+function imageCroppingUpload() {
+    var $uploadCrop;
+
+    var opts = {
+        viewport: 'original',
+        type: 'canvas',
+        enableResize: true,
+        enableExif: true,
+        enableOrientation: true,
+        format: 'jpeg'
+    };
+
+    function readFile(input) {
+        if (input.files && input.files[0]) {
+            var reader = new FileReader();
