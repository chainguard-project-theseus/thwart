+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+
+@Controller
+@RequestMapping("/systeminfo")
+@PreAuthorize("hasAuthority('" + FredBetPermission.PERM_ADMINISTRATION + "')")
+public class SystemInfoController {
+
+    private static final String SYSTEMINFO_VIEW = "admin/systeminfo";
+
+    private final SystemInfoService systemInfoService;
+
+    public SystemInfoController(SystemInfoService systemInfoService) {
+        this.systemInfoService = systemInfoService;
+    }
+
+    @GetMapping
+    public String list(Model model) {
+        java.util.Map<String, String> buildInfoMap = new java.util.LinkedHashMap<>();
+        systemInfoService.fetchSystemInfo().forEach((key, value) -> buildInfoMap.put(key, String.valueOf(value)));
+        model.addAttribute("buildInfoMap", buildInfoMap);
+        return SYSTEMINFO_VIEW;
+    }
+}
