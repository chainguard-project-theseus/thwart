+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.util.MessageSourceUtil;
+import de.fred4jupiter.fredbet.web.GroupAvailabilityUtil;
+import de.fred4jupiter.fredbet.web.LanguageUtil;
+import de.fred4jupiter.fredbet.web.RuntimeSettingsUtil;
+import de.fred4jupiter.fredbet.web.WebMessageUtil;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.util.LanguageIconUtil;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import org.springframework.stereotype.Component;
+import org.springframework.web.servlet.HandlerInterceptor;
+import org.springframework.web.servlet.ModelAndView;
+
+/**
+ * Adds the {@link SiteModel} (as model attribute {@code site}) to every rendered view.
+ */
+@Component
+public class SiteModelInterceptor implements HandlerInterceptor {
+
+    public static final String SITE_ATTRIBUTE = "site";
+
+    private final WebSecurityUtil webSecurityUtil;
+    private final RuntimeSettingsUtil runtimeSettingsUtil;
+    private final GroupAvailabilityUtil groupAvailabilityUtil;
+    private final LanguageIconUtil languageIconUtil;
+    private final LanguageUtil languageUtil;
+    private final MessageSourceUtil messageSourceUtil;
+
+    public SiteModelInterceptor(WebSecurityUtil webSecurityUtil, RuntimeSettingsUtil runtimeSettingsUtil, GroupAvailabilityUtil groupAvailabilityUtil,
+                                LanguageIconUtil languageIconUtil, LanguageUtil languageUtil, MessageSourceUtil messageSourceUtil) {
+        this.webSecurityUtil = webSecurityUtil;
+        this.runtimeSettingsUtil = runtimeSettingsUtil;
+        this.groupAvailabilityUtil = groupAvailabilityUtil;
+        this.languageIconUtil = languageIconUtil;
+        this.languageUtil = languageUtil;
+        this.messageSourceUtil = messageSourceUtil;
+    }
+
+    @Override
+    public void postHandle(HttpServletRequest request, HttpServletResponse response, Object handler, ModelAndView modelAndView) {
+        if (modelAndView == null) {
+            return;
+        }
+        String viewName = modelAndView.getViewName();
+        if (viewName != null && (viewName.startsWith("redirect:") || viewName.startsWith("forward:"))) {
+            return;
+        }
+        Object message = modelAndView.getModel().get("globalMessage");
+        WebMessageUtil.WebMessage globalMessage = message instanceof WebMessageUtil.WebMessage webMessage ? webMessage : null;
+        modelAndView.addObject(SITE_ATTRIBUTE, createSiteModel(globalMessage));
+    }
+
+    public SiteModel createSiteModel(WebMessageUtil.WebMessage globalMessage) {
+        return new SiteModel(webSecurityUtil, runtimeSettingsUtil, groupAvailabilityUtil, languageIconUtil, languageUtil,
+            messageSourceUtil, globalMessage);
+    }
+}
