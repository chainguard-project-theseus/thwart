+package de.fred4jupiter.fredbet.web.view;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.time.ZonedDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.Locale;
+
+/**
+ * Formatting helpers for the Tessera templates.
+ */
+@TemplateFunctions("fb")
+public final class ViewFunctions {
+
+    private static final DateTimeFormatter DATE_TO_STRING = DateTimeFormatter.ofPattern("EEE MMM dd HH:mm:ss zzz yyyy", Locale.US);
+
+    private ViewFunctions() {
+    }
+
+    /**
+     * Formats like {@link java.util.Date#toString()}, as the old templates printed Boot's error timestamp.
+     */
+    @TemplateFunction
+    public static String dateToString(ZonedDateTime dateTime) {
+        return dateTime == null ? null : DATE_TO_STRING.format(dateTime);
+    }
+}
