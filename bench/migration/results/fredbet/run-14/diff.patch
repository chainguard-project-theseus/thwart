+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.domain.Group;
+import de.fred4jupiter.fredbet.settings.RuntimeSettings;
+import de.fred4jupiter.fredbet.util.MessageSourceUtil;
+import de.fred4jupiter.fredbet.web.GroupAvailabilityUtil;
+import de.fred4jupiter.fredbet.web.LanguageUtil;
+import de.fred4jupiter.fredbet.web.RuntimeSettingsUtil;
+import de.fred4jupiter.fredbet.web.WebMessageUtil;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.util.LanguageIconUtil;
+import dev.tessera.runtime.TemplateView;
+import org.springframework.context.i18n.LocaleContextHolder;
+
+import java.util.AbstractMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Values every page (layout, navigation) needs. Formerly read by the templates through Spring beans.
+ * Values are computed lazily while the page renders, like the old bean calls.
+ */
+@TemplateView
+public class SiteModel {
+
+    private static final List<String> LANGUAGES = List.of("de", "en", "pl", "es", "ca", "cs", "sv", "fr");
+
+    private final WebSecurityUtil webSecurityUtil;
+    private final RuntimeSettingsUtil runtimeSettingsUtil;
+    private final GroupAvailabilityUtil groupAvailabilityUtil;
+    private final LanguageIconUtil languageIconUtil;
+    private final LanguageUtil languageUtil;
+    private final MessageSourceUtil messageSourceUtil;
+    private final WebMessageUtil.WebMessage globalMessage;
+
+    private RuntimeSettings settings;
+
+    public SiteModel(WebSecurityUtil webSecurityUtil, RuntimeSettingsUtil runtimeSettingsUtil, GroupAvailabilityUtil groupAvailabilityUtil,
+                     LanguageIconUtil languageIconUtil, LanguageUtil languageUtil, MessageSourceUtil messageSourceUtil,
+                     WebMessageUtil.WebMessage globalMessage) {
+        this.webSecurityUtil = webSecurityUtil;
+        this.runtimeSettingsUtil = runtimeSettingsUtil;
+        this.groupAvailabilityUtil = groupAvailabilityUtil;
+        this.languageIconUtil = languageIconUtil;
+        this.languageUtil = languageUtil;
+        this.messageSourceUtil = messageSourceUtil;
+        this.globalMessage = globalMessage;
+    }
+
+    public WebMessageUtil.WebMessage getGlobalMessage() {
+        return globalMessage;
+    }
+
+    public RuntimeSettings getSettings() {
+        if (settings == null) {
+            settings = runtimeSettingsUtil.getSettings();
+        }
+        return settings;
+    }
+
+    public boolean isDefaultTheme() {
+        return getSettings().getBootswatchThemeUrl().startsWith("/webjars/bootstrap/");
+    }
+
+    public String getThemeName() {
+        return getSettings().getBootswatchTheme().toString().toLowerCase();
+    }
+
+    public String getNavbarTag() {
+        return getSettings().getNavbarLayout().getNavbarTag();
+    }
+
+    public boolean isUserLoggedIn() {
+        return webSecurityUtil.isUserLoggedIn();
+    }
+
+    public String getCurrentUsername() {
+        return webSecurityUtil.getCurrentUsername();
+    }
+
+    public String getCurrentUserProfileImageKey() {
+        return String.valueOf(webSecurityUtil.getCurrentUserProfileImageKey());
+    }
+
+    /**
+     * Profile image key per user name, looked up on access ({@code site.profileImageKeys[username]}).
+     */
+    public Map<String, String> getProfileImageKeys() {
+        return new AbstractMap<>() {
+            @Override
+            public String get(Object username) {
+                return username == null ? null : webSecurityUtil.getUserProfileImageKeyFor(username.toString());
+            }
+
+            @Override
+            public boolean containsKey(Object key) {
+                return true;
+            }
+
+            @Override
+            public Set<Entry<String, String>> entrySet() {
+                return Set.of();
+            }
+        };
+    }
+
+    public boolean isDemoDataMenuEntryEnabled() {
+        return webSecurityUtil.isDemoDataMenuEntryEnabled();
+    }
+
+    public boolean isH2ConsoleEnabled() {
+        return runtimeSettingsUtil.isH2ConsoleEnabled();
+    }
+
+    public String getH2Path() {
+        return webSecurityUtil.resolveH2Path();
+    }
+
+    public List<GroupLink> getMainGroups() {
+        return groupAvailabilityUtil.getMainGroups().stream()
+            .map(g -> new GroupLink(g.getName(), messageSourceUtil.getMessageFor(g.getTitleMsgKey(), LocaleContextHolder.getLocale())))
+            .toList();
+    }
+
+    public boolean isKnockOutMatchesAvailable() {
+        return groupAvailabilityUtil.isKnockOutMatchesAvailable();
+    }
+
+    public Map<String, Boolean> getGroupAvailable() {
+        Map<String, Boolean> result = new LinkedHashMap<>();
+        for (Group group : Group.values()) {
+            result.put(group.name(), groupAvailabilityUtil.isGroupAvailable(group.name()));
+        }
+        return result;
+    }
+
+    public String getCurrentLanguageCss() {
+        return languageIconUtil.cssClassCurrentUserLanguage();
+    }
+
+    public Map<String, String> getLanguageUrls() {
+        Map<String, String> result = new LinkedHashMap<>();
+        for (String lang : LANGUAGES) {
+            result.put(lang, languageUtil.buildUrl(lang));
+        }
+        return result;
+    }
+
+    public record GroupLink(String name, String title) {
+    }
+}
