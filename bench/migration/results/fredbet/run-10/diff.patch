@@ -0,0 +1,81 @@
+package de.fred4jupiter.fredbet.web.layout;
+
+import de.fred4jupiter.fredbet.domain.Group;
+import de.fred4jupiter.fredbet.settings.RuntimeSettings;
+import de.fred4jupiter.fredbet.web.GroupAvailabilityUtil;
+import de.fred4jupiter.fredbet.web.LanguageUtil;
+import de.fred4jupiter.fredbet.web.RuntimeSettingsUtil;
+import de.fred4jupiter.fredbet.web.WebMessageUtil;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.util.LanguageIconUtil;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+
+import java.util.List;
+
+/**
+ * Provides the values the layout and navigation bar need on every page.
+ */
+@ControllerAdvice
+public class LayoutModelAdvice {
+
+    private final WebSecurityUtil webSecurityUtil;
+
+    private final RuntimeSettingsUtil runtimeSettingsUtil;
+
+    private final GroupAvailabilityUtil groupAvailabilityUtil;
+
+    private final LanguageUtil languageUtil;
+
+    private final LanguageIconUtil languageIconUtil;
+
+    private final WebMessageUtil webMessageUtil;
+
+    public LayoutModelAdvice(WebSecurityUtil webSecurityUtil, RuntimeSettingsUtil runtimeSettingsUtil,
+                             GroupAvailabilityUtil groupAvailabilityUtil, LanguageUtil languageUtil,
+                             LanguageIconUtil languageIconUtil, WebMessageUtil webMessageUtil) {
+        this.webSecurityUtil = webSecurityUtil;
+        this.runtimeSettingsUtil = runtimeSettingsUtil;
+        this.groupAvailabilityUtil = groupAvailabilityUtil;
+        this.languageUtil = languageUtil;
+        this.languageIconUtil = languageIconUtil;
+        this.webMessageUtil = webMessageUtil;
+    }
+
+    @ModelAttribute("layout")
+    public LayoutModel layout() {
+        RuntimeSettings settings = runtimeSettingsUtil.getSettings();
+        boolean loggedIn = webSecurityUtil.isUserLoggedIn();
+
+        LayoutModel.LanguageUrls languageUrls = new LayoutModel.LanguageUrls(languageUtil.buildUrl("de"),
+            languageUtil.buildUrl("en"), languageUtil.buildUrl("pl"), languageUtil.buildUrl("es"),
+            languageUtil.buildUrl("ca"), languageUtil.buildUrl("cs"), languageUtil.buildUrl("sv"),
+            languageUtil.buildUrl("fr"));
+
+        List<LayoutModel.GroupLink> mainGroups = List.of();
+        boolean knockOut = false;
+        String profileImageKey = null;
+        String currentUsername = null;
+        if (loggedIn) {
+            mainGroups = groupAvailabilityUtil.getMainGroups().stream()
+                .map(group -> new LayoutModel.GroupLink(group.name(), webMessageUtil.getMessageFor(group.getTitleMsgKey())))
+                .toList();
+            knockOut = groupAvailabilityUtil.isKnockOutMatchesAvailable();
+            profileImageKey = webSecurityUtil.getCurrentUserProfileImageKey();
+            currentUsername = webSecurityUtil.getCurrentUsername();
+        }
+
+        return new LayoutModel(loggedIn, settings.getNavbarLayout().getNavbarTag(), settings.getBootswatchTheme(),
+            languageIconUtil.cssClassCurrentUserLanguage(), languageUrls, mainGroups, knockOut,
+            loggedIn && isGroupAvailable(Group.ROUND_OF_THIRTY_TWO), loggedIn && isGroupAvailable(Group.ROUND_OF_SIXTEEN),
+            loggedIn && isGroupAvailable(Group.QUARTER_FINAL), loggedIn && isGroupAvailable(Group.SEMI_FINAL),
+            loggedIn && isGroupAvailable(Group.FINAL), loggedIn && isGroupAvailable(Group.GAME_FOR_THIRD),
+            webSecurityUtil.isDemoDataMenuEntryEnabled(), runtimeSettingsUtil.isH2ConsoleEnabled(),
+            webSecurityUtil.resolveH2Path(), profileImageKey, currentUsername, settings.isEnableChangingUsername(),
+            settings.isSelfRegistrationEnabled());
+    }
+
+    private boolean isGroupAvailable(Group group) {
+        return groupAvailabilityUtil.isGroupAvailable(group.name());
+    }
+}
