+package de.fred4jupiter.fredbet.web.matches;
+
+import com.neovisionaries.i18n.CountryCode;
+import de.fred4jupiter.fredbet.domain.Country;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.apache.commons.lang3.StringUtils;
+
+import java.util.EnumMap;
+import java.util.Map;
+
+/**
+ * Template functions for the match pages (replaces {@code @teamUtil.cssClassFor(country)}).
+ */
+@TemplateFunctions("matchView")
+public final class MatchViewFunctions {
+
+    private static final Map<Country, String> FLAG_CSS = new EnumMap<>(Country.class);
+
+    static {
+        for (Country country : Country.values()) {
+            FLAG_CSS.put(country, computeFlagCss(country));
+        }
+    }
+
+    private MatchViewFunctions() {
+    }
+
+    /**
+     * The CSS classes of the country's flag icon, as {@code TeamUtil.cssClassFor(Country)} computes them; {@code ""}
+     * for {@code null}.
+     */
+    @TemplateFunction
+    public static String flagCss(Country country) {
+        return country == null ? "" : FLAG_CSS.get(country);
+    }
+
+    private static String computeFlagCss(Country country) {
+        if (StringUtils.isNotBlank(country.getCssIconClass())) {
+            return country.getCssIconClass();
+        }
+        String alpha2 = null;
+        if (StringUtils.isNotBlank(country.getFlagIconCode())) {
+            alpha2 = country.getFlagIconCode();
+        } else if (StringUtils.isNotBlank(country.getAlpha3Code())) {
+            CountryCode countryCode = CountryCode.getByAlpha3Code(country.getAlpha3Code().toUpperCase());
+            if (countryCode != null) {
+                alpha2 = countryCode.getAlpha2();
+            }
+        }
+        return StringUtils.isBlank(alpha2) ? "" : "fi fi-%s".formatted(alpha2.toLowerCase());
+    }
+}
