+package de.fred4jupiter.fredbet.web.layout;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.time.ZonedDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.Locale;
+
+/**
+ * Formatting helpers for the templates.
+ */
+@TemplateFunctions("fmt")
+public final class FormatFunctions {
+
+    private static final DateTimeFormatter DATE_TO_STRING = DateTimeFormatter.ofPattern("EEE MMM dd HH:mm:ss zzz yyyy", Locale.ENGLISH);
+
+    private FormatFunctions() {
+    }
+
+    /**
+     * Formats like {@link java.util.Date#toString()}, independent of the render locale.
+     */
+    @TemplateFunction
+    public static String dateToString(ZonedDateTime dateTime) {
+        return dateTime == null ? null : DATE_TO_STRING.format(dateTime);
+    }
+}
