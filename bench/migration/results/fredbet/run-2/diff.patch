+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.domain.Country;
+import de.fred4jupiter.fredbet.points.ExtraPointsConfiguration;
+import de.fred4jupiter.fredbet.settings.RuntimeSettings;
+import de.fred4jupiter.fredbet.domain.Theme;
+import de.fred4jupiter.fredbet.web.GroupAvailabilityUtil;
+import de.fred4jupiter.fredbet.web.LanguageUtil;
+import de.fred4jupiter.fredbet.web.RuntimeSettingsUtil;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.bet.BettingWebUtil;
+import de.fred4jupiter.fredbet.web.util.LanguageIconUtil;
+import de.fred4jupiter.fredbet.web.util.TeamUtil;
+import dev.tessera.runtime.TemplateView;
+import org.springframework.context.MessageSource;
+import org.springframework.context.i18n.LocaleContextHolder;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Everything the shared layout (and a few pages) used to read from Spring beans in the templates.
+ * Values are computed lazily at render time, so the behaviour equals the former bean calls.
+ */
+@TemplateView
+public class LayoutView {
+
+    private final RuntimeSettingsUtil runtimeSettingsUtil;
+    private final WebSecurityUtil webSecurityUtil;
+    private final GroupAvailabilityUtil groupAvailabilityUtil;
+    private final LanguageUtil languageUtil;
+    private final LanguageIconUtil languageIconUtil;
+    private final TeamUtil teamUtil;
+    private final BettingWebUtil bettingWebUtil;
+    private final MessageSource messageSource;
+
+    private final Map<String, Boolean> groupAvailable;
+    private final Map<String, String> languageUrls;
+    private final Map<String, String> languageIconClasses;
+    private final Map<String, String> profileImageKeys;
+    private final Map<Country, String> teamCssClasses;
+
+    private RuntimeSettings settings;
+
+    public LayoutView(RuntimeSettingsUtil runtimeSettingsUtil, WebSecurityUtil webSecurityUtil,
+                      GroupAvailabilityUtil groupAvailabilityUtil, LanguageUtil languageUtil,
+                      LanguageIconUtil languageIconUtil, TeamUtil teamUtil, BettingWebUtil bettingWebUtil,
+                      MessageSource messageSource) {
+        this.runtimeSettingsUtil = runtimeSettingsUtil;
+        this.webSecurityUtil = webSecurityUtil;
+        this.groupAvailabilityUtil = groupAvailabilityUtil;
+        this.languageUtil = languageUtil;
+        this.languageIconUtil = languageIconUtil;
+        this.teamUtil = teamUtil;
+        this.bettingWebUtil = bettingWebUtil;
+        this.messageSource = messageSource;
+        this.groupAvailable = new LazyMap<>(groupAvailabilityUtil::isGroupAvailable);
+        this.languageUrls = new LazyMap<>(languageUtil::buildUrl);
+        this.languageIconClasses = new LazyMap<>(languageIconUtil::cssClassFor);
+        this.profileImageKeys = new LazyMap<>(webSecurityUtil::getUserProfileImageKeyFor);
+        this.teamCssClasses = new LazyMap<>(teamUtil::cssClassFor);
+    }
+
+    public RuntimeSettings getSettings() {
+        if (settings == null) {
+            settings = runtimeSettingsUtil.getSettings();
+        }
+        return settings;
+    }
+
+    public ExtraPointsConfiguration getExtraPointsConfig() {
+        return runtimeSettingsUtil.getExtraPointsConfig();
+    }
+
+    /**
+     * @return the lower case bootswatch theme name, or {@code null} for the default bootstrap theme.
+     */
+    public String getBootswatchThemeName() {
+        Theme theme = getSettings().getBootswatchTheme();
+        if (theme == null || Theme.DEFAULT.name().equalsIgnoreCase(theme.toString())) {
+            return null;
+        }
+        return theme.toString().toLowerCase();
+    }
+
+    public String getNavbarTag() {
+        return getSettings().getNavbarLayout().getNavbarTag();
+    }
+
+    public boolean isUserLoggedIn() {
+        return webSecurityUtil.isUserLoggedIn();
+    }
+
+    public boolean isDemoDataMenuEntryEnabled() {
+        return webSecurityUtil.isDemoDataMenuEntryEnabled();
+    }
+
+    public boolean isH2ConsoleEnabled() {
+        return runtimeSettingsUtil.isH2ConsoleEnabled();
+    }
+
+    public String getH2Path() {
+        return webSecurityUtil.resolveH2Path();
+    }
+
+    public String getCurrentUsername() {
+        return webSecurityUtil.getCurrentUsername();
+    }
+
+    public String getCurrentUserProfileImageKey() {
+        return webSecurityUtil.getCurrentUserProfileImageKey();
+    }
+
+    public String getCurrentUserLanguageIconClass() {
+        return languageIconUtil.cssClassCurrentUserLanguage();
+    }
+
+    public List<NavGroup> getMainGroups() {
+        return groupAvailabilityUtil.getMainGroups().stream()
+            .map(group -> new NavGroup(group.getName(),
+                messageSource.getMessage(group.getTitleMsgKey(), null, LocaleContextHolder.getLocale())))
+            .toList();
+    }
+
+    public boolean isKnockOutMatchesAvailable() {
+        return groupAvailabilityUtil.isKnockOutMatchesAvailable();
+    }
+
+    /**
+     * @return group name to availability, e.g. {@code layout.groupAvailable['FINAL']}
+     */
+    public Map<String, Boolean> getGroupAvailable() {
+        return groupAvailable;
+    }
+
+    /**
+     * @return language code to the current URL with the {@code lang} parameter replaced
+     */
+    public Map<String, String> getLanguageUrls() {
+        return languageUrls;
+    }
+
+    /**
+     * @return alpha2 code to the flag icon css class
+     */
+    public Map<String, String> getLanguageIconClasses() {
+        return languageIconClasses;
+    }
+
+    /**
+     * @return username to profile image key
+     */
+    public Map<String, String> getProfileImageKeys() {
+        return profileImageKeys;
+    }
+
+    /**
+     * @return country to flag css class
+     */
+    public Map<Country, String> getTeamCssClasses() {
+        return teamCssClasses;
+    }
+
+    public boolean isBettable() {
+        return bettingWebUtil.isBettable();
+    }
+
+    private Map<String, Boolean> roleSelectionDisabled;
+
+    /**
+     * @return username to whether the role selection is disabled for that user,
+     * e.g. {@code layout.roleSelectionDisabled[editUserCommand.username]}
+     */
+    public Map<String, Boolean> getRoleSelectionDisabled() {
+        if (roleSelectionDisabled == null) {
+            roleSelectionDisabled = new LazyMap<>(webSecurityUtil::isRoleSelectionDisabledForUser);
+        }
+        return roleSelectionDisabled;
+    }
+
+    private Map<Country, String> teamNames;
+
+    /**
+     * @return country to translated team name (= former {@code @teamUtil.i18n(country)})
+     */
+    public Map<Country, String> getTeamNames() {
+        if (teamNames == null) {
+            teamNames = new LazyMap<>(teamUtil::i18n);
+        }
+        return teamNames;
+    }
+
+    private Map<String, String> messages;
+
+    /**
+     * @return message key to the message in the current locale (= former dynamic {@code #{${key}}})
+     */
+    public Map<String, String> getMessages() {
+        if (messages == null) {
+            messages = new LazyMap<>(key -> messageSource.getMessage(key, null, LocaleContextHolder.getLocale()));
+        }
+        return messages;
+    }
+
+    private Map<String, Map<java.time.LocalDateTime, String>> dateTimeFormats;
+
+    /**
+     * Locale aware date formatting (Tessera's {@code temporals.format} always uses English names).
+     *
+     * @return pattern to (date time to the formatted date time in the current locale),
+     * e.g. {@code layout.dateTimeFormats['EEE dd. MMMM yyyy HH:mm'][match.kickOffDate]}
+     */
+    public Map<String, Map<java.time.LocalDateTime, String>> getDateTimeFormats() {
+        if (dateTimeFormats == null) {
+            dateTimeFormats = new LazyMap<>(pattern -> new LazyMap<>(dateTime -> dateTime == null ? null
+                : java.time.format.DateTimeFormatter.ofPattern(pattern, LocaleContextHolder.getLocale()).format(dateTime)));
+        }
+        return dateTimeFormats;
+    }
+}
