@@ -0,0 +1,44 @@
+package de.fred4jupiter.fredbet.web.view;
+
+import java.util.AbstractMap;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Function;
+
+/**
+ * Read-only map that computes (and caches) its values on access. Used to expose per-key lookups
+ * (former bean method calls with an argument) to templates as {@code map[key]}.
+ */
+final class LazyMap<K, V> extends AbstractMap<K, V> {
+
+    private final Function<K, V> loader;
+
+    private final Map<K, V> cache = new HashMap<>();
+
+    LazyMap(Function<K, V> loader) {
+        this.loader = loader;
+    }
+
+    @Override
+    @SuppressWarnings("unchecked")
+    public V get(Object key) {
+        K k = (K) key;
+        if (cache.containsKey(k)) {
+            return cache.get(k);
+        }
+        V value = loader.apply(k);
+        cache.put(k, value);
+        return value;
+    }
+
+    @Override
+    public boolean containsKey(Object key) {
+        return true;
+    }
+
+    @Override
+    public Set<Entry<K, V>> entrySet() {
+        return cache.entrySet();
+    }
+}
