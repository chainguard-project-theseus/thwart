+package de.fred4jupiter.fredbet.web.info;
+
+import java.util.List;
+
+/**
+ * One node of admin edited rich text (rules, prices, misc), already restricted to a whitelist of elements and
+ * attributes by {@link RichTextParser}. The template {@code fragments/rich_text} renders it with normal escaping, so
+ * no raw HTML of the user ever reaches the page.
+ *
+ * @param tag      element name (lower case, one of {@link RichTextParser#ALLOWED_ELEMENTS}) or {@link #TEXT} for a text node
+ * @param text     the (decoded) text of a text node, otherwise {@code null}
+ * @param attrs    whitelisted attributes; values are {@code null} if absent
+ * @param children child nodes of an element
+ */
+public record RichTextNode(String tag, String text, Attributes attrs, List<RichTextNode> children) {
+
+    public static final String TEXT = "#text";
+
+    public record Attributes(String cssClass, String title, String href, String target, String src, String alt,
+                             String width, String height, String colspan, String rowspan) {
+
+        static final Attributes NONE = new Attributes(null, null, null, null, null, null, null, null, null, null);
+    }
+}
diff --git a/src/main/java/de/fred4jupiter/fredbet/web/info/RichTextParser.java b/src/main/java/de/fred4jupiter/fredbet/web/info/RichTextParser.java
new file mode 100644
index 00000000..41ddc9e6
--- /dev/null
+++ b/src/main/java/de/fred4jupiter/fredbet/web/info/RichTextParser.java
@@ -0,0 +1,329 @@
+package de.fred4jupiter.fredbet.web.info;
+
+import org.apache.commons.lang3.StringUtils;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Parses the admin edited HTML of the info pages (rules, prices, misc; written with summernote) into a tree of
+ * {@link RichTextNode}s that only contains whitelisted elements and attributes. Everything else is dropped:
+ * {@code script}, {@code style} and similar elements together with their content, other unknown elements keep
+ * their content but lose their tag, and all attributes that are not whitelisted (event handlers, {@code style}, ...)
+ * are removed. The tree is rendered by the template {@code fragments/rich_text}, which escapes all text and
+ * attribute values and checks URLs, so the result is safe without trusting the stored markup.
+ */
+public final class RichTextParser {
+
+    /**
+     * Elements the template {@code fragments/rich_text} can render.
+     */
+    public static final Set<String> ALLOWED_ELEMENTS = Set.of("p", "div", "span", "br", "hr", "b", "strong", "i", "em",
+        "u", "s", "strike", "del", "ins", "sub", "sup", "small", "mark", "code", "pre", "blockquote", "h1", "h2", "h3",
+        "h4", "h5", "h6", "ul", "ol", "li", "table", "thead", "tbody", "tfoot", "tr", "td", "th", "caption", "a", "img");
+
+    private static final Set<String> VOID_ELEMENTS = Set.of("br", "hr", "img", "input", "meta", "link", "area", "base",
+        "col", "embed", "param", "source", "track", "wbr");
+
+    /**
+     * Elements whose whole content is dropped.
+     */
+    private static final Set<String> DROPPED_WITH_CONTENT = Set.of("script", "style", "iframe", "object", "embed",
+        "template", "noscript", "textarea", "title", "head", "svg", "math", "select", "frameset", "frame", "noembed",
+        "noframes", "xmp", "plaintext");
+
+    /**
+     * Elements implicitly closed by a following element of the same name.
+     */
+    private static final Set<String> SELF_CLOSING_SIBLINGS = Set.of("p", "li", "tr", "td", "th");
+
+    private static final int MAX_DEPTH = 40;
+
+    private final String html;
+    private int pos;
+
+    private RichTextParser(String html) {
+        this.html = html;
+    }
+
+    public static List<RichTextNode> parse(String html) {
+        if (StringUtils.isEmpty(html)) {
+            return List.of();
+        }
+        return new RichTextParser(html).parseDocument();
+    }
+
+    private static final class Builder {
+        final String tag;
+        final RichTextNode.Attributes attrs;
+        final List<RichTextNode> children = new ArrayList<>();
+
+        Builder(String tag, RichTextNode.Attributes attrs) {
+            this.tag = tag;
+            this.attrs = attrs;
+        }
+
+        RichTextNode build() {
+            return new RichTextNode(tag, null, attrs, List.copyOf(children));
+        }
+    }
+
+    private final Builder root = new Builder(null, RichTextNode.Attributes.NONE);
+
+    /**
+     * Open elements (innermost first); elements that are not rendered themselves have the {@link #UNWRAPPED} builder.
+     */
+    private final Deque<String> openNames = new ArrayDeque<>();
+    private final Deque<Builder> openBuilders = new ArrayDeque<>();
+
+    private final StringBuilder text = new StringBuilder();
+
+    /**
+     * Marker for an open element that is not rendered itself (its children go to the next rendered ancestor).
+     */
+    private static final Builder UNWRAPPED = new Builder(null, RichTextNode.Attributes.NONE);
+
+    private List<RichTextNode> parseDocument() {
+        while (pos < html.length()) {
+            char c = html.charAt(pos);
+            if (c != '<') {
+                text.append(c);
+                pos++;
+            } else if (html.startsWith("<!--", pos)) {
+                flushText();
+                int end = html.indexOf("-->", pos + 4);
+                pos = end < 0 ? html.length() : end + 3;
+            } else if (html.startsWith("<!", pos) || html.startsWith("<?", pos)) {
+                flushText();
+                int end = html.indexOf('>', pos);
+                pos = end < 0 ? html.length() : end + 1;
+            } else if (html.startsWith("</", pos) && pos + 2 < html.length() && Character.isLetter(html.charAt(pos + 2))) {
+                flushText();
+                closeElement(readEndTag());
+            } else if (pos + 1 < html.length() && Character.isLetter(html.charAt(pos + 1))) {
+                flushText();
+                handleStartTag(readStartTag());
+            } else {
+                // a lone '<' is text
+                text.append(c);
+                pos++;
+            }
+        }
+        flushText();
+        while (!openNames.isEmpty()) {
+            popElement();
+        }
+        return List.copyOf(root.children);
+    }
+
+    private record Tag(String name, Map<String, String> attributes, boolean selfClosing) {
+    }
+
+    private void handleStartTag(Tag tag) {
+        String name = tag.name();
+        boolean isVoid = VOID_ELEMENTS.contains(name);
+        if (DROPPED_WITH_CONTENT.contains(name)) {
+            if (!tag.selfClosing() && !isVoid) {
+                skipContentOf(name);
+            }
+            return;
+        }
+        if (SELF_CLOSING_SIBLINGS.contains(name) && name.equals(openNames.peek())) {
+            popElement();
+        }
+        boolean allowed = ALLOWED_ELEMENTS.contains(name) && openNames.size() < MAX_DEPTH;
+        if (allowed && (isVoid || tag.selfClosing())) {
+            current().children.add(new Builder(name, toAttributes(name, tag.attributes())).build());
+        } else if (allowed) {
+            openNames.push(name);
+            openBuilders.push(new Builder(name, toAttributes(name, tag.attributes())));
+        } else if (!isVoid && !tag.selfClosing()) {
+            openNames.push(name);
+            openBuilders.push(UNWRAPPED);
+        }
+    }
+
+    /**
+     * @return the innermost open rendered element (or the root)
+     */
+    private Builder current() {
+        for (Builder builder : openBuilders) {
+            if (builder != UNWRAPPED) {
+                return builder;
+            }
+        }
+        return root;
+    }
+
+    private void closeElement(String name) {
+        if (!openNames.contains(name)) {
+            return; // stray end tag
+        }
+        while (!openNames.isEmpty()) {
+            String top = openNames.peek();
+            popElement();
+            if (top.equals(name)) {
+                return;
+            }
+        }
+    }
+
+    private void popElement() {
+        openNames.pop();
+        Builder builder = openBuilders.pop();
+        if (builder != UNWRAPPED) {
+            current().children.add(builder.build());
+        }
+    }
+
+    private void flushText() {
+        if (text.isEmpty()) {
+            return;
+        }
+        String decoded = decodeEntities(text.toString());
+        text.setLength(0);
+        current().children.add(new RichTextNode(RichTextNode.TEXT, decoded, RichTextNode.Attributes.NONE, List.of()));
+    }
+
+    private void skipContentOf(String name) {
+        String lower = html.toLowerCase(Locale.ROOT);
+        int search = pos;
+        while (true) {
+            int end = lower.indexOf("</" + name, search);
+            if (end < 0) {
+                pos = html.length();
+                return;
+            }
+            int after = end + 2 + name.length();
+            if (after >= html.length() || !Character.isLetterOrDigit(html.charAt(after))) {
+                int close = html.indexOf('>', after);
+                pos = close < 0 ? html.length() : close + 1;
+                return;
+            }
+            search = after;
+        }
+    }
+
+    private String readEndTag() {
+        pos += 2;
+        int start = pos;
+        while (pos < html.length() && isNameChar(html.charAt(pos))) {
+            pos++;
+        }
+        String name = html.substring(start, pos).toLowerCase(Locale.ROOT);
+        int close = html.indexOf('>', pos);
+        pos = close < 0 ? html.length() : close + 1;
+        return name;
+    }
+
+    private Tag readStartTag() {
+        pos++;
+        int start = pos;
+        while (pos < html.length() && isNameChar(html.charAt(pos))) {
+            pos++;
+        }
+        String name = html.substring(start, pos).toLowerCase(Locale.ROOT);
+        Map<String, String> attributes = new HashMap<>();
+        boolean selfClosing = false;
+        while (pos < html.length()) {
+            char c = html.charAt(pos);
+            if (c == '>') {
+                pos++;
+                break;
+            }
+            if (c == '/' && pos + 1 < html.length() && html.charAt(pos + 1) == '>') {
+                selfClosing = true;
+                pos += 2;
+                break;
+            }
+            if (Character.isWhitespace(c) || c == '/') {
+                pos++;
+                continue;
+            }
+            int attrStart = pos;
+            while (pos < html.length() && !Character.isWhitespace(html.charAt(pos)) && "=>/".indexOf(html.charAt(pos)) < 0) {
+                pos++;
+            }
+            if (pos == attrStart) {
+                pos++; // stray character such as '"'
+                continue;
+            }
+            String attrName = html.substring(attrStart, pos).toLowerCase(Locale.ROOT);
+            skipWhitespace();
+            String value = "";
+            if (pos < html.length() && html.charAt(pos) == '=') {
+                pos++;
+                skipWhitespace();
+                value = readAttributeValue();
+            }
+            attributes.putIfAbsent(attrName, decodeEntities(value));
+        }
+        return new Tag(name, attributes, selfClosing);
+    }
+
+    private String readAttributeValue() {
+        if (pos >= html.length()) {
+            return "";
+        }
+        char quote = html.charAt(pos);
+        if (quote == '"' || quote == '\'') {
+            int end = html.indexOf(quote, pos + 1);
+            if (end < 0) {
+                end = html.length();
+            }
+            String value = html.substring(pos + 1, end);
+            pos = Math.min(end + 1, html.length());
+            return value;
+        }
+        int start = pos;
+        while (pos < html.length() && !Character.isWhitespace(html.charAt(pos)) && html.charAt(pos) != '>') {
+            pos++;
+        }
+        return html.substring(start, pos);
+    }
+
+    private void skipWhitespace() {
+        while (pos < html.length() && Character.isWhitespace(html.charAt(pos))) {
+            pos++;
+        }
+    }
+
+    private static boolean isNameChar(char c) {
+        return Character.isLetterOrDigit(c) || c == '-' || c == '_' || c == ':' || c == '.';
+    }
+
+    private static RichTextNode.Attributes toAttributes(String element, Map<String, String> attributes) {
+        boolean link = element.equals("a");
+        boolean image = element.equals("img");
+        boolean cell = element.equals("td") || element.equals("th");
+        String target = link ? attributes.get("target") : null;
+        if (target != null && !Set.of("_blank", "_self", "_parent", "_top").contains(target)) {
+            target = null;
+        }
+        return new RichTextNode.Attributes(
+            attributes.get("class"),
+            attributes.get("title"),
+            link ? attributes.get("href") : null,
+            target,
+            image ? attributes.get("src") : null,
+            image ? attributes.get("alt") : null,
+            image || element.equals("table") ? attributes.get("width") : null,
+            image ? attributes.get("height") : null,
+            cell ? attributes.get("colspan") : null,
+            cell ? attributes.get("rowspan") : null);
+    }
+
+    @SuppressWarnings("deprecation")
+    private static String decodeEntities(String text) {
+        if (text.indexOf('&') < 0) {
+            return text;
+        }
+        return org.apache.commons.lang3.StringEscapeUtils.unescapeHtml4(text);
+    }
+}
