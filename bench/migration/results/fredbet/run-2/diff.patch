+package de.fred4jupiter.fredbet.web.view;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.security.authentication.AnonymousAuthenticationToken;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.GrantedAuthority;
+import org.springframework.security.core.context.SecurityContextHolder;
+
+import java.util.Set;
+
+/**
+ * Template functions replacing the former {@code sec:authorize="hasAuthority(...)"} checks.
+ */
+@TemplateFunctions("sec")
+public final class SecurityFunctions {
+
+    private SecurityFunctions() {
+    }
+
+    @TemplateFunction
+    public static boolean hasAuthority(String authority) {
+        return hasAnyAuthority(authority);
+    }
+
+    @TemplateFunction
+    public static boolean hasAnyAuthority(String... authorities) {
+        Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
+        if (authentication == null || !authentication.isAuthenticated() || authentication instanceof AnonymousAuthenticationToken) {
+            return false;
+        }
+        Set<String> wanted = Set.of(authorities);
+        for (GrantedAuthority grantedAuthority : authentication.getAuthorities()) {
+            if (wanted.contains(grantedAuthority.getAuthority())) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
