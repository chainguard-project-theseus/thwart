diff --git a/src/main/java/de/fred4jupiter/fredbet/web/view/ViewFunctions.java b/src/main/java/de/fred4jupiter/fredbet/web/view/ViewFunctions.java
new file mode 100644
index 00000000..190076e1
--- /dev/null
+++ b/src/main/java/de/fred4jupiter/fredbet/web/view/ViewFunctions.java
@@ -0,0 +1,201 @@
+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.domain.Country;
+import de.fred4jupiter.fredbet.domain.Group;
+import de.fred4jupiter.fredbet.points.ExtraPointsConfiguration;
+import de.fred4jupiter.fredbet.settings.RuntimeSettings;
+import de.fred4jupiter.fredbet.web.GroupAvailabilityUtil;
+import de.fred4jupiter.fredbet.web.LanguageUtil;
+import de.fred4jupiter.fredbet.web.RuntimeSettingsUtil;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.bet.BettingWebUtil;
+import de.fred4jupiter.fredbet.web.util.LanguageIconUtil;
+import de.fred4jupiter.fredbet.web.util.TeamUtil;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.context.MessageSource;
+import org.springframework.context.NoSuchMessageException;
+import org.springframework.context.i18n.LocaleContextHolder;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.GrantedAuthority;
+import org.springframework.security.core.context.SecurityContextHolder;
+
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Functions callable from the Tessera templates (namespace {@code fb}). They replace the Spring bean
+ * references ({@code ${@bean.method()}}), dynamic message keys and {@code sec:authorize} of the
+ * former Thymeleaf templates.
+ */
+@TemplateFunctions("fb")
+public final class ViewFunctions {
+
+    private ViewFunctions() {
+    }
+
+    private static ViewBeans beans() {
+        return ViewBeans.instance();
+    }
+
+    // ---- messages ----
+
+    /**
+     * Resolves a message whose key is computed at runtime (Thymeleaf: {@code #{${key}}}).
+     */
+    @TemplateFunction
+    public static String msg(String key) {
+        return resolve(key, new Object[0]);
+    }
+
+    @TemplateFunction
+    public static String msg(String key, Object arg) {
+        return resolve(key, new Object[]{arg});
+    }
+
+    private static String resolve(String key, Object[] args) {
+        if (key == null) {
+            return "";
+        }
+        Locale locale = LocaleContextHolder.getLocale();
+        MessageSource messageSource = beans().messageSource();
+        try {
+            return messageSource.getMessage(key, args, locale);
+        } catch (NoSuchMessageException e) {
+            return "??" + key + "_" + locale + "??";
+        }
+    }
+
+    /**
+     * Formats a date/time with the current request locale (Thymeleaf: {@code #temporals.format}).
+     */
+    @TemplateFunction
+    public static String formatTemporal(Object temporal, String pattern) {
+        if (!(temporal instanceof java.time.temporal.TemporalAccessor accessor)) {
+            return "";
+        }
+        return java.time.format.DateTimeFormatter.ofPattern(pattern, LocaleContextHolder.getLocale()).format(accessor);
+    }
+
+    // ---- security ----
+
+    @TemplateFunction
+    public static boolean hasAuthority(String authority) {
+        Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
+        if (authentication == null || authority == null) {
+            return false;
+        }
+        for (GrantedAuthority grantedAuthority : authentication.getAuthorities()) {
+            if (authority.equals(grantedAuthority.getAuthority())) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @TemplateFunction
+    public static boolean hasAnyAuthority(String a, String b, String c) {
+        return hasAuthority(a) || hasAuthority(b) || hasAuthority(c);
+    }
+
+    @TemplateFunction
+    public static boolean loggedIn() {
+        return beans().webSecurityUtil().isUserLoggedIn();
+    }
+
+    @TemplateFunction
+    public static String currentUsername() {
+        return beans().webSecurityUtil().getCurrentUsername();
+    }
+
+    @TemplateFunction
+    public static String currentUserProfileImageKey() {
+        return beans().webSecurityUtil().getCurrentUserProfileImageKey();
+    }
+
+    @TemplateFunction
+    public static String profileImageKey(String username) {
+        return beans().webSecurityUtil().getUserProfileImageKeyFor(username);
+    }
+
+    @TemplateFunction
+    public static boolean roleSelectionDisabled(String username) {
+        return beans().webSecurityUtil().isRoleSelectionDisabledForUser(username);
+    }
+
+    @TemplateFunction
+    public static boolean demoDataMenuEntryEnabled() {
+        return beans().webSecurityUtil().isDemoDataMenuEntryEnabled();
+    }
+
+    @TemplateFunction
+    public static String h2Path() {
+        return beans().webSecurityUtil().resolveH2Path();
+    }
+
+    // ---- settings ----
+
+    @TemplateFunction
+    public static RuntimeSettings settings() {
+        return beans().runtimeSettingsUtil().getSettings();
+    }
+
+    @TemplateFunction
+    public static ExtraPointsConfiguration extraPointsConfig() {
+        return beans().runtimeSettingsUtil().getExtraPointsConfig();
+    }
+
+    @TemplateFunction
+    public static boolean h2ConsoleEnabled() {
+        return beans().runtimeSettingsUtil().isH2ConsoleEnabled();
+    }
+
+    @TemplateFunction
+    public static boolean bettable() {
+        return beans().bettingWebUtil().isBettable();
+    }
+
+    // ---- groups ----
+
+    @TemplateFunction
+    public static List<Group> mainGroups() {
+        return beans().groupAvailabilityUtil().getMainGroups();
+    }
+
+    @TemplateFunction
+    public static boolean groupAvailable(String groupName) {
+        return beans().groupAvailabilityUtil().isGroupAvailable(groupName);
+    }
+
+    @TemplateFunction
+    public static boolean knockOutMatchesAvailable() {
+        return beans().groupAvailabilityUtil().isKnockOutMatchesAvailable();
+    }
+
+    // ---- teams, flags and languages ----
+
+    @TemplateFunction
+    public static String teamCss(Country country) {
+        return beans().teamUtil().cssClassFor(country);
+    }
+
+    @TemplateFunction
+    public static String teamName(Country country) {
+        return beans().teamUtil().i18n(country);
+    }
+
+    @TemplateFunction
+    public static String flagCss(String alpha2Code) {
+        return beans().languageIconUtil().cssClassFor(alpha2Code);
+    }
+
+    @TemplateFunction
+    public static String currentLanguageCss() {
+        return beans().languageIconUtil().cssClassCurrentUserLanguage();
+    }
+
+    @TemplateFunction
+    public static String languageUrl(String languageCode) {
+        return beans().languageUtil().buildUrl(languageCode);
+    }
+}
