+package de.fred4jupiter.fredbet.web.info;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Small lenient HTML parser for the rich text of the info pages (written by the summernote editor). It
+ * builds a tree of {@link HtmlNode}s; script and style content and comments are dropped. Rendering the
+ * tree (and deciding which elements and attributes are printed) is done by the template
+ * {@code info/html_content}, which escapes every text and attribute value.
+ */
+public final class HtmlContentParser {
+
+    private static final Set<String> VOID_ELEMENTS = Set.of("area", "base", "br", "col", "embed", "hr", "img", "input",
+        "link", "meta", "source", "track", "wbr");
+
+    private static final Set<String> CLOSES_P = Set.of("address", "article", "aside", "blockquote", "div", "dl",
+        "fieldset", "footer", "form", "h1", "h2", "h3", "h4", "h5", "h6", "header", "hr", "main", "nav", "ol", "p",
+        "pre", "section", "table", "ul");
+
+    private static final Set<String> RAW_TEXT_ELEMENTS = Set.of("script", "style", "textarea", "title");
+
+    private static final Map<String, String> ENTITIES = new HashMap<>();
+
+    static {
+        String[][] entities = {{"nbsp", " "}, {"amp", "&"}, {"lt", "<"}, {"gt", ">"}, {"quot", "\""},
+            {"apos", "'"}, {"euro", "€"}, {"auml", "ä"}, {"ouml", "ö"}, {"uuml", "ü"},
+            {"Auml", "Ä"}, {"Ouml", "Ö"}, {"Uuml", "Ü"}, {"szlig", "ß"}, {"copy", "©"},
+            {"reg", "®"}, {"ndash", "–"}, {"mdash", "—"}, {"hellip", "…"},
+            {"laquo", "«"}, {"raquo", "»"}, {"bdquo", "„"}, {"ldquo", "“"},
+            {"rdquo", "”"}, {"lsquo", "‘"}, {"rsquo", "’"}, {"sbquo", "‚"},
+            {"deg", "°"}, {"middot", "·"}, {"bull", "•"}, {"times", "×"},
+            {"eacute", "é"}, {"egrave", "è"}, {"agrave", "à"}, {"aacute", "á"},
+            {"ccedil", "ç"}, {"ntilde", "ñ"}, {"oacute", "ó"}, {"iacute", "í"},
+            {"uacute", "ú"}, {"ecirc", "ê"}, {"sect", "§"}, {"para", "¶"},
+            {"shy", "­"}, {"frac12", "½"}, {"frac14", "¼"}, {"frac34", "¾"}};
+        for (String[] entity : entities) {
+            ENTITIES.put(entity[0], entity[1]);
+        }
+    }
+
+    private HtmlContentParser() {
+    }
+
+    public static List<HtmlNode> parse(String html) {
+        if (html == null || html.isEmpty()) {
+            return List.of();
+        }
+        return new Builder(html).parse();
+    }
+
+    private static final class Element {
+        final String tag;
+        final Map<String, String> attrs;
+        final List<Object> children = new ArrayList<>();
+
+        Element(String tag, Map<String, String> attrs) {
+            this.tag = tag;
+            this.attrs = attrs;
+        }
+
+        HtmlNode toNode() {
+            List<HtmlNode> nodes = new ArrayList<>();
+            for (Object child : children) {
+                nodes.add(child instanceof Element element ? element.toNode() : (HtmlNode) child);
+            }
+            return new HtmlNode(tag, attrs, null, nodes);
+        }
+    }
+
+    private static final class Builder {
+        private final String html;
+        private int pos;
+        private final List<Element> stack = new ArrayList<>();
+        private final Element root = new Element(null, Map.of());
+        private final StringBuilder text = new StringBuilder();
+
+        Builder(String html) {
+            this.html = html;
+            stack.add(root);
+        }
+
+        List<HtmlNode> parse() {
+            while (pos < html.length()) {
+                char c = html.charAt(pos);
+                if (c == '<' && startsTag()) {
+                    flushText();
+                    readMarkup();
+                } else {
+                    text.append(c);
+                    pos++;
+                }
+            }
+            flushText();
+            return root.toNode().children();
+        }
+
+        private boolean startsTag() {
+            if (pos + 1 >= html.length()) {
+                return false;
+            }
+            char next = html.charAt(pos + 1);
+            return Character.isLetter(next) || next == '/' || next == '!' || next == '?';
+        }
+
+        private Element current() {
+            return stack.get(stack.size() - 1);
+        }
+
+        private void flushText() {
+            if (!text.isEmpty()) {
+                current().children.add(HtmlNode.text(decode(text.toString())));
+                text.setLength(0);
+            }
+        }
+
+        private void readMarkup() {
+            if (html.startsWith("<!--", pos)) {
+                int end = html.indexOf("-->", pos + 4);
+                pos = end < 0 ? html.length() : end + 3;
+                return;
+            }
+            char next = html.charAt(pos + 1);
+            if (next == '!' || next == '?') {
+                int end = html.indexOf('>', pos);
+                pos = end < 0 ? html.length() : end + 1;
+                return;
+            }
+            if (next == '/') {
+                int end = html.indexOf('>', pos);
+                String name = html.substring(pos + 2, end < 0 ? html.length() : end).trim().toLowerCase(Locale.ROOT);
+                pos = end < 0 ? html.length() : end + 1;
+                close(name);
+                return;
+            }
+            readStartTag();
+        }
+
+        private void close(String name) {
+            for (int i = stack.size() - 1; i > 0; i--) {
+                if (stack.get(i).tag.equals(name)) {
+                    while (stack.size() > i) {
+                        stack.remove(stack.size() - 1);
+                    }
+                    return;
+                }
+            }
+        }
+
+        private void readStartTag() {
+            pos++;
+            int start = pos;
+            while (pos < html.length() && !Character.isWhitespace(html.charAt(pos)) && html.charAt(pos) != '>'
+                && html.charAt(pos) != '/') {
+                pos++;
+            }
+            String name = html.substring(start, pos).toLowerCase(Locale.ROOT);
+            Map<String, String> attrs = new LinkedHashMap<>();
+            boolean selfClosing = false;
+            while (pos < html.length()) {
+                char c = html.charAt(pos);
+                if (c == '>') {
+                    pos++;
+                    break;
+                }
+                if (c == '/' || Character.isWhitespace(c)) {
+                    selfClosing = c == '/';
+                    pos++;
+                    continue;
+                }
+                selfClosing = false;
+                readAttribute(attrs);
+            }
+
+            if (RAW_TEXT_ELEMENTS.contains(name)) {
+                int end = html.toLowerCase(Locale.ROOT).indexOf("</" + name, pos);
+                if (end < 0) {
+                    pos = html.length();
+                } else {
+                    int gt = html.indexOf('>', end);
+                    pos = gt < 0 ? html.length() : gt + 1;
+                }
+                return;
+            }
+
+            if (CLOSES_P.contains(name) && "p".equals(current().tag)) {
+                stack.remove(stack.size() - 1);
+            }
+            if ("li".equals(name)) {
+                closeIfOpenWithin("li", Set.of("ul", "ol"));
+            }
+            Element element = new Element(name, attrs);
+            current().children.add(element);
+            if (!selfClosing && !VOID_ELEMENTS.contains(name)) {
+                stack.add(element);
+            }
+        }
+
+        private void closeIfOpenWithin(String tag, Set<String> scope) {
+            for (int i = stack.size() - 1; i > 0; i--) {
+                String open = stack.get(i).tag;
+                if (scope.contains(open)) {
+                    return;
+                }
+                if (open.equals(tag)) {
+                    while (stack.size() > i) {
+                        stack.remove(stack.size() - 1);
+                    }
+                    return;
+                }
+            }
+        }
+
+        private void readAttribute(Map<String, String> attrs) {
+            int start = pos;
+            while (pos < html.length() && !Character.isWhitespace(html.charAt(pos)) && html.charAt(pos) != '='
+                && html.charAt(pos) != '>' && html.charAt(pos) != '/') {
+                pos++;
+            }
+            String name = html.substring(start, pos).toLowerCase(Locale.ROOT);
+            while (pos < html.length() && Character.isWhitespace(html.charAt(pos))) {
+                pos++;
+            }
+            String value = "";
+            if (pos < html.length() && html.charAt(pos) == '=') {
+                pos++;
+                while (pos < html.length() && Character.isWhitespace(html.charAt(pos))) {
+                    pos++;
+                }
+                if (pos < html.length() && (html.charAt(pos) == '"' || html.charAt(pos) == '\'')) {
+                    char quote = html.charAt(pos);
+                    int end = html.indexOf(quote, pos + 1);
+                    if (end < 0) {
+                        end = html.length();
+                    }
+                    value = html.substring(pos + 1, end);
+                    pos = Math.min(end + 1, html.length());
+                } else {
+                    int valueStart = pos;
+                    while (pos < html.length() && !Character.isWhitespace(html.charAt(pos)) && html.charAt(pos) != '>') {
+                        pos++;
+                    }
+                    value = html.substring(valueStart, pos);
+                }
+            }
+            if (!name.isEmpty() && !attrs.containsKey(name)) {
+                attrs.put(name, decode(value));
+            }
+        }
+    }
+
+    static String decode(String text) {
+        if (text.indexOf('&') < 0) {
+            return text;
+        }
+        StringBuilder out = new StringBuilder(text.length());
+        int i = 0;
+        while (i < text.length()) {
+            char c = text.charAt(i);
+            if (c == '&') {
+                int semi = text.indexOf(';', i);
+                if (semi > i + 1 && semi - i <= 10) {
+                    String name = text.substring(i + 1, semi);
+                    String replacement = null;
+                    if (name.startsWith("#x") || name.startsWith("#X")) {
+                        replacement = codePoint(name.substring(2), 16);
+                    } else if (name.startsWith("#")) {
+                        replacement = codePoint(name.substring(1), 10);
+                    } else {
+                        replacement = ENTITIES.get(name);
+                    }
+                    if (replacement != null) {
+                        out.append(replacement);
+                        i = semi + 1;
+                        continue;
+                    }
+                }
+            }
+            out.append(c);
+            i++;
+        }
+        return out.toString();
+    }
+
+    private static String codePoint(String digits, int radix) {
+        try {
+            int codePoint = Integer.parseInt(digits, radix);
+            return Character.isValidCodePoint(codePoint) && codePoint != 0 ? new String(Character.toChars(codePoint)) : null;
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+}
