+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.web.GroupAvailabilityUtil;
+import de.fred4jupiter.fredbet.web.LanguageUtil;
+import de.fred4jupiter.fredbet.web.RuntimeSettingsUtil;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.bet.BettingWebUtil;
+import de.fred4jupiter.fredbet.web.util.LanguageIconUtil;
+import de.fred4jupiter.fredbet.web.util.TeamUtil;
+import org.springframework.context.MessageSource;
+import org.springframework.stereotype.Component;
+
+/**
+ * Gives the static {@link ViewFunctions} access to the helper beans the templates used to reference directly.
+ */
+@Component
+public class ViewBeans {
+
+    private static volatile ViewBeans instance;
+
+    private final MessageSource messageSource;
+    private final WebSecurityUtil webSecurityUtil;
+    private final RuntimeSettingsUtil runtimeSettingsUtil;
+    private final GroupAvailabilityUtil groupAvailabilityUtil;
+    private final TeamUtil teamUtil;
+    private final LanguageIconUtil languageIconUtil;
+    private final LanguageUtil languageUtil;
+    private final BettingWebUtil bettingWebUtil;
+
+    public ViewBeans(MessageSource messageSource, WebSecurityUtil webSecurityUtil, RuntimeSettingsUtil runtimeSettingsUtil,
+                     GroupAvailabilityUtil groupAvailabilityUtil, TeamUtil teamUtil, LanguageIconUtil languageIconUtil,
+                     LanguageUtil languageUtil, BettingWebUtil bettingWebUtil) {
+        this.messageSource = messageSource;
+        this.webSecurityUtil = webSecurityUtil;
+        this.runtimeSettingsUtil = runtimeSettingsUtil;
+        this.groupAvailabilityUtil = groupAvailabilityUtil;
+        this.teamUtil = teamUtil;
+        this.languageIconUtil = languageIconUtil;
+        this.languageUtil = languageUtil;
+        this.bettingWebUtil = bettingWebUtil;
+        instance = this;
+    }
+
+    static ViewBeans instance() {
+        ViewBeans current = instance;
+        if (current == null) {
+            throw new IllegalStateException("ViewBeans not initialized");
+        }
+        return current;
+    }
+
+    MessageSource messageSource() { return messageSource; }
+    WebSecurityUtil webSecurityUtil() { return webSecurityUtil; }
+    RuntimeSettingsUtil runtimeSettingsUtil() { return runtimeSettingsUtil; }
+    GroupAvailabilityUtil groupAvailabilityUtil() { return groupAvailabilityUtil; }
+    TeamUtil teamUtil() { return teamUtil; }
+    LanguageIconUtil languageIconUtil() { return languageIconUtil; }
+    LanguageUtil languageUtil() { return languageUtil; }
+    BettingWebUtil bettingWebUtil() { return bettingWebUtil; }
