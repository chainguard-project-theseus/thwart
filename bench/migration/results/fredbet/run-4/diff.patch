+ * fragment {@code fragments/rich_html :: nodes}.
+ *
+ * @param tag      the lower case element name, or {@link #TEXT} for a text node
+ * @param text     the (unescaped) text of a text node, otherwise {@code null}
+ * @param attrs    the whitelisted attributes of an element (name to value)
+ * @param children the child nodes of an element
+ */
+public record HtmlNode(String tag, String text, Map<String, String> attrs, List<HtmlNode> children) {
+
+    public static final String TEXT = "#text";
+
+    public static HtmlNode text(String text) {
+        return new HtmlNode(TEXT, text, Map.of(), List.of());
+    }
+}
