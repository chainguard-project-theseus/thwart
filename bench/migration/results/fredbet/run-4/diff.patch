+								  		<span> : </span>
+							  			<span class="badge rounded-pill bg-success big-badge" t:classappend="matchCommand.getUserBetGoalsTeamTwoCssClasses()"
+							  			      t:text="matchCommand.userBetGoalsTeamTwo != null ? '' + matchCommand.userBetGoalsTeamTwo : '?'"></span>
+					  				</div>
