+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.domain.Country;
+import de.fred4jupiter.fredbet.domain.Group;
+import de.fred4jupiter.fredbet.points.ExtraPointsConfiguration;
+import de.fred4jupiter.fredbet.settings.RuntimeSettings;
+import de.fred4jupiter.fredbet.web.GroupAvailabilityUtil;
+import de.fred4jupiter.fredbet.web.LanguageUtil;
+import de.fred4jupiter.fredbet.web.RuntimeSettingsUtil;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.bet.BettingWebUtil;
+import de.fred4jupiter.fredbet.web.util.LanguageIconUtil;
+import de.fred4jupiter.fredbet.web.util.TeamUtil;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.context.MessageSource;
+import org.springframework.context.NoSuchMessageException;
+import org.springframework.context.i18n.LocaleContextHolder;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.GrantedAuthority;
+import org.springframework.security.core.context.SecurityContextHolder;
+
+import java.time.format.DateTimeFormatter;
+import java.time.temporal.TemporalAccessor;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Template functions (namespace {@code fb}) for the Tessera views. They replace the Spring bean references,
+ * dynamic message keys and {@code sec:authorize} checks of the former Thymeleaf templates.
+ */
+@TemplateFunctions("fb")
+public final class ViewFunctions {
+
+    private ViewFunctions() {
+    }
+
+    // ---- messages ----------------------------------------------------------------------------
+
+    /**
+     * Looks up a message whose key is computed at runtime (not checked at build time).
+     */
+    @TemplateFunction
+    public static String msg(String key) {
+        return message(key);
+    }
+
+    @TemplateFunction
+    public static String msgArg(String key, Object arg) {
+        return message(key, arg);
+    }
+
+    @TemplateFunction
+    public static String msgArgs(String key, Object arg1, Object arg2) {
+        return message(key, arg1, arg2);
+    }
+
+    private static String message(String key, Object... args) {
+        if (key == null) {
+            return "";
+        }
+        Locale locale = LocaleContextHolder.getLocale();
+        try {
+            return ViewSupport.bean(MessageSource.class).getMessage(key, args, locale);
+        } catch (NoSuchMessageException e) {
+            return "??" + key + "_" + locale + "??";
+        }
+    }
+
+    /**
+     * Formats a date with the current locale (as Thymeleaf's #temporals.format did).
+     */
+    @TemplateFunction
+    public static String formatDate(Object temporal, String pattern) {
+        if (!(temporal instanceof TemporalAccessor accessor)) {
+            return "";
+        }
+        return DateTimeFormatter.ofPattern(pattern, LocaleContextHolder.getLocale()).format(accessor);
+    }
+
+    // ---- security ----------------------------------------------------------------------------
+
+    @TemplateFunction
+    public static boolean hasAuthority(String authority) {
+        return hasAnyAuthority(authority);
+    }
+
+    /**
+     * @param authorities comma separated list of authorities
+     */
+    @TemplateFunction
+    public static boolean hasAnyAuthority(String authorities) {
+        Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
+        if (authentication == null || authorities == null) {
+            return false;
+        }
+        List<String> wanted = Arrays.stream(authorities.split(",")).map(String::trim).toList();
+        return authentication.getAuthorities().stream().map(GrantedAuthority::getAuthority).anyMatch(wanted::contains);
+    }
+
+    @TemplateFunction
+    public static boolean loggedIn() {
+        return ViewSupport.bean(WebSecurityUtil.class).isUserLoggedIn();
+    }
+
+    @TemplateFunction
+    public static String currentUsername() {
+        return ViewSupport.bean(WebSecurityUtil.class).getCurrentUsername();
+    }
+
+    @TemplateFunction
+    public static String currentProfileImageKey() {
+        return ViewSupport.bean(WebSecurityUtil.class).getCurrentUserProfileImageKey();
+    }
+
+    @TemplateFunction
+    public static String profileImageKey(String username) {
+        return ViewSupport.bean(WebSecurityUtil.class).getUserProfileImageKeyFor(username);
+    }
+
+    @TemplateFunction
+    public static boolean roleSelectionDisabled(String username) {
+        return ViewSupport.bean(WebSecurityUtil.class).isRoleSelectionDisabledForUser(username);
+    }
+
+    @TemplateFunction
+    public static boolean demoDataMenuEnabled() {
+        return ViewSupport.bean(WebSecurityUtil.class).isDemoDataMenuEntryEnabled();
+    }
+
+    @TemplateFunction
+    public static String h2Path() {
+        return ViewSupport.bean(WebSecurityUtil.class).resolveH2Path();
+    }
+
+    // ---- settings ----------------------------------------------------------------------------
+
+    @TemplateFunction
+    public static RuntimeSettings settings() {
+        return ViewSupport.bean(RuntimeSettingsUtil.class).getSettings();
+    }
+
+    @TemplateFunction
+    public static ExtraPointsConfiguration extraPointsConfig() {
+        return ViewSupport.bean(RuntimeSettingsUtil.class).getExtraPointsConfig();
+    }
+
+    @TemplateFunction
+    public static boolean h2ConsoleEnabled() {
+        return ViewSupport.bean(RuntimeSettingsUtil.class).isH2ConsoleEnabled();
+    }
+
+    // ---- matches and teams -------------------------------------------------------------------
+
+    @TemplateFunction
+    public static boolean groupAvailable(String groupName) {
+        return ViewSupport.bean(GroupAvailabilityUtil.class).isGroupAvailable(groupName);
+    }
+
+    @TemplateFunction
+    public static boolean knockOutMatchesAvailable() {
+        return ViewSupport.bean(GroupAvailabilityUtil.class).isKnockOutMatchesAvailable();
+    }
+
+    @TemplateFunction
+    public static List<Group> mainGroups() {
+        return ViewSupport.bean(GroupAvailabilityUtil.class).getMainGroups();
+    }
+
+    @TemplateFunction
+    public static boolean bettable() {
+        return ViewSupport.bean(BettingWebUtil.class).isBettable();
+    }
+
+    @TemplateFunction
+    public static String teamCss(Country country) {
+        return ViewSupport.bean(TeamUtil.class).cssClassFor(country);
+    }
+
+    /**
+     * Translated team name of a country (replaces {@code @teamUtil.i18n(country)}); empty for null.
+     */
+    @TemplateFunction
+    public static String teamName(Country country) {
+        return ViewSupport.bean(TeamUtil.class).i18n(country);
+    }
+
+    @TemplateFunction
+    public static String teamCssCode(String alpha2Code) {
+        return ViewSupport.bean(TeamUtil.class).cssClassFor(alpha2Code);
+    }
+
+    // ---- languages ---------------------------------------------------------------------------
+
+    @TemplateFunction
+    public static String languageUrl(String languageCode) {
+        return ViewSupport.bean(LanguageUtil.class).buildUrl(languageCode);
+    }
+
+    @TemplateFunction
+    public static String languageCss(String alpha2Code) {
+        return ViewSupport.bean(LanguageIconUtil.class).cssClassFor(alpha2Code);
+    }
+
+    @TemplateFunction
+    public static String currentLanguageCss() {
+        return ViewSupport.bean(LanguageIconUtil.class).cssClassCurrentUserLanguage();
+    }
+}
