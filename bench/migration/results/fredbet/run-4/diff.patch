@@ -0,0 +1,31 @@
+package de.fred4jupiter.fredbet.web.view;
+
+import org.springframework.beans.BeansException;
+import org.springframework.context.ApplicationContext;
+import org.springframework.context.ApplicationContextAware;
+import org.springframework.stereotype.Component;
+
+/**
+ * Gives the static Tessera template functions in {@link ViewFunctions} access to the application's beans.
+ */
+@Component
+public class ViewSupport implements ApplicationContextAware {
+
+    private static ApplicationContext applicationContext;
+
+    @Override
+    public void setApplicationContext(ApplicationContext context) throws BeansException {
+        setContext(context);
+    }
+
+    private static synchronized void setContext(ApplicationContext context) {
+        applicationContext = context;
+    }
+
+    static <T> T bean(Class<T> type) {
+        if (applicationContext == null) {
+            throw new IllegalStateException("application context not yet available");
+        }
+        return applicationContext.getBean(type);
+    }
+}
