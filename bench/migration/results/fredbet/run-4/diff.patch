+                                            <span class="fas fa-trophy"></span>
+                                        </a>
+                                    </div>
+	       						</div>
+       						</div>
+					   </div>
+					</div>
+				</div>
+			</div>
+			<a t:if="fb.hasAuthority('PERM_CREATE_MATCH')" href="#" t:href="@{/match/create}" class="btn btn-primary" role="button" t:text="#{matches.list.createMatch}"></a>
+	</div>
+</body>
+</html>
