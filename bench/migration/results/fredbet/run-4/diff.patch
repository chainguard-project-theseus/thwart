diff --git a/src/main/java/de/fred4jupiter/fredbet/web/info/RichTextParser.java b/src/main/java/de/fred4jupiter/fredbet/web/info/RichTextParser.java
new file mode 100644
index 00000000..43b75916
--- /dev/null
+++ b/src/main/java/de/fred4jupiter/fredbet/web/info/RichTextParser.java
@@ -0,0 +1,82 @@
+package de.fred4jupiter.fredbet.web.info;
+
+import org.jsoup.Jsoup;
+import org.jsoup.nodes.Attribute;
+import org.jsoup.nodes.Element;
+import org.jsoup.nodes.Node;
+import org.jsoup.nodes.TextNode;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Parses admin-edited HTML (info pages) into a tree of {@link HtmlNode}s that contains only whitelisted elements and
+ * attributes. The template renders the tree with literal tag names, so the text is escaped and URLs are checked by
+ * the template engine; no raw markup is ever printed.
+ */
+public final class RichTextParser {
+
+    /** Elements that are rendered (each one has a case in fragments/rich_html.html). */
+    static final Set<String> ALLOWED_TAGS = Set.of("p", "br", "hr", "b", "strong", "i", "em", "u", "s", "strike",
+            "sub", "sup", "small", "mark", "h1", "h2", "h3", "h4", "h5", "h6", "ul", "ol", "li", "a", "span", "div",
+            "blockquote", "pre", "code", "table", "caption", "thead", "tbody", "tfoot", "tr", "td", "th", "img");
+
+    /** Elements that are dropped together with their content. Any other unknown element is unwrapped. */
+    private static final Set<String> DROPPED_TAGS = Set.of("script", "style", "iframe", "frame", "frameset", "object",
+            "embed", "applet", "noscript", "template", "head", "title", "meta", "link", "base", "form", "input",
+            "button", "select", "option", "textarea", "svg", "math", "video", "audio", "source", "canvas");
+
+    private static final Set<String> GLOBAL_ATTRS = Set.of("id", "class", "title", "dir");
+
+    private static final Map<String, Set<String>> TAG_ATTRS = Map.of(
+            "a", Set.of("href", "target", "rel", "name"),
+            "img", Set.of("src", "alt", "width", "height"),
+            "td", Set.of("colspan", "rowspan"),
+            "th", Set.of("colspan", "rowspan"),
+            "ol", Set.of("start", "type"),
+            "li", Set.of("value"));
+
+    private RichTextParser() {
+    }
+
+    public static List<HtmlNode> parse(String html) {
+        if (html == null || html.isBlank()) {
+            return List.of();
+        }
+        return convert(Jsoup.parseBodyFragment(html).body().childNodes());
+    }
+
+    private static List<HtmlNode> convert(List<Node> nodes) {
+        List<HtmlNode> result = new ArrayList<>();
+        for (Node node : nodes) {
+            if (node instanceof TextNode textNode) {
+                result.add(HtmlNode.text(textNode.getWholeText()));
+            } else if (node instanceof Element element) {
+                String tag = element.normalName();
+                if (ALLOWED_TAGS.contains(tag)) {
+                    result.add(new HtmlNode(tag, null, attributesOf(tag, element), convert(element.childNodes())));
+                } else if (!DROPPED_TAGS.contains(tag)) {
+                    result.addAll(convert(element.childNodes()));
+                }
+            }
+            // comments, doctype, data nodes: dropped
+        }
+        return Collections.unmodifiableList(result);
+    }
+
+    private static Map<String, String> attributesOf(String tag, Element element) {
+        Set<String> tagAttrs = TAG_ATTRS.getOrDefault(tag, Set.of());
+        Map<String, String> attrs = new LinkedHashMap<>();
+        for (Attribute attribute : element.attributes()) {
+            String name = attribute.getKey().toLowerCase();
+            if (GLOBAL_ATTRS.contains(name) || tagAttrs.contains(name)) {
+                attrs.putIfAbsent(name, attribute.getValue());
+            }
+        }
+        return Collections.unmodifiableMap(attrs);
+    }
+}
