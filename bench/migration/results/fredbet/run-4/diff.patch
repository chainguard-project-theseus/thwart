+package de.fred4jupiter.fredbet.config;
+
+import org.springframework.boot.web.error.ErrorAttributeOptions;
+import org.springframework.boot.web.servlet.error.DefaultErrorAttributes;
+import org.springframework.boot.web.servlet.error.ErrorAttributes;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.web.context.request.WebRequest;
+
+import java.util.Map;
+
+/**
+ * Adds the timestamp of an error as text, because the error page template cannot read a {@link java.util.Date}.
+ */
+@Configuration
+public class ErrorPageConfig {
+
+    @Bean
+    public ErrorAttributes errorAttributes() {
+        return new DefaultErrorAttributes() {
+            @Override
+            public Map<String, Object> getErrorAttributes(WebRequest webRequest, ErrorAttributeOptions options) {
+                Map<String, Object> attributes = super.getErrorAttributes(webRequest, options);
+                Object timestamp = attributes.get("timestamp");
+                if (timestamp != null) {
+                    attributes.put("timestampText", timestamp.toString());
+                }
+                return attributes;
+            }
+        };
+    }
+}
