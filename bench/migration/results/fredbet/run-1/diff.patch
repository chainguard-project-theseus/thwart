--- /dev/null
+++ b/src/main/java/de/fred4jupiter/fredbet/web/info/RichTextNode.java
@@ -0,0 +1,19 @@
+package de.fred4jupiter.fredbet.web.info;
+
+import java.util.List;
+
+/**
+ * A node of sanitized, admin edited rich text (see {@link RichTextParser}). Either a text node ({@code tag == null},
+ * {@code text} is the decoded text) or an allow-listed element with allow-listed attributes (null = absent).
+ * Rendered by the template fragment {@code info/rich_text :: nodes}, which escapes every value.
+ */
+public record RichTextNode(String tag, String text, String href, String target, String rel, String title, String alt,
+                           String src, String width, String height, String cssClass, String value, String start,
+                           String type, String colspan, String rowspan, String align, String color, String face,
+                           String size, List<RichTextNode> children) {
+
+    public static RichTextNode text(String text) {
+        return new RichTextNode(null, text, null, null, null, null, null, null, null, null, null, null, null, null,
+                null, null, null, null, null, null, List.of());
+    }
+}
diff --git a/src/main/java/de/fred4jupiter/fredbet/web/info/RichTextParser.java b/src/main/java/de/fred4jupiter/fredbet/web/info/RichTextParser.java
new file mode 100644
index 00000000..912f4406
--- /dev/null
+++ b/src/main/java/de/fred4jupiter/fredbet/web/info/RichTextParser.java
@@ -0,0 +1,379 @@
+package de.fred4jupiter.fredbet.web.info;
+
+import org.apache.commons.lang3.StringEscapeUtils;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Deque;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Parses the admin edited rich text of the info pages (Summernote output) into a tree of {@link RichTextNode}s,
+ * keeping only allow-listed elements and attributes. The tree is rendered by the template fragment
+ * {@code info/rich_text :: nodes}, which writes every text and attribute value through Tessera's escapers (URLs
+ * are checked by Tessera too), so no raw HTML ever reaches the page.
+ * <ul>
+ *     <li>allow-listed elements are kept with their allow-listed attributes,</li>
+ *     <li>active/embedded content ({@code script}, {@code style}, {@code iframe}, ...) is dropped with its content,</li>
+ *     <li>every other element (e.g. {@code span} with style) is unwrapped: its content is kept,</li>
+ *     <li>comments, doctype and processing instructions are dropped; style and event handler attributes are dropped.</li>
+ * </ul>
+ */
+public final class RichTextParser {
+
+    private static final int MAX_DEPTH = 64;
+
+    private static final Set<String> ALLOWED = Set.of("p", "div", "span", "br", "hr", "b", "strong", "i", "em", "u",
+            "s", "strike", "del", "ins", "sub", "sup", "small", "big", "mark", "code", "kbd", "samp", "var", "pre",
+            "blockquote", "q", "cite", "abbr", "h1", "h2", "h3", "h4", "h5", "h6", "ul", "ol", "li", "dl", "dt", "dd",
+            "a", "img", "table", "caption", "thead", "tbody", "tfoot", "tr", "th", "td", "font", "center");
+
+    private static final Set<String> VOID = Set.of("br", "hr", "img", "wbr", "area", "base", "col", "embed", "input",
+            "link", "meta", "param", "source", "track", "keygen", "basefont", "frame", "isindex");
+
+    /** Elements whose content is not markup: it is skipped up to the matching end tag. */
+    private static final Set<String> RAW_TEXT = Set.of("script", "style", "textarea", "title", "xmp", "iframe",
+            "noembed", "noframes", "noscript", "plaintext");
+
+    /** Elements dropped together with their content. */
+    private static final Set<String> DROP = Set.of("svg", "math", "select", "template", "object", "applet",
+            "frameset", "head", "form", "button", "option", "optgroup", "datalist", "audio", "video", "picture",
+            "canvas", "map", "dialog");
+
+    private static final Set<String> CLOSES_P = Set.of("p", "div", "h1", "h2", "h3", "h4", "h5", "h6", "ul", "ol",
+            "dl", "pre", "blockquote", "table", "hr", "center");
+
+    private static final Set<String> GLOBAL_ATTRS = Set.of("title", "class", "align");
+
+    private static final Map<String, Set<String>> TAG_ATTRS = Map.of(
+            "a", Set.of("href", "target", "rel"),
+            "img", Set.of("src", "alt", "width", "height"),
+            "li", Set.of("value", "type"),
+            "ol", Set.of("start", "type"),
+            "ul", Set.of("type"),
+            "table", Set.of("width"),
+            "td", Set.of("colspan", "rowspan", "width", "height"),
+            "th", Set.of("colspan", "rowspan", "width", "height"),
+            "font", Set.of("color", "face", "size"));
+
+    private RichTextParser() {
+    }
+
+    public static List<RichTextNode> parse(String html) {
+        return new Builder().build(html == null ? "" : html);
+    }
+
+    private static final class Element {
+        private final String tag;
+        private final Map<String, String> attrs;
+        private final List<RichTextNode> children = new ArrayList<>();
+        private final StringBuilder pendingText = new StringBuilder();
+
+        Element(String tag, Map<String, String> attrs) {
+            this.tag = tag;
+            this.attrs = attrs;
+        }
+
+        void addText(String text) {
+            pendingText.append(text);
+        }
+
+        void add(RichTextNode node) {
+            flushText();
+            children.add(node);
+        }
+
+        void flushText() {
+            if (!pendingText.isEmpty()) {
+                children.add(RichTextNode.text(pendingText.toString()));
+                pendingText.setLength(0);
+            }
+        }
+
+        RichTextNode toNode() {
+            flushText();
+            return new RichTextNode(tag, null, attrs.get("href"), attrs.get("target"), attrs.get("rel"),
+                    attrs.get("title"), attrs.get("alt"), attrs.get("src"), attrs.get("width"), attrs.get("height"),
+                    attrs.get("class"), attrs.get("value"), attrs.get("start"), attrs.get("type"), attrs.get("colspan"),
+                    attrs.get("rowspan"), attrs.get("align"), attrs.get("color"), attrs.get("face"), attrs.get("size"),
+                    List.copyOf(children));
+        }
+    }
+
+    private static final class Builder {
+        private final Element root = new Element(null, Map.of());
+        private final Deque<Element> stack = new ArrayDeque<>();
+        private String src;
+        private int pos;
+
+        List<RichTextNode> build(String html) {
+            this.src = html;
+            this.pos = 0;
+            stack.push(root);
+            while (pos < src.length()) {
+                int lt = src.indexOf('<', pos);
+                if (lt < 0) {
+                    text(src.substring(pos));
+                    break;
+                }
+                if (lt > pos) {
+                    text(src.substring(pos, lt));
+                }
+                pos = lt;
+                markup();
+            }
+            while (stack.size() > 1) {
+                close();
+            }
+            return root.toNode().children();
+        }
+
+        private void text(String raw) {
+            stack.peek().addText(decode(raw));
+        }
+
+        private void markup() {
+            int len = src.length();
+            char next = pos + 1 < len ? src.charAt(pos + 1) : 0;
+            if (src.startsWith("<!--", pos)) {
+                int end = src.indexOf("-->", pos + 4);
+                pos = end < 0 ? len : end + 3;
+            } else if (next == '!' || next == '?') {
+                int end = src.indexOf('>', pos);
+                pos = end < 0 ? len : end + 1;
+            } else if (next == '/' && pos + 2 < len && Character.isLetter(src.charAt(pos + 2))) {
+                pos += 2;
+                String name = readName();
+                int end = src.indexOf('>', pos);
+                pos = end < 0 ? len : end + 1;
+                endTag(name);
+            } else if (Character.isLetter(next)) {
+                pos += 1;
+                String name = readName();
+                Map<String, String> attrs = readAttributes();
+                startTag(name, attrs);
+            } else {
+                stack.peek().addText("<");
+                pos += 1;
+            }
+        }
+
+        private String readName() {
+            int start = pos;
+            while (pos < src.length()) {
+                char c = src.charAt(pos);
+                if (Character.isWhitespace(c) || c == '/' || c == '>') {
+                    break;
+                }
+                pos++;
+            }
+            return src.substring(start, pos).toLowerCase(Locale.ROOT);
+        }
+
+        /** Reads attributes up to and including the closing '>'. The first occurrence of a name wins (as in HTML). */
+        private Map<String, String> readAttributes() {
+            Map<String, String> attrs = new LinkedHashMap<>();
+            int len = src.length();
+            while (pos < len) {
+                char c = src.charAt(pos);
+                if (c == '>') {
+                    pos++;
+                    return attrs;
+                }
+                if (Character.isWhitespace(c) || c == '/') {
+                    pos++;
+                    continue;
+                }
+                int start = pos;
+                while (pos < len) {
+                    char n = src.charAt(pos);
+                    if (Character.isWhitespace(n) || n == '/' || n == '>' || (n == '=' && pos > start)) {
+                        break;
+                    }
+                    pos++;
+                }
+                String name = src.substring(start, pos).toLowerCase(Locale.ROOT);
+                while (pos < len && Character.isWhitespace(src.charAt(pos))) {
+                    pos++;
+                }
+                String value = "";
+                if (pos < len && src.charAt(pos) == '=') {
+                    pos++;
+                    while (pos < len && Character.isWhitespace(src.charAt(pos))) {
+                        pos++;
+                    }
+                    if (pos < len && (src.charAt(pos) == '"' || src.charAt(pos) == '\'')) {
+                        char quote = src.charAt(pos);
+                        int end = src.indexOf(quote, pos + 1);
+                        if (end < 0) {
+                            end = len;
+                        }
+                        value = src.substring(pos + 1, end);
+                        pos = Math.min(len, end + 1);
+                    } else {
+                        int vs = pos;
+                        while (pos < len && !Character.isWhitespace(src.charAt(pos)) && src.charAt(pos) != '>') {
+                            pos++;
+                        }
+                        value = src.substring(vs, pos);
+                    }
+                }
+                attrs.putIfAbsent(name, decode(value));
+            }
+            return attrs;
+        }
+
+        private void startTag(String name, Map<String, String> attrs) {
+            if (RAW_TEXT.contains(name)) {
+                skipRawText(name);
+                return;
+            }
+            if (DROP.contains(name)) {
+                if (!VOID.contains(name)) {
+                    skipElement(name);
+                }
+                return;
+            }
+            if (!ALLOWED.contains(name)) {
+                return; // unwrap: drop the tag, keep its content
+            }
+            implicitlyClose(name);
+            if (stack.size() > MAX_DEPTH && !VOID.contains(name)) {
+                return;
+            }
+            Element element = new Element(name, allowedAttributes(name, attrs));
+            if (VOID.contains(name)) {
+                stack.peek().add(element.toNode());
+            } else {
+                stack.push(element);
+            }
+        }
+
+        private void implicitlyClose(String name) {
+            String top = stack.peek().tag;
+            if (CLOSES_P.contains(name) && "p".equals(top)) {
+                close();
+            } else if ("li".equals(name) && "li".equals(top)) {
+                close();
+            } else if (("dt".equals(name) || "dd".equals(name)) && ("dt".equals(top) || "dd".equals(top))) {
+                close();
+            } else if (("td".equals(name) || "th".equals(name)) && ("td".equals(top) || "th".equals(top))) {
+                close();
+            } else if ("tr".equals(name)) {
+                if ("td".equals(stack.peek().tag) || "th".equals(stack.peek().tag)) {
+                    close();
+                }
+                if ("tr".equals(stack.peek().tag)) {
+                    close();
+                }
+            }
+        }
+
+        private void endTag(String name) {
+            boolean open = false;
+            for (Element element : stack) {
+                if (name.equals(element.tag)) {
+                    open = true;
+                    break;
+                }
+            }
+            if (!open) {
+                return;
+            }
+            while (stack.size() > 1) {
+                String tag = stack.peek().tag;
+                close();
+                if (name.equals(tag)) {
+                    return;
+                }
+            }
+        }
+
+        private void close() {
+            Element element = stack.pop();
+            stack.peek().add(element.toNode());
+        }
+
+        private void skipRawText(String name) {
+            int end = indexOfEndTag(name, pos);
+            pos = end < 0 ? src.length() : afterTag(end);
+        }
+
+        /** Skips a dropped element with its content, honouring nested elements of the same name. */
+        private void skipElement(String name) {
+            int depth = 1;
+            while (depth > 0 && pos < src.length()) {
+                int lt = src.indexOf('<', pos);
+                if (lt < 0) {
+                    pos = src.length();
+                    return;
+                }
+                pos = lt;
+                if (src.startsWith("<!--", pos)) {
+                    int end = src.indexOf("-->", pos + 4);
+                    pos = end < 0 ? src.length() : end + 3;
+                } else if (startsWithTag(pos + 1, name)) {
+                    pos += 1 + name.length();
+                    readAttributes();
+                    depth++;
+                } else if (src.startsWith("/", pos + 1) && startsWithTag(pos + 2, name)) {
+                    pos = afterTag(pos);
+                    depth--;
+                } else {
+                    pos++;
+                }
+            }
+        }
+
+        private boolean startsWithTag(int at, String name) {
+            if (!src.regionMatches(true, at, name, 0, name.length())) {
+                return false;
+            }
+            int after = at + name.length();
+            if (after >= src.length()) {
+                return true;
+            }
+            char c = src.charAt(after);
+            return Character.isWhitespace(c) || c == '/' || c == '>';
+        }
+
+        private int indexOfEndTag(String name, int from) {
+            int at = from;
+            while (true) {
+                int lt = src.indexOf("</", at);
+                if (lt < 0) {
+                    return -1;
+                }
+                if (startsWithTag(lt + 2, name)) {
+                    return lt;
+                }
+                at = lt + 2;
+            }
+        }
+
+        private int afterTag(int lt) {
+            int gt = src.indexOf('>', lt);
+            return gt < 0 ? src.length() : gt + 1;
+        }
+
+        private static Map<String, String> allowedAttributes(String tag, Map<String, String> attrs) {
+            Set<String> tagAttrs = TAG_ATTRS.getOrDefault(tag, Set.of());
+            Map<String, String> result = new LinkedHashMap<>();
+            attrs.forEach((name, value) -> {
+                if (GLOBAL_ATTRS.contains(name) || tagAttrs.contains(name)) {
+                    result.put(name, value);
+                }
+            });
+            return result;
+        }
+
+        @SuppressWarnings("deprecation")
+        private static String decode(String raw) {
+            return raw.indexOf('&') < 0 ? raw : StringEscapeUtils.unescapeHtml4(raw);
+        }
+    }
+}
