+package de.fred4jupiter.fredbet.web.view;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.context.i18n.LocaleContextHolder;
+
+import java.time.format.DateTimeFormatter;
+import java.time.temporal.TemporalAccessor;
+
+/**
+ * Date formatting in the locale of the current request, called as {@code pageDates.format(date, pattern)}.
+ * Tessera's built-in {@code temporals.format} always formats with {@link java.util.Locale#ENGLISH}, while
+ * Thymeleaf's {@code #temporals.format} used the request locale (e.g. "Do. 11. Juni 2020").
+ */
+@TemplateFunctions("pageDates")
+public final class PageDateFunctions {
+
+    private PageDateFunctions() {
+    }
+
+    @TemplateFunction
+    public static String format(TemporalAccessor temporal, String pattern) {
+        if (temporal == null) {
+            return null;
+        }
+        return DateTimeFormatter.ofPattern(pattern, LocaleContextHolder.getLocale()).format(temporal);
+    }
+}
