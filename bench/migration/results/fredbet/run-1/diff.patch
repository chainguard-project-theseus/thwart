@@ -0,0 +1,119 @@
+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.domain.Group;
+import de.fred4jupiter.fredbet.settings.RuntimeSettings;
+import de.fred4jupiter.fredbet.domain.Theme;
+import de.fred4jupiter.fredbet.web.GroupAvailabilityUtil;
+import de.fred4jupiter.fredbet.web.LanguageUtil;
+import de.fred4jupiter.fredbet.web.RuntimeSettingsUtil;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.util.LanguageIconUtil;
+import org.springframework.context.MessageSource;
+import org.springframework.context.i18n.LocaleContextHolder;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.GrantedAuthority;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.stereotype.Component;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Builds the {@link LayoutModel} for the current request.
+ */
+@Component
+public class LayoutModelFactory {
+
+    /**
+     * language code -> flag icon code, in the order of the language selector.
+     */
+    private static final Map<String, String> LANGUAGES = new LinkedHashMap<>();
+
+    static {
+        LANGUAGES.put("de", "de");
+        LANGUAGES.put("en", "gb");
+        LANGUAGES.put("pl", "pl");
+        LANGUAGES.put("es", "es");
+        LANGUAGES.put("ca", "es-ct");
+        LANGUAGES.put("cs", "cz");
+        LANGUAGES.put("sv", "se");
+        LANGUAGES.put("fr", "fr");
+    }
+
+    private final WebSecurityUtil webSecurityUtil;
+
+    private final RuntimeSettingsUtil runtimeSettingsUtil;
+
+    private final GroupAvailabilityUtil groupAvailabilityUtil;
+
+    private final LanguageUtil languageUtil;
+
+    private final LanguageIconUtil languageIconUtil;
+
+    private final MessageSource messageSource;
+
+    public LayoutModelFactory(WebSecurityUtil webSecurityUtil, RuntimeSettingsUtil runtimeSettingsUtil,
+                              GroupAvailabilityUtil groupAvailabilityUtil, LanguageUtil languageUtil,
+                              LanguageIconUtil languageIconUtil, MessageSource messageSource) {
+        this.webSecurityUtil = webSecurityUtil;
+        this.runtimeSettingsUtil = runtimeSettingsUtil;
+        this.groupAvailabilityUtil = groupAvailabilityUtil;
+        this.languageUtil = languageUtil;
+        this.languageIconUtil = languageIconUtil;
+        this.messageSource = messageSource;
+    }
+
+    public LayoutModel create() {
+        final RuntimeSettings settings = runtimeSettingsUtil.getSettings();
+        final boolean loggedIn = webSecurityUtil.isUserLoggedIn();
+        final Locale locale = LocaleContextHolder.getLocale();
+
+        List<NavGroup> mainGroups = groupAvailabilityUtil.getMainGroups().stream()
+            .map(group -> new NavGroup(group.name(), ViewFunctions.message(messageSource, group.getTitleMsgKey(), locale)))
+            .toList();
+        List<String> availableGroups = Arrays.stream(Group.values())
+            .filter(group -> groupAvailabilityUtil.isGroupAvailable(group.name()))
+            .map(Group::name)
+            .toList();
+
+        Map<String, String> languageUrls = new LinkedHashMap<>();
+        Map<String, String> languageCssClasses = new LinkedHashMap<>();
+        LANGUAGES.forEach((language, icon) -> {
+            languageUrls.put(language, languageUtil.buildUrl(language));
+            languageCssClasses.put(language, languageIconUtil.cssClassFor(icon));
+        });
+
+        String themeName = settings.getBootswatchTheme() != null ? settings.getBootswatchTheme().toString().toLowerCase() : null;
+        boolean defaultTheme = themeName == null || Theme.DEFAULT.name().equalsIgnoreCase(themeName);
+
+        return new LayoutModel(loggedIn,
+            settings,
+            runtimeSettingsUtil.getExtraPointsConfig(),
+            defaultTheme,
+            themeName,
+            currentAuthorities(),
+            mainGroups,
+            availableGroups,
+            groupAvailabilityUtil.isKnockOutMatchesAvailable(),
+            webSecurityUtil.isDemoDataMenuEntryEnabled(),
+            runtimeSettingsUtil.isH2ConsoleEnabled(),
+            webSecurityUtil.resolveH2Path(),
+            loggedIn ? webSecurityUtil.getCurrentUsername() : null,
+            // String.valueOf: the old template concatenated the key into the URL, so a missing key rendered as "null"
+            loggedIn ? String.valueOf(webSecurityUtil.getCurrentUserProfileImageKey()) : "null",
+            languageIconUtil.cssClassCurrentUserLanguage(),
+            languageUrls,
+            languageCssClasses);
+    }
+
+    private List<String> currentAuthorities() {
+        Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
+        if (authentication == null) {
+            return List.of();
+        }
+        return authentication.getAuthorities().stream().map(GrantedAuthority::getAuthority).toList();
+    }
+}
