@@ -0,0 +1,52 @@
+package de.fred4jupiter.fredbet.web.info;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class RichTextParserTest {
+
+    @Test
+    void keepsAllowedMarkupAndDecodesEntities() {
+        List<RichTextNode> nodes = RichTextParser.parse("<p>a&nbsp;<b>bold</b> &lt;x&gt;</p><ol><li value=\"2\">x</ol>");
+
+        assertThat(nodes).hasSize(2);
+        RichTextNode p = nodes.get(0);
+        assertThat(p.tag()).isEqualTo("p");
+        assertThat(p.children()).extracting(RichTextNode::tag).containsExactly(null, "b", null);
+        assertThat(p.children().get(0).text()).isEqualTo("a ");
+        assertThat(p.children().get(2).text()).isEqualTo(" <x>");
+        RichTextNode li = nodes.get(1).children().get(0);
+        assertThat(li.tag()).isEqualTo("li");
+        assertThat(li.value()).isEqualTo("2");
+    }
+
+    @Test
+    void dropsScriptsEventHandlersAndStyles() {
+        List<RichTextNode> nodes = RichTextParser.parse("<b>bold</b><script>alert(1)</script>"
+                + "<img src=\"x.jpg\" onerror=\"alert(1)\" style=\"width:10px\" class=\"img-responsive\">"
+                + "<svg><script>alert(2)</script></svg><!-- c --><span style=\"color:red\">t</span>");
+
+        assertThat(nodes).extracting(RichTextNode::tag).containsExactly("b", "img", "span");
+        RichTextNode img = nodes.get(1);
+        assertThat(img.src()).isEqualTo("x.jpg");
+        assertThat(img.cssClass()).isEqualTo("img-responsive");
+        assertThat(nodes.get(2).children()).extracting(RichTextNode::text).containsExactly("t");
+    }
+
+    @Test
+    void closesUnclosedElements() {
+        List<RichTextNode> nodes = RichTextParser.parse("<p>one<p>two</div><ul><li>a<li>b");
+
+        assertThat(nodes).extracting(RichTextNode::tag).containsExactly("p", "p", "ul");
+        assertThat(nodes.get(2).children()).hasSize(2);
+    }
+
+    @Test
+    void nullAndEmptyContent() {
+        assertThat(RichTextParser.parse(null)).isEmpty();
+        assertThat(RichTextParser.parse("")).isEmpty();
+    }
+}
diff --git a/src/test/java/de/fred4jupiter/fredbet/web/snapshot/PageSnapshotMT.java b/src/test/java/de/fred4jupiter/fredbet/web/snapshot/PageSnapshotMT.java
