+package de.fred4jupiter.fredbet.web.view;
+
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+
+/**
+ * Adds the {@link LayoutModel} to the model of every controller.
+ */
+@ControllerAdvice
+public class LayoutModelAdvice {
+
+    private final LayoutModelFactory layoutModelFactory;
+
+    public LayoutModelAdvice(LayoutModelFactory layoutModelFactory) {
+        this.layoutModelFactory = layoutModelFactory;
+    }
+
+    @ModelAttribute("layout")
+    public LayoutModel layout() {
+        return layoutModelFactory.create();
+    }
+}
