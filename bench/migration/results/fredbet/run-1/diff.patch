+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.points.ExtraPointsConfiguration;
+import de.fred4jupiter.fredbet.settings.RuntimeSettings;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Everything the page layout (navigation bar, theme, language selector) needs. Added to every model as
+ * attribute {@code layout} by {@link LayoutModelAdvice}, since Tessera templates have no access to beans,
+ * the security context or the request.
+ */
+public record LayoutModel(boolean userLoggedIn,
+                          RuntimeSettings settings,
+                          ExtraPointsConfiguration extraPointsConfig,
+                          boolean defaultTheme,
+                          String themeName,
+                          List<String> authorities,
+                          List<NavGroup> mainGroups,
+                          List<String> availableGroups,
+                          boolean knockOutMatchesAvailable,
+                          boolean demoDataMenuEntryEnabled,
+                          boolean h2ConsoleEnabled,
+                          String h2Path,
+                          String currentUsername,
+                          String currentUserProfileImageKey,
+                          String currentLanguageCssClass,
+                          Map<String, String> languageUrls,
+                          Map<String, String> languageCssClasses) {
+
+    public boolean hasAuthority(String authority) {
+        return authorities.contains(authority);
+    }
+}
