+++ b/src/test/java/de/fred4jupiter/fredbet/web/snapshot/PageSnapshotMT.java
@@ -0,0 +1,115 @@
+package de.fred4jupiter.fredbet.web.snapshot;
+
+import de.fred4jupiter.fredbet.betting.repository.BetRepository;
+import de.fred4jupiter.fredbet.common.IntegrationTest;
+import de.fred4jupiter.fredbet.domain.Country;
+import de.fred4jupiter.fredbet.domain.Group;
+import de.fred4jupiter.fredbet.domain.builder.MatchBuilder;
+import de.fred4jupiter.fredbet.domain.entity.Bet;
+import de.fred4jupiter.fredbet.domain.entity.Match;
+import de.fred4jupiter.fredbet.match.MatchService;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.security.test.context.support.WithUserDetails;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.LocalDateTime;
+import java.util.List;
+
+import static org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.csrf;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+
+/**
+ * Manual test: renders every page into a directory (system property snapshot.dir) to compare view engine output.
+ */
+@IntegrationTest
+@AutoConfigureMockMvc
+public class PageSnapshotMT {
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Autowired
+    private MatchService matchService;
+
+    @Autowired
+    private BetRepository betRepository;
+
+    @Test
+    @WithUserDetails("admin")
+    public void snapshot() throws Exception {
+        Path dir = Path.of(System.getProperty("snapshot.dir", "target/snapshots"));
+        Files.createDirectories(dir);
+
+        Match m1 = matchService.save(MatchBuilder.create().withTeams(Country.GERMANY, Country.FRANCE).withGroup(Group.GROUP_A)
+            .withStadium("Berlin <Stadium> & \"Co\"").withKickOffDate(LocalDateTime.of(2035, 6, 10, 18, 0)).build());
+        Match m2 = matchService.save(MatchBuilder.create().withTeams(Country.SPAIN, Country.ITALY).withGroup(Group.GROUP_B)
+            .withStadium("Madrid").withKickOffDate(LocalDateTime.of(2020, 6, 11, 21, 0)).withGoals(2, 1).build());
+        Match m3 = matchService.save(MatchBuilder.create().withTeams(Country.BRAZIL, Country.ARGENTINA).withGroup(Group.FINAL)
+            .withStadium("Rio").withKickOffDate(LocalDateTime.of(2036, 7, 1, 20, 0)).build());
+        Match m4 = matchService.save(MatchBuilder.create().withTeams(Country.ENGLAND, Country.PORTUGAL).withGroup(Group.GROUP_A)
+            .withStadium("London").withKickOffDate(LocalDateTime.of(2020, 6, 12, 15, 0)).build());
+        Bet bet = new Bet();
+        bet.setUserName("admin");
+        bet.setMatch(m2);
+        bet.setGoalsTeamOne(2);
+        bet.setGoalsTeamTwo(0);
+        bet.setPoints(1);
+        betRepository.save(bet);
+
+        List<String> urls = List.of("/", "/ranking", "/registration", "/importexport", "/systeminfo", "/administration",
+            "/administration/active/users", "/administration/lastlogins", "/backup/show", "/excelexport/show",
+            "/config/show", "/runtimesettings/show", "/excelimport/show", "/matchresult/" + m2.getId(),
+            "/matchresult/" + m4.getId(),
+            "/matches", "/matches/past", "/matches/upcoming", "/matches/group/GROUP_A", "/matches/joker", "/matches/today",
+            "/matches/yesterday", "/matches/finishednoresult", "/match/create", "/match/" + m1.getId(), "/user", "/user/create",
+            "/gallery/show", "/image/show", "/imagegroup/show", "/info/pointsfrequency", "/info/rules", "/info/prices",
+            "/info/misc", "/info/editinfo/rules", "/info/editinfo/prices", "/info/editinfo/misc", "/info/statistic",
+            "/standings", "/pointcourse/show", "/cropping/show", "/profile/changePassword", "/profile/changeUsername",
+            "/extrabets", "/extrabets/others", "/bet/open", "/bet/createOrUpdate/" + m1.getId(),
+            "/bet/others/match/" + m2.getId(), "/config/points", "/login", "/login/error");
+        for (String url : urls) {
+            save(dir, url, get(url));
+        }
+        save(dir, "htmx-team-bundle", get("/runtimesettings/team-bundle").param("runtimeSettings.teamBundle", "WORLD_CUP").header("HX-Request", "true"));
+        save(dir, "/user/1", get("/user/1"));
+        save(dir, "POST-match", post("/match").with(csrf()).param("teamNameOne", "").param("stadium", ""));
+        save(dir, "POST-user", post("/user").with(csrf()).param("username", "").param("password", ""));
+        save(dir, "POST-user-edit", post("/user/edit").with(csrf()).param("userId", "1").param("username", ""));
+        save(dir, "POST-profile-changePassword", post("/profile/changePassword").with(csrf()).param("oldPassword", "x").param("newPassword", "").param("newPasswordRepeat", "y"));
+        save(dir, "POST-profile-changeUsername", post("/profile/changeUsername").with(csrf()).param("newUsername", ""));
+        save(dir, "POST-registration", post("/registration").with(csrf()).param("username", "").param("password", "a"));
+        save(dir, "POST-bet", post("/bet").with(csrf()).param("matchId", String.valueOf(m1.getId())).param("goalsTeamOne", "-1"));
+        save(dir, "POST-matchresult", post("/matchresult").with(csrf()).param("matchId", String.valueOf(m4.getId())).param("teamResultOne", "-5"));
+        save(dir, "POST-info-editinfo", post("/info/editinfo").with(csrf()).param("name", "rules").param("textContent", "<b>bold</b><script>alert(1)</script>"));
+        save(dir, "/info/rules-after", get("/info/rules"));
+        save(dir, "POST-imagegroup-save", post("/imagegroup/save").with(csrf()).param("name", ""));
+        save(dir, "error-404", get("/error").requestAttr("jakarta.servlet.error.status_code", 404)
+            .requestAttr("jakarta.servlet.error.request_uri", "/does/<not>/exist").accept("text/html"));
+        save(dir, "error-500", get("/error").requestAttr("jakarta.servlet.error.status_code", 500)
+            .requestAttr("jakarta.servlet.error.request_uri", "/boom").requestAttr("jakarta.servlet.error.exception", new IllegalStateException("x")).accept("text/html"));
+        save(dir, "POST-administration-testdata", post("/administration/testdata").with(csrf()).param("numberOfTestUsers", "-1").param("includeBets", "false").param("includeResults", "false"));
+    }
+
+    private void save(Path dir, String name, MockHttpServletRequestBuilder request) throws Exception {
+        String file = name.replaceAll("[^A-Za-z0-9_-]", "_") + ".html";
+        MvcResult result;
+        try {
+            result = mockMvc.perform(request).andReturn();
+        } catch (Exception e) {
+            Files.writeString(dir.resolve(file), "<!-- " + name + " FAILED: " + e + " -->\n");
+            return;
+        }
+        String body = result.getResponse().getContentAsString(StandardCharsets.UTF_8);
+        String header = "<!-- " + name + " status=" + result.getResponse().getStatus() + " redirect=" + result.getResponse().getRedirectedUrl()
+            + " view=" + (result.getModelAndView() != null ? result.getModelAndView().getViewName() : null) + " -->\n";
+        Files.writeString(dir.resolve(file), header + body);
+    }
+}
