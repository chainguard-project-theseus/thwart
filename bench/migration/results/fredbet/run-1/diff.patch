+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.domain.Country;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.util.TeamUtil;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.context.MessageSource;
+import org.springframework.context.i18n.LocaleContextHolder;
+import org.springframework.stereotype.Component;
+
+import java.util.Locale;
+
+/**
+ * Application functions for Tessera templates, called as {@code fb.fn(...)}. They replace the bean calls
+ * ({@code ${@teamUtil.cssClassFor(..)}}) and dynamic message keys ({@code #{${key}}}) of the old templates.
+ * The Spring beans are handed over once at startup by the {@link Registrar}.
+ */
+@TemplateFunctions("fb")
+public final class ViewFunctions {
+
+    private static volatile TeamUtil teamUtil;
+
+    private static volatile WebSecurityUtil webSecurityUtil;
+
+    private static volatile MessageSource messageSource;
+
+    private ViewFunctions() {
+    }
+
+    /**
+     * CSS class of the flag icon for the given country (was {@code @teamUtil.cssClassFor(country)}).
+     */
+    @TemplateFunction
+    public static String teamCss(Country country) {
+        return teamUtil.cssClassFor(country);
+    }
+
+    /**
+     * Translated name of the given country (was {@code @teamUtil.i18n(country)}).
+     */
+    @TemplateFunction
+    public static String teamName(Country country) {
+        return teamUtil.i18n(country);
+    }
+
+    /**
+     * Message for a key computed at runtime (was {@code #{${key}}}). The text is escaped like any other value.
+     */
+    @TemplateFunction
+    public static String msg(String key) {
+        return message(messageSource, key, LocaleContextHolder.getLocale());
+    }
+
+    /**
+     * Profile image key of the given user (was {@code @webSecurityUtil.getUserProfileImageKeyFor(username)}).
+     */
+    @TemplateFunction
+    public static String profileImageKey(String username) {
+        return webSecurityUtil.getUserProfileImageKeyFor(username);
+    }
+
+    /**
+     * Was {@code @webSecurityUtil.isRoleSelectionDisabledForUser(username)}.
+     */
+    @TemplateFunction
+    public static boolean roleSelectionDisabled(String username) {
+        return webSecurityUtil.isRoleSelectionDisabledForUser(username);
+    }
+
+    static String message(MessageSource source, String key, Locale locale) {
+        if (key == null) {
+            return null;
+        }
+        // same fallback as Thymeleaf for unknown keys
+        return source.getMessage(key, null, "??" + key + "_" + locale + "??", locale);
+    }
+
+    @Component
+    static class Registrar {
+
+        Registrar(TeamUtil teamUtil, WebSecurityUtil webSecurityUtil, MessageSource messageSource) {
+            ViewFunctions.teamUtil = teamUtil;
+            ViewFunctions.webSecurityUtil = webSecurityUtil;
+            ViewFunctions.messageSource = messageSource;
+        }
+    }
+}
