+
+    /**
+     * Kick-off date formatted with the request locale (Tessera's temporals.format always formats in English).
+     */
+    public String getKickOffDateFormatted() {
+        return getKickOffDate() == null ? null : java.time.format.DateTimeFormatter
+            .ofPattern("EEE dd. MMMM yyyy HH:mm", org.springframework.context.i18n.LocaleContextHolder.getLocale())
+            .format(getKickOffDate());
