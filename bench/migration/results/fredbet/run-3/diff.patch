@@ -0,0 +1,28 @@
+package de.fred4jupiter.fredbet.web.info.richtext;
+
+import java.util.List;
+
+/**
+ * One node of sanitized, admin-edited rich text (see {@link RichTextSanitizer}).
+ * <p>
+ * {@code tag} is either {@link #TEXT} (a text node, content in {@code text}) or one of the allowed lower-case
+ * element names. Only the fixed set of attributes below survives sanitizing; the template
+ * {@code fragments/richtext.html} writes literal tags and lets Tessera escape every value (URLs in href/src go
+ * through Tessera's URL filter).
+ */
+public record RichTextNode(String tag, String text,
+                           String cls, String title,
+                           String href, String target, String rel,
+                           String src, String alt, String width, String height,
+                           String value, String start, String type,
+                           String colspan, String rowspan,
+                           String color, String face, String size,
+                           List<RichTextNode> children) {
+
+    public static final String TEXT = "#text";
+
+    public static RichTextNode text(String text) {
+        return new RichTextNode(TEXT, text, null, null, null, null, null, null, null, null, null, null, null, null,
+                null, null, null, null, null, List.of());
+    }
+}
diff --git a/src/main/java/de/fred4jupiter/fredbet/web/info/richtext/RichTextSanitizer.java b/src/main/java/de/fred4jupiter/fredbet/web/info/richtext/RichTextSanitizer.java
new file mode 100644
index 00000000..dc5cb1f4
--- /dev/null
+++ b/src/main/java/de/fred4jupiter/fredbet/web/info/richtext/RichTextSanitizer.java
@@ -0,0 +1,120 @@
+package de.fred4jupiter.fredbet.web.info.richtext;
+
+import org.jsoup.Jsoup;
+import org.jsoup.nodes.Element;
+import org.jsoup.nodes.Node;
+import org.jsoup.nodes.TextNode;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+/**
+ * Parses admin-edited rich text HTML (summernote) into a tree of {@link RichTextNode}s using a strict allow-list.
+ * <ul>
+ *     <li>allowed elements are kept (with the allowed attributes only),</li>
+ *     <li>elements whose content is code or another document ({@link #DROPPED}) are removed with their content,</li>
+ *     <li>any other element is unwrapped: the tag is dropped, its children are kept.</li>
+ * </ul>
+ * Comments and other non-text nodes are dropped. {@code style} and all {@code on*} attributes are always dropped
+ * (Tessera does not allow computed style attributes).
+ */
+public final class RichTextSanitizer {
+
+    /**
+     * Must match the t:case list in templates/fragments/richtext.html.
+     */
+    public static final Set<String> ALLOWED_TAGS = Set.of(
+            "p", "div", "span", "br", "hr", "b", "strong", "i", "em", "u", "s", "strike", "sub", "sup", "small",
+            "mark", "code", "pre", "blockquote", "h1", "h2", "h3", "h4", "h5", "h6", "ul", "ol", "li", "a", "img",
+            "table", "thead", "tbody", "tfoot", "tr", "td", "th", "caption", "font", "section", "article", "figure",
+            "figcaption", "dl", "dt", "dd", "q", "cite", "abbr", "del", "ins", "kbd");
+
+    private static final Set<String> DROPPED = Set.of(
+            "script", "style", "iframe", "frame", "frameset", "object", "embed", "applet", "noscript", "template",
+            "head", "title", "meta", "link", "base", "textarea", "select", "option", "button", "input", "form",
+            "svg", "math", "video", "audio", "canvas");
+
+    private static final Set<String> TARGETS = Set.of("_blank", "_self", "_parent", "_top");
+
+    private static final Pattern NUMBER = Pattern.compile("[0-9]{1,5}(%|px)?");
+
+    private static final int MAX_DEPTH = 100;
+
+    private RichTextSanitizer() {
+    }
+
+    public static List<RichTextNode> sanitize(String html) {
+        if (html == null || html.isBlank()) {
+            return List.of();
+        }
+        Element body = Jsoup.parseBodyFragment(html).body();
+        List<RichTextNode> result = new ArrayList<>();
+        convertChildren(body, result, 0);
+        return List.copyOf(result);
+    }
+
+    private static void convertChildren(Element parent, List<RichTextNode> out, int depth) {
+        for (Node child : parent.childNodes()) {
+            if (child instanceof TextNode textNode) {
+                out.add(RichTextNode.text(textNode.getWholeText()));
+            } else if (child instanceof Element element) {
+                convertElement(element, out, depth);
+            }
+            // comments, data nodes (script/style content), doctype etc. are dropped
+        }
+    }
+
+    private static void convertElement(Element element, List<RichTextNode> out, int depth) {
+        String tag = element.normalName().toLowerCase(Locale.ROOT);
+        if (DROPPED.contains(tag)) {
+            return;
+        }
+        if (!ALLOWED_TAGS.contains(tag) || depth >= MAX_DEPTH) {
+            convertChildren(element, out, depth); // unwrap
+            return;
+        }
+        List<RichTextNode> children = new ArrayList<>();
+        convertChildren(element, children, depth + 1);
+
+        boolean link = tag.equals("a");
+        boolean img = tag.equals("img");
+        boolean list = tag.equals("ol") || tag.equals("ul");
+        boolean cell = tag.equals("td") || tag.equals("th");
+        boolean font = tag.equals("font");
+        out.add(new RichTextNode(tag, null,
+                attr(element, "class"), attr(element, "title"),
+                link ? attr(element, "href") : null,
+                link ? target(element) : null,
+                link ? attr(element, "rel") : null,
+                img ? attr(element, "src") : null,
+                img ? attr(element, "alt") : null,
+                img || tag.equals("table") ? number(element, "width") : null,
+                img ? number(element, "height") : null,
+                tag.equals("li") ? attr(element, "value") : null,
+                list ? attr(element, "start") : null,
+                list ? attr(element, "type") : null,
+                cell ? number(element, "colspan") : null,
+                cell ? number(element, "rowspan") : null,
+                font ? attr(element, "color") : null,
+                font ? attr(element, "face") : null,
+                font ? attr(element, "size") : null,
+                List.copyOf(children)));
+    }
+
+    private static String attr(Element element, String name) {
+        return element.hasAttr(name) ? element.attr(name) : null;
+    }
+
+    private static String target(Element element) {
+        String value = attr(element, "target");
+        return value != null && TARGETS.contains(value.toLowerCase(Locale.ROOT)) ? value : null;
+    }
+
+    private static String number(Element element, String name) {
+        String value = attr(element, name);
+        return value != null && NUMBER.matcher(value.trim()).matches() ? value.trim() : null;
+    }
+}
