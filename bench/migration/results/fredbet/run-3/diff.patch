+package de.fred4jupiter.fredbet.web.template;
+
+import de.fred4jupiter.fredbet.common.UnitTest;
+import de.fred4jupiter.fredbet.settings.RuntimeSettings;
+import de.fred4jupiter.fredbet.templates.ErrorTemplate;
+import de.fred4jupiter.fredbet.templates.info.RulesTemplate;
+import de.fred4jupiter.fredbet.web.WebMessageUtil.WebMessage;
+import de.fred4jupiter.fredbet.web.info.richtext.RichTextSanitizer;
+import dev.tessera.runtime.RenderContext;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Renders compiled Tessera templates with hostile data and checks that it comes out escaped.
+ */
+@UnitTest
+public class TemplateEscapingUT {
+
+    private static final String SCRIPT = "<script>alert('x')</script>";
+
+    private static LayoutModel layout(WebMessage globalMessage) {
+        return new LayoutModel(new RuntimeSettings(), null, false, null, null, List.of(), false, Map.of(), false, false,
+            "", "fi-de", Map.of(), Map.of(), globalMessage);
+    }
+
+    @Test
+    void userDataIsEscapedInTextAndAttributes() {
+        String html = ErrorTemplate.of("now", 500, SCRIPT, "/\"><script>x</script>", layout(new WebMessage("alert-danger", SCRIPT)))
+            .renderToString(RenderContext.defaults());
+
+        assertThat(html).doesNotContain("<script>alert").doesNotContain("\"><script>x");
+        assertThat(html).contains("&lt;script&gt;alert(");
+        assertThat(html).contains("FredBet - ");
+    }
+
+    @Test
+    void richTextIsSanitized() {
+        String content = "<p onclick=\"evil()\">Hello <b>World</b></p>" + SCRIPT + "<a href=\"javascript:evil()\">link</a>";
+        String html = RulesTemplate.of(RichTextSanitizer.sanitize(content), true, layout(null))
+            .renderToString(RenderContext.defaults());
+
+        assertThat(html).contains("<p>Hello <b>World</b></p>");
+        assertThat(html).doesNotContain("onclick").doesNotContain("alert('x')").doesNotContain("javascript:");
+    }
+}
