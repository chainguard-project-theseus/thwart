+package de.fred4jupiter.fredbet.web.template;
+
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.util.TeamUtil;
+import org.springframework.stereotype.Component;
+
+/**
+ * Tessera template functions are static methods. This component hands them the Spring beans they delegate to
+ * (the beans the former Thymeleaf templates called directly with {@code @teamUtil...}).
+ */
+@Component
+public class TemplateFunctionsBridge {
+
+    private static volatile TeamUtil teamUtil;
+
+    private static volatile WebSecurityUtil webSecurityUtil;
+
+    public TemplateFunctionsBridge(TeamUtil teamUtil, WebSecurityUtil webSecurityUtil) {
+        TemplateFunctionsBridge.teamUtil = teamUtil;
+        TemplateFunctionsBridge.webSecurityUtil = webSecurityUtil;
+    }
+
+    static TeamUtil teamUtil() {
+        return teamUtil;
+    }
+
+    static WebSecurityUtil webSecurityUtil() {
+        return webSecurityUtil;
+    }
+}
