+package de.fred4jupiter.fredbet.web.template;
+
+import de.fred4jupiter.fredbet.domain.Group;
+import de.fred4jupiter.fredbet.util.MessageSourceUtil;
+import de.fred4jupiter.fredbet.web.GroupAvailabilityUtil;
+import de.fred4jupiter.fredbet.web.LanguageUtil;
+import de.fred4jupiter.fredbet.web.RuntimeSettingsUtil;
+import de.fred4jupiter.fredbet.web.WebMessageUtil.WebMessage;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.util.LanguageIconUtil;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import org.springframework.context.i18n.LocaleContextHolder;
+import org.springframework.stereotype.Component;
+import org.springframework.web.servlet.HandlerInterceptor;
+import org.springframework.web.servlet.ModelAndView;
+import org.springframework.web.servlet.view.RedirectView;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Puts the {@link LayoutModel} into the model of every view that is rendered (replaces the bean calls of the former
+ * Thymeleaf layout and navigation).
+ */
+@Component
+public class LayoutModelInterceptor implements HandlerInterceptor {
+
+    /**
+     * language code of the selector -> flag icon code
+     */
+    private static final Map<String, String> LANGUAGES = languages();
+
+    private final WebSecurityUtil webSecurityUtil;
+
+    private final RuntimeSettingsUtil runtimeSettingsUtil;
+
+    private final GroupAvailabilityUtil groupAvailabilityUtil;
+
+    private final LanguageUtil languageUtil;
+
+    private final LanguageIconUtil languageIconUtil;
+
+    private final MessageSourceUtil messageSourceUtil;
+
+    public LayoutModelInterceptor(WebSecurityUtil webSecurityUtil, RuntimeSettingsUtil runtimeSettingsUtil,
+                                  GroupAvailabilityUtil groupAvailabilityUtil, LanguageUtil languageUtil,
+                                  LanguageIconUtil languageIconUtil, MessageSourceUtil messageSourceUtil) {
+        this.webSecurityUtil = webSecurityUtil;
+        this.runtimeSettingsUtil = runtimeSettingsUtil;
+        this.groupAvailabilityUtil = groupAvailabilityUtil;
+        this.languageUtil = languageUtil;
+        this.languageIconUtil = languageIconUtil;
+        this.messageSourceUtil = messageSourceUtil;
+    }
+
+    private static Map<String, String> languages() {
+        Map<String, String> languages = new LinkedHashMap<>();
+        languages.put("de", "de");
+        languages.put("en", "gb");
+        languages.put("pl", "pl");
+        languages.put("es", "es");
+        languages.put("ca", "es-ct");
+        languages.put("cs", "cz");
+        languages.put("sv", "se");
+        languages.put("fr", "fr");
+        return languages;
+    }
+
+    @Override
+    public void postHandle(HttpServletRequest request, HttpServletResponse response, Object handler, ModelAndView modelAndView) {
+        if (modelAndView == null || !needsLayout(modelAndView)) {
+            return;
+        }
+        modelAndView.addObject(LayoutModel.MODEL_ATTRIBUTE, createLayoutModel(modelAndView.getModel()));
+    }
+
+    private boolean needsLayout(ModelAndView modelAndView) {
+        if (modelAndView.getView() instanceof RedirectView) {
+            return false;
+        }
+        String viewName = modelAndView.getViewName();
+        return viewName == null || !(viewName.startsWith("redirect:") || viewName.startsWith("forward:"));
+    }
+
+    LayoutModel createLayoutModel(Map<String, Object> model) {
+        boolean userLoggedIn = webSecurityUtil.isUserLoggedIn();
+        String username = userLoggedIn ? webSecurityUtil.getCurrentUsername() : null;
+        // the former template concatenated the key into the URL, so a missing key rendered as 'null'
+        String profileImageKey = userLoggedIn ? String.valueOf(webSecurityUtil.getCurrentUserProfileImageKey()) : null;
+
+        List<LayoutModel.GroupLink> mainGroups = groupAvailabilityUtil.getMainGroups().stream()
+            .map(group -> new LayoutModel.GroupLink(group.getName(),
+                messageSourceUtil.getMessageFor(group.getTitleMsgKey(), LocaleContextHolder.getLocale())))
+            .toList();
+
+        Map<String, Boolean> groupAvailable = new LinkedHashMap<>();
+        for (Group group : Group.values()) {
+            groupAvailable.put(group.name(), groupAvailabilityUtil.isGroupAvailable(group.name()));
+        }
+
+        Map<String, String> languageUrls = new LinkedHashMap<>();
+        Map<String, String> languageCssClasses = new LinkedHashMap<>();
+        LANGUAGES.forEach((language, flag) -> {
+            languageUrls.put(language, languageUtil.buildUrl(language));
+            languageCssClasses.put(language, languageIconUtil.cssClassFor(flag));
+        });
+
+        WebMessage globalMessage = model.get("globalMessage") instanceof WebMessage webMessage ? webMessage : null;
+
+        return new LayoutModel(runtimeSettingsUtil.getSettings(), runtimeSettingsUtil.getExtraPointsConfig(), userLoggedIn,
+            username, profileImageKey, mainGroups, groupAvailabilityUtil.isKnockOutMatchesAvailable(), groupAvailable,
+            webSecurityUtil.isDemoDataMenuEntryEnabled(), runtimeSettingsUtil.isH2ConsoleEnabled(),
+            webSecurityUtil.resolveH2Path(), languageIconUtil.cssClassCurrentUserLanguage(), languageUrls,
+            languageCssClasses, globalMessage);
+    }
+}
