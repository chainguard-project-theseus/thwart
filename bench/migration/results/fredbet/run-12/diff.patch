+++ b/src/main/java/de/fred4jupiter/fredbet/web/view/MessageFunctions.java
@@ -0,0 +1,50 @@
+package de.fred4jupiter.fredbet.web.view;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.List;
+import java.util.Locale;
+import java.util.MissingResourceException;
+import java.util.ResourceBundle;
+
+/**
+ * Looks up a message whose key is computed from data (e.g. an enum's title key). Literal keys are
+ * written as {@code #{key}} in the templates and checked at build time; these aren't.
+ */
+@TemplateFunctions("msgs")
+public final class MessageFunctions {
+
+    private static final List<String> BASENAMES = List.of("msgs.TranslationMessages", "msgs.ValidationMessages", "msgs.TeamKey");
+
+    private static final ResourceBundle.Control CONTROL = ResourceBundle.Control.getNoFallbackControl(ResourceBundle.Control.FORMAT_PROPERTIES);
+
+    private MessageFunctions() {
+    }
+
+    @TemplateFunction
+    public static String get(Locale locale, String key) {
+        if (key == null) {
+            return null;
+        }
+        String message = lookup(locale, key);
+        if (message == null && !Locale.ENGLISH.getLanguage().equals(locale.getLanguage())) {
+            message = lookup(Locale.ENGLISH, key);
+        }
+        return message != null ? message : key;
+    }
+
+    private static String lookup(Locale locale, String key) {
+        for (String basename : BASENAMES) {
+            try {
+                ResourceBundle bundle = ResourceBundle.getBundle(basename, locale, MessageFunctions.class.getClassLoader(), CONTROL);
+                if (bundle.containsKey(key)) {
+                    return bundle.getString(key);
+                }
+            } catch (MissingResourceException e) {
+                // try the next basename
+            }
+        }
+        return null;
+    }
+}
