@@ -0,0 +1,75 @@
+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.domain.Group;
+import de.fred4jupiter.fredbet.settings.RuntimeSettings;
+import de.fred4jupiter.fredbet.util.MessageSourceUtil;
+import de.fred4jupiter.fredbet.web.GroupAvailabilityUtil;
+import de.fred4jupiter.fredbet.web.LanguageUtil;
+import de.fred4jupiter.fredbet.web.RuntimeSettingsUtil;
+import de.fred4jupiter.fredbet.web.WebSecurityUtil;
+import de.fred4jupiter.fredbet.web.util.LanguageIconUtil;
+import org.springframework.context.i18n.LocaleContextHolder;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Provides the values every page reads (the templates can't call beans).
+ */
+@ControllerAdvice
+public class LayoutModelAdvice {
+
+    private static final List<String> LANGUAGES = List.of("de", "en", "pl", "es", "ca", "cs", "sv", "fr");
+
+    private final WebSecurityUtil webSecurityUtil;
+    private final RuntimeSettingsUtil runtimeSettingsUtil;
+    private final GroupAvailabilityUtil groupAvailabilityUtil;
+    private final LanguageUtil languageUtil;
+    private final LanguageIconUtil languageIconUtil;
+    private final MessageSourceUtil messageSourceUtil;
+
+    public LayoutModelAdvice(WebSecurityUtil webSecurityUtil, RuntimeSettingsUtil runtimeSettingsUtil,
+                             GroupAvailabilityUtil groupAvailabilityUtil, LanguageUtil languageUtil,
+                             LanguageIconUtil languageIconUtil, MessageSourceUtil messageSourceUtil) {
+        this.webSecurityUtil = webSecurityUtil;
+        this.runtimeSettingsUtil = runtimeSettingsUtil;
+        this.groupAvailabilityUtil = groupAvailabilityUtil;
+        this.languageUtil = languageUtil;
+        this.languageIconUtil = languageIconUtil;
+        this.messageSourceUtil = messageSourceUtil;
+    }
+
+    @ModelAttribute("layout")
+    public LayoutView layout() {
+        RuntimeSettings settings = runtimeSettingsUtil.getSettings();
+        boolean loggedIn = webSecurityUtil.isUserLoggedIn();
+
+        Map<String, String> languageUrls = new LinkedHashMap<>();
+        LANGUAGES.forEach(lang -> languageUrls.put(lang, languageUtil.buildUrl(lang)));
+
+        if (!loggedIn) {
+            return new LayoutView(false, settings.getBootswatchTheme(), settings.getNavbarLayout().getNavbarTag(), List.of(),
+                false, Map.of(), false, runtimeSettingsUtil.isH2ConsoleEnabled(), webSecurityUtil.resolveH2Path(),
+                languageIconUtil.cssClassCurrentUserLanguage(), languageUrls, null, null, settings.isEnableChangingUsername());
+        }
+
+        List<LayoutView.GroupLink> mainGroups = groupAvailabilityUtil.getMainGroups().stream()
+            .map(group -> new LayoutView.GroupLink(group.getName(),
+                messageSourceUtil.getMessageFor(group.getTitleMsgKey(), LocaleContextHolder.getLocale())))
+            .toList();
+
+        Map<String, Boolean> groupAvailable = new LinkedHashMap<>();
+        for (Group group : Group.values()) {
+            groupAvailable.put(group.name(), groupAvailabilityUtil.isGroupAvailable(group.name()));
+        }
+
+        return new LayoutView(true, settings.getBootswatchTheme(), settings.getNavbarLayout().getNavbarTag(), mainGroups,
+            groupAvailabilityUtil.isKnockOutMatchesAvailable(), groupAvailable, webSecurityUtil.isDemoDataMenuEntryEnabled(),
+            runtimeSettingsUtil.isH2ConsoleEnabled(), webSecurityUtil.resolveH2Path(),
+            languageIconUtil.cssClassCurrentUserLanguage(), languageUrls, webSecurityUtil.getCurrentUserProfileImageKey(),
+            webSecurityUtil.getCurrentUsername(), settings.isEnableChangingUsername());
+    }
+}
