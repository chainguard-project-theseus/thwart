+        <table t:case="'table'" t:class="node.cssClass"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></table>
+        <thead t:case="'thead'" t:class="node.cssClass"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></thead>
+        <tbody t:case="'tbody'" t:class="node.cssClass"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></tbody>
