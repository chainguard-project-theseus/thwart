+package de.fred4jupiter.fredbet.web.richtext;
+
+import java.util.List;
+
+/**
+ * One node of user-edited rich text (rules, prices, misc), rendered by {@code templates/fragments/rich_text.html}.
+ * A text node has {@code tag == null} and carries {@code text}; an element node has an allowlisted tag name,
+ * optional allowlisted attributes and children. Everything is escaped by the template engine on output.
+ *
+ * @param tag      the element name, or {@code null} for a text node
+ * @param text     the text of a text node
+ * @param cssClass the class attribute, or {@code null}
+ * @param href     the href of a link, or {@code null}
+ * @param src      the src of an image, or {@code null}
+ * @param alt      the alt text of an image, or {@code null}
+ * @param value    the value of a list item, or {@code null}
+ * @param children the child nodes
+ */
+public record RichTextNode(String tag, String text, String cssClass, String href, String src, String alt, String value,
+                           List<RichTextNode> children) {
+
+    public boolean isText() {
+        return tag == null;
+    }
+}
diff --git a/src/main/java/de/fred4jupiter/fredbet/web/richtext/RichTextParser.java b/src/main/java/de/fred4jupiter/fredbet/web/richtext/RichTextParser.java
new file mode 100644
index 00000000..ffd05046
--- /dev/null
+++ b/src/main/java/de/fred4jupiter/fredbet/web/richtext/RichTextParser.java
@@ -0,0 +1,63 @@
+package de.fred4jupiter.fredbet.web.richtext;
+
+import org.apache.commons.lang3.StringUtils;
+import org.jsoup.Jsoup;
+import org.jsoup.nodes.Element;
+import org.jsoup.nodes.Node;
+import org.jsoup.nodes.TextNode;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Parses the HTML stored by the rich text editor into {@link RichTextNode}s. Only allowlisted elements are kept
+ * (others are unwrapped, script-like elements are dropped with their content) and only the attributes class, href,
+ * src, alt and value survive. The result is rendered by a template, so text and attributes are escaped on output and URLs
+ * are scheme-checked; no markup is ever printed unescaped.
+ */
+public final class RichTextParser {
+
+    static final Set<String> ALLOWED_TAGS = Set.of("p", "br", "b", "strong", "i", "em", "u", "s", "strike", "sub", "sup",
+        "small", "h1", "h2", "h3", "h4", "h5", "h6", "ul", "ol", "li", "blockquote", "pre", "code", "span", "div", "a",
+        "hr", "img", "table", "thead", "tbody", "tr", "th", "td", "font");
+
+    private static final Set<String> DROPPED_TAGS = Set.of("script", "style", "iframe", "object", "embed", "noscript",
+        "template", "svg", "math", "form", "input", "button", "textarea", "select");
+
+    private RichTextParser() {
+    }
+
+    public static List<RichTextNode> parse(String html) {
+        if (StringUtils.isBlank(html)) {
+            return List.of();
+        }
+        return convert(Jsoup.parseBodyFragment(html).body().childNodes());
+    }
+
+    private static List<RichTextNode> convert(List<Node> nodes) {
+        List<RichTextNode> result = new ArrayList<>();
+        for (Node node : nodes) {
+            if (node instanceof TextNode textNode) {
+                result.add(new RichTextNode(null, textNode.getWholeText(), null, null, null, null, null, List.of()));
+            } else if (node instanceof Element element) {
+                String tag = element.normalName();
+                if (DROPPED_TAGS.contains(tag)) {
+                    continue;
+                }
+                List<RichTextNode> children = convert(element.childNodes());
+                if (!ALLOWED_TAGS.contains(tag)) {
+                    result.addAll(children);
+                    continue;
+                }
+                result.add(new RichTextNode(tag, null, attr(element, "class"), attr(element, "href"), attr(element, "src"),
+                    attr(element, "alt"), attr(element, "value"), children));
+            }
+        }
+        return result;
+    }
+
+    private static String attr(Element element, String name) {
+        return element.hasAttr(name) ? element.attr(name) : null;
+    }
+}
