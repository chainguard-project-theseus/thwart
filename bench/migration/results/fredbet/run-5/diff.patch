+    private final LanguageIconUtil languageIconUtil;
+    private final SecurityService securityService;
+    private final MessageSourceUtil messageSourceUtil;
+    private final BettingWebUtil bettingWebUtil;
+
+    public LayoutModelAdvice(WebSecurityUtil webSecurityUtil, RuntimeSettingsUtil runtimeSettingsUtil,
+                             GroupAvailabilityUtil groupAvailabilityUtil, LanguageUtil languageUtil,
+                             LanguageIconUtil languageIconUtil, SecurityService securityService,
+                             MessageSourceUtil messageSourceUtil, BettingWebUtil bettingWebUtil) {
+        this.webSecurityUtil = webSecurityUtil;
+        this.runtimeSettingsUtil = runtimeSettingsUtil;
+        this.groupAvailabilityUtil = groupAvailabilityUtil;
+        this.languageUtil = languageUtil;
+        this.languageIconUtil = languageIconUtil;
+        this.securityService = securityService;
+        this.messageSourceUtil = messageSourceUtil;
+        this.bettingWebUtil = bettingWebUtil;
+    }
+
+    @ModelAttribute("layout")
+    public LayoutView layout() {
+        RuntimeSettings settings = runtimeSettingsUtil.getSettings();
+        boolean loggedIn = webSecurityUtil.isUserLoggedIn();
+
+        Map<String, String> languageUrls = new LinkedHashMap<>();
+        for (String language : LANGUAGES) {
+            languageUrls.put(language, languageUtil.buildUrl(language));
+        }
+
+        if (!loggedIn) {
+            return new LayoutView(false, settings.getBootswatchTheme(), settings.getNavbarLayout().getNavbarTag(), List.of(),
+                Map.of(), false, Map.of(), false, false, "", false,
+                languageIconUtil.cssClassCurrentUserLanguage(), languageUrls, null, null, settings.isSelfRegistrationEnabled(), bettingWebUtil.isBettable());
+        }
+
+        List<LayoutView.NavGroup> mainGroups = groupAvailabilityUtil.getMainGroups().stream()
+            .map(group -> new LayoutView.NavGroup(group.getName(),
+                messageSourceUtil.getMessageFor(group.getTitleMsgKey(), LocaleContextHolder.getLocale())))
+            .toList();
+
+        Map<String, Boolean> groupAvailable = new LinkedHashMap<>();
+        for (String group : KNOCKOUT_GROUPS) {
+            groupAvailable.put(group, groupAvailabilityUtil.isGroupAvailable(group));
+        }
+
+        Map<String, Boolean> perm = new LinkedHashMap<>();
+        for (String permission : NAV_PERMISSIONS) {
+            perm.put(permission, securityService.isCurrentUserHavingPermission(permission));
+        }
+
+        return new LayoutView(true, settings.getBootswatchTheme(), settings.getNavbarLayout().getNavbarTag(), mainGroups,
+            groupAvailable, groupAvailabilityUtil.isKnockOutMatchesAvailable(), perm,
+            webSecurityUtil.isDemoDataMenuEntryEnabled(), runtimeSettingsUtil.isH2ConsoleEnabled(), webSecurityUtil.resolveH2Path(),
+            settings.isEnableChangingUsername(), languageIconUtil.cssClassCurrentUserLanguage(), languageUrls,
+            webSecurityUtil.getCurrentUserProfileImageKey(), webSecurityUtil.getCurrentUsername(), settings.isSelfRegistrationEnabled(), bettingWebUtil.isBettable());
+    }
+}
