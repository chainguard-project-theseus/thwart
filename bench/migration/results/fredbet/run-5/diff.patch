+      <t:block t:unless="node.isText()" t:switch="node.tag">
+        <p t:case="'p'" t:class="node.cssClass"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></p>
+        <b t:case="'b'" t:class="node.cssClass"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></b>
+        <strong t:case="'strong'" t:class="node.cssClass"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></strong>
