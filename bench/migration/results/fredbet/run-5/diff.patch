@@ -0,0 +1,45 @@
+package de.fred4jupiter.fredbet.web.matches;
+
+import de.fred4jupiter.fredbet.domain.Group;
+import de.fred4jupiter.fredbet.web.WebMessageUtil;
+
+import java.time.LocalDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.EnumMap;
+import java.util.Map;
+
+import org.springframework.context.i18n.LocaleContextHolder;
+
+/**
+ * View helpers for the match and bet pages: translated group titles (the templates cannot resolve
+ * message keys computed at runtime) and locale-aware kick-off dates.
+ */
+public final class GroupTitles {
+
+    private static final String KICK_OFF_PATTERN = "EEE dd. MMMM yyyy HH:mm";
+
+    private GroupTitles() {
+    }
+
+    /**
+     * Translated title of every group in the current locale, for the {@code groupTitles} model attribute.
+     */
+    public static Map<Group, String> of(WebMessageUtil webMessageUtil) {
+        Map<Group, String> titles = new EnumMap<>(Group.class);
+        for (Group group : Group.values()) {
+            titles.put(group, webMessageUtil.getMessageFor(group.getTitleMsgKey()));
+        }
+        return titles;
+    }
+
+    /**
+     * Formats a kick-off date like Thymeleaf's {@code #temporals.format(date, 'EEE dd. MMMM yyyy HH:mm')} did,
+     * with the current request locale.
+     */
+    public static String formatKickOff(LocalDateTime kickOffDate) {
+        if (kickOffDate == null) {
+            return "";
+        }
+        return DateTimeFormatter.ofPattern(KICK_OFF_PATTERN, LocaleContextHolder.getLocale()).format(kickOffDate);
+    }
+}
