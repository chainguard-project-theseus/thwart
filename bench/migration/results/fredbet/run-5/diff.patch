+package de.fred4jupiter.fredbet.web.util;
+
+import com.neovisionaries.i18n.CountryCode;
+import de.fred4jupiter.fredbet.domain.Country;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.apache.commons.lang3.StringUtils;
+
+/**
+ * Template functions for teams: {@code teams.cssClass(country)} in templates.
+ */
+@TemplateFunctions("teams")
+public final class TeamFunctions {
+
+    private TeamFunctions() {
+    }
+
+    /**
+     * CSS class of the flag icon for the given country, or an empty string.
+     */
+    @TemplateFunction
+    public static String cssClass(Country country) {
+        if (country == null) {
+            return "";
+        }
+        if (StringUtils.isNotBlank(country.getCssIconClass())) {
+            return country.getCssIconClass();
+        }
+        return cssClassForAlpha2(alpha2CodeOf(country));
+    }
+
+    static String cssClassForAlpha2(String alpha2Code) {
+        if (StringUtils.isBlank(alpha2Code)) {
+            return "";
+        }
+        return "fi fi-%s".formatted(alpha2Code.toLowerCase());
+    }
+
+    static String alpha2CodeOf(Country country) {
+        if (StringUtils.isNotBlank(country.getFlagIconCode())) {
+            return country.getFlagIconCode();
+        }
+        if (StringUtils.isNotBlank(country.getAlpha3Code())) {
+            CountryCode countryCode = CountryCode.getByAlpha3Code(country.getAlpha3Code().toUpperCase());
+            if (countryCode != null && countryCode.getAlpha2() != null) {
+                return countryCode.getAlpha2();
+            }
+        }
+        return null;
+    }
+}
