diff --git a/src/test/java/de/fred4jupiter/fredbet/web/view/RichTextParserUT.java b/src/test/java/de/fred4jupiter/fredbet/web/view/RichTextParserUT.java
new file mode 100644
index 00000000..e7ee27e5
--- /dev/null
+++ b/src/test/java/de/fred4jupiter/fredbet/web/view/RichTextParserUT.java
@@ -0,0 +1,32 @@
+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.common.UnitTest;
+import de.fred4jupiter.fredbet.web.richtext.RichTextNode;
+import de.fred4jupiter.fredbet.web.richtext.RichTextParser;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@UnitTest
+public class RichTextParserUT {
+
+    @Test
+    public void keepsAllowedMarkupAndDropsScripts() {
+        List<RichTextNode> nodes = RichTextParser.parse("<p onclick=\"x()\">Hi <b>there</b><script>alert(1)</script></p><blink>!</blink>");
+
+        assertThat(nodes).hasSize(2);
+        RichTextNode p = nodes.get(0);
+        assertThat(p.tag()).isEqualTo("p");
+        assertThat(p.children()).extracting(RichTextNode::tag).containsExactly(null, "b");
+        assertThat(nodes.get(1).isText()).isTrue();
+        assertThat(nodes.get(1).text()).isEqualTo("!");
+    }
+
+    @Test
+    public void emptyContentGivesNoNodes() {
+        assertThat(RichTextParser.parse(null)).isEmpty();
+        assertThat(RichTextParser.parse("  ")).isEmpty();
+    }
+}
