+        <ul t:case="'ul'" t:class="node.cssClass"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></ul>
+        <ol t:case="'ol'" t:class="node.cssClass"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></ol>
+        <li t:case="'li'" t:class="node.cssClass" t:value="node.value"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></li>
+        <blockquote t:case="'blockquote'" t:class="node.cssClass"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></blockquote>
+        <pre t:case="'pre'" t:class="node.cssClass"><t:block t:replace="~{fragments/rich_text :: nodes(node.children)}"></t:block></pre>
