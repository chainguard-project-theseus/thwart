new file mode 100644
index 00000000..8bf422de
--- /dev/null
+++ b/src/test/java/de/fred4jupiter/fredbet/web/view/TesseraRenderingIT.java
@@ -0,0 +1,33 @@
+package de.fred4jupiter.fredbet.web.view;
+
+import de.fred4jupiter.fredbet.common.IntegrationTest;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+/**
+ * Renders pages through the real view resolvers (Tessera templates) and checks that request data comes out escaped.
+ */
+@IntegrationTest
+@AutoConfigureMockMvc
+public class TesseraRenderingIT {
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Test
+    public void loginPageIsRenderedByTesseraAndEscapesRequestData() throws Exception {
+        String body = mockMvc.perform(get("/login").param("q", "<script>alert(1)</script>"))
+            .andExpect(status().isOk())
+            .andReturn().getResponse().getContentAsString();
+
+        assertThat(body).contains("action=\"/login\"");
+        assertThat(body).contains("name=\"_csrf\"");
+        assertThat(body).doesNotContain("<script>alert(1)</script>");
+    }
+}
