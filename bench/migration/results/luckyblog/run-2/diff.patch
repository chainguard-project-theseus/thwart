diff --git a/src/main/resources/templates/layout/macros.html b/src/main/resources/templates/layout/macros.html
new file mode 100644
index 0000000..a8816b5
--- /dev/null
+++ b/src/main/resources/templates/layout/macros.html
@@ -0,0 +1,32 @@
+<div xmlns:t="https://tessera.dev">
+<!-- admin pagination (VM_global_library.vm #flip) -->
+<ul t:fragment="flip(int pageNum, int current, String href)" class="pagination">
+    <li class="disabled" t:if="current < 2"><a href="#">&laquo;</a></li>
+    <li t:unless="current < 2"><a t:href="|${href}/${current - 1}|">&laquo;</a></li>
+    <t:block t:if="pageNum >= 1">
+        <li t:each="page : numbers.sequence(1, pageNum)" t:class="current == page ? 'active'"><a t:href="|${href}/${page}|" t:text="page">1</a></li>
+    </t:block>
+    <li class="disabled" t:if="current >= pageNum"><a href="#">&raquo;</a></li>
+    <li t:unless="current >= pageNum"><a t:href="|${href}/${current + 1}|">&raquo;</a></li>
+</ul>
+<!-- front pagination (VM_global_library.vm #frontFlip). With no page numbers in the model
+     Velocity could not compute $prev/$next and printed the references themselves; kept as is. -->
+<t:block t:fragment="frontFlip(Integer pageNum, Integer current, String href)">
+    <t:block t:if="pageNum != null and current != null">
+        <t:block t:if="pageNum > 1 and current <= 1">
+            <a t:href="|${href}/${current + 1}|" class="default-tag" style="float: right"><i class="fa fa-chevron-right fa-fw"></i> <span class="network-name">Next</span></a>
+        </t:block>
+        <t:block t:if="pageNum > 1 and current > 1 and current >= pageNum">
+            <a t:href="|${href}/${current - 1}|" class="default-tag"><i class="fa fa-chevron-left fa-fw"></i> <span class="network-name">Prev</span></a>
+        </t:block>
+        <t:block t:if="pageNum > 1 and current > 1 and current < pageNum">
+            <a t:href="|${href}/${current - 1}|" class="default-tag"><i class="fa fa-chevron-left fa-fw"></i> <span class="network-name">Prev</span></a>
+            <a t:href="|${href}/${current + 1}|" class="default-tag" style="float: right"><i class="fa fa-chevron-right fa-fw"></i> <span class="network-name">Next</span></a>
+        </t:block>
+    </t:block>
+    <t:block t:unless="pageNum != null and current != null">
+        <a t:href="|${href}/$prev|" class="default-tag"><i class="fa fa-chevron-left fa-fw"></i> <span class="network-name">Prev</span></a>
+        <a t:href="|${href}/$next|" class="default-tag" style="float: right"><i class="fa fa-chevron-right fa-fw"></i> <span class="network-name">Next</span></a>
+    </t:block>
+</t:block>
+</div>
