+ */
+package com.msun.luckyBlog.support.view;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import dev.tessera.runtime.TemplateView;
+
+/**
+ * 富文本(博客html/简历html)解析后的节点，只保留白名单内的标签和属性，由模板 layout/richtext 渲染
+ */
+@TemplateView
+public class RichNode {
+
+    /** 文本节点的 tag */
+    public static final String TEXT = "#text";
+
+    private final String         tag;
+    private final String         text;
+    private final List<RichNode> children = new ArrayList<>();
+    private String               id;
+    private String               cls;
+    private String               name;
+    private String               title;
+    private String               href;
+    private String               src;
+    private String               alt;
+
+    RichNode(String tag, String text) {
+        this.tag = tag;
+        this.text = text;
+    }
+
+    public String getTag() {
+        return tag;
+    }
+
+    public String getText() {
+        return text;
+    }
+
+    public List<RichNode> getChildren() {
+        return children;
+    }
+
+    public String getId() {
+        return id;
+    }
+
+    void setId(String id) {
+        this.id = id;
+    }
+
+    public String getCls() {
+        return cls;
+    }
+
+    void setCls(String cls) {
+        this.cls = cls;
+    }
+
+    public String getName() {
+        return name;
+    }
+
+    void setName(String name) {
+        this.name = name;
+    }
+
+    public String getTitle() {
+        return title;
+    }
+
+    void setTitle(String title) {
+        this.title = title;
+    }
+
+    public String getHref() {
+        return href;
+    }
+
+    void setHref(String href) {
+        this.href = href;
+    }
+
+    public String getSrc() {
+        return src;
+    }
+
+    void setSrc(String src) {
+        this.src = src;
+    }
+
+    public String getAlt() {
+        return alt;
+    }
+
+    void setAlt(String alt) {
+        this.alt = alt;
+    }
+}
diff --git a/src/main/java/com/msun/luckyBlog/support/view/RichText.java b/src/main/java/com/msun/luckyBlog/support/view/RichText.java
new file mode 100644
index 0000000..c4f99ca
--- /dev/null
+++ b/src/main/java/com/msun/luckyBlog/support/view/RichText.java
@@ -0,0 +1,77 @@
+/*
+ * Copyright 2015-2020 msun.com All right reserved.
+ */
+package com.msun.luckyBlog.support.view;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import org.jsoup.Jsoup;
+import org.jsoup.nodes.Element;
+import org.jsoup.nodes.Node;
+import org.jsoup.nodes.TextNode;
+
+/**
+ * 把编辑器(editor.md)生成的html解析为 {@link RichNode} 树。白名单之外的标签只保留其内容，script/style 等连同内容一起丢弃，
+ * 属性只保留 id,class,name,title,href,src,alt（链接地址由模板按 URL 上下文校验）。
+ */
+public final class RichText {
+
+    /** 与模板 layout/richtext.html 中的 t:case 一一对应 */
+    public static final Set<String> TAGS    = Collections.unmodifiableSet(new HashSet<>(Arrays.asList(
+            "p", "br", "hr", "h1", "h2", "h3", "h4", "h5", "h6", "a", "span", "code", "pre", "ol", "ul", "li",
+            "blockquote", "strong", "em", "b", "i", "u", "s", "del", "sup", "sub", "kbd", "table", "thead",
+            "tbody", "tr", "th", "td", "img", "dl", "dt", "dd", "div")));
+
+    private static final Set<String> DROPPED = new HashSet<>(Arrays.asList("script", "style", "iframe", "frame",
+            "frameset", "object", "embed", "applet", "svg", "math", "template", "noscript", "textarea", "select",
+            "button", "input", "form", "link", "meta", "base", "title", "head"));
+
+    private RichText() {
+    }
+
+    public static List<RichNode> parse(String html) {
+        List<RichNode> nodes = new ArrayList<>();
+        if (html != null && !html.isEmpty()) {
+            convert(Jsoup.parseBodyFragment(html).body().childNodes(), nodes);
+        }
+        return nodes;
+    }
+
+    private static void convert(List<Node> in, List<RichNode> out) {
+        for (Node node : in) {
+            if (node instanceof TextNode) {
+                out.add(new RichNode(RichNode.TEXT, ((TextNode) node).getWholeText()));
+            } else if (node instanceof Element) {
+                Element el = (Element) node;
+                String tag = el.normalName();
+                if (DROPPED.contains(tag)) {
+                    continue;
+                }
+                if (!TAGS.contains(tag)) {
+                    convert(el.childNodes(), out);
+                    continue;
+                }
+                RichNode rn = new RichNode(tag, null);
+                rn.setId(attr(el, "id"));
+                rn.setCls(attr(el, "class"));
+                rn.setName(attr(el, "name"));
+                rn.setTitle(attr(el, "title"));
+                rn.setHref(attr(el, "href"));
+                rn.setSrc(attr(el, "src"));
+                rn.setAlt(attr(el, "alt"));
+                convert(el.childNodes(), rn.getChildren());
+                out.add(rn);
+            }
+            // 注释等其它节点丢弃
+        }
+    }
+
+    private static String attr(Element el, String name) {
+        return el.hasAttr(name) ? el.attr(name) : null;
+    }
+}
