diff --git a/src/main/resources/templates/fragments/paging.html b/src/main/resources/templates/fragments/paging.html
new file mode 100644
index 0000000..d11ffc7
--- /dev/null
+++ b/src/main/resources/templates/fragments/paging.html
@@ -0,0 +1,30 @@
+<t:block xmlns:t="https://tessera.dev">
+<!--/* Was the Velocity macro #flip in VM_global_library.vm */-->
+<ul t:fragment="flip(Integer pageNum, Integer current, String href)" class="pagination">
+    <li t:if="current < 2" class="disabled"><a href="#">&laquo;</a></li>
+    <li t:unless="current < 2"><a t:href="|${href}/${current - 1}|">&laquo;</a></li>
+    <t:block t:if="pageNum >= 1" t:each="page : numbers.sequence(1, pageNum)">
+        <li t:if="current == page" class="active"><a t:href="|${href}/${page}|" t:text="page">1</a></li>
+        <li t:unless="current == page"><a t:href="|${href}/${page}|" t:text="page">1</a></li>
+    </t:block>
+    <li t:if="current >= pageNum" class="disabled"><a href="#">&raquo;</a></li>
+    <li t:unless="current >= pageNum"><a t:href="|${href}/${current + 1}|">&raquo;</a></li>
+</ul>
+<!--/* Was the Velocity macro #frontFlip. Without a current page Velocity could not compute
+       $prev/$next and printed the references literally; that output is kept. */-->
+<t:block t:fragment="frontFlip(Integer pageNum, Integer current, String href)">
+    <t:block t:if="current == null">
+        <a t:href="|${href}/$prev|" class="default-tag"><i class="fa fa-chevron-left fa-fw"></i> <span class="network-name">Prev</span></a>
+        <a t:href="|${href}/$next|" class="default-tag" style="float: right"><i class="fa fa-chevron-right fa-fw"></i> <span class="network-name">Next</span></a>
+    </t:block>
+    <t:block t:unless="current == null">
+        <t:block t:if="pageNum > 1">
+            <a t:if="current <= 1" t:href="|${href}/${current + 1}|" class="default-tag" style="float: right"><i class="fa fa-chevron-right fa-fw"></i> <span class="network-name">Next</span></a>
