+/*
+ * Copyright 2015-2020 msun.com All right reserved.
+ */
+package com.msun.luckyBlog.support.view;
+
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * 模板函数：博客文章、简历等由 editor.md 生成并存储的 html 文本，经过白名单过滤后输出
+ */
+@TemplateFunctions("blog")
+public final class BlogFunctions {
+
+    // editor.md / prettify 生成的标签和样式类
+    private static final HtmlPolicy POLICY = HtmlPolicy.builder()//
+    .allowElements("h1", "h2", "h3", "h4", "h5", "h6", "p", "br", "hr", "a", "span", "strong", "b", "em", "i",
+                   "del", "code", "pre", "blockquote", "ul", "ol", "li", "img")//
+    .allowAttributes("id", "title", "alt")//
+    .allowClasses("reference-link", "header-link", "octicon", "octicon-link", "at-link", "prettyprint", "linenums",
+                  "prettyprinted", "lang-*", "L*", "pln", "pun", "kwd", "com", "str", "lit", "typ", "tag", "atn",
+                  "atv", "dec", "fun")//
+    .build();
