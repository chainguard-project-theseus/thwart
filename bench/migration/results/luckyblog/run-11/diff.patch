@@ -0,0 +1,96 @@
+/*
+ * Copyright 2015-2020 msun.com All right reserved.
+ */
+package com.msun.luckyBlog.view;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import dev.tessera.runtime.TemplateView;
+
+/**
+ * 分页链接, 取代 VM_global_library.vm 中的 flip / frontFlip 宏
+ */
+@TemplateView
+public class Pager {
+
+    private final String     prevUrl; // null 表示没有(或禁用)上一页
+    private final String     nextUrl; // null 表示没有(或禁用)下一页
+    private final List<Page> pages;
+
+    private Pager(String prevUrl, String nextUrl, List<Page> pages) {
+        this.prevUrl = prevUrl;
+        this.nextUrl = nextUrl;
+        this.pages = pages;
+    }
+
+    /**
+     * 前台的 Prev / Next 链接(原 frontFlip 宏). 原宏在 pageNum 与 current 都为空时两个链接都会输出, 且链接为 "$href/$prev"
+     * 字面量, 这里照原样保留.
+     */
+    public static Pager front(String href, Integer pageNum, Integer current) {
+        List<Page> none = new ArrayList<>();
+        if (pageNum == null || current == null) {
+            return new Pager(href + "/$prev", href + "/$next", none);
+        }
+        if (pageNum <= 1) {
+            return new Pager(null, null, none);
+        } else if (current <= 1) {
+            return new Pager(null, href + "/" + (current + 1), none);
+        } else if (current >= pageNum) {
+            return new Pager(href + "/" + (current - 1), null, none);
+        }
+        return new Pager(href + "/" + (current - 1), href + "/" + (current + 1), none);
+    }
+
+    /**
+     * 后台的分页条(原 flip 宏).
+     */
+    public static Pager admin(String href, int pageNum, int current) {
+        List<Page> pages = new ArrayList<>();
+        for (int page = 1; page <= pageNum; page++) {
+            pages.add(new Page(page, href + "/" + page, current == page));
+        }
+        String prev = current < 2 ? null : href + "/" + (current - 1);
+        String next = current >= pageNum ? null : href + "/" + (current + 1);
+        return new Pager(prev, next, pages);
+    }
+
+    public String getPrevUrl() {
+        return prevUrl;
+    }
+
+    public String getNextUrl() {
+        return nextUrl;
+    }
+
+    public List<Page> getPages() {
+        return pages;
+    }
+
+    @TemplateView
+    public static class Page {
+
+        private final int     number;
+        private final String  url;
+        private final boolean active;
+
+        public Page(int number, String url, boolean active) {
+            this.number = number;
+            this.url = url;
+            this.active = active;
+        }
+
+        public int getNumber() {
+            return number;
+        }
+
+        public String getUrl() {
+            return url;
+        }
+
+        public boolean isActive() {
+            return active;
+        }
+    }
+}
