@@ -0,0 +1,65 @@
+/*
+ * Copyright 2015-2020 msun.com All right reserved.
+ */
+package com.msun.luckyBlog.view;
+
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * 博客正文与简历是 editor.md 生成后存进数据库的 html, 原先 velocity 直接原样输出. 这里按 editor.md 的输出(标题、代码块、
+ * prettify 高亮的 class 等)做白名单过滤.
+ */
+@TemplateFunctions("editormd")
+public final class ArticleFunctions {
+
+    private static final HtmlPolicy POLICY = HtmlPolicy.builder()//
+    .allowElements("a", "b", "i", "em", "strong", "u", "s", "del", "ins", "sub", "sup", "small", "mark", "code", "kbd",
+                   "span", "br", "img", "p", "h1", "h2", "h3", "h4", "h5", "h6", "pre", "blockquote", "ul", "ol",
+                   "li", "div", "hr")//
+    .allowAttributes("id", "title", "alt", "width", "height", "start", "reversed", "value")//
+    // editor.md 的标题锚点, prettify 代码高亮, 代码语言
+    .allowClasses("reference-link", "header-link", "octicon", "octicon-link", "at-link", "prettyprint",
+                  "prettyprinted", "linenums", "L*", "lang-*", "language-*", "pln", "pun", "kwd", "typ", "str",
+                  "com", "lit", "tag", "atn", "atv", "dec", "var", "fun", "editormd-*", "markdown-*")//
+    .allowLinkTarget()//
+    .build();
+
+    private static final Pattern PRE       = Pattern.compile("(<pre\\b[^>]*>)(.*?)(</pre>)",
+                                                         Pattern.CASE_INSENSITIVE | Pattern.DOTALL);
+    private static final Pattern LIST_TAG  = Pattern.compile("</?ol\\b[^>]*>|<li\\b[^>]*>",
+                                                         Pattern.CASE_INSENSITIVE);
+    private static final Pattern LI_END    = Pattern.compile("</li\\s*>", Pattern.CASE_INSENSITIVE);
+
+    private ArticleFunctions() {
+    }
+
+    @TemplateFunction
+    public static SafeHtml html(String text) {
+        return SafeHtml.sanitize(flattenCodeLines(text), POLICY);
+    }
+
+    /**
+     * prettify 的 linenums 把代码块的每一行写成 &lt;pre&gt;&lt;ol&gt;&lt;li&gt;. 过滤器会丢掉 pre 里的 ol/li 开始标签却保留结束标签,
+     * 使外层列表提前闭合, 所以先把这些行改成以换行分隔的文本.
+     */
+    static String flattenCodeLines(String text) {
+        if (text == null) {
+            return null;
+        }
+        Matcher m = PRE.matcher(text);
+        StringBuffer sb = new StringBuffer();
+        while (m.find()) {
+            String body = LI_END.matcher(m.group(2)).replaceAll("\n");
+            body = LIST_TAG.matcher(body).replaceAll("");
+            m.appendReplacement(sb, Matcher.quoteReplacement(m.group(1) + body + m.group(3)));
+        }
+        m.appendTail(sb);
+        return sb.toString();
+    }
+}
