+/*
+ * Copyright 2015-2020 msun.com All right reserved.
+ */
+package com.msun.luckyBlog.view;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import dev.tessera.runtime.TemplateView;
+
+import com.msun.luckyBlog.persistence.domain.Project;
+
+/**
+ * 模板中显示的项目. 日期按原页面的格式(Timestamp.toString)输出
+ */
+@TemplateView
+public class ProjectView {
+
+    private final int    id;
+    private final String name;
+    private final String url;
+    private final String tech;
+    private final String desp;
+    private final String date;
+
+    public ProjectView(Project p) {
+        this.id = p.getId();
+        this.name = p.getName();
+        this.url = p.getUrl();
+        this.tech = p.getTech();
+        this.desp = p.getDesp();
+        this.date = p.getDate() == null ? null : p.getDate().toString();
+    }
+
+    public static List<ProjectView> of(List<Project> projects) {
+        if (projects == null) {
+            return null;
+        }
+        List<ProjectView> views = new ArrayList<>();
+        for (Project p : projects) {
+            views.add(new ProjectView(p));
+        }
+        return views;
+    }
+
+    public int getId() {
+        return id;
+    }
+
+    public String getName() {
+        return name;
+    }
+
+    public String getUrl() {
+        return url;
+    }
+
+    public String getTech() {
+        return tech;
+    }
+
+    public String getDesp() {
+        return desp;
+    }
+
+    public String getDate() {
+        return date;
+    }
+}
