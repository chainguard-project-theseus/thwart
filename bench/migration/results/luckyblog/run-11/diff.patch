diff --git a/src/main/resources/templates/module/pager.html b/src/main/resources/templates/module/pager.html
new file mode 100644
index 0000000..07dc6dd
--- /dev/null
+++ b/src/main/resources/templates/module/pager.html
@@ -0,0 +1,13 @@
+<t:block xmlns:t="https://tessera.dev" t:import="com.msun.luckyBlog.view.Pager">
+<t:block t:fragment="frontFlip(Pager pager)">
+    <a t:if="pager.prevUrl != null" t:href="pager.prevUrl" class="default-tag"><i class="fa fa-chevron-left fa-fw"></i> <span class="network-name">Prev</span></a>
+    <a t:if="pager.nextUrl != null" t:href="pager.nextUrl" class="default-tag" style="float: right"><i class="fa fa-chevron-right fa-fw"></i> <span class="network-name">Next</span></a>
+</t:block>
+<ul t:fragment="flip(Pager pager)" class="pagination">
+    <li t:if="pager.prevUrl == null" class="disabled"><a href="#">&laquo;</a></li>
+    <li t:unless="pager.prevUrl == null"><a t:href="pager.prevUrl">&laquo;</a></li>
+    <li t:each="p : pager.pages" t:class="p.active ? 'active'"><a t:href="p.url" t:text="p.number">1</a></li>
+    <li t:if="pager.nextUrl == null" class="disabled"><a href="#">&raquo;</a></li>
+    <li t:unless="pager.nextUrl == null"><a t:href="pager.nextUrl">&raquo;</a></li>
+</ul>
+</t:block>
