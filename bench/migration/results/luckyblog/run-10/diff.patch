diff --git a/src/main/resources/templates/fragments/flip.html b/src/main/resources/templates/fragments/flip.html
new file mode 100644
index 0000000..dca8618
--- /dev/null
+++ b/src/main/resources/templates/fragments/flip.html
@@ -0,0 +1,25 @@
+<div xmlns:t="https://tessera.dev">
+<!--/* Pagination of the admin lists (the old VM_global_library.vm #flip macro) */-->
+<ul t:fragment="flip(int pageNum, int current, String href)" class="pagination">
+    <li t:if="current < 2" class="disabled"><a href="#">&laquo;</a></li>
+    <li t:unless="current < 2"><a t:href="|${href}/${current - 1}|">&laquo;</a></li>
+    <t:block t:if="pageNum >= 1" t:each="page : numbers.sequence(1, pageNum)">
+        <li t:if="current == page" class="active"><a t:href="|${href}/${page}|" t:text="page">1</a></li>
+        <li t:unless="current == page"><a t:href="|${href}/${page}|" t:text="page">1</a></li>
+    </t:block>
+    <li t:if="current >= pageNum" class="disabled"><a href="#">&raquo;</a></li>
+    <li t:unless="current >= pageNum"><a t:href="|${href}/${current + 1}|">&raquo;</a></li>
+</ul>
+<!--/* Prev/Next links of the front pages (the old #frontFlip macro). Without paging data the old
+       macro printed its unresolved references literally, which is kept. */-->
+<t:block t:fragment="frontFlip(Integer pageNum, Integer current, String href)">
+    <t:block t:if="pageNum == null or current == null">
+        <a t:href="href + '/$prev'" class="default-tag"><i class="fa fa-chevron-left fa-fw"></i> <span class="network-name">Prev</span></a>
+        <a t:href="href + '/$next'" class="default-tag" style="float: right"><i class="fa fa-chevron-right fa-fw"></i> <span class="network-name">Next</span></a>
+    </t:block>
+    <t:block t:unless="pageNum == null or current == null">
+        <a t:if="pageNum > 1 and current > 1" t:href="|${href}/${current - 1}|" class="default-tag"><i class="fa fa-chevron-left fa-fw"></i> <span class="network-name">Prev</span></a>
+        <a t:if="pageNum > 1 and current < pageNum" t:href="|${href}/${current + 1}|" class="default-tag" style="float: right"><i class="fa fa-chevron-right fa-fw"></i> <span class="network-name">Next</span></a>
+    </t:block>
+</t:block>
+</div>
