+/*
+ * Copyright 2015-2020 msun.com All right reserved.
+ */
+package com.msun.luckyBlog.view;
+
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * 博客文章和简历的html文本(editor.md生成)在页面上的输出，经过白名单过滤
+ */
+@TemplateFunctions("blog")
+public final class BlogFunctions {
+
+    // RICH's elements and attributes, plus the classes editor.md and prettify write, and no rel on links
+    private static final HtmlPolicy POLICY = HtmlPolicy.builder()
+            .allowElements(HtmlPolicy.ELEMENTS.toArray(new String[0]))
+            .allowAttributes(HtmlPolicy.ATTRIBUTES.toArray(new String[0]))
+            .allowClasses("lang-*", "language-*", "prettyprint", "prettyprinted", "linenums", "L0", "L1", "L2", "L3",
+                          "L4", "L5", "L6", "L7", "L8", "L9", "pln", "pun", "str", "kwd", "com", "typ", "lit", "tag",
+                          "atn", "atv", "dec", "var", "fun", "reference-link", "header-link", "octicon",
+                          "octicon-link", "at-link", "editormd-*")
+            .linkRel()
+            .build();
+
+    private BlogFunctions() {
+    }
+
+    @TemplateFunction
+    public static SafeHtml html(Object text) {
+        return SafeHtml.sanitize(text == null ? null : text.toString(), POLICY);
+    }
+}
