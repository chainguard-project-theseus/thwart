+/*
+ * Copyright 2015-2020 msun.com All right reserved.
+ */
+package com.msun.luckyBlog.view;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import com.msun.luckyBlog.persistence.domain.Project;
+
+import dev.tessera.runtime.TemplateView;
+
+/**
+ * 项目列表页面显示用的视图对象，日期按Timestamp.toString()的格式显示
+ */
+@TemplateView
+public class ProjectRow {
+
+    private final int    id;
+    private final String name;
+    private final String url;
+    private final String tech;
+    private final String desp;
+    private final String date;
+
+    public ProjectRow(Project project) {
+        this.id = project.getId();
+        this.name = project.getName();
+        this.url = project.getUrl();
+        this.tech = project.getTech();
+        this.desp = project.getDesp();
+        this.date = project.getDate() == null ? null : project.getDate().toString();
+    }
+
+    public static List<ProjectRow> of(List<Project> projects) {
+        if (projects == null) {
+            return null;
+        }
+        List<ProjectRow> rows = new ArrayList<>();
+        for (Project project : projects) {
+            rows.add(new ProjectRow(project));
+        }
+        return rows;
+    }
