+<body t:remove="tag">
+<div class="container">
+    <div class="row">
+        <div class="col-lg-12 post">
+            <div class="editormd-preview" id="md-container">
+                <div class="markdown-body editormd-preview-container" previewcontainer="true" style="padding: 20px;" t:utext="blog.html(article)">
+                </div>
+            </div>
+            <br><br>
