+<!DOCTYPE html>
+<html lang="en" xmlns:t="https://tessera.dev" t:params="String targetUrl, Integer result">
+<head>
+    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
+    <title>success</title>
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <t:block t:switch="targetUrl">
+    <meta t:case="'/admin/info'" http-equiv="refresh" content="1;url=/admin/info">
+    <meta t:case="'/admin/blog_add'" http-equiv="refresh" content="1;url=/admin/blog_add">
+    <meta t:case="'/admin/blogList/1'" http-equiv="refresh" content="1;url=/admin/blogList/1">
+    <meta t:case="'/admin/updatenull'" http-equiv="refresh" content="1;url=/admin/updatenull">
+    <meta t:case="'/'" http-equiv="refresh" content="1;url=/">
+    <meta t:case="*" http-equiv="refresh" content="1;url=/admin/blogList/1">
+    </t:block>
+    <link rel="stylesheet" href="/css/result-page.min.css" type="text/css">
+</head>
+<body>
+<t:block t:if="result == null or result > 0">
+<h1 class="success">Operation succeeded!</h1>
+<p class="success">Congratulations,your operation has been successful.</p>
+</t:block>
+<t:block t:unless="result == null or result > 0">
+ <h1 class="fail">Operation failed!</h1>
+ <p class="fail">Unfortunately,your operation has failed.</p>
+ <br>
+ <p class="errorInfo">For more details, please check the log</p>
+</t:block>
+</body>
+</html>
