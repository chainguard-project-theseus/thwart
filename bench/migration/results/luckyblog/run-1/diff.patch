+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="com.msun.luckyBlog.persistence.domain.*, com.msun.luckyBlog.support.view.RichNode"
+      t:params="Info info, List<RichNode> article, BlogView prev, BlogView next"
+      t:replace="~{module/front :: front(info, ~{::body})}">
+<body t:remove="tag">
+<div class="container">
+    <div class="row">
+        <div class="col-lg-12 post">
+            <div class="editormd-preview" id="md-container">
+                <div class="markdown-body editormd-preview-container" previewcontainer="true" style="padding: 20px;">
+                <t:block t:replace="~{fragments/rich :: nodes(article)}"></t:block>
+                </div>
+            </div>
+            <br><br>
+            <a t:if="prev != null" t:href="|/post/${prev.vid == null ? '' : '' + prev.vid}|" class="post-flip"><i class="fa fa-arrow-left"></i>&nbsp;[[${prev.title}]]</a>
+            <a t:if="next != null" t:href="|/post/${next.vid == null ? '' : '' + next.vid}|" class="post-flip" style="float: right;">[[${next.title}]]&nbsp;<i class="fa fa-arrow-right"></i></a>
+        </div>
+    </div>
+</div>
+</body>
+</html>
