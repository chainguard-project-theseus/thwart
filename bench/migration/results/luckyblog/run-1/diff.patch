+/*
+ * Copyright 2015-2020 msun.com All right reserved.
+ */
+package com.msun.luckyBlog.support.view;
+
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+
+import dev.tessera.runtime.TemplateView;
+
+/**
+ * 富文本(博客html、简历html)解析后的节点, 由 templates/fragments/rich.html 递归渲染. 文本节点的 tag 为 "#text".
+ */
+@TemplateView
+public final class RichNode {
+
+    public static final String TEXT = "#text";
+
+    private final String              tag;
+    private final String              text;
+    private final Map<String, String> attrs;
+    private final List<RichNode>      children;
+
+    RichNode(String tag, String text, Map<String, String> attrs, List<RichNode> children) {
+        this.tag = tag;
+        this.text = text;
+        this.attrs = attrs == null ? Collections.<String, String> emptyMap() : attrs;
+        this.children = children == null ? Collections.<RichNode> emptyList() : children;
+    }
+
+    public String getTag() {
+        return tag;
+    }
+
+    public String getText() {
+        return text;
+    }
+
+    public Map<String, String> getAttrs() {
+        return attrs;
+    }
+
+    public List<RichNode> getChildren() {
+        return children;
+    }
+}
