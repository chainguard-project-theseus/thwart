+/*
+ * Copyright 2015-2020 msun.com All right reserved.
+ */
+package com.msun.luckyBlog.support.view;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import org.jsoup.Jsoup;
+import org.jsoup.nodes.Attribute;
+import org.jsoup.nodes.Element;
+import org.jsoup.nodes.Node;
+import org.jsoup.nodes.TextNode;
+
+/**
+ * 把数据库中保存的html(editor.md 生成的博客/简历)解析成 {@link RichNode} 树. 只保留白名单中的元素和属性, 其余元素去掉标签保留文本,
+ * script/style 等连同内容一起删除; 输出时由模板按上下文转义, 链接经过 URL 校验. 白名单要与 templates/fragments/rich.html 保持一致.
+ */
+public final class RichText {
+
+    /** 渲染的元素, 与 rich.html 中的 t:case 一一对应 */
+    public static final Set<String> TAGS       = new HashSet<String>(Arrays.asList(
+            "a", "abbr", "b", "blockquote", "br", "caption", "center", "cite", "code", "dd", "del", "div", "dl", "dt",
+            "em", "figcaption", "figure", "font", "h1", "h2", "h3", "h4", "h5", "h6", "hr", "i", "img", "ins", "kbd",
+            "li", "mark", "ol", "p", "pre", "q", "s", "samp", "small", "span", "strike", "strong", "sub", "sup",
+            "table", "tbody", "td", "tfoot", "th", "thead", "tr", "u", "ul", "var"));
+
+    /** 渲染的属性, 与 rich.html 中每个元素上的 t: 属性一一对应 */
+    public static final Set<String> ATTRS      = new HashSet<String>(Arrays.asList(
+            "id", "class", "name", "title", "alt", "href", "src", "target", "rel", "width", "height", "align",
+            "colspan", "rowspan", "start", "lang", "dir"));
+
+    /** style 只保留 editor.md 表格对齐生成的这几个值(模板中以字面量输出) */
+    public static final Set<String> STYLES     = new HashSet<String>(Arrays.asList(
+            "text-align:left", "text-align:center", "text-align:right"));
+
+    /** 连同内容一起删除的元素 */
+    private static final Set<String> DROPPED   = new HashSet<String>(Arrays.asList(
+            "script", "style", "iframe", "frame", "frameset", "object", "embed", "applet", "svg", "math",
+            "template", "noscript", "noembed", "noframes", "textarea", "select", "button", "input", "form",
+            "link", "meta", "base", "title", "head", "audio", "video", "canvas", "xmp", "plaintext"));
+
+    private RichText() {
+    }
+
+    public static List<RichNode> parse(String html) {
+        if (html == null || html.isEmpty()) {
+            return Collections.emptyList();
+        }
+        return convert(Jsoup.parseBodyFragment(html).body().childNodes());
+    }
+
+    private static List<RichNode> convert(List<Node> nodes) {
+        List<RichNode> out = new ArrayList<RichNode>();
+        for (Node node : nodes) {
+            if (node instanceof TextNode) {
+                out.add(new RichNode(RichNode.TEXT, ((TextNode) node).getWholeText(), null, null));
+            } else if (node instanceof Element) {
+                Element element = (Element) node;
+                String tag = element.normalName();
+                if (DROPPED.contains(tag)) {
+                    continue;
+                }
+                List<RichNode> children = convert(element.childNodes());
+                if (TAGS.contains(tag)) {
+                    Map<String, String> attrs = new LinkedHashMap<String, String>();
+                    for (Attribute attribute : element.attributes()) {
+                        String key = attribute.getKey().toLowerCase();
+                        if (ATTRS.contains(key)) {
+                            attrs.put(key, attribute.getValue());
+                        } else if ("style".equals(key) && STYLES.contains(attribute.getValue())) {
+                            attrs.put(key, attribute.getValue());
+                        }
+                    }
+                    out.add(new RichNode(tag, null, attrs, children));
+                } else {
+                    out.addAll(children);
+                }
+            }
+            // comments, doctype and script data are dropped
+        }
+        return out;
+    }
+}
