+<div xmlns:t="https://tessera.dev">
+<!-- The avatar box. A style attribute only takes literals and CssValues (there is no CssValue for url(...)), so the
+     background image can only be written for the known default avatar; any other avatar renders without it. -->
+<div class="login-avatar" t:fragment="avatar(String avatar)"
+     t:style="avatar == '/img/avatar.jpg' ? 'background: url(/img/avatar.jpg) no-repeat center center;' : 'background: no-repeat center center;'"></div>
+</div>
diff --git a/src/main/resources/templates/fragments/flip.html b/src/main/resources/templates/fragments/flip.html
new file mode 100644
index 0000000..6113ff8
--- /dev/null
+++ b/src/main/resources/templates/fragments/flip.html
@@ -0,0 +1,23 @@
+<div xmlns:t="https://tessera.dev">
+<!-- Pagination, ported from the velocity macros #flip (admin lists) and #frontFlip (front pages) of VM_global_library.vm. -->
+<ul class="pagination" t:fragment="flip(int pageNum, int current, String href)">
+    <li class="disabled" t:if="current < 2"><a href="#">&laquo;</a></li>
+    <li t:unless="current < 2"><a t:href="|${href}/${current - 1}|">&laquo;</a></li>
+    <t:block t:if="pageNum > 0" t:each="page : numbers.sequence(1, pageNum)">
+        <li class="active" t:if="current == page"><a t:href="|${href}/${page}|" t:text="page">1</a></li>
+        <li t:unless="current == page"><a t:href="|${href}/${page}|" t:text="page">1</a></li>
+    </t:block>
+    <li class="disabled" t:if="current >= pageNum"><a href="#">&raquo;</a></li>
+    <li t:unless="current >= pageNum"><a t:href="|${href}/${current + 1}|">&raquo;</a></li>
+</ul>
+<!-- Velocity printed the undefined references $prev/$next literally when the page had no paging data (GET /projects). -->
+<t:block t:fragment="frontFlip(Integer pageNum, Integer current, String href)"
+         t:with="prev=current == null ? '$prev' : '' + (current - 1), next=current == null ? '$next' : '' + (current + 1)">
+    <t:block t:if="pageNum == null or current == null or (pageNum > 1 and current > 1 and current < pageNum)">
+        <a t:href="|${href}/${prev}|" class="default-tag"><i class="fa fa-chevron-left fa-fw"></i> <span class="network-name">Prev</span></a>
+        <a t:href="|${href}/${next}|" class="default-tag" style="float: right"><i class="fa fa-chevron-right fa-fw"></i> <span class="network-name">Next</span></a>
+    </t:block>
+    <a t:if="pageNum != null and current != null and pageNum > 1 and current <= 1" t:href="|${href}/${next}|" class="default-tag" style="float: right"><i class="fa fa-chevron-right fa-fw"></i> <span class="network-name">Next</span></a>
+    <a t:if="pageNum != null and current != null and pageNum > 1 and current > 1 and current >= pageNum" t:href="|${href}/${prev}|" class="default-tag"><i class="fa fa-chevron-left fa-fw"></i> <span class="network-name">Prev</span></a>
+</t:block>
+</div>
