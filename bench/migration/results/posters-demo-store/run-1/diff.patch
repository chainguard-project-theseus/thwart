+package com.xceptance.posters.view;
+
+import java.math.BigDecimal;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Template functions for the storefront templates ({@code shop.*}).
+ */
+// AI-generated: Claude Opus 5.5
+@TemplateFunctions("shop")
+public final class StorefrontFunctions
+{
+    private static final BigDecimal ONE_HUNDRED = BigDecimal.valueOf(100);
+
+    private StorefrontFunctions()
+    {
+    }
+
+    /**
+     * Parses a plain decimal string (as {@code CommonDataInterceptor} stores the cart totals) so that
+     * {@code numbers.formatCurrency} can format it, as Thymeleaf's conversion service did.
+     *
+     * @param amount
+     *            the plain decimal string, may be {@code null} or blank
+     * @return the decimal value, or {@code null} if there is none
+     */
+    @TemplateFunction
+    public static BigDecimal decimal(final String amount)
+    {
+        if (amount == null || amount.isBlank())
+        {
+            return null;
+        }
+        return new BigDecimal(amount.trim());
+    }
+
+    /**
+     * Converts a rate to percent ({@code rate * 100}); Tessera expressions have no {@link BigDecimal}
+     * arithmetic.
+     *
+     * @param rate
+     *            the rate, e.g. {@code 0.06}, may be {@code null}
+     * @return the percentage, e.g. {@code 6.00}, or {@code null}
+     */
+    @TemplateFunction
+    public static BigDecimal percent(final BigDecimal rate)
+    {
+        return rate == null ? null : rate.multiply(ONE_HUNDRED);
+    }
+}
