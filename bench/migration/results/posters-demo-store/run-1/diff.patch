+     * @return the view record
+     */
+    public static BackofficeCustomerView of(final Customer customer)
+    {
+        final List<BackofficeCreditCardView> cards = new ArrayList<>();
+        if (customer.getCreditCards() != null)
+        {
+            for (final CatalogCreditCard card : customer.getCreditCards())
+            {
+                cards.add(BackofficeCreditCardView.of(card));
+            }
+        }
+        return new BackofficeCustomerView(customer.getId() != null ? customer.getId().toString() : null,
+                                          customer.getCustomerNumber(), customer.getEmail(),
+                                          customer.getFirstName(), customer.getMiddleName(),
+                                          customer.getLastName(), customer.getCreatedAt(), customer.getVersion(),
+                                          cards);
+    }
+}
