+ * limitations under the License.
+ */
+package com.xceptance.posters.view;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.security.web.csrf.CsrfToken;
+
+import com.xceptance.posters.interceptor.CommonDataInterceptor;
+import com.xceptance.posters.interceptor.CommonDataInterceptor.CategoryDto;
+
+import jakarta.servlet.http.HttpServletRequest;
+
+/**
+ * Everything the storefront layout ({@code layout/default}) shows on every page: header navigation,
+ * locale switcher, login state, mini cart count, flash messages and the CSRF token for scripts.
+ * Built from the values {@link CommonDataInterceptor} has already put into the model.
+ *
+ * @param urlLocale
+ *            the locale segment of the request URL
+ * @param topCategory
+ *            the navigation categories
+ * @param currentLanguageFlag
+ *            the flag of the current locale
+ * @param languages
+ *            the locale switcher entries
+ * @param logged
+ *            whether a customer is logged in
+ * @param customerFirstName
+ *            the logged-in customer's first name, or {@code null}
+ * @param cartProductCount
+ *            the number of items in the cart
+ * @param currentVersion
+ *            the application version
+ * @param error
+ *            an error message to show, or {@code null}
+ * @param success
+ *            a success message to show, or {@code null}
+ * @param csrfToken
+ *            the CSRF token for JavaScript requests, or {@code null}
+ * @param csrfHeaderName
+ *            the CSRF header name for JavaScript requests, or {@code null}
+ */
+// AI-generated: Claude Opus 5.5
+public record StorefrontLayout(String urlLocale, List<CategoryDto> topCategory, String currentLanguageFlag,
+                               List<StorefrontLanguage> languages, boolean logged, String customerFirstName,
+                               int cartProductCount, String currentVersion, String error, String success,
+                               String csrfToken, String csrfHeaderName)
+{
+    /**
+     * Builds the layout values from a model already filled by {@link CommonDataInterceptor}.
+     *
+     * @param model
+     *            the model of the current request
+     * @param request
+     *            the current request (for the CSRF token)
+     * @return the layout values
+     */
+    @SuppressWarnings("unchecked")
+    public static StorefrontLayout from(final Map<String, Object> model, final HttpServletRequest request)
+    {
+        final List<String> codes = (List<String>) model.get("supportedLanguages");
+        final Map<String, String> flags = (Map<String, String>) model.get("languageFlags");
+        final Map<String, String> names = (Map<String, String>) model.get("languageNames");
+        final List<StorefrontLanguage> languages = new ArrayList<>();
+        if (codes != null)
+        {
+            for (final String code : codes)
+            {
+                languages.add(new StorefrontLanguage(code, flags.get(code), names.get(code)));
+            }
+        }
+        final Object token = request.getAttribute(CsrfToken.class.getName());
+        final CsrfToken csrf = token instanceof final CsrfToken t ? t : null;
+        final Object count = model.get("cartProductCount");
+        return new StorefrontLayout(text(model.get("urlLocale")),
+                                    (List<CategoryDto>) model.get("topCategory"),
+                                    text(model.get("currentLanguageFlag")),
+                                    List.copyOf(languages),
+                                    Boolean.TRUE.equals(model.get("isLogged")),
+                                    text(model.get("customerFirstName")),
+                                    count instanceof final Integer i ? i : 0,
+                                    text(model.get("currentVersion")),
+                                    text(model.get("error")),
+                                    text(model.get("success")),
+                                    csrf == null ? null : csrf.getToken(),
+                                    csrf == null ? null : csrf.getHeaderName());
+    }
+
+    /**
+     * Converts a model value to its string form, keeping {@code null}.
+     *
+     * @param value
+     *            the model value
+     * @return its string form, or {@code null}
+     */
+    private static String text(final Object value)
+    {
+        return value == null ? null : value.toString();
+    }
+}
