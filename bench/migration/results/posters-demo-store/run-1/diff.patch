+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.xceptance.posters.view.checkout;
+
+import org.springframework.security.web.csrf.CsrfToken;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+
+import com.xceptance.posters.controller.CheckoutController;
+
+import jakarta.servlet.http.HttpServletRequest;
+
+/**
+ * Exposes Spring Security's CSRF token to the checkout layout, which writes it into
+ * {@code <meta name="_csrf">} for HTMX. Tessera templates cannot read request attributes, so the token
+ * has to come from the model. Limited to {@link CheckoutController} so that it does not collide with
+ * model attributes of other pages.
+ */
+// AI-generated: Claude Opus 5.5
+@ControllerAdvice(assignableTypes = CheckoutController.class)
+public class CheckoutCsrfModelAdvice
+{
+    /**
+     * The CSRF token value.
+     *
+     * @param request the current request
+     * @return the token, or {@code null} without CSRF protection
+     */
+    @ModelAttribute("checkoutCsrfToken")
+    public String csrfToken(final HttpServletRequest request)
+    {
+        final CsrfToken token = (CsrfToken) request.getAttribute(CsrfToken.class.getName());
+        return token == null ? null : token.getToken();
+    }
+
+    /**
+     * The name of the CSRF header.
+     *
+     * @param request the current request
+     * @return the header name, or {@code null} without CSRF protection
+     */
+    @ModelAttribute("checkoutCsrfHeaderName")
+    public String csrfHeaderName(final HttpServletRequest request)
+    {
+        final CsrfToken token = (CsrfToken) request.getAttribute(CsrfToken.class.getName());
+        return token == null ? null : token.getHeaderName();
+    }
+}
