+ * limitations under the License.
+ */
+package com.xceptance.posters.view.checkout;
+
+import java.math.BigDecimal;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Template functions used by the checkout templates ({@code checkout.*}).
+ */
+// AI-generated: Claude Opus 5.5
+@TemplateFunctions("checkout")
+public final class CheckoutFunctions
+{
+    private static final BigDecimal HUNDRED = BigDecimal.valueOf(100);
+
+    private CheckoutFunctions()
+    {
+        // function holder
+    }
+
+    /**
+     * Returns the part of {@code text} after the first occurrence of {@code separator}, like Thymeleaf's
+     * {@code #strings.substringAfter}: an empty string if the separator does not occur, {@code null} for
+     * {@code null} text.
+     *
+     * @param text the text, may be {@code null}
+     * @param separator the separator
+     * @return the substring after the separator
+     */
+    @TemplateFunction
+    public static String substringAfter(final String text, final String separator)
+    {
+        if (text == null)
+        {
+            return null;
+        }
+        final int index = text.indexOf(separator);
+        return index < 0 ? "" : text.substring(index + separator.length());
+    }
+
+    /**
+     * Converts a fraction to a percentage ({@code 0.06} becomes {@code 6.00}).
+     *
+     * @param fraction the fraction, may be {@code null}
+     * @return the percentage, or {@code null} for {@code null}
+     */
+    @TemplateFunction
+    public static BigDecimal percent(final BigDecimal fraction)
+    {
+        return fraction == null ? null : fraction.multiply(HUNDRED);
+    }
+}
