+            displayName = principal.getDisplayName();
+            modules = principal.getPermittedModuleIds();
+        }
+        else
+        {
+            displayName = "Admin";
+            modules = Collections.emptySet();
+        }
+        final Object attribute = request.getAttribute(CsrfToken.class.getName());
+        final CsrfToken token = attribute instanceof final CsrfToken csrf ? csrf : null;
+        return new BackofficeChrome(displayName,
+                                    modules,
+                                    includeUri ? request.getRequestURI() : null,
+                                    token != null ? token.getToken() : null,
+                                    token != null ? token.getHeaderName() : null);
+    }
+}
