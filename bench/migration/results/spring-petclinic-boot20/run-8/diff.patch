@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.system;
+
+import org.springframework.boot.autoconfigure.web.ConditionalOnEnabledResourceChain;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.web.servlet.resource.ResourceUrlEncodingFilter;
+
+/**
+ * Registers {@link ResourceUrlEncodingFilter} the way Spring Boot 2.0's Thymeleaf
+ * auto-configuration did (request dispatches only), so that resource links on error pages stay
+ * unversioned as they were before the move to Tessera. Tessera's starter backs off when this
+ * bean is present.
+ */
+@Configuration
+class WebConfiguration {
+
+    @Bean
+    @ConditionalOnEnabledResourceChain
