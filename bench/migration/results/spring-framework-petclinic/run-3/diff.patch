+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.web;
+
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
+import dev.tessera.runtime.TemplateRegistry;
+import dev.tessera.spring.context.SpringRenderContexts;
+import dev.tessera.spring.view.TesseraView;
+import dev.tessera.spring.view.TesseraViewResolver;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.springframework.beans.factory.BeanClassLoaderAware;
+import org.springframework.util.StringUtils;
+import org.springframework.web.servlet.View;
+import org.springframework.web.servlet.ViewResolver;
+import org.springframework.web.servlet.view.InternalResourceView;
+import org.springframework.web.servlet.view.RedirectView;
+import org.springframework.web.servlet.view.UrlBasedViewResolver;
+import org.springframework.web.util.UrlPathHelper;
+
+/**
+ * Resolves view names to the Tessera templates compiled from {@code src/main/resources/templates}
+ * (view name {@code owners/ownerDetails} is {@code templates/owners/ownerDetails.html}).
+ * <p/>
+ * Templates have no access to the request, so every rendered template also receives the model
+ * attribute {@value #REQUEST_URI_ATTRIBUTE}: the URI of the current request, used as the action
+ * of forms that post back to the page that displayed them.
+ * <p/>
+ * {@code redirect:} and {@code forward:} view names are handled as by {@link UrlBasedViewResolver}.
+ * A view name without a template resolves to a view that answers 404 Not Found, as the
+ * JSP view resolver did by forwarding to a missing JSP.
+ */
+public class TemplateViewResolver implements ViewResolver, BeanClassLoaderAware {
+
+    public static final String REQUEST_URI_ATTRIBUTE = "requestUri";
+
+    private static final UrlPathHelper URL_PATH_HELPER = new UrlPathHelper();
+
+    private TesseraViewResolver delegate;
+
+    @Override
+    public void setBeanClassLoader(ClassLoader classLoader) {
+        this.delegate = new TesseraViewResolver(TemplateRegistry.load(classLoader), SpringRenderContexts::create);
+    }
+
+    @Override
+    public View resolveViewName(String viewName, Locale locale) throws Exception {
+        if (viewName.startsWith(UrlBasedViewResolver.REDIRECT_URL_PREFIX)) {
+            String redirectUrl = viewName.substring(UrlBasedViewResolver.REDIRECT_URL_PREFIX.length());
+            return new RedirectView(redirectUrl, true, true);
+        }
+        if (viewName.startsWith(UrlBasedViewResolver.FORWARD_URL_PREFIX)) {
+            return new InternalResourceView(viewName.substring(UrlBasedViewResolver.FORWARD_URL_PREFIX.length()));
+        }
+        View template = this.delegate.resolveViewName(viewName, locale);
+        return template != null ? new RequestUriView(template) : new NotFoundView();
+    }
+
+    private record RequestUriView(View template) implements View {
+
+        @Override
+        public String getContentType() {
+            return this.template.getContentType();
+        }
+
+        @Override
+        public void render(Map<String, ?> model, HttpServletRequest request, HttpServletResponse response) throws Exception {
+            Map<String, Object> templateModel = model != null ? new HashMap<>(model) : new HashMap<>();
+            templateModel.put(REQUEST_URI_ATTRIBUTE, requestUri(request, response));
+            this.template.render(templateModel, request, response);
+        }
+
+        private static String requestUri(HttpServletRequest request, HttpServletResponse response) {
+            String uri = response.encodeURL(URL_PATH_HELPER.getOriginatingRequestUri(request));
+            String query = URL_PATH_HELPER.getOriginatingQueryString(request);
+            return StringUtils.hasText(query) ? uri + "?" + query : uri;
+        }
+    }
+
+    private record NotFoundView() implements View {
+
+        @Override
+        public String getContentType() {
+            return TesseraView.CONTENT_TYPE;
+        }
+
+        @Override
+        public void render(Map<String, ?> model, HttpServletRequest request, HttpServletResponse response) throws Exception {
+            response.sendError(HttpServletResponse.SC_NOT_FOUND);
+        }
+    }
+
+}
