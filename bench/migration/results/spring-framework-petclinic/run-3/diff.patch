diff --git a/src/test/java/org/springframework/samples/petclinic/web/TemplateRenderingTests.java b/src/test/java/org/springframework/samples/petclinic/web/TemplateRenderingTests.java
new file mode 100644
index 0000000..97164f2
--- /dev/null
+++ b/src/test/java/org/springframework/samples/petclinic/web/TemplateRenderingTests.java
@@ -0,0 +1,147 @@
+package org.springframework.samples.petclinic.web;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.redirectedUrl;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import java.time.LocalDate;
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.model.Pet;
+import org.springframework.samples.petclinic.model.PetType;
+import org.springframework.samples.petclinic.model.Vet;
+import org.springframework.samples.petclinic.service.ClinicService;
+import org.springframework.test.context.junit.jupiter.web.SpringJUnitWebConfig;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.context.WebApplicationContext;
+
+/**
+ * Renders the Tessera templates through the application's MVC configuration (view resolvers,
+ * message source, exception resolver).
+ */
+@SpringJUnitWebConfig(locations = {"classpath:spring/mvc-core-config.xml", "classpath:spring/mvc-test-config.xml"})
+class TemplateRenderingTests {
+
+    @Autowired
+    private WebApplicationContext context;
+
+    @Autowired
+    private ClinicService clinicService;
+
+    private MockMvc mockMvc;
+
+    @BeforeEach
+    void setup() {
+        this.mockMvc = MockMvcBuilders.webAppContextSetup(this.context).build();
+
+        Owner owner = new Owner();
+        owner.setId(1);
+        owner.setFirstName("<script>alert('x')</script>");
+        owner.setLastName("Franklin");
+        owner.setAddress("110 W. Liberty St.");
+        owner.setCity("Madison");
+        owner.setTelephone("6085551023");
+        PetType cat = new PetType();
+        cat.setId(1);
+        cat.setName("cat");
+        Pet pet = new Pet();
+        pet.setId(2);
+        pet.setName("Leo");
+        pet.setType(cat);
+        pet.setBirthDate(LocalDate.of(2010, 9, 7));
+        owner.addPet(pet);
+        given(this.clinicService.findOwnerById(1)).willReturn(owner);
+        given(this.clinicService.findPetTypes()).willReturn(List.of(cat));
+        Vet vet = new Vet();
+        vet.setFirstName("James");
+        vet.setLastName("Carter");
+        given(this.clinicService.findVets()).willReturn(List.of(vet));
+    }
+
+    @Test
+    void welcomePageUsesMessagesAndLayout() throws Exception {
+        mockMvc.perform(get("/"))
+            .andExpect(status().isOk())
+            .andExpect(content().contentType("text/html;charset=UTF-8"))
+            .andExpect(content().string(containsString("<h2>Welcome</h2>")))
+            .andExpect(content().string(containsString("<li class=\"nav-item\">")))
+            .andExpect(content().string(containsString("/resources/images/pets.png")));
+    }
+
+    @Test
+    void ownerDetailsEscapesUserData() throws Exception {
+        mockMvc.perform(get("/owners/1"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(not(containsString("<script>alert"))))
+            .andExpect(content().string(containsString("&lt;script&gt;")))
+            .andExpect(content().string(containsString("href=\"1/edit\"")))
+            .andExpect(content().string(containsString("href=\"/owners/1/pets/2/edit\"")))
+            .andExpect(content().string(containsString("<dd>2010-09-07</dd>")));
+    }
+
+    @Test
+    void ownerFormWithValidationErrors() throws Exception {
+        mockMvc.perform(post("/owners/1/edit")
+                .param("firstName", "Joe")
+                .param("lastName", "Bloggs")
+                .param("city", "London"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("action=\"/owners/1/edit\"")))
+            .andExpect(content().string(containsString("class=\"form-group has-error\"")))
+            .andExpect(content().string(containsString("value=\"Joe\"")))
+            .andExpect(content().string(containsString("<span class=\"help-inline\">must not be empty</span>")));
+    }
+
+    @Test
+    void petFormSelectsBoundType() throws Exception {
+        mockMvc.perform(get("/owners/1/pets/new"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("<option value=\"cat\">cat</option>")))
+            .andExpect(content().string(containsString("flatpickr(\"#birthDate\", {});")));
+    }
+
+    @Test
+    void vetList() throws Exception {
+        mockMvc.perform(get("/vets"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("none")))
+            .andExpect(content().string(containsString("href=\"/vets.json\"")));
+    }
+
+    @Test
+    void exceptionPageShowsMessage() throws Exception {
+        mockMvc.perform(get("/oups"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("<h2>Something happened...</h2>")))
+            .andExpect(content().string(containsString("Expected: controller used to showcase")));
+    }
+
+    @Test
+    void redirectAfterSuccessfulPost() throws Exception {
+        mockMvc.perform(post("/owners/1/edit")
+                .param("firstName", "Joe")
+                .param("lastName", "Bloggs")
+                .param("address", "123 Caramel Street")
+                .param("city", "London")
+                .param("telephone", "01616291589"))
+            .andExpect(status().is3xxRedirection())
+            .andExpect(redirectedUrl("/owners/1"));
+    }
+
+    @Test
+    void viewWithoutTemplateIsNotFound() throws Exception {
+        given(this.clinicService.findPetById(2)).willReturn(new Pet());
+        mockMvc.perform(get("/owners/1/pets/2/visits"))
+            .andExpect(status().isNotFound());
+    }
+}
