+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.web;
+
+import jakarta.servlet.http.HttpServletRequest;
+
+import org.springframework.web.servlet.ModelAndView;
+import org.springframework.web.servlet.handler.SimpleMappingExceptionResolver;
+
+/**
+ * {@link SimpleMappingExceptionResolver} that also exposes the exception message as the
+ * {@value #MESSAGE_ATTRIBUTE} model attribute: the error template cannot read the exception itself.
+ */
+public class ExceptionMessageResolver extends SimpleMappingExceptionResolver {
+
+    public static final String MESSAGE_ATTRIBUTE = "message";
+
+    @Override
+    protected ModelAndView getModelAndView(String viewName, Exception ex, HttpServletRequest request) {
+        ModelAndView mv = super.getModelAndView(viewName, ex, request);
+        mv.addObject(MESSAGE_ATTRIBUTE, ex.getMessage());
+        return mv;
+    }
+
+}
