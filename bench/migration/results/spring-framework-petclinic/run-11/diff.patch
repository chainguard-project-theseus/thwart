+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.web;
+
+import java.util.Locale;
+import java.util.Map;
+
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.springframework.core.Ordered;
+import org.springframework.web.servlet.View;
+import org.springframework.web.servlet.ViewResolver;
+
+/**
+ * Last view resolver in the chain: a view name that no template provides is answered with 404 Not Found, as the
+ * former JSP view resolver did when the JSP file was missing.
+ */
+public class MissingViewResolver implements ViewResolver, Ordered {
+
+    private static final View NOT_FOUND = new View() {
+        @Override
+        public void render(Map<String, ?> model, HttpServletRequest request, HttpServletResponse response)
+            throws Exception {
+            response.sendError(HttpServletResponse.SC_NOT_FOUND);
+        }
+    };
+
+    @Override
+    public View resolveViewName(String viewName, Locale locale) {
+        return NOT_FOUND;
+    }
+
+    @Override
+    public int getOrder() {
+        return Ordered.LOWEST_PRECEDENCE;
+    }
+
+}
