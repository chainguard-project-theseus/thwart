diff --git a/src/main/resources/templates/pets/createOrUpdatePetForm.html b/src/main/resources/templates/pets/createOrUpdatePetForm.html
new file mode 100644
index 0000000..d4004e0
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdatePetForm.html
@@ -0,0 +1,39 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.*"
+      t:params="Pet pet, Collection<PetType> types, String ownerId, String petId"
+      t:replace="~{fragments/layout :: layout(~{::body}, 'owners', ~{::custom-script})}">
+<custom-script t:remove="tag">
+    <link rel="stylesheet" t:href="@{/webjars/flatpickr/4.6.13/dist/flatpickr.min.css}">
+    <script t:src="@{/webjars/flatpickr/4.6.13/dist/flatpickr.js}"></script>
+    <script>
+        flatpickr("#birthDate", {});
+    </script>
+</custom-script>
+<body t:remove="tag">
+    <h2>
+        <t:block t:if="pet.isNew()">New </t:block> Pet
+    </h2>
+    <!--/* posts back to the URL of the page, as <form:form> without an action did */-->
+    <form t:object="pet" id="pet" class="form-horizontal" method="post"
+          t:action="petId == null ? @{/owners/{ownerId}/pets/new(ownerId=ownerId)} : @{/owners/{ownerId}/pets/{petId}/edit(ownerId=ownerId, petId=petId)}">
+        <input type="hidden" name="id" t:value="pet.id == null ? '' : '' + pet.id"/>
+        <div class="form-group has-feedback">
+            <div class="form-group">
+                <label class="col-sm-2 control-label">Owner</label>
+                <div class="col-sm-10" t:text="(pet.owner?.firstName ?: '') + ' ' + (pet.owner?.lastName ?: '')">George Franklin</div>
+            </div>
+            <div t:replace="~{fragments/fields :: inputField('Name', 'name')}"></div>
+            <div t:replace="~{fragments/fields :: inputField('Birth Date', 'birthDate')}"></div>
+            <div class="control-group">
+                <div t:replace="~{fragments/fields :: selectField('Type ', 'type', types)}"></div>
+            </div>
+        </div>
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <button t:if="pet.isNew()" class="btn btn-primary" type="submit">Add Pet</button>
+                <button t:unless="pet.isNew()" class="btn btn-primary" type="submit">Update Pet</button>
+            </div>
+        </div>
+    </form>
+</body>
+</html>
diff --git a/src/main/resources/templates/pets/createOrUpdateVisitForm.html b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
new file mode 100644
index 0000000..c114247
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
@@ -0,0 +1,67 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.*"
+      t:params="Visit visit, String ownerId, String petId"
+      t:replace="~{fragments/layout :: layout(~{::body}, 'owners', ~{::custom-script})}">
+<custom-script t:remove="tag">
+    <link rel="stylesheet" t:href="@{/webjars/flatpickr/4.6.13/dist/flatpickr.min.css}">
+    <script t:src="@{/webjars/flatpickr/4.6.13/dist/flatpickr.js}"></script>
+    <script>
+        flatpickr("#date", {});
+    </script>
+</custom-script>
+<body t:remove="tag">
+    <h2><t:block t:if="visit.isNew()">New </t:block>Visit</h2>
+
+    <span id="pet"><strong>Pet</strong></span>
+    <table class="table table-striped" aria-describedby="pet">
+        <thead>
+        <tr>
+            <th scope="col">Name</th>
+            <th scope="col">Birth Date</th>
+            <th scope="col">Type</th>
+            <th scope="col">Owner</th>
+        </tr>
+        </thead>
+        <tbody>
+        <tr>
+            <td t:text="visit.pet.name">Leo</td>
+            <td t:text="temporals.format(visit.pet.birthDate, 'yyyy/MM/dd')">2010/09/07</td>
+            <td t:text="visit.pet.type?.name">cat</td>
+            <td t:text="(visit.pet.owner?.firstName ?: '') + ' ' + (visit.pet.owner?.lastName ?: '')">George Franklin</td>
+        </tr>
+        </tbody>
+    </table>
+
+    <!--/* posts back to the URL of the page, as <form:form> without an action did; the page is also mapped
+         as /owners/*/pets/{petId}/visits/new, where the owner comes from the pet */-->
+    <form t:object="visit" id="visit" class="form-horizontal" method="post"
+          t:action="ownerId != null ? @{/owners/{ownerId}/pets/{petId}/visits/new(ownerId=ownerId, petId=petId)} : @{/owners/{ownerId}/pets/{petId}/visits/new(ownerId=visit.pet.owner.id, petId=petId)}">
+        <div class="form-group has-feedback">
+            <div t:replace="~{fragments/fields :: inputField('Date', 'date')}"></div>
+            <div t:replace="~{fragments/fields :: inputField('Description', 'description')}"></div>
+        </div>
+
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <input type="hidden" name="petId" t:value="visit.pet.id == null ? '' : '' + visit.pet.id"/>
+                <button class="btn btn-primary" type="submit">Add Visit</button>
+            </div>
+        </div>
+    </form>
+
+    <br/>
+    <strong id="previousVisits">Previous Visits</strong>
+    <table class="table table-striped" aria-describedby="previousVisits">
+        <tbody>
+        <tr>
+            <th scope="col">Date</th>
+            <th scope="col">Description</th>
+        </tr>
+        <tr t:each="previous : visit.pet.visits" t:if="!previous.isNew()">
+            <td t:text="temporals.format(previous.date, 'yyyy/MM/dd')">2013/01/01</td>
+            <td t:text="previous.description">rabies shot</td>
+        </tr>
+        </tbody>
+    </table>
+</body>
+</html>
