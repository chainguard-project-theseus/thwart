+<div xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.PetType">
+
+    <!--/* Text input bound to a property of the enclosing form object (was WEB-INF/tags/inputField.tag).
+         The label appears in red if the input is considered invalid after submission. */-->
+    <div t:fragment="inputField(String label, Field name)"
+         t:class="fields.hasErrors(name) ? 'form-group has-error' : 'form-group '">
+        <label class="col-sm-2 control-label" t:text="label">Label</label>
+
+        <div class="col-sm-10">
+            <input class="form-control" type="text" t:field="name"/>
+            <span t:if="!fields.hasErrors(name) and !fields.value(name).isEmpty()"
+                  class="fa fa-ok form-control-feedback" aria-hidden="true"></span>
+            <t:block t:if="fields.hasErrors(name)">
+                <span class="fa fa-remove form-control-feedback" aria-hidden="true"></span>
+                <span class="help-inline" t:text="fields.errors(name).first">error</span>
+            </t:block>
+        </div>
+    </div>
+
+    <!--/* Select bound to a property of the enclosing form object (was WEB-INF/tags/selectField.tag). */-->
+    <div t:fragment="selectField(String label, Field name, Collection<PetType> names, int size)"
+         t:class="fields.hasErrors(name) ? 'form-group error' : 'form-group '">
+        <label class="col-sm-2 control-label" t:text="label">Label</label>
+
+        <div class="col-sm-10">
+            <select class="form-control" t:field="name" t:size="size">
+                <option t:each="n : names" t:value="n.name" t:text="n.name">name</option>
+            </select>
+            <span t:if="!fields.hasErrors(name) and !fields.value(name).isEmpty()"
+                  class="fa fa-ok form-control-feedback" aria-hidden="true"></span>
+            <t:block t:if="fields.hasErrors(name)">
+                <span class="fa fa-remove form-control-feedback" aria-hidden="true"></span>
+                <span class="help-inline" t:text="fields.errors(name).first">error</span>
+            </t:block>
+        </div>
+    </div>
+
+</div>
