@@ -0,0 +1,62 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.*"
+      t:params="Pet pet, Collection<PetType> types, Integer ownerId, Integer petId"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::page-script})}">
+<page-script t:remove="tag">
+    <link rel="stylesheet" href="/webjars/flatpickr/4.6.13/dist/flatpickr.min.css">
+    <script src="/webjars/flatpickr/4.6.13/dist/flatpickr.js"></script>
+    <script>
+        flatpickr("#birthDate", {});
+    </script>
+</page-script>
+<body t:remove="tag">
+    <h2>
+        <t:block t:if="pet.isNew()">New </t:block> Pet
+    </h2>
+    <!--/* The form posts back to the URL it was requested from: .../pets/new or .../pets/{petId}/edit */-->
+    <form t:object="pet" id="pet" class="form-horizontal" method="post"
+          t:if="petId == null" t:action="@{/owners/{ownerId}/pets/new(ownerId=ownerId)}">
+        <input type="hidden" name="id" t:value="pet.id == null ? '' : '' + pet.id"/>
+        <div class="form-group has-feedback">
+            <div class="form-group">
+                <label class="col-sm-2 control-label">Owner</label>
+                <div class="col-sm-10"
+                     t:text="pet.owner == null ? ' ' : pet.owner.firstName + ' ' + pet.owner.lastName">George Franklin</div>
+            </div>
+            <div t:replace="~{fragments/fields :: inputField('Name', 'name')}"></div>
+            <div t:replace="~{fragments/fields :: inputField('Birth Date', 'birthDate')}"></div>
+            <div class="control-group">
+                <div t:replace="~{fragments/fields :: selectField('Type ', 'type', types, 5)}"></div>
+            </div>
+        </div>
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <button t:if="pet.isNew()" class="btn btn-primary" type="submit">Add Pet</button>
+                <button t:unless="pet.isNew()" class="btn btn-primary" type="submit">Update Pet</button>
+            </div>
+        </div>
+    </form>
+    <form t:object="pet" id="pet" class="form-horizontal" method="post"
+          t:unless="petId == null" t:action="@{/owners/{ownerId}/pets/{petId}/edit(ownerId=ownerId,petId=petId)}">
+        <input type="hidden" name="id" t:value="pet.id == null ? '' : '' + pet.id"/>
+        <div class="form-group has-feedback">
+            <div class="form-group">
+                <label class="col-sm-2 control-label">Owner</label>
+                <div class="col-sm-10"
+                     t:text="pet.owner == null ? ' ' : pet.owner.firstName + ' ' + pet.owner.lastName">George Franklin</div>
+            </div>
+            <div t:replace="~{fragments/fields :: inputField('Name', 'name')}"></div>
+            <div t:replace="~{fragments/fields :: inputField('Birth Date', 'birthDate')}"></div>
+            <div class="control-group">
+                <div t:replace="~{fragments/fields :: selectField('Type ', 'type', types, 5)}"></div>
+            </div>
+        </div>
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <button t:if="pet.isNew()" class="btn btn-primary" type="submit">Add Pet</button>
+                <button t:unless="pet.isNew()" class="btn btn-primary" type="submit">Update Pet</button>
+            </div>
+        </div>
+    </form>
+</body>
+</html>
diff --git a/src/main/resources/templates/pets/createOrUpdateVisitForm.html b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
