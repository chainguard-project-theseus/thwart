+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.web;
+
+import org.assertj.core.util.Lists;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.model.Pet;
+import org.springframework.samples.petclinic.model.PetType;
+import org.springframework.samples.petclinic.model.Vet;
+import org.springframework.samples.petclinic.service.ClinicService;
+import org.springframework.test.context.junit.jupiter.web.SpringJUnitWebConfig;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.context.WebApplicationContext;
+
+import java.time.LocalDate;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+/**
+ * Renders pages through the application's view resolvers (Tessera templates), unlike the
+ * controller tests, which use a standalone MockMvc setup.
+ */
+@SpringJUnitWebConfig(locations = {"classpath:spring/mvc-core-config.xml", "classpath:spring/mvc-test-config.xml"})
+class TemplateRenderingTests {
+
+    private static final int TEST_OWNER_ID = 1;
+
+    @Autowired
+    private WebApplicationContext webApplicationContext;
+
+    @Autowired
+    private ClinicService clinicService;
+
+    private MockMvc mockMvc;
+
+    @BeforeEach
+    void setup() {
+        this.mockMvc = MockMvcBuilders.webAppContextSetup(webApplicationContext).build();
+
+        Owner owner = new Owner();
+        owner.setId(TEST_OWNER_ID);
+        owner.setFirstName("<script>alert('x')</script>");
+        owner.setLastName("Franklin");
+        owner.setAddress("110 W. Liberty St.");
+        owner.setCity("Madison");
+        owner.setTelephone("6085551023");
+        PetType cat = new PetType();
+        cat.setId(1);
+        cat.setName("cat");
+        Pet pet = new Pet();
+        pet.setId(1);
+        pet.setName("Leo");
+        pet.setType(cat);
+        pet.setBirthDate(LocalDate.of(2010, 9, 7));
+        owner.addPet(pet);
+        given(this.clinicService.findOwnerById(TEST_OWNER_ID)).willReturn(owner);
+        given(this.clinicService.findPetById(1)).willReturn(pet);
+        given(this.clinicService.findPetTypes()).willReturn(Lists.newArrayList(cat));
+        given(this.clinicService.findVets()).willReturn(Lists.newArrayList(new Vet()));
+    }
+
+    @Test
+    void testWelcomePage() throws Exception {
+        mockMvc.perform(get("/"))
+            .andExpect(status().isOk())
+            .andExpect(content().contentTypeCompatibleWith("text/html"))
+            .andExpect(content().string(containsString("<h2>Welcome</h2>")))
+            .andExpect(content().string(containsString("<li class=\"nav-item\">")));
+    }
+
+    @Test
+    void testOwnerDetailsEscapesUserData() throws Exception {
+        mockMvc.perform(get("/owners/{ownerId}", TEST_OWNER_ID))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("&lt;script&gt;alert(&#39;x&#39;)&lt;/script&gt; Franklin")))
+            .andExpect(content().string(not(containsString("<script>alert"))))
+            .andExpect(content().string(containsString("<dd>2010-09-07</dd>")))
+            .andExpect(content().string(containsString("href=\"/owners/1/pets/1/edit\"")));
+    }
+
+    @Test
+    void testOwnerFormWithValidationErrors() throws Exception {
+        mockMvc.perform(post("/owners/new")
+            .param("firstName", "Joe")
+            .param("lastName", "Bloggs")
+            .param("city", "London")
+        )
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("action=\"/owners/new\"")))
+            .andExpect(content().string(containsString("value=\"Joe\"")))
+            .andExpect(content().string(containsString("<div class=\"form-group has-error\">")))
+            .andExpect(content().string(containsString("<span class=\"help-inline\">must not be empty</span>")));
+    }
+
+    @Test
+    void testPetFormSelectsBoundType() throws Exception {
+        mockMvc.perform(get("/owners/{ownerId}/pets/{petId}/edit", TEST_OWNER_ID, 1))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("<input type=\"hidden\" name=\"id\" value=\"1\"/>")))
+            .andExpect(content().string(containsString("value=\"2010/09/07\"")))
+            .andExpect(content().string(containsString("<option value=\"cat\" selected=\"selected\">cat</option>")));
+    }
+
+    @Test
+    void testVetList() throws Exception {
+        mockMvc.perform(get("/vets"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("none")));
+    }
+
+    @Test
+    void testErrorPage() throws Exception {
+        mockMvc.perform(get("/oups"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("<h2>Something happened...</h2>")))
+            .andExpect(content().string(containsString("Expected: controller used to showcase what happens when an exception is thrown")));
+    }
+
+    @Test
+    void testRedirect() throws Exception {
+        mockMvc.perform(post("/owners/{ownerId}/edit", TEST_OWNER_ID)
+            .param("firstName", "Joe")
+            .param("lastName", "Bloggs")
+            .param("address", "123 Caramel Street")
+            .param("city", "London")
+            .param("telephone", "01616291589")
+        )
+            .andExpect(status().is3xxRedirection())
+            .andExpect(redirectedUrl("/owners/1"));
+    }
+
+}
