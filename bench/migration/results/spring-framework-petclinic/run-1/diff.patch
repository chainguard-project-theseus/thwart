+package org.springframework.samples.petclinic.web;
+
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import org.springframework.util.StringUtils;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+import org.springframework.web.util.UrlPathHelper;
+
+/**
+ * Exposes the URL a form posts back to as the {@code formAction} model attribute, as Spring's
+ * {@code <form:form>} tag did for forms without an explicit action: the current request URI and
+ * query string.
+ */
+@ControllerAdvice(assignableTypes = {OwnerController.class, PetController.class, VisitController.class})
+public class FormActionAdvice {
+
+    private static final UrlPathHelper URL_PATH_HELPER = new UrlPathHelper();
+
+    @ModelAttribute("formAction")
+    public String formAction(HttpServletRequest request, HttpServletResponse response) {
+        String action = response.encodeURL(URL_PATH_HELPER.getOriginatingRequestUri(request));
+        String queryString = request.getQueryString();
+        if (StringUtils.hasText(queryString)) {
+            action += "?" + queryString;
+        }
+        return action;
+    }
+
+}
