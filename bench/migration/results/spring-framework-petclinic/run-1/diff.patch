+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.web;
+
+import dev.tessera.runtime.TemplateRegistry;
+import dev.tessera.spring.context.SpringRenderContexts;
+import dev.tessera.spring.view.RenderContextFactory;
+import org.springframework.context.ApplicationContext;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+
+/**
+ * Tessera view infrastructure. PetClinic does not use Spring Boot, so the beans that
+ * Tessera's Spring Boot auto-configuration would declare are declared here. The view resolver
+ * is registered in mvc-view-config.xml, behind the content negotiating view resolver.
+ */
+@Configuration(proxyBeanMethods = false)
+public class TesseraViewConfig {
+
+    @Bean
+    public TemplateRegistry tesseraTemplateRegistry(ApplicationContext applicationContext) {
+        return TemplateRegistry.load(applicationContext.getClassLoader());
+    }
+
+    @Bean
+    public RenderContextFactory tesseraRenderContextFactory() {
+        return SpringRenderContexts::create;
+    }
+
+}
