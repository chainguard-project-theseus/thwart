+package org.springframework.samples.petclinic.web;
+
+import java.util.Map;
+
+import dev.tessera.runtime.RenderContext;
+import dev.tessera.spring.context.SpringRenderContexts;
+import dev.tessera.spring.view.RenderContextFactory;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+
+/**
+ * Builds the {@link RenderContext} of Tessera templates from Spring MVC: messages from the
+ * {@code MessageSource}, links with the context path, and form values and errors from the {@code BindingResult}.
+ * <p/>
+ * Declared in {@code mvc-view-config.xml}, which also registers the {@code TesseraViewResolver}.
+ */
+public class TesseraRenderContextFactory implements RenderContextFactory {
+
+    @Override
+    public RenderContext create(HttpServletRequest request, HttpServletResponse response, Map<String, ?> model) {
+        return SpringRenderContexts.create(request, response, model);
+    }
+
+}
