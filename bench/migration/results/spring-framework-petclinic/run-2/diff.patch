+<div xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.PetType">
+
+    <!-- Text input bound to a property of the form object. 'hasValue' tells whether the property is not empty:
+         the input is marked as valid when it has a value and no error. -->
+    <div t:fragment="inputField(String label, Field name, boolean hasValue)"
+         t:class="fields.hasErrors(name) ? 'form-group has-error' : 'form-group '">
+        <label class="col-sm-2 control-label" t:text="label">Label</label>
+
+        <div class="col-sm-10">
+            <input class="form-control" type="text" t:field="name"/>
+            <span t:if="hasValue and !fields.hasErrors(name)" class="fa fa-ok form-control-feedback" aria-hidden="true"></span>
+            <t:block t:if="fields.hasErrors(name)">
+                <span class="fa fa-remove form-control-feedback" aria-hidden="true"></span>
+                <span class="help-inline" t:text="fields.errors(name).first">Error</span>
+            </t:block>
+        </div>
+    </div>
+
+    <!-- Select box listing pet types, bound to a property of the form object. -->
+    <div t:fragment="selectField(String label, Field name, Collection<PetType> names, int size, boolean hasValue)"
+         t:class="fields.hasErrors(name) ? 'form-group error' : 'form-group '">
+        <label class="col-sm-2 control-label" t:text="label">Label</label>
+
+        <div class="col-sm-10">
