+/**
+ * Exposes the URL that HTML forms post back to as the {@code formAction} model attribute.
+ * <p/>
+ * Forms without an explicit action submit to the URL that rendered them (the current request URI and query string),
+ * the same default as Spring's {@code <form:form>} tag. Templates cannot read the request, so the value is computed here.
+ */
+@ControllerAdvice
+public class FormActionAdvice {
+
+    private static final UrlPathHelper URL_PATH_HELPER = new UrlPathHelper();
+
+    @ModelAttribute("formAction")
+    public String formAction(HttpServletRequest request, HttpServletResponse response) {
+        String encoding = request.getCharacterEncoding() != null ? request.getCharacterEncoding() : "ISO-8859-1";
+        String action = response.encodeURL(
+            UriUtils.encodePath(URL_PATH_HELPER.getOriginatingRequestUri(request), encoding));
+        String queryString = URL_PATH_HELPER.getOriginatingQueryString(request);
+        if (StringUtils.hasText(queryString)) {
+            action += "?" + queryString;
+        }
+        return action;
+    }
+
+}
