+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.*"
+      t:params="Pet pet, Collection<PetType> types, String formAction"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::customScript})}">
+<t:block t:fragment="customScript">
+    <link rel="stylesheet" href="/webjars/flatpickr/4.6.13/dist/flatpickr.min.css">
+    <script src="/webjars/flatpickr/4.6.13/dist/flatpickr.js"></script>
+    <script>
+        flatpickr("#birthDate", {});
+    </script>
+</t:block>
+<body t:remove="tag">
+    <h2>
+        <t:block t:if="pet.new">New </t:block> Pet
+    </h2>
+    <form t:object="pet" class="form-horizontal" id="pet" t:action="formAction" method="post">
+        <input type="hidden" name="id" t:value="text.orEmpty(pet.id)"/>
+        <div class="form-group has-feedback">
+            <div class="form-group">
+                <label class="col-sm-2 control-label">Owner</label>
+                <div class="col-sm-10">
+                    [[${pet.owner?.firstName}]] [[${pet.owner?.lastName}]]
+                </div>
+            </div>
+            <div t:replace="~{fragments/fields :: inputField('Name', 'name', !strings.isEmpty(pet.name))}"></div>
+            <div t:replace="~{fragments/fields :: inputField('Birth Date', 'birthDate', pet.birthDate != null)}"></div>
+            <div class="control-group">
+                <div t:replace="~{fragments/fields :: selectField('Type ', 'type', types, 5, pet.type != null)}"></div>
+            </div>
+        </div>
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <button t:if="pet.new" class="btn btn-primary" type="submit">Add Pet</button>
+                <button t:unless="pet.new" class="btn btn-primary" type="submit">Update Pet</button>
+            </div>
+        </div>
+    </form>
+</body>
+</html>
diff --git a/src/main/resources/templates/pets/createOrUpdateVisitForm.html b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
new file mode 100644
index 0000000..5216c97
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
@@ -0,0 +1,62 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.Visit"
+      t:params="Visit visit, String formAction"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::customScript})}">
+<t:block t:fragment="customScript">
+    <link rel="stylesheet" href="/webjars/flatpickr/4.6.13/dist/flatpickr.min.css">
+    <script src="/webjars/flatpickr/4.6.13/dist/flatpickr.js"></script>
+    <script>
+        flatpickr("#date", {});
+    </script>
+</t:block>
+<body t:remove="tag">
+    <h2><t:block t:if="visit.new">New </t:block>Visit</h2>
+
+    <span id="pet"><strong>Pet</strong></span>
+    <table class="table table-striped" aria-describedby="pet">
+        <thead>
+        <tr>
+            <th scope="col">Name</th>
+            <th scope="col">Birth Date</th>
+            <th scope="col">Type</th>
+            <th scope="col">Owner</th>
+        </tr>
+        </thead>
+        <tr>
+            <td t:text="visit.pet.name">Leo</td>
+            <td t:text="temporals.format(visit.pet.birthDate, 'yyyy/MM/dd')">2010/09/07</td>
+            <td t:text="visit.pet.type?.name">cat</td>
+            <td>[[${visit.pet.owner?.firstName}]] [[${visit.pet.owner?.lastName}]]</td>
+        </tr>
+    </table>
+
+    <form t:object="visit" class="form-horizontal" id="visit" t:action="formAction" method="post">
+        <div class="form-group has-feedback">
+            <div t:replace="~{fragments/fields :: inputField('Date', 'date', visit.date != null)}"></div>
+            <div t:replace="~{fragments/fields :: inputField('Description', 'description', !strings.isEmpty(visit.description))}"></div>
+        </div>
+
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <input type="hidden" name="petId" t:value="text.orEmpty(visit.pet.id)"/>
+                <button class="btn btn-primary" type="submit">Add Visit</button>
+            </div>
+        </div>
+    </form>
+
+    <br/>
+    <strong id="previousVisits">Previous Visits</strong>
+    <table class="table table-striped" aria-describedby="previousVisits">
+        <tr>
+            <th scope="col">Date</th>
+            <th scope="col">Description</th>
+        </tr>
+        <t:block t:each="previousVisit : visit.pet.visits">
+            <tr t:unless="previousVisit.new">
+                <td t:text="temporals.format(previousVisit.date, 'yyyy/MM/dd')">2013/01/01</td>
+                <td t:text="previousVisit.description">rabies shot</td>
+            </tr>
+        </t:block>
+    </table>
+</body>
+</html>
diff --git a/src/main/resources/templates/vets/vetList.html b/src/main/resources/templates/vets/vetList.html
new file mode 100644
index 0000000..f9f9bf3
--- /dev/null
+++ b/src/main/resources/templates/vets/vetList.html
@@ -0,0 +1,34 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.Vets"
+      t:params="Vets vets"
+      t:replace="~{fragments/layout :: layout('vets', ~{::body}, null)}">
+<body t:remove="tag">
+    <h2 id="veterinarians">Veterinarians</h2>
+
+    <div class="row">
+        <table id="vetsTable" class="table table-striped" aria-describedby="veterinarians">
+            <thead>
+            <tr>
+                <th scope="col">Name</th>
+                <th scope="col">Specialties</th>
+            </tr>
+            </thead>
+            <tbody>
+            <tr t:each="vet : vets.vetList">
+                <td>[[${vet.firstName}]] [[${vet.lastName}]]</td>
+                <td><t:block t:each="specialty : vet.specialties">[[${specialty.name}]] </t:block><t:block t:if="vet.nrOfSpecialties == 0">none</t:block></td>
+            </tr>
+            </tbody>
+        </table>
+    </div>
+
+    <div class="row">
+        <div class="col-md-2">
+            <a t:href="@{/vets.xml}">View as XML</a>
+        </div>
+        <div class="col-md-2">
+            <a t:href="@{/vets.json}">View as JSON</a>
+        </div>
+    </div>
+</body>
+</html>
