diff --git a/src/test/java/org/springframework/samples/petclinic/web/PageRenderingTests.java b/src/test/java/org/springframework/samples/petclinic/web/PageRenderingTests.java
new file mode 100644
index 0000000..311b094
--- /dev/null
+++ b/src/test/java/org/springframework/samples/petclinic/web/PageRenderingTests.java
@@ -0,0 +1,157 @@
+package org.springframework.samples.petclinic.web;
+
+import java.time.LocalDate;
+
+import org.assertj.core.util.Lists;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.model.Pet;
+import org.springframework.samples.petclinic.model.PetType;
+import org.springframework.samples.petclinic.model.Specialty;
+import org.springframework.samples.petclinic.model.Vet;
+import org.springframework.samples.petclinic.service.ClinicService;
+import org.springframework.test.context.junit.jupiter.web.SpringJUnitWebConfig;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.context.WebApplicationContext;
+
+import static org.hamcrest.Matchers.allOf;
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Renders the HTML pages through the application's web configuration (Tessera view resolver, form action advice,
+ * exception resolver), with a mocked {@link ClinicService}.
+ */
+@SpringJUnitWebConfig(locations = {"classpath:spring/mvc-core-config.xml", "classpath:spring/mvc-test-config.xml"})
+class PageRenderingTests {
+
+    @Autowired
+    private WebApplicationContext webApplicationContext;
+
+    @Autowired
+    private ClinicService clinicService;
+
+    private MockMvc mockMvc;
+
+    @BeforeEach
+    void setup() {
+        this.mockMvc = MockMvcBuilders.webAppContextSetup(webApplicationContext).build();
+
+        Owner owner = new Owner();
+        owner.setId(1);
+        owner.setFirstName("<script>alert('x')</script>");
+        owner.setLastName("Franklin & Sons");
+        owner.setAddress("110 W. Liberty St.");
+        owner.setCity("Madison");
+        owner.setTelephone("6085551023");
+        PetType cat = new PetType();
+        cat.setId(1);
+        cat.setName("cat");
+        Pet pet = new Pet();
+        pet.setId(2);
+        pet.setName("Leo");
+        pet.setBirthDate(LocalDate.of(2010, 9, 7));
+        pet.setType(cat);
+        owner.addPet(pet);
+        given(this.clinicService.findOwnerById(1)).willReturn(owner);
+        given(this.clinicService.findPetById(2)).willReturn(pet);
+        given(this.clinicService.findPetTypes()).willReturn(Lists.newArrayList(cat));
+
+        Vet helen = new Vet();
+        helen.setId(2);
+        helen.setFirstName("Helen");
+        helen.setLastName("Leary");
+        Specialty radiology = new Specialty();
+        radiology.setId(1);
+        radiology.setName("radiology");
+        helen.addSpecialty(radiology);
+        given(this.clinicService.findVets()).willReturn(Lists.newArrayList(helen));
+    }
+
+    @Test
+    void rendersWelcomePageWithMessageAndActiveMenu() throws Exception {
+        mockMvc.perform(get("/"))
+            .andExpect(status().isOk())
+            .andExpect(content().contentTypeCompatibleWith("text/html"))
+            .andExpect(content().string(allOf(
+                containsString("<h2>Welcome</h2>"),
+                containsString("<li class=\"nav-item\">"),
+                containsString("<title>PetClinic :: a Spring Framework demonstration</title>"))));
+    }
+
+    @Test
+    void escapesUserDataOnOwnerDetails() throws Exception {
+        mockMvc.perform(get("/owners/1"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(allOf(
+                not(containsString("<script>alert")),
+                containsString("&lt;script&gt;alert("),
+                containsString("Franklin &amp; Sons"),
+                containsString("<dd>2010-09-07</dd>"),
+                containsString("href=\"/owners/1/pets/2/edit\""))));
+    }
+
+    @Test
+    void rendersVetList() throws Exception {
+        mockMvc.perform(get("/vets"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(allOf(
+                containsString("Helen Leary"),
+                containsString("radiology"))));
+    }
+
+    @Test
+    void rendersOwnerFormWithValidationErrors() throws Exception {
+        mockMvc.perform(post("/owners/new")
+                .param("firstName", "Joe")
+                .param("lastName", "Bloggs")
+                .param("city", "London"))
+            .andExpect(status().isOk())
+            .andExpect(view().name("owners/createOrUpdateOwnerForm"))
+            .andExpect(content().string(allOf(
+                containsString("action=\"/owners/new\""),
+                containsString("<div class=\"form-group has-error\">"),
+                containsString("value=\"Joe\""),
+                containsString("<span class=\"help-inline\">must not be empty</span>"),
+                containsString("Add Owner"))));
+    }
+
+    @Test
+    void rendersPetFormWithSelectedType() throws Exception {
+        mockMvc.perform(get("/owners/1/pets/2/edit"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(allOf(
+                containsString("action=\"/owners/1/pets/2/edit\""),
+                containsString("value=\"2010/09/07\""),
+                containsString("selected"),
+                containsString("Update Pet"),
+                containsString("flatpickr(\"#birthDate\", {});"))));
+    }
+
+    @Test
+    void rendersFindFormWithGlobalErrors() throws Exception {
+        mockMvc.perform(get("/owners").param("lastName", "Unknown"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("<span id=\"owner.errors\">has not been found</span>")));
+    }
+
+    @Test
+    void rendersErrorPage() throws Exception {
+        mockMvc.perform(get("/oups"))
+            .andExpect(status().isOk())
+            .andExpect(view().name("exception"))
+            .andExpect(content().string(allOf(
+                containsString("<h2>Something happened...</h2>"),
+                containsString("Expected: controller used to showcase what happens when an exception is thrown"))));
+    }
+
+}
