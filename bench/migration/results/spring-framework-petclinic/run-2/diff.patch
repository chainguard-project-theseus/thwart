+package org.springframework.samples.petclinic.web;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Text functions for Tessera templates, called as {@code text.fn(...)}.
+ */
+@TemplateFunctions("text")
+public final class TextFunctions {
+
+    private TextFunctions() {
+    }
+
+    /**
+     * Returns the value as text, or an empty string for {@code null}.
+     * Unlike a {@code null} attribute value, which omits the attribute, this renders {@code value=""}.
+     */
+    @TemplateFunction
+    public static String orEmpty(Object value) {
+        return value == null ? "" : String.valueOf(value);
+    }
+
+}
