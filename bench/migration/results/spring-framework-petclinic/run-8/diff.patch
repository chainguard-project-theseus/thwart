+package org.springframework.samples.petclinic.web;
+
+import jakarta.servlet.http.HttpServletRequest;
+
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+import org.springframework.web.util.UrlPathHelper;
+
+/**
+ * Exposes the URL of the current request as the {@code formAction} model attribute, so that forms post back
+ * to the URL they were rendered from (as Spring's {@code form:form} tag did when no action was given).
+ */
+@ControllerAdvice
+public class FormActionAdvice {
+
+    private static final UrlPathHelper URL_PATH_HELPER = new UrlPathHelper();
+
+    @ModelAttribute("formAction")
+    public String formAction(HttpServletRequest request) {
+        String uri = URL_PATH_HELPER.getOriginatingRequestUri(request);
+        String query = URL_PATH_HELPER.getOriginatingQueryString(request);
+        return query == null ? uri : uri + "?" + query;
+    }
+
+}
