diff --git a/src/main/resources/templates/pets/createOrUpdatePetForm.html b/src/main/resources/templates/pets/createOrUpdatePetForm.html
new file mode 100644
index 0000000..61f6b80
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdatePetForm.html
@@ -0,0 +1,40 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.*"
+      t:params="Pet pet, Collection<PetType> types, String formAction"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::customScript})}">
+<head>
+    <t:block t:fragment="customScript">
+        <link rel="stylesheet" href="/webjars/flatpickr/4.6.13/dist/flatpickr.min.css">
+        <script src="/webjars/flatpickr/4.6.13/dist/flatpickr.js"></script>
+        <script>
+            flatpickr("#birthDate", {});
+        </script>
+    </t:block>
+</head>
+<body t:remove="tag">
+    <h2>
+        <t:block t:if="pet.isNew()">New </t:block> Pet
+    </h2>
+    <form t:object="pet" t:action="formAction" method="post" class="form-horizontal" id="pet">
+        <input type="hidden" name="id" t:value="pet.id == null ? '' : '' + pet.id"/>
+        <div class="form-group has-feedback">
+            <div class="form-group">
+                <label class="col-sm-2 control-label">Owner</label>
+                <div class="col-sm-10"
+                     t:text="pet.owner == null ? ' ' : pet.owner.firstName + ' ' + pet.owner.lastName">George Franklin</div>
+            </div>
+            <div t:replace="~{fragments/fields :: input('Name', 'name', !strings.isEmpty(pet.name))}"></div>
+            <div t:replace="~{fragments/fields :: input('Birth Date', 'birthDate', pet.birthDate != null)}"></div>
+            <div class="control-group">
+                <div t:replace="~{fragments/fields :: selectType('Type ', 'type', types, '5', pet.type != null)}"></div>
+            </div>
+        </div>
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <button t:if="pet.isNew()" class="btn btn-primary" type="submit">Add Pet</button>
+                <button t:unless="pet.isNew()" class="btn btn-primary" type="submit">Update Pet</button>
+            </div>
+        </div>
+    </form>
+</body>
+</html>
diff --git a/src/main/resources/templates/pets/createOrUpdateVisitForm.html b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
new file mode 100644
index 0000000..e8a6680
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
@@ -0,0 +1,62 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.*"
+      t:params="Visit visit, String formAction"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::customScript})}">
+<head>
+    <t:block t:fragment="customScript">
+        <link rel="stylesheet" href="/webjars/flatpickr/4.6.13/dist/flatpickr.min.css">
+        <script src="/webjars/flatpickr/4.6.13/dist/flatpickr.js"></script>
+        <script>
+            flatpickr("#date", {});
+        </script>
+    </t:block>
+</head>
+<body t:remove="tag">
+    <h2><t:block t:if="visit.isNew()">New </t:block>Visit</h2>
+
+    <span id="pet"><strong>Pet</strong></span>
+    <table class="table table-striped" aria-describedby="pet">
+        <thead>
+        <tr>
+            <th scope="col">Name</th>
+            <th scope="col">Birth Date</th>
+            <th scope="col">Type</th>
+            <th scope="col">Owner</th>
+        </tr>
+        </thead>
+        <tr>
+            <td t:text="visit.pet.name">Leo</td>
+            <td t:text="temporals.format(visit.pet.birthDate, 'yyyy/MM/dd')">2010/09/07</td>
+            <td t:text="visit.pet.type?.name">cat</td>
+            <td t:text="visit.pet.owner == null ? ' ' : visit.pet.owner.firstName + ' ' + visit.pet.owner.lastName">George Franklin</td>
+        </tr>
+    </table>
+
+    <form t:object="visit" t:action="formAction" method="post" class="form-horizontal" id="visit">
+        <div class="form-group has-feedback">
+            <div t:replace="~{fragments/fields :: input('Date', 'date', visit.date != null)}"></div>
+            <div t:replace="~{fragments/fields :: input('Description', 'description', !strings.isEmpty(visit.description))}"></div>
+        </div>
+
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <input type="hidden" name="petId" t:value="visit.pet.id == null ? '' : '' + visit.pet.id"/>
+                <button class="btn btn-primary" type="submit">Add Visit</button>
+            </div>
+        </div>
+    </form>
+
+    <br/>
+    <strong id="previousVisits">Previous Visits</strong>
+    <table class="table table-striped" aria-describedby="previousVisits">
+        <tr>
+            <th scope="col">Date</th>
+            <th scope="col">Description</th>
+        </tr>
+        <tr t:each="v : visit.pet.visits" t:if="!v.isNew()">
+            <td t:text="temporals.format(v.date, 'yyyy/MM/dd')">2013/01/01</td>
+            <td t:text="v.description">rabies shot</td>
+        </tr>
+    </table>
+</body>
+</html>
