diff --git a/src/main/resources/templates/fragments/fields.html b/src/main/resources/templates/fragments/fields.html
new file mode 100644
index 0000000..65dd5bb
--- /dev/null
+++ b/src/main/resources/templates/fragments/fields.html
@@ -0,0 +1,35 @@
+<div xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.PetType">
+
+    <!-- Text input bound to a form field. hasValue: the field's current value is not empty. -->
+    <div t:fragment="inputField(String label, Field name, boolean hasValue)"
+         t:class="fields.hasErrors(name) ? 'form-group has-error' : 'form-group'">
+        <label class="col-sm-2 control-label" t:text="label">Label</label>
+
+        <div class="col-sm-10">
+            <input class="form-control" type="text" t:field="name"/>
+            <span t:if="!fields.hasErrors(name) and hasValue" class="fa fa-ok form-control-feedback" aria-hidden="true"></span>
+            <t:block t:if="fields.hasErrors(name)">
+                <span class="fa fa-remove form-control-feedback" aria-hidden="true"></span>
+                <span class="help-inline" t:text="fields.errors(name).first">Error</span>
+            </t:block>
+        </div>
+    </div>
+
+    <!-- Select bound to a pet type field. hasValue: the field's current value is not empty. -->
+    <div t:fragment="petTypeSelectField(String label, Field name, boolean hasValue, Collection<PetType> names, String size)"
+         t:class="fields.hasErrors(name) ? 'form-group error' : 'form-group'">
+        <label class="col-sm-2 control-label" t:text="label">Label</label>
+
+        <div class="col-sm-10">
+            <select class="form-control" t:field="name" t:size="size">
+                <option t:each="item : names" t:value="item.name" t:text="item.name">cat</option>
+            </select>
+            <span t:if="!fields.hasErrors(name) and hasValue" class="fa fa-ok form-control-feedback" aria-hidden="true"></span>
+            <t:block t:if="fields.hasErrors(name)">
+                <span class="fa fa-remove form-control-feedback" aria-hidden="true"></span>
+                <span class="help-inline" t:text="fields.errors(name).first">Error</span>
+            </t:block>
+        </div>
+    </div>
+
+</div>
diff --git a/src/main/resources/templates/fragments/layout.html b/src/main/resources/templates/fragments/layout.html
