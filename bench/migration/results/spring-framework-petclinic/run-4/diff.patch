+package org.springframework.samples.petclinic.web;
+
+import jakarta.servlet.http.HttpServletRequest;
+
+import org.springframework.web.servlet.ModelAndView;
+import org.springframework.web.servlet.handler.SimpleMappingExceptionResolver;
+
+/**
+ * {@link SimpleMappingExceptionResolver} that also exposes the exception message as a plain
+ * {@code String} ("exceptionMessage"), since the exception itself is not readable by a template.
+ */
+public class ExceptionMessageResolver extends SimpleMappingExceptionResolver {
+
+    public static final String MESSAGE_ATTRIBUTE = "exceptionMessage";
+
+    @Override
+    protected ModelAndView getModelAndView(String viewName, Exception ex, HttpServletRequest request) {
+        ModelAndView mav = super.getModelAndView(viewName, ex, request);
+        mav.addObject(MESSAGE_ATTRIBUTE, ex.getMessage());
+        return mav;
+    }
+
+}
