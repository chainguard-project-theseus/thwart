diff --git a/src/test/java/org/springframework/samples/petclinic/web/ViewRenderingTests.java b/src/test/java/org/springframework/samples/petclinic/web/ViewRenderingTests.java
new file mode 100644
index 0000000..fc9f3ad
--- /dev/null
+++ b/src/test/java/org/springframework/samples/petclinic/web/ViewRenderingTests.java
@@ -0,0 +1,90 @@
+package org.springframework.samples.petclinic.web;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.service.ClinicService;
+import org.springframework.test.context.junit.jupiter.web.SpringJUnitWebConfig;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.context.WebApplicationContext;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+/**
+ * Renders pages through the application's real view resolvers (Tessera templates), unlike the
+ * controller tests which use {@code standaloneSetup} and never render a view.
+ */
+@SpringJUnitWebConfig(locations = {"classpath:spring/mvc-test-config.xml", "classpath:spring/mvc-core-config.xml"})
+class ViewRenderingTests {
+
+    private static final int TEST_OWNER_ID = 42;
+
+    @Autowired
+    private WebApplicationContext context;
+
+    @Autowired
+    private ClinicService clinicService;
+
+    private MockMvc mockMvc;
+
+    @BeforeEach
+    void setup() {
+        this.mockMvc = MockMvcBuilders.webAppContextSetup(context).build();
+
+        Owner owner = new Owner();
+        owner.setId(TEST_OWNER_ID);
+        owner.setFirstName("<script>alert('x')</script>");
+        owner.setLastName("O'Brien & \"Co\"");
+        owner.setAddress("<b>1 Road</b>");
+        owner.setCity("Madison");
+        owner.setTelephone("6085551023");
+        given(this.clinicService.findOwnerById(TEST_OWNER_ID)).willReturn(owner);
+    }
+
+    @Test
+    void ownerDetailsEscapesUserData() throws Exception {
+        mockMvc.perform(get("/owners/{ownerId}", TEST_OWNER_ID))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("Owner Information")))
+            .andExpect(content().string(containsString("&lt;script&gt;alert(")))
+            .andExpect(content().string(containsString("&lt;b&gt;1 Road&lt;/b&gt;")))
+            .andExpect(content().string(not(containsString("<script>alert"))))
+            .andExpect(content().string(not(containsString("<b>1 Road"))));
+    }
+
+    @Test
+    void ownerFormEscapesRejectedValues() throws Exception {
+        mockMvc.perform(post("/owners/new")
+                .param("firstName", "\"><script>alert(1)</script>")
+                .param("lastName", "")
+                .param("address", "a")
+                .param("city", "b")
+                .param("telephone", "1"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("action=\"/owners/new\"")))
+            .andExpect(content().string(containsString("must not be empty")))
+            .andExpect(content().string(not(containsString("<script>alert(1)"))));
+    }
+
+    @Test
+    void welcomePageRenders() throws Exception {
+        mockMvc.perform(get("/"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("<h2>Welcome</h2>")));
+    }
+
+    @Test
+    void exceptionPageRendersMessage() throws Exception {
+        mockMvc.perform(get("/oups"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("Something happened...")))
+            .andExpect(content().string(containsString("Expected: controller used to showcase")));
+    }
+}
