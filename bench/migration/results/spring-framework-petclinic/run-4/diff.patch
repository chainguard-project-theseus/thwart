+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.Owner" t:params="Owner owner"
+      t:replace="~{fragments/layout :: layout(~{::body}, 'owners', null)}">
+<body t:remove="tag">
+
+    <h2 id="ownerInformation">Owner Information</h2>
+
+    <table class="table table-striped" aria-describedby="ownerInformation">
+        <tr>
+            <th id="name">Name</th>
+            <td headers="name"><strong t:text="|${owner.firstName} ${owner.lastName}|">George Franklin</strong></td>
+        </tr>
+        <tr>
+            <th id="address">Address</th>
+            <td headers="address" t:text="owner.address">110 W. Liberty St.</td>
+        </tr>
+        <tr>
+            <th id="city">City</th>
+            <td headers="city" t:text="owner.city">Madison</td>
+        </tr>
+        <tr>
+            <th id="telephone">Telephone</th>
+            <td headers="telephone" t:text="owner.telephone">6085551023</td>
+        </tr>
+    </table>
+
+    <a t:href="@{{ownerId}/edit(ownerId=owner.id)}" class="btn btn-primary">Edit Owner</a>
+
+    <a t:href="@{{ownerId}/pets/new(ownerId=owner.id)}" class="btn btn-primary">Add New Pet</a>
+
+    <br/>
+    <br/>
+    <br/>
+    <h2 id="petsAndVisits">Pets and Visits</h2>
+
+    <table class="table table-striped" aria-describedby="petsAndVisits">
+        <tr t:each="pet : owner.pets">
+            <th scope="col">
+                <dl class="dl-horizontal">
+                    <dt>Name</dt>
+                    <dd t:text="pet.name">Leo</dd>
+                    <dt>Birth Date</dt>
+                    <dd t:text="temporals.format(pet.birthDate, 'yyyy-MM-dd')">2010-09-07</dd>
+                    <dt>Type</dt>
+                    <dd t:text="pet.type?.name">cat</dd>
+                </dl>
+            </th>
+            <td>
+                <table class="table-condensed" aria-describedby="petsAndVisits">
+                    <thead>
+                    <tr>
+                        <th id="visitDate">Visit Date</th>
+                        <th id="visitDescription">Description</th>
+                    </tr>
+                    </thead>
+                    <tr t:each="visit : pet.visits">
+                        <td headers="visitDate" t:text="temporals.format(visit.date, 'yyyy-MM-dd')">2013-01-01</td>
+                        <td headers="visitDescription" t:text="visit.description">rabies shot</td>
+                    </tr>
+                    <tr>
+                        <td>
+                            <a t:href="@{/owners/{ownerId}/pets/{petId}/edit(ownerId=owner.id, petId=pet.id)}">Edit Pet</a>
+                        </td>
+                        <td>
+                            <a t:href="@{/owners/{ownerId}/pets/{petId}/visits/new(ownerId=owner.id, petId=pet.id)}">Add Visit</a>
+                        </td>
+                    </tr>
+                </table>
+            </td>
+        </tr>
+    </table>
+
+</body>
+</html>
