@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.system;
+
+import org.springframework.boot.autoconfigure.web.ConditionalOnEnabledResourceChain;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.web.servlet.resource.ResourceUrlEncodingFilter;
+
+/**
+ * Registers the {@link ResourceUrlEncodingFilter} that versions webjar links, as Spring Boot's
+ * Thymeleaf auto-configuration did before the views moved to Tessera. Declared as a plain filter
+ * bean, Boot maps it for REQUEST dispatches only, so error pages keep their unversioned links as
+ * before (Tessera's own registration would also cover ERROR dispatches).
+ */
+@Configuration
+class ResourceUrlConfig {
+
+    @Bean
+    @ConditionalOnEnabledResourceChain
+    public ResourceUrlEncodingFilter resourceUrlEncodingFilter() {
+        return new ResourceUrlEncodingFilter();
+    }
+
+}
