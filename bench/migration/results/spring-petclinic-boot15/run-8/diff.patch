diff --git a/src/test/java/org/springframework/samples/petclinic/owner/OwnerViewRenderingTests.java b/src/test/java/org/springframework/samples/petclinic/owner/OwnerViewRenderingTests.java
new file mode 100644
index 0000000..3695b8f
--- /dev/null
+++ b/src/test/java/org/springframework/samples/petclinic/owner/OwnerViewRenderingTests.java
@@ -0,0 +1,51 @@
+package org.springframework.samples.petclinic.owner;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
+import org.springframework.boot.test.mock.mockito.MockBean;
+import org.springframework.test.context.junit4.SpringRunner;
+import org.springframework.test.web.servlet.MockMvc;
+
+/**
+ * Renders owner pages through the real (Tessera) view resolver and checks that user data is
+ * escaped.
+ */
+@RunWith(SpringRunner.class)
+@WebMvcTest(OwnerController.class)
+public class OwnerViewRenderingTests {
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @MockBean
+    private OwnerRepository owners;
+
+    @Test
+    public void ownerDetailsEscapesUserData() throws Exception {
+        Owner owner = new Owner();
+        owner.setId(1);
+        owner.setFirstName("<script>alert(1)</script>");
+        owner.setLastName("O'Brien & Co");
+        owner.setAddress("\"quoted\"");
+        owner.setCity("Madison");
+        owner.setTelephone("6085551023");
+        given(this.owners.findById(1)).willReturn(owner);
+
+        mockMvc.perform(get("/owners/1"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("Owner Information")))
+            .andExpect(content().string(containsString("&lt;script&gt;alert(1)&lt;/script&gt;")))
+            .andExpect(content().string(not(containsString("<script>alert(1)"))))
+            .andExpect(content().string(containsString("O&#39;Brien &amp; Co")));
+    }
+
+}
