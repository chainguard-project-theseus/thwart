@@ -0,0 +1,37 @@
+package org.springframework.samples.petclinic.system;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.samples.petclinic.owner.Pet;
+import org.springframework.samples.petclinic.visit.Visit;
+
+/**
+ * Date formatting for the views: the entities hold {@link java.util.Date}s, which templates
+ * cannot read directly. Formats the way Thymeleaf's {@code #calendars.format(date, 'yyyy-MM-dd')} did.
+ */
+@TemplateFunctions("dates")
+public final class DateFunctions {
+
+    private static final String PATTERN = "yyyy-MM-dd";
+
+    private DateFunctions() {
+    }
+
+    @TemplateFunction
+    public static String birthDate(Locale locale, Pet pet) {
+        return pet == null ? null : format(locale, pet.getBirthDate());
+    }
+
+    @TemplateFunction
+    public static String visitDate(Locale locale, Visit visit) {
+        return visit == null ? null : format(locale, visit.getDate());
+    }
+
+    private static String format(Locale locale, Date date) {
+        return date == null ? null : new SimpleDateFormat(PATTERN, locale).format(date);
+    }
+}
