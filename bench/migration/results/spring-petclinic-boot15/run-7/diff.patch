+++ b/src/main/java/org/springframework/samples/petclinic/system/WebConfig.java
@@ -0,0 +1,19 @@
+package org.springframework.samples.petclinic.system;
+
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.web.servlet.resource.ResourceUrlEncodingFilter;
+
+/**
+ * Rewrites resource links (e.g. {@code /webjars/jquery/jquery.min.js}) to their versioned
+ * locations through {@code response.encodeURL}, which Tessera's links go through. Spring Boot
+ * registered this filter as part of its Thymeleaf auto-configuration.
+ */
+@Configuration
+class WebConfig {
+
+    @Bean
+    public ResourceUrlEncodingFilter resourceUrlEncodingFilter() {
+        return new ResourceUrlEncodingFilter();
+    }
+}
