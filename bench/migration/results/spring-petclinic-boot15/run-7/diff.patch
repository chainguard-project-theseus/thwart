diff --git a/src/main/java/org/springframework/samples/petclinic/system/DateFunctions.java b/src/main/java/org/springframework/samples/petclinic/system/DateFunctions.java
new file mode 100644
index 0000000..e0f36ab
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/system/DateFunctions.java
@@ -0,0 +1,36 @@
+package org.springframework.samples.petclinic.system;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.samples.petclinic.owner.Pet;
+import org.springframework.samples.petclinic.visit.Visit;
+
+/**
+ * Date formatting for templates: {@link java.util.Date} is not a view-safe type, so templates
+ * pass the entity and get the formatted date back.
+ */
+@TemplateFunctions("dates")
+public final class DateFunctions {
+
+    private static final String PATTERN = "yyyy-MM-dd";
+
+    private DateFunctions() {
+    }
+
+    @TemplateFunction
+    public static String birthDate(Pet pet) {
+        return pet == null ? "" : format(pet.getBirthDate());
+    }
+
+    @TemplateFunction
+    public static String visitDate(Visit visit) {
+        return visit == null ? "" : format(visit.getDate());
+    }
+
+    private static String format(Date date) {
+        return date == null ? "" : new SimpleDateFormat(PATTERN).format(date);
+    }
+}
