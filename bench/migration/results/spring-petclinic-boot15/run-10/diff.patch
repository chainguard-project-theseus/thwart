+POST /owners/1/pets/1/visits/new date=2013-01-01&description=
+POST /owners/1/pets/1/visits/new date=notadate&description=check
+POST /owners/1/pets/1/visits/new date=2013-01-02&description=%3Cb%3Erabies%3C%2Fb%3E+shot
