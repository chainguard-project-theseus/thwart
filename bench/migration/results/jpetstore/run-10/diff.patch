+ *    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ *    See the License for the specific language governing permissions and
+ *    limitations under the License.
+ */
+package com.kazuki43zoo.jpetstore.ui.template;
+
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Template functions for the HTML stored in the database (product descriptions and banners).
+ */
+@TemplateFunctions("markup")
+public final class MarkupFunctions {
+
+	// Stored descriptions and banners hold a same-origin image followed by text.
+	private static final HtmlPolicy POLICY = HtmlPolicy.builder()
+			.allowElements("img")
+			.allowAttributes("alt")
+			.build();
+
+	// The stored markup uses <image>, which browsers parse as <img> but the sanitizer drops.
+	private static final Pattern IMAGE_TAG = Pattern.compile("<image(?=[\\s/>])", Pattern.CASE_INSENSITIVE);
+
+	private static final Pattern LEADING_IMAGE =
+			Pattern.compile("^\\s*<(?:image|img)\\s[^>]*?src\\s*=\\s*\"([^\"]*)\"[^>]*>", Pattern.CASE_INSENSITIVE);
+	private static final Pattern TAG = Pattern.compile("<[^>]*>");
+
+	private MarkupFunctions() {
+	}
+
+	@TemplateFunction
+	public static SafeHtml html(Object text) {
+		if (text == null) {
+			return SafeHtml.sanitize(null, POLICY);
+		}
+		return SafeHtml.sanitize(IMAGE_TAG.matcher(text.toString()).replaceAll("<img"), POLICY);
+	}
+
+	/**
+	 * The {@code src} of the image a stored description starts with, for places where markup can't go
+	 * (inside a link); {@code null} if it starts with none.
+	 */
+	@TemplateFunction
+	public static String leadingImage(String html) {
+		if (html == null) {
+			return null;
+		}
+		Matcher matcher = LEADING_IMAGE.matcher(html);
+		return matcher.find() ? matcher.group(1) : null;
+	}
+
+	/**
+	 * The text of a stored description without its tags, printed escaped.
+	 */
+	@TemplateFunction
+	public static String text(String html) {
+		return html == null ? null : TAG.matcher(html).replaceAll("");
+	}
+
+}
