+ *    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ *    See the License for the specific language governing permissions and
+ *    limitations under the License.
+ */
+package com.kazuki43zoo.jpetstore;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.test.context.junit4.SpringRunner;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+/**
+ * Renders pages through the real view resolver (Tessera) and checks that user input comes out escaped.
+ */
+@RunWith(SpringRunner.class)
+@SpringBootTest
+@AutoConfigureMockMvc
+public class ViewRenderingTests {
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	public void searchKeywordsAreEscaped() throws Exception {
+		mockMvc.perform(get("/catalog/products").param("keywords", "<script>alert(1)</script>"))
+				.andExpect(status().isOk())
+				.andExpect(content().string(containsString("value=\"&lt;script&gt;alert(1)&lt;/script&gt;\"")))
+				.andExpect(content().string(not(containsString("<script>alert(1)</script>"))));
+	}
+
+	@Test
+	public void storedDescriptionKeepsOnlyItsImage() throws Exception {
+		mockMvc.perform(get("/catalog/items/EST-1"))
+				.andExpect(status().isOk())
+				.andExpect(content().string(containsString("<img src=\"/images/fish1.gif\">Salt Water fish from Australia")));
+	}
+
+}
