diff --git a/src/main/java/com/kazuki43zoo/jpetstore/ui/template/MarkupFunctions.java b/src/main/java/com/kazuki43zoo/jpetstore/ui/template/MarkupFunctions.java
new file mode 100644
index 0000000..9f36817
--- /dev/null
+++ b/src/main/java/com/kazuki43zoo/jpetstore/ui/template/MarkupFunctions.java
@@ -0,0 +1,77 @@
