+
+	private static final Pattern IMAGE_TEXT =
+			Pattern.compile("^\\s*<image\\s+src=\"(/images/[A-Za-z0-9_.-]+)\"\\s*/?>(.*)$", Pattern.DOTALL);
+
+	private final String imageSrc;
+	private final String text;
+
+	private ImageText(String imageSrc, String text) {
+		this.imageSrc = imageSrc;
+		this.text = text;
+	}
+
+	public static ImageText parse(String value) {
+		if (value == null) {
+			return new ImageText(null, null);
+		}
+		Matcher matcher = IMAGE_TEXT.matcher(value);
+		if (matcher.matches()) {
+			return new ImageText(matcher.group(1), matcher.group(2));
+		}
+		return new ImageText(null, value);
+	}
+
+	public String getImageSrc() {
+		return imageSrc;
+	}
+
+	public String getText() {
+		return text;
+	}
+
+}
