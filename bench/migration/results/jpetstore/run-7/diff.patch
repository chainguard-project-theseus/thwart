+ *    limitations under the License.
+ */
+package com.kazuki43zoo.jpetstore;
+
+import com.kazuki43zoo.jpetstore.config.TesseraTemplateAvailabilityProvider;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.test.context.junit4.SpringRunner;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+/**
+ * Renders pages through the real view resolvers (Tessera templates).
+ *
+ * @author Kazuki Shimizu
+ */
+@RunWith(SpringRunner.class)
+@SpringBootTest
+@AutoConfigureMockMvc
+public class ViewRenderingTests {
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	public void searchKeywordsAreEscaped() throws Exception {
+		mockMvc.perform(get("/catalog/products").param("keywords", "<script>alert(1)</script>"))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith("text/html"))
+				.andExpect(content().string(containsString("Products not found.")))
+				.andExpect(content().string(containsString("&lt;script&gt;alert(1)&lt;/script&gt;")))
+				.andExpect(content().string(not(containsString("<script>alert(1)</script>"))));
+	}
+
+	@Test
+	public void productDescriptionImageIsRendered() throws Exception {
+		mockMvc.perform(get("/catalog/products").param("keywords", "angel"))
+				.andExpect(status().isOk())
+				.andExpect(content().string(containsString("<img src=\"/images/fish1.gif\"")))
+				.andExpect(content().string(containsString("Salt Water fish from Australia")));
+	}
+
+	@Test
+	public void errorViewsAreTesseraTemplates() {
+		TesseraTemplateAvailabilityProvider provider = new TesseraTemplateAvailabilityProvider();
+		ClassLoader classLoader = getClass().getClassLoader();
+		assertThat(provider.isTemplateAvailable("error/404", null, classLoader, null)).isTrue();
+		assertThat(provider.isTemplateAvailable("error/500", null, classLoader, null)).isTrue();
+		assertThat(provider.isTemplateAvailable("error/4xx", null, classLoader, null)).isFalse();
+	}
+
+}
