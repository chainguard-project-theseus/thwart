+package com.kazuki43zoo.jpetstore.ui.view;
+
+import dev.tessera.runtime.TemplateView;
+
+import java.util.function.Supplier;
+
+/**
+ * What the common layout shows besides the page content.
+ *
+ * @author Kazuki Shimizu
+ */
+@TemplateView
+public final class LayoutView {
+
+	private final boolean errorResponse;
+	private final Supplier<String> keywords;
+	private final String username;
+	private final String firstName;
+	private final ImageText banner;
+
+	public LayoutView(boolean errorResponse, Supplier<String> keywords, String username, String firstName, ImageText banner) {
+		this.errorResponse = errorResponse;
+		this.keywords = keywords;
+		this.username = username;
+		this.firstName = firstName;
+		this.banner = banner;
+	}
+
+	/**
+	 * Whether the page is an error page (the header menus are hidden).
+	 */
+	public boolean isErrorResponse() {
+		return errorResponse;
+	}
+
+	/**
+	 * The keywords of the last product search, read when the page renders (after the search ran).
+	 */
+	public String getKeywords() {
+		return keywords.get();
+	}
+
+	/**
+	 * The user ID of the signed-in user, or {@code null}.
+	 */
+	public String getUsername() {
+		return username;
+	}
+
+	/**
+	 * The first name of the signed-in user, or {@code null}.
+	 */
+	public String getFirstName() {
+		return firstName;
+	}
+
+	/**
+	 * The banner of the signed-in user's favourite category, or {@code null} if disabled.
+	 */
+	public ImageText getBanner() {
+		return banner;
+	}
+
+}
