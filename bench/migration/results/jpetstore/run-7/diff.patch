+package com.kazuki43zoo.jpetstore.config;
+
+import dev.tessera.runtime.TemplateRegistry;
+import org.springframework.boot.autoconfigure.template.TemplateAvailabilityProvider;
+import org.springframework.core.env.Environment;
+import org.springframework.core.io.ResourceLoader;
+
+/**
+ * Tells Spring Boot's error view resolver which views are compiled Tessera templates, so that
+ * {@code error/404} and the like render through Tessera.
+ *
+ * @author Kazuki Shimizu
+ */
+public class TesseraTemplateAvailabilityProvider implements TemplateAvailabilityProvider {
+
+	@Override
+	public boolean isTemplateAvailable(String view, Environment environment, ClassLoader classLoader,
+									   ResourceLoader resourceLoader) {
+		return TemplateRegistry.load(classLoader).find(view).isPresent();
+	}
+
+}
