+package com.kazuki43zoo.jpetstore.ui.view;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.text.DecimalFormat;
+import java.text.DecimalFormatSymbols;
+import java.util.Locale;
+
+/**
+ * Template functions of the {@code view} namespace.
+ *
+ * @author Kazuki Shimizu
+ */
+@TemplateFunctions("view")
+public final class ViewFunctions {
+
+	private ViewFunctions() {
+	}
+
+	/**
+	 * Formats an amount with comma grouping and two decimals (e.g. {@code 1,234.50}).
+	 */
+	@TemplateFunction
+	public static String price(BigDecimal amount) {
+		if (amount == null) {
+			return null;
+		}
+		DecimalFormat format = new DecimalFormat("#,##0.00", DecimalFormatSymbols.getInstance(Locale.US));
+		return format.format(amount.setScale(2, RoundingMode.HALF_UP));
+	}
+
+	/**
+	 * Splits a description stored as {@code <image src="...">text} into its image and text.
+	 */
+	@TemplateFunction
+	public static ImageText imageText(String value) {
+		return ImageText.parse(value);
+	}
+
+}
