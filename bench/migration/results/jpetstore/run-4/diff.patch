+ * Lets Spring Boot's error view resolver find the Tessera templates {@code error/404},
+ * {@code error/500}, ... by status code, as it did for the Thymeleaf templates.
+ *
+ * @author Kazuki Shimizu
+ */
+public class TesseraTemplateAvailabilityProvider implements TemplateAvailabilityProvider {
+
+	private final Map<ClassLoader, TemplateRegistry> registries = new ConcurrentHashMap<>();
+
+	@Override
+	public boolean isTemplateAvailable(String view, Environment environment, ClassLoader classLoader,
+									   ResourceLoader resourceLoader) {
+		return registries.computeIfAbsent(classLoader, TemplateRegistry::load).find(view).isPresent();
+	}
+
+}
