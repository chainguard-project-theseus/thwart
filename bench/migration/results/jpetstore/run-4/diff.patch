+package com.kazuki43zoo.jpetstore.ui.view;
+
+import dev.tessera.runtime.TemplateView;
+
+/**
+ * A piece of the markup stored in the database: either an image or plain text.
+ *
+ * @author Kazuki Shimizu
+ */
+@TemplateView
+public class MarkupPart {
+
+	private final String src;
+	private final String text;
+
+	private MarkupPart(String src, String text) {
+		this.src = src;
+		this.text = text;
+	}
+
+	static MarkupPart image(String src) {
+		return new MarkupPart(src, null);
+	}
+
+	static MarkupPart text(String text) {
+		return new MarkupPart(null, text);
+	}
+
+	public boolean isImage() {
+		return src != null;
+	}
+
+	public String getSrc() {
+		return src;
+	}
+
+	public String getText() {
+		return text;
+	}
+
+}
