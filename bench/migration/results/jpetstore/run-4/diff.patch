+ *    See the License for the specific language governing permissions and
+ *    limitations under the License.
+ */
+package com.kazuki43zoo.jpetstore;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.test.context.junit4.SpringRunner;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+/**
+ * Renders pages through the real view resolvers (Tessera templates) and checks escaping.
+ */
+@RunWith(SpringRunner.class)
+@SpringBootTest
+@AutoConfigureMockMvc
+public class TesseraViewRenderingTests {
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	public void searchKeywordsAreEscapedInTheLayout() throws Exception {
+		mockMvc.perform(get("/catalog/products").param("keywords", "<script>alert('x')</script>"))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith("text/html"))
+				.andExpect(content().string(containsString("Products not found.")))
+				.andExpect(content().string(containsString("value=\"&lt;script&gt;alert(")))
+				.andExpect(content().string(not(containsString("<script>alert("))));
+	}
+
+	@Test
+	public void productDescriptionMarkupIsRenderedAsImageAndText() throws Exception {
+		mockMvc.perform(get("/catalog/products").param("keywords", "fish"))
+				.andExpect(status().isOk())
+				.andExpect(content().string(containsString("<img src=\"/images/fish2.gif\">Fresh Water fish from China")));
+	}
+
+}
