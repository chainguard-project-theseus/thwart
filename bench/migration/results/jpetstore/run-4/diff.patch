+/**
+ * Number formatting for templates.
+ *
+ * @author Kazuki Shimizu
+ */
+@TemplateFunctions("fmt")
+public final class FormatFunctions {
+
+	private FormatFunctions() {
+	}
+
+	/** Formats an amount with comma grouping and two decimals (e.g. {@code 1,234.50}). */
+	@TemplateFunction
+	public static String decimal(BigDecimal value) {
+		if (value == null) {
+			return null;
+		}
+		DecimalFormat format = new DecimalFormat("#,##0.00", DecimalFormatSymbols.getInstance(Locale.US));
+		format.setRoundingMode(RoundingMode.HALF_EVEN);
+		return format.format(value);
+	}
+
+}
diff --git a/src/main/java/com/kazuki43zoo/jpetstore/ui/view/MarkupFunctions.java b/src/main/java/com/kazuki43zoo/jpetstore/ui/view/MarkupFunctions.java
