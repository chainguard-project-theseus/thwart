+ */
+package com.kazuki43zoo.jpetstore.ui.view;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Splits the HTML snippets stored in the database (product descriptions, banners) into images and
+ * text, so that templates can render them without trusting raw markup. Only
+ * {@code <image src="/local/path">} tags are recognized; everything else is kept as text and
+ * escaped on output.
+ *
+ * @author Kazuki Shimizu
+ */
+@TemplateFunctions("markup")
+public final class MarkupFunctions {
+
+	private static final Pattern IMAGE = Pattern.compile("<image\\s+src=\"(/[A-Za-z0-9_./-]*)\"\\s*/?>");
+
+	private MarkupFunctions() {
+	}
+
+	@TemplateFunction
+	public static List<MarkupPart> parts(String html) {
+		if (html == null || html.isEmpty()) {
+			return Collections.emptyList();
+		}
+		List<MarkupPart> parts = new ArrayList<>();
+		Matcher matcher = IMAGE.matcher(html);
+		int last = 0;
+		while (matcher.find()) {
+			if (matcher.start() > last) {
+				parts.add(MarkupPart.text(html.substring(last, matcher.start())));
+			}
+			parts.add(MarkupPart.image(matcher.group(1)));
+			last = matcher.end();
+		}
+		if (last < html.length()) {
+			parts.add(MarkupPart.text(html.substring(last)));
+		}
+		return parts;
+	}
+
+}
