+
+import java.util.List;
+
+/**
+ * A cart item with its quantity field ({@code lines[i].quantity}) as bound by Spring: Tessera's
+ * {@code t:field} does not support indexed paths, so the controller resolves the field's name,
+ * display value and error messages.
+ *
+ * @author Kazuki Shimizu
+ */
+@TemplateView
+public class CartRow {
+
+	private final CartItem cartItem;
+	private final String quantityName;
+	private final String quantityId;
+	private final String quantityValue;
+	private final List<String> quantityErrors;
+
+	public CartRow(CartItem cartItem, String quantityName, String quantityValue, List<String> quantityErrors) {
+		this.cartItem = cartItem;
+		this.quantityName = quantityName;
+		this.quantityId = quantityName.replace("[", "").replace("]", "");
+		this.quantityValue = quantityValue;
+		this.quantityErrors = quantityErrors;
+	}
+
+	public CartItem getCartItem() {
+		return cartItem;
+	}
+
+	public String getQuantityName() {
+		return quantityName;
+	}
+
+	public String getQuantityId() {
+		return quantityId;
+	}
+
+	public String getQuantityValue() {
+		return quantityValue;
+	}
+
+	public List<String> getQuantityErrors() {
+		return quantityErrors;
+	}
+
+}
