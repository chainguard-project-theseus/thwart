+ *    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ *    See the License for the specific language governing permissions and
+ *    limitations under the License.
+ */
+package com.kazuki43zoo.jpetstore.ui.view;
+
+import com.kazuki43zoo.jpetstore.domain.Account;
+import dev.tessera.runtime.TemplateView;
+
+import java.util.List;
+import java.util.function.Supplier;
+
+/**
+ * Values the common layout needs on every page (they were read from the request, the session and
+ * the security context by the old templates).
+ *
+ * @author Kazuki Shimizu
+ */
+@TemplateView
+public class SiteView {
+
+	private final boolean errorResponse;
+	private final Supplier<String> keywords;
+	private final Account account;
+
+	public SiteView(boolean errorResponse, Supplier<String> keywords, Account account) {
+		this.errorResponse = errorResponse;
+		this.keywords = keywords;
+		this.account = account;
+	}
+
+	/** Whether the page is rendered for an error response (status 400 or higher). */
+	public boolean isErrorResponse() {
+		return errorResponse;
+	}
+
+	/** The last product search keywords (read when the page renders, after the controller ran), never null. */
+	public String getKeywords() {
+		String value = keywords.get();
+		return value == null ? "" : value;
+	}
+
+	/** The signed-in user's account, or null. */
+	public Account getAccount() {
+		return account;
+	}
+
+	/** The banner of the signed-in user when the banner option is enabled, otherwise empty. */
+	public List<MarkupPart> getBanner() {
+		if (account == null || !account.isBannerOption()) {
+			return java.util.Collections.emptyList();
+		}
+		return MarkupFunctions.parts(account.getBannerName());
+	}
+
+}
