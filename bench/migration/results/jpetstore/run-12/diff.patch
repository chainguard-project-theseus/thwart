+package com.kazuki43zoo.jpetstore.ui;
+
+import org.junit.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class MarkupFunctionsTests {
+
+	@Test
+	public void keepsStoredImageAndText() {
+		assertThat(MarkupFunctions.inline("<image src=\"/images/fish1.gif\">Salt Water fish from Australia").html())
+				.isEqualTo("<img src=\"/images/fish1.gif\">Salt Water fish from Australia");
+	}
+
+	@Test
+	public void dropsActiveContent() {
+		String html = MarkupFunctions.inline("<image src=\"/x.gif\" onerror=\"alert(1)\"><script>alert(2)</script><b>ok</b>").html();
+		assertThat(html).doesNotContain("onerror").doesNotContain("<script");
+	}
+
+	@Test
+	public void nullIsNull() {
+		assertThat(MarkupFunctions.inline(null)).isNull();
+	}
+
+}
