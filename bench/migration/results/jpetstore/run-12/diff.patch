+package com.kazuki43zoo.jpetstore.ui;
+
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeInlineHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.regex.Pattern;
+
+/**
+ * Template functions for the HTML stored in the database (product descriptions and banners).
+ */
+@TemplateFunctions("markup")
+public final class MarkupFunctions {
+
+	private static final HtmlPolicy INLINE_POLICY = HtmlPolicy.inlineBuilder().allowElements("img").build();
+
+	// the stored data uses the legacy <image> tag that browsers read as <img>
+	private static final Pattern IMAGE_TAG = Pattern.compile("<image(?=[\\s/>])", Pattern.CASE_INSENSITIVE);
+
+	private MarkupFunctions() {
+	}
+
+	@TemplateFunction
+	public static SafeInlineHtml inline(String html) {
+		if (html == null) {
+			return null;
+		}
+		return SafeInlineHtml.sanitize(IMAGE_TAG.matcher(html).replaceAll("<img"), INLINE_POLICY);
+	}
+
+}
