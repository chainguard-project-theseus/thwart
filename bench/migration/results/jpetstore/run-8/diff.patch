+package com.kazuki43zoo.jpetstore.ui;
+
+import com.kazuki43zoo.jpetstore.domain.Account;
+import com.kazuki43zoo.jpetstore.service.AccountUserDetails;
+import dev.tessera.runtime.TemplateView;
+import org.springframework.security.authentication.AnonymousAuthenticationToken;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.context.SecurityContextHolder;
+
+/**
+ * Values read by the layout template on every page.
+ *
+ * @author Kazuki Shimizu
+ */
+@TemplateView
+public class LayoutView {
+
+	private final boolean errorResponse;
+	private final ProductSearchCriteria productSearchCriteria;
+
+	public LayoutView(boolean errorResponse, ProductSearchCriteria productSearchCriteria) {
+		this.errorResponse = errorResponse;
+		this.productSearchCriteria = productSearchCriteria;
+	}
+
+	/**
+	 * @return whether the page is rendered for an error response (status 400 or above)
+	 */
+	public boolean isErrorResponse() {
+		return errorResponse;
+	}
+
+	/**
+	 * @return the keywords of the last product search (read when the page renders)
+	 */
+	public String getSearchKeywords() {
+		return productSearchCriteria.getKeywords();
+	}
+
+	/**
+	 * @return the account of the signed-in user, or {@code null}
+	 */
+	public Account getAccount() {
+		Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
+		if (authentication == null || authentication instanceof AnonymousAuthenticationToken
+				|| !(authentication.getPrincipal() instanceof AccountUserDetails)) {
+			return null;
+		}
+		return ((AccountUserDetails) authentication.getPrincipal()).getAccount();
+	}
+
+}
