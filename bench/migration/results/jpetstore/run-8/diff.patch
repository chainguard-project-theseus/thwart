+ *    limitations under the License.
+ */
+package com.kazuki43zoo.jpetstore.ui;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.autoconfigure.web.servlet.MockMvcPrint;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.test.context.junit4.SpringRunner;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+/**
+ * Renders pages through the real view resolvers (Tessera templates).
+ *
+ * @author Kazuki Shimizu
+ */
+@RunWith(SpringRunner.class)
+@SpringBootTest
+// No printing: the printed model holds session-scoped proxies that cannot be read after the request
+@AutoConfigureMockMvc(print = MockMvcPrint.NONE)
+public class ViewRenderingTests {
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	public void searchKeywordsAreEscaped() throws Exception {
+		mockMvc.perform(get("/catalog/products").param("keywords", "<script>alert(1)</script>"))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith("text/html"))
+				.andExpect(content().string(containsString("value=\"&lt;script&gt;alert(1)&lt;/script&gt;\"")))
+				.andExpect(content().string(not(containsString("<script>alert(1)</script>"))));
+	}
+
+	@Test
+	public void productDescriptionRendersImageAndText() throws Exception {
+		mockMvc.perform(get("/catalog/products").param("keywords", "goldfish"))
+				.andExpect(status().isOk())
+				.andExpect(content().string(containsString("<img src=\"/images/fish2.gif\"")))
+				.andExpect(content().string(containsString("Fresh Water fish from China")));
+	}
+
+	@Test
+	public void cartFormRendersCsrfToken() throws Exception {
+		mockMvc.perform(get("/cart"))
+				.andExpect(status().isOk())
+				.andExpect(content().string(containsString("name=\"_csrf\"")))
+				.andExpect(content().string(containsString("Your cart is empty.")));
+	}
+
+}
