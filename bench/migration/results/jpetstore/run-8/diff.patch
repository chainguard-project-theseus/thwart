+
+/**
+ * Template functions of the {@code view} namespace.
+ *
+ * @author Kazuki Shimizu
+ */
+@TemplateFunctions("view")
+public final class ViewFunctions {
+
+	/**
+	 * Markup stored in the sample data: an image tag followed by plain text,
+	 * e.g. {@code <image src="/images/fish1.gif">Salt Water fish from Australia}.
+	 */
+	private static final Pattern IMAGE_AND_TEXT = Pattern.compile(
+			"^\\s*<image\\s+src=\"([^\"<>]*)\"\\s*/?>(.*)$", Pattern.CASE_INSENSITIVE | Pattern.DOTALL);
+
+	private ViewFunctions() {
+	}
+
+	/**
+	 * Formats an amount with two decimals and grouped thousands (e.g. {@code 1,234.50}).
+	 */
+	@TemplateFunction
+	public static String amount(BigDecimal amount) {
+		if (amount == null) {
+			return null;
+		}
+		DecimalFormatSymbols symbols = new DecimalFormatSymbols();
+		symbols.setGroupingSeparator(',');
+		symbols.setDecimalSeparator('.');
+		DecimalFormat format = new DecimalFormat("#,##0.00", symbols);
+		format.setRoundingMode(RoundingMode.HALF_EVEN);
+		return format.format(amount);
+	}
+
+	/**
+	 * Returns the image path of a description stored as {@code <image src="...">text}, or {@code null}.
+	 */
+	@TemplateFunction
+	public static String imageSrc(String markup) {
+		Matcher matcher = matcher(markup);
+		return matcher == null ? null : matcher.group(1);
+	}
+
+	/**
+	 * Returns the text of a description stored as {@code <image src="...">text} (the whole value
+	 * if it has no leading image). It is printed escaped.
+	 */
+	@TemplateFunction
+	public static String text(String markup) {
+		Matcher matcher = matcher(markup);
+		return matcher == null ? markup : matcher.group(2);
+	}
+
+	private static Matcher matcher(String markup) {
+		if (markup == null) {
+			return null;
+		}
+		Matcher matcher = IMAGE_AND_TEXT.matcher(markup);
+		return matcher.matches() ? matcher : null;
+	}
+
+}
