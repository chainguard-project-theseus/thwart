+package com.kazuki43zoo.jpetstore.ui;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Splits stored markup such as a product description or a banner ({@code <image src="/images/x.gif">Some text}) into its
+ * image path and its plain text, so that a template can render it inside a link without
+ * inserting stored markup.
+ *
+ * @author Kazuki Shimizu
+ */
+@TemplateFunctions("storedMarkup")
+public final class StoredMarkup {
+
+	private static final Pattern IMAGE = Pattern.compile("<im(?:age|g)\\b[^>]*?\\bsrc\\s*=\\s*[\"']([^\"']*)[\"'][^>]*>", Pattern.CASE_INSENSITIVE);
+	private static final Pattern TAG = Pattern.compile("<[^>]*>");
+
+	private StoredMarkup() {
+	}
+
+	/**
+	 * @return the {@code src} of the first image in the markup, or {@code null}
+	 */
+	@TemplateFunction
+	public static String image(String markup) {
+		if (markup == null) {
+			return null;
+		}
+		Matcher matcher = IMAGE.matcher(markup);
+		return matcher.find() ? matcher.group(1) : null;
+	}
+
+	/**
+	 * @return the text of the markup without its tags
+	 */
+	@TemplateFunction
+	public static String text(String markup) {
+		if (markup == null) {
+			return null;
+		}
+		return TAG.matcher(markup).replaceAll("")
+				.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"")
+				.replace("&#39;", "'").replace("&amp;", "&");
+	}
+
+}
