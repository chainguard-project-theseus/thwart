+          <h5>Du wurdest ausgeloggt!</h5>
+        </div>
+        <form action="/admin/login" method="post"><input type="hidden" name="_csrf" value="qyBygQyKBH8GndNmrMPqtiw_phZJx9yZ9PO4O1PuEGg5Eca2kkJA5W-7ZRwr-OJQyu7e0xkLi3Qsprm0xJXbDzLeKFpfKKOH"/>
