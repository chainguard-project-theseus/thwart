+package de.uni.rostock.ub.purl_server.web;
+
+import java.util.Locale;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+
+import jakarta.servlet.http.HttpServletRequest;
+
+/**
+ * Model attributes that every page reads: the locale, the configured page title and footer and the request
+ * parameters read by the login pages.
+ */
+@ControllerAdvice
+public class ViewModelAdvice {
+    @Value("${purl_server.web.html_fragment.title:#{null}}")
+    private String titleHtml;
+
+    @Value("${purl_server.web.html_fragment.footer:#{null}}")
+    private String footerHtml;
+
+    @ModelAttribute("pageLang")
+    public String pageLang(Locale locale) {
+        return locale.getLanguage();
+    }
+
+    @ModelAttribute("pageLocale")
+    public String pageLocale(Locale locale) {
+        return locale.toString();
+    }
+
+    @ModelAttribute("titleHtml")
+    public String titleHtml() {
+        return titleHtml;
+    }
+
+    @ModelAttribute("footerHtml")
+    public String footerHtml() {
+        return footerHtml;
+    }
+
+    @ModelAttribute("paramError")
+    public boolean paramError(HttpServletRequest request) {
+        return request.getParameter("error") != null;
+    }
+
+    @ModelAttribute("paramLogout")
+    public boolean paramLogout(HttpServletRequest request) {
+        return request.getParameter("logout") != null;
+    }
+
+    @ModelAttribute("paramToken")
+    public String paramToken(HttpServletRequest request) {
+        return request.getParameter("token");
+    }
+
+    @ModelAttribute("paramLogin")
+    public String paramLogin(HttpServletRequest request) {
+        return request.getParameter("login");
+    }
+}
