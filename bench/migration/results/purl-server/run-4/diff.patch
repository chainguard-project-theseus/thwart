+package de.uni.rostock.ub.purl_server.test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import java.util.List;
+import java.util.Optional;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.security.test.context.support.WithMockUser;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.web.servlet.MockMvc;
+
+import de.uni.rostock.ub.purl_server.dao.DomainDAO;
+import de.uni.rostock.ub.purl_server.model.Domain;
+import de.uni.rostock.ub.purl_server.web.Markup;
+import de.uni.rostock.ub.purl_server.web.MarkupNode;
+
+/**
+ * Renders pages through the real view resolvers (Tessera templates).
+ */
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.MOCK)
+@AutoConfigureMockMvc
+@ActiveProfiles("test")
+class ViewRenderingTests extends PURLServerBaseTest {
+    @Autowired
+    MockMvc mvc;
+
+    @Autowired
+    DomainDAO domainDAO;
+
+    @Test
+    void testUserDataIsEscaped() throws Exception {
+        Domain domain = new Domain();
+        domain.setPath("/xss");
+        domain.setName("<script>alert('name')</script>");
+        domain.setComment("<b onclick=\"x()\">comment</b>");
+        Optional<Domain> created = domainDAO.createDomain(domain);
+        assertTrue(created.isPresent());
+
+        String html = mvc.perform(get("/info/domain/xss").accept(MediaType.TEXT_HTML))
+            .andExpect(status().isOk())
+            .andReturn().getResponse().getContentAsString();
+        assertThat(html).contains("&lt;script&gt;alert(&#39;name&#39;)&lt;/script&gt;")
+            .doesNotContain("<script>alert(")
+            .contains("&lt;b onclick=")
+            .doesNotContain("<b onclick=");
+    }
+
+    @Test
+    @WithMockUser(username = "admin", roles = { "USER", "ADMIN" })
+    void testAdminPageRenders() throws Exception {
+        String html = mvc.perform(get("/admin/manager/domain/modify").param("id", "12"))
+            .andExpect(status().isOk())
+            .andReturn().getResponse().getContentAsString();
+        assertThat(html).contains("name=\"domainUserList[0].user.login\"")
+            .contains("name=\"_csrf\"")
+            .contains("<h2>PURL Server</h2>");
+    }
+
+    @Test
+    void testErrorPageRenders() throws Exception {
+        mvc.perform(get("/info/purl/does/not/exist").accept(MediaType.TEXT_HTML))
+            .andExpect(status().isNotFound());
+    }
+
+    @Test
+    void testMarkupDropsUnsafeElementsAndAttributes() {
+        List<MarkupNode> nodes = Markup.parse("<h2 onclick=\"x()\" class=\"c\">T &amp; &copy;</h2><script>alert(1)</script>"
+            + "<img src=x onerror=alert(1)><a href=\"javascript:alert(1)\">a</a>");
+        assertThat(nodes).hasSize(2);
+        assertThat(nodes.get(0).tag()).isEqualTo("h2");
+        assertThat(nodes.get(0).attrs()).containsOnlyKeys("class");
+        assertThat(nodes.get(0).children().get(0).text()).isEqualTo("T & ©");
+        assertThat(nodes.get(1).tag()).isEqualTo("a");
+    }
+}
