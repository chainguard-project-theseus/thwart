+ * limitations under the License.
+ */
+package de.uni.rostock.ub.purl_server.web;
+
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.autoconfigure.web.servlet.error.ErrorViewResolver;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Component;
+import org.springframework.web.servlet.ModelAndView;
+import org.springframework.web.servlet.support.RequestContextUtils;
+
+import jakarta.servlet.http.HttpServletRequest;
+
+/**
+ * Renders error pages with the template "error". Adds what the template shows that Boot's error attributes do not
+ * provide as view-safe values: the timestamp as text and the values of {@link ViewModelAdvice}.
+ */
+@Component
+public class ErrorPageViewResolver implements ErrorViewResolver {
+    @Value("${purl_server.web.html_fragment.title:#{null}}")
+    private String titleHtml;
+
+    @Value("${purl_server.web.html_fragment.footer:#{null}}")
+    private String footerHtml;
+
+    @Override
+    public ModelAndView resolveErrorView(HttpServletRequest request, HttpStatus status, Map<String, Object> model) {
+        Map<String, Object> m = new HashMap<>(model);
+        Object timestamp = model.get("timestamp");
+        m.put("timestampText", timestamp == null ? null : String.valueOf(timestamp));
+        Locale locale = RequestContextUtils.getLocale(request);
+        m.putIfAbsent("pageLang", locale.getLanguage());
+        m.putIfAbsent("pageLocale", locale.toString());
+        m.putIfAbsent("titleHtml", titleHtml);
+        m.putIfAbsent("footerHtml", footerHtml);
+        return new ModelAndView("error", m, status);
+    }
+}
diff --git a/src/main/java/de/uni/rostock/ub/purl_server/web/Markup.java b/src/main/java/de/uni/rostock/ub/purl_server/web/Markup.java
new file mode 100644
index 0000000..7f7fab6
--- /dev/null
+++ b/src/main/java/de/uni/rostock/ub/purl_server/web/Markup.java
@@ -0,0 +1,168 @@
+/*
+ * Copyright 2021 University Library, 18051 Rostock, Germany
+ *
+ * This file is part of the application "PURL Server".
+ * https://github.com/ubrostock/purl_server
+ * 
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package de.uni.rostock.ub.purl_server.web;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Parses HTML snippets (configured page title/footer, error messages from the message bundle) into a tree of
+ * allowlisted elements and text, so that templates can render them without raw HTML output.
+ *
+ * Elements that are not allowlisted are dropped, their content is kept as text; the content of script and style
+ * elements is dropped. Only allowlisted attributes are kept, and URL attributes are escaped by the template.
+ */
+@TemplateFunctions("markup")
+public final class Markup {
+    /** tags rendered by fragments/markup.html, keep both lists in sync */
+    static final Set<String> TAGS = Set.of("a", "b", "strong", "i", "em", "u", "small", "code", "span", "div", "p",
+        "h1", "h2", "h3", "h4", "h5", "h6", "hr", "br");
+
+    static final Set<String> VOID_TAGS = Set.of("hr", "br");
+
+    static final Set<String> DROP_CONTENT_TAGS = Set.of("script", "style", "template", "iframe", "object", "noscript");
+
+    static final Set<String> ATTRIBUTES = Set.of("class", "id", "title", "href");
+
+    private static final Pattern TAG = Pattern.compile("<(/?)([a-zA-Z][a-zA-Z0-9]*)((?:\\s+[^\\s/>=]+(?:\\s*=\\s*(?:\"[^\"]*\"|'[^']*'|[^\\s>]+))?)*)\\s*(/?)>");
+
+    private static final Pattern ATTR = Pattern.compile("([^\\s/>=]+)(?:\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+)))?");
+
+    private static final Pattern ENTITY = Pattern.compile("&(#[0-9]+|#[xX][0-9a-fA-F]+|[a-zA-Z]+);");
+
+    private static final Map<String, String> ENTITIES = Map.of("amp", "&", "lt", "<", "gt", ">", "quot", "\"",
+        "apos", "'", "nbsp", "\u00a0", "copy", "\u00a9", "reg", "\u00ae", "shy", "\u00ad");
+
+    private Markup() {
+    }
+
+    @TemplateFunction
+    public static List<MarkupNode> parse(String html) {
+        List<MarkupNode> root = new ArrayList<>();
+        if (html == null || html.isEmpty()) {
+            return root;
+        }
+        Deque<Element> open = new ArrayDeque<>();
+        open.push(new Element(null, null, root));
+        int dropDepth = 0;
+        String dropTag = null;
+        int pos = 0;
+        String rest = html.replaceAll("(?s)<!--.*?-->", "");
+        Matcher m = TAG.matcher(rest);
+        while (m.find()) {
+            if (dropDepth == 0) {
+                addText(open.peek().children, rest.substring(pos, m.start()));
+            }
+            pos = m.end();
+            boolean closing = !m.group(1).isEmpty();
+            String tag = m.group(2).toLowerCase(Locale.ROOT);
+            boolean selfClosing = !m.group(4).isEmpty();
+            if (dropDepth > 0) {
+                if (tag.equals(dropTag)) {
+                    dropDepth += closing ? -1 : (selfClosing ? 0 : 1);
+                }
+                continue;
+            }
+            if (DROP_CONTENT_TAGS.contains(tag)) {
+                if (!closing && !selfClosing) {
+                    dropTag = tag;
+                    dropDepth = 1;
+                }
+                continue;
+            }
+            if (!TAGS.contains(tag)) {
+                continue;
+            }
+            if (closing) {
+                if (open.stream().anyMatch(e -> tag.equals(e.tag))) {
+                    while (!tag.equals(open.peek().tag)) {
+                        open.pop();
+                    }
+                    open.pop();
+                }
+                continue;
+            }
+            List<MarkupNode> children = new ArrayList<>();
+            open.peek().children.add(new MarkupNode(tag, null, attributes(m.group(3)), children));
+            if (!selfClosing && !VOID_TAGS.contains(tag)) {
+                open.push(new Element(tag, null, children));
+            }
+        }
+        if (dropDepth == 0) {
+            addText(open.peek().children, rest.substring(pos));
+        }
+        return root;
+    }
+
+    private static Map<String, String> attributes(String source) {
+        Map<String, String> attrs = new HashMap<>();
+        Matcher m = ATTR.matcher(source);
+        while (m.find()) {
+            String name = m.group(1).toLowerCase(Locale.ROOT);
+            if (ATTRIBUTES.contains(name)) {
+                String value = m.group(2) != null ? m.group(2) : m.group(3) != null ? m.group(3) : m.group(4);
+                attrs.put(name, value == null ? "" : decode(value));
+            }
+        }
+        return attrs;
+    }
+
+    private static void addText(List<MarkupNode> target, String text) {
+        if (!text.isEmpty()) {
+            target.add(new MarkupNode(null, decode(text), Map.of(), List.of()));
+        }
+    }
+
+    static String decode(String text) {
+        Matcher m = ENTITY.matcher(text);
+        StringBuilder sb = new StringBuilder();
+        while (m.find()) {
+            String e = m.group(1);
+            String replacement;
+            try {
+                if (e.startsWith("#x") || e.startsWith("#X")) {
+                    replacement = new String(Character.toChars(Integer.parseInt(e.substring(2), 16)));
+                } else if (e.startsWith("#")) {
+                    replacement = new String(Character.toChars(Integer.parseInt(e.substring(1))));
+                } else {
+                    replacement = ENTITIES.getOrDefault(e, m.group());
+                }
+            } catch (IllegalArgumentException ex) {
+                replacement = m.group();
+            }
+            m.appendReplacement(sb, Matcher.quoteReplacement(replacement));
+        }
+        m.appendTail(sb);
+        return sb.toString();
+    }
+
+    private record Element(String tag, String text, List<MarkupNode> children) {
+    }
+}
