+package de.uni.rostock.ub.purl_server.web;
+
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayList;
+import java.util.List;
+
+import de.uni.rostock.ub.purl_server.model.Domain;
+import de.uni.rostock.ub.purl_server.model.DomainUser;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Template functions of the PURL server views.
+ */
+@TemplateFunctions("view")
+public final class ViewFunctions {
+    private ViewFunctions() {
+    }
+
+    /**
+     * Format an instant in the server's time zone (an {@link Instant} has no zone of its own).
+     */
+    @TemplateFunction
+    public static String format(Instant instant, String pattern) {
+        if (instant == null) {
+            return "";
+        }
+        return DateTimeFormatter.ofPattern(pattern).withZone(ZoneId.systemDefault()).format(instant);
+    }
+
+    /**
+     * The rows of the domain form's user table: one per domain user plus an empty one to add a user.
+     */
+    @TemplateFunction
+    public static List<DomainUserRow> domainUserRows(Domain domain) {
+        List<DomainUserRow> rows = new ArrayList<>();
+        List<DomainUser> users = domain.getDomainUserList();
+        for (int i = 0; i <= users.size(); i++) {
+            DomainUser du = i < users.size() ? users.get(i) : null;
+            if (du == null) {
+                rows.add(new DomainUserRow(i, null, false, false));
+            } else {
+                rows.add(new DomainUserRow(i, du.getUser() == null ? null : du.getUser().getLogin(),
+                    du.isCanCreate(), du.isCanModify()));
+            }
+        }
+        return rows;
+    }
+}
