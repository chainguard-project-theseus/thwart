+package de.uni.rostock.ub.purl_server.web;
+
+import java.util.Locale;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+
+/**
+ * Model values every page template needs (Tessera templates see only their model).
+ */
+@ControllerAdvice
+public class PageModelAdvice {
+    // the configurable HTML fragments for page title and footer (purl_server.web.html_fragment.*)
+    private static final HtmlPolicy FRAGMENT_POLICY = HtmlPolicy.builder()
+        .allowElements("h1", "h2", "h3", "h4", "h5", "h6", "p", "div", "span", "hr", "br", "b", "i", "strong", "em",
+            "small", "a", "img")
+        .allowAttributes("alt", "title")
