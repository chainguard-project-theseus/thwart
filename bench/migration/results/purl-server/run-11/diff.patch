+package de.uni.rostock.ub.purl_server.authentication;
+
+import java.util.Locale;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.context.MessageSource;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+import org.springframework.web.bind.annotation.RequestParam;
+
+/**
+ * Model values for the login and password pages, which the templates read from the request before.
+ */
+@ControllerAdvice(assignableTypes = LoginController.class)
+public class LoginModelAdvice {
+    private static final String KEY_PASSWORDS_DIFFERENT = "purl_server.error.validate.passwords_different";
+
+    @Autowired
+    private MessageSource messages;
+
+    @ModelAttribute("paramError")
+    public boolean paramError(@RequestParam(name = "error", required = false) String error) {
+        return isTrue(error);
+    }
+
+    @ModelAttribute("paramLogout")
+    public boolean paramLogout(@RequestParam(name = "logout", required = false) String logout) {
+        return isTrue(logout);
+    }
+
+    @ModelAttribute("paramToken")
+    public String paramToken(@RequestParam(name = "token", required = false) String token) {
+        return token;
+    }
+
+    @ModelAttribute("paramLogin")
+    public String paramLogin(@RequestParam(name = "login", required = false) String login) {
+        return login;
+    }
+
+    @ModelAttribute("passwordsDifferentMessage")
+    public String passwordsDifferentMessage(Locale locale) {
+        // a missing key is shown as Thymeleaf did it
+        return messages.getMessage(KEY_PASSWORDS_DIFFERENT, null, "??" + KEY_PASSWORDS_DIFFERENT + "_" + locale + "??",
+            locale);
+    }
+
+    // a request parameter is "true" in a condition unless it is missing or "false", "off" or "no"
+    private static boolean isTrue(String value) {
+        return value != null && !"false".equalsIgnoreCase(value) && !"off".equalsIgnoreCase(value)
+            && !"no".equalsIgnoreCase(value);
+    }
+}
