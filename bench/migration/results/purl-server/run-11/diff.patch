+        .build();
+
+    @Value("${purl_server.web.html_fragment.title:}")
+    private String htmlFragmentTitle;
+
+    @Value("${purl_server.web.html_fragment.footer:}")
+    private String htmlFragmentFooter;
+
+    @ModelAttribute("pageLang")
+    public String pageLang(Locale locale) {
+        return locale.getLanguage();
+    }
+
+    @ModelAttribute("pageLocale")
+    public String pageLocale(Locale locale) {
+        return locale.toString();
+    }
+
+    @ModelAttribute("titleHtml")
+    public SafeHtml titleHtml() {
+        return SafeHtml.sanitize(htmlFragmentTitle, FRAGMENT_POLICY);
+    }
+
+    @ModelAttribute("footerHtml")
+    public SafeHtml footerHtml() {
+        return SafeHtml.sanitize(htmlFragmentFooter, FRAGMENT_POLICY);
+    }
+}
