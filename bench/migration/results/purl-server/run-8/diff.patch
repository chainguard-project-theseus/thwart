+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package de.uni.rostock.ub.purl_server.web;
+
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.format.DateTimeFormatter;
+import java.util.Arrays;
+import java.util.List;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Formatting functions for the Tessera templates ({@code fmt.*}).
+ */
+@TemplateFunctions("fmt")
+public final class TemplateFormat {
+    private static final DateTimeFormatter DATE_TIME = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");
+
+    private TemplateFormat() {
+    }
+
+    /**
+     * Format an instant as "yyyy-MM-dd HH:mm" in the server's time zone (as Thymeleaf's #temporals did).
+     */
+    @TemplateFunction
+    public static String dateTime(Instant instant) {
+        return instant == null ? "" : DATE_TIME.format(instant.atZone(ZoneId.systemDefault()));
+    }
+
+    /**
+     * Split a message that was built with "&lt;br /&gt;" line breaks into its lines, so the template can print each
+     * line escaped.
+     */
+    @TemplateFunction
+    public static List<String> lines(String text) {
+        return text == null ? List.of() : Arrays.asList(text.split("<br />", -1));
+    }
+}
