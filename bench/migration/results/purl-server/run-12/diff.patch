+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package de.uni.rostock.ub.purl_server.web;
+
+import java.util.Locale;
+
+import org.springframework.core.env.Environment;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+
+/**
+ * Provides the model attribute "page" for the page layout of all views.
+ */
+@ControllerAdvice
+public class PageModelAdvice {
+    public static final String MODEL_ATTRIBUTE_PAGE = "page";
+
+    // markup allowed in the configurable HTML fragments (purl_server.web.html_fragment.*)
+    private static final HtmlPolicy FRAGMENT_POLICY = HtmlPolicy.builder()
+        .allowElements("h1", "h2", "h3", "h4", "h5", "h6", "p", "div", "span", "hr", "br", "b", "i", "em", "strong",
+            "small", "a", "img")
+        .allowAttributes("title", "alt")
+        .allowClasses("m-*", "mt-*", "mb-*", "ms-*", "me-*", "mx-*", "my-*", "p-*", "pt-*", "pb-*", "ps-*", "pe-*",
+            "px-*", "py-*", "text-*", "fs-*", "fw-*", "float-*", "d-*", "col", "col-*", "row")
+        .build();
+
+    private final Environment environment;
+
+    public PageModelAdvice(Environment environment) {
+        this.environment = environment;
+    }
+
+    @ModelAttribute(MODEL_ATTRIBUTE_PAGE)
+    public PageInfo page(Locale locale) {
+        return new PageInfo(locale.getLanguage(), locale.toString(),
+            fragment("purl_server.web.html_fragment.title"), fragment("purl_server.web.html_fragment.footer"));
+    }
+
+    private SafeHtml fragment(String property) {
+        String html = environment.getProperty(property);
+        return html == null ? null : SafeHtml.sanitize(html, FRAGMENT_POLICY);
+    }
+}
diff --git a/src/main/java/de/uni/rostock/ub/purl_server/web/ViewFunctions.java b/src/main/java/de/uni/rostock/ub/purl_server/web/ViewFunctions.java
