+package de.uni.rostock.ub.purl_server.web;
+
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.Locale;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Template functions for the views
+ */
+@TemplateFunctions("views")
+public final class ViewFunctions {
+    // the format of java.util.Date.toString()
+    private static final DateTimeFormatter DATE_TO_STRING = DateTimeFormatter
+        .ofPattern("EEE MMM dd HH:mm:ss zzz yyyy", Locale.US);
+
+    private static final DateTimeFormatter DATE_TIME = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");
+
+    private ViewFunctions() {
+    }
+
+    /**
+     * formats a timestamp as java.util.Date.toString() does (used by the error page)
+     */
+    @TemplateFunction
+    public static String timestamp(ZonedDateTime timestamp) {
+        return timestamp == null ? null
+            : DATE_TO_STRING.format(timestamp.withZoneSameInstant(ZoneId.systemDefault()));
+    }
+
+    /**
+     * formats an instant as "yyyy-MM-dd HH:mm" in the default time zone
+     */
+    @TemplateFunction
+    public static String dateTime(Instant instant) {
+        return instant == null ? null : DATE_TIME.format(instant.atZone(ZoneId.systemDefault()));
+    }
+}
