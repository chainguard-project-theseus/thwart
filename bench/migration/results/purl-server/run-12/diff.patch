+package de.uni.rostock.ub.purl_server.test;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.hamcrest.Matchers;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.security.test.context.support.WithMockUser;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.web.servlet.MockMvc;
+
+/**
+ * renders the HTML views through the real view resolver
+ */
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.MOCK)
+@ActiveProfiles("test")
+@AutoConfigureMockMvc
+public class ViewRenderingTest {
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Test
+    public void renderIndexAnonymous() throws Exception {
+        mockMvc.perform(get("/"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(Matchers.containsString("<h2>PURL Server</h2>")))
+            .andExpect(content().string(Matchers.containsString("href=\"/admin/login\"")))
+            .andExpect(content().string(Matchers.not(Matchers.containsString("navbar-brand"))));
+    }
+
+    @Test
+    public void renderLoginWithError() throws Exception {
+        mockMvc.perform(get("/admin/login").param("error", ""))
+            .andExpect(status().isOk())
+            .andExpect(content().string(Matchers.containsString("alert-danger")))
+            .andExpect(content().string(Matchers.containsString("name=\"_csrf\"")));
+    }
+
+    @Test
+    public void renderPurlInfo() throws Exception {
+        mockMvc.perform(get("/info/purl/test/test123/suffix").accept(MediaType.TEXT_HTML))
+            .andExpect(status().isOk())
+            .andExpect(content().string(Matchers.containsString("/test/test123")))
+            .andExpect(content().string(Matchers.containsString("/suffix")));
+    }
+
+    @Test
+    public void renderDomainInfo() throws Exception {
+        mockMvc.perform(get("/info/domain/test").accept(MediaType.TEXT_HTML))
+            .andExpect(status().isOk())
+            .andExpect(content().string(Matchers.containsString("Test Domain")));
+    }
+
+    @Test
+    @WithMockUser(username = "admin", roles = { "USER", "ADMIN" })
+    public void renderDomainCreateForm() throws Exception {
+        mockMvc.perform(get("/admin/manager/domain/create"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(Matchers.containsString("name=\"domainUserList[0].user.login\"")))
+            .andExpect(content().string(Matchers.containsString("id=\"dropdownCreateDomain\"")));
+    }
+
+    @Test
+    @WithMockUser(username = "user1", roles = { "USER" })
+    public void renderPurlSearchAsUser() throws Exception {
+        mockMvc.perform(get("/admin/manager/purl/search"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(Matchers.containsString("value=\"user1\"")))
+            .andExpect(content().string(Matchers.not(Matchers.containsString("id=\"dropdownCreateDomain\""))));
+    }
+}
