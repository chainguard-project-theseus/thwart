+package de.uni.rostock.ub.purl_server.web;
+
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.TemplateView;
+
+/**
+ * Values every page layout needs: the locale and the configurable HTML fragments
+ */
+@TemplateView
+public class PageInfo {
+    private final String lang;
+
+    private final String locale;
+
+    private final SafeHtml titleHtml;
+
+    private final SafeHtml footerHtml;
+
+    public PageInfo(String lang, String locale, SafeHtml titleHtml, SafeHtml footerHtml) {
+        this.lang = lang;
+        this.locale = locale;
+        this.titleHtml = titleHtml;
+        this.footerHtml = footerHtml;
+    }
+
+    /** the language of the current locale, e.g. "de" */
+    public String getLang() {
+        return lang;
+    }
+
+    /** the current locale as string, e.g. "de" or "en" */
+    public String getLocale() {
+        return locale;
+    }
+
+    public SafeHtml getTitleHtml() {
+        return titleHtml;
+    }
+
+    public SafeHtml getFooterHtml() {
+        return footerHtml;
+    }
+}
diff --git a/src/main/java/de/uni/rostock/ub/purl_server/web/PageModelAdvice.java b/src/main/java/de/uni/rostock/ub/purl_server/web/PageModelAdvice.java
