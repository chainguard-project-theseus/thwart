+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package de.uni.rostock.ub.purl_server.web;
+
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.Date;
+import java.util.Locale;
+
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Template functions for the PURL Server pages
+ */
+@TemplateFunctions("site")
+public final class SiteFunctions {
+    /**
+     * markup allowed in the configurable HTML fragments (purl_server.web.html_fragment.*)
+     */
+    private static final HtmlPolicy SITE_FRAGMENT_POLICY = HtmlPolicy.builder()
+        .allowElements("h1", "h2", "h3", "h4", "h5", "h6", "p", "br", "hr", "b", "i", "em", "strong", "small",
+            "span", "div", "a")
+        .allowClasses("m-*", "mb-*", "mt-*", "ms-*", "me-*", "my-*", "mx-*", "p-*", "pb-*", "pt-*", "ps-*", "pe-*",
+            "text-*", "fw-*", "fst-*", "h1", "h2", "h3", "h4", "h5", "h6", "small")
+        .linkRel()
+        .build();
+
+    private static final DateTimeFormatter DATE_TIME_FORMATTER = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");
+
+    private SiteFunctions() {
+    }
+
+    /**
+     * @return the language of the current locale (e.g. "de")
+     */
+    @TemplateFunction
+    public static String lang(Locale locale) {
+        return locale.getLanguage();
+    }
+
+    /**
+     * @return true, if the current locale is English
+     */
+    @TemplateFunction
+    public static boolean en(Locale locale) {
+        return "en".equals(locale.toString());
+    }
+
+    /**
+     * sanitize a configurable HTML fragment (title, footer) or an error message
+     */
+    @TemplateFunction
+    public static SafeHtml html(Object text) {
+        return SafeHtml.sanitize(text == null ? null : text.toString(), SITE_FRAGMENT_POLICY);
+    }
+
+    /**
+     * format an instant as "yyyy-MM-dd HH:mm" in the default time zone
+     */
+    @TemplateFunction
+    public static String dateTime(Instant instant) {
+        return instant == null ? "" : DATE_TIME_FORMATTER.format(ZonedDateTime.ofInstant(instant, ZoneId.systemDefault()));
+    }
+
+    /**
+     * format a timestamp as java.util.Date.toString() did
+     */
+    @TemplateFunction
+    public static String timestamp(ZonedDateTime timestamp) {
+        return timestamp == null ? "" : Date.from(timestamp.toInstant()).toString();
+    }
+}
