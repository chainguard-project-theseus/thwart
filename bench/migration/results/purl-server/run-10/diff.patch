+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package de.uni.rostock.ub.purl_server.web;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import jakarta.servlet.http.HttpServletRequest;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.autoconfigure.web.servlet.error.ErrorViewResolver;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Component;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ModelAttribute;
+import org.springframework.web.servlet.ModelAndView;
+
+/**
+ * Provides the configurable HTML fragments (title, footer) to every page, including the error page.
+ */
+@ControllerAdvice
+@Component
+public class SiteModelAdvice implements ErrorViewResolver {
+    public static final String MODEL_ATTRIBUTE_SITE_TITLE = "siteTitle";
+
+    public static final String MODEL_ATTRIBUTE_SITE_FOOTER = "siteFooter";
+
+    @Value("${purl_server.web.html_fragment.title:}")
+    private String siteTitle;
+
+    @Value("${purl_server.web.html_fragment.footer:}")
+    private String siteFooter;
+
+    @ModelAttribute(MODEL_ATTRIBUTE_SITE_TITLE)
+    public String siteTitle() {
+        return siteTitle;
+    }
+
+    @ModelAttribute(MODEL_ATTRIBUTE_SITE_FOOTER)
+    public String siteFooter() {
+        return siteFooter;
+    }
+
+    @Override
+    public ModelAndView resolveErrorView(HttpServletRequest request, HttpStatus status, Map<String, Object> model) {
+        Map<String, Object> errorModel = new HashMap<>(model);
+        errorModel.put(MODEL_ATTRIBUTE_SITE_TITLE, siteTitle);
+        errorModel.put(MODEL_ATTRIBUTE_SITE_FOOTER, siteFooter);
+        return new ModelAndView("error", errorModel);
+    }
+}
