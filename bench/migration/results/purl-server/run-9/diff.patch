+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package de.uni.rostock.ub.purl_server.web;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+import org.jsoup.Jsoup;
+import org.jsoup.nodes.Element;
+import org.jsoup.nodes.Node;
+import org.jsoup.nodes.TextNode;
+
+import dev.tessera.runtime.TemplateView;
+
+/**
+ * A node of a configured HTML snippet (e.g. purl_server.web.html_fragment.title),
+ * parsed in Java and rendered by the template fragments/html :: nodes.
+ * Only an allowlist of elements and attributes survives; the template escapes everything.
+ */
+@TemplateView
+public class HtmlNode {
+    static final Set<String> TAGS = Set.of("h1", "h2", "h3", "h4", "h5", "h6", "p", "div", "span", "hr", "br", "b",
+        "i", "em", "strong", "small", "u", "a", "img");
+
+    private final String tag;
+
+    private final String text;
+
+    private final String cls;
+
+    private final String id;
+
+    private final String title;
+
+    private final String href;
+
+    private final String src;
+
+    private final String alt;
+
+    private final List<HtmlNode> children;
+
+    private HtmlNode(String tag, String text, Element e, List<HtmlNode> children) {
+        this.tag = tag;
+        this.text = text;
+        this.cls = attr(e, "class");
+        this.id = attr(e, "id");
+        this.title = attr(e, "title");
+        this.href = attr(e, "href");
+        this.src = attr(e, "src");
+        this.alt = attr(e, "alt");
+        this.children = children;
+    }
+
+    private static String attr(Element e, String name) {
+        return e != null && e.hasAttr(name) ? e.attr(name) : null;
+    }
+
+    /**
+     * Parse an HTML snippet into a list of nodes
+     * @param html the snippet, may be null
+     * @return the nodes, never null
+     */
+    public static List<HtmlNode> parse(String html) {
+        if (html == null) {
+            return List.of();
+        }
+        return convert(Jsoup.parseBodyFragment(html).body().childNodes());
+    }
+
+    private static List<HtmlNode> convert(List<Node> nodes) {
+        List<HtmlNode> result = new ArrayList<>();
+        for (Node n : nodes) {
+            if (n instanceof TextNode t) {
+                result.add(new HtmlNode(null, t.getWholeText(), null, List.of()));
+            } else if (n instanceof Element e) {
+                List<HtmlNode> children = convert(e.childNodes());
+                if (TAGS.contains(e.normalName())) {
+                    result.add(new HtmlNode(e.normalName(), null, e, children));
+                } else {
+                    result.addAll(children);
+                }
+            }
+        }
+        return result;
+    }
+
+    public String getTag() {
+        return tag;
+    }
+
+    public String getText() {
+        return text;
+    }
+
+    public String getCls() {
+        return cls;
+    }
+
+    public String getId() {
+        return id;
+    }
+
+    public String getTitle() {
+        return title;
+    }
+
+    public String getHref() {
+        return href;
+    }
+
+    public String getSrc() {
+        return src;
+    }
+
+    public String getAlt() {
+        return alt;
+    }
+
+    public List<HtmlNode> getChildren() {
+        return children;
+    }
+}
