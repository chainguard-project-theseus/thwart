diff --git a/src/main/templates/pets/createOrUpdatePetForm.html b/src/main/templates/pets/createOrUpdatePetForm.html
new file mode 100644
index 0000000..5053862
--- /dev/null
+++ b/src/main/templates/pets/createOrUpdatePetForm.html
@@ -0,0 +1,40 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="org.springframework.samples.petclinic.model.*, org.springframework.samples.petclinic.web.CurrentRequest"
+      t:params="Pet pet, Collection<PetType> types, CurrentRequest currentRequest"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::script})}">
+<head>
+    <script>
+        $(function () {
+            $("#birthDate").datepicker({dateFormat: 'yy/mm/dd'});
+        });
+    </script>
+</head>
+<body t:remove="tag">
+    <h2>
+        <t:block t:if="pet.isNew()">New </t:block> Pet
+    </h2>
+    <form t:object="pet" t:action="currentRequest.uri" method="post" class="form-horizontal" id="pet">
+        <input type="hidden" name="id" t:value="pet.id == null ? '' : '' + pet.id"/>
+        <div class="form-group has-feedback">
+            <div class="form-group">
+                <label class="col-sm-2 control-label">Owner</label>
+                <div class="col-sm-10">
+                    [[${pet.owner?.firstName}]] [[${pet.owner?.lastName}]]
+                </div>
+            </div>
+            <div t:replace="~{fragments/fields :: input('Name', 'name', !strings.isEmpty(pet.name))}"></div>
+            <div t:replace="~{fragments/fields :: input('Birth Date', 'birthDate', pet.birthDate != null)}"></div>
+            <div class="control-group">
+                <div t:replace="~{fragments/fields :: select('Type ', 'type', types, '5', pet.type != null)}"></div>
+            </div>
+        </div>
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <button t:if="pet.isNew()" class="btn btn-default" type="submit">Add Pet</button>
+                <button t:unless="pet.isNew()" class="btn btn-default" type="submit">Update Pet</button>
+            </div>
+        </div>
+    </form>
+</body>
+</html>
diff --git a/src/main/templates/pets/createOrUpdateVisitForm.html b/src/main/templates/pets/createOrUpdateVisitForm.html
new file mode 100644
index 0000000..efc0c35
--- /dev/null
+++ b/src/main/templates/pets/createOrUpdateVisitForm.html
@@ -0,0 +1,63 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="org.springframework.samples.petclinic.model.Visit, org.springframework.samples.petclinic.web.CurrentRequest"
+      t:params="Visit visit, CurrentRequest currentRequest"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::script})}">
+<head>
+    <script>
+        $(function () {
+            $("#date").datepicker({dateFormat: 'yy/mm/dd'});
+        });
+    </script>
+</head>
+<body t:remove="tag">
+    <h2><t:block t:if="visit.isNew()">New </t:block>Visit</h2>
+
+    <span id="pet"><strong>Pet</strong></span>
+    <table class="table table-striped" aria-describedby="pet">
+        <thead>
+        <tr>
+            <th scope="col">Name</th>
+            <th scope="col">Birth Date</th>
+            <th scope="col">Type</th>
+            <th scope="col">Owner</th>
+        </tr>
+        </thead>
+        <tr>
+            <td t:text="visit.pet.name">Leo</td>
+            <td t:text="temporals.format(visit.pet.birthDate, 'yyyy/MM/dd')">2010/09/07</td>
+            <td t:text="visit.pet.type?.name">cat</td>
+            <td>[[${visit.pet.owner?.firstName}]] [[${visit.pet.owner?.lastName}]]</td>
+        </tr>
+    </table>
+
+    <form t:object="visit" t:action="currentRequest.uri" method="post" class="form-horizontal" id="visit">
+        <div class="form-group has-feedback">
+            <div t:replace="~{fragments/fields :: input('Date', 'date', visit.date != null)}"></div>
+            <div t:replace="~{fragments/fields :: input('Description', 'description', !strings.isEmpty(visit.description))}"></div>
+        </div>
+
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <input type="hidden" name="petId" t:value="visit.pet.id == null ? '' : '' + visit.pet.id"/>
+                <button class="btn btn-default" type="submit">Add Visit</button>
+            </div>
+        </div>
+    </form>
+
+    <br/>
+    <strong id="previousVisits">Previous Visits</strong>
+    <table class="table table-striped" aria-describedby="previousVisits">
+        <tr>
+            <th scope="col">Date</th>
+            <th scope="col">Description</th>
+        </tr>
+        <t:block t:each="previous : visit.pet.visits">
+            <tr t:unless="previous.isNew()">
+                <td t:text="temporals.format(previous.date, 'yyyy/MM/dd')">2013/01/01</td>
+                <td t:text="previous.description">rabies shot</td>
+            </tr>
+        </t:block>
+    </table>
+</body>
+</html>
