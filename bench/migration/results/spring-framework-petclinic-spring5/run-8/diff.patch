+package org.springframework.samples.petclinic.web;
+
+import dev.tessera.runtime.TemplateView;
+
+/**
+ * The URL of the current request, as Spring's form tag used it for a form's default action.
+ * <p>
+ * Deliberately not a simple value type, so that {@code RedirectView} never exposes it as a query parameter.
+ */
+@TemplateView
+public class CurrentRequest {
+
+    private final String uri;
+
+    public CurrentRequest(String uri) {
+        this.uri = uri;
+    }
+
+    /**
+     * The originating request URI (including the context path) and query string.
+     */
+    public String getUri() {
+        return this.uri;
+    }
+
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/web/CurrentRequestAdvice.java b/src/main/java/org/springframework/samples/petclinic/web/CurrentRequestAdvice.java
