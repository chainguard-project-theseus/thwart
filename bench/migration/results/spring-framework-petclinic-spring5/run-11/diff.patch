diff --git a/src/main/java/org/springframework/samples/petclinic/web/MissingViewResolver.java b/src/main/java/org/springframework/samples/petclinic/web/MissingViewResolver.java
new file mode 100644
index 0000000..affc18d
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/web/MissingViewResolver.java
@@ -0,0 +1,40 @@
+package org.springframework.samples.petclinic.web;
+
+import java.util.Locale;
+import java.util.Map;
+
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+
+import org.springframework.core.Ordered;
+import org.springframework.web.servlet.View;
+import org.springframework.web.servlet.ViewResolver;
+
+/**
+ * Last view resolver in the chain: a view name that no template provides (for example
+ * "visitList") answers 404 Not Found, as the JSP resolver did for a missing JSP file, instead of
+ * failing with a 500 "Could not resolve view".
+ */
+public class MissingViewResolver implements ViewResolver, Ordered {
+
+    @Override
+    public View resolveViewName(String viewName, Locale locale) {
+        return new View() {
+            @Override
+            public String getContentType() {
+                return null;
+            }
+
+            @Override
+            public void render(Map<String, ?> model, HttpServletRequest request, HttpServletResponse response) throws Exception {
+                response.sendError(HttpServletResponse.SC_NOT_FOUND);
+            }
+        };
+    }
+
+    @Override
+    public int getOrder() {
+        return Ordered.LOWEST_PRECEDENCE;
+    }
+
+}
