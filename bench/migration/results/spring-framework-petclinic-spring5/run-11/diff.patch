+<t:block xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.PetType">
+
+    <!--/* Text input bound to a property of the form object; the label turns red when the value is invalid */-->
+    <div t:fragment="inputField(String label, Field name)"
+         t:class="fields.hasErrors(name) ? 'form-group has-error' : 'form-group '">
