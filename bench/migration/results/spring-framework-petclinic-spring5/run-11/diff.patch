+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="org.springframework.samples.petclinic.model.Vets"
+      t:params="Vets vets"
+      t:replace="~{fragments/layout :: layout('vets', ~{::body}, null)}">
+<body t:remove="tag">
+    <h2 id="veterinarians">Veterinarians</h2>
+
+    <div class="row">
+        <table id="vetsTable" class="table table-striped" aria-describedby="veterinarians">
+            <thead>
+            <tr>
+                <th scope="col">Name</th>
+                <th scope="col">Specialties</th>
+            </tr>
+            </thead>
+            <tbody>
+            <tr t:each="vet : vets.vetList">
+                <td t:text="|${vet.firstName ?: ''} ${vet.lastName ?: ''}|">James Carter</td>
+                <td>
+                    <t:block t:each="specialty : vet.specialties" t:text="|${specialty.name ?: ''} |">radiology</t:block>
+                    <t:block t:if="vet.nrOfSpecialties == 0">none</t:block>
+                </td>
+            </tr>
+            </tbody>
+        </table>
+    </div>
+
+    <div class="row">
+        <div class="col-md-2">
+            <a t:href="@{/vets.xml}">View as XML</a>
+        </div>
+        <div class="col-md-2">
+            <a t:href="@{/vets.json}">View as JSON</a>
+        </div>
+    </div>
+</body>
+</html>
