@@ -0,0 +1,24 @@
+package org.springframework.samples.petclinic.web;
+
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.web.servlet.ModelAndView;
+import org.springframework.web.servlet.handler.SimpleMappingExceptionResolver;
+
+/**
+ * {@link SimpleMappingExceptionResolver} that also exposes the exception message as a plain
+ * {@code String} model attribute ("exceptionMessage"), since the error template can only read
+ * view-safe values and not the {@code Exception} itself.
+ */
+public class PetclinicExceptionResolver extends SimpleMappingExceptionResolver {
+
+    public static final String EXCEPTION_MESSAGE_ATTRIBUTE = "exceptionMessage";
+
+    @Override
+    protected ModelAndView getModelAndView(String viewName, Exception ex, HttpServletRequest request) {
+        ModelAndView mv = super.getModelAndView(viewName, ex, request);
+        mv.addObject(EXCEPTION_MESSAGE_ATTRIBUTE, ex.getMessage());
+        return mv;
+    }
+
+}
