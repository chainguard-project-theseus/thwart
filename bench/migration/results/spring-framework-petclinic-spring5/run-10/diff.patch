diff --git a/src/main/resources/templates/pets/createOrUpdatePetForm.html b/src/main/resources/templates/pets/createOrUpdatePetForm.html
new file mode 100644
index 0000000..5b1a855
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdatePetForm.html
@@ -0,0 +1,48 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.*"
+      t:params="Pet pet, Collection<PetType> types, Integer ownerId"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::custom-script})}">
+<custom-script t:remove="tag">
+    <script>
+        $(function () {
+            $("#birthDate").datepicker({dateFormat: 'yy/mm/dd'});
+        });
+    </script>
+</custom-script>
+<t:block t:fragment="petFormBody(Pet pet, Collection<PetType> types)" t:object="pet">
+    <input type="hidden" name="id" t:value="pet.id == null ? '' : '' + pet.id"/>
+    <div class="form-group has-feedback">
+        <div class="form-group">
+            <label class="col-sm-2 control-label">Owner</label>
+            <div class="col-sm-10"
+                 t:text="pet.owner == null ? '' : pet.owner.firstName + ' ' + pet.owner.lastName">George Franklin</div>
+        </div>
+        <div t:replace="~{fragments/fields :: inputField('Name', 'name')}"></div>
+        <div t:replace="~{fragments/fields :: inputField('Birth Date', 'birthDate')}"></div>
+        <div class="control-group">
+            <div t:replace="~{fragments/fields :: selectField('Type ', 'type', types)}"></div>
+        </div>
+    </div>
+    <div class="form-group">
+        <div class="col-sm-offset-2 col-sm-10">
+            <button t:if="pet.isNew()" class="btn btn-default" type="submit">Add Pet</button>
+            <button t:unless="pet.isNew()" class="btn btn-default" type="submit">Update Pet</button>
+        </div>
+    </div>
+</t:block>
+<body t:remove="tag">
+    <h2>
+        <t:block t:if="pet.isNew()">New </t:block> Pet
+    </h2>
+    <!--/* posts back to the URL the form was requested from */-->
+    <t:block t:if="pet.isNew()">
+        <form id="pet" class="form-horizontal" method="post" t:action="@{/owners/{ownerId}/pets/new(ownerId=ownerId)}"
+              t:insert="~{::petFormBody(pet, types)}"></form>
+    </t:block>
+    <t:block t:unless="pet.isNew()">
+        <form id="pet" class="form-horizontal" method="post"
+              t:action="@{/owners/{ownerId}/pets/{petId}/edit(ownerId=ownerId, petId=pet.id)}"
+              t:insert="~{::petFormBody(pet, types)}"></form>
+    </t:block>
+</body>
+</html>
diff --git a/src/main/resources/templates/pets/createOrUpdateVisitForm.html b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
new file mode 100644
index 0000000..8e99bac
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
@@ -0,0 +1,63 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.Visit" t:params="Visit visit"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::custom-script})}">
+<custom-script t:remove="tag">
+    <script>
+        $(function () {
+            $("#date").datepicker({dateFormat: 'yy/mm/dd'});
+        });
+    </script>
+</custom-script>
+<body t:remove="tag">
+    <h2><t:block t:if="visit.isNew()">New </t:block>Visit</h2>
+
+    <span id="pet"><strong>Pet</strong></span>
+    <table class="table table-striped" aria-describedby="pet">
+        <thead>
+        <tr>
+            <th scope="col">Name</th>
+            <th scope="col">Birth Date</th>
+            <th scope="col">Type</th>
+            <th scope="col">Owner</th>
+        </tr>
+        </thead>
+        <tr>
+            <td t:text="visit.pet.name">Leo</td>
+            <td t:text="temporals.format(visit.pet.birthDate, 'yyyy/MM/dd')">2010/09/07</td>
+            <td t:text="visit.pet.type?.name">cat</td>
+            <td t:text="|${visit.pet.owner.firstName} ${visit.pet.owner.lastName}|">George Franklin</td>
+        </tr>
+    </table>
+
+    <!--/* posts back to the URL the form was requested from */-->
+    <form t:object="visit" id="visit" class="form-horizontal" method="post"
+          t:action="@{/owners/{ownerId}/pets/{petId}/visits/new(ownerId=visit.pet.owner.id, petId=visit.pet.id)}">
+        <div class="form-group has-feedback">
+            <div t:replace="~{fragments/fields :: inputField('Date', 'date')}"></div>
+            <div t:replace="~{fragments/fields :: inputField('Description', 'description')}"></div>
+        </div>
+
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <input type="hidden" name="petId" t:value="visit.pet.id"/>
+                <button class="btn btn-default" type="submit">Add Visit</button>
+            </div>
+        </div>
+    </form>
+
+    <br/>
+    <strong id="previousVisits">Previous Visits</strong>
+    <table class="table table-striped" aria-describedby="previousVisits">
+        <tr>
+            <th scope="col">Date</th>
+            <th scope="col">Description</th>
+        </tr>
+        <t:block t:each="v : visit.pet.visits">
+            <tr t:if="!v.isNew()">
+                <td t:text="temporals.format(v.date, 'yyyy/MM/dd')">2013/01/01</td>
+                <td t:text="v.description">rabies shot</td>
+            </tr>
+        </t:block>
+    </table>
+</body>
+</html>
