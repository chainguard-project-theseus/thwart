diff --git a/src/test/java/org/springframework/samples/petclinic/web/TemplateRenderingTests.java b/src/test/java/org/springframework/samples/petclinic/web/TemplateRenderingTests.java
new file mode 100644
index 0000000..d50165e
--- /dev/null
+++ b/src/test/java/org/springframework/samples/petclinic/web/TemplateRenderingTests.java
@@ -0,0 +1,110 @@
+package org.springframework.samples.petclinic.web;
+
+import org.assertj.core.util.Lists;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.model.Pet;
+import org.springframework.samples.petclinic.model.PetType;
+import org.springframework.samples.petclinic.service.ClinicService;
+import org.springframework.test.context.junit.jupiter.web.SpringJUnitWebConfig;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.context.WebApplicationContext;
+
+import java.time.LocalDate;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+/**
+ * Renders pages through the application's real view resolvers (the Tessera templates), unlike the controller
+ * tests, which use a standalone setup and never render a view.
+ */
+@SpringJUnitWebConfig(locations = {"classpath:spring/mvc-test-config.xml", "classpath:spring/mvc-core-config.xml"})
+class TemplateRenderingTests {
+
+    private static final int TEST_OWNER_ID = 1;
+
+    @Autowired
+    private WebApplicationContext context;
+
+    @Autowired
+    private ClinicService clinicService;
+
+    private MockMvc mockMvc;
+
+    @BeforeEach
+    void setup() {
+        this.mockMvc = MockMvcBuilders.webAppContextSetup(context).build();
+
+        Owner owner = new Owner();
+        owner.setId(TEST_OWNER_ID);
+        owner.setFirstName("<script>alert(1)</script>");
+        owner.setLastName("Franklin");
+        owner.setAddress("110 W. Liberty St.");
+        owner.setCity("Madison");
+        owner.setTelephone("6085551023");
+        PetType cat = new PetType();
+        cat.setId(1);
+        cat.setName("cat");
+        Pet pet = new Pet();
+        pet.setId(1);
+        pet.setName("<b>Leo</b>");
+        pet.setBirthDate(LocalDate.of(2010, 9, 7));
+        pet.setType(cat);
+        owner.addPet(pet);
+        given(this.clinicService.findOwnerById(TEST_OWNER_ID)).willReturn(owner);
+        given(this.clinicService.findOwnerByLastName("")).willReturn(Lists.newArrayList(owner, new Owner()));
+        given(this.clinicService.findPetTypes()).willReturn(Lists.newArrayList(cat));
+    }
+
+    @Test
+    void ownerDetailsEscapesUserData() throws Exception {
+        mockMvc.perform(get("/owners/{ownerId}", TEST_OWNER_ID))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("&lt;script&gt;alert(1)&lt;/script&gt; Franklin")))
+            .andExpect(content().string(containsString("&lt;b&gt;Leo&lt;/b&gt;")))
+            .andExpect(content().string(containsString("2010-09-07")))
+            .andExpect(content().string(containsString("href=\"/owners/1/pets/1/edit\"")))
+            .andExpect(content().string(not(containsString("<script>alert(1)"))));
+    }
+
+    @Test
+    void ownerFormShowsValidationErrors() throws Exception {
+        mockMvc.perform(post("/owners/new").param("firstName", "Joe").param("lastName", "<i>Bloggs</i>"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("action=\"/owners/new\"")))
+            .andExpect(content().string(containsString("value=\"&lt;i&gt;Bloggs&lt;/i&gt;\"")))
+            .andExpect(content().string(containsString("form-group has-error")))
+            .andExpect(content().string(not(containsString("<i>Bloggs"))));
+    }
+
+    @Test
+    void petFormSelectsBoundType() throws Exception {
+        mockMvc.perform(post("/owners/{ownerId}/pets/new", TEST_OWNER_ID).param("name", "").param("type", "cat"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("action=\"/owners/1/pets/new\"")))
+            .andExpect(content().string(containsString("is required")));
+    }
+
+    @Test
+    void errorPageShowsExceptionMessage() throws Exception {
+        mockMvc.perform(get("/oups"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("Something happened...")))
+            .andExpect(content().string(containsString("Expected: controller used to showcase what happens")));
+    }
+
+    @Test
+    void welcomePageUsesMessages() throws Exception {
+        mockMvc.perform(get("/"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("<h2>Welcome</h2>")));
+    }
+}
