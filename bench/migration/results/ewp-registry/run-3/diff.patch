@@ -0,0 +1,57 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.view.*, eu.erasmuswithoutpaper.registry.updater.*, eu.erasmuswithoutpaper.registry.notifier.*"
+      t:params="PageCommons page, String manifestUrl, ManifestUpdateStatus manifestStatus, boolean sourcePresent"
+      t:replace="~{fragments/toolbar :: toolbar(page, 'Manifest Status Report', null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifest Status Report</h2>
+
+        <p class='ewp-para'>Manifest URL:
+        <code class='ewpst__bordered-code'><a t:href="manifestUrl" t:text="manifestUrl">url</a></code></p>
+
+        <t:block t:if="!sourcePresent and manifestStatus == null">
+            <p class='ewp-para'>
+                <b>Unknown URL:</b> This URL is not listed among the current Registry Service
+                manifest sources, nor any trace of it can be found in our logs.
+            </p>
+        </t:block>
+        <t:block t:if="!sourcePresent and manifestStatus != null">
+            <p class='ewp-para'>
+                <b>Stale URL:</b> This URL was once listed among Registry Service sources, but
+                it is not anymore.
+            </p>
+            <p class='ewp-para'>
+                Last access attempt:
+                <code t:text="manifestStatus.lastAccessAttemptFormatted">date</code>
+            </p>
+        </t:block>
+        <t:block t:if="sourcePresent and manifestStatus == null">
+            <p class='ewp-para'>
+                <b>New URL:</b> This URL is listed among the current Registry Service manifest
+                sources, but it hasn't been accessed yet. Please refresh this page.
+            </p>
+        </t:block>
+        <t:block t:if="sourcePresent and manifestStatus != null">
+            <p class='ewp-para'>
+                Last access attempt:
+                <code class='ewpst__bordered-code' t:text="manifestStatus.lastAccessAttemptFormatted">date</code>
+                <br>
+                Last access status:
+                <code class='ewpst__bordered-code' t:text="manifestStatus.lastAccessFlagStatus">status</code>
+                <br>
+                <a class='ewp-manifest-reloader' t:data-manifest-url="manifestUrl">reload now</a>
+            </p>
+            <t:block t:if="!manifestStatus.lastAccessNotices.isEmpty()">
+                <h2 class='ewp-section-title'>Last access notices</h2>
+
+                <table class='ewpsrc'>
+                        <tr t:each="notice : manifestStatus.lastAccessNotices" t:class="|ewpsrc__item ewpsrc__item--status-${notice.severity}|">
+                            <td class='ewpsrc__status' t:text="notice.severity">severity</td>
+                            <td class='ewpsrc__message'><t:block t:replace="~{fragments/html :: nodes(view.tree(notice.messageHtml))}"></t:block></td>
+                        </tr>
+                </table>
+            </t:block>
+        </t:block>
+    </section>
+</body>
+</html>
