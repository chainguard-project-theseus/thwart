diff --git a/src/main/resources/templates/manifestsOverview.html b/src/main/resources/templates/manifestsOverview.html
new file mode 100644
index 0000000..72c1600
--- /dev/null
+++ b/src/main/resources/templates/manifestsOverview.html
@@ -0,0 +1,138 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.view.*, eu.erasmuswithoutpaper.registry.manifestoverview.*"
+      t:params="PageCommons page, List<ManifestOverviewInfo> manifestInfos, ImplementedApisCount implementedApisCount, ApiForHeiImplementationMapping duplicatesInfo, CoveredInstitutionsCounters heiDuplicates"
+      t:replace="~{fragments/toolbar :: toolbar(page, 'Manifests Overview', null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifests Overview</h2>
+
+        <p class='ewp-para'>Currently defined manifest sources and overview of their contents.</p>
+
+        <div class="ewpsrc ewpsrc__section_with_top_margin">
+            <h2>Implemented APIs statistics</h2>
+                <table class="ewpsrc ewpsrc__api_stats_table" t:each="implementedApiCount : implementedApisCount.counts">
+                <tbody>
+                    <tr class="ewpsrc__item">
+                    <td colspan="3"><h4 t:text="implementedApiCount.name">name</h4></td>
+                    </tr>
+                    <tr class="ewpsrc__item">
+                        <td>Version</td>
+                        <td>Hosts</td>
+                        <td>Institutions</td>
+                    </tr>
+                        <tr class="ewpsrc__item" t:each="versionsCounts : implementedApiCount.counts">
+                            <td t:text="versionsCounts.version">1</td>
+                            <td t:text="versionsCounts.hostsCount">1</td>
+                            <td t:text="versionsCounts.uniqueInstitutionsCount">1</td>
+                        </tr>
+                </tbody>
+                </table>
+        </div>
+        <div class='ewpsrc ewpsrc__section_with_top_margin'>
+            <h2>Duplicates in the EWP Network</h2>
+            <h3>Duplicate (HEI, API) pairs on different hosts (with the same major version)</h3>
+                <div style="font-weight: bolder" t:if="duplicatesInfo.map.isEmpty()">
+                    No duplicates.
+                </div>
+                <t:block t:unless="duplicatesInfo.map.isEmpty()">
+                    <table class="ewpsrc ewpsrc__host_overview_info_table" t:each="entry : duplicatesInfo.map">
+                        <tr class="ewpsrc__item">
+                            <td colspan="2" t:text="entry.key.heiId">hei</td>
+                            <td colspan="2"> API: [[${entry.key.apiName}]]</td>
+                            <td colspan="1"> Major version: [[${entry.key.majorVersion}]]</td>
+                        </tr>
+                            <tr class="ewpsrc__item" t:each="implementingHostEntry : entry.value">
+                                <td colspan="3"> [[${implementingHostEntry.key.manifestUrl}]] </td>
+                                <td colspan="1"> Host: [[${implementingHostEntry.key.hostId}]] </td>
+                                <td colspan="1"> Versions: [[${strings.join(implementingHostEntry.value, ', ')}]]</td>
+                            </tr>
+                    </table>
+                </t:block>
+
+            <h3>Duplicate HEIs on the same host</h3>
+                <div style="font-weight: bolder" t:if="heiDuplicates.map.isEmpty()">
+                    No duplicates.
+                </div>
+                <t:block t:unless="heiDuplicates.map.isEmpty()">
+                    <table class="ewpsrc ewpsrc__host_overview_info_table" t:each="entry : heiDuplicates.map">
+                        <tr class="ewpsrc__item">
+                            <td colspan="2" t:text="entry.key.manifestUrl">url</td>
+                            <td colspan="1">Host [[${entry.key.hostId}]]</td>
+                        </tr>
+                            <tr class="ewpsrc__item" t:each="heiAndCount : entry.value">
+                                <td colspan="2"> [[${heiAndCount.key}]] </td>
+                                <td colspan="1"> Count: [[${heiAndCount.value}]] </td>
+                            </tr>
+                    </table>
+                </t:block>
+        </div>
+
+        <div class='ewpsrc ewpsrc__section_with_top_margin'>
+            <h2>Implemented APIs and covered HEIs</h2>
+            <table class="ewpsrc">
+            <t:block t:each="manifestOverviewInfo : manifestInfos">
+                <h3><a t:href="manifestOverviewInfo.url" t:text="manifestOverviewInfo.url">url</a></h3>
+                <table class="ewpsrc__host_overview_info_table" t:each="hostOverviewInfo, hostStat : manifestOverviewInfo.hosts">
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            <h4>HOST [[${hostStat.count}]]</h4>
+                        </td>
+                    </tr>
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            Admin emails: ([[${hostOverviewInfo.adminEmails.size()}]])
+                        </td>
+                    </tr>
+
+                        <tr class="ewpsrc__item" t:each="email : hostOverviewInfo.adminEmails">
+                            <td colspan="5" t:text="email">
+                            </td>
+                        </tr>
+
+                        <tr class="ewpsrc__item" t:if="hostOverviewInfo.adminProvider != null">
+                            <td colspan="5">
+                                Admin provider: [[${hostOverviewInfo.adminProvider}]]
+                            </td>
+                        </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            Admin notes: ([[${hostOverviewInfo.adminNotes.size()}]])
+                        </td>
+                    </tr>
+                        <tr class="ewpsrc__item" t:each="note : hostOverviewInfo.adminNotes">
+                            <td colspan="5" t:text="note">
+                            </td>
+                        </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            APIs implemented: ([[${hostOverviewInfo.apisImplemented.size()}]])
+                        </td>
+                    </tr>
+                        <tr class="ewpsrc__item" t:each="apiImplementedInfo : hostOverviewInfo.apisImplemented">
+                            <td t:text="apiImplementedInfo.name">
+                            </td>
+                            <td t:text="apiImplementedInfo.version">
+                            </td>
+                            <td colspan="3">
+                                <t:block t:each="url, urlStat : apiImplementedInfo.urls">[[${url}]] <br t:unless="urlStat.last"/> </t:block>
+                            </td>
+                        </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            Covered institutions: ([[${hostOverviewInfo.coveredHeiIds.size()}]])
+                        </td>
+                    </tr>
+                    <tr t:each="row : view.rowsOfFive(hostOverviewInfo.coveredHeiIds)" t:class="row[0] != null ? 'ewpsrc__item'">
+                        <td t:each="heiId : row" t:text="heiId">
+                        </td>
+                    </tr>
+                </table>
+            </t:block>
+            </table>
+        </div>
+    </section>
+</body>
+</html>
