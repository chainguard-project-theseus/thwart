+package eu.erasmuswithoutpaper.registry.web.view;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * A node of an allow-listed HTML tree, rendered by the {@code fragments/html} template.
+ *
+ * @param tag lower-case element name, or {@link #TEXT} for a text node.
+ * @param text the (unescaped) text of a text node, {@code null} for elements.
+ * @param attrs allow-listed attributes of an element (unescaped values).
+ * @param children child nodes of an element.
+ */
+public record HtmlNode(String tag, String text, Map<String, String> attrs,
+    List<HtmlNode> children) {
+
+  /**
