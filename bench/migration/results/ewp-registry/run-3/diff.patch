diff --git a/src/main/java/eu/erasmuswithoutpaper/registry/web/view/HtmlTreeParser.java b/src/main/java/eu/erasmuswithoutpaper/registry/web/view/HtmlTreeParser.java
new file mode 100644
index 0000000..ac3fdc4
--- /dev/null
+++ b/src/main/java/eu/erasmuswithoutpaper/registry/web/view/HtmlTreeParser.java
@@ -0,0 +1,288 @@
+package eu.erasmuswithoutpaper.registry.web.view;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Deque;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Parses HTML built by this application (notices, the coverage matrix) into a tree of
+ * {@link HtmlNode}str, keeping only allow-listed elements and attributes.
+ *
+ * <p>
+ * The tree is rendered by the {@code fragments/html} template, which escapes all text and
+ * attribute values. Elements which are not allow-listed are dropped (their content is kept),
+ * and so are all attributes which are not allow-listed.
+ * </p>
+ */
+public final class HtmlTreeParser {
+
+  private static final Set<String> ALLOWED_TAGS = Set.of("a", "b", "br", "code", "div", "em", "i",
+      "li", "ol", "p", "pre", "small", "span", "strong", "sub", "sup", "table", "tbody", "td",
+      "th", "thead", "tr", "ul");
+  private static final Set<String> VOID_TAGS = Set.of("br");
+  private static final Set<String> ALLOWED_ATTRS =
+      Set.of("class", "href", "colspan", "rowspan", "title", "id");
+  private static final Map<String, String> ENTITIES = Map.of("lt", "<", "gt", ">", "amp", "&",
+      "quot", "\"", "apos", "'", "nbsp", " ", "shy", "­");
+
+  private HtmlTreeParser() {
+  }
+
+  /**
+   * Parse an HTML fragment.
+   *
+   * @param html the HTML to parse, may be {@code null}.
+   * @return the list of top-level nodes.
+   */
+  public static List<HtmlNode> parse(String html) {
+    Builder root = new Builder(null, Collections.emptyMap());
+    if (html == null) {
+      return root.build().children();
+    }
+    Deque<Builder> stack = new ArrayDeque<>();
+    stack.push(root);
+    StringBuilder text = new StringBuilder();
+    int pos = 0;
+    int len = html.length();
+    while (pos < len) {
+      char ch = html.charAt(pos);
+      if (ch == '<' && pos + 1 < len && isTagStart(html.charAt(pos + 1))) {
+        int end = findTagEnd(html, pos + 1);
+        if (end < 0) {
+          text.append(html, pos, len);
+          break;
+        }
+        flushText(stack.peek(), text);
+        handleTag(html.substring(pos + 1, end), stack);
+        pos = end + 1;
+      } else {
+        text.append(ch);
+        pos++;
+      }
+    }
+    flushText(stack.peek(), text);
+    while (stack.size() > 1) {
+      Builder done = stack.pop();
+      stack.peek().children.add(done);
+    }
+    return root.build().children();
+  }
+
+  private static boolean isTagStart(char ch) {
+    return ch == '/' || Character.isLetter(ch);
+  }
+
+  private static int findTagEnd(String html, int from) {
+    char quote = 0;
+    for (int i = from; i < html.length(); i++) {
+      char ch = html.charAt(i);
+      if (quote != 0) {
+        if (ch == quote) {
+          quote = 0;
+        }
+      } else if (ch == '"' || ch == '\'') {
+        quote = ch;
+      } else if (ch == '>') {
+        return i;
+      }
+    }
+    return -1;
+  }
+
+  private static void handleTag(String tagContent, Deque<Builder> stack) {
+    if (tagContent.startsWith("/")) {
+      String name = tagContent.substring(1).trim().toLowerCase(Locale.ROOT);
+      if (!ALLOWED_TAGS.contains(name)) {
+        return;
+      }
+      boolean open = false;
+      for (Builder b : stack) {
+        if (name.equals(b.tag)) {
+          open = true;
+          break;
+        }
+      }
+      if (!open) {
+        return;
+      }
+      while (true) {
+        Builder done = stack.pop();
+        stack.peek().children.add(done);
+        if (name.equals(done.tag)) {
+          return;
+        }
+      }
+    }
+    int nameEnd = 0;
+    while (nameEnd < tagContent.length() && !Character.isWhitespace(tagContent.charAt(nameEnd))
+        && tagContent.charAt(nameEnd) != '/') {
+      nameEnd++;
+    }
+    String name = tagContent.substring(0, nameEnd).toLowerCase(Locale.ROOT);
+    if (!ALLOWED_TAGS.contains(name)) {
+      return;
+    }
+    Builder element = new Builder(name, parseAttributes(tagContent.substring(nameEnd)));
+    if (VOID_TAGS.contains(name)) {
+      stack.peek().children.add(element);
+    } else {
+      stack.push(element);
+    }
+  }
+
+  private static Map<String, String> parseAttributes(String str) {
+    Map<String, String> attrs = new LinkedHashMap<>();
+    int pos = 0;
+    int len = str.length();
+    while (pos < len) {
+      char ch = str.charAt(pos);
+      if (Character.isWhitespace(ch) || ch == '/') {
+        pos++;
+        continue;
+      }
+      int nameStart = pos;
+      while (pos < len && !Character.isWhitespace(str.charAt(pos)) && str.charAt(pos) != '='
+          && str.charAt(pos) != '/') {
+        pos++;
+      }
+      String name = str.substring(nameStart, pos).toLowerCase(Locale.ROOT);
+      while (pos < len && Character.isWhitespace(str.charAt(pos))) {
+        pos++;
+      }
+      String value = "";
+      if (pos < len && str.charAt(pos) == '=') {
+        pos++;
+        while (pos < len && Character.isWhitespace(str.charAt(pos))) {
+          pos++;
+        }
+        if (pos < len && (str.charAt(pos) == '"' || str.charAt(pos) == '\'')) {
+          char quote = str.charAt(pos);
+          int end = str.indexOf(quote, pos + 1);
+          if (end < 0) {
+            end = len;
+          }
+          value = str.substring(pos + 1, end);
+          pos = Math.min(end + 1, len);
+        } else {
+          int valueStart = pos;
+          while (pos < len && !Character.isWhitespace(str.charAt(pos))) {
+            pos++;
+          }
+          value = str.substring(valueStart, pos);
+        }
+      }
+      if (ALLOWED_ATTRS.contains(name) && !attrs.containsKey(name)) {
+        attrs.put(name, decodeEntities(value));
+      }
+    }
+    return attrs;
+  }
+
+  private static void flushText(Builder parent, StringBuilder text) {
+    if (text.length() > 0) {
+      parent.children.add(new HtmlNode(HtmlNode.TEXT, decodeEntities(text.toString()),
+          Collections.emptyMap(), Collections.emptyList()));
+      text.setLength(0);
+    }
+  }
+
+  /**
+   * Decode character references the way a browser does for the references used by this app.
+   *
+   * @param str text with character references.
+   * @return decoded text.
+   */
+  static String decodeEntities(String str) {
+    if (str.indexOf('&') < 0) {
+      return str;
+    }
+    StringBuilder sb = new StringBuilder();
+    int pos = 0;
+    while (pos < str.length()) {
+      char ch = str.charAt(pos);
+      if (ch != '&') {
+        sb.append(ch);
+        pos++;
+        continue;
+      }
+      int end = pos + 1;
+      if (end < str.length() && str.charAt(end) == '#') {
+        end++;
+        boolean hex = end < str.length() && (str.charAt(end) == 'x' || str.charAt(end) == 'X');
+        if (hex) {
+          end++;
+        }
+        int digitsStart = end;
+        while (end < str.length() && Character.digit(str.charAt(end), hex ? 16 : 10) >= 0) {
+          end++;
+        }
+        if (end > digitsStart) {
+          int cp = Integer.parseInt(str.substring(digitsStart, end), hex ? 16 : 10);
+          sb.appendCodePoint(cp);
+          if (end < str.length() && str.charAt(end) == ';') {
+            end++;
+          }
+          pos = end;
+          continue;
+        }
+      } else {
+        while (end < str.length() && Character.isLetterOrDigit(str.charAt(end))) {
+          end++;
+        }
+        String name = str.substring(pos + 1, end);
+        String decoded = ENTITIES.get(name);
+        if (decoded == null && name.length() > 2) {
+          // Legacy references such as "&lt" may be followed by other letters.
+          for (String legacy : new String[] { "lt", "gt", "amp", "quot" }) {
+            if (name.startsWith(legacy)) {
+              decoded = ENTITIES.get(legacy);
+              end = pos + 1 + legacy.length();
+              break;
+            }
+          }
+        }
+        if (decoded != null) {
+          sb.append(decoded);
+          if (end < str.length() && str.charAt(end) == ';') {
+            end++;
+          }
+          pos = end;
+          continue;
+        }
+      }
+      sb.append(ch);
+      pos++;
+    }
+    return sb.toString();
+  }
+
+  private static final class Builder {
+    private final String tag;
+    private final Map<String, String> attrs;
+    private final List<Object> children = new ArrayList<>();
+
+    Builder(String tag, Map<String, String> attrs) {
+      this.tag = tag;
+      this.attrs = attrs;
+    }
+
+    HtmlNode build() {
+      List<HtmlNode> built = new ArrayList<>();
+      for (Object child : this.children) {
+        if (child instanceof Builder) {
+          built.add(((Builder) child).build());
+        } else {
+          built.add((HtmlNode) child);
+        }
+      }
+      return new HtmlNode(this.tag, null, Collections.unmodifiableMap(this.attrs),
+          Collections.unmodifiableList(built));
+    }
+  }
+}
