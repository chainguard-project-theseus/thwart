@@ -0,0 +1,63 @@
+package eu.erasmuswithoutpaper.registry.web.view;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Functions available to the templates as {@code view.*}.
+ */
+@TemplateFunctions("view")
+public final class ViewFunctions {
+
+  private ViewFunctions() {
+  }
+
+  /**
+   * Parse HTML built by this application into an allow-listed tree, to be rendered by the
+   * {@code fragments/html :: nodes} fragment.
+   *
+   * @param html the HTML, may be {@code null}.
+   * @return the top-level nodes.
+   */
+  @TemplateFunction
+  public static List<HtmlNode> tree(String html) {
+    return HtmlTreeParser.parse(html);
+  }
+
+  /**
+   * Unwrap an optional string.
+   *
+   * @param value the optional value.
+   * @return the value, or {@code null} if it is empty.
+   */
+  @TemplateFunction
+  public static String orNull(Optional<String> value) {
+    return value == null ? null : value.orElse(null);
+  }
+
+  /**
+   * Split a list into table rows of five cells. As the old template did, the last row is padded
+   * with empty ({@code null}) cells, and a list whose size is a multiple of five (including an
+   * empty list) gets an additional row of five empty cells.
+   *
+   * @param values the values to split.
+   * @return the rows.
+   */
+  @TemplateFunction
+  public static List<List<String>> rowsOfFive(List<String> values) {
+    List<String> cells = new ArrayList<>(values);
+    int padding = 5 - (values.size() % 5);
+    for (int i = 0; i < padding; i++) {
+      cells.add(null);
+    }
+    List<List<String>> rows = new ArrayList<>();
+    for (int i = 0; i < cells.size(); i += 5) {
+      rows.add(cells.subList(i, i + 5));
+    }
+    return rows;
+  }
+}
