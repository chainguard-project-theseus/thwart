+++ b/src/main/resources/templates/heiSearch.html
@@ -0,0 +1,38 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.view.*"
+      t:params="PageCommons page, String pattern, List<HeiRow> heis"
+      t:replace="~{fragments/toolbar :: toolbar(page, 'HEI Search Page', null, ~{::body})}">
+<body t:remove="tag">
+<section class='ewp-section ewp-section-centered'>
+    <h2 class='ewp-section-title'>HEI Search Page</h2>
+
+    <t:block t:replace="~{fragments/heiFilter :: heiFilter(pattern)}"></t:block>
+
+    <p>
+        Found [[${heis.size()}]] HEI(s):
+    </p>
+
+    <div class="ewpsrc ewpsrc__section_with_top_margin">
+        <table class="ewpst__table" t:if="!heis.isEmpty()">
+            <thead>
+                <tr class="ewpst__row ewpst__row--header">
+                    <th class="cell cc1">Name</th>
+                    <th class="cell cc1">SCHAC</th>
+                    <th class="cell cc1">Erasmus code</th>
+                </tr>
+            </thead>
+            <tbody>
+                <tr t:each="hei : heis">
+                    <td class="cell cc1" t:text="hei.name">name</td>
+                    <td class="cell cc1 schac">
+                        <a t:href="|https://hei.api.uni-foundation.eu/schac/${hei.id}|" t:text="hei.id">id</a>
+                    </td>
+                    <td class="cell cc1 erasmus" t:text="hei.erasmus">
+                    </td>
+                </tr>
+            </tbody>
+        </table>
+    </div>
+</section>
+</body>
+</html>
