diff --git a/src/main/resources/templates/validationResult.html b/src/main/resources/templates/validationResult.html
new file mode 100644
index 0000000..e0eb7c3
--- /dev/null
+++ b/src/main/resources/templates/validationResult.html
@@ -0,0 +1,137 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.view.*, eu.erasmuswithoutpaper.registry.validators.HtmlValidationReportFormatter.*"
+      t:params="PageCommons page, ValidationReport report"
+      t:replace="~{fragments/toolbar :: toolbar(page, |${report.info.apiName} validation result|, null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-validation-results' t:with="info=report.info">
+        <h1 class='ewp-section-title'>
+            Result: <code class='ewpst__bordered' t:text="report.status">status</code>
+        </h1>
+
+        <h2 class='ewp-section-title'>Basic info</h2>
+        <ul>
+            <li>
+                <p class='ewp-para'>Tested URL:
+                    <code class='ewpst__bordered-code'>
+                        <a t:href="info.url" t:text="info.url">url</a></code>:
+                </p>
+            </li>
+            <li>
+                <p class='ewp-para'>API name: [[${info.apiName}]]</p>
+            </li>
+            <li>
+                <p class='ewp-para'>Version: [[${info.version}]]</p>
+            </li>
+            <li>
+                Security:<br>
+                <code class='ewpst__bordered-code-larger' t:text="info.security">security</code> <br>
+                <t:block t:each="explanation : info.securityExplanation">
+                    <code class='ewpst__bordered-code-larger' t:text="explanation.marker">marker</code> - [[${explanation.description}]]<br>
+                </t:block>
+            </li>
+            <li>
+                Datetime validation started: <code class='ewpst__bordered-code' t:text="info.validationStarted">date</code>
+            </li>
+            <li t:if="info.clientKeysRegenerated != null">
+                Datetime client keys regenerated:
+                <code class='ewpst__bordered-code' t:text="info.clientKeysRegenerated">date</code>
+                ([[${info.clientKeysAgeWhenValidationStartedInSeconds}]]
+                seconds before validation)
+            </li>
+        </ul>
+
+        <h2 class='ewp-section-title'>Validation results</h2>
+
+        <button type="button" id="show_all_details">Show all details</button>
+        <button type="button" id="hide_all_details">Hide all details</button>
+
+        <table class='ewpsrc ewpsrc__test_validation-table'>
+        <t:block t:each="test, testStat : report.tests">
+            <tr class='ewpsrc__item'>
+                <td class='ewpsrc__test_index' t:rowspan="test.height" t:text="testStat.count">1</td>
+                <td t:class="|ewpsrc__item ewpsrc__test_text ewpsrc__item--status-${test.status}|" t:text="test.name">name</td>
+                <td t:class="|ewpsrc__item ewpsrc__item--status-${test.status} ewpsrc__test_validation-status-code|" t:text="test.status">
+                    status
+                </td>
+            </tr>
+
+            <tr class='ewpsrc__item' t:if="test.hasMessage">
+                <td colspan='2' t:class="|ewpsrc__item ewpsrc__test_text ewpsrc__item--status-${test.status}|" t:text="test.message">message</td>
+            </tr>
+
+            <tr class='ewpsrc__item' t:if="test.hasDetails">
+                <td colspan='2'>
+                <details>
+                <summary>
+                    Show/hide details
+                </summary>
+                <table class='ewpsrc ewpsrc__test_details-table'>
+                <tr class='ewpsrc__item' t:each="request, requestStat : test.requestSnapshots"><td>
+                    <details>
+                    <summary>
+                        <t:block t:if="requestStat.last">Actual request which was made (#-1)</t:block>
+                        <t:block t:unless="requestStat.last">Preliminary request snapshot (#-[[${requestStat.size - requestStat.index}]])</t:block>
+                    </summary>
+                    <p></p>
+                    <t:block t:replace="~{::printRequest(request)}"></t:block>
+                    <p></p>
+                    </details>
+                </td></tr>
+
+                <tr class='ewpsrc__item' t:each="response, responseStat : test.responseSnapshots"><td>
+                    <details>
+                    <summary>
+                        <t:block t:if="responseStat.first">Response received from server (#+1)</t:block>
+                        <t:block t:unless="responseStat.first">Processed response snapshot (#+[[${responseStat.count}]])</t:block>
+                    </summary>
+                    <p></p><t:block t:replace="~{::printResponse(response)}"></t:block><p></p>
+                    </details>
+                </td></tr>
+                </table>
+
+                </details>
+                </td>
+            </tr>
+            <tr class='ewp-empty-row'></tr>
+
+        </t:block>
+        </table>
+
+    </section>
+</body>
+
+<t:block t:fragment="printKeyValue(String key, String value, String cls)">
+    <div t:class="cls">
+        <span class='ewpsrc__test_key'>[[${key}]]:</span>
+        <span class='ewpsrc__test_value'>
+            <t:block t:if="value == null">(none)</t:block>
+            <t:block t:unless="value == null">[[${value}]]</t:block>
+        </span>
+    </div>
+</t:block>
+
+<t:block t:fragment="printHeaders(Map<String, String> headers, List<String> notices)">
+    <t:block t:each="header : headers">
+        <t:block t:replace="~{::printKeyValue(header.key, header.value, 'ewpsrc__test_http-header ')}"></t:block>
+    </t:block>
+
+    <p class="ewpsrc__test_processing-notice" t:each="notice : notices" t:text="notice">notice</p>
+</t:block>
+
+<t:block t:fragment="printRequest(RequestSnapshot request)">
+    <t:block t:replace="~{::printKeyValue('Method and URL', request.method + ' ' + request.url, '')}"></t:block>
+    <t:block t:replace="~{::printKeyValue('Client certificate fingerprint', request.clientCertFingerprint, '')}"></t:block>
+    <t:block t:replace="~{::printHeaders(request.headers, request.processingNoticesHtml)}"></t:block>
+    <pre class="ewpsrc__test_message-body" t:if="request.body != null and !request.body.isEmpty()" t:text="request.body">body</pre>
+    <pre class="ewpsrc__test_message-body" t:if="!(request.body != null and !request.body.isEmpty()) and request.rawBodyBase64 != null and !request.rawBodyBase64.isEmpty()" t:text="request.rawBodyBase64">body</pre>
+</t:block>
+
+<t:block t:fragment="printResponse(ResponseSnapshot response)">
+    <t:block t:replace="~{::printKeyValue('HTTP status', '' + response.status, '')}"></t:block>
+    <t:block t:replace="~{::printHeaders(response.headers, response.processingNoticesHtml)}"></t:block>
+    <p class="ewpsrc__test_developer-message" t:if="response.developerMessage != null">Developer message:<br>[[${response.developerMessage}]]</p>
+    <pre class="ewpsrc__test_message-body" t:if="response.rawBodyBase64 == null">(empty body)</pre>
+    <pre class="ewpsrc__test_message-body" t:if="response.rawBodyBase64 != null and response.prettyXml != null" t:text="response.prettyXml">xml</pre>
+    <pre class="ewpsrc__test_message-body" t:if="response.rawBodyBase64 != null and response.prettyXml == null" t:text="response.rawBodyBase64">body</pre>
+</t:block>
+</html>
