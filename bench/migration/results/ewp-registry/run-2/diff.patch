+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.PageCommons, eu.erasmuswithoutpaper.registry.updater.ManifestUpdateStatus"
+      t:params="PageCommons page, List<ManifestUpdateStatus> manifestStatuses, String manifestValidationUrl, boolean isValidatorEnabled"
+      t:replace="~{generic-with-toolbar :: toolbarLayout(page, 'Status of the EWP Manifest Importer', null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifest Importer Status</h2>
+
+        <p class='ewp-para'>Currently defined manifest sources and their statuses:</p>
+
+        <table class='ewpsrc'>
+                <tr t:each="stat, st : manifestStatuses" class='ewpsrc__item' t:classappend="|ewpsrc__item--status-${stat.lastAccessFlagStatus}|">
+                    <td class='ewpsrc__item'> [[${st.count}]] </td>
+                    <td class='ewpsrc__url'>
+                        <a t:href="stat.url" t:text="stat.url">url</a>
+                    </td>
+                    <td class='ewpsrc__status' t:text="stat.lastAccessFlagStatus">OK</td>
+                    <td class='ewpsrv__details'><a t:href="|?url=${stat.url}|">details</a></td>
+                    <td class='ewpsrv__details'>
+                        <a class='ewp-manifest-reloader' t:data-manifest-url="stat.url">reload now</a>
+                    </td>
+                    <td class='ewpsrv__details' t:if="isValidatorEnabled">
+                        <a t:href="|${manifestValidationUrl}?url=${stat.url}|">validate</a>
+                    </td>
+                </tr>
+        </table>
+    </section>
+</body>
+</html>
