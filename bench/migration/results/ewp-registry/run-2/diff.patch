+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.PageCommons, eu.erasmuswithoutpaper.registry.validators.HtmlValidationReportFormatter.*"
+      t:params="PageCommons page, ValidationInfo info, String status, List<TestStep> tests"
+      t:replace="~{generic-with-toolbar :: toolbarLayout(page, |${info.apiName} validation result|, null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-validation-results'>
+        <h1 class='ewp-section-title'>
+            Result: <code class='ewpst__bordered' t:text="status">OK</code>
+        </h1>
+
+        <h2 class='ewp-section-title'>Basic info</h2>
+        <ul>
+            <li>
+                <p class='ewp-para'>Tested URL:
+                    <code class='ewpst__bordered-code'>
+                        <a t:href="info.url" t:text="info.url">url</a></code>:
+                </p>
+            </li>
+            <li>
+                <p class='ewp-para'>API name: [[${info.apiName}]]</p>
+            </li>
+            <li>
+                <p class='ewp-para'>Version: [[${info.version}]]</p>
+            </li>
+            <li>
+                Security:<br>
+                <code class='ewpst__bordered-code-larger' t:text="info.security">SecA</code> <br>
+                <t:block t:each="explanation : info.securityExplanation">
+                    <code class='ewpst__bordered-code-larger' t:text="explanation.marker">S</code> - [[${explanation.description}]]<br>
+                </t:block>
+            </li>
+            <li>
+                Datetime validation started: <code class='ewpst__bordered-code' t:text="info.validationStarted">date</code>
+            </li>
+            <li t:if="info.clientKeysRegenerated != null">
+                Datetime client keys regenerated:
+                <code class='ewpst__bordered-code' t:text="info.clientKeysRegenerated">date</code>
+                ([[${info.clientKeysAgeWhenValidationStartedInSeconds}]]
+                seconds before validation)
+            </li>
+        </ul>
+
+        <h2 class='ewp-section-title'>Validation results</h2>
+
+        <button type="button" id="show_all_details">Show all details</button>
+        <button type="button" id="hide_all_details">Hide all details</button>
+
+        <table class='ewpsrc ewpsrc__test_validation-table'>
+        <t:block t:each="test, testStat : tests">
+            <tr class='ewpsrc__item'>
+                <td class='ewpsrc__test_index' t:rowspan="test.height" t:text="testStat.count">1</td>
