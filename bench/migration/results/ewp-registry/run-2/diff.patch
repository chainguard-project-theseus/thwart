--- /dev/null
+++ b/src/main/resources/templates/manifestsOverview.html
@@ -0,0 +1,141 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.PageCommons, eu.erasmuswithoutpaper.registry.manifestoverview.*"
+      t:params="PageCommons page, Collection<ManifestOverviewInfo> manifestInfos, ImplementedApisCount implementedApisCount, ApiForHeiImplementationMapping duplicatesInfo, CoveredInstitutionsCounters heiDuplicates"
+      t:replace="~{generic-with-toolbar :: toolbarLayout(page, 'Manifests Overview', null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifests Overview</h2>
+
+        <p class='ewp-para'>Currently defined manifest sources and overview of their contents.</p>
+
+        <div class="ewpsrc ewpsrc__section_with_top_margin">
+            <h2>Implemented APIs statistics</h2>
+                <table class="ewpsrc ewpsrc__api_stats_table" t:each="implementedApiCount : implementedApisCount.counts">
+                <tbody>
+                    <tr class="ewpsrc__item">
+                    <td colspan="3"><h4 t:text="implementedApiCount.name">name</h4></td>
+                    </tr>
+                    <tr class="ewpsrc__item">
+                        <td>Version</td>
+                        <td>Hosts</td>
+                        <td>Institutions</td>
+                    </tr>
+                        <tr class="ewpsrc__item" t:each="versionsCounts : implementedApiCount.counts">
+                            <td t:text="versionsCounts.version">1</td>
+                            <td t:text="versionsCounts.hostsCount">1</td>
+                            <td t:text="versionsCounts.uniqueInstitutionsCount">1</td>
+                        </tr>
+                </tbody>
+                </table>
+        </div>
+        <div class='ewpsrc ewpsrc__section_with_top_margin'>
+            <h2>Duplicates in the EWP Network</h2>
+            <h3>Duplicate (HEI, API) pairs on different hosts (with the same major version)</h3>
+                <div style="font-weight: bolder" t:if="duplicatesInfo.map.isEmpty()">
+                    No duplicates.
+                </div>
+                    <table class="ewpsrc ewpsrc__host_overview_info_table" t:each="entry : duplicatesInfo.map" t:with="apiAndHei=entry.key">
+                        <tr class="ewpsrc__item">
+                            <td colspan="2" t:text="apiAndHei.heiId">hei</td>
+                            <td colspan="2"> API: [[${apiAndHei.apiName}]]</td>
+                            <td colspan="1"> Major version: [[${apiAndHei.majorVersion}]]</td>
+                        </tr>
+                            <tr class="ewpsrc__item" t:each="implementingHostEntry : entry.value" t:with="implementationInfo=implementingHostEntry.key">
+                                <td colspan="3"> [[${implementationInfo.manifestUrl}]] </td>
+                                <td colspan="1"> Host: [[${implementationInfo.hostId}]] </td>
+                                <td colspan="1"> Versions: [[${strings.join(implementingHostEntry.value, ', ')}]]</td>
+                            </tr>
+                    </table>
+
+            <h3>Duplicate HEIs on the same host</h3>
+                <div style="font-weight: bolder" t:if="heiDuplicates.map.isEmpty()">
+                    No duplicates.
+                </div>
+                    <table class="ewpsrc ewpsrc__host_overview_info_table" t:each="entry : heiDuplicates.map" t:with="manifestAndHostId=entry.key">
+                        <tr class="ewpsrc__item">
+                            <td colspan="2" t:text="manifestAndHostId.manifestUrl">url</td>
+                            <td colspan="1">Host [[${manifestAndHostId.hostId}]]</td>
+                        </tr>
+                            <tr class="ewpsrc__item" t:each="heiAndCount : entry.value">
+                                <td colspan="2"> [[${heiAndCount.key}]] </td>
+                                <td colspan="1"> Count: [[${heiAndCount.value}]] </td>
+                            </tr>
+                    </table>
+        </div>
+
+        <div class='ewpsrc ewpsrc__section_with_top_margin'>
+            <h2>Implemented APIs and covered HEIs</h2>
+            <table class="ewpsrc">
+            <t:block t:each="manifestOverviewInfo : manifestInfos">
+                <h3><a t:href="manifestOverviewInfo.url" t:text="manifestOverviewInfo.url">url</a></h3>
+                <table class="ewpsrc__host_overview_info_table" t:each="hostOverviewInfo, hostStat : manifestOverviewInfo.hosts">
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            <h4>HOST [[${hostStat.count}]]</h4>
+                        </td>
+                    </tr>
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            Admin emails: ([[${hostOverviewInfo.adminEmails.size()}]])
+                        </td>
+                    </tr>
+
+                        <tr class="ewpsrc__item" t:each="email : hostOverviewInfo.adminEmails">
+                            <td colspan="5">
+                                [[${email}]]
+                            </td>
+                        </tr>
+
+                        <tr class="ewpsrc__item" t:if="hostOverviewInfo.adminProvider != null">
+                            <td colspan="5">
+                                Admin provider: [[${hostOverviewInfo.adminProvider}]]
+                            </td>
+                        </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            Admin notes: ([[${hostOverviewInfo.adminNotes.size()}]])
+                        </td>
+                    </tr>
+                        <tr class="ewpsrc__item" t:each="note : hostOverviewInfo.adminNotes">
+                            <td colspan="5">
+                                [[${note}]]
+                            </td>
+                        </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            APIs implemented: ([[${hostOverviewInfo.apisImplemented.size()}]])
+                        </td>
+                    </tr>
+                        <tr class="ewpsrc__item" t:each="apiImplementedInfo : hostOverviewInfo.apisImplemented">
+                            <td>
+                                [[${apiImplementedInfo.name}]]
+                            </td>
+                            <td>
+                                [[${apiImplementedInfo.version}]]
+                            </td>
+                            <td colspan="3">
+                                <t:block t:each="url, urlStat : apiImplementedInfo.urls">
+                                    [[${url}]] <t:block t:unless="urlStat.last"> <br/> </t:block>
+                                </t:block>
+                            </td>
+                        </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            Covered institutions: ([[${hostOverviewInfo.coveredHeiIdCount}]])
+                        </td>
+                    </tr>
+                        <tr t:each="heiRow : hostOverviewInfo.coveredHeiIdRows" t:class="heiRow[0] == null ? null : 'ewpsrc__item'">
+                        <t:block t:each="heiId : heiRow"><td t:if="heiId != null">
+                         [[${heiId}]]
+                        </td><td t:if="heiId == null"></td></t:block>
+                        </tr>
+                </table>
+            </t:block>
+            </table>
+        </div>
+    </section>
+</body>
+</html>
