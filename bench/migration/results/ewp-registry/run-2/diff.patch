--- /dev/null
+++ b/src/main/resources/templates/statusPerUrl.html
@@ -0,0 +1,53 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.PageCommons, eu.erasmuswithoutpaper.registry.updater.ManifestUpdateStatus"
+      t:params="PageCommons page, String manifestUrl, ManifestUpdateStatus statusValue, boolean sourcePresent"
+      t:replace="~{generic-with-toolbar :: toolbarLayout(page, 'Manifest Status Report', null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifest Status Report</h2>
+
+        <p class='ewp-para'>Manifest URL:
+        <code class='ewpst__bordered-code'><a t:href="manifestUrl" t:text="manifestUrl">url</a></code></p>
+
+            <p class='ewp-para' t:if="!sourcePresent and statusValue == null">
+                <b>Unknown URL:</b> This URL is not listed among the current Registry Service
+                manifest sources, nor any trace of it can be found in our logs.
+            </p>
+            <t:block t:if="!sourcePresent and statusValue != null">
+            <p class='ewp-para'>
+                <b>Stale URL:</b> This URL was once listed among Registry Service sources, but
+                it is not anymore.
+            </p>
+            <p class='ewp-para'>
+                Last access attempt:
+                <code t:text="statusValue.lastAccessAttemptFormatted">date</code>
+            </p>
+            </t:block>
+            <p class='ewp-para' t:if="sourcePresent and statusValue == null">
+                <b>New URL:</b> This URL is listed among the current Registry Service manifest
+                sources, but it hasn't been accessed yet. Please refresh this page.
+            </p>
+            <t:block t:if="sourcePresent and statusValue != null">
+            <p class='ewp-para'>
+                Last access attempt:
+                <code class='ewpst__bordered-code' t:text="statusValue.lastAccessAttemptFormatted">date</code>
+                <br>
+                Last access status:
+                <code class='ewpst__bordered-code' t:text="statusValue.lastAccessFlagStatus">OK</code>
+                <br>
+                <a class='ewp-manifest-reloader' t:data-manifest-url="manifestUrl">reload now</a>
+            </p>
+            <t:block t:if="!statusValue.lastAccessNotices.isEmpty()">
+                <h2 class='ewp-section-title'>Last access notices</h2>
+
+                <table class='ewpsrc'>
+                        <tr t:each="notice : statusValue.lastAccessNotices" class='ewpsrc__item' t:classappend="|ewpsrc__item--status-${notice.severity}|">
+                            <td class='ewpsrc__status' t:text="notice.severity">OK</td>
+                            <td class='ewpsrc__message' t:with="nodes=notice.messageNodes"><t:block t:if="nodes != null"><t:block t:replace="~{richText :: nodes(nodes)}"></t:block></t:block><t:block t:if="nodes == null" t:utext="html.sanitize(notice.messageHtml)"></t:block></td>
+                        </tr>
+                </table>
+            </t:block>
+            </t:block>
+    </section>
+</body>
+</html>
