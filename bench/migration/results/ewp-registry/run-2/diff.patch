diff --git a/src/main/java/eu/erasmuswithoutpaper/registry/common/HtmlNode.java b/src/main/java/eu/erasmuswithoutpaper/registry/common/HtmlNode.java
new file mode 100644
index 0000000..9b30d01
--- /dev/null
+++ b/src/main/java/eu/erasmuswithoutpaper/registry/common/HtmlNode.java
@@ -0,0 +1,84 @@
+package eu.erasmuswithoutpaper.registry.common;
+
+import java.io.IOException;
+import java.io.StringReader;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import javax.xml.XMLConstants;
+import javax.xml.parsers.DocumentBuilder;
+import javax.xml.parsers.DocumentBuilderFactory;
+import javax.xml.parsers.ParserConfigurationException;
+
+import org.w3c.dom.Document;
+import org.w3c.dom.Element;
+import org.w3c.dom.Node;
+import org.w3c.dom.NodeList;
+import org.xml.sax.InputSource;
+import org.xml.sax.SAXException;
+import org.xml.sax.helpers.DefaultHandler;
+
+/**
+ * A node of a small, allow-listed HTML tree, built from HTML snippets generated by our own code
+ * (e.g. manifest update notices), so that templates can render them without printing raw markup.
+ *
+ * @param tag lower-case name of an allowed element, or null for a text node.
+ * @param href the href of an "a" element (null otherwise).
+ * @param text the text of a text node (null otherwise).
+ * @param children child nodes of an element.
+ */
+public record HtmlNode(String tag, String href, String text, List<HtmlNode> children) {
+
+  private static final Set<String> ALLOWED_TAGS =
+      Set.of("p", "code", "b", "i", "em", "strong", "ul", "ol", "li", "br", "pre", "span", "a");
+
+  /**
+   * Parse an HTML snippet. Elements which are not allowed are replaced by their content, and all
+   * attributes except the "href" of "a" elements are dropped.
+   *
+   * @param html a well-formed HTML snippet (XML syntax).
+   * @return list of top-level nodes, or null if the snippet is not well-formed.
+   */
+  public static List<HtmlNode> parse(String html) {
+    if (html == null) {
+      return null;
+    }
+    try {
+      DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
+      factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
+      factory.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true);
+      factory.setExpandEntityReferences(false);
+      DocumentBuilder builder = factory.newDocumentBuilder();
+      builder.setErrorHandler(new DefaultHandler());
+      Document doc = builder.parse(new InputSource(new StringReader("<r>" + html + "</r>")));
+      return convertChildren(doc.getDocumentElement());
+    } catch (ParserConfigurationException | SAXException | IOException e) {
+      return null;
+    }
+  }
+
+  private static List<HtmlNode> convertChildren(Node parent) {
+    List<HtmlNode> result = new ArrayList<>();
+    NodeList children = parent.getChildNodes();
+    for (int i = 0; i < children.getLength(); i++) {
+      Node child = children.item(i);
+      if (child.getNodeType() == Node.TEXT_NODE || child.getNodeType() == Node.CDATA_SECTION_NODE) {
+        result.add(new HtmlNode(null, null, child.getNodeValue(), Collections.emptyList()));
+      } else if (child.getNodeType() == Node.ELEMENT_NODE) {
+        Element element = (Element) child;
+        String tag = element.getTagName().toLowerCase(Locale.ROOT);
+        List<HtmlNode> converted = convertChildren(element);
+        if (ALLOWED_TAGS.contains(tag)) {
+          String href = "a".equals(tag) && element.hasAttribute("href")
+              ? element.getAttribute("href") : null;
+          result.add(new HtmlNode(tag, href, null, converted));
+        } else {
+          result.addAll(converted);
+        }
+      }
+    }
+    return result;
+  }
+}
