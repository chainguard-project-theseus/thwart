diff --git a/src/test/java/eu/erasmuswithoutpaper/registry/common/HtmlNodeTest.java b/src/test/java/eu/erasmuswithoutpaper/registry/common/HtmlNodeTest.java
new file mode 100644
index 0000000..55bcb88
--- /dev/null
+++ b/src/test/java/eu/erasmuswithoutpaper/registry/common/HtmlNodeTest.java
@@ -0,0 +1,41 @@
+package eu.erasmuswithoutpaper.registry.common;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Tests for {@link HtmlNode}.
+ */
+public class HtmlNodeTest {
+
+  @Test
+  public void testKeepsAllowedElementsAndHref() {
+    List<HtmlNode> nodes =
+        HtmlNode.parse("<p>See <a href='https://example.com/' onclick='x()'>this</a></p>");
+    assertThat(nodes).hasSize(1);
+    HtmlNode p = nodes.get(0);
+    assertThat(p.tag()).isEqualTo("p");
+    assertThat(p.children()).hasSize(2);
+    assertThat(p.children().get(0).text()).isEqualTo("See ");
+    HtmlNode a = p.children().get(1);
+    assertThat(a.tag()).isEqualTo("a");
+    assertThat(a.href()).isEqualTo("https://example.com/");
+    assertThat(a.children().get(0).text()).isEqualTo("this");
+  }
+
+  @Test
+  public void testUnknownElementsAreReplacedByTheirContent() {
+    List<HtmlNode> nodes = HtmlNode.parse("<script>alert(1)</script><x>text</x>");
+    assertThat(nodes).extracting(HtmlNode::tag).containsOnlyNulls();
+    assertThat(nodes).extracting(HtmlNode::text).containsExactly("alert(1)", "text");
+  }
+
+  @Test
+  public void testMalformedHtmlIsRejected() {
+    assertThat(HtmlNode.parse("URL \"https://example.com/?a=1&b=<x>\" is not correct.")).isNull();
+    assertThat(HtmlNode.parse("<!DOCTYPE r [<!ENTITY e 'x'>]><p>&e;</p>")).isNull();
+  }
+}
