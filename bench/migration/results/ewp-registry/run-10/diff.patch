+                        </td>
+                    </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            APIs implemented: ([[${hostOverviewInfo.apisImplemented.size()}]])
+                        </td>
+                    </tr>
+                    <tr class="ewpsrc__item" t:each="apiImplementedInfo : hostOverviewInfo.apisImplemented">
+                        <td t:text="apiImplementedInfo.name">
+                        </td>
+                        <td t:text="apiImplementedInfo.version">
+                        </td>
+                        <td colspan="3">
+                            <t:block t:each="url, urlStat : apiImplementedInfo.urls">
+                                [[${url}]] <t:block t:unless="urlStat.last"> <br/> </t:block>
+                            </t:block>
+                        </td>
+                    </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            Covered institutions: ([[${hostOverviewInfo.coveredHeiCount}]])
+                        </td>
+                    </tr>
+                    <tr t:each="heiRow : hostOverviewInfo.coveredHeiRows" t:class="heiRow.item ? 'ewpsrc__item'">
+                        <td t:each="heiId : heiRow.heiIds" t:text="heiId">
+                        </td>
+                    </tr>
+                    </tbody>
+                </table>
+                </t:block>
+            </t:block>
+            <table class="ewpsrc" t:unless="hasAnyHost"></table>
+        </div>
+    </section>
+</body>
+</html>
