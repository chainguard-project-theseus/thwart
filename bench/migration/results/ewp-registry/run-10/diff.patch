+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.views.RecipientFlagRow"
+      t:params="boolean isUsingDevDesign, String cssFingerprint, String jsFingerprint, String email, List<RecipientFlagRow> flags"
+      t:replace="~{fragments/toolbar :: toolbar(|${email} - Recipient Status Report|, isUsingDevDesign, cssFingerprint, jsFingerprint, null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section'>
+        <h2 class='ewp-section-title'>Recipient Status Report</h2>
+
+        <p class='ewp-para'>Requested for recipient email address:
+        <code class='ewpst__bordered-code' t:text="email"></code></p>
+
+        <h2 class='ewp-section-title'>Issues being watched</h2>
+
+        <table class='ewpsrc' t:unless="flags.isEmpty()">
+            <tbody>
+                <tr t:each="flag : flags" t:class="|ewpsrc__item ewpsrc__item--status-${flag.status}|">
+                    <td class='ewpsrc__status' t:text="flag.status"></td>
+                    <td class='ewpsrc__message'>
+                        [[${flag.name}]]
+                        <t:block t:if="flag.detailsUrl != null">
+                            - <a t:href="flag.detailsUrl">details</a>
+                        </t:block>
+                    </td>
+                </tr>
+            </tbody>
+        </table>
+        <p class='ewp-para' t:if="flags.isEmpty()">No watched issues found for this email address.</p>
+    </section>
+</body>
+</html>
