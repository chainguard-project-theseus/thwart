+package eu.erasmuswithoutpaper.registry.web;
+
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Template functions printing the HTML messages of manifest update notices.
+ */
+@TemplateFunctions("notices")
+public final class NoticeFunctions {
+  private static final HtmlPolicy POLICY =
+      HtmlPolicy.builder()
+          .allowElements("p", "br", "b", "i", "code", "ul", "li", "a")
+          .linkRel() // the Registry writes these notices itself: add no rel
+          .build();
+
+  private NoticeFunctions() {
+  }
+
+  /**
+   * Sanitize the HTML message of a notice.
+   *
+   * @param html the HTML message.
+   * @return the sanitized message.
+   */
+  @TemplateFunction
+  public static SafeHtml html(String html) {
+    return SafeHtml.sanitize(html, POLICY);
+  }
+}
