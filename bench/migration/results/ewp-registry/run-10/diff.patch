diff --git a/src/main/resources/templates/statusPerUrl.html b/src/main/resources/templates/statusPerUrl.html
new file mode 100644
index 0000000..a3ac334
--- /dev/null
+++ b/src/main/resources/templates/statusPerUrl.html
@@ -0,0 +1,62 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.views.ManifestStatusView"
+      t:params="boolean isUsingDevDesign, String cssFingerprint, String jsFingerprint, String manifestUrl, boolean sourcePresent, ManifestStatusView status"
+      t:replace="~{fragments/toolbar :: toolbar('Manifest Status Report', isUsingDevDesign, cssFingerprint, jsFingerprint, null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifest Status Report</h2>
+
+        <p class='ewp-para'>Manifest URL:
+        <code class='ewpst__bordered-code'><a t:href="manifestUrl" t:text="manifestUrl"></a></code></p>
+
+        <p class='ewp-para' t:if="!sourcePresent and status == null">
+            <b>Unknown URL:</b> This URL is not listed among the current Registry Service
+            manifest sources, nor any trace of it can be found in our logs.
+        </p>
+        <t:block t:if="!sourcePresent and status != null">
+            <p class='ewp-para'>
+                <b>Stale URL:</b> This URL was once listed among Registry Service sources, but
+                it is not anymore.
+            </p>
+            <p class='ewp-para'>
+                Last access attempt:
+                <code t:text="status.lastAccessAttemptFormatted"></code>
+            </p>
+        </t:block>
+        <p class='ewp-para' t:if="sourcePresent and status == null">
+            <b>New URL:</b> This URL is listed among the current Registry Service manifest
+            sources, but it hasn't been accessed yet. Please refresh this page.
+        </p>
+        <t:block t:if="sourcePresent and status != null">
+            <p class='ewp-para'>
+                Last access attempt:
+                <code class='ewpst__bordered-code' t:text="status.lastAccessAttemptFormatted"></code>
+                <br>
+                Last access status:
+                <code class='ewpst__bordered-code' t:text="status.lastAccessFlagStatus"></code>
+                <br>
+                <input type="hidden" class="ewp-manifest-url" t:value="manifestUrl"><a class='ewp-manifest-reloader'>reload now</a>
+            </p>
+
+        <script>
+            // The manifest URL is passed in a hidden input next to each reload link.
+            $(".ewp-manifest-url").each(function() {
+                $(this).next(".ewp-manifest-reloader").attr("data-manifest-url", this.value);
+            });
+        </script>
+            <t:block t:unless="status.notices.isEmpty()">
+                <h2 class='ewp-section-title'>Last access notices</h2>
+
+                <table class='ewpsrc'>
+                    <tbody>
+                        <tr t:each="notice : status.notices" t:class="|ewpsrc__item ewpsrc__item--status-${notice.severity}|">
+                            <td class='ewpsrc__status' t:text="notice.severity"></td>
+                            <td class='ewpsrc__message' t:utext="notices.html(notice.messageHtml)"></td>
+                        </tr>
+                    </tbody>
+                </table>
+            </t:block>
+        </t:block>
+    </section>
+</body>
+</html>
