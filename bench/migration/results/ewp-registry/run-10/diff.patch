+package eu.erasmuswithoutpaper.registry.validators;
+
+import java.util.List;
+
+/**
+ * Results of an API validation, as rendered by the <code>validationResult</code> template.
+ *
+ * @param info basic info about the validation.
+ * @param success true if all the tests succeeded.
+ * @param status the worst status of all the tests.
+ * @param tests results of the tests.
+ */
+public record ValidationReport(Info info, boolean success, String status, List<Test> tests) {
+
+  /**
+   * Basic info about the validation.
+   *
+   * @param url URL of the tested API.
+   * @param apiName name of the tested API.
+   * @param version version of the tested API.
+   * @param security HTTP security description used.
+   * @param securityExplanation explanation of the HTTP security description.
+   * @param validationStarted date when the validation started.
+   * @param clientKeysRegenerated date when the client keys were regenerated, or null.
+   * @param clientKeysAgeWhenValidationStartedInSeconds age of client keys, or null.
+   */
+  public record Info(String url, String apiName, String version, String security,
+      List<SecurityLegendEntry> securityExplanation, String validationStarted,
+      String clientKeysRegenerated, String clientKeysAgeWhenValidationStartedInSeconds) {
+  }
+
+  /**
+   * Single marker of a HTTP security description, with its meaning.
+   *
+   * @param marker the marker.
+   * @param description its description.
+   */
+  public record SecurityLegendEntry(String marker, String description) {
+  }
+
+  /**
+   * Result of a single test.
+   *
+   * @param name name of the test.
+   * @param status status of the test.
+   * @param message message of the test.
+   * @param hasMessage true if the message should be displayed.
+   * @param hasDetails true if there are any request or response snapshots.
+   * @param height number of table rows the test takes.
+   * @param requestSnapshots snapshots of the requests made.
+   * @param responseSnapshots snapshots of the responses received.
+   */
+  public record Test(String name, String status, String message, boolean hasMessage,
+      boolean hasDetails, int height, List<RequestSnapshot> requestSnapshots,
+      List<ResponseSnapshot> responseSnapshots) {
+  }
+
+  /**
+   * HTTP header.
+   *
+   * @param key name of the header.
+   * @param value value of the header.
+   */
+  public record Header(String key, String value) {
+  }
+
+  /**
+   * Snapshot of a request.
+   *
+   * @param method HTTP method.
+   * @param url URL.
+   * @param clientCertFingerprint fingerprint of the client certificate, or null.
+   * @param headers HTTP headers.
+   * @param processingNotices processing notices.
+   * @param body body decoded as UTF-8, or null.
+   * @param rawBodyBase64 body encoded in Base64, or null.
+   */
+  public record RequestSnapshot(String method, String url, String clientCertFingerprint,
+      List<Header> headers, List<String> processingNotices, String body, String rawBodyBase64) {
+  }
+
+  /**
+   * Snapshot of a response.
+   *
+   * @param status HTTP status.
+   * @param headers HTTP headers.
+   * @param processingNotices processing notices.
+   * @param developerMessage developer message of an error response, or null.
+   * @param prettyXml formatted XML body, or null.
+   * @param rawBodyBase64 body encoded in Base64.
+   */
+  public record ResponseSnapshot(String status, List<Header> headers,
+      List<String> processingNotices, String developerMessage, String prettyXml,
+      String rawBodyBase64) {
+  }
+}
