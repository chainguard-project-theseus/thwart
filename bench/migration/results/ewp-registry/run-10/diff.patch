diff --git a/src/main/resources/templates/status.html b/src/main/resources/templates/status.html
new file mode 100644
index 0000000..a9b8899
--- /dev/null
+++ b/src/main/resources/templates/status.html
@@ -0,0 +1,38 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.web.views.ManifestStatusRow"
+      t:params="boolean isUsingDevDesign, String cssFingerprint, String jsFingerprint, List<ManifestStatusRow> manifestStatuses, String manifestValidationUrl, boolean isValidatorEnabled"
+      t:replace="~{fragments/toolbar :: toolbar('Status of the EWP Manifest Importer', isUsingDevDesign, cssFingerprint, jsFingerprint, null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifest Importer Status</h2>
+
+        <p class='ewp-para'>Currently defined manifest sources and their statuses:</p>
+
+        <table class='ewpsrc'>
+            <tbody>
+                <tr t:each="stat, loop : manifestStatuses" t:class="|ewpsrc__item ewpsrc__item--status-${stat.status}|">
+                    <td class='ewpsrc__item'> [[${loop.count}]] </td>
+                    <td class='ewpsrc__url'>
+                        <a t:href="stat.url" t:text="stat.url"></a>
+                    </td>
+                    <td class='ewpsrc__status' t:text="stat.status"></td>
+                    <td class='ewpsrv__details'><a t:href="|?url=${stat.url}|">details</a></td>
+                    <td class='ewpsrv__details'>
+                        <input type="hidden" class="ewp-manifest-url" t:value="stat.url"><a class='ewp-manifest-reloader'>reload now</a>
+                    </td>
+                    <td class='ewpsrv__details' t:if="isValidatorEnabled">
+                        <a t:href="|${manifestValidationUrl}?url=${stat.url}|">validate</a>
+                    </td>
+                </tr>
+            </tbody>
+        </table>
+
+        <script>
+            // The manifest URL is passed in a hidden input next to each reload link.
+            $(".ewp-manifest-url").each(function() {
+                $(this).next(".ewp-manifest-reloader").attr("data-manifest-url", this.value);
+            });
+        </script>
+    </section>
+</body>
+</html>
