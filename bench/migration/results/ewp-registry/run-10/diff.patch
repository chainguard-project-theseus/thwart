diff --git a/src/main/java/eu/erasmuswithoutpaper/registry/web/views/ManifestOverviewRow.java b/src/main/java/eu/erasmuswithoutpaper/registry/web/views/ManifestOverviewRow.java
new file mode 100644
index 0000000..08c5ee5
--- /dev/null
+++ b/src/main/java/eu/erasmuswithoutpaper/registry/web/views/ManifestOverviewRow.java
@@ -0,0 +1,106 @@
+package eu.erasmuswithoutpaper.registry.web.views;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.List;
+
+import eu.erasmuswithoutpaper.registry.manifestoverview.HostOverviewInfo;
+import eu.erasmuswithoutpaper.registry.manifestoverview.ImplementedApiInfo;
+import eu.erasmuswithoutpaper.registry.manifestoverview.ManifestOverviewInfo;
+
+/**
+ * A manifest, as listed in the "Implemented APIs and covered HEIs" section of the Manifests
+ * Overview page.
+ *
+ * @param url URL of the manifest.
+ * @param hosts hosts described in the manifest.
+ */
+public record ManifestOverviewRow(String url, List<Host> hosts) {
+
+  /**
+   * Number of covered HEIs listed in a single table row.
+   */
+  private static final int HEIS_PER_ROW = 5;
+
+  /**
+   * A host described in a manifest.
+   *
+   * @param number number of the host in the manifest, starting from 1.
+   * @param firstOfAllManifests true if this is the first host of all listed manifests.
+   * @param adminEmails admin emails of the host.
+   * @param adminProvider admin provider of the host, or null.
+   * @param adminNotes admin notes of the host.
+   * @param apisImplemented APIs implemented by the host.
+   * @param coveredHeiCount number of HEIs covered by the host.
+   * @param coveredHeiRows HEIs covered by the host, in rows of {@value #HEIS_PER_ROW}.
+   */
+  public record Host(int number, boolean firstOfAllManifests, List<String> adminEmails,
+      String adminProvider, List<String> adminNotes, List<Api> apisImplemented,
+      int coveredHeiCount, List<HeiRow> coveredHeiRows) {
+  }
+
+  /**
+   * An API implemented by a host.
+   *
+   * @param name name of the API.
+   * @param version version of the API.
+   * @param urls URLs of the API.
+   */
+  public record Api(String name, String version, List<String> urls) {
+  }
+
+  /**
+   * A row of covered HEIs.
+   *
+   * @param item true if the row is styled as an item (only the row added after a full last row
+   *     is not).
+   * @param heiIds IDs of the HEIs, padded with nulls to {@value #HEIS_PER_ROW} cells.
+   */
+  public record HeiRow(boolean item, List<String> heiIds) {
+  }
+
+  /**
+   * Build the rows for the given manifests.
+   *
+   * @param infos the manifests.
+   * @return the rows.
+   */
+  public static List<ManifestOverviewRow> fromInfos(Collection<ManifestOverviewInfo> infos) {
+    List<ManifestOverviewRow> result = new ArrayList<>();
+    boolean firstHost = true;
+    for (ManifestOverviewInfo info : infos) {
+      List<Host> hosts = new ArrayList<>();
+      int number = 1;
+      for (HostOverviewInfo host : info.getHosts()) {
+        List<Api> apis = new ArrayList<>();
+        for (ImplementedApiInfo api : host.apisImplemented) {
+          apis.add(new Api(api.getName(), api.getVersion().toString(), api.getUrls()));
+        }
+        hosts.add(new Host(number, firstHost, host.adminEmails, host.adminProvider,
+            host.adminNotes, apis, host.coveredHeiIds.size(), toHeiRows(host.coveredHeiIds)));
+        firstHost = false;
+        number++;
+      }
+      result.add(new ManifestOverviewRow(info.getUrl(), hosts));
+    }
+    return result;
+  }
+
+  private static List<HeiRow> toHeiRows(List<String> heiIds) {
+    List<HeiRow> rows = new ArrayList<>();
+    for (int start = 0; start < heiIds.size(); start += HEIS_PER_ROW) {
+      List<String> row =
+          new ArrayList<>(heiIds.subList(start, Math.min(start + HEIS_PER_ROW, heiIds.size())));
+      while (row.size() < HEIS_PER_ROW) {
+        row.add(null);
+      }
+      rows.add(new HeiRow(true, row));
+    }
+    if (heiIds.size() % HEIS_PER_ROW == 0) {
+      // A full row of empty cells follows the last full row.
+      rows.add(new HeiRow(false, Collections.nCopies(HEIS_PER_ROW, null)));
+    }
+    return rows;
+  }
+}
