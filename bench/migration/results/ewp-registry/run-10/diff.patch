@@ -0,0 +1,53 @@
+package eu.erasmuswithoutpaper.registry.validators;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Collections;
+import java.util.List;
+
+import eu.erasmuswithoutpaper.registry.templates.ValidationResultTemplate;
+
+import dev.tessera.runtime.RenderContext;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Tests for the <code>validationResult</code> template.
+ */
+public class ValidationResultTemplateTest {
+
+  @Test
+  public void testRendersReportWithSnapshots() {
+    ValidationReport.RequestSnapshot preliminary = new ValidationReport.RequestSnapshot("GET",
+        "https://example.com/a", null, Collections.emptyList(), Collections.emptyList(), null,
+        null);
+    ValidationReport.RequestSnapshot request = new ValidationReport.RequestSnapshot("POST",
+        "https://example.com/b", "abc123",
+        List.of(new ValidationReport.Header("X-Test", "<b>value</b>")),
+        List.of("<i>notice</i>"), "<body/>", "PGJvZHkvPg==");
+    ValidationReport.ResponseSnapshot response = new ValidationReport.ResponseSnapshot("500",
+        Collections.emptyList(), Collections.emptyList(), "<script>alert(1)</script>",
+        null, "YWJj");
+    ValidationReport.Test test = new ValidationReport.Test("Test <1>", "FAILURE", "Failed <2>",
+        true, true, 3, List.of(preliminary, request), List.of(response));
+    ValidationReport report = new ValidationReport(
+        new ValidationReport.Info("https://example.com/b", "echo", "2.0.0", "SecMethod",
+            List.of(new ValidationReport.SecurityLegendEntry("S", " Server")),
+            "2024-01-01T00:00:00.000Z", null, null),
