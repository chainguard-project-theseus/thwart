@@ -0,0 +1,52 @@
+package eu.erasmuswithoutpaper.registry.cmatrix;
+
+import java.util.List;
+
+/**
+ * The HEI/API coverage matrix, as rendered by the <code>coverage</code> template.
+ *
+ * @param rows rows of the matrix, one per HEI.
+ * @param footnotes footnotes listing the APIs not covered by the matrix columns.
+ */
+public record CoverageMatrix(List<Row> rows, List<Footnote> footnotes) {
+
+  /**
+   * A single row of the matrix.
+   *
+   * @param cells cells of the row.
+   */
+  public record Row(List<Cell> cells) {
+  }
+
+  /**
+   * A single cell of the matrix.
+   *
+   * @param classes CSS classes of the cell.
