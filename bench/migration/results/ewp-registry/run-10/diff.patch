@@ -0,0 +1,42 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.iia.HashComparisonResult"
+      t:params="boolean isUsingDevDesign, String cssFingerprint, String jsFingerprint, String xml, List<HashComparisonResult> hashComparisonResults, Boolean allResultsCorrect, String errorMessage"
+      t:replace="~{fragments/toolbar :: toolbar('IIA Hash Validator', isUsingDevDesign, cssFingerprint, jsFingerprint, null, ~{::body})}">
+<body t:remove="tag">
+<section class='ewp-section ewp-section-centered'>
+    <h2 class='ewp-section-title'>IIA Hash Validator</h2>
+
+    <form id="xml_form" method="post">
+        <p class="ewp-para">
+            Paste your IIA Get Response XML document below and press <button>Validate</button>
+        </p>
+        <label>
+            <textarea class="xml-text" name="xml" t:text="xml"></textarea>
+        </label>
+    </form>
+
+    <section id="result_section" t:if="hashComparisonResults != null">
+        <h3 class='ewp-section-title'>Result
+            <span class="ewp-manifest-validator-result" id="result_ok" t:if="allResultsCorrect">OK</span>
+            <span class="ewp-manifest-validator-result" id="result_error" t:unless="allResultsCorrect">Failed</span>
+        </h3>
+
+        <h3 class='ewp-section-title' t:if="hashComparisonResults.isEmpty()">No IIAs where found.</h3>
+
+        <t:block t:each="hashComparisonResult : hashComparisonResults">
+            <t:block t:unless="hashComparisonResult.correct">
+            <h4>Expected hash: [[${hashComparisonResult.hashExpected}]]</h4>
+            <label>
+                <p class="ewp-para">
+                    String used to calculate hash:
+                </p>
+                <textarea class="xml-text" t:text="hashComparisonResult.hashedString"></textarea>
+            </label>
+            </t:block>
+        </t:block>
+    </section>
+
+    <h4 t:if="errorMessage != null" t:text="errorMessage"></h4>
+</section>
+</body>
+</html>
