diff --git a/src/main/resources/templates/validationResult.html b/src/main/resources/templates/validationResult.html
new file mode 100644
index 0000000..36b99dc
--- /dev/null
+++ b/src/main/resources/templates/validationResult.html
@@ -0,0 +1,129 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="eu.erasmuswithoutpaper.registry.validators.ValidationReport"
+      t:params="ValidationReport report, boolean isUsingDevDesign, String cssFingerprint, String jsFingerprint"
+      t:replace="~{fragments/toolbar :: toolbar(|${report.info.apiName} validation result|, isUsingDevDesign, cssFingerprint, jsFingerprint, null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-validation-results'>
+        <h1 class='ewp-section-title'>
+            Result: <code class='ewpst__bordered' t:text="report.status"></code>
+        </h1>
+
+        <h2 class='ewp-section-title'>Basic info</h2>
+        <ul>
+            <li>
+                <p class='ewp-para'>Tested URL:
+                    <code class='ewpst__bordered-code'>
+                        <a t:href="report.info.url" t:text="report.info.url"></a></code>:
+                </p>
+            </li>
+            <li>
+                <p class='ewp-para'>API name: [[${report.info.apiName}]]</p>
+            </li>
+            <li>
+                <p class='ewp-para'>Version: [[${report.info.version}]]</p>
+            </li>
+            <li>
+                Security:<br>
+                <code class='ewpst__bordered-code-larger' t:text="report.info.security"></code> <br>
+                <t:block t:each="explanation : report.info.securityExplanation">
+                    <code class='ewpst__bordered-code-larger' t:text="explanation.marker"></code> - [[${explanation.description}]]<br>
+                </t:block>
+            </li>
+            <li>
+                Datetime validation started: <code class='ewpst__bordered-code' t:text="report.info.validationStarted"></code>
+            </li>
+            <li t:if="report.info.clientKeysRegenerated != null">
+                Datetime client keys regenerated:
+                <code class='ewpst__bordered-code' t:text="report.info.clientKeysRegenerated"></code>
+                ([[${report.info.clientKeysAgeWhenValidationStartedInSeconds}]]
+                seconds before validation)
+            </li>
+        </ul>
+
+        <h2 class='ewp-section-title'>Validation results</h2>
+
+        <button type="button" id="show_all_details">Show all details</button>
+        <button type="button" id="hide_all_details">Hide all details</button>
+
+        <table class='ewpsrc ewpsrc__test_validation-table'>
+        <tbody t:unless="report.tests.isEmpty()">
+        <t:block t:each="test, testStat : report.tests">
+            <tr class='ewpsrc__item'>
+                <td class='ewpsrc__test_index' t:rowspan="test.height">[[${testStat.count}]]</td>
+                <td t:class="|ewpsrc__item ewpsrc__test_text ewpsrc__item--status-${test.status}|" t:text="test.name"></td>
+                <td t:class="|ewpsrc__item ewpsrc__item--status-${test.status} ewpsrc__test_validation-status-code|">
+                    [[${test.status}]]
+                </td>
+            </tr>
+
+            <tr class='ewpsrc__item' t:if="test.hasMessage">
+                <td colspan='2' t:class="|ewpsrc__item ewpsrc__test_text ewpsrc__item--status-${test.status}|" t:text="test.message"></td>
+            </tr>
+
+            <tr class='ewpsrc__item' t:if="test.hasDetails">
+                <td colspan='2'>
+                <details>
+                <summary>
+                    Show/hide details
+                </summary>
+                <table class='ewpsrc ewpsrc__test_details-table'>
+                <tbody t:unless="test.requestSnapshots.isEmpty() and test.responseSnapshots.isEmpty()">
+                <tr class='ewpsrc__item' t:each="request, requestStat : test.requestSnapshots"><td>
+                    <details>
+                    <summary>
+                        <t:block t:if="requestStat.last">Actual request which was made (#-1)</t:block>
+                        <t:block t:unless="requestStat.last">Preliminary request snapshot (#-[[${requestStat.size - requestStat.index}]])</t:block>
+                    </summary>
+                    <p></p>
+                    <div t:replace="~{::keyValue('Method and URL', |${request.method} ${request.url}|, '')}"></div>
+                    <div t:replace="~{::keyValue('Client certificate fingerprint', request.clientCertFingerprint, '')}"></div>
+                    <t:block t:replace="~{::headers(request.headers, request.processingNotices)}"></t:block>
+                    <pre class="ewpsrc__test_message-body" t:if="request.body != null and !request.body.isEmpty()" t:text="request.body"></pre>
+                    <pre class="ewpsrc__test_message-body" t:if="(request.body == null or request.body.isEmpty()) and request.rawBodyBase64 != null and !request.rawBodyBase64.isEmpty()" t:text="request.rawBodyBase64"></pre>
+                    <p></p>
+                    </details>
+                </td></tr>
+
+                <tr class='ewpsrc__item' t:each="response, responseStat : test.responseSnapshots"><td>
+                    <details>
+                    <summary>
+                        <t:block t:if="responseStat.first">Response received from server (#+1)</t:block>
+                        <t:block t:unless="responseStat.first">Processed response snapshot (#+[[${responseStat.count}]])</t:block>
+                    </summary>
+                    <p></p>
+                    <div t:replace="~{::keyValue('HTTP status', response.status, '')}"></div>
+                    <t:block t:replace="~{::headers(response.headers, response.processingNotices)}"></t:block>
+                    <p class="ewpsrc__test_developer-message" t:if="response.developerMessage != null">Developer message:<br>[[${response.developerMessage}]]</p>
+                    <pre class="ewpsrc__test_message-body" t:if="response.rawBodyBase64 == null">(empty body)</pre>
+                    <pre class="ewpsrc__test_message-body" t:if="response.rawBodyBase64 != null and response.prettyXml != null" t:text="response.prettyXml"></pre>
+                    <pre class="ewpsrc__test_message-body" t:if="response.rawBodyBase64 != null and response.prettyXml == null" t:text="response.rawBodyBase64"></pre>
+                    </details>
+                </td></tr>
+                </tbody>
+                </table>
+
+                </details>
+                </td>
+            </tr>
+            <tr class='ewp-empty-row'></tr>
+
+        </t:block>
+        </tbody>
+        </table>
+
+    </section>
+</body>
+
+<div t:fragment="keyValue(String key, String value, String cls)" t:class="cls">
+    <span class='ewpsrc__test_key'>[[${key}]]:</span>
+    <span class='ewpsrc__test_value'>
+        <t:block t:if="value == null">(none)</t:block>
+        <t:block t:if="value != null">[[${value}]]</t:block>
+    </span>
+</div>
+
+<t:block t:fragment="headers(List<ValidationReport.Header> headers, List<String> notices)">
+    <t:block t:each="header : headers"><div t:replace="~{::keyValue(header.key, header.value, 'ewpsrc__test_http-header ')}"></div></t:block>
+    <p class="ewpsrc__test_processing-notice" t:each="notice : notices" t:text="notice"></p>
+</t:block>
+</html>
