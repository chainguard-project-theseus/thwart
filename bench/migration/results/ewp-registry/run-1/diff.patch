+package eu.erasmuswithoutpaper.registry.validators;
+
+import java.util.List;
+import java.util.Map;
+
+import eu.erasmuswithoutpaper.registry.web.SecurityLegendEntry;
+
+/**
+ * Data presented on the validation result page (see <code>templates/validationResult.html</code>).
+ *
+ * @param info basic info about the validation.
+ * @param success whether all tests succeeded.
+ * @param status the worst status of all tests.
+ * @param tests results of all tests.
+ */
+public record ValidationReport(Info info, boolean success, String status, List<TestStep> tests) {
+
+  /**
+   * Basic info about run tests.
+   *
+   * @param apiName name of tested API.
+   * @param url URL of tested API.
+   * @param version version of tested API.
+   * @param security description of used HTTP security.
+   * @param securityExplanation explanation of used HTTP security.
+   * @param validationStarted date when the validation started.
+   * @param clientKeysRegenerated date when client keys were regenerated, or null.
+   * @param clientKeysAgeWhenValidationStartedInSeconds age of client keys, or null.
+   */
+  public record Info(String apiName, String url, String version, String security,
+      List<SecurityLegendEntry> securityExplanation, String validationStarted,
+      String clientKeysRegenerated, String clientKeysAgeWhenValidationStartedInSeconds) {
+  }
+
+  /**
+   * Result of a single test.
+   *
+   * @param name test name.
+   * @param status test status.
+   * @param message test message.
+   * @param hasMessage whether the message should be shown.
+   * @param hasDetails whether there are any snapshots.
+   * @param height number of table rows used by this test.
+   * @param requestSnapshots request snapshots.
+   * @param responseSnapshots response snapshots.
+   */
+  public record TestStep(String name, String status, String message, boolean hasMessage,
+      boolean hasDetails, int height, List<RequestSnapshot> requestSnapshots,
+      List<ResponseSnapshot> responseSnapshots) {
+  }
+
+  /**
+   * Snapshot of a request.
+   *
+   * @param method HTTP method.
+   * @param url request URL.
+   * @param clientCertFingerprint client certificate fingerprint, or null.
+   * @param headers request headers.
+   * @param processingNoticesHtml processing notices.
+   * @param body request body decoded as UTF-8, or null.
+   * @param rawBodyBase64 request body encoded with Base64, or null.
+   */
+  public record RequestSnapshot(String method, String url, String clientCertFingerprint,
+      Map<String, String> headers, List<String> processingNoticesHtml, String body,
+      String rawBodyBase64) {
+  }
+
+  /**
+   * Snapshot of a response.
+   *
+   * @param status HTTP status.
+   * @param headers response headers.
+   * @param processingNoticesHtml processing notices.
+   * @param developerMessage developer message from the error response, or null.
+   * @param rawBodyBase64 response body encoded with Base64.
+   * @param prettyXml formatted XML body, or null.
+   */
+  public record ResponseSnapshot(int status, Map<String, String> headers,
+      List<String> processingNoticesHtml, String developerMessage, String rawBodyBase64,
+      String prettyXml) {
+  }
+}
