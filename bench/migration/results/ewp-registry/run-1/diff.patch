diff --git a/src/main/resources/templates/iiaHashValidator.html b/src/main/resources/templates/iiaHashValidator.html
new file mode 100644
index 0000000..e52fb98
--- /dev/null
+++ b/src/main/resources/templates/iiaHashValidator.html
@@ -0,0 +1,43 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="eu.erasmuswithoutpaper.registry.web.PageCommons, eu.erasmuswithoutpaper.registry.iia.HashComparisonResult"
+      t:params="PageCommons common, String xml, List<HashComparisonResult> hashComparisonResults, Boolean allResultsCorrect, String errorMessage"
+      t:replace="~{toolbar :: toolbar(common, 'IIA Hash Validator', null, ~{::body})}">
+<body t:remove="tag">
+<section class='ewp-section ewp-section-centered'>
+    <h2 class='ewp-section-title'>IIA Hash Validator</h2>
+
+    <form id="xml_form" method="post">
+        <p class="ewp-para">
+            Paste your IIA Get Response XML document below and press <button>Validate</button>
+        </p>
+        <label>
+            <textarea class="xml-text" name="xml" t:text="xml"></textarea>
+        </label>
+    </form>
+
+    <section id="result_section" t:if="hashComparisonResults != null">
+        <h3 class='ewp-section-title'>Result
+            <span class="ewp-manifest-validator-result" id="result_ok" t:if="allResultsCorrect == true">OK</span>
+            <span class="ewp-manifest-validator-result" id="result_error" t:unless="allResultsCorrect == true">Failed</span>
+        </h3>
+
+        <h3 class='ewp-section-title' t:if="hashComparisonResults.isEmpty()">No IIAs where found.</h3>
+
+        <t:block t:each="hashComparisonResult : hashComparisonResults">
+            <t:block t:unless="hashComparisonResult.correct">
+            <h4>Expected hash: [[${hashComparisonResult.hashExpected}]]</h4>
+            <label>
+                <p class="ewp-para">
+                    String used to calculate hash:
+                </p>
+                <textarea class="xml-text" t:text="hashComparisonResult.hashedString"></textarea>
+            </label>
+            </t:block>
+        </t:block>
+    </section>
+
+    <h4 t:if="errorMessage != null" t:text="errorMessage"></h4>
+</section>
+</body>
+</html>
