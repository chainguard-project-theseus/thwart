+ * Renders pages through the real view resolver and checks that user data is escaped.
+ */
+public class UiTemplatesIntegrationTest extends WRIntegrationTest {
+
+  @Autowired
+  private TestRestTemplate template;
+
+  @Test
+  public void testEmailIsEscaped() {
+    ResponseEntity<String> response =
+        this.template.getForEntity("/status?email={email}", String.class, "<script>x</script>");
+    assertThat(response.getStatusCode()).isEqualTo(HttpStatus.OK);
+    assertThat(response.getBody()).contains("Recipient Status Report");
+    assertThat(response.getBody()).doesNotContain("<script>x</script>");
+    assertThat(response.getBody()).contains("&lt;script&gt;x&lt;/script&gt;");
+  }
+
+  @Test
+  public void testHeiSearchPatternIsEscaped() {
+    ResponseEntity<String> response = this.template.getForEntity("/heiSearch?pattern={pattern}",
+        String.class, "\"><script>x</script>");
+    assertThat(response.getStatusCode()).isEqualTo(HttpStatus.OK);
+    assertThat(response.getBody()).contains("HEI Search Page");
+    assertThat(response.getBody()).doesNotContain("<script>x</script>");
+  }
+
+  @Test
+  public void testManifestUrlIsEscaped() {
+    ResponseEntity<String> response = this.template.getForEntity("/status?url={url}",
+        String.class, "https://example.com/<script>x</script>");
+    assertThat(response.getStatusCode()).isEqualTo(HttpStatus.OK);
+    assertThat(response.getBody()).contains("Unknown URL");
+    assertThat(response.getBody()).doesNotContain("<script>x</script>");
+  }
+}
