diff --git a/src/main/resources/templates/manifestsOverview.html b/src/main/resources/templates/manifestsOverview.html
new file mode 100644
index 0000000..bd0e2f3
--- /dev/null
+++ b/src/main/resources/templates/manifestsOverview.html
@@ -0,0 +1,136 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="eu.erasmuswithoutpaper.registry.web.PageCommons, eu.erasmuswithoutpaper.registry.manifestoverview.*"
+      t:params="PageCommons common, Collection<ManifestOverviewInfo> manifestInfos, ImplementedApisCount implementedApisCount, ApiForHeiImplementationMapping duplicatesInfo, CoveredInstitutionsCounters heiDuplicates"
+      t:replace="~{toolbar :: toolbar(common, 'Manifests Overview', null, ~{::body})}">
+<body t:remove="tag">
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifests Overview</h2>
+
+        <p class='ewp-para'>Currently defined manifest sources and overview of their contents.</p>
+
+        <div class="ewpsrc ewpsrc__section_with_top_margin">
+            <h2>Implemented APIs statistics</h2>
+                <table class="ewpsrc ewpsrc__api_stats_table" t:each="implementedApiCount : implementedApisCount.counts">
+                <tbody>
+                    <tr class="ewpsrc__item">
+                    <td colspan="3"><h4 t:text="implementedApiCount.name"></h4></td>
+                    </tr>
+                    <tr class="ewpsrc__item">
+                        <td>Version</td>
+                        <td>Hosts</td>
+                        <td>Institutions</td>
+                    </tr>
+                        <tr class="ewpsrc__item" t:each="versionsCounts : implementedApiCount.counts">
+                            <td t:text="versionsCounts.version"></td>
+                            <td t:text="versionsCounts.hostsCount"></td>
+                            <td t:text="versionsCounts.uniqueInstitutionsCount"></td>
+                        </tr>
+                </tbody>
+                </table>
+        </div>
+        <div class='ewpsrc ewpsrc__section_with_top_margin'>
+            <h2>Duplicates in the EWP Network</h2>
+            <h3>Duplicate (HEI, API) pairs on different hosts (with the same major version)</h3>
+                <div style="font-weight: bolder" t:if="duplicatesInfo.map.isEmpty()">
+                    No duplicates.
+                </div>
+                    <table class="ewpsrc ewpsrc__host_overview_info_table" t:each="entry : duplicatesInfo.map" t:with="apiAndHei=entry.key">
+                        <tr class="ewpsrc__item">
+                            <td colspan="2" t:text="apiAndHei.heiId"></td>
+                            <td colspan="2"> API: [[${apiAndHei.apiName}]]</td>
+                            <td colspan="1"> Major version: [[${apiAndHei.majorVersion}]]</td>
+                        </tr>
+                            <tr class="ewpsrc__item" t:each="implementingHostEntry : entry.value">
+                                <td colspan="3"> [[${implementingHostEntry.key.manifestUrl}]] </td>
+                                <td colspan="1"> Host: [[${implementingHostEntry.key.hostId}]] </td>
+                                <td colspan="1"> Versions: [[${strings.join(implementingHostEntry.value, ', ')}]]</td>
+                            </tr>
+                    </table>
+
+            <h3>Duplicate HEIs on the same host</h3>
+                <div style="font-weight: bolder" t:if="heiDuplicates.map.isEmpty()">
+                    No duplicates.
+                </div>
+                    <table class="ewpsrc ewpsrc__host_overview_info_table" t:each="entry : heiDuplicates.map" t:with="manifestAndHostId=entry.key">
+                        <tr class="ewpsrc__item">
+                            <td colspan="2" t:text="manifestAndHostId.manifestUrl"></td>
+                            <td colspan="1">Host [[${manifestAndHostId.hostId}]]</td>
+                        </tr>
+                            <tr class="ewpsrc__item" t:each="heiAndCount : entry.value">
+                                <td colspan="2"> [[${heiAndCount.key}]] </td>
+                                <td colspan="1"> Count: [[${heiAndCount.value}]] </td>
+                            </tr>
+                    </table>
+        </div>
+
+        <div class='ewpsrc ewpsrc__section_with_top_margin'>
+            <h2>Implemented APIs and covered HEIs</h2>
+            <table class="ewpsrc">
+            <t:block t:each="manifestOverviewInfo : manifestInfos">
+                <h3><a t:href="manifestOverviewInfo.url" t:text="manifestOverviewInfo.url"></a></h3>
+                <table class="ewpsrc__host_overview_info_table" t:each="hostOverviewInfo : manifestOverviewInfo.hosts">
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            <h4>HOST [[${hostOverviewInfoStat.count}]]</h4>
+                        </td>
+                    </tr>
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            Admin emails: ([[${hostOverviewInfo.adminEmails.size()}]])
+                        </td>
+                    </tr>
+
+                        <tr class="ewpsrc__item" t:each="email : hostOverviewInfo.adminEmails">
+                            <td colspan="5" t:text="email"></td>
+                        </tr>
+
+                        <tr class="ewpsrc__item" t:if="hostOverviewInfo.adminProvider != null">
+                            <td colspan="5">
+                                Admin provider: [[${hostOverviewInfo.adminProvider}]]
+                            </td>
+                        </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            Admin notes: ([[${hostOverviewInfo.adminNotes.size()}]])
+                        </td>
+                    </tr>
+                        <tr class="ewpsrc__item" t:each="note : hostOverviewInfo.adminNotes">
+                            <td colspan="5" t:text="note"></td>
+                        </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            APIs implemented: ([[${hostOverviewInfo.apisImplemented.size()}]])
+                        </td>
+                    </tr>
+                        <tr class="ewpsrc__item" t:each="apiImplementedInfo : hostOverviewInfo.apisImplemented">
+                            <td t:text="apiImplementedInfo.name"></td>
+                            <td t:text="apiImplementedInfo.version"></td>
+                            <td colspan="3">
+                                <t:block t:each="url : apiImplementedInfo.urls">
+                                    [[${url}]] <t:block t:unless="urlStat.last"> <br/> </t:block>
+                                </t:block>
+                            </td>
+                        </tr>
+
+                    <tr class="ewpsrc__item">
+                        <td colspan="5">
+                            Covered institutions: ([[${hostOverviewInfo.coveredHeiIdsCount}]])
+                        </td>
+                    </tr>
+                    <tr class="ewpsrc__item" t:each="row : hostOverviewInfo.coveredHeiIdRows">
+                        <td t:each="heiId : row" t:text="heiId"></td>
+                        <t:block t:if="rowStat.last and hostOverviewInfo.coveredHeiIdsPadding < 5">
+                            <td t:each="i : numbers.sequence(1, hostOverviewInfo.coveredHeiIdsPadding)"></td>
+                        </t:block>
+                    </tr>
+                    <tr t:if="hostOverviewInfo.coveredHeiIdsPadding == 5"><td t:each="i : numbers.sequence(1, 5)"></td></tr>
+                </table>
+            </t:block>
+            </table>
+        </div>
+    </section>
+</body>
+</html>
