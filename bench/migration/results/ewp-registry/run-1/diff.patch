diff --git a/src/main/java/eu/erasmuswithoutpaper/registry/cmatrix/CoverageMatrix.java b/src/main/java/eu/erasmuswithoutpaper/registry/cmatrix/CoverageMatrix.java
new file mode 100644
index 0000000..588a1aa
--- /dev/null
+++ b/src/main/java/eu/erasmuswithoutpaper/registry/cmatrix/CoverageMatrix.java
@@ -0,0 +1,52 @@
+package eu.erasmuswithoutpaper.registry.cmatrix;
+
+import java.util.List;
+
+/**
+ * The HEI/API coverage matrix, as presented by <code>templates/coverageMatrix.html</code>.
+ *
+ * @param rows table rows, one per HEI.
+ * @param footnotes footnotes listing APIs not described by any column.
+ */
+public record CoverageMatrix(List<Row> rows, List<Footnote> footnotes) {
+
+  /**
+   * A single table row.
+   *
+   * @param cells cells of this row.
+   */
+  public record Row(List<Cell> cells) {
+  }
+
+  /**
+   * A single table cell.
+   *
+   * @param colSpan number of columns spanned by this cell.
+   * @param classes CSS classes of this cell.
+   * @param simple if true, then the only line is rendered as plain text, without a wrapper.
+   * @param lines content lines of this cell.
+   */
+  public record Cell(int colSpan, String classes, boolean simple, List<Line> lines) {
+  }
+
+  /**
+   * A single content line of a cell.
+   *
+   * @param classes CSS classes of this line.
+   * @param title tooltip of this line, or null.
+   * @param text text of this line.
+   * @param link if not null, then the text links to this URL.
+   */
+  public record Line(String classes, String title, String text, String link) {
+  }
+
+  /**
+   * A footnote listing APIs not described by any column.
+   *
+   * @param id ID of the footnote element.
+   * @param heiId ID of the HEI.
+   * @param apis the APIs, as <code>{namespace}localName</code>.
+   */
+  public record Footnote(String id, String heiId, List<String> apis) {
+  }
+}
