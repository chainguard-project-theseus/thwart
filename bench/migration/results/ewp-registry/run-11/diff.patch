diff --git a/src/main/resources/templates/statusPerUrl.html b/src/main/resources/templates/statusPerUrl.html
new file mode 100644
index 0000000..3ddbbb0
--- /dev/null
+++ b/src/main/resources/templates/statusPerUrl.html
@@ -0,0 +1,85 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="eu.erasmuswithoutpaper.registry.web.view.PageCommons, eu.erasmuswithoutpaper.registry.updater.ManifestUpdateStatus"
+      t:params="PageCommons page, String manifestUrl, ManifestUpdateStatus status, boolean sourcePresent"
+      t:replace="~{layout/toolbar :: toolbarLayout('Manifest Status Report', page, false, ~{::section})}">
+<body>
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifest Status Report</h2>
+
+        <p class='ewp-para'>Manifest URL:
+        <code class='ewpst__bordered-code'><a t:href='manifestUrl' t:text='manifestUrl'></a></code></p>
+
+        <t:block t:if="!sourcePresent && status == null">
+            <p class='ewp-para'>
+                <b>Unknown URL:</b> This URL is not listed among the current Registry Service
+                manifest sources, nor any trace of it can be found in our logs.
+            </p>
+        </t:block>
+        <t:block t:if="!sourcePresent && status != null">
+            <p class='ewp-para'>
+                <b>Stale URL:</b> This URL was once listed among Registry Service sources, but
+                it is not anymore.
+            </p>
+            <p class='ewp-para'>
+                Last access attempt:
+                <code t:text="status.lastAccessAttemptFormatted"></code>
+            </p>
+        </t:block>
+        <t:block t:if="sourcePresent && status == null">
+            <p class='ewp-para'>
+                <b>New URL:</b> This URL is listed among the current Registry Service manifest
+                sources, but it hasn't been accessed yet. Please refresh this page.
+            </p>
+        </t:block>
+        <t:block t:if="sourcePresent && status != null">
+            <p class='ewp-para'>
+                Last access attempt:
+                <code class='ewpst__bordered-code' t:text="status.lastAccessAttemptFormatted"></code>
+                <br>
+                Last access status:
+                <code class='ewpst__bordered-code' t:text="status.lastAccessFlagStatus"></code>
+                <br>
+                <input type="hidden" class="ewp-manifest-url" t:value="manifestUrl"><a class='ewp-manifest-reload-link'>reload now</a>
+            </p>
+            <t:block t:if="!status.lastAccessNotices.isEmpty()">
+                <h2 class='ewp-section-title'>Last access notices</h2>
+
+                <table class='ewpsrc'>
+                    <tbody>
+                    <tr class='ewpsrc__item' t:each="notice : status.lastAccessNotices" t:classappend="|ewpsrc__item--status-${notice.severity}|">
+                        <td class='ewpsrc__status' t:text="notice.severity"></td>
+                        <td class='ewpsrc__message' t:utext="notices.html(notice.messageHtml)"></td>
+                    </tr>
+                    </tbody>
+                </table>
+            </t:block>
+        <script>
+            jQuery(function($) {
+                // The manifest URL is in the hidden input before each link.
+                $(".ewp-manifest-reload-link").on("click", function() {
+                    var self = $(this);
+                    $.ajax({
+                        url: "/reload",
+                        data: {
+                            url: self.prevAll("input.ewp-manifest-url").first().val()
+                        },
+                        method: 'POST'
+                    }).then(function() {
+                        var info = $("<span>Reload queued</span>");
+                        info.hide();
+                        self.replaceWith(info);
+                        info.fadeIn();
+                    }).catch(function() {
+                        var info = $("<span>Reload FAILED</span>");
+                        info.hide();
+                        self.replaceWith(info);
+                        info.fadeIn();
+                    });
+                });
+            });
+        </script>
+        </t:block>
+    </section>
+</body>
+</html>
