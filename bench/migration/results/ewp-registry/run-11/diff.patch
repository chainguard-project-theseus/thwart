diff --git a/src/main/java/eu/erasmuswithoutpaper/registry/cmatrix/CoverageMatrix.java b/src/main/java/eu/erasmuswithoutpaper/registry/cmatrix/CoverageMatrix.java
new file mode 100644
index 0000000..ad6c860
--- /dev/null
+++ b/src/main/java/eu/erasmuswithoutpaper/registry/cmatrix/CoverageMatrix.java
@@ -0,0 +1,52 @@
+package eu.erasmuswithoutpaper.registry.cmatrix;
+
+import java.util.List;
+
+/**
+ * The HEI/API coverage matrix, as rendered by the coverage page.
+ *
+ * @param rows rows of the matrix, one per HEI.
+ * @param footnotes footnotes listing the other APIs implemented by HEIs.
+ */
+public record CoverageMatrix(List<Row> rows, List<Footnote> footnotes) {
+
+  /**
+   * A row of the matrix.
+   *
+   * @param cells cells of the row.
+   */
+  public record Row(List<Cell> cells) {
+  }
+
+  /**
+   * A cell of the matrix.
+   *
+   * @param colSpan number of columns spanned.
+   * @param classes CSS classes, separated with spaces.
+   * @param simple whether the cell holds a single plain line, written without a wrapper.
+   * @param lines lines of content.
+   */
+  public record Cell(int colSpan, String classes, boolean simple, List<Line> lines) {
+  }
+
+  /**
+   * A line of content in a cell.
+   *
+   * @param classes CSS classes, separated with spaces.
+   * @param tooltip tooltip, or null.
+   * @param content text content.
+   * @param footnoteLink id of the footnote the content links to, or null.
+   */
+  public record Line(String classes, String tooltip, String content, String footnoteLink) {
+  }
+
+  /**
+   * A footnote listing the other APIs implemented by a HEI.
+   *
+   * @param id element id of the footnote.
+   * @param heiId the HEI id.
+   * @param apis the other APIs.
+   */
+  public record Footnote(String id, String heiId, List<String> apis) {
+  }
+}
