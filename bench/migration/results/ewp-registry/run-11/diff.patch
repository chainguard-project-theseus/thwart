--- /dev/null
+++ b/src/main/resources/templates/status.html
@@ -0,0 +1,59 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="eu.erasmuswithoutpaper.registry.web.view.PageCommons, eu.erasmuswithoutpaper.registry.updater.ManifestUpdateStatus"
+      t:params="PageCommons page, List<ManifestUpdateStatus> manifestStatuses, String manifestValidationUrl, boolean isValidatorEnabled"
+      t:replace="~{layout/toolbar :: toolbarLayout('Status of the EWP Manifest Importer', page, false, ~{::section})}">
+<body>
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifest Importer Status</h2>
+
+        <p class='ewp-para'>Currently defined manifest sources and their statuses:</p>
+
+        <table class='ewpsrc'>
+            <tbody t:if="!manifestStatuses.isEmpty()">
+                <tr class='ewpsrc__item' t:each="stat, st : manifestStatuses" t:classappend="|ewpsrc__item--status-${stat.lastAccessFlagStatus}|">
+                    <td class='ewpsrc__item' t:text="st.count"> 1 </td>
+                    <td class='ewpsrc__url'>
+                        <a t:href='stat.url' t:text='stat.url'></a>
+                    </td>
+                    <td class='ewpsrc__status' t:text="stat.lastAccessFlagStatus"></td>
+                    <td class='ewpsrv__details'><a t:href="|?url=${stat.url}|">details</a></td>
+                    <td class='ewpsrv__details'>
+                        <input type="hidden" class="ewp-manifest-url" t:value="stat.url"><a class='ewp-manifest-reload-link'>reload now</a>
+                    </td>
+                        <td class='ewpsrv__details' t:if="isValidatorEnabled">
+                            <a t:href="|${manifestValidationUrl}?url=${stat.url}|">validate</a>
+                        </td>
+                </tr>
+            </tbody>
+        </table>
+        <t:block t:if="!manifestStatuses.isEmpty()">
+        <script>
+            jQuery(function($) {
+                // The manifest URL is in the hidden input before each link.
+                $(".ewp-manifest-reload-link").on("click", function() {
+                    var self = $(this);
+                    $.ajax({
+                        url: "/reload",
+                        data: {
