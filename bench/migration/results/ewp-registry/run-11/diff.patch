@@ -0,0 +1,89 @@
+package eu.erasmuswithoutpaper.registry.validators;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Data shown on the validation result page, built by {@link HtmlValidationReportFormatter}.
+ *
+ * @param info basic info about the validation run.
+ * @param success whether all tests succeeded.
+ * @param status the worst status of all tests.
+ * @param tests descriptions of all run tests.
+ */
+public record ValidationReport(Info info, boolean success, String status, List<TestStep> tests) {
+
+  /**
+   * Basic info about the validation run.
+   *
+   * @param validationStarted formatted date when the validation started.
+   * @param clientKeysRegenerated formatted date when client keys were regenerated, or null.
+   * @param clientKeysAgeWhenValidationStartedInSeconds age of client keys, or null.
+   * @param security description of the used HTTP security.
+   * @param url tested URL.
+   * @param apiName tested API name.
+   * @param version tested API version.
+   * @param securityExplanation explanation of the used HTTP security.
+   */
+  public record Info(String validationStarted, String clientKeysRegenerated,
+      String clientKeysAgeWhenValidationStartedInSeconds, String security, String url,
+      String apiName, String version, List<Marker> securityExplanation) {
+  }
+
+  /**
+   * A security marker with its description.
+   *
+   * @param marker the marker.
+   * @param description its description.
+   */
+  public record Marker(String marker, String description) {
+  }
+
+  /**
+   * Description of a single test.
+   *
+   * @param name test name.
+   * @param status test status.
+   * @param message test message.
+   * @param requestSnapshots snapshots of requests made.
+   * @param responseSnapshots snapshots of responses received.
+   * @param hasMessage whether the message should be shown.
+   * @param hasDetails whether there are any snapshots.
+   * @param height number of table rows used by this test.
+   */
+  public record TestStep(String name, String status, String message,
+      List<RequestSnapshot> requestSnapshots, List<ResponseSnapshot> responseSnapshots,
+      boolean hasMessage, boolean hasDetails, int height) {
+  }
+
+  /**
+   * Snapshot of a request.
+   *
+   * @param method HTTP method.
+   * @param url request URL.
+   * @param clientCertFingerprint fingerprint of the client certificate, or null.
+   * @param headers request headers.
+   * @param processingNoticesHtml processing notices.
+   * @param body request body decoded as UTF-8, or null.
+   * @param rawBodyBase64 raw request body encoded in Base64, or null.
+   */
+  public record RequestSnapshot(String method, String url, String clientCertFingerprint,
+      Map<String, String> headers, List<String> processingNoticesHtml, String body,
+      String rawBodyBase64) {
+  }
+
+  /**
+   * Snapshot of a response.
+   *
+   * @param status HTTP status.
+   * @param headers response headers.
+   * @param processingNoticesHtml processing notices.
+   * @param developerMessage developer message from an error response, or null.
+   * @param prettyXml formatted XML body, or null.
+   * @param rawBodyBase64 raw response body encoded in Base64.
+   */
+  public record ResponseSnapshot(int status, Map<String, String> headers,
+      List<String> processingNoticesHtml, String developerMessage, String prettyXml,
+      String rawBodyBase64) {
+  }
+}
