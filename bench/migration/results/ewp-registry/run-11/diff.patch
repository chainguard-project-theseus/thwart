--- /dev/null
+++ b/src/main/java/eu/erasmuswithoutpaper/registry/web/view/ManifestsOverviewView.java
@@ -0,0 +1,109 @@
+package eu.erasmuswithoutpaper.registry.web.view;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.List;
+
+import eu.erasmuswithoutpaper.registry.manifestoverview.HostOverviewInfo;
+import eu.erasmuswithoutpaper.registry.manifestoverview.ImplementedApiInfo;
+import eu.erasmuswithoutpaper.registry.manifestoverview.ManifestOverviewInfo;
+
+/**
+ * The "Implemented APIs and covered HEIs" part of the Manifests Overview page.
+ *
+ * <p>
+ * The page used to write the manifest headings and host tables inside an outer table, which
+ * browsers rearrange: the headings up to the first host table end up before the (empty) outer
+ * table, and everything after it follows the outer table. This view keeps that structure.
+ * </p>
+ *
+ * @param leadingManifestUrls URLs of the manifests whose headings are written before the outer
+ *     table (up to, and including, the first manifest with any hosts).
+ * @param firstHosts hosts of the first manifest with any hosts.
+ * @param otherManifests manifests following the first manifest with any hosts.
+ */
+public record ManifestsOverviewView(List<String> leadingManifestUrls, List<HostView> firstHosts,
+    List<ManifestView> otherManifests) {
+
+  /**
+   * A manifest with its hosts.
+   *
+   * @param url manifest URL.
+   * @param hosts hosts described in the manifest.
+   */
+  public record ManifestView(String url, List<HostView> hosts) {
+  }
+
+  /**
+   * A host described in a manifest.
+   *
+   * @param adminEmails admin emails.
+   * @param adminProvider admin provider, or null.
+   * @param adminNotes admin notes.
+   * @param apisImplemented implemented APIs.
+   * @param coveredHeiIdsCount number of covered HEIs.
+   * @param coveredHeiRows covered HEIs, five per row.
+   */
+  public record HostView(List<String> adminEmails, String adminProvider, List<String> adminNotes,
+      List<ImplementedApiInfo> apisImplemented, int coveredHeiIdsCount,
+      List<CellRow> coveredHeiRows) {
+  }
+
+  /**
+   * A row of covered HEI ids.
+   *
+   * @param styled whether the row has the item class.
+   * @param cells HEI ids, empty strings for padding cells.
+   */
+  public record CellRow(boolean styled, List<String> cells) {
+  }
+
+  private static final int CELLS_PER_ROW = 5;
+
+  /**
+   * @param infos manifest overview infos.
+   * @return the view.
+   */
+  public static ManifestsOverviewView fromInfos(Collection<ManifestOverviewInfo> infos) {
+    List<String> leading = new ArrayList<>();
+    List<HostView> firstHosts = Collections.emptyList();
+    List<ManifestView> others = new ArrayList<>();
+    boolean foundHosts = false;
+    for (ManifestOverviewInfo info : infos) {
+      List<HostView> hosts = new ArrayList<>();
+      for (HostOverviewInfo host : info.getHosts()) {
+        hosts.add(toHostView(host));
+      }
+      if (foundHosts) {
+        others.add(new ManifestView(info.getUrl(), hosts));
+      } else {
+        leading.add(info.getUrl());
+        if (!hosts.isEmpty()) {
+          foundHosts = true;
+          firstHosts = hosts;
+        }
+      }
+    }
+    return new ManifestsOverviewView(leading, firstHosts, others);
+  }
+
+  private static HostView toHostView(HostOverviewInfo host) {
+    List<CellRow> rows = new ArrayList<>();
+    List<String> ids = host.coveredHeiIds;
+    for (int i = 0; i < ids.size(); i += CELLS_PER_ROW) {
+      List<String> cells =
+          new ArrayList<>(ids.subList(i, Math.min(i + CELLS_PER_ROW, ids.size())));
+      while (cells.size() < CELLS_PER_ROW) {
+        cells.add("");
+      }
+      rows.add(new CellRow(true, cells));
+    }
+    if (ids.size() % CELLS_PER_ROW == 0) {
+      // The page always added padding cells; after a full row a browser put them in a new row.
+      rows.add(new CellRow(false, Collections.nCopies(CELLS_PER_ROW, "")));
+    }
+    return new HostView(host.adminEmails, host.adminProvider, host.adminNotes,
+        host.apisImplemented, ids.size(), rows);
+  }
+}
