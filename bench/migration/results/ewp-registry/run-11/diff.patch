+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="eu.erasmuswithoutpaper.registry.web.view.PageCommons, eu.erasmuswithoutpaper.registry.validators.ValidationReport"
+      t:params="PageCommons page, ValidationReport report"
+      t:replace="~{layout/toolbar :: toolbarLayout(|${report.info.apiName} validation result|, page, false, ~{::section})}">
+<body>
+    <section class='ewp-section ewp-section-validation-results'>
+        <h1 class='ewp-section-title'>
+            Result: <code class='ewpst__bordered' t:text="report.status">SUCCESS</code>
+        </h1>
+
+        <h2 class='ewp-section-title'>Basic info</h2>
+        <ul>
+            <li>
+                <p class='ewp-para'>Tested URL:
+                    <code class='ewpst__bordered-code'>
+                        <a t:href='report.info.url' t:text='report.info.url'></a></code>:
+                </p>
+            </li>
+            <li>
+                <p class='ewp-para'>API name: <t:block t:text="report.info.apiName"></t:block></p>
+            </li>
+            <li>
+                <p class='ewp-para'>Version: <t:block t:text="report.info.version"></t:block></p>
+            </li>
+            <li>
+                Security:<br>
+                <code class='ewpst__bordered-code-larger' t:text="report.info.security"></code> <br>
+                <t:block t:each="explanation : report.info.securityExplanation">
+                    <code class='ewpst__bordered-code-larger' t:text="explanation.marker"></code> - <t:block t:text="explanation.description"></t:block><br>
+                </t:block>
+            </li>
+            <li>
+                Datetime validation started: <code class='ewpst__bordered-code' t:text="report.info.validationStarted"></code>
+            </li>
+            <li t:if="report.info.clientKeysRegenerated != null">
+                Datetime client keys regenerated:
+                <code class='ewpst__bordered-code' t:text="report.info.clientKeysRegenerated"></code>
+                (<t:block t:text="report.info.clientKeysAgeWhenValidationStartedInSeconds"></t:block>
+                seconds before validation)
+            </li>
+        </ul>
+
+        <h2 class='ewp-section-title'>Validation results</h2>
+
+        <button type="button" id="show_all_details">Show all details</button>
+        <button type="button" id="hide_all_details">Hide all details</button>
+
+        <table class='ewpsrc ewpsrc__test_validation-table'>
+        <tbody t:if="!report.tests.isEmpty()">
+        <t:block t:each="test, testStat : report.tests">
+            <tr class='ewpsrc__item'>
+                <td class='ewpsrc__test_index' t:rowspan='test.height' t:text="testStat.count">1</td>
+                <td class='ewpsrc__item ewpsrc__test_text' t:classappend="|ewpsrc__item--status-${test.status}|" t:text="test.name"></td>
+                <td class='ewpsrc__item' t:classappend="|ewpsrc__item--status-${test.status} ewpsrc__test_validation-status-code|" t:text="test.status">
+                </td>
+            </tr>
+
+            <tr class='ewpsrc__item' t:if="test.hasMessage">
+                <td colspan='2' class='ewpsrc__item ewpsrc__test_text' t:classappend="|ewpsrc__item--status-${test.status}|" t:text="test.message"></td>
+            </tr>
+
+            <tr class='ewpsrc__item' t:if="test.hasDetails">
+                <td colspan='2'>
+                <details>
+                <summary>
+                    Show/hide details
+                </summary>
+                <table class='ewpsrc ewpsrc__test_details-table'>
+                <tbody t:if="!test.requestSnapshots.isEmpty() || !test.responseSnapshots.isEmpty()">
+                <tr class='ewpsrc__item' t:each="request, requestStat : test.requestSnapshots"><td>
+                    <details>
+                    <summary>
+                        <t:block t:if="requestStat.last">Actual request which was made (#-1)</t:block>
+                        <t:block t:unless="requestStat.last">Preliminary request snapshot (#-<t:block t:text="requestStat.size - requestStat.index"></t:block>)</t:block>
+                    </summary>
+                    <p></p>
+                    <t:block t:replace="~{fragments/validationReport :: printRequest(request)}"></t:block>
+                    <p></p>
+                    </details>
+                </td></tr>
+
+                <tr class='ewpsrc__item' t:each="response, responseStat : test.responseSnapshots"><td>
+                    <details>
+                    <summary>
+                        <t:block t:if="responseStat.first">Response received from server (#+1)</t:block>
+                        <t:block t:unless="responseStat.first">Processed response snapshot (#+<t:block t:text="responseStat.count"></t:block>)</t:block>
+                    </summary>
+                    <p></p>
+                    <t:block t:replace="~{fragments/validationReport :: printResponse(response)}"></t:block>
+                    <p></p>
+                    </details>
+                </td></tr>
+                </tbody>
+                </table>
+
+                </details>
+                </td>
+            </tr>
+            <tr class='ewp-empty-row'></tr>
+
+        </t:block>
+        </tbody>
+        </table>
+
+    </section>
+</body>
+</html>
