diff --git a/src/main/resources/templates/manifestsOverview.html b/src/main/resources/templates/manifestsOverview.html
new file mode 100644
index 0000000..e73770c
--- /dev/null
+++ b/src/main/resources/templates/manifestsOverview.html
@@ -0,0 +1,91 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="eu.erasmuswithoutpaper.registry.web.view.PageCommons, eu.erasmuswithoutpaper.registry.web.view.ManifestsOverviewView, eu.erasmuswithoutpaper.registry.manifestoverview.*"
+      t:params="PageCommons page, ManifestsOverviewView manifestInfos, ImplementedApisCount implementedApisCount, ApiForHeiImplementationMapping duplicatesInfo, CoveredInstitutionsCounters heiDuplicates"
+      t:replace="~{layout/toolbar :: toolbarLayout('Manifests Overview', page, false, ~{::section})}">
+<body>
+    <section class='ewp-section ewp-section-centered'>
+        <h2 class='ewp-section-title'>Manifests Overview</h2>
+
+        <p class='ewp-para'>Currently defined manifest sources and overview of their contents.</p>
+
+        <div class="ewpsrc ewpsrc__section_with_top_margin">
+            <h2>Implemented APIs statistics</h2>
+                <table class="ewpsrc ewpsrc__api_stats_table" t:each="implementedApiCount : implementedApisCount.counts">
+                <tbody>
+                    <tr class="ewpsrc__item">
+                    <td colspan="3"><h4 t:text="implementedApiCount.name"></h4></td>
+                    </tr>
+                    <tr class="ewpsrc__item">
+                        <td>Version</td>
+                        <td>Hosts</td>
+                        <td>Institutions</td>
+                    </tr>
+                        <tr class="ewpsrc__item" t:each="versionsCounts : implementedApiCount.counts">
+                            <td t:text="versionsCounts.version"></td>
+                            <td t:text="versionsCounts.hostsCount"></td>
+                            <td t:text="versionsCounts.uniqueInstitutionsCount"></td>
+                        </tr>
+                </tbody>
+                </table>
+        </div>
+        <div class='ewpsrc ewpsrc__section_with_top_margin'>
+            <h2>Duplicates in the EWP Network</h2>
+            <h3>Duplicate (HEI, API) pairs on different hosts (with the same major version)</h3>
+                <div style="font-weight: bolder" t:if="duplicatesInfo.map.isEmpty()">
+                    No duplicates.
+                </div>
+                <t:block t:unless="duplicatesInfo.map.isEmpty()">
+                    <table class="ewpsrc ewpsrc__host_overview_info_table" t:each="entry : duplicatesInfo.map">
+                        <tbody>
+                        <tr class="ewpsrc__item">
+                            <td colspan="2" t:text="entry.key.heiId"></td>
+                            <td colspan="2"> API: <t:block t:text="entry.key.apiName"></t:block></td>
+                            <td colspan="1"> Major version: <t:block t:text="entry.key.majorVersion"></t:block></td>
+                        </tr>
+                            <tr class="ewpsrc__item" t:each="implementingHostEntry : entry.value">
+                                <td colspan="3" t:text="implementingHostEntry.key.manifestUrl"></td>
+                                <td colspan="1"> Host: <t:block t:text="implementingHostEntry.key.hostId"></t:block> </td>
+                                <td colspan="1"> Versions: <t:block t:text="strings.join(implementingHostEntry.value, ', ')"></t:block></td>
+                            </tr>
+                        </tbody>
+                    </table>
+                </t:block>
+
+            <h3>Duplicate HEIs on the same host</h3>
+                <div style="font-weight: bolder" t:if="heiDuplicates.map.isEmpty()">
+                    No duplicates.
+                </div>
+                <t:block t:unless="heiDuplicates.map.isEmpty()">
+                    <table class="ewpsrc ewpsrc__host_overview_info_table" t:each="entry : heiDuplicates.map">
+                        <tbody>
+                        <tr class="ewpsrc__item">
+                            <td colspan="2" t:text="entry.key.manifestUrl"></td>
+                            <td colspan="1">Host <t:block t:text="entry.key.hostId"></t:block></td>
+                        </tr>
+                            <tr class="ewpsrc__item" t:each="heiAndCount : entry.value">
+                                <td colspan="2" t:text="heiAndCount.key"></td>
+                                <td colspan="1"> Count: <t:block t:text="heiAndCount.value"></t:block> </td>
+                            </tr>
+                        </tbody>
+                    </table>
+                </t:block>
+        </div>
+
+        <div class='ewpsrc ewpsrc__section_with_top_margin'>
+            <h2>Implemented APIs and covered HEIs</h2>
+            <h3 t:each="url : manifestInfos.leadingManifestUrls"><a t:href="url" t:text="url"></a></h3>
+            <table class="ewpsrc"></table>
+            <t:block t:each="hostOverviewInfo, hostStat : manifestInfos.firstHosts">
+                <table t:replace="~{fragments/manifestsOverview :: host(hostOverviewInfo, hostStat.count)}"></table>
+            </t:block>
+            <t:block t:each="manifestOverviewInfo : manifestInfos.otherManifests">
+                <h3><a t:href="manifestOverviewInfo.url" t:text="manifestOverviewInfo.url"></a></h3>
+                <t:block t:each="hostOverviewInfo, hostStat : manifestOverviewInfo.hosts">
+                    <table t:replace="~{fragments/manifestsOverview :: host(hostOverviewInfo, hostStat.count)}"></table>
+                </t:block>
+            </t:block>
+        </div>
+    </section>
+</body>
+</html>
