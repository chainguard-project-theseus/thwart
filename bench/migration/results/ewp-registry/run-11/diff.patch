+package eu.erasmuswithoutpaper.registry.web.view;
+
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Template functions for manifest update notices.
+ */
+@TemplateFunctions("notices")
+public final class NoticeFunctions {
+
+  /**
+   * The markup used by the notices built in the updater and the manifest constraints.
+   */
+  private static final HtmlPolicy POLICY = HtmlPolicy.builder()
+      .allowElements("p", "br", "b", "code", "ul", "li", "a")
+      .linkRel()
+      .build();
+
+  private NoticeFunctions() {
+  }
+
+  /**
+   * @param messageHtml HTML of a notice, as stored with the manifest update status.
+   * @return the sanitized HTML.
+   */
+  @TemplateFunction
+  public static SafeHtml html(String messageHtml) {
+    return SafeHtml.sanitize(messageHtml, POLICY);
+  }
+}
