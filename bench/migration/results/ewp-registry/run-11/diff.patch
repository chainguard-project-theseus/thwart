diff --git a/src/main/resources/templates/fragments/validationReport.html b/src/main/resources/templates/fragments/validationReport.html
new file mode 100644
index 0000000..dda6482
--- /dev/null
+++ b/src/main/resources/templates/fragments/validationReport.html
@@ -0,0 +1,37 @@
+<t:block xmlns:t="https://tessera.dev"
+         t:import="eu.erasmuswithoutpaper.registry.validators.ValidationReport">
+
+<div t:fragment="printKeyValue(String key, String value, String cssClass)" t:class='cssClass'>
+    <span class='ewpsrc__test_key' t:text="|${key}:|">key:</span>
+    <span class='ewpsrc__test_value'>
+        <t:block t:if="value == null">(none)</t:block>
+        <t:block t:unless="value == null" t:text="value"></t:block>
+    </span>
+</div>
+
+<t:block t:fragment="printHeaders(Map<String, String> headers, List<String> processingNotices)">
+    <t:block t:each="header : headers">
+        <div t:replace="~{::printKeyValue(header.key, header.value, 'ewpsrc__test_http-header ')}"></div>
+    </t:block>
+
+    <p class="ewpsrc__test_processing-notice" t:each="notice : processingNotices" t:text="notice"></p>
+</t:block>
+
+<t:block t:fragment="printRequest(ValidationReport.RequestSnapshot request)">
+    <div t:replace="~{::printKeyValue('Method and URL', |${request.method} ${request.url}|, '')}"></div>
+    <div t:replace="~{::printKeyValue('Client certificate fingerprint', request.clientCertFingerprint, '')}"></div>
+    <t:block t:replace="~{::printHeaders(request.headers, request.processingNoticesHtml)}"></t:block>
+    <pre class="ewpsrc__test_message-body" t:if="request.body != null && !request.body.isEmpty()" t:text="request.body"></pre>
+    <pre class="ewpsrc__test_message-body" t:if="(request.body == null || request.body.isEmpty()) && request.rawBodyBase64 != null && !request.rawBodyBase64.isEmpty()" t:text="request.rawBodyBase64"></pre>
+</t:block>
+
+<t:block t:fragment="printResponse(ValidationReport.ResponseSnapshot response)">
+    <div t:replace="~{::printKeyValue('HTTP status', |${response.status}|, '')}"></div>
+    <t:block t:replace="~{::printHeaders(response.headers, response.processingNoticesHtml)}"></t:block>
+    <p class="ewpsrc__test_developer-message" t:if="response.developerMessage != null">Developer message:<br><t:block t:text="response.developerMessage"></t:block></p>
+    <pre class="ewpsrc__test_message-body" t:if="response.rawBodyBase64 == null">(empty body)</pre>
+    <pre class="ewpsrc__test_message-body" t:if="response.rawBodyBase64 != null && response.prettyXml != null" t:text="response.prettyXml"></pre>
+    <pre class="ewpsrc__test_message-body" t:if="response.rawBodyBase64 != null && response.prettyXml == null" t:text="response.rawBodyBase64"></pre>
+</t:block>
+
+</t:block>
