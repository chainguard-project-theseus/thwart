+    <tr>
+      <th>Date</th>
+      <th>Description</th>
+    </tr>
+    <t:block t:if="pet != null"><tr t:each="visit : pet.visits" t:unless="visit.isNew()">
+      <td t:text="visit.date">date</td>
+      <td t:text="visit.description">description</td>
+    </tr></t:block>
+  </table>
+
+</body>
+</html>
