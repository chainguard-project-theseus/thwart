+
+  <h2>
+    <t:block t:if="visit?.isNew() == true">New </t:block> Visit
+  </h2>
+
+  <t:block t:if="pet != null">
+  <b>Pet</b>
+  <table class="table table-striped">
+    <thead>
+      <tr>
+        <th>Name</th>
+        <th>Birth Date</th>
+        <th>Type</th>
+        <th>Owner</th>
+      </tr>
+    </thead>
+    <tr>
+      <td t:text="pet.name">name</td>
+      <td t:text="pet.birthDate">birthDate</td>
+      <td t:text="pet.type?.name">type</td>
+      <td t:if="pet.owner != null">[[${pet.owner.firstName}]] [[${pet.owner.lastName}]]</td>
+    </tr>
+  </table>
+  </t:block>
+
+  <form class="form-horizontal" method="post">
+    <div class="form-group has-feedback">
+    </div>
