@@ -0,0 +1,59 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev"
+      t:import="org.springframework.samples.petclinic.system.Application, org.springframework.samples.petclinic.owner.Pet, org.springframework.samples.petclinic.visit.Visit"
+      t:params="List<Application.Menu> menus, Pet pet, Visit visit"
+      t:replace="~{fragments/layout :: layout(menus, ~{::body})}">
+
+  <body t:remove="tag">
+
+  <h2>
+    <t:block t:if="visit != null and visit.isNew()">New </t:block> Visit
+  </h2>
+
+  <t:block t:if="pet != null">
+  <b>Pet</b>
+  <table class="table table-striped">
+    <thead>
+      <tr>
+        <th>Name</th>
+        <th>Birth Date</th>
+        <th>Type</th>
+        <th>Owner</th>
+      </tr>
+    </thead>
+    <tr>
+      <td t:text="pet.name">name</td>
+      <td t:text="pet.birthDate">birthDate</td>
+      <td t:text="pet.type?.name">type</td>
+      <td t:if="pet.owner != null">[[${pet.owner.firstName}]] [[${pet.owner.lastName}]]</td>
+    </tr>
+  </table>
+  </t:block>
+
+  <form class="form-horizontal" method="post">
+    <div class="form-group has-feedback">
+    </div>
+    <div class="form-group">
+      <div class="col-sm-offset-2 col-sm-10">
+        <input type="hidden" name="petId" th:value="${pet.id}" />
+        <button class="btn btn-primary" type="submit">Add Visit</button>
+      </div>
+    </div>
+  </form>
+
+  <br />
+  <b>Previous Visits</b>
+  <table class="table table-striped">
+    <tr>
+      <th>Date</th>
+      <th>Description</th>
+    </tr>
+    <tr t:each="pastVisit : pet?.visits" t:unless="pastVisit.isNew()">
+      <td t:text="pastVisit.date">date</td>
+      <td t:text="pastVisit.description">description</td>
+    </tr>
+  </table>
+
+  </body>
+
+</html>
