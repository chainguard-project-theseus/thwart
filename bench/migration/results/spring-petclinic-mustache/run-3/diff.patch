+<!doctype html>
+<html xmlns:t="https://tessera.dev"
+      t:import="org.springframework.samples.petclinic.system.Application, org.springframework.samples.petclinic.owner.Owner"
+      t:params="List<Application.Menu> menus, Owner owner"
+      t:replace="~{fragments/layout :: layout(menus, ~{::body})}">
+
+  <body t:remove="tag">
+
+    <h2>Owner Information</h2>
+
+
+    <t:block t:if="owner != null">
+    <table class="table table-striped">
+      <tr>
+        <th>Name</th>
+        <td><b>[[${owner.firstName}]] [[${owner.lastName}]]</b></td>
+      </tr>
+      <tr>
+        <th>Address</th>
+        <td t:text="owner.address">address</td>
+      </tr>
+      <tr>
+        <th>City</th>
+        <td t:text="owner.city">city</td>
+      </tr>
+      <tr>
+        <th>Telephone</th>
+        <td t:text="owner.telephone">telephone</td>
+      </tr>
+    </table>
+
+    <a t:href="@{{ownerId}/edit(ownerId=owner.id)}" class="btn btn-primary">Edit
+      Owner</a>
+    <a t:href="@{{ownerId}/pets/new(ownerId=owner.id)}" class="btn btn-primary">Add
+      New Pet</a>
+
+    <br />
+    <br />
+    <br />
+    <h2>Pets and Visits</h2>
+
+    <table class="table table-striped">
+
+      <tr t:each="pet : owner.pets">
+        <td valign="top">
+          <dl class="dl-horizontal">
+            <dt>Name</dt>
+            <dd t:text="pet.name">name</dd>
+            <dt>Birth Date</dt>
+            <dd>
+              [[${pet.birthDate}]]</dd>
+            <dt>Type</dt>
+            <dd t:text="pet.type?.name">type</dd>
+          </dl>
+        </td>
+        <td valign="top">
+          <table class="table-condensed">
+            <thead>
+              <tr>
+                <th>Visit Date</th>
+                <th>Description</th>
+              </tr>
+            </thead>
+            <tr t:each="visit : pet.visits">
+              <td t:text="visit.date">date</td>
+              <td t:text="visit.description">description</td>
+            </tr>
+            <tr>
+              <td><a t:href="@{{ownerId}/pets/{petId}/edit(ownerId=owner.id, petId=pet.id)}">Edit
+                  Pet</a></td>
+              <td><a t:href="@{{ownerId}/pets/{petId}/visits/new(ownerId=owner.id, petId=pet.id)}">Add
+                  Visit</a></td>
+            </tr>
+          </table>
+        </td>
+      </tr>
+
+    </table>
+    </t:block>
+
+  </body>
+
+</html>
