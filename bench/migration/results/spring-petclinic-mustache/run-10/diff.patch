+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.system.*, org.springframework.samples.petclinic.owner.*" t:params="List<MenuItem> menus, Owner owner"
+      t:replace="~{fragments/layout :: layout(menus, ~{::body}, true)}">
