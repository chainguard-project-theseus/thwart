+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.system.*, org.springframework.samples.petclinic.owner.*, org.springframework.samples.petclinic.visit.*, org.springframework.samples.petclinic.vet.*" t:params="List<MenuItem> menus, boolean hasPages, List<PageLink> pages, boolean first, boolean last, int previous, int next, int totalPages, List<Vet> listVets"
+      t:replace="~{fragments/layout :: layout(menus, ~{::body}, true)}">
+<body t:remove="tag">
+
+  <h2>Veterinarians</h2>
+
+  <table id="vets" class="table table-striped">
+    <thead>
+      <tr>
+        <th>Name</th>
+        <th>Specialties</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr t:each="vet : listVets">
+        <td>[[${vet.firstName}]] [[${vet.lastName}]]</td>
+        <td><t:block t:each="specialty : vet.specialties"><span t:text="specialty.name">surgery</span> </t:block>
+        <span t:unless="vet.special">none</span></td>
+      </tr>
+    </tbody>
+  </table>
+
+    <div t:if="hasPages">
+        <span>Pages:</span>
+        <span>[</span>
+        <span t:each="p : pages">
+            <a t:unless="p.current" t:href="@{/vets.html(page=${p.number})}" t:text="p.number">1</a>
+            <span t:if="p.current" t:text="p.number">1</span>
+        </span>
+        <span>]&nbsp;</span>
+        <span>
+            <a t:unless="first" t:href="@{/vets.html(page=1)}" title="First"
+                class="fa fa-fast-backward"></a>
+            <span t:if="first" title="First" class="fa fa-fast-backward"></span>
+        </span>
+        <span>
+            <a t:unless="first" t:href="@{/vets.html(page=${previous})}" title="Previous"
+                class="fa fa-step-backward"></a>
+            <span t:if="first" title="Previous" class="fa fa-step-backward"></span>
+        </span>
+        <span>
+            <a t:unless="last" t:href="@{/vets.html(page=${next})}" title="Next"
+                class="fa fa-step-forward"></a>
+            <span t:if="last" title="Next" class="fa fa-step-forward"></span>
+        </span>
+        <span>
+            <a t:unless="last" t:href="@{/vets.html(page=${totalPages})}" title="Last"
+                class="fa fa-fast-forward"></a>
+            <span t:if="last" title="Last" class="fa fa-fast-forward"></span>
+        </span>
+    </div>
+
+</body>
+</html>
