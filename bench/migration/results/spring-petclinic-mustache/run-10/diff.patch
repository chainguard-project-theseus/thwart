+
+    <h2>Owner Information</h2>
+
+
+    <table class="table table-striped">
+      <tr>
+        <th>Name</th>
+        <td><b>[[${owner.firstName}]] [[${owner.lastName}]]</b></td>
+      </tr>
+      <tr>
+        <th>Address</th>
+        <td t:text="owner.address">address</td>
+      </tr>
+      <tr>
+        <th>City</th>
+        <td t:text="owner.city">city</td>
+      </tr>
+      <tr>
+        <th>Telephone</th>
+        <td t:text="owner.telephone">telephone</td>
+      </tr>
+    </table>
+
+    <a t:href="|${owner.id}/edit|" class="btn btn-primary">Edit
+      Owner</a>
+    <a t:href="|${owner.id}/pets/new|" class="btn btn-primary">Add
+      New Pet</a>
+
+    <br />
+    <br />
+    <br />
+    <h2>Pets and Visits</h2>
+
+    <table class="table table-striped"><tbody>
+
+      <tr t:each="pet : owner.pets">
+        <td valign="top">
+          <dl class="dl-horizontal">
+            <dt>Name</dt>
+            <dd t:text="pet.name">name</dd>
+            <dt>Birth Date</dt>
+            <dd>
+              [[${pet.birthDate}]]</dd>
+            <dt>Type</dt>
+            <dd t:text="pet.type?.name">type</dd>
+          </dl>
+        </td>
+        <td valign="top">
+          <table class="table-condensed">
+            <thead>
+              <tr>
+                <th>Visit Date</th>
+                <th>Description</th>
+              </tr>
+            </thead><tbody>
+            <tr t:each="visit : pet.visits">
+              <td t:text="visit.date">date</td>
+              <td t:text="visit.description">description</td>
+            </tr>
+            <tr>
+              <td><a t:href="|${owner.id}/pets/${pet.id}/edit|">Edit
+                  Pet</a></td>
+              <td><a t:href="|${owner.id}/pets/${pet.id}/visits/new|">Add
+                  Visit</a></td>
+            </tr>
+          </tbody></table>
+        </td>
+      </tr>
+
+    </tbody></table>
+
+</body>
+</html>
