+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.system.*, org.springframework.samples.petclinic.owner.*, org.springframework.samples.petclinic.visit.*, org.springframework.samples.petclinic.vet.*" t:params="List<MenuItem> menus, Pet pet, Collection<PetType> types"
+      t:replace="~{fragments/layout :: layout(menus, ~{::body}, true)}">
+<body t:remove="tag">
+
+  <h2>
+    <t:block t:if="pet.isNew()">New </t:block>Pet
+  </h2>
+  <form class="form-horizontal" method="post" t:object="pet">
+    <input type="hidden" name="id" th:value="*{id}" />
+    <div class="form-group has-feedback">
+      <div class="form-group">
+        <label class="col-sm-2 control-label">Owner</label>
+        <div class="col-sm-10">
+          <span t:if="pet.owner != null">[[${pet.owner.firstName}]] [[${pet.owner.lastName}]]</span>
+        </div>
+      </div>
+        <div t:replace="~{fragments/inputField :: inputField('Name', 'name', false)}"></div>
+        <div t:replace="~{fragments/inputField :: inputField('Birth Date', 'birthDate', true)}"></div>
+        <div t:replace="~{fragments/selectField :: selectField('Type', 'type', types)}"></div>
+    </div>
+    <div class="form-group">
+      <div class="col-sm-offset-2 col-sm-10">
+        <button class="btn btn-primary" type="submit"><t:block t:if="pet.isNew()">Add</t:block><t:block t:unless="pet.isNew()">Update</t:block>
+          Pet</button>
+      </div>
+    </div>
+  </form>
+
+</body>
+</html>
