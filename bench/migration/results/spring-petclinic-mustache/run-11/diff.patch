+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.system.Application"
+      t:params="List<Application.Menu> menus"
+      t:replace="~{fragments/layout :: layout(~{::body}, menus)}">
+<body t:remove="tag">
+    <h2 th:text="#{welcome}">Welcome</h2>
