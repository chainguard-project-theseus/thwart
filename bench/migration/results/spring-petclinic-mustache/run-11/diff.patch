+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="org.springframework.samples.petclinic.system.Application, org.springframework.samples.petclinic.owner.Owner"
+      t:params="List<Application.Menu> menus, Owner owner"
+      t:replace="~{fragments/layout :: layout(~{::body}, menus)}">
+<body t:remove="tag">
+
+    <h2>Owner Information</h2>
+
+
+    <t:block t:if="owner != null">
+    <table class="table table-striped">
+      <tbody>
+      <tr>
+        <th>Name</th>
+        <td><b t:text="|${owner.firstName} ${owner.lastName}|">George Franklin</b></td>
+      </tr>
+      <tr>
+        <th>Address</th>
+        <td t:text="owner.address">address</td>
+      </tr>
+      <tr>
+        <th>City</th>
+        <td t:text="owner.city">city</td>
+      </tr>
+      <tr>
+        <th>Telephone</th>
+        <td t:text="owner.telephone">telephone</td>
+      </tr>
+      </tbody>
+    </table>
+
+    <a t:href="|${owner.id}/edit|" class="btn btn-primary">Edit
+      Owner</a>
+    <a t:href="|${owner.id}/pets/new|" class="btn btn-primary">Add
+      New Pet</a>
+
+    <br />
+    <br />
+    <br />
+    <h2>Pets and Visits</h2>
+
+    <table class="table table-striped">
+      <tbody t:if="!owner.pets.isEmpty()">
+      <tr t:each="pet : owner.pets">
+        <td valign="top">
+          <dl class="dl-horizontal">
+            <dt>Name</dt>
+            <dd t:text="pet.name">Leo</dd>
+            <dt>Birth Date</dt>
+            <dd t:text="pet.birthDate">2010-09-07</dd>
+            <dt>Type</dt>
+            <dd t:text="pet.type?.name">cat</dd>
+          </dl>
+        </td>
+        <td valign="top">
+          <table class="table-condensed">
+            <thead>
+              <tr>
+                <th>Visit Date</th>
+                <th>Description</th>
+              </tr>
+            </thead>
+            <tbody>
+            <tr t:each="visit : pet.visits">
+              <td t:text="visit.date">2013-01-01</td>
+              <td t:text="visit.description">rabies shot</td>
+            </tr>
+            <tr>
+              <td><a t:href="|${owner.id}/pets/${pet.id}/edit|">Edit
+                  Pet</a></td>
+              <td><a t:href="|${owner.id}/pets/${pet.id}/visits/new|">Add
+                  Visit</a></td>
+            </tr>
+            </tbody>
+          </table>
+        </td>
+      </tr>
+      </tbody>
+    </table>
+    </t:block>
