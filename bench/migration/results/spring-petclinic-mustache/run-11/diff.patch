+++ b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
@@ -0,0 +1,66 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev"
+      t:import="org.springframework.samples.petclinic.system.Application, org.springframework.samples.petclinic.owner.Pet, org.springframework.samples.petclinic.visit.Visit"
+      t:params="List<Application.Menu> menus, Pet pet, Visit visit"
+      t:replace="~{fragments/layout :: layout(~{::body}, menus)}">
+<body t:remove="tag">
+
+  <h2>
+    <t:block t:if="visit != null and visit.isNew()">New </t:block> Visit
+  </h2>
+
+  <t:block t:if="pet != null">
+  <b>Pet</b>
+  <table class="table table-striped">
+    <thead>
+      <tr>
+        <th>Name</th>
+        <th>Birth Date</th>
+        <th>Type</th>
+        <th>Owner</th>
+      </tr>
+    </thead>
+    <tbody>
+    <tr>
+      <td t:text="pet.name">Max</td>
+      <td t:text="pet.birthDate">2012-09-04</td>
+      <td t:text="pet.type?.name">cat</td>
+      <td t:if="pet.owner != null" t:text="|${pet.owner.firstName} ${pet.owner.lastName}|">Jean Coleman</td>
+    </tr>
+    </tbody>
+  </table>
+  </t:block>
+
+  <form class="form-horizontal" method="post">
+    <div class="form-group has-feedback">
+      <!--/* The original template rendered input fields from a "form" model attribute that
+           VisitController never provides, so no fields were ever rendered here. */-->
+    </div>
+    <div class="form-group">
+      <div class="col-sm-offset-2 col-sm-10">
+        <input type="hidden" name="petId" th:value="${pet.id}" />
+        <button class="btn btn-primary" type="submit">Add Visit</button>
+      </div>
+    </div>
+  </form>
+
+  <br />
+  <b>Previous Visits</b>
+  <table class="table table-striped">
+    <tbody>
+    <tr>
+      <th>Date</th>
+      <th>Description</th>
+    </tr>
+    <t:block t:if="pet != null">
+    <t:block t:each="previous : pet.visits"><tr t:unless="previous.isNew()">
+      <td t:text="previous.date">2013-01-01</td>
+      <td t:text="previous.description">rabies shot</td>
+    </tr></t:block>
+    </t:block>
+    </tbody>
+  </table>
+
+
+</body>
+</html>
