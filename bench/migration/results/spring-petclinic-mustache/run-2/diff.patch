+      t:import="org.springframework.samples.petclinic.system.Application, org.springframework.samples.petclinic.vet.Vet, org.springframework.samples.petclinic.system.PageLink"
+      t:params="List<Application.Menu> menus, List<Vet> listVets, boolean hasPages, List<PageLink> pages, boolean first, boolean last, int previous, int next, int totalPages"
+      t:replace="~{fragments/layout :: layout(~{::section}, menus)}">
+<section t:remove="tag">
+
+  <h2>Veterinarians</h2>
+
+  <table id="vets" class="table table-striped">
+    <thead>
+      <tr>
+        <th>Name</th>
+        <th>Specialties</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr t:each="vet : listVets">
+        <td>[[${vet.firstName}]] [[${vet.lastName}]]</td>
+        <td><t:block t:each="specialty : vet.specialties"><span t:text="specialty.name">specialty</span> </t:block>
+        <span t:unless="vet.special">none</span></td>
+      </tr>
+    </tbody>
+  </table>
+  <div t:if="hasPages">
+      <span>Pages:</span>
+      <span>[</span>
+      <span t:each="page : pages">
+          <a t:unless="page.current" t:href="@{/vets.html(page=page.number)}" t:text="page.number">1</a>
+          <span t:if="page.current" t:text="page.number">1</span>
+      </span>
+      <span>]&nbsp;</span>
+      <span>
+          <a t:unless="first" href="/vets.html?page=1" title="First"
+              class="fa fa-fast-backward"></a>
+          <span t:if="first" title="First" class="fa fa-fast-backward"></span>
+      </span>
+      <span>
+          <a t:unless="first" t:href="@{/vets.html(page=previous)}" title="Previous"
+              class="fa fa-step-backward"></a>
+          <span t:if="first" title="Previous" class="fa fa-step-backward"></span>
+      </span>
+      <span>
+          <a t:unless="last" t:href="@{/vets.html(page=next)}" title="Next"
+              class="fa fa-step-forward"></a>
+          <span t:if="last" title="Next" class="fa fa-step-forward"></span>
+      </span>
+      <span>
+          <a t:unless="last" t:href="@{/vets.html(page=totalPages)}" title="Last"
+              class="fa fa-fast-forward"></a>
+          <span t:if="last" title="Last" class="fa fa-fast-forward"></span>
+      </span>
+  </div>
+
+</section>
+</html>
