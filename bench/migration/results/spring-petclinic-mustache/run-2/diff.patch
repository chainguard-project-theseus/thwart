+          <dl class="dl-horizontal">
+            <dt>Name</dt>
+            <dd t:text="pet.name">name</dd>
+            <dt>Birth Date</dt>
+            <dd>
+              [[${pet.birthDate}]]</dd>
+            <dt>Type</dt>
+            <dd t:text="pet.type?.name">type</dd>
+          </dl>
+        </td>
+        <td valign="top">
+          <table class="table-condensed">
+            <thead>
+              <tr>
+                <th>Visit Date</th>
+                <th>Description</th>
+              </tr>
+            </thead>
+            <tr t:each="visit : pet.visits">
+              <td t:text="visit.date">date</td>
+              <td t:text="visit.description">description</td>
+            </tr>
+            <tr>
+              <td><a t:href="@{{ownerId}/pets/{petId}/edit(ownerId=owner.id, petId=pet.id)}">Edit
+                  Pet</a></td>
+              <td><a t:href="@{{ownerId}/pets/{petId}/visits/new(ownerId=owner.id, petId=pet.id)}">Add
+                  Visit</a></td>
+            </tr>
+          </table>
+        </td>
+      </tr>
+
+    </table>
+    </t:block>
+
+</section>
+</html>
