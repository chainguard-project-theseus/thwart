+          <dl class="dl-horizontal">
+            <dt>Name</dt>
+            <dd t:text="pet.name">Leo</dd>
+            <dt>Birth Date</dt>
+            <dd t:text="pet.birthDate">2010-09-07</dd>
+            <dt>Type</dt>
+            <dd t:text="pet.type?.name">cat</dd>
+          </dl>
+        </td>
+        <td valign="top">
+          <table class="table-condensed">
+            <thead>
+              <tr>
+                <th>Visit Date</th>
+                <th>Description</th>
+              </tr>
+            </thead>
+            <tr t:each="visit : pet.visits">
+              <td t:text="visit.date">2013-01-01</td>
+              <td t:text="visit.description">rabies shot</td>
+            </tr>
+            <tr>
+              <td><a t:href="@{{ownerId}/pets/{petId}/edit(ownerId=owner.id, petId=pet.id)}">Edit
+                  Pet</a></td>
+              <td><a t:href="@{{ownerId}/pets/{petId}/visits/new(ownerId=owner.id, petId=pet.id)}">Add
+                  Visit</a></td>
+            </tr>
+          </table>
+        </td>
+      </tr>
+
+    </table>
+    </t:block>
+
+</body>
+</html>
