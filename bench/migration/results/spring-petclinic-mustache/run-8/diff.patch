+# Home, error pages
+GET /
+GET /oups
+GET /does-not-exist
+GET /owners/999
+GET /vets.html
+GET /vets.html?page=2
+GET /vets
+# Find owners
+GET /owners/find
+GET /owners?lastName=Nobody
+GET /owners?lastName=Franklin
+GET /owners?lastName=Davis
+GET /owners
+GET /owners?page=2
+GET /owners?lastName=&page=2
+# Owner details
+GET /owners/1
+GET /owners/3
+GET /owners/6
+GET /owners/10
+# New owner
+GET /owners/new
+POST /owners/new firstName=&lastName=&address=&city=&telephone=
+POST /owners/new firstName=<b>Ann</b>&lastName=Lee&address=1 Main St&city=Paris&telephone=abc
+POST /owners/new firstName=Ann&lastName=Lee&address=1 Main St&city=Paris&telephone=0123456789
+GET /owners/11
+# Edit owner
+GET /owners/2/edit
+POST /owners/2/edit firstName=Betty&lastName=&address=638 Cardinal Ave.&city=Sun Prairie&telephone=12345678901
+POST /owners/2/edit firstName=Betty&lastName=Davis&address=640 Cardinal Ave.&city=Sun Prairie&telephone=6085551749
+# New pet
+GET /owners/1/pets/new
+POST /owners/1/pets/new name=&birthDate=&type=
+POST /owners/1/pets/new name=Leo&birthDate=notadate&type=cat
+POST /owners/1/pets/new name=Rex&birthDate=2020-01-02&type=bogus
+POST /owners/1/pets/new name=Rex&birthDate=2020-01-02&type=dog
+GET /owners/1
+# Edit pet
+GET /owners/1/pets/1/edit
+POST /owners/1/pets/1/edit name=&birthDate=2010-09-07&type=cat
+POST /owners/1/pets/1/edit name=Leo&birthDate=bad&type=cat
+POST /owners/1/pets/1/edit name=Leon&birthDate=2010-09-08&type=hamster
+GET /owners/1
+# Visits
+GET /owners/6/pets/7/visits/new
+POST /owners/6/pets/7/visits/new date=2023-01-01&description=
+POST /owners/6/pets/7/visits/new date=bad&description=x
+POST /owners/6/pets/7/visits/new date=2023-01-01&description=<script>alert(1)</script>
+GET /owners/6/pets/7/visits/new
+GET /owners/6
+GET /owners/1/pets/1/visits/new
+GET /owners?lastName=
