+    </table>
+
+    <a t:href="@{{id}/edit(id=owner.id)}" class="btn btn-primary">Edit
+      Owner</a>
+    <a t:href="@{{id}/pets/new(id=owner.id)}" class="btn btn-primary">Add
+      New Pet</a>
+
+    <br />
