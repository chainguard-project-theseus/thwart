+    <t:block t:if="visit?.isNew() == true">New </t:block> Visit
+  </h2>
+
+  <t:block t:if="pet != null">
+  <b>Pet</b>
+  <table class="table table-striped">
+    <thead>
+      <tr>
+        <th>Name</th>
+        <th>Birth Date</th>
+        <th>Type</th>
+        <th>Owner</th>
+      </tr>
+    </thead>
+    <tr>
+      <td t:text="pet.name">Leo</td>
+      <td t:text="pet.birthDate">2010-09-07</td>
+      <td t:text="pet.type?.name">cat</td>
+      <td t:if="pet.owner != null" t:text="|${pet.owner.firstName} ${pet.owner.lastName}|">George Franklin</td>
+    </tr>
+  </table>
+  </t:block>
