+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.system.Application.Menu, org.springframework.samples.petclinic.owner.Pet, org.springframework.samples.petclinic.visit.Visit"
+      t:params="List<Menu> menus, Visit visit, Pet pet"
+      t:replace="~{fragments/layout :: layout(~{::body}, menus)}">
+<body t:remove="tag">
+
+  <h2>
+    <t:block t:if="visit?.isNew()">New </t:block> Visit
+  </h2>
+
+  <t:block t:if="pet != null">
+  <b>Pet</b>
+  <table class="table table-striped">
+    <thead>
+      <tr>
+        <th>Name</th>
+        <th>Birth Date</th>
+        <th>Type</th>
+        <th>Owner</th>
+      </tr>
+    </thead>
+    <tr>
+      <td t:text="pet.name">Name</td>
+      <td t:text="pet.birthDate">Birth Date</td>
+      <td t:text="pet.type?.name">Type</td>
