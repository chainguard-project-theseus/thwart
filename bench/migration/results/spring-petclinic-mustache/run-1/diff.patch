@@ -0,0 +1,55 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.system.Application.Menu, org.springframework.samples.petclinic.system.PageLink, org.springframework.samples.petclinic.vet.Vet"
+      t:params="List<Menu> menus, List<Vet> listVets, boolean hasPages, List<PageLink> pages, boolean first, boolean last, int previous, int next, int totalPages"
+      t:replace="~{fragments/layout :: layout(~{::body}, menus)}">
+<body t:remove="tag">
+
+  <h2>Veterinarians</h2>
+
+  <table id="vets" class="table table-striped">
+    <thead>
+      <tr>
+        <th>Name</th>
+        <th>Specialties</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr t:each="vet : listVets">
+        <td>[[${vet.firstName}]] [[${vet.lastName}]]</td>
+        <td><t:block t:each="specialty : vet.specialties"><span t:text="specialty.name">Specialty</span> </t:block>
+        <span t:unless="vet.special">none</span></td>
+      </tr>
+    </tbody>
+  </table>
+    <div t:if="hasPages">
+        <span>Pages:</span>
+        <span>[</span>
+        <span t:each="page : pages">
+            <a t:unless="page.current" t:href="|/vets.html?page=${page.number}|" t:text="page.number">1</a>
