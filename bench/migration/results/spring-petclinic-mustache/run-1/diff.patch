+package org.springframework.samples.petclinic.owner;
+
+import org.springframework.samples.petclinic.system.Form;
+import org.springframework.samples.petclinic.system.InputField;
+import org.springframework.web.servlet.support.RequestContext;
+
+import dev.tessera.runtime.TemplateView;
+
+/**
+ * The input fields of the owner form, with their binding status.
+ */
+@TemplateView
+public class OwnerForm implements Form {
+
+	private final InputField firstName;
+
+	private final InputField lastName;
+
+	private final InputField address;
+
+	private final InputField city;
+
+	private final InputField telephone;
+
+	OwnerForm(Owner owner) {
+		firstName = new InputField("First Name", "firstName", owner.getFirstName(), "text");
+		lastName = new InputField("Last Name", "lastName", owner.getLastName(), "text");
+		address = new InputField("Address", "address", owner.getAddress(), "text");
+		city = new InputField("City", "city", owner.getCity(), "text");
+		telephone = new InputField("Telephone", "telephone", owner.getTelephone(), "text");
+	}
+
+	public InputField getFirstName() {
+		return firstName;
+	}
+
+	public InputField getLastName() {
+		return lastName;
+	}
+
+	public InputField getAddress() {
+		return address;
+	}
+
+	public InputField getCity() {
+		return city;
+	}
+
+	public InputField getTelephone() {
+		return telephone;
+	}
+
+	@Override
+	public void setContext(RequestContext context) {
+		firstName.setStatus(context.getBindStatus("owner.firstName"));
+		lastName.setStatus(context.getBindStatus("owner.lastName"));
+		address.setStatus(context.getBindStatus("owner.address"));
+		city.setStatus(context.getBindStatus("owner.city"));
+		telephone.setStatus(context.getBindStatus("owner.telephone"));
+	}
+
+}
