@@ -0,0 +1,63 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.system.Application.Menu, org.springframework.samples.petclinic.system.PageLink, org.springframework.samples.petclinic.owner.Owner"
+      t:params="List<Menu> menus, List<Owner> listOwners, boolean hasPages, List<PageLink> pages, boolean first, boolean last, int previous, int next, int totalPages"
+      t:replace="~{fragments/layout :: layout(~{::body}, menus)}">
+<body t:remove="tag">
+
+    <h2>Owners</h2>
+
+    <table id="owners" class="table table-striped">
+        <thead>
+        <tr>
+            <th style="width: 150px;">Name</th>
+            <th style="width: 200px;">Address</th>
+            <th>City</th>
+            <th style="width: 120px">Telephone</th>
+            <th>Pets</th>
+        </tr>
+        </thead>
+        <tbody>
+          <tr t:each="owner : listOwners">
+              <td>
+                  <a t:href="|/owners/${owner.id}|">[[${owner.firstName}]] [[${owner.lastName}]]</a>
+              </td>
+              <td t:text="owner.address">Address</td>
+              <td t:text="owner.city">City</td>
+              <td t:text="owner.telephone">Telephone</td>
+              <td><t:block t:each="pet : owner.pets"><span t:text="pet.name">Pet</span> </t:block></td>
+          </tr>
+        </tbody>
+    </table>
+
+    <div t:if="hasPages">
+        <span>Pages:</span>
+        <span>[</span>
+        <span t:each="page : pages">
+            <a t:unless="page.current" t:href="|/owners?page=${page.number}|" t:text="page.number">1</a>
+            <span t:if="page.current" t:text="page.number">1</span>
+        </span>
+        <span>]&nbsp;</span>
+        <span>
+            <a t:unless="first" href="/owners?page=1" title="First"
+                class="fa fa-fast-backward"></a>
+            <span t:if="first" title="First" class="fa fa-fast-backward"></span>
+        </span>
+        <span>
+            <a t:unless="first" t:href="|/owners?page=${previous}|" title="Previous"
+                class="fa fa-step-backward"></a>
+            <span t:if="first" title="Previous" class="fa fa-step-backward"></span>
+        </span>
+        <span>
+            <a t:unless="last" t:href="|/owners?page=${next}|" title="Next"
+                class="fa fa-step-forward"></a>
+            <span t:if="last" title="Next" class="fa fa-step-forward"></span>
+        </span>
+        <span>
+            <a t:unless="last" t:href="|/owners?page=${totalPages}|" title="Last"
+                class="fa fa-fast-forward"></a>
+            <span t:if="last" title="Last" class="fa fa-fast-forward"></span>
+        </span>
+    </div>
+
+</body>
+</html>
