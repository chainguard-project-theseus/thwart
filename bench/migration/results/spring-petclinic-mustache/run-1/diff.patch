+<!doctype html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.system.Application.Menu, org.springframework.samples.petclinic.owner.*"
+      t:params="List<Menu> menus, Pet pet, PetForm form"
+      t:replace="~{fragments/layout :: layout(~{::body}, menus)}">
+<body t:remove="tag">
+
+  <h2 t:if="pet != null">
+    <t:block t:if="pet.isNew()">New </t:block>Pet
+  </h2>
+  <form class="form-horizontal" method="post">
+    <input type="hidden" name="id" th:value="*{id}" />
+    <div class="form-group has-feedback">
+      <div class="form-group">
+        <label class="col-sm-2 control-label">Owner</label>
+        <div class="col-sm-10">
+          <span t:if="pet?.owner != null">[[${pet.owner.firstName}]] [[${pet.owner.lastName}]]</span>
+        </div>
+      </div>
+      <t:block t:if="form != null">
+        <t:block t:replace="~{fragments/inputField :: inputField(form.nameField)}"></t:block>
+        <t:block t:replace="~{fragments/inputField :: inputField(form.birthDate)}"></t:block>
+        <t:block t:replace="~{fragments/selectField :: selectField(form.type)}"></t:block>
+      </t:block>
+    </div>
+    <div class="form-group" t:if="pet != null">
+      <div class="col-sm-offset-2 col-sm-10">
+        <button class="btn btn-primary" type="submit"><t:block t:if="pet.isNew()">Add</t:block><t:block t:unless="pet.isNew()">Update</t:block>
+          Pet</button>
+      </div>
+    </div>
+  </form>
+
+</body>
+</html>
