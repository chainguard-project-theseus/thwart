diff --git a/BudgetMasterServer/src/main/resources/templates/charts/newChart.html b/BudgetMasterServer/src/main/resources/templates/charts/newChart.html
new file mode 100644
index 00000000..bc10e7d9
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/charts/newChart.html
@@ -0,0 +1,93 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.charts.Chart"
+      t:params="Settings settings, List<Notification> notifications, Chart chart, Map<String, String> fieldErrors">
+    <head t:with="title=chart.getID() != null ? locale.getString('title.chart.edit') : locale.getString('title.chart.new')">
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <link rel="stylesheet" t:href="@{/webjars/codemirror/lib/codemirror.css}">
+        <link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('charts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="chart.getID() != null ? locale.getString('title.chart.edit') : locale.getString('title.chart.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::pagecontent(chart, fieldErrors)})}">
+                    <t:block t:fragment="pagecontent(Chart chart, Map<String, String> fieldErrors)">
+                        <div class="container">
+                        <form name="NewChart" t:action="@{/charts/newChart}" method="post">
+                            <input type="hidden" name="ID" t:value="chart.getID() == null ? '' : '' + chart.getID()">
+
+                            <div class="row">
+                                <div class="input-field col s12 m12 l8 offset-l2">
+                                    <i class="material-icons prefix">edit</i>
+                                    <input id="chart-name" type="text" name="name"
+                                           t:class="validation.cssClass(fieldErrors, 'name', '')"
+                                           t:data-position="validation.hasError(fieldErrors, 'name') ? 'bottom'"
+                                           t:data-delay="validation.hasError(fieldErrors, 'name') ? '50'"
+                                           t:data-tooltip="validation.tooltip(fieldErrors, 'name')"
+                                           t:value="chartsViews.chartName(chart)" t:disabled="chart.getType() == 'DEFAULT'">
+                                    <label for="chart-name" t:text="locale.getString('chart.new.label.name')">name</label>
+                                </div>
+                            </div>
+
+                            <!-- info message with link to wiki on how to create custom charts -->
+                            <t:block t:if="chart.getType() == 'CUSTOM'">
+                                <t:block t:replace="~{charts/chartFunctions :: infoMessage(locale.getString('chart.new.info.wiki'))}"></t:block>
+                            </t:block>
+
+                            <div class="row">
+                                <div class="input-field col sl2" style="width: 100%">
+                                    <textarea id="chart-script" name="script"
+                                              t:class="validation.cssClass(fieldErrors, 'script', 'materialize-textarea')"
+                                              t:data-position="validation.hasError(fieldErrors, 'script') ? 'bottom'"
+                                              t:data-delay="validation.hasError(fieldErrors, 'script') ? '50'"
+                                              t:data-tooltip="validation.tooltip(fieldErrors, 'script')"
+                                              t:text="chart.getScript()"></textarea>
+                                </div>
+                            </div>
+
+                            <br>
+
+                            <t:block t:if="chart.getType() == 'DEFAULT'">
+                                <t:block t:replace="~{charts/chartFunctions :: infoMessage(locale.getString('chart.new.info.default'))}"></t:block>
+                            </t:block>
+
+                            <div class="row hide-on-small-only">
+                                <div class="col s6 right-align">
+                                    <t:block t:replace="~{helpers/header :: buttonLink('/charts/manage', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                                </div>
+
+                                <div class="col s6 left-align">
+                                    <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', chart.getType() == 'DEFAULT', '', '', '')}"></t:block>
+                                </div>
+                            </div>
+                            <div class="hide-on-med-and-up">
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{helpers/header :: buttonLink('/charts/manage', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                                    </div>
+                                </div>
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', chart.getType() == 'DEFAULT', '', '', '')}"></t:block>
+                                    </div>
+                                </div>
+                            </div>
+                        </form>
+                        </div>
+                    </t:block>
+                </t:block>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/codemirror/lib/codemirror.js}"></script>
+        <script t:src="@{/webjars/codemirror/mode/javascript/javascript.js}"></script>
+        <script t:src="@{/js/charts.js}"></script>
+    </body>
+</html>
