@@ -0,0 +1,42 @@
+<div xmlns:t="https://tessera.dev" t:params="List<String> existingTemplateNames" id="modalCreateFromTransaction" class="modal background-color">
+    <div class="modal-content">
+        <h4 t:text="locale.getString('save.as.template')">Save as template</h4>
+
+        <div class="row">
+            <div class="input-field col s12">
+                <input id="template-name" type="text" name="templateName">
+                <label for="template-name" t:text="locale.getString('transaction.new.label.name')">Name</label>
+            </div>
+            <div class="col s12">
+                <label>
+                    <input id="include-category" type="checkbox" checked="checked">
+                    <span class="columnName-checkbox-label text-default" t:text="locale.getString('template.checkbox.include.category')">category</span>
+                </label>
+            </div>
+            <div class="col s12">
+                <label>
+                    <input id="include-account" type="checkbox">
+                    <span class="columnName-checkbox-label text-default" t:text="locale.getString('template.checkbox.include.account')">account</span>
+                </label>
+            </div>
+        </div>
+
+        <div class="row">
+            <div class="col s12">
+                <i class="fas fa-info"></i> [[${locale.getString('template.repeating.options.not.included')}]]
+            </div>
+        </div>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false, false, '')}"></t:block>
+        <!-- the old call passed classes='"modal-action ...' (stray quote), which ended the class attribute early;
+             reproduced as written by the browser except for the unrepresentable attribute name 'text-white"' -->
+        <a id="buttonCreateTemplate" class="waves-effect waves-light btn green" modal-action modal-close data-url="/templates/fromTransaction">
+            <i class="material-icons left">file_copy</i>[[${locale.getString('save.as.template')}]]
+        </a>
+    </div>
+
+    <script>
+        existingTemplateNames = [[${existingTemplateNames}]];
+    </script>
+</div>
