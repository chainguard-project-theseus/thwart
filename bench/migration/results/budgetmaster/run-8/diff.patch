@@ -0,0 +1,145 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.icon.Iconizable">
+
+<div t:fragment="iconSelect(String id, Iconizable item, boolean showBackground, String initialBackgroundClasses, String backgroundClasses, boolean preventFallbackIcon)" class="row"
+     t:with="hasImageIcon=item.getIconReference() != null && item.getIconReference().isImageIcon(), hasBuiltinIcon=item.getIconReference() != null && item.getIconReference().isBuiltinIcon()">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <i class="fas fa-icons prefix"></i>
+        <label class="input-label" t:for="id" t:text="locale.getString('account.new.label.icon')">icon</label>
+
+        <div t:id="id" class="valign-wrapper item-icon">
+            <div class="item-icon-preview-container">
+                <t:block t:replace="~{helpers/styles :: a_color(views.fontColor(item), 'item-icon-preview', null, null, ~{helpers/iconSelect :: iconPreview(item, hasImageIcon, hasBuiltinIcon, preventFallbackIcon, showBackground, initialBackgroundClasses, backgroundClasses)})}"></t:block>
+                <t:block t:replace="~{helpers/header :: buttonFlat('', 'delete', '', '', 'no-padding text-default button-remove-icon-from-item', false, true, '', '', '')}"></t:block>
+            </div>
+
+            <div id="item-icon-placeholder" t:text="locale.getString('account.new.icon.placeholder')">placeholder</div>
+
+            <input id="hidden-input-icon-image-id" type="hidden" name="iconImageID" t:value="hasImageIcon ? '' + item.getIconReference().getImage().getID() : ''">
+            <input id="hidden-input-icon-builtin-identifier" type="hidden" name="builtinIconIdentifier" t:value="hasBuiltinIcon ? item.getIconReference().getBuiltinIdentifier() : ''">
+        </div>
+    </div>
+</div>
+
+
+<div t:fragment="modalIconSelect(String idToFocusOnClose, Iconizable item)" id="modalIconSelect" class="modal modal-fixed-footer background-color" t:data-focus-on-close="idToFocusOnClose"
+     t:with="hasImageIcon=item.getIconReference() != null && item.getIconReference().isImageIcon()">
+    <div class="modal-content center-align">
+        <div class="row">
+            <div class="col s12">
+                <ul class="tabs" id="iconTabs">
+                    <li class="tab col s6"><a class="text-blue valign-wrapper" t:classappend="!hasImageIcon ? 'active'" href="#tabBuiltinIcons" data-name="builtinIcons"><i class="fas fa-icons"></i> [[${locale.getString('icons.builtin')}]]</a></li>
+                    <li class="tab col s6"><a class="text-blue valign-wrapper" t:classappend="hasImageIcon ? 'active'" href="#tabImages" data-name="images"><i class="fas fa-image"></i> [[${locale.getString('icons.images')}]]</a></li>
+                </ul>
+            </div>
+            <div id="tabBuiltinIcons" class="col s12"><t:block t:replace="~{helpers/iconSelect :: tabBuiltinIcons(item)}"></t:block></div>
+            <div id="tabImages" class="col s12"><t:block t:replace="~{helpers/iconSelect :: tabImages(item)}"></t:block></div>
+        </div>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, true, false, '')}"></t:block>
+        <t:block t:replace="~{helpers/header :: buttonLink('', 'done', 'ok', 'button-icon-confirm', 'green', 'modal-action modal-close text-white', false, true, true, '')}"></t:block>
+    </div>
+</div>
+
+<t:block t:fragment="tabImages(Iconizable item)"
+         t:with="hasImageIcon=item.getIconReference() != null && item.getIconReference().isImageIcon()">
+    <div class="row">
+        <div class="col s12">
+            <div class="headline" t:text="locale.getString('upload.image.headline')">headline</div>
+        </div>
+    </div>
+
+    <div class="row">
+        <t:block t:replace="~{helpers/iconSelect :: uploadImageForm}"></t:block>
+    </div>
+
+    <hr>
+
+    <div class="row">
+        <div class="col s12">
+            <div class="headline" t:text="locale.getString('available.images')">headline</div>
+        </div>
+    </div>
+
+    <t:block t:replace="~{helpers/iconSelect :: progressIndicator}"></t:block>
+
+    <div class="row" id="available-images"
+         t:data-url="hasImageIcon ? @{/media/getAvailableImages/{id}(id=item.getIconReference().getImage().getID())} : @{/media/getAvailableImages}">
+    </div>
+</t:block>
+
+<t:block t:fragment="tabBuiltinIcons(Iconizable item)" t:with="icons=accountsViews.fontawesomeIcons()">
+    <div class="row no-margin-bottom">
+        <div class="input-field col s12 m12 l8 offset-l2">
+            <i class="material-icons prefix">search</i>
+            <input id="searchIcons" type="text" onchange="searchBuiltinIcons();" onkeypress="searchBuiltinIcons();" onpaste="searchBuiltinIcons()" oninput="searchBuiltinIcons();">
+            <label for="searchIcons" t:text="locale.getString('search')">search</label>
+        </div>
+    </div>
+    <div class="row">
+        <div class="col s12 center-align" id="numberOfIcons"><span id="numberOfMatchingIcons" t:text="icons.size()">0</span>/[[${icons.size()}]] [[${locale.getString('icons.numberOf')}]]</div>
+    </div>
+
+    <hr>
+
+    <div class="row">
+        <t:block t:each="icon : icons">
+            <t:block t:replace="~{helpers/iconSelect :: builtinIconOption(icon, item)}"></t:block>
+        </t:block>
+    </div>
+</t:block>
+
+<div t:fragment="builtinIconOption(String icon, Iconizable item)" class="col s4 m2 l2 builtin-icon-option-column"
+     t:with="selectedIconName=item.getIconReference() != null && item.getIconReference().isBuiltinIcon() ? item.getIconReference().getBuiltinIdentifier() : ''">
+    <div class="builtin-icon-option" t:classappend="selectedIconName == icon ? 'selected'">
+        <i t:class="|builtin-icon-option-icon ${icon}|"></i>
+        <div class="builtin-icon-option-name truncate" t:text="icon">icon</div>
+    </div>
+</div>
+
+<t:block t:fragment="uploadImageForm">
+    <form id="form-upload-image" method="post" t:action="@{/media/uploadImage}" enctype="multipart/form-data">
+        <div class="file-field input-field col s12">
+            <div class="container">
+                <div class="btn background-blue">
+                    <i class="material-icons left">folder</i>
+                    [[${locale.getString('account.new.icon.upload.choose.file')}]]
+                    <input id="inputUploadFile" type="file" t:accept="helpers.getValidImageUploadTypes()" name="file">
+                </div>
+                <div class="file-path-wrapper">
+                    <input class="file-path validate" type="text">
+                </div>
+                <t:block t:replace="~{helpers/header :: buttonLink('', 'upload', 'account.new.icon.upload', 'button-upload-new-image', 'background-blue', 'right', false, true, false, '')}"></t:block>
+            </div>
+        </div>
+    </form>
+
+    <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.icon.upload.image.size'), 'fas fa-info', '')}"></t:block>
+</t:block>
+
+<div t:fragment="progressIndicator" class="preloader-wrapper active margin" id="progressIndicator">
+    <div class="spinner-layer spinner-blue-only">
+        <div class="circle-clipper left">
+            <div class="circle"></div>
+        </div>
+        <div class="gap-patch">
+            <div class="circle"></div>
+        </div>
+        <div class="circle-clipper right">
+            <div class="circle"></div>
+        </div>
+    </div>
+</div>
+
+<t:block t:fragment="iconPreview(Iconizable item, boolean hasImageIcon, boolean hasBuiltinIcon, boolean preventFallbackIcon, boolean showBackground, String initialBackgroundClasses, String backgroundClasses)">
+                    <script>iconSelectAdditionalBackgroundClasses = [[${backgroundClasses}]];</script>
+                    <div t:replace="~{helpers/styles :: div_background(showBackground ? accountsViews.itemColor(item) : '', 'item-icon-preview-background', 'category-circle category-circle-preview ' + initialBackgroundClasses + (helpers.getSettings().getShowCategoriesAsCircles() == false ? ' category-square' : ''), null, ~{helpers/iconSelect :: iconPreviewIcons(item, hasImageIcon, hasBuiltinIcon, preventFallbackIcon)})}"></div>
+                </t:block>
+
+<t:block t:fragment="iconPreviewIcons(Iconizable item, boolean hasImageIcon, boolean hasBuiltinIcon, boolean preventFallbackIcon)">
+                        <i id="builtin-icon-preview-icon" t:class="hasBuiltinIcon ? item.getIconReference().getBuiltinIdentifier() : 'hidden'"></i>
+                        <img id="item-icon-preview-icon" t:src="hasImageIcon ? @{/media/getImageByIconID/{id}(id=item.getIconReference().getID())} : ''" class=" item-icon-preview category-icon" t:classappend="!hasImageIcon ? 'hidden'"/>
+                        <span t:unless="preventFallbackIcon" id="item-icon-fallback-name" t:class="hasBuiltinIcon || hasImageIcon ? 'hidden' : ''" t:text="views.firstCharCapitalized(accountsViews.itemName(item))">A</span>
+                    </t:block>
+
+</t:block>
