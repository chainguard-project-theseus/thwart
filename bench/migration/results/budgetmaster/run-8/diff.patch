diff --git a/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/views/SettingsViewFunctions.java b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/views/SettingsViewFunctions.java
new file mode 100644
index 00000000..cf40945f
--- /dev/null
+++ b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/views/SettingsViewFunctions.java
@@ -0,0 +1,150 @@
+package de.deadlocker8.budgetmaster.views;
+
+import de.deadlocker8.budgetmaster.backup.AutoBackupStrategy;
+import de.deadlocker8.budgetmaster.transactions.keywords.TransactionNameKeyword;
+import de.deadlocker8.budgetmaster.utils.LanguageType;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Functions for the settings, about, first use, hotkeys, statistics and error views (agent E).
+ */
+@TemplateFunctions("settingsViews")
+public final class SettingsViewFunctions
+{
+	private static final Pattern MARKUP = Pattern.compile("<br\\s*/?>|<a(\\s[^>]*)?>(.*?)</a>", Pattern.CASE_INSENSITIVE | Pattern.DOTALL);
+	private static final Pattern ATTRIBUTE = Pattern.compile("([a-zA-Z-]+)\\s*=\\s*\"([^\"]*)\"");
+
+	private SettingsViewFunctions()
+	{
+	}
+
+	/**
+	 * A piece of a localized text: plain text ("text"), a line break ("br") or a link ("a").
+	 */
+	public record HtmlPart(String kind, String text, String href, String title, String target, String cssClass)
+	{
+	}
+
+	public record KeywordTag(String tag)
+	{
+	}
+
+	@TemplateFunction
+	public static List<LanguageType> getAvailableLanguages()
+	{
+		return ViewServices.helpers.getAvailableLanguages();
+	}
+
+	@TemplateFunction
+	public static List<AutoBackupStrategy> getAvailableAutoBackupStrategies()
+	{
+		return ViewServices.helpers.getAvailableAutoBackupStrategies();
+	}
+
+	/**
+	 * FreeMarker's {@code value.name()?lower_case}.
+	 */
+	@TemplateFunction
+	public static String lowerCaseName(Object value)
+	{
+		return value instanceof Enum<?> enumValue ? enumValue.name().toLowerCase(Locale.ROOT) : "";
+	}
+
+	/**
+	 * The keywords as the objects the chips widget expects.
+	 */
+	@TemplateFunction
+	public static List<KeywordTag> keywordTags(List<TransactionNameKeyword> keywords)
+	{
+		final List<KeywordTag> tags = new ArrayList<>();
+		if(keywords != null)
+		{
+			for(TransactionNameKeyword keyword : keywords)
+			{
+				tags.add(new KeywordTag(keyword.getValue()));
+			}
+		}
+		return tags;
+	}
+
+	/**
+	 * Splits a localized text that contains the markup the old views printed unescaped (line breaks and links)
+	 * into parts that the views render as elements. Any other markup stays text.
+	 */
+	@TemplateFunction
+	public static List<HtmlPart> htmlParts(String text)
+	{
+		final List<HtmlPart> parts = new ArrayList<>();
+		if(text == null)
+		{
+			return parts;
+		}
+
+		final Matcher matcher = MARKUP.matcher(text);
+		int position = 0;
+		while(matcher.find())
+		{
+			if(matcher.start() > position)
+			{
+				parts.add(new HtmlPart("text", text.substring(position, matcher.start()), null, null, null, null));
+			}
+
+			if(matcher.group().toLowerCase(Locale.ROOT).startsWith("<br"))
+			{
+				parts.add(new HtmlPart("br", null, null, null, null, null));
+			}
+			else
+			{
+				String href = null;
+				String title = null;
+				String target = null;
+				String cssClass = null;
+				if(matcher.group(1) != null)
+				{
+					final Matcher attributeMatcher = ATTRIBUTE.matcher(matcher.group(1));
+					while(attributeMatcher.find())
+					{
+						switch(attributeMatcher.group(1).toLowerCase(Locale.ROOT))
+						{
+							case "href" -> href = attributeMatcher.group(2);
+							case "title" -> title = attributeMatcher.group(2);
+							case "target" -> target = attributeMatcher.group(2);
+							case "class" -> cssClass = attributeMatcher.group(2);
+							default ->
+							{
+							}
+						}
+					}
+				}
+				parts.add(new HtmlPart("a", matcher.group(2), href, title, target, cssClass));
+			}
+			position = matcher.end();
+		}
+
+		if(position < text.length())
+		{
+			parts.add(new HtmlPart("text", text.substring(position), null, null, null, null));
+		}
+		return parts;
+	}
+
+	/**
+	 * The keyword values joined with '|', so the template can write the old JavaScript literal for known lists.
+	 */
+	@TemplateFunction
+	public static String keywordSignature(List<TransactionNameKeyword> keywords)
+	{
+		if(keywords == null)
+		{
+			return "";
+		}
+		return keywords.stream().map(TransactionNameKeyword::getValue).collect(java.util.stream.Collectors.joining("|"));
+	}
+}
diff --git a/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/views/TransactionsViewFunctions.java b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/views/TransactionsViewFunctions.java
