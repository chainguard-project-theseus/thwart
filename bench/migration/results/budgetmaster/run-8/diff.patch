+function applyDataStyles(root)
+{
+    (root || document).querySelectorAll('[data-style-color]').forEach(function(element)
+    {
+        element.style.color = element.dataset.styleColor;
+    });
+    (root || document).querySelectorAll('[data-style-background-color]').forEach(function(element)
