+        <div class="row center-align">
+            <div class="row center-align">
+                <div class="col s12">
+                    <t:block t:replace="~{charts/chartFunctions :: buttonShow}"></t:block>
+                </div>
+            </div>
+            <div class="col s12">
+                <t:block t:replace="~{charts/chartFunctions :: buttonNew}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!-- the old iconForItem(item) for a ChartDisplayType or ChartGroupType: pass item.getIcon() and item.getLocalizationKey() -->
+<t:block t:fragment="iconForItem(String icon, String localizationKey)">
+    <t:block t:if="chartsViews.isFontAwesomeIcon(icon)"><i t:class="|${icon} left|"></i> [[${locale.getString(localizationKey)}]]</t:block>
