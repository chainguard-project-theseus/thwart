new file mode 100644
index 00000000..c27a7cb5
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/settings/importResult.html
@@ -0,0 +1,76 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.services.ImportResultItem"
+      t:params="Settings settings, List<ImportResultItem> importResultItems, List<String> errorMessages">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('settings.database.import'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('settings', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="locale.getString('info.title.database.import.dialog')">import</div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline-small" t:text="locale.getString('info.database.import.result')">result</div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="row">
+                        <div class="col s10 offset-s1 m8 offset-m2 l6 offset-l3">
+                            <table class="bordered">
+                                <tr t:each="item : importResultItems">
+                                    <td><i class="material-icons left" t:text="item.getEntityType().getIcon()">icon</i>
+                                        <div class="import-entity-name" t:text="locale.getString(item.getEntityType().getLocalizationKey())">name</div>
+                                    </td>
+                                    <td><i t:if="item.getNumberOfImportedItems() != item.getNumberOfAvailableItems()" class="fas fa-exclamation-triangle text-red"></i></td>
+                                    <td>[[${item.getNumberOfImportedItems()}]]/[[${item.getNumberOfAvailableItems()}]]</td>
+                                </tr>
+                            </table>
+                        </div>
+                    </div>
+                </div>
+
+                <div t:if="errorMessages != null && !errorMessages.isEmpty()" class="container">
+                    <div class="row">
+                        <div class="col s12">
+                            <ul class="collapsible">
+                                <li>
+                                    <div class="collapsible-header bold">
+                                        <i class="fas fa-exclamation-triangle text-red"></i>
+                                        [[${locale.getString('info.database.import.result.errors')}]]
+                                    </div>
+                                    <div class="collapsible-body">
+                                        <table class="bordered">
+                                            <tr t:each="error : errorMessages">
+                                                <td><i class="fas fa-exclamation-triangle text-red"></i></td>
+                                                <td t:text="error">error</td>
+                                            </tr>
+                                        </table>
+                                    </div>
+                                </li>
+                            </ul>
+                        </div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="row">
+                        <div class="col s12 center-align">
+                            <t:block t:replace="~{helpers/header :: buttonLink('/settings', 'done', 'ok', 'button-finish-import', 'background-blue', '', false, false, false, '')}"></t:block>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/import.js}"></script>
+    </body>
+</html>
