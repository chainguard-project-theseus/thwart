+++ b/BudgetMasterServer/src/main/resources/templates/firstUse.html
@@ -0,0 +1,117 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="Settings settings, List<Notification> notifications">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.firstUseGuide'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('firstUseGuide', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="fas fa-graduation-cap"></i> [[${locale.getString('home.first.use')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::pagecontent})}">
+                    <t:block t:fragment="pagecontent">
+                        <br>
+
+                        <div class="container">
+                            <div class="container center-align">
+                                <div class="row left-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{indexFunctions :: stepContent('home.first.use.step.1.headline', 'home.first.use.step.1.contentText', '/accounts', 'home.menu.accounts.action.manage', null)}"></t:block>
+                                    </div>
+                                </div>
+                                <hr>
+
+                                <div class="row left-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{indexFunctions :: stepContent('home.first.use.step.2.headline', 'home.first.use.step.2.contentText', '/categories', 'home.menu.categories.action.manage', null)}"></t:block>
+                                    </div>
+                                </div>
+                                <hr>
+
+                                <div class="row left-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{indexFunctions :: stepContent('home.first.use.step.3.headline', 'home.first.use.step.3.contentText', '/transactions/newTransaction/normal', 'home.menu.transactions.action.new', ~{::step3})}">
+                                            <t:block t:fragment="step3">
+                                                <ul class="browser-default">
+                                                    <li t:text="locale.getString('home.first.use.step.3.sub.1')">1</li>
+                                                    <li t:text="locale.getString('home.first.use.step.3.sub.2')">2</li>
+                                                    <li t:text="locale.getString('home.first.use.step.3.sub.3')">3</li>
+                                                    <li t:text="locale.getString('home.first.use.step.3.sub.4')">4</li>
+                                                    <li t:text="locale.getString('home.first.use.step.3.sub.5')">5</li>
+                                                    <li t:text="locale.getString('home.first.use.step.3.sub.6')">6</li>
+                                                </ul>
+                                            </t:block>
+                                        </t:block>
+                                    </div>
+                                </div>
+                                <hr>
+
+                                <div class="row left-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{indexFunctions :: stepContent('home.first.use.step.4.headline', 'home.menu.transactions', '/transactions', 'home.menu.transactions.action.manage', ~{::step4})}">
+                                            <t:block t:fragment="step4">
+                                                <br>
+                                                [[${locale.getString('home.first.use.step.4.contentText')}]]
+                                                <ul class="browser-default">
+                                                    <li t:text="locale.getString('home.first.use.step.4.sub.1')">1</li>
+                                                    <li t:text="locale.getString('home.first.use.step.4.sub.2')">2</li>
+                                                </ul>
+                                            </t:block>
+                                        </t:block>
+                                    </div>
+                                </div>
+                                <hr>
+
+                                <div class="row left-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{indexFunctions :: stepContent('home.first.use.step.5.headline', 'home.first.use.step.5.contentText', '', '', ~{::step5})}">
+                                            <t:block t:fragment="step5">
+                                                <h5 t:text="locale.getString('menu.transactions.templates')">templates</h5>
+                                                <p>
+                                                    [[${locale.getString('home.first.use.step.5.sub.1')}]]
+                                                </p>
+                                                <p>
+                                                    <t:block t:replace="~{indexFunctions :: action('/templates', 'home.menu.templates.action.manage')}"></t:block>
+                                                </p>
+
+                                                <h5 t:text="locale.getString('menu.charts')">charts</h5>
+                                                <p>
+                                                    [[${locale.getString('home.first.use.step.5.sub.2')}]]
+                                                </p>
+                                                <p>
+                                                    <t:block t:replace="~{indexFunctions :: action('/charts', 'home.menu.charts.action.manage')}"></t:block>
+                                                </p>
+
+                                                <h5 t:text="locale.getString('menu.reports')">reports</h5>
+                                                <p>
+                                                    [[${locale.getString('home.first.use.step.5.sub.3')}]]
+                                                </p>
+                                                <p>
+                                                    <t:block t:replace="~{indexFunctions :: action('/reports', 'home.menu.reports.action.new')}"></t:block>
+                                                </p>
+
+                                                <h5 t:text="locale.getString('home.first.use.step.5.sub.4')">done</h5>
+
+                                                <p class="center-align">
+                                                    <t:block t:replace="~{helpers/header :: buttonLink('/', 'home', 'home.first.use.home', '', 'background-blue', '', false, false, false, '')}"></t:block>
+                                                </p>
+                                            </t:block>
+                                        </t:block>
+                                    </div>
+                                </div>
+                            </div>
+                        </div>
+                    </t:block>
+                </t:block>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+    </body>
+</html>
