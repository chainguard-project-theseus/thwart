--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/transactionImport.html
@@ -0,0 +1,81 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.transactions.csvimport.*, de.deadlocker8.budgetmaster.categories.Category"
+      t:params="Settings settings, List<Notification> notifications, CsvImport csvImport, List<CsvRow> csvRows, List<CsvTransaction> csvTransactions, List<String> errorsColumnSettings, CsvImportSettings csvImportSettings, List<Category> categories, String suggestionsJSON, Map<String, String> fieldErrors">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.transactions.import'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactionImport.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+        <link rel="stylesheet" t:href="@{/webjars/datatables/css/dataTables.dataTables.min.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('importCSV', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="fas fa-file-csv"></i> [[${locale.getString('menu.transactions.import')}]]</div>
+                    </div>
+                </div>
+
+                <script>
+                    transactionNameSuggestions = {};
+                </script>
+
+                <t:block t:if="notifications != null"><t:block t:replace="~{helpers/header :: showNotifications(notifications)}"></t:block></t:block>
+                <t:block>
+                    <t:block>
+                        <div class="container">
+                            <t:block t:if="csvRows != null">
+                                <div class="row center-align">
+                                    <div class="col s12 m12 l8 offset-l2 headline-small text-green truncate" id="csv-file-name">
+                                        <i class="fas fa-file-csv"></i> [[${csvImport.getFileName()}]]
+                                    </div>
+                                </div>
+
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{helpers/header :: buttonLink('/transactionImport/cancel', 'clear', 'cancel', 'button-cancel-csv-import', 'red', 'text-white', false, false, false, '')}"></t:block>
+                                    </div>
+                                </div>
+                            </t:block>
+                            <t:block t:if="csvRows == null">
+                                <t:block t:replace="~{transactions/transactionImportMacros :: csvUpload(csvImportSettings, fieldErrors)}"></t:block>
+                            </t:block>
+                        </div>
+
+                        <t:block t:if="csvTransactions != null">
+                            <t:block t:replace="~{transactions/transactionImportMacros :: renderCsvTransactions(csvTransactions, categories, suggestionsJSON)}"></t:block>
+                            <t:block t:replace="~{transactions/transactionImportMacros :: showColumnSettingsErrors(errorsColumnSettings)}"></t:block>
+                        </t:block>
+                        <t:block t:if="csvTransactions == null && csvRows != null">
+                            <div class="container">
+                                <div class="section center-align">
+                                    <div class="headline-small" t:text="locale.getString('transactions.import.matchColumns')">match columns</div>
+                                </div>
+                            </div>
+                            <t:block t:replace="~{transactions/transactionImportMacros :: columnSettings(csvRows, csvImportSettings, fieldErrors)}"></t:block>
+                            <t:block t:replace="~{transactions/transactionImportMacros :: renderCsvRows(csvRows)}"></t:block>
+                        </t:block>
+                    </t:block>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- the old page wrote a single-quoted JavaScript literal; [[...]] writes JSON, so the known translations are written literally -->
+        <script t:if="locale.getString('search') == 'Search'">
+            localizedSearch = 'Search';
+        </script>
+        <script t:if="locale.getString('search') == 'Suche'">
+            localizedSearch = 'Suche';
+        </script>
+        <script t:unless="locale.getString('search') == 'Search' || locale.getString('search') == 'Suche'">
+            localizedSearch = [[${locale.getString('search')}]];
+        </script>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/datatables/js/dataTables.min.js}"></script>
+        <script t:src="@{/js/transactionImport.js}"></script>
+    </body>
+</html>
