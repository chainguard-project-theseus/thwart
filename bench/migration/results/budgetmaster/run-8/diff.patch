@@ -0,0 +1,236 @@
+package de.deadlocker8.budgetmaster.views;
+
+import de.thecodelabs.utils.util.Localization;
+import com.google.gson.Gson;
+import com.google.gson.reflect.TypeToken;
+import de.deadlocker8.budgetmaster.accounts.Account;
+import de.deadlocker8.budgetmaster.repeating.modifier.RepeatingModifierType;
+import de.deadlocker8.budgetmaster.tags.Tag;
+import de.deadlocker8.budgetmaster.transactions.Transaction;
+import de.deadlocker8.budgetmaster.transactions.TransactionBase;
+import de.deadlocker8.budgetmaster.transactions.TransactionImportController;
+import de.deadlocker8.budgetmaster.utils.types.MonthNames;
+import de.deadlocker8.budgetmaster.utils.types.WeekDay;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.web.context.request.RequestAttributes;
+import org.springframework.web.context.request.RequestContextHolder;
+
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Functions for the transactions, transaction import, filter and global date picker views (agent C).
+ */
+@TemplateFunctions("transactionsViews")
+public final class TransactionsViewFunctions
+{
+	private static final Gson GSON = new Gson();
+
+	private TransactionsViewFunctions()
+	{
+	}
+
+	/**
+	 * helpers.getAmount(transaction, account)
+	 */
+	@TemplateFunction
+	public static int getAmount(Transaction transaction, Account account)
+	{
+		return ViewServices.helpers.getAmount(transaction, account);
+	}
+
+	@TemplateFunction
+	public static List<RepeatingModifierType> getRepeatingModifierTypes()
+	{
+		return ViewServices.helpers.getRepeatingModifierTypes();
+	}
+
+	/**
+	 * The old FreeMarker templates read the session attribute "currentCsvTransaction".
+	 */
+	@TemplateFunction
+	public static boolean isCsvImportInProgress()
+	{
+		final RequestAttributes attributes = RequestContextHolder.getRequestAttributes();
+		if(attributes == null)
+		{
+			return false;
+		}
+		return attributes.getAttribute(TransactionImportController.RequestAttributeNames.CURRENT_CSV_TRANSACTION, RequestAttributes.SCOPE_SESSION) != null;
+	}
+
+	/**
+	 * Parses a JSON array of strings computed in Java (e.g. the name suggestions) so the template can write it as JSON.
+	 */
+	@TemplateFunction
+	public static List<String> parseJsonStringList(String json)
+	{
+		if(json == null || json.isBlank())
+		{
+			return List.of();
+		}
+		return GSON.fromJson(json, new TypeToken<List<String>>() {}.getType());
+	}
+
+	/**
+	 * The initial tags of the transaction chips: [{tag: name}, ...]
+	 */
+	@TemplateFunction
+	public static List<Map<String, String>> initialTags(TransactionBase transaction)
+	{
+		final List<Map<String, String>> result = new ArrayList<>();
+		if(transaction == null || transaction.getTags() == null)
+		{
+			return result;
+		}
+		for(Tag tag : transaction.getTags())
+		{
+			final Map<String, String> entry = new LinkedHashMap<>();
+			entry.put("tag", tag.getName());
+			result.add(entry);
+		}
+		return result;
+	}
+
+	/**
+	 * The tag autocomplete data: {name: null, ...}
+	 */
+	@TemplateFunction
+	public static Map<String, String> tagAutoComplete()
+	{
+		final Map<String, String> result = new LinkedHashMap<>();
+		for(Tag tag : ViewServices.helpers.getAllTags())
+		{
+			result.put(tag.getName(), null);
+		}
+		return result;
+	}
+
+	@TemplateFunction
+	public static List<String> monthNames()
+	{
+		return MonthNames.getLocalizedStrings();
+	}
+
+	@TemplateFunction
+	public static List<String> monthNamesShort()
+	{
+		return prefixes(MonthNames.getLocalizedStrings(), 3);
+	}
+
+	@TemplateFunction
+	public static List<String> weekDays()
+	{
+		return WeekDay.getLocalizedStrings();
+	}
+
+	@TemplateFunction
+	public static List<String> weekDaysShort()
+	{
+		return prefixes(WeekDay.getLocalizedStrings(), 2);
+	}
+
+	@TemplateFunction
+	public static List<String> weekDaysLetters()
+	{
+		return prefixes(WeekDay.getLocalizedStrings(), 1);
+	}
+
+	/**
+	 * The localized month name of the given month (1-12).
+	 */
+	@TemplateFunction
+	public static String monthName(int month)
+	{
+		return MonthNames.getLocalizedStrings().get(month - 1);
+	}
+
+	/**
+	 * The 12 years shown in the global date picker, starting with the given year.
+	 */
+	@TemplateFunction
+	public static List<String> yearRange(int startYear)
+	{
+		final List<String> years = new ArrayList<>();
+		for(int i = startYear; i <= startYear + 11; i++)
+		{
+			years.add(String.valueOf(i));
+		}
+		return years;
+	}
+
+	/**
+	 * FreeMarker's ?upper_case
+	 */
+	@TemplateFunction
+	public static String upperCase(String value)
+	{
+		return value == null ? null : value.toUpperCase();
+	}
+
+	/**
+	 * transaction.getRepeatingOption().getEndOption().getValue() (an Object, which templates cannot read)
+	 */
+	@TemplateFunction
+	public static String repeatingEndValue(Transaction transaction)
+	{
+		return String.valueOf(transaction.getRepeatingOption().getEndOption().getValue());
+	}
+
+	/**
+	 * dateService.getLongDateString(transaction.getRepeatingOption().getEndOption().getValue())
+	 */
+	@TemplateFunction
+	public static String repeatingEndDateString(Transaction transaction)
+	{
+		return ViewServices.dateService.getLongDateString((LocalDate) transaction.getRepeatingOption().getEndOption().getValue());
+	}
+
+	/**
+	 * Consecutive transactions with the same (upper case) date string, as the old template grouped them.
+	 */
+	public record DateGroup(String date, List<Transaction> transactions)
+	{
+	}
+
+	@TemplateFunction
+	public static List<DateGroup> groupByDate(List<Transaction> transactions)
+	{
+		final List<DateGroup> groups = new ArrayList<>();
+		String lastDate = "";
+		for(Transaction transaction : transactions)
+		{
+			final String date = ViewServices.dateService.getDateStringWithMonthName(transaction.getDate()).toUpperCase();
+			if(!date.equals(lastDate) || groups.isEmpty())
+			{
+				groups.add(new DateGroup(date, new ArrayList<>()));
+				lastDate = date;
+			}
+			groups.get(groups.size() - 1).transactions().add(transaction);
+		}
+		return groups;
+	}
+
+	private static List<String> prefixes(List<String> values, int length)
+	{
+		return values.stream().map(value -> value.substring(0, Math.min(length, value.length()))).toList();
+	}
+
+	/**
+	 * All strings of the date picker's localization script joined with '|'. The template writes the old JavaScript
+	 * literals for the languages it knows and falls back to JSON output if this does not match them.
+	 */
+	@TemplateFunction
+	public static String datePickerLocalization()
+	{
+		final List<String> parts = new ArrayList<>(MonthNames.getLocalizedStrings());
+		parts.addAll(WeekDay.getLocalizedStrings());
+		parts.add(Localization.getString("cancel"));
+		parts.add(Localization.getString("ok"));
+		return String.join("|", parts);
+	}
+}
