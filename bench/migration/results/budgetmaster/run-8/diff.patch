+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.templategroup.TemplateGroup">
+
+<t:block t:fragment="buttonNew">
+    <t:block t:replace="~{helpers/header :: buttonLink('/templates/newTemplate', 'add', 'title.template.new', '', 'background-blue', '', false, false, false, '')}"></t:block>
+</t:block>
+
+<t:block t:fragment="buttonEditTemplateGroups">
+    <t:block t:replace="~{helpers/header :: buttonLink('/templateGroups', 'folder', 'title.template.group.edit.short', '', 'background-blue', '', false, false, false, '')}"></t:block>
+</t:block>
+
+<t:block t:fragment="buttons">
+    <div class="row valign-wrapper hide-on-small-only">
+        <div class="col s6 right-align">
+            <t:block t:replace="~{templates/templateFunctions :: buttonNew}"></t:block>
+        </div>
+
+        <div class="col s6 left-align">
+            <t:block t:replace="~{templates/templateFunctions :: buttonEditTemplateGroups}"></t:block>
+        </div>
+    </div>
+    <div class="hide-on-med-and-up">
+        <div class="row valign-wrapper center-align">
+            <div class="col s12">
+                <t:block t:replace="~{templates/templateFunctions :: buttonNew}"></t:block>
+            </div>
+        </div>
+        <div class="row valign-wrapper center-align">
+            <div class="col s12">
+                <t:block t:replace="~{templates/templateFunctions :: buttonEditTemplateGroups}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="listTemplates(Map<TemplateGroup, List<Template>> templatesByGroup)">
+    <div class="container">
+        <div class="row">
+            <div class="col s12">
+                <ul t:each="entry : templatesByGroup" class="collapsible expandable templateCollapsible" t:data-group-id="entry.key.getID()">
+                    <div t:if="templatesByGroup.size() != 1" class="template-group-headline" t:text="categoriesViews.getTemplateGroupName(entry.key)">group</div>
+
+                    <t:block t:each="template : entry.value">
+                        <t:block t:replace="~{templates/templateFunctions :: templateItem(template)}"></t:block>
+                    </t:block>
+                </ul>
+            </div>
+        </div>
+    </div>
+
+     <form id="form-move-template-to-group" method="post" t:action="@{/templateGroups/moveTemplateToGroup}">
+        <input type="hidden" name="templateID" value=""/>
+        <input type="hidden" name="groupID" value=""/>
+     </form>
+</t:block>
+
+<li t:fragment="templateItem(Template template)" class="template-item z-depth-2" t:data-template-id="template.getID()">
+    <div class="collapsible-header bold">
+        <t:block t:replace="~{templates/templateFunctions :: templateHeader(template)}"></t:block>
+        <div class="collapsible-header-button">
