+	}
+
+	/**
+	 * The old categoriesFunctions.getCategoryName(category) FreeMarker function.
+	 */
+	@TemplateFunction
+	public static String getCategoryName(Category category)
+	{
+		if(category == null || category.getName() == null)
+		{
+			return "";
+		}
+
+		if(category.getType() == CategoryType.NONE)
+		{
+			return Localization.getString("category.none");
+		}
+		if(category.getType() == CategoryType.REST)
+		{
+			return Localization.getString("category.rest");
+		}
+		return category.getName();
+	}
+
+	/**
+	 * The old templateFunctions.getTemplateGroupName(templateGroup) FreeMarker function.
+	 */
+	@TemplateFunction
+	public static String getTemplateGroupName(TemplateGroup templateGroup)
+	{
+		if(templateGroup.getType() == TemplateGroupType.DEFAULT)
+		{
+			return Localization.getString("template.group.default");
+		}
+		return templateGroup.getName();
+	}
+
+	/**
+	 * FreeMarker's {@code value?c} for a nullable Integer: empty string for null.
+	 */
+	@TemplateFunction
+	public static String idOrEmpty(Integer id)
+	{
+		return id == null ? "" : String.valueOf(id);
+	}
+
+	/**
+	 * Splits a list into rows of {@code size} items (the old category color grid opened a row every 6 colors).
+	 */
+	@TemplateFunction
+	public static List<List<String>> chunk(List<String> items, int size)
+	{
+		final List<List<String>> rows = new ArrayList<>();
+		for(int i = 0; i < items.size(); i += size)
+		{
+			rows.add(items.subList(i, Math.min(i + size, items.size())));
+		}
+		return rows;
+	}
+}
