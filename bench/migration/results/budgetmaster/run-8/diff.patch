+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.charts.Chart"
+      t:params="Settings settings, List<Notification> notifications, List<Chart> customCharts, List<Chart> defaultCharts">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.charts'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('charts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="locale.getString('menu.charts')">Charts</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::pagecontent(customCharts, defaultCharts)})}">
+                    <t:block t:fragment="pagecontent(List<Chart> customCharts, List<Chart> defaultCharts)">
+                        <br>
+                        <t:block t:replace="~{charts/chartFunctions :: buttons}"></t:block>
+                        <br>
+                        <div class="container">
+                            <div class="section center-align">
+                                <div class="headline-small" t:text="locale.getString('charts.custom')">custom</div>
+                            </div>
+
+                            <table class="bordered">
+                                <thead>
+                                    <tr>
+                                        <th t:text="locale.getString('chart.new.label.name')">name</th>
+                                        <th t:text="locale.getString('chart.actions')">actions</th>
+                                    </tr>
+                                </thead>
+                                <tr t:each="chart : customCharts">
+                                    <td t:text="chartsViews.chartName(chart)">name</td>
+                                    <td>
+                                        <t:block t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.getID() + '/edit', 'edit', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                                        <t:block t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.getID() + '/requestDelete', 'delete', '', '', 'no-padding text-default button-request-delete-chart', true, false, '', '', '')}"></t:block>
+                                    </td>
+                                </tr>
+                            </table>
+                            <t:block t:if="customCharts.size() == 0">
+                                <div class="center-align charts-default-margin" t:text="locale.getString('placeholder')">placeholder</div>
+                                <br>
+                            </t:block>
+
+                            <div class="section center-align charts-default-margin">
+                                <div class="headline-small" t:text="locale.getString('charts.default')">default</div>
+                            </div>
+
+                            <table class="bordered">
+                                <thead>
+                                    <tr>
+                                        <th t:text="locale.getString('chart.new.label.name')">name</th>
+                                        <th t:text="locale.getString('chart.display.type')">display type</th>
+                                        <th t:text="locale.getString('chart.group.type')">group type</th>
+                                        <th t:text="locale.getString('chart.actions')">actions</th>
+                                    </tr>
+                                </thead>
+                                <tr t:each="chart : defaultCharts">
+                                    <td t:text="chartsViews.chartName(chart)">name</td>
+                                    <td><t:block t:replace="~{charts/chartFunctions :: iconForItem(chart.getDisplayType().getIcon(), chart.getDisplayType().getLocalizationKey())}"></t:block></td>
+                                    <td><t:block t:replace="~{charts/chartFunctions :: iconForItem(chart.getGroupType().getIcon(), chart.getGroupType().getLocalizationKey())}"></t:block></td>
+                                    <td>
+                                        <t:block t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.getID() + '/edit', 'visibility', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                                    </td>
+                                </tr>
+                            </table>
+                        </div>
+                    </t:block>
+                </t:block>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/charts.js}"></script>
+    </body>
+</html>
