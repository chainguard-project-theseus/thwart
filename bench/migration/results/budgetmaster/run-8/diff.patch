diff --git a/BudgetMasterServer/src/main/resources/templates/settings/containers/settingsTransactions.html b/BudgetMasterServer/src/main/resources/templates/settings/containers/settingsTransactions.html
new file mode 100644
index 00000000..17f18509
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/settings/containers/settingsTransactions.html
@@ -0,0 +1,121 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.transactions.keywords.TransactionNameKeyword"
+         t:params="Settings settings, List<TransactionNameKeyword> transactionNameKeywords, String toastContent">
+
+<t:block t:fragment="transactionsSettingsContainer(boolean importScripts, Settings settings, List<TransactionNameKeyword> transactionNameKeywords, String toastContent)">
+    <t:block t:replace="~{settings/containers/settingsContainer :: settingsContainer('TransactionsSettingsContainer', 'transactionsSettingsContainer', importScripts, '/settings/save/transactions', toastContent, ~{::transactionsContent(settings, transactionNameKeywords)})}">
+        <t:block t:fragment="transactionsContent(Settings settings, List<TransactionNameKeyword> transactionNameKeywords)">
+            <div class="row">
+                <div class="col s12">
+                    <div class="table-container">
+                        <div class="table-cell">
+                            <div class="switch-cell-margin" t:text="locale.getString('settings.rest')">rest</div>
+                            <div class="switch-cell-margin" t:text="locale.getString('settings.transactionNameSuggestionOrder')">order</div>
+                        </div>
+                        <div class="table-cell table-cell-spacer"></div>
+                        <div class="table-cell">
+                            <t:block t:replace="~{settings/settingsMacros :: switch('rest', 'restActivated', settings.isRestActivated())}"></t:block>
+                            <t:block t:replace="~{settings/settingsMacros :: switch('transactionNameSuggestionOrder', 'orderTransactionNameSuggestionsAlphabetically', settings.getOrderTransactionNameSuggestionsAlphabetically() != null && settings.getOrderTransactionNameSuggestionsAlphabetically())}"></t:block>
+                        </div>
+                        <div class="table-cell table-cell-spacer"></div>
+                        <div class="table-cell">
+                            <div class="switch-cell-margin">
+                                <a class="btn btn-flat tooltipped text-default" data-position="bottom" t:data-tooltip="locale.getString('settings.rest.description')"><i class="material-icons">help_outline</i></a>
+                            </div>
+                            <div class="switch-cell-margin">
+                                <a class="btn btn-flat tooltipped text-default" data-position="bottom" t:data-tooltip="locale.getString('settings.transactionNameSuggestionOrder.description')"><i class="material-icons">help_outline</i></a>
+                            </div>
+                        </div>
+                    </div>
+                </div>
+            </div>
+
+            <div class="row no-margin-bottom">
+                <div class="col s12 m12 l8 offset-l2">
+                    <div class="tag-input-container">
+                        <i class="material-icons prefix">rule_folder</i>
+                        <div class="tag-input">
+                            <!-- the old markup had a second class attribute (chips-label), which browsers ignore -->
+                            <label class="input-label" for="settings-keywords" t:text="locale.getString('settings.transactions.keywords')">keywords</label>
+                            <div id="settings-keywords" class="chips chips-placeholder"></div>
+                        </div>
+                    </div>
+                </div>
+                <div id="hidden-transaction-name-keywords"></div>
+                <!-- the old page wrote a JavaScript literal; [[...]] writes JSON, so the default and empty keyword lists are written literally -->
+                <script t:if="settingsViews.keywordSignature(transactionNameKeywords) == 'einnahme|rückzahlung|erstattung|zinsen|lohn|gehalt|gutschrift|income|refund|interest|salary'">
+                    keywordsPlaceholder = [[${locale.getString('settings.transactions.keywords.placeholder')}]];
+                    var initialKeywords = [ {tag: 'einnahme'}, {tag: 'rückzahlung'}, {tag: 'erstattung'}, {tag: 'zinsen'}, {tag: 'lohn'}, {tag: 'gehalt'}, {tag: 'gutschrift'}, {tag: 'income'}, {tag: 'refund'}, {tag: 'interest'}, {tag: 'salary'}, ];
+                </script>
+                <script t:if="settingsViews.keywordSignature(transactionNameKeywords) == ''">
+                    keywordsPlaceholder = [[${locale.getString('settings.transactions.keywords.placeholder')}]];
+                    var initialKeywords = [ ];
+                </script>
+                <script t:unless="settingsViews.keywordSignature(transactionNameKeywords) == 'einnahme|rückzahlung|erstattung|zinsen|lohn|gehalt|gutschrift|income|refund|interest|salary' || settingsViews.keywordSignature(transactionNameKeywords) == ''">
+                    keywordsPlaceholder = [[${locale.getString('settings.transactions.keywords.placeholder')}]];
+                    var initialKeywords = [[${settingsViews.keywordTags(transactionNameKeywords)}]];
+                </script>
+            </div>
+
+            <div class="row">
+                <div class="col s10 offset-s1 m8 offset-m2 l6 offset-l3">
+                    <div id="settings-keywords-description">
+                        <i class="material-icons">help_outline</i>
+                        <div t:text="locale.getString('settings.transactions.keywords.description')">
+                            description
+                        </div>
+                    </div>
+                </div>
+            </div>
+
+            <br>
+
+            <div class="row">
+                <div class="col s12 center-align">
+                    <button class="btn waves-effect waves-light background-green " type="submit" name="action" onclick="return validateTransactionForm()">
+                        <i class="material-icons left">save</i>[[${locale.getString('save')}]]
+                    </button>
+                </div>
+            </div>
+
+            <script>
+                M.Chips.init(document.querySelectorAll('.chips'), {
+                    placeholder: keywordsPlaceholder,
+                    secondaryPlaceholder: keywordsPlaceholder,
+                    data: initialKeywords,
+                    onChipAdd: onKeywordsChange,
+                    onChipDelete: onKeywordsChange
+                });
+
+                function onKeywordsChange()
+                {
+                    toggleSettingsContainerHeader('transactionsSettingsContainerHeader', false);
+                }
+
+                function validateTransactionForm()
+                {
+                    let keywords = M.Chips.getInstance(document.querySelector('.chips')).chipsData;
+                    let parent = document.getElementById('hidden-transaction-name-keywords');
+                    for(let i = 0; i < keywords.length; i++)
+                    {
+                        let input = document.createElement('input');
+                        input.setAttribute('type', 'hidden');
+                        input.setAttribute('name', 'keywords[' + i + '].value');
+                        input.setAttribute('value', keywords[i].tag);
+                        parent.appendChild(input);
+                    }
+
+                    return true;
+                }
+
+                $('input[name="restActivated"]').change(function()
+                {
+                    toggleSettingsContainerHeader('transactionsSettingsContainerHeader', false);
+                });
+            </script>
+        </t:block>
+    </t:block>
+</t:block>
+
+<t:block t:replace="~{::transactionsSettingsContainer(true, settings, transactionNameKeywords, toastContent)}"></t:block>
+
+</t:block>
