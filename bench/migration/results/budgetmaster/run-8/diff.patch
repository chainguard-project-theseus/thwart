+
+<t:block t:fragment="templateName(Template template)">
+    <tr t:if="!strings.isEmpty(template.getName())">
+        <td class="template-content-label" t:text="locale.getString('transaction.new.label.name')">Name</td>
+        <td t:text="template.getName()">name</td>
+    </tr>
+</t:block>
+
+<t:block t:fragment="templateAmount(Template template)">
+    <tr t:if="template.getAmount() != null">
+        <td class="template-content-label" t:text="locale.getString('transaction.new.label.amount')">Amount</td>
+        <td t:text="currencyService.getCurrencyString(template.getAmount())">amount</td>
+    </tr>
+</t:block>
+
+<t:block t:fragment="templateCategory(Template template)">
+    <tr t:if="template.getCategory() != null">
+        <td class="template-content-label" t:text="locale.getString('transaction.new.label.category')">Category</td>
+        <td t:text="categoriesViews.getCategoryName(template.getCategory())">category</td>
+    </tr>
+</t:block>
+
+<t:block t:fragment="templateDescription(Template template)">
+    <tr t:if="!strings.isEmpty(template.getDescription())">
+        <td class="template-content-label" t:text="locale.getString('transaction.new.label.description')">Description</td>
+        <td t:text="template.getDescription()">description</td>
+    </tr>
+</t:block>
+
+<t:block t:fragment="templateTags(Template template)">
+    <tr t:if="template.getTags() != null && template.getTags().size() > 0">
+        <td class="template-content-label" t:text="locale.getString('transaction.new.label.tags')">Tags</td>
+        <td class="chips-placeholder">
+            <div t:each="tag : template.getTags()" class="chip" t:text="tag.getName()">tag</div>
+        </td>
+    </tr>
+</t:block>
+
+<t:block t:fragment="templateAccount(Template template)">
+    <tr t:if="template.getAccount() != null">
+        <td class="template-content-label" t:text="locale.getString('transaction.new.label.account')">Account</td>
+        <td t:text="template.getAccount().getName()">account</td>
+    </tr>
+</t:block>
+
+<t:block t:fragment="templateTransferAccount(Template template)">
+    <tr t:if="template.getTransferAccount() != null">
+        <td class="template-content-label" t:text="locale.getString('transaction.new.label.transfer.account')">Transfer account</td>
+        <td t:text="template.getTransferAccount().getName()">account</td>
+    </tr>
+</t:block>
+
+<div t:fragment="templateNameInput(Template template, Map<String, String> fieldErrors)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <i class="material-icons prefix">file_copy</i>
+        <input id="template-name" type="text" name="templateName"
+               t:class="validation.cssClass(fieldErrors, 'templateName', '')"
+               t:data-position="validation.hasError(fieldErrors, 'templateName') ? 'bottom'"
+               t:data-delay="validation.hasError(fieldErrors, 'templateName') ? '50'"
+               t:data-tooltip="validation.tooltip(fieldErrors, 'templateName')"
+               t:value="template.getTemplateName() == null ? '' : template.getTemplateName()">
+        <label for="template-name" t:text="locale.getString('template.new.label.name')">Name</label>
+    </div>
+</div>
+
+<div t:fragment="templateIncludeAccountCheckbox(String id, String name, String label, boolean checked)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <label>
+            <input t:id="id" t:name="name" type="checkbox" t:checked="checked">
+            <span class="columnName-checkbox-label text-default" t:text="label">label</span>
+        </label>
+    </div>
+</div>
+
+<t:block t:fragment="templateHeaderIcon(Template template)">
+        <t:block t:if="template.getIconReference() != null && (template.getIconReference().isImageIcon() || template.getIconReference().isBuiltinIcon())">
+            <t:block t:replace="~{helpers/header :: entityIcon(template, 'template-icon', '')}"></t:block>
+        </t:block>
+        <t:block t:unless="template.getIconReference() != null && (template.getIconReference().isImageIcon() || template.getIconReference().isBuiltinIcon())">
+            <i t:if="template.getTransferAccount() != null" class="material-icons">swap_horiz</i>
+            <i t:if="template.getTransferAccount() == null" class="material-icons">payment</i>
+        </t:block>
+    </t:block>
+
+</t:block>
