+package de.deadlocker8.budgetmaster.views;
+
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.Map;
+
+/**
+ * Replaces the old validation macro, which wrote class and tooltip attributes onto the caller's input.
+ * {@code fieldErrors} is the model attribute added by {@link FieldErrorsInterceptor} (null without validation errors).
+ */
+@TemplateFunctions("validation")
+public final class ValidationFunctions
+{
+	private ValidationFunctions()
+	{
+	}
+
+	@TemplateFunction
+	public static boolean hasError(Map<String, String> fieldErrors, String fieldName)
+	{
+		return fieldErrors != null && fieldErrors.containsKey(fieldName);
+	}
+
+	@TemplateFunction
+	public static String cssClass(Map<String, String> fieldErrors, String fieldName, String classes)
+	{
+		return hasError(fieldErrors, fieldName) ? "tooltipped invalid " + classes : "validate " + classes;
+	}
+
+	@TemplateFunction
+	public static String tooltip(Map<String, String> fieldErrors, String fieldName)
+	{
+		return hasError(fieldErrors, fieldName) ? Localization.getString(fieldErrors.get(fieldName)) : null;
+	}
+}
diff --git a/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/views/ViewFunctions.java b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/views/ViewFunctions.java
