+                <t:block t:replace="~{templates/templateFunctions :: templateAmount(template)}"></t:block>
+                <t:block t:replace="~{templates/templateFunctions :: templateCategory(template)}"></t:block>
+                <t:block t:replace="~{templates/templateFunctions :: templateDescription(template)}"></t:block>
+                <t:block t:replace="~{templates/templateFunctions :: templateTags(template)}"></t:block>
+                <t:block t:replace="~{templates/templateFunctions :: templateAccount(template)}"></t:block>
+                <t:block t:replace="~{templates/templateFunctions :: templateTransferAccount(template)}"></t:block>
