+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.database.InternalDatabase"
+      t:params="Settings settings, InternalDatabase database">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('settings.database.import'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('settings', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="locale.getString('info.title.database.import.dialog')">import</div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline-small" t:text="locale.getString('info.database.import')">import</div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <form name="Import" t:action="@{/settings/database/import/step1}" method="post">
+                        <div class="row">
+                            <div class="col s12 m10 offset-m1 l10 offset-l1 xl8 offset-xl2">
+                                <table class="bordered">
+                                    <tr t:each="entry : database.getNumberOfEntitiesByType()">
+                                        <td>
+                                            <label>
+                                                <input type="checkbox" checked="checked" t:name="entry.key" t:disabled="entry.key.getImportRequired() == 'REQUIRED'">
+                                                <span></span>
+                                            </label>
+                                        </td>
+                                        <td><i class="material-icons left" t:text="entry.key.getIcon()">icon</i>
+                                            <div class="import-entity-name" t:text="locale.getString(entry.key.getLocalizationKey())">name</div>
+                                        </td>
+                                        <td t:text="entry.value">0</td>
+                                        <td><a class="btn btn-flat text-default import-entity-help-button"
+                                               t:data-title="locale.getString(entry.key.getLocalizationKey())"
+                                               t:data-text="locale.getString('import.entity.' + settingsViews.lowerCaseName(entry.key))"><i class="material-icons">help_outline</i></a>
+                                        </td>
+                                    </tr>
+                                </table>
+                            </div>
+                        </div>
+
+                        <div class="row">
+                            <div class="col m6 l4 offset-l2 right-align">
+                                <t:block t:replace="~{helpers/header :: buttonLink('/settings', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                            </div>
+
+                            <div class="col m6 l4 left-align">
+                                <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'unarchive', 'settings.database.import', 'buttonImport', 'green', '', false, '', '', '')}"></t:block>
+                            </div>
+                        </div>
+                    </form>
+
+                    <div id="modal-import-entity-help" class="modal background-color">
+                        <div class="modal-content">
+                            <h4 id="modal-import-entity-help-title"></h4>
+                            <p id="modal-import-entity-help-content"></p>
+                        </div>
+                        <div class="modal-footer background-color">
+                            <t:block t:replace="~{helpers/header :: buttonLink('', 'done', 'ok', '', 'green', 'modal-action modal-close text-white', false, true, false, '')}"></t:block>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/import.js}"></script>
+    </body>
+</html>
