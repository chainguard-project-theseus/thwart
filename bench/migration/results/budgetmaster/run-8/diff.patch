+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.images.Image"
+         t:params="List<Image> availableImages, Integer selectedImageID">
+
+<t:block t:each="image : availableImages">
+    <t:block t:replace="~{helpers/availableImages :: imageOption(image, 'item-icon', selectedImageID)}"></t:block>
+</t:block>
+
+<div t:fragment="imageOption(Image image, String classPrefix, Integer selectedImageID)" t:class="|col s4 m2 l2 ${classPrefix}-option-column|">
+    <div t:class="|${classPrefix}-option|" t:classappend="selectedImageID != null && selectedImageID == image.getID() ? 'selected'">
+        <img t:src="@{/media/getImageByID/{id}(id=image.getID())}" t:class="|${classPrefix}-preview|" t:data-image-id="image.getID()"/>
+    </div>
+    <t:block t:replace="~{helpers/header :: buttonFlat('/media/deleteImage/' + image.getID(), 'delete', 'delete.question', '', 'no-padding text-default ' + classPrefix + '-option-delete', true, false, '', '', '')}"></t:block>
+</div>
+
+</t:block>
