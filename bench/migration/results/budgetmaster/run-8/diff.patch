diff --git a/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html b/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html
new file mode 100644
index 00000000..da856d3b
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html
@@ -0,0 +1,93 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.categories.Category"
+      t:params="Settings settings, List<Notification> notifications, Category category, String customColor, List<String> categoryColors, Map<String, String> fieldErrors">
+    <head t:with="title=category.getID() != null ? locale.getString('title.category.edit') : locale.getString('title.category.new')">
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('categories', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="category.getID() != null ? locale.getString('title.category.edit') : locale.getString('title.category.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::pagecontent(category, customColor, categoryColors, fieldErrors)})}">
+                    <t:block t:fragment="pagecontent(Category category, String customColor, List<String> categoryColors, Map<String, String> fieldErrors)">
+                    <div class="container">
+                        <form name="NewCategory" t:action="@{/categories/newCategory}" method="post">
+                            <input type="hidden" name="ID" t:value="categoriesViews.idOrEmpty(category.getID())">
+                            <input type="hidden" name="type" t:value="category.getType() == null ? '' : '' + category.getType()">
+
+                            <div class="row">
+                                <div class="input-field col s12 m12 l8 offset-l2"
+                                     t:with="isNameEditingForbidden=category.getType() != null && (category.getType() == 'NONE' || category.getType() == 'REST')">
+                                    <i class="material-icons prefix">edit</i>
+                                    <input t:if="!isNameEditingForbidden" id="category-name" type="text" name="name"
+                                           t:class="validation.cssClass(fieldErrors, 'name', '')"
+                                           t:data-position="validation.hasError(fieldErrors, 'name') ? 'bottom'"
+                                           t:data-delay="validation.hasError(fieldErrors, 'name') ? '50'"
+                                           t:data-tooltip="validation.tooltip(fieldErrors, 'name')"
+                                           t:value="categoriesViews.getCategoryName(category)">
+                                    <input t:if="isNameEditingForbidden" id="category-name" type="text" name="name" t:value="categoriesViews.getCategoryName(category)" readonly>
+                                    <label for="category-name" t:text="locale.getString('category.new.label.name')">Name</label>
+                                </div>
+                            </div>
+
+                            <input type="hidden" name="color" id="categoryColor" t:value="category.getColor()">
+                            <div class="row" t:each="colorRow, colorRowStat : categoriesViews.chunk(categoryColors, 6)">
+                                <div t:each="color, colorStat : colorRow" t:class="colorStat.first ? 'col s2 m1 offset-m3 no-padding' : 'col s2 m1 no-padding'">
+                                    <t:block t:replace="~{helpers/styles :: div_background(color, null, color == category.getColor() ? 'category-color category-color-active' : 'category-color', null, null)}"></t:block>
+                                </div>
+                                <div t:if="colorRowStat.last" class="col s2 m1 no-padding">
+                                    <t:block t:replace="~{helpers/styles :: div_background(customColor, 'customColorPickerContainer', customColor == category.getColor() ? 'category-color category-color-active' : 'category-color', null, ~{::plusSign})}"><span t:fragment="plusSign">+</span></t:block>
+                                </div>
+                            </div>
+
+                            <t:block t:replace="~{helpers/iconSelect :: iconSelect('category-icon', category, true, '', '', false)}"></t:block>
+
+                            <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(category)}"></t:block>
+
+                            <br>
+
+                            <div class="row hide-on-small-only">
+                                <div class="col s6 right-align">
+                                    <t:block t:replace="~{helpers/header :: buttonLink('/categories', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                                </div>
+
+                                <div class="col s6 left-align">
+                                    <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '', '')}"></t:block>
+                                </div>
+                            </div>
+                            <div class="hide-on-med-and-up">
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{helpers/header :: buttonLink('/categories', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                                    </div>
+                                </div>
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '', '')}"></t:block>
+                                    </div>
+                                </div>
+                            </div>
+                        </form>
+                    </div>
+                    </t:block>
+                </t:block>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/iconSelect :: modalIconSelect('category-name', category)}"></t:block>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/categories.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
