@@ -0,0 +1,105 @@
+package de.deadlocker8.budgetmaster.views;
+
+import de.deadlocker8.budgetmaster.categories.Category;
+import de.deadlocker8.budgetmaster.categories.CategoryType;
+import de.deadlocker8.budgetmaster.icon.Iconizable;
+import de.deadlocker8.budgetmaster.templates.Template;
+import de.deadlocker8.budgetmaster.utils.FontAwesomeIcons;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.List;
+
+/**
+ * Computations of the account pages and the shared helpers customSelectMacros, iconSelect and fontColorPicker.
+ */
+@TemplateFunctions("accountsViews")
+public final class AccountsViewFunctions
+{
+	private AccountsViewFunctions()
+	{
+	}
+
+	/**
+	 * The old categoriesFunctions.getCategoryName.
+	 */
+	@TemplateFunction
+	public static String categoryName(Category category)
+	{
+		if(category == null || category.getName() == null)
+		{
+			return "";
+		}
+		if(category.getType() == CategoryType.NONE)
+		{
+			return Localization.getString("category.none");
+		}
+		if(category.getType() == CategoryType.REST)
+		{
+			return Localization.getString("category.rest");
+		}
+		return category.getName();
+	}
+
+	/**
+	 * {@code item.getDefaultFontColor(settings.isUseDarkTheme())}.
+	 */
+	@TemplateFunction
+	public static String defaultFontColor(Iconizable item)
+	{
+		return item.getDefaultFontColor(HelpersFunctions.getSettings().isUseDarkTheme());
+	}
+
+	/**
+	 * {@code item.getColor()} for items that have a color (categories), else null.
+	 */
+	@TemplateFunction
+	public static String itemColor(Iconizable item)
+	{
+		if(item instanceof Category category)
+		{
+			return category.getColor();
+		}
