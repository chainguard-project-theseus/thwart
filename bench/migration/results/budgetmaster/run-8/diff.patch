+        <tr t:each="cswRow : csvRows">
+            <td t:each="csvColumn : cswRow.getColumns()" t:text="csvColumn">value</td>
+        </tr>
+    </table>
+</div>
+
+<t:block t:fragment="renderCsvTransactions(List<CsvTransaction> csvTransactions, List<Category> categories, String suggestionsJSON)">
+    <div id="transaction-import-list">
+        <table class="centered" id="table-transaction-rows" style="width:100%">
+            <thead>
+                <tr>
+                    <td class="bold" t:text="locale.getString('transactions.import.status')">status</td>
+                    <td class="bold" t:text="locale.getString('transaction.new.label.date')">date</td>
+                    <td class="bold" t:text="locale.getString('transaction.new.label.category')">category</td>
+                    <td class="bold" t:text="locale.getString('transaction.new.label.name')">name</td>
+                    <td class="bold" t:text="locale.getString('transaction.new.label.description')">description</td>
+                    <td class="bold" t:text="locale.getString('transaction.new.label.amount')">amount</td>
+                    <td class="bold" t:text="locale.getString('transactions.import.actions')">actions</td>
+                </tr>
+            </thead>
+
+            <tbody>
+                <t:block t:each="csvTransaction, csvTransactionStat : csvTransactions">
+                    <t:block t:replace="~{transactions/transactionImportMacros :: renderCsvTransaction(csvTransaction, csvTransactionStat.index, categories)}"></t:block>
+                </t:block>
+            </tbody>
+        </table>
+
+        <div class="hidden">
+            <form t:each="csvTransaction, csvTransactionStat : csvTransactions" name="NewTransactionInPlace" t:id="|newTransactionInPlace_${csvTransactionStat.index}|" method="POST" t:action="@{/transactionImport/{index}/newTransactionInPlace(index=csvTransactionStat.index)}" t:data-index="csvTransactionStat.index">
+            </form>
+        </div>
+    </div>
+
+    <t:block t:replace="~{transactions/newTransactionMacros :: insertNameSuggestions(suggestionsJSON)}"></t:block>
+</t:block>
+
+<tr t:fragment="renderCsvTransaction(CsvTransaction csvTransaction, int index, List<Category> categories)"
+    class="transaction-import-row" t:classappend="csvTransaction.getStatus() == 'SKIPPED' ? 'transaction-import-row-skipped'" t:id="|transaction-import-row-${index}|"
+    t:with="skipped=csvTransaction.getStatus() == 'SKIPPED', formID='newTransactionInPlace_' + index, statusText=locale.getString(csvTransaction.getStatus().getLocalizationKey()), dateText='' + csvTransaction.getDate(), amountText=currencyService.getCurrencyString(csvTransaction.getAmount())">
+    <td t:data-order="statusText" t:data-search="statusText"><t:block t:replace="~{transactions/transactionImportMacros :: statusBanner(csvTransaction.getStatus())}"></t:block></td>
+    <td t:data-order="dateText" t:data-search="dateText" t:text="dateText">date</td>
+    <td t:data-order="csvTransaction.getCategory().getName()" t:data-search="csvTransaction.getCategory().getName()">
+        <t:block t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, csvTransaction.getCategory(), 'left-align no-margin-top no-margin-bottom', '', 'csvTransaction-category-' + index, false, 'no-margin-bottom', skipped, formID)}"></t:block>
+    </td>
+    <td t:data-order="csvTransaction.getName()" t:data-search="csvTransaction.getName()">
+        <div class="input-field no-margin-top no-margin-bottom">
+            <input t:form="formID" class="no-margin-bottom autocomplete" type="text" name="name" autocomplete="off" required t:value="csvTransaction.getName()" t:disabled="skipped">
+        </div>
+    </td>
+    <td t:data-order="csvTransaction.getDescription()" t:data-search="csvTransaction.getDescription()">
+        <div class="input-field no-margin-top no-margin-bottom">
+            <input t:form="formID" class="no-margin-bottom" type="text" name="description" t:value="csvTransaction.getDescription()" t:disabled="skipped">
+        </div>
+    </td>
+    <td t:data-order="amountText" t:data-search="amountText" t:text="amountText">amount</td>
+    <td>
+        <t:block t:if="skipped">
+            <t:block t:replace="~{helpers/header :: buttonFlat('/transactionImport/' + index + '/undoSkip', 'do_disturb_off', '', '', 'no-padding text-default button-request-transaction-import-undo-skip', true, false, '', '', '' + index)}"></t:block>
+        </t:block>
+        <t:block t:unless="skipped">
+            <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', '', '', 'background-blue', 'text-white', false, '', '', formID)}"></t:block>&nbsp;
+            <div class="fixed-action-btn edit-transaction-button">
+                <a class="btn-floating btn-flat waves-effect waves-light no-padding text-default edit-transaction-button-link">
+                    <i class="material-icons text-default">edit</i>
+                </a>
+                <ul class="new-transaction-button-list">
+                    <li>
+                        <a t:href="@{/transactionImport/{index}/newTransaction/normal(index=index)}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="locale.getString('title.transaction.new', locale.getString('title.transaction.new.normal'))">normal</a>
+                        <a t:href="@{/transactionImport/{index}/newTransaction/normal(index=index)}" class="btn-floating btn background-orange"><i class="material-icons">payment</i></a>
+                    </li>
+                    <li>
+                        <a t:href="@{/transactionImport/{index}/newTransaction/transfer(index=index)}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="locale.getString('title.transaction.new', locale.getString('title.transaction.new.transfer'))">transfer</a>
+                        <a t:href="@{/transactionImport/{index}/newTransaction/transfer(index=index)}" class="btn-floating btn background-green-dark"><i class="material-icons">swap_horiz</i></a>
+                    </li>
+                    <li>
+                        <a t:href="@{/transactionImport/{index}/newFromTemplate(index=index)}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="locale.getString('title.transaction.new', locale.getString('title.transaction.new.from.template'))">template</a>
+                        <a t:href="@{/transactionImport/{index}/newFromTemplate(index=index)}" class="btn-floating btn background-blue-baby"><i class="material-icons">file_copy</i></a>
+                    </li>
+                </ul>
+            </div>
+            <t:block t:replace="~{helpers/header :: buttonFlat('/transactionImport/' + index + '/skip', 'do_not_disturb_on', '', '', 'no-padding text-default button-request-transaction-import-skip', true, false, '', '', '' + index)}"></t:block>
+        </t:block>
+    </td>
+</tr>
+
+<t:block t:fragment="showColumnSettingsErrors(List<String> errorsColumnSettings)">
+    <div t:if="errorsColumnSettings != null && !errorsColumnSettings.isEmpty()" class="container" id="parseErrors">
+        <div class="row">
+            <div class="col s12">
+                <ul class="collapsible">
+                    <li>
+                        <div class="collapsible-header bold">
+                            <i class="fas fa-exclamation-triangle text-red"></i>
+                            [[${locale.getString('info.database.import.result.errors')}]]
+                        </div>
+                        <div class="collapsible-body">
+                            <table class="bordered">
+                                <tr t:each="error : errorsColumnSettings">
+                                    <td><i class="fas fa-exclamation-triangle text-red"></i></td>
+                                    <td t:text="error">error</td>
+                                </tr>
+                            </table>
+                        </div>
+                    </li>
+                </ul>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<div t:fragment="statusBanner(CsvTransactionStatus status)"
+     t:class="|banner ${status == 'PENDING' ? 'background-blue text-white' : (status == 'IMPORTED' ? 'background-green text-white' : (helpers.getSettings().isUseDarkTheme() ? 'background-grey text-black' : 'background-grey text-white'))}|"
+     t:text="locale.getString(status.getLocalizationKey())">status</div>
+
+</t:block>
