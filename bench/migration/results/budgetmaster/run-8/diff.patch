@@ -0,0 +1,101 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.reports.Budget, de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.filter.FilterConfiguration"
