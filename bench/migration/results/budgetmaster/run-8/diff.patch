+        </a>
+        <ul>
+            <li t:if="canChangeType">
+                <a class="btn-floating btn transaction-action mobile-fab-tip no-wrap" data-action-type="changeType" t:data-url="@{/transactions/{id}/changeTypeModal(id=transaction.getID())}" t:text="locale.getString('transaction.change.type')">change type</a>
+                <a class="btn-floating btn transaction-action background-blue-baby" data-action-type="changeType" t:data-url="@{/transactions/{id}/changeTypeModal(id=transaction.getID())}"><i class="material-icons">shuffle</i></a>
+            </li>
+            <li t:if="canCreateTemplate">
+                <a class="btn-floating btn transaction-action mobile-fab-tip no-wrap" data-action-type="saveAsTemplate" t:data-url="@{/templates/fromTransactionModal}" t:text="locale.getString('save.as.template')">save as template</a>
+                <a class="btn-floating btn transaction-action background-orange-dark" data-action-type="saveAsTemplate" t:data-url="@{/templates/fromTransactionModal}"><i class="material-icons">file_copy</i></a>
+            </li>
+        </ul>
+    </div>
+</t:block>
+
+</t:block>
