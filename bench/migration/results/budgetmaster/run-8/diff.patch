+        weekDays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', ];
+        weekDaysShort = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', ];
+        weekDaysLetters = ['S', 'M', 'T', 'W', 'T', 'F', 'S', ];
+        buttonCancel = 'Cancel';
+        buttonClose = 'OK';
+    </script>
+    <script t:if="transactionsViews.datePickerLocalization() == 'Januar|Februar|März|April|Mai|Juni|Juli|August|September|Oktober|November|Dezember|Sonntag|Montag|Dienstag|Mittwoch|Donnerstag|Freitag|Samstag|Abbrechen|OK'">
+        monthNames = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember', ];
+        monthNamesShort = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez', ];
+        weekDays = ['Sonntag', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', ];
+        weekDaysShort = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', ];
+        weekDaysLetters = ['S', 'M', 'D', 'M', 'D', 'F', 'S', ];
+        buttonCancel = 'Abbrechen';
+        buttonClose = 'OK';
+    </script>
+    <script t:unless="transactionsViews.datePickerLocalization() == 'January|February|March|April|May|June|July|August|September|October|November|December|Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Cancel|OK' || transactionsViews.datePickerLocalization() == 'Januar|Februar|März|April|Mai|Juni|Juli|August|September|Oktober|November|Dezember|Sonntag|Montag|Dienstag|Mittwoch|Donnerstag|Freitag|Samstag|Abbrechen|OK'">
+        monthNames = [[${transactionsViews.monthNames()}]];
+        monthNamesShort = [[${transactionsViews.monthNamesShort()}]];
+        weekDays = [[${transactionsViews.weekDays()}]];
+        weekDaysShort = [[${transactionsViews.weekDaysShort()}]];
+        weekDaysLetters = [[${transactionsViews.weekDaysLetters()}]];
+        buttonCancel = [[${locale.getString('cancel')}]];
+        buttonClose = [[${locale.getString('ok')}]];
+    </script>
+</t:block>
+
+</t:block>
