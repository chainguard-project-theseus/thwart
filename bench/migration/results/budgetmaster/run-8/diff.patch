+package de.deadlocker8.budgetmaster.views;
+
+import de.deadlocker8.budgetmaster.icon.Iconizable;
+import dev.tessera.runtime.TemplateFunction;
+import org.springframework.security.web.csrf.CsrfToken;
+import org.springframework.web.context.request.RequestContextHolder;
+import org.springframework.web.context.request.ServletRequestAttributes;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Small computations the FreeMarker templates did with built-ins or by calling methods with arguments.
+ */
+@TemplateFunctions("views")
+public final class ViewFunctions
+{
+	private ViewFunctions()
+	{
+	}
+
+	/**
+	 * FreeMarker's {@code name?capitalize[0]}.
+	 */
+	@TemplateFunction
+	public static String firstCharCapitalized(String name)
+	{
+		if(name == null || name.isEmpty())
+		{
+			return "";
+		}
+		return name.substring(0, 1).toUpperCase();
+	}
+
+	@TemplateFunction
+	public static String fontColor(Iconizable entity)
+	{
+		return entity.getFontColor(HelpersFunctions.getSettings().isUseDarkTheme());
+	}
+
+	/**
+	 * FreeMarker's {@code enumValue.name()}; printing an enum in a template uses its toString().
+	 */
+	@TemplateFunction
+	public static String enumName(Object value)
+	{
+		return value == null ? null : ((Enum<?>) value).name();
+	}
+
+	/**
+	 * The current request's CSRF token, for the one form that rendered its token input by hand (with an id the scripts read).
+	 */
+	@TemplateFunction
+	public static String csrfToken()
+	{
+		if(!(RequestContextHolder.getRequestAttributes() instanceof ServletRequestAttributes attributes))
+		{
+			return null;
+		}
+		final CsrfToken token = (CsrfToken) attributes.getRequest().getAttribute(CsrfToken.class.getName());
+		return token == null ? null : token.getToken();
+	}
+}
