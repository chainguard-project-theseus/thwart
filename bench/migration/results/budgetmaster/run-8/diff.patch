+++ b/BudgetMasterServer/src/main/resources/templates/accounts/accounts.html
@@ -0,0 +1,146 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountsFilterConfiguration"
+      t:params="Settings settings, List<Notification> notifications, List<Account> accounts, AccountsFilterConfiguration accountsFilterConfiguration, Account currentAccount, Boolean accountNotDeletable">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.accounts'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('accounts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">account_balance</i> [[${locale.getString('menu.accounts')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::pagecontent(accounts, accountsFilterConfiguration)})}">
+                    <t:block t:fragment="pagecontent(List<Account> accounts, AccountsFilterConfiguration accountsFilterConfiguration)">
+                    <br>
+                    <div class="center-align"><t:block t:replace="~{helpers/header :: buttonLink('/accounts/newAccount', 'add', 'title.account.new', 'button-new-account', 'background-blue', '', false, false, false, '')}"></t:block></div>
+                    <br>
+                    <div class="container account-container">
+                        <form name="AccountsFilter" t:action="@{/accounts/applyFilter}" method="post">
+                            <table class="bordered">
+                                <thead class="hide-on-med-and-down">
+                                    <tr>
+                                        <th></th>
+                                        <th>
+                                            <div t:text="locale.getString('account.new.label.state')">state</div>
+                                            <div>
+                                                <label>
+                                                    <input type="checkbox" name="includeFullAccess" t:checked="accountsFilterConfiguration != null && accountsFilterConfiguration.isIncludeFullAccess()"/>
+                                                    <span><i class="fas fa-edit placeholder-icon-right"></i>[[${locale.getString('account.state.full.access')}]]</span>
+                                                </label>
+                                            </div>
+                                            <div>
+                                                <label>
+                                                    <input type="checkbox" name="includeReadOnly" t:checked="accountsFilterConfiguration != null && accountsFilterConfiguration.isIncludeReadOnly()"/>
+                                                    <span><i class="fas fa-lock placeholder-icon-right"></i>[[${locale.getString('account.state.read.only')}]]</span>
+                                                </label>
+                                            </div>
+                                            <div>
+                                                <label>
+                                                    <input type="checkbox" name="includeHidden" t:checked="accountsFilterConfiguration != null && accountsFilterConfiguration.isIncludeHidden()"/>
+                                                    <span id="includeHidden"><i class="far fa-eye-slash placeholder-icon-right"></i>[[${locale.getString('account.state.hidden')}]]</span>
+                                                </label>
+                                            </div>
+                                        </th>
+                                        <th>
+                                            <div t:text="locale.getString('account.new.label.endDate')">end date</div>
+                                            <div>
+                                                <label>
+                                                    <input type="checkbox" name="includeWithEndDate" t:checked="accountsFilterConfiguration != null && accountsFilterConfiguration.isIncludeWithEndDate()"/>
+                                                    <span><i class="fas fa-bell placeholder-icon-right"></i>[[${locale.getString('account.label.endDate.with')}]]</span>
+                                                </label>
+                                            </div>
+                                            <div>
+                                                <label>
+                                                    <input type="checkbox" name="includeWithoutEndDate" t:checked="accountsFilterConfiguration != null && accountsFilterConfiguration.isIncludeWithoutEndDate()"/>
+                                                    <span><i class="fas fa-bell-slash placeholder-icon-right"></i>[[${locale.getString('account.label.endDate.without')}]]</span>
+                                                </label>
+                                            </div>
+                                        </th>
+                                        <th>
+                                            <div t:text="locale.getString('account.new.label.name')">name</div>
+                                            <div class="input-field">
+                                                <input type="text" name="name" t:value="accountsFilterConfiguration != null ? accountsFilterConfiguration.getName() : ''"/>
+                                            </div>
+                                        </th>
+                                        <th>
+                                            <div t:text="locale.getString('transaction.new.label.description')">description</div>
+                                            <div class="input-field">
+                                                <input type="text" name="description" t:value="accountsFilterConfiguration != null ? accountsFilterConfiguration.getDescription() : ''"/>
+                                            </div>
+                                        </th>
+                                        <th class="vertical-align-middle">
+                                            <button class="btn waves-effect waves-light background-green" type="submit" id="accounts-filter-button">
+                                                <i class="fas fa-filter left"></i>[[${locale.getString('filter.apply')}]]
+                                            </button>
+                                        </th>
+                                    </tr>
+                                </thead>
+
+                                <t:block t:each="account : accounts">
+                                    <tr t:if="account.getType() == 'CUSTOM'" class="account-overview-row">
+                                        <td><t:block t:replace="~{helpers/customSelectMacros :: accountIcon(account, account.getName(), 'text-blue', '')}"></t:block></td>
+                                        <td>
+                                            <t:block t:if="account.getAccountState() == 'READ_ONLY'">
+                                                <div class="placeholder-icon placeholder-icon-right"></div>
+                                                <i class="fas fa-lock placeholder-icon-right"></i>
+                                            </t:block>
+                                            <t:block t:if="account.getAccountState() == 'HIDDEN'">
+                                                <div class="placeholder-icon placeholder-icon-right"></div>
+                                                <i class="far fa-eye-slash placeholder-icon-right"></i>
+                                            </t:block>
+                                            <t:block t:unless="account.getAccountState() == 'READ_ONLY' || account.getAccountState() == 'HIDDEN'">
+                                                <a t:href="@{/accounts/{id}/setAsDefault(id=account.getID())}" class="btn-flat no-padding text-default tooltipped" data-position="left" t:data-tooltip="locale.getString('account.tooltip.default')"><i class="material-icons left" t:text="account.isDefault() == true ? 'star' : 'star_border'">star</i></a>
+                                                <i class="fas fa-edit placeholder-icon-right"></i>
+                                            </t:block>
+                                        </td>
+                                        <td>
+                                            <t:block t:if="account.getEndDate() != null">
+                                                <i class="fas fa-bell placeholder-icon-right"></i> [[${dateService.getDateStringNormal(account.getEndDate())}]]
+                                            </t:block>
+                                            <div t:if="account.getEndDate() == null" class="placeholder-icon"></div>
+                                        </td>
+                                        <td t:text="account.getName()">name</td>
+                                        <td>
+                                            <div class="truncate account-description" t:text="account.getDescription()">description</div>
+                                        </td>
+                                        <td>
+                                            <a t:href="@{/accounts/{id}/edit(id=account.getID())}" class="btn-flat no-padding text-default"><i class="material-icons left">edit</i></a>
+                                            <t:block t:replace="~{helpers/header :: buttonFlat('/accounts/' + account.getID() + '/requestDelete', 'delete', '', '', 'no-padding text-default button-request-delete-account', true, false, '', '', '')}"></t:block>
+                                        </td>
+                                    </tr>
+                                </t:block>
+                            </table>
+                        </form>
+                        <div t:if="accounts.isEmpty()" class="headline center-align" t:text="locale.getString('placeholder')">placeholder</div>
+                    </div>
+                    </t:block>
+                </t:block>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+
+        <t:block t:if="accountNotDeletable != null">
+            <!-- warning account not deletable -->
+            <div id="modalAccountNotDeletable" class="modal background-color">
+                <div class="modal-content">
+                    <h4 t:text="locale.getString('info.title.account.delete')">title</h4>
+                    <p t:text="locale.getString('warning.text.account.delete', currentAccount.getName())">text</p>
+                </div>
+                <div class="modal-footer background-color">
+                    <t:block t:replace="~{helpers/header :: buttonLink('/accounts', 'done', 'ok', 'buttonCloseWhatsNew', 'green', 'modal-action modal-close text-white', false, false, false, '')}"></t:block>
+                </div>
+            </div>
+        </t:block>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/accounts.js}"></script>
+    </body>
+</html>
