--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/templateGroups/templateGroups.html
@@ -0,0 +1,49 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templategroup.TemplateGroup"
+      t:params="Settings settings, List<Notification> notifications, List<TemplateGroup> templateGroups">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.template.groups'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/templates.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">file_copy</i> [[${locale.getString('menu.template.groups')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::pagecontent(templateGroups)})}">
+                    <t:block t:fragment="pagecontent(List<TemplateGroup> templateGroups)">
+                    <br>
+                    <t:block t:replace="~{templateGroups/templateGroupFunctions :: buttons}"></t:block>
+                    <br>
+
+                    <div class="container">
+                        <table class="bordered">
+                            <tr t:each="group : templateGroups">
+                                <td>[[${group.getName()}]] </td>
+                                <td>
+                                    <t:block t:replace="~{helpers/header :: buttonFlat('/templateGroups/' + group.getID() + '/edit', 'edit', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                                    <t:block t:replace="~{helpers/header :: buttonFlat('/templateGroups/' + group.getID() + '/requestDelete', 'delete', '', '', 'no-padding text-default button-request-delete-template-group', true, false, '', '', '')}"></t:block>
+                                </td>
+                            </tr>
+                        </table>
+                        <div t:if="templateGroups.isEmpty()" class="headline center-align" t:text="locale.getString('placeholder')">placeholder</div>
+                    </div>
+                    </t:block>
+                </t:block>
+
+                <!-- the old template did not close the card div, so the container ended up inside it -->
+                <div id="deleteModalContainerOnDemand"></div>
+
+                <!-- the browser also put the scripts into the unclosed card div -->
+                <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+                <script t:src="@{/js/templateGroups.js}"></script>
+            </div>
+        </main>
+    </body>
+</html>
