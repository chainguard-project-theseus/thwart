+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState, de.deadlocker8.budgetmaster.categories.Category">
+<!-- formerly helpers/customSelectMacros.ftl. All parameters are required; old defaults are noted per fragment. -->
+
+<!-- formerly customSelectStart + customSelectEnd: content is the former #nested, hiddenInput is the hidden input written by customSelectEnd -->
+<div t:fragment="customSelect(String selector, String inputClasses, String labelText, String id, String icon, boolean disabled, String rowClasses, Fragment content, Fragment hiddenInput)"
+     t:class="|row ${rowClasses}|">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix" t:text="icon">icon</i>
+        <label t:if="!strings.isEmpty(labelText)" class="input-label" t:for="id" t:text="labelText">label</label>
+        <div t:class="|custom-select-wrapper ${selector}|" t:classappend="disabled ? 'disabled'" t:id="id">
+            <div class="custom-select">
+                <t:block t:replace="content"></t:block>
+            </div>
+            <t:block t:replace="hiddenInput"></t:block>
+        </div>
+    </div>
+</div>
+
+<!-- formerly customSelectEnd's input; selectedID: null for none, form: '' for none -->
+<input t:fragment="hiddenSelectInput(String inputName, String selectedValue, String form)"
+       type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedValue" t:form="strings.isEmpty(form) ? null : form"/>
+
+<!-- old defaults: showName=true, rowClasses='', disabled=false, form='' -->
+<t:block t:fragment="customCategorySelect(List<Category> categories, Category selectedCategory, String inputClasses, String labelText, String id, boolean showName, String rowClasses, boolean disabled, String form)">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelect('category-select-wrapper', inputClasses, labelText, id, 'label', disabled, rowClasses, ~{helpers/customSelectMacros :: categorySelectContent(categories, selectedCategory, showName)}, ~{helpers/customSelectMacros :: hiddenSelectInput('category', selectedCategory == null ? null : '' + selectedCategory.ID, form)})}"></t:block>
+</t:block>
+
+<t:block t:fragment="categorySelectContent(List<Category> categories, Category selectedCategory, boolean showName)">
+    <div class="custom-select-trigger" tabindex="0">
+        <div class="custom-select-selected-item">
+            <t:block t:if="selectedCategory != null"><t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionCategoryContent(selectedCategory, 'no-margin-left', true, showName)}"></t:block></t:block>
+        </div>
+        <div class="custom-select-arrow"></div>
+    </div>
+    <div class="custom-select-options">
+        <t:block t:each="category : categories">
+            <t:block t:unless="category.type == 'REST'">
+                <t:block t:if="selectedCategory != null"><t:block t:replace="~{helpers/customSelectMacros :: customSelectCategoryOption(category, selectedCategory.ID == category.ID)}"></t:block></t:block>
+                <t:block t:if="selectedCategory == null"><t:block t:replace="~{helpers/customSelectMacros :: customSelectCategoryOption(category, category.type == 'NONE')}"></t:block></t:block>
+            </t:block>
+        </t:block>
+    </div>
+</t:block>
+
+<!-- old default: disabled=false -->
+<t:block t:fragment="customAccountSelect(String selector, String inputName, List<Account> accounts, Account selectedAccount, String inputClasses, String labelText, String id, boolean disabled)">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelect(selector, inputClasses, labelText, id, 'account_balance', disabled, '', ~{helpers/customSelectMacros :: accountSelectContent(accounts, selectedAccount)}, ~{helpers/customSelectMacros :: hiddenSelectInput(inputName, selectedAccount == null ? null : '' + selectedAccount.ID, '')})}"></t:block>
+</t:block>
+
+<t:block t:fragment="accountSelectContent(List<Account> accounts, Account selectedAccount)">
+    <div class="custom-select-trigger" tabindex="0">
+        <div class="custom-select-selected-item">
+            <t:block t:if="selectedAccount != null"><t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountContent(selectedAccount, 'no-margin-left', '')}"></t:block></t:block>
+        </div>
+        <div class="custom-select-arrow"></div>
+    </div>
+    <div class="custom-select-options">
+        <t:block t:each="account : accounts">
+            <t:block t:if="account.type == 'CUSTOM'">
+                <t:block t:replace="~{helpers/customSelectMacros :: customSelectAccountOption(account, selectedAccount != null && selectedAccount.ID == account.ID)}"></t:block>
+            </t:block>
+        </t:block>
+    </div>
+</t:block>
+
+<div t:fragment="globalAccountSelect()" class="input-field no-margin">
+    <div class="custom-select-wrapper global-account-select-wrapper">
+        <div class="custom-select">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountContent(bm.currentAccount(), 'no-margin-left', '')}"></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="account : bm.allReadableAccounts()">
+                    <t:block t:replace="~{helpers/customSelectMacros :: customSelectAccountOption(account, account.isSelected())}"></t:block>
+                </t:block>
+            </div>
+        </div>
+
+        <input type="hidden" class="hidden-input-custom-select" t:value="bm.currentAccount().ID"/>
+    </div>
+</div>
+
+<t:block t:fragment="customAccountStateSelect(String selector, String inputName, List<AccountState> availableStates, AccountState selectedState, String inputClasses, String labelText, String id)">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelect(selector, inputClasses, labelText, id, 'visibility', false, '', ~{helpers/customSelectMacros :: accountStateSelectContent(availableStates, selectedState)}, ~{helpers/customSelectMacros :: hiddenSelectInput(inputName, selectedState == null ? null : acc.enumName(selectedState), '')})}"></t:block>
+</t:block>
+
+<t:block t:fragment="accountStateSelectContent(List<AccountState> availableStates, AccountState selectedState)">
+    <div class="custom-select-trigger" tabindex="0">
+        <div class="custom-select-selected-item">
+            <t:block t:if="selectedState != null"><t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountStateContent(selectedState, 'no-margin-left')}"></t:block></t:block>
+        </div>
+        <div class="custom-select-arrow"></div>
+    </div>
+    <div class="custom-select-options">
+        <t:block t:each="state : availableStates">
+            <t:block t:replace="~{helpers/customSelectMacros :: customSelectAccountStateOption(state, selectedState != null && selectedState == state)}"></t:block>
+        </t:block>
+    </div>
+</t:block>
+
+<div t:fragment="customSelectCategoryOption(Category category, boolean isSelected)"
+     class="custom-select-option" t:classappend="isSelected ? 'selected'" t:data-value="category.ID">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionCategoryContent(category, '', false, true)}"></t:block>
+</div>
+
+<!-- old defaults: classes='', datasetValue=false, showName=true (includes categoriesFunctions.categoryCircle) -->
+<t:block t:fragment="customSelectOptionCategoryContent(Category category, String classes, boolean datasetValue, boolean showName)">
+    <div t:class="|category-circle category-circle-small ${classes}|"
+         t:classappend="bm.settings().showCategoriesAsCircles != null && bm.settings().showCategoriesAsCircles == false ? 'category-square'"
+         t:style="|background-color: ${css.color(category.color)}|"
+         t:data-value="datasetValue ? '' + category.ID : null">
+        <span t:style="|color: ${css.color(bm.fontColor(category))}|">
+            <t:block t:replace="~{helpers/header :: entityIcon(category, 'category-icon', acc.categoryName(category))}"></t:block>
+        </span>
+    </div>
+    <span t:if="showName" class="custom-select-item-name" t:text="acc.categoryName(category)">name</span>
+</t:block>
+
+<div t:fragment="customSelectAccountOption(Account account, boolean isSelected)"
+     class="custom-select-option" t:classappend="isSelected ? 'selected'" t:data-value="account.ID">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountContent(account, '', '')}"></t:block>
+</div>
+
+<!-- old defaults: classes='', datasetValue='' -->
+<t:block t:fragment="customSelectOptionAccountContent(Account account, String classes, String datasetValue)">
+    <t:block t:with="accountName=account.type == 'ALL' ? loc.get('account.all') : account.name">
+        <t:block t:replace="~{helpers/customSelectMacros :: accountIcon(account, accountName, 'category-circle-small ' + classes, 'true')}"></t:block>
+        <span class="custom-select-item-name" t:text="accountName">name</span>
+    </t:block>
+</t:block>
+
+<!-- old defaults: classes='', datasetValue='' ('' for none) -->
+<div t:fragment="accountIcon(Account account, String accountName, String classes, String datasetValue)"
+     t:class="|category-circle ${classes} category-square|"
+     t:classappend="account.iconReference != null && account.iconReference.isFallbackIcon() ? 'account-square-border'"
+     t:data-value="strings.isEmpty(datasetValue) ? null : '' + account.ID">
+    <span t:style="|color: ${css.color(bm.fontColor(account))}|">
+        <t:block t:replace="~{helpers/header :: entityIcon(account, 'account-select-icon', accountName)}"></t:block>
+    </span>
+</div>
+
+<div t:fragment="customSelectAccountStateOption(AccountState state, boolean isSelected)"
+     class="custom-select-option" t:classappend="isSelected ? 'selected'" t:data-value="acc.enumName(state)">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountStateContent(state, '')}"></t:block>
+</div>
+
+<!-- old default: classes='' -->
+<t:block t:fragment="customSelectOptionAccountStateContent(AccountState state, String classes)">
+    <div t:class="|category-circle category-circle-small ${classes}|" t:data-value="acc.enumName(state)">
+        <span class="text-blue">
+            <i t:class="state.icon"></i>
+        </span>
+    </div>
+    <span class="custom-select-item-name" t:text="loc.get(state.localizationKey)">state</span>
+</t:block>
+</html>
