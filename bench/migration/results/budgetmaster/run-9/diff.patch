+    <t:block t:replace="~{charts/chartFunctions :: iconForItem(item)}"></t:block>
+</a>
+
+<div t:fragment="chartPreview(Chart chart)" class="col s6 m4 l3 center-align chart-preview-column hidden"
+     t:data-display-type="chart.displayType" t:data-group-type="chart.groupType" t:data-id="chart.ID">
+    <div class="card chart-preview">
