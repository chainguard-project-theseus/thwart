--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/iconSelect.html
@@ -0,0 +1,142 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.icon.Iconizable">
+<!-- formerly helpers/iconSelect.ftl. item: Account, Category or Template.
+     iconSelect old defaults: showBackground=true, initialBackgroundClasses='', backgroundClasses='', preventFallbackIcon=false -->
+<div t:fragment="iconSelect(String id, Iconizable item, boolean showBackground, String initialBackgroundClasses, String backgroundClasses, boolean preventFallbackIcon)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2"
+         t:with="hasImageIcon=item.iconReference != null && item.iconReference.isImageIcon(), hasBuiltinIcon=item.iconReference != null && item.iconReference.isBuiltinIcon()">
+        <i class="fas fa-icons prefix"></i>
+        <label class="input-label" t:for="id" t:text="loc.get('account.new.label.icon')">icon</label>
+
+        <div t:id="id" class="valign-wrapper item-icon">
+            <div class="item-icon-preview-container">
+                <a id="item-icon-preview" t:style="bm.fontColor(item) != null ? |color: ${css.color(bm.fontColor(item))}| : 'color: '">
+                    <script>iconSelectAdditionalBackgroundClasses = [[${backgroundClasses}]];</script>
+                    <div id="item-icon-preview-background" t:class="|category-circle category-circle-preview ${initialBackgroundClasses}|"
+                         t:classappend="bm.settings().showCategoriesAsCircles != null && bm.settings().showCategoriesAsCircles == false ? 'category-square'"
+                         t:style="showBackground && acc.itemColor(item) != null ? |background-color: ${css.color(acc.itemColor(item))}| : 'background-color: '">
+                        <i id="builtin-icon-preview-icon" t:class="hasBuiltinIcon ? item.iconReference.builtinIdentifier : 'hidden'"></i>
+                        <img id="item-icon-preview-icon" t:src="hasImageIcon ? @{/media/getImageByIconID/{id}(id=item.iconReference.ID)} : ''" class="item-icon-preview category-icon" t:classappend="!hasImageIcon ? 'hidden'"/>
+                        <span t:if="!preventFallbackIcon" id="item-icon-fallback-name" t:class="hasBuiltinIcon || hasImageIcon ? 'hidden' : ''" t:text="bm.firstCapital(acc.itemName(item))">X</span>
+                    </div>
+                </a>
+                <t:block t:replace="~{helpers/header :: buttonFlat('', 'delete', '', '', 'no-padding text-default button-remove-icon-from-item', false, true, '', '', '')}"></t:block>
+            </div>
+
+            <div id="item-icon-placeholder" t:text="loc.get('account.new.icon.placeholder')">placeholder</div>
+
+            <input id="hidden-input-icon-image-id" type="hidden" name="iconImageID" t:value="hasImageIcon ? '' + item.iconReference.image.ID : ''">
+            <input id="hidden-input-icon-builtin-identifier" type="hidden" name="builtinIconIdentifier" t:value="hasBuiltinIcon ? item.iconReference.builtinIdentifier : ''">
+        </div>
+    </div>
+</div>
+
+<div t:fragment="modalIconSelect(String idToFocusOnClose, Iconizable item)" id="modalIconSelect" class="modal modal-fixed-footer background-color" t:data-focus-on-close="idToFocusOnClose"
+     t:with="hasImageIcon=item.iconReference != null && item.iconReference.isImageIcon()">
+    <div class="modal-content center-align">
+        <div class="row">
+            <div class="col s12">
+                <ul class="tabs" id="iconTabs">
+                    <li class="tab col s6"><a class="text-blue valign-wrapper" t:classappend="!hasImageIcon ? 'active'" href="#tabBuiltinIcons" data-name="builtinIcons"><i class="fas fa-icons"></i> [[${loc.get('icons.builtin')}]]</a></li>
+                    <li class="tab col s6"><a class="text-blue valign-wrapper" t:classappend="hasImageIcon ? 'active'" href="#tabImages" data-name="images"><i class="fas fa-image"></i> [[${loc.get('icons.images')}]]</a></li>
+                </ul>
+            </div>
+            <div id="tabBuiltinIcons" class="col s12"><t:block t:replace="~{helpers/iconSelect :: tabBuiltinIcons(item)}"></t:block></div>
+            <div id="tabImages" class="col s12"><t:block t:replace="~{helpers/iconSelect :: tabImages(item)}"></t:block></div>
+        </div>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, true, false, '')}"></t:block>
+        <t:block t:replace="~{helpers/header :: buttonLink('', 'done', 'ok', 'button-icon-confirm', 'green', 'modal-action modal-close text-white', false, true, true, '')}"></t:block>
+    </div>
+</div>
+
+<t:block t:fragment="tabImages(Iconizable item)">
+    <div class="row">
+        <div class="col s12">
+            <div class="headline" t:text="loc.get('upload.image.headline')">headline</div>
+        </div>
+    </div>
+
+    <div class="row">
+        <t:block t:replace="~{helpers/iconSelect :: uploadImageForm()}"></t:block>
+    </div>
+
+    <hr>
+
+    <div class="row">
+        <div class="col s12">
+            <div class="headline" t:text="loc.get('available.images')">images</div>
+        </div>
+    </div>
+
+    <t:block t:replace="~{helpers/iconSelect :: progressIndicator()}"></t:block>
+
+    <div class="row" id="available-images"
+         t:data-url="item.iconReference != null && item.iconReference.isImageIcon() ? @{/media/getAvailableImages/{id}(id=item.iconReference.image.ID)} : @{/media/getAvailableImages}">
+    </div>
+</t:block>
+
+<t:block t:fragment="tabBuiltinIcons(Iconizable item)">
+    <div class="row no-margin-bottom">
+        <div class="input-field col s12 m12 l8 offset-l2">
+            <i class="material-icons prefix">search</i>
+            <input id="searchIcons" type="text" onchange="searchBuiltinIcons();" onkeypress="searchBuiltinIcons();" onpaste="searchBuiltinIcons()" oninput="searchBuiltinIcons();">
+            <label for="searchIcons" t:text="loc.get('search')">search</label>
+        </div>
+    </div>
+    <div class="row">
+        <div class="col s12 center-align" id="numberOfIcons"><span id="numberOfMatchingIcons" t:text="acc.fontawesomeIcons().size()">0</span>/[[${acc.fontawesomeIcons().size()}]] [[${loc.get('icons.numberOf')}]]</div>
+    </div>
+
+    <hr>
+
+    <div class="row" t:with="selectedIconName=item.iconReference != null && item.iconReference.isBuiltinIcon() ? item.iconReference.builtinIdentifier : ''">
+        <t:block t:each="icon : acc.fontawesomeIcons()">
+            <t:block t:replace="~{helpers/iconSelect :: builtinIconOption(icon, selectedIconName)}"></t:block>
+        </t:block>
+    </div>
+</t:block>
+
+<!-- formerly builtinIconOption(icon, item): takes the selected icon identifier ('' for none) instead of the item -->
+<div t:fragment="builtinIconOption(String icon, String selectedIconName)" class="col s4 m2 l2 builtin-icon-option-column">
+    <div class="builtin-icon-option" t:classappend="selectedIconName == icon ? 'selected'">
+        <i t:class="|builtin-icon-option-icon ${icon}|"></i>
+        <div class="builtin-icon-option-name truncate" t:text="icon">icon</div>
+    </div>
+</div>
+
+<t:block t:fragment="uploadImageForm()">
+    <form id="form-upload-image" method="post" t:action="@{/media/uploadImage}" enctype="multipart/form-data">
+        <div class="file-field input-field col s12">
+            <div class="container">
+                <div class="btn background-blue">
+                    <i class="material-icons left">folder</i>
+                    [[${loc.get('account.new.icon.upload.choose.file')}]]
+                    <input id="inputUploadFile" type="file" t:accept="bm.validImageUploadTypes()" name="file">
+                </div>
+                <div class="file-path-wrapper">
+                    <input class="file-path validate" type="text">
+                </div>
+                <t:block t:replace="~{helpers/header :: buttonLink('', 'upload', 'account.new.icon.upload', 'button-upload-new-image', 'background-blue', 'right', false, true, false, '')}"></t:block>
+            </div>
+        </div>
+    </form>
+
+    <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.icon.upload.image.size'), 'fas fa-info', '')}"></t:block>
+</t:block>
+
+<div t:fragment="progressIndicator()" class="preloader-wrapper active margin" id="progressIndicator">
+    <div class="spinner-layer spinner-blue-only">
+        <div class="circle-clipper left">
+            <div class="circle"></div>
+        </div>
+        <div class="gap-patch">
+            <div class="circle"></div>
+        </div>
+        <div class="circle-clipper right">
+            <div class="circle"></div>
+        </div>
+    </div>
+</div>
+</html>
