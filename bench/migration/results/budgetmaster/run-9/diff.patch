diff --git a/BudgetMasterServer/src/main/resources/templates/indexFunctions.html b/BudgetMasterServer/src/main/resources/templates/indexFunctions.html
new file mode 100644
index 00000000..797337a4
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/indexFunctions.html
@@ -0,0 +1,28 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev">
+<!-- formerly indexFunctions.ftl -->
+<div t:fragment="homeEntry(String url, String icon, String iconColor, String headlineText, String bodyText, Fragment content)" class="col s12 m6 l4 home-menu-cell">
+    <t:block t:replace="~{helpers/header :: buttonFlat(url, icon, headlineText, '', 'home-menu-link budget', false, false, 'icon-budget ' + iconColor, '', '')}"></t:block>
+    <p class="text-grey home-menu-text" t:text="loc.get(bodyText)">text</p>
+    <div class="left-align">
+        <t:block t:replace="content"></t:block>
+    </div>
+</div>
+
+<t:block t:fragment="action(String url, String name)">
+    <t:block t:replace="~{helpers/header :: buttonFlat(url, 'play_arrow', name, '', 'home-menu-link-item', false, false, '', '', '')}"></t:block>
+</t:block>
+
+<t:block t:fragment="stepContent(String headline, String contentText, String actionUrl, String actionName, Fragment content)">
+    <h5 t:text="loc.get(headline)">headline</h5>
+    <p>
+        [(${misc.markup(contentText)})]
+        <t:block t:replace="content"></t:block>
+    </p>
+    <p>
+        <t:block t:if="!strings.isEmpty(actionUrl)">
+            <t:block t:replace="~{indexFunctions :: action(actionUrl, actionName)}"></t:block>
+        </t:block>
+    </p>
+</t:block>
+</html>
