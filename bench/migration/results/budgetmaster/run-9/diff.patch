diff --git a/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html b/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html
new file mode 100644
index 00000000..b9dcc07e
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html
@@ -0,0 +1,53 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.charts.ChartTypeItem">
+<!-- formerly chartFunctions.ftl; getChartName(chart) is now mischarts.chartName(chart) -->
+
+<!-- text: plain text message; content: markup to show instead of text (null for none) -->
+<div t:fragment="infoMessage(String text, Fragment content)" class="row no-margin-bottom">
+    <div class="col s12 center-align">
+        <table class="text-default login-message no-border-table">
+            <tr>
+                <td><i class="material-icons">info</i></td>
+                <td><t:block t:if="content == null" t:text="text">text</t:block><t:block t:if="content != null"><t:block t:replace="content"></t:block></t:block></td>
+            </tr>
+        </table>
+    </div>
+</div>
+
+<t:block t:fragment="buttonNew()">
+    <t:block t:replace="~{helpers/header :: buttonLink('/charts/newChart', 'add', 'title.chart.new', '', 'background-blue', '', false, false, false, '')}"></t:block>
+</t:block>
+
+<t:block t:fragment="buttonShow()">
+    <t:block t:replace="~{helpers/header :: buttonLink('/charts', 'show_chart', 'home.menu.charts.action.show', '', 'background-blue', '', false, false, false, '')}"></t:block>
+</t:block>
+
+<t:block t:fragment="buttons()">
+    <div class="row hide-on-small-only valign-wrapper">
+        <div class="col s6 right-align">
+            <t:block t:replace="~{charts/chartFunctions :: buttonNew()}"></t:block>
+        </div>
+        <div class="col s6 left-align">
+            <t:block t:replace="~{charts/chartFunctions :: buttonShow()}"></t:block>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up center-align">
+        <div class="row center-align">
+            <div class="row center-align">
+                <div class="col s12">
+                    <t:block t:replace="~{charts/chartFunctions :: buttonShow()}"></t:block>
+                </div>
+            </div>
+            <div class="col s12">
+                <t:block t:replace="~{charts/chartFunctions :: buttonNew()}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="iconForItem(ChartTypeItem item)">
+    <t:block t:if="item.isFontAwesomeIcon()"><i t:class="|${item.icon} left|"></i> [[${loc.get(item.localizationKey)}]]</t:block>
+    <t:block t:unless="item.isFontAwesomeIcon()"><i class="material-icons left" t:text="item.icon">icon</i> [[${loc.get(item.localizationKey)}]]</t:block>
+</t:block>
+</html>
