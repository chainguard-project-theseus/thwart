+            <t:block t:if="includeContinueButton"><t:block t:replace="~{transactions/newTransactionMacros :: buttonSaveAndContinue}"></t:block>&nbsp;
+            </t:block>
+            <t:block t:replace="~{transactions/newTransactionMacros :: buttonSave(allowEmptyAmount)}"></t:block>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up">
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{transactions/newTransactionMacros :: buttonCancel(cancelURL)}"></t:block>
+            </div>
+        </div>
+        <div t:if="includeContinueButton" class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{transactions/newTransactionMacros :: buttonSaveAndContinue}"></t:block>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
