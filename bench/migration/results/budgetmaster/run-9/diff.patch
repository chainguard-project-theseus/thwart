+        <div t:each="tag : template.tags" class="chip" t:text="tag.name">tag</div>
+    </td>
+</tr>
+
+<tr t:fragment="templateAccount(Template template)" t:if="template.account != null">
+    <td class="template-content-label" t:text="loc.get('transaction.new.label.account')">label</td>
+    <td t:text="template.account.name">account</td>
+</tr>
+
+<tr t:fragment="templateTransferAccount(Template template)" t:if="template.transferAccount != null">
+    <td class="template-content-label" t:text="loc.get('transaction.new.label.transfer.account')">label</td>
+    <td t:text="template.transferAccount.name">account</td>
+</tr>
+
+<!-- validation: the page's ValidationErrors validation (may be null) -->
+<div t:fragment="templateNameInput(Template template, ValidationErrors validation)" class="row">
