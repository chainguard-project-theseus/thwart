+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.transactions.Transaction;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Template functions for the transaction list pages (namespace {@code tx}).
+ */
+@TemplateFunctions("tx")
+public final class TransactionFunctions
+{
+	public record DateGroup(String date, List<Transaction> transactions)
+	{
+	}
+
+	private TransactionFunctions()
+	{
+	}
+
+	/**
+	 * Groups consecutive transactions with the same (upper-cased) month-name date string,
+	 * as the old FreeMarker list did with its lastDate variable.
+	 */
+	@TemplateFunction
+	public static List<DateGroup> groupByDate(List<Transaction> transactions)
+	{
+		final List<DateGroup> groups = new ArrayList<>();
+		if(transactions == null)
+		{
+			return groups;
+		}
+
+		String lastDate = "";
+		List<Transaction> current = null;
+		for(Transaction transaction : transactions)
+		{
+			final String date = AppFunctions.dateWithMonthName(transaction.getDate()).toUpperCase();
+			if(current == null || !Objects.equals(date, lastDate))
+			{
+				current = new ArrayList<>();
+				groups.add(new DateGroup(date, current));
+				lastDate = date;
+			}
+			current.add(transaction);
+		}
+		return groups;
+	}
+
+	@TemplateFunction
+	public static boolean isHighlighted(Transaction transaction, Integer highlightID)
+	{
+		return highlightID != null && transaction.getID() != null && transaction.getID().equals(highlightID);
+	}
+}
