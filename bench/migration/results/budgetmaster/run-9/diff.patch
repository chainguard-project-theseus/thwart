--- /dev/null
+++ b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/templating/AccountFunctions.java
@@ -0,0 +1,166 @@
+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.accounts.Account;
+import de.deadlocker8.budgetmaster.categories.Category;
+import de.deadlocker8.budgetmaster.categories.CategoryType;
+import de.deadlocker8.budgetmaster.icon.Iconizable;
+import de.deadlocker8.budgetmaster.templates.Template;
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Helpers for the shared helper fragments (customSelectMacros, iconSelect, fontColorPicker, globalDatePicker)
+ * and the account pages.
+ */
+@TemplateFunctions("acc")
+public final class AccountFunctions
+{
+	private AccountFunctions()
+	{
+	}
+
+	/** categoriesFunctions.getCategoryName(category) */
+	@TemplateFunction
+	public static String categoryName(Category category)
+	{
+		if(category == null || category.getName() == null)
+		{
+			return "";
+		}
+		if(category.getType() == CategoryType.NONE)
+		{
+			return LocalizationFunctions.get("category.none");
+		}
+		if(category.getType() == CategoryType.REST)
+		{
+			return LocalizationFunctions.get("category.rest");
+		}
+		return category.getName();
+	}
+
+	/** item.getName() for Account, Category or Template (null otherwise). */
+	@TemplateFunction
+	public static String itemName(Iconizable item)
+	{
+		if(item instanceof Account account)
+		{
+			return account.getName();
+		}
+		if(item instanceof Category category)
+		{
+			return category.getName();
+		}
+		if(item instanceof Template template)
+		{
+			return template.getName();
+		}
+		return null;
+	}
+
+	/** item.getColor() (only categories have a background color). */
+	@TemplateFunction
+	public static String itemColor(Iconizable item)
+	{
+		if(item instanceof Category category)
+		{
+			return category.getColor();
+		}
+		return null;
+	}
+
+	@TemplateFunction
+	public static String defaultFontColor(Iconizable item)
+	{
+		return item.getDefaultFontColor(AppFunctions.isDarkTheme());
+	}
+
+	/** Twelve years starting at startYear as strings (globalDatePicker). */
+	@TemplateFunction
+	public static List<String> years(int startYear)
+	{
+		final List<String> years = new ArrayList<>();
+		for(int i = startYear; i <= startYear + 11; i++)
+		{
+			years.add(String.valueOf(i));
+		}
+		return years;
+	}
+
+	/** The first maxLength characters of each name (FreeMarker name[0..maxLength-1]). */
+	@TemplateFunction
+	public static List<String> prefixes(List<String> names, int maxLength)
+	{
+		final List<String> result = new ArrayList<>();
+		if(names == null)
+		{
+			return result;
+		}
+		for(String name : names)
+		{
+			result.add(name.substring(0, Math.min(maxLength, name.length())));
+		}
+		return result;
+	}
+
+	@TemplateFunction
+	public static List<String> monthNames()
+	{
+		return de.deadlocker8.budgetmaster.utils.types.MonthNames.getLocalizedStrings();
+	}
+
+	@TemplateFunction
+	public static List<String> weekDays()
+	{
+		return de.deadlocker8.budgetmaster.utils.types.WeekDay.getLocalizedStrings();
+	}
+
+	/** Splits items into rows of size columns. */
+	@TemplateFunction
+	public static List<List<String>> rows(List<String> items, int columns)
+	{
+		final List<List<String>> rows = new ArrayList<>();
+		for(int i = 0; i < items.size(); i += columns)
+		{
+			rows.add(new ArrayList<>(items.subList(i, Math.min(i + columns, items.size()))));
+		}
+		return rows;
+	}
+
+	@TemplateFunction
+	public static List<String> fontawesomeIcons()
+	{
+		return de.deadlocker8.budgetmaster.utils.FontAwesomeIcons.ICONS;
+	}
+
+	/** enum.name() (some enums override toString). */
+	@TemplateFunction
+	public static String enumName(Object value)
+	{
+		return value instanceof Enum<?> e ? e.name() : null;
+	}
+
+	/** Escapes text but keeps the <br> line breaks that localized messages contain (old pages printed them raw). */
+	@TemplateFunction
+	public static SafeHtml withLineBreaks(String text)
+	{
+		if(text == null)
+		{
+			return SafeHtml.EMPTY;
+		}
+		final String[] parts = text.split("<br>", -1);
+		final List<SafeHtml> result = new ArrayList<>();
+		for(int i = 0; i < parts.length; i++)
+		{
+			if(i > 0)
+			{
+				result.add(SafeHtml.sanitize("<br>"));
+			}
+			result.add(SafeHtml.escape(parts[i]));
+		}
+		return SafeHtml.concat(result.toArray(new SafeHtml[0]));
+	}
+}
