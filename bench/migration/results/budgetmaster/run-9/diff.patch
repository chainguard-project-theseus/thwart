new file mode 100644
index 00000000..3eaf5d90
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/templateGroups/templateGroups.html
@@ -0,0 +1,49 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.templategroup.TemplateGroup, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="Settings settings, List<Notification> notifications, List<TemplateGroup> templateGroups">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + loc.get('menu.template.groups'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/templates.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">file_copy</i> [[${loc.get('menu.template.groups')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                <section t:remove="tag">
+                    <br>
+                    <t:block t:replace="~{templateGroups/templateGroupFunctions :: buttons()}"></t:block>
+                    <br>
+
+                    <div class="container">
+                        <table class="bordered">
+                            <tr t:each="group : templateGroups">
+                                <td>[[${group.name}]] </td>
+                                <td>
+                                    <t:block t:replace="~{helpers/header :: buttonFlat('/templateGroups/' + group.ID + '/edit', 'edit', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                                    <t:block t:replace="~{helpers/header :: buttonFlat('/templateGroups/' + group.ID + '/requestDelete', 'delete', '', '', 'no-padding text-default button-request-delete-template-group', true, false, '', '', '')}"></t:block>
+                                </td>
+                            </tr>
+                        </table>
+                        <div t:if="templateGroups.size() == 0" class="headline center-align" t:text="loc.get('placeholder')">placeholder</div>
+                    </div>
+                </section>
+                </t:block>
+
+                <!-- the old page never closed main-card, so this container ended up inside it -->
+                <div id="deleteModalContainerOnDemand"></div>
+
+                <!-- ...and so did the scripts (kept for page parity) -->
+                <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+                <script t:src="@{/js/templateGroups.js}"></script>
+            </div>
+        </main>
+    </body>
+</html>
