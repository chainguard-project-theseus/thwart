+                <a class="btn-floating btn transaction-action background-blue-baby" data-action-type="changeType" t:data-url="@{/transactions/{id}/changeTypeModal(id=transaction.ID)}"><i class="material-icons">shuffle</i></a>
+            </li>
+            <li t:if="canCreateTemplate">
+                <a class="btn-floating btn transaction-action mobile-fab-tip no-wrap" data-action-type="saveAsTemplate" t:data-url="@{/templates/fromTransactionModal}" t:text="loc.get('save.as.template')">template</a>
+                <a class="btn-floating btn transaction-action background-orange-dark" data-action-type="saveAsTemplate" t:data-url="@{/templates/fromTransactionModal}"><i class="material-icons">file_copy</i></a>
+            </li>
+        </ul>
+    </div>
+</t:block>
+</html>
