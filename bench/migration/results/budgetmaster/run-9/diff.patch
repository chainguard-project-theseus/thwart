+	private static final java.util.regex.Pattern NOTIFICATION_LINK = java.util.regex.Pattern.compile("<a href=\"([^\"]*)\" class=\"text-default\">(.*?)</a>", java.util.regex.Pattern.DOTALL);
+
+	/**
+	 * Notification messages may embed an edit link built by NotificationLinkBuilder.buildEditLink.
+	 * The text around it is escaped and the link is re-rendered through the helpers/notificationLink template,
+	 * so the link name (user data) is escaped too.
+	 */
+	@TemplateFunction
+	public static dev.tessera.runtime.SafeHtml notificationMessage(de.deadlocker8.budgetmaster.utils.notification.Notification notification)
+	{
+		final String message = notification.getMessage() == null ? "" : notification.getMessage();
+		final java.util.regex.Matcher matcher = NOTIFICATION_LINK.matcher(message);
+		final List<dev.tessera.runtime.SafeHtml> parts = new java.util.ArrayList<>();
+		int last = 0;
+		while(matcher.find())
+		{
+			parts.add(dev.tessera.runtime.SafeHtml.escape(message.substring(last, matcher.start())));
+			parts.add(dev.tessera.runtime.SafeHtml.of(de.deadlocker8.budgetmaster.templates.generated.helpers.NotificationLinkTemplate.of(matcher.group(1), matcher.group(2)), dev.tessera.runtime.RenderContext.defaults()));
+			last = matcher.end();
+		}
+		parts.add(dev.tessera.runtime.SafeHtml.escape(message.substring(last)));
+		return dev.tessera.runtime.SafeHtml.concat(parts.toArray(new dev.tessera.runtime.SafeHtml[0]));
+	}
