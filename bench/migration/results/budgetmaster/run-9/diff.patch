+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.backup.AutoBackupStrategy;
+import de.deadlocker8.budgetmaster.transactions.keywords.TransactionNameKeyword;
+import de.deadlocker8.budgetmaster.utils.LanguageType;
+import dev.tessera.runtime.TemplateFunction;
+import org.springframework.security.web.csrf.CsrfToken;
+import org.springframework.web.context.request.RequestAttributes;
+import org.springframework.web.context.request.RequestContextHolder;
+import dev.tessera.runtime.TemplateFunctions;
+import dev.tessera.runtime.SafeHtml;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Functions for the settings pages (agentE).
+ */
+@TemplateFunctions("set")
+public final class SettingsFunctions
+{
+	private SettingsFunctions()
+	{
+	}
+
+	/** formerly helpers.getAvailableLanguages() */
+	@TemplateFunction
+	public static List<LanguageType> languages()
+	{
+		return Arrays.asList(LanguageType.values());
+	}
+
+	/** formerly helpers.getAvailableAutoBackupStrategies() */
+	@TemplateFunction
+	public static List<AutoBackupStrategy> autoBackupStrategies()
+	{
+		final List<AutoBackupStrategy> strategies = new ArrayList<>(Arrays.asList(AutoBackupStrategy.values()));
+		strategies.remove(AutoBackupStrategy.NONE);
+		return strategies;
+	}
+
+	/**
+	 * The CSRF token value: the old settings container form carried a hidden input with id="token"
+	 * that inline scripts read (document.getElementById('token')).
+	 */
+	@TemplateFunction
+	public static String csrfToken()
+	{
+		final RequestAttributes attributes = RequestContextHolder.getRequestAttributes();
+		if(attributes == null)
+		{
+			return "";
+		}
+		final Object token = attributes.getAttribute("_csrf", RequestAttributes.SCOPE_REQUEST);
+		if(token instanceof CsrfToken csrfToken)
+		{
+			return csrfToken.getToken();
+		}
+		return "";
+	}
+
+	/** initial data for the keywords chips: [{tag: value}, ...] */
+	@TemplateFunction
+	public static List<Map<String, String>> keywordTags(List<TransactionNameKeyword> keywords)
+	{
+		final List<Map<String, String>> result = new ArrayList<>();
+		if(keywords != null)
+		{
+			for(TransactionNameKeyword keyword : keywords)
+			{
+				result.add(Map.of("tag", keyword.getValue() == null ? "" : keyword.getValue()));
+			}
+		}
+		return result;
+	}
+
+	/** Escapes text but keeps the <br> line breaks of localized messages (the old pages printed them raw). */
+	@TemplateFunction
+	public static SafeHtml withBreaks(String text)
+	{
+		if(text == null)
+		{
+			return SafeHtml.EMPTY;
+		}
+		final String[] parts = text.split("<br>", -1);
+		final List<SafeHtml> result = new ArrayList<>();
+		for(int i = 0; i < parts.length; i++)
+		{
+			if(i > 0)
+			{
+				result.add(SafeHtml.sanitize("<br>"));
+			}
+			result.add(SafeHtml.escape(parts[i]));
+		}
+		return SafeHtml.concat(result.toArray(new SafeHtml[0]));
+	}
+
+	/**
+	 * Part {@code index} (0 = before, 1 = link text, 2 = after) of a localized message containing one
+	 * {@code <a href="">...</a>} link (settings.personalization.reload.page); the template writes the link markup.
+	 */
+	@TemplateFunction
+	public static String linkPart(String text, int index)
+	{
+		if(text == null)
+		{
+			return "";
+		}
+		final String[] parts = text.split("<a href=\"\">|</a>", 3);
+		return index < parts.length ? parts[index] : "";
+	}
+}
