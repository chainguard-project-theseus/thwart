+                                    <td><i class="fas fa-exclamation-triangle text-red"></i></td>
+                                    <td t:text="error">error</td>
+                                </tr>
+                            </table>
+                        </div>
+                    </li>
+                </ul>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<div t:fragment="statusBanner(CsvTransactionStatus status)"
+     t:class="|banner ${status == 'PENDING' ? 'background-blue text-white' : (status == 'IMPORTED' ? 'background-green text-white' : (status == 'SKIPPED' ? (bm.isDarkTheme() ? 'background-grey text-black' : 'background-grey text-white') : ''))}|"
+     t:text="loc.get(status.localizationKey)">status</div>
+</html>
