+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.templategroup.TemplateGroup, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templating.ValidationErrors"
+      t:params="Settings settings, List<Notification> notifications, TemplateGroup templateGroup, ValidationErrors validation">
+    <head t:with="title=templateGroup.ID != null ? loc.get('title.template.group.edit') : loc.get('title.template.group.new')">
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="templateGroup.ID != null ? loc.get('title.template.group.edit') : loc.get('title.template.group.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                <section t:remove="tag">
+                    <div class="container">
+                    <form name="NewTemplateGroup" t:action="@{/templateGroups/newTemplateGroup}" method="post" onsubmit="return validateForm(true)">
+                        <input type="hidden" name="ID" t:value="templateGroup.ID == null ? '' : '' + templateGroup.ID">
+
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">file_copy</i>
+                                <input id="template-group-name" type="text" name="name" t:class="val.cls(validation, 'name', '')" t:data-position="val.position(validation, 'name')" t:data-delay="val.delay(validation, 'name')" t:data-tooltip="val.tooltip(validation, 'name')" t:value="templateGroup.name ?: ''">
+                                <label for="template-group-name" t:text="loc.get('transaction.new.label.name')">name</label>
+                            </div>
+                        </div>
+
+                        <br>
+
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <t:block t:replace="~{helpers/header :: buttonLink('/templateGroups', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '', '')}"></t:block>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonLink('/templateGroups', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '', '')}"></t:block>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+                </section>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/templateGroups.js}"></script>
+    </body>
+</html>
