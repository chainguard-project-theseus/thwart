+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.charts.Chart, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="Settings settings, List<Notification> notifications, List<Chart> customCharts, List<Chart> defaultCharts">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + loc.get('menu.charts'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('charts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="loc.get('menu.charts')">Charts</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                <section t:remove="tag">
+                    <br>
+                    <t:block t:replace="~{charts/chartFunctions :: buttons()}"></t:block>
+                    <br>
+                    <div class="container">
+                        <div class="section center-align">
+                            <div class="headline-small" t:text="loc.get('charts.custom')">custom</div>
+                        </div>
+
+                        <table class="bordered">
+                            <thead>
+                                <tr>
+                                    <th t:text="loc.get('chart.new.label.name')">name</th>
+                                    <th t:text="loc.get('chart.actions')">actions</th>
+                                </tr>
+                            </thead>
+                            <tr t:each="chart : customCharts">
+                                <td t:text="mischarts.chartName(chart)">name</td>
+                                <td>
+                                    <t:block t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.ID + '/edit', 'edit', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                                    <t:block t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.ID + '/requestDelete', 'delete', '', '', 'no-padding text-default button-request-delete-chart', true, false, '', '', '')}"></t:block>
+                                </td>
+                            </tr>
+                        </table>
+                        <t:block t:if="customCharts.isEmpty()">
+                            <div class="center-align charts-default-margin" t:text="loc.get('placeholder')">placeholder</div>
+                            <br>
+                        </t:block>
+
+                        <div class="section center-align charts-default-margin">
+                            <div class="headline-small" t:text="loc.get('charts.default')">default</div>
+                        </div>
+
+                        <table class="bordered">
+                            <thead>
+                                <tr>
+                                    <th t:text="loc.get('chart.new.label.name')">name</th>
+                                    <th t:text="loc.get('chart.display.type')">display</th>
+                                    <th t:text="loc.get('chart.group.type')">group</th>
+                                    <th t:text="loc.get('chart.actions')">actions</th>
+                                </tr>
+                            </thead>
+                            <tr t:each="chart : defaultCharts">
+                                <td t:text="mischarts.chartName(chart)">name</td>
+                                <td><t:block t:replace="~{charts/chartFunctions :: iconForItem(chart.displayType)}"></t:block></td>
+                                <td><t:block t:replace="~{charts/chartFunctions :: iconForItem(chart.groupType)}"></t:block></td>
+                                <td>
+                                    <t:block t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.ID + '/edit', 'visibility', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                                </td>
+                            </tr>
+                        </table>
+                    </div>
+                </section>
+                </t:block>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/charts.js}"></script>
+    </body>
+</html>
