+      t:params="Settings settings, List<Notification> notifications, Transaction transaction, boolean isEdit, boolean changeTypeInProgress, List<Category> categories, List<Account> accounts, String suggestionsJSON, LocalDate currentDate, ValidationErrors validation"
+      t:with="title=isEdit ? loc.get('title.transaction.edit', loc.get('title.transaction.new.normal')) : loc.get('title.transaction.new', loc.get('title.transaction.new.normal'))">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
