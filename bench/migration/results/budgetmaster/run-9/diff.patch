diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/header.html b/BudgetMasterServer/src/main/resources/templates/helpers/header.html
new file mode 100644
index 00000000..7eced882
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/header.html
@@ -0,0 +1,121 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.hints.Hint, de.deadlocker8.budgetmaster.icon.Iconizable">
+<!--
+  Shared fragments (formerly helpers/header.ftl).
+  Usage in a page <head>:   <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + loc.get('menu.accounts'))}"></t:block>
+  Page stylesheets are written directly: <link type="text/css" rel="stylesheet" t:href="@{/css/login.css}"/>
+  Body: <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'"> (Settings settings is a model attribute on every page)
+-->
+<t:block t:fragment="header(String title)">
+    <title t:text="title">title</title>
+    <meta charset="UTF-8"/>
+    <link rel="stylesheet" t:href="@{/webjars/font-awesome/css/all.min.css}">
+    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
+    <link rel="stylesheet" t:href="@{/webjars/materializecss/css/materialize.min.css}">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/colors.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/style.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/navbar.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/categories.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/accounts.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/customSelect.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/hotkeys.css}"/>
+
+    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
+
+    <link rel="apple-touch-icon" t:href="@{/touch_icon.png}">
+</t:block>
+
+<t:block t:fragment="logo(String id, String classes)">
+    <img t:if="bm.isDarkTheme()" t:class="classes" t:id="id" t:src="@{/images/Logo_with_white_text_medium_res.png}">
+    <img t:unless="bm.isDarkTheme()" t:class="classes" t:id="id" t:src="@{/images/Logo_with_text_medium_res.png}">
+</t:block>
+
+<!-- confirmUrl + '/' + itemId + '/delete' is the delete link; content is the former #nested -->
+<div t:fragment="modalConfirmDelete(String title, String confirmUrl, Integer itemId, String confirmButtonTextKey, String id, String classes, Fragment content)"
+     t:id="id" class="modal background-color" t:classappend="classes">
+    <div class="modal-content">
+        <h4 t:text="title">title</h4>
+
+        <t:block t:replace="content"></t:block>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, true, false, '')}"></t:block>
+        <t:block t:replace="~{helpers/header :: buttonLink(confirmUrl + '/' + itemId + '/delete', 'delete', confirmButtonTextKey, '', 'green', 'modal-action modal-close text-white', false, false, false, '')}"></t:block>
+    </div>
+</div>
+
+<!-- formerly <@header.content>: notifications followed by the content -->
+<t:block t:fragment="content(List<Notification> notifications, Fragment content)">
+    <t:block t:if="notifications != null" t:replace="~{helpers/header :: showNotifications(notifications)}"></t:block>
+    <t:block t:replace="content"></t:block>
+</t:block>
+
+<t:block t:fragment="showNotifications(List<Notification> notifications)">
+    <div t:each="notification : notifications" class="row notification-row" t:id="|notification-${notificationStat.index}|">
+        <div class="col s12 center-align">
+            <div class="notification-wrapper">
+                <div t:class="|notification ${notification.backgroundColor} ${notification.textColor}|">
+                    <i t:if="notification.icon != null" t:class="|${notification.icon} notification-item|"></i>
+                    <span class="notification-item" t:utext="bm.notificationMessage(notification)">message</span>
+                    <a t:class="|notification-item notification-clear ${notification.textColor}|" t:data-id="|notification-${notificationStat.index}|">
+                        <i class="material-icons">clear</i>
+                    </a>
+                </div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!-- actionUrl: '' for none -->
+<t:block t:fragment="hint(Hint hint, String icon, String actionUrl)">
+    <div t:unless="hint.dismissed" class="row" t:id="|hint-${hint.ID}|">
+        <div class="col s12 center-align">
+            <div class="notification-wrapper">
+                <div class="notification notification-border text-default">
+                    <i t:class="|${icon} notification-item|"></i>
+                    <a t:if="!strings.isEmpty(actionUrl)" t:href="actionUrl" class="text-default">
+                        <span class="notification-item left-align" t:text="loc.get(hint.localizationKey)">hint</span>
+                    </a>
+                    <span t:if="strings.isEmpty(actionUrl)" class="notification-item left-align" t:text="loc.get(hint.localizationKey)">hint</span>
+                    <a class="notification-item hint-clear text-default" t:data-url="@{/hints/dismiss/{id}(id=hint.ID)}" t:data-id="|hint-${hint.ID}|">
+                        <i class="material-icons">clear</i>
+                    </a>
+                </div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!-- all parameters are required: pass '' / false for the old defaults
+     (id='', color='background-blue', classes='', isDataUrl=false, noUrl=false, disabled=false, target='') -->
+<a t:fragment="buttonLink(String url, String icon, String localizationKey, String id, String color, String classes, boolean isDataUrl, boolean noUrl, boolean disabled, String target)"
+   t:target="strings.isEmpty(target) ? null : target" t:href="isDataUrl || noUrl ? null : url"
+   t:id="id"
+   t:class="|waves-effect waves-light btn ${color} ${classes}|"
+   t:data-url="isDataUrl ? url : null"
+   t:disabled="disabled"><i class="material-icons left" t:classappend="strings.isEmpty(localizationKey) ? 'no-margin'" t:text="icon">icon</i><t:block t:unless="strings.isEmpty(localizationKey)" t:text="loc.get(localizationKey)">text</t:block></a>
+
+<!-- all parameters are required: old defaults id='', color='background-blue', classes='', disabled=false, formaction='', value='', form='' (onclick is not supported) -->
+<button t:fragment="buttonSubmit(String name, String icon, String localizationKey, String id, String color, String classes, boolean disabled, String formaction, String value, String form)"
+        t:id="strings.isEmpty(id) ? null : id" t:class="|btn waves-effect waves-light ${color} ${classes}|" type="submit" t:name="name"
+        t:disabled="disabled" t:formaction="strings.isEmpty(formaction) ? null : formaction" t:value="strings.isEmpty(value) ? null : value"
+        t:form="strings.isEmpty(form) ? null : form"><i class="material-icons left" t:classappend="strings.isEmpty(localizationKey) ? 'no-margin'" t:text="icon">icon</i><t:block t:unless="strings.isEmpty(localizationKey)" t:text="loc.get(localizationKey)">text</t:block></button>
+
+<!-- all parameters are required: old defaults id='', classes='', isDataUrl=false, noUrl=false, iconClasses='', target='', datasetIndex='' -->
+<a t:fragment="buttonFlat(String url, String icon, String localizationKey, String id, String classes, boolean isDataUrl, boolean noUrl, String iconClasses, String target, String datasetIndex)"
+   t:target="strings.isEmpty(target) ? null : target" t:href="isDataUrl || noUrl ? null : url"
+   t:id="id"
+   t:data-index="strings.isEmpty(datasetIndex) ? null : datasetIndex"
+   t:class="|waves-effect waves-light btn-flat ${classes}|"
+   t:data-url="isDataUrl ? url : null"><i t:class="|material-icons left ${strings.isEmpty(localizationKey) ? 'no-margin' : ''} ${iconClasses}|" t:text="icon">icon</i><span t:unless="strings.isEmpty(localizationKey)" t:text="loc.get(localizationKey)">text</span></a>
+
+<!-- entity: anything with an icon reference (Account, Category, Template, ...) -->
+<t:block t:fragment="entityIcon(Iconizable entity, String classes, String fallbackName)">
+    <t:block t:if="entity.iconReference != null">
+        <img t:if="entity.iconReference.isImageIcon()" t:src="@{/media/getImageByIconID/{id}(id=entity.iconReference.ID)}" t:class="classes"/>
+        <i t:if="!entity.iconReference.isImageIcon() && entity.iconReference.isBuiltinIcon()" t:class="|${entity.iconReference.builtinIdentifier} ${classes}|"></i>
+        <t:block t:if="!entity.iconReference.isImageIcon() && !entity.iconReference.isBuiltinIcon()" t:text="bm.firstCapital(fallbackName)">X</t:block>
+    </t:block>
+    <t:block t:if="entity.iconReference == null" t:text="bm.firstCapital(fallbackName)">X</t:block>
+</t:block>
+</html>
