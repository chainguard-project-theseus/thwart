+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + loc.get('menu.tags'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('tags', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">local_offer</i> [[${loc.get('menu.tags')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                <section t:remove="tag">
+                    <div class="container">
+                        <div t:if="tagUsages.isEmpty()" class="headline center-align" t:text="loc.get('placeholder')">placeholder</div>
+                        <table t:unless="tagUsages.isEmpty()" class="bordered">
+                            <thead>
+                                <tr>
+                                    <th t:text="loc.get('category.new.label.name')">name</th>
+                                    <th t:text="loc.get('categories.usages')">usages</th>
+                                    <th t:text="loc.get('categories.actions')">actions</th>
+                                </tr>
+                            </thead>
+                            <tr t:each="tag : tagUsages">
+                                <td>[[${tag.key}]] </td>
+                                <td>
+                                    <a t:href="'/search?searchTags=true&searchText=' + tag.key" class="waves-effect waves-light text-default" t:text="tag.value">1</a>
+                                </td>
+                                <td>
+                                    <t:block t:replace="~{helpers/header :: buttonFlat('/search?searchTags=true&searchText=' + tag.key, 'search', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                                </td>
+                            </tr>
+                        </table>
+                    </div>
+                </section>
+                </t:block>
+            </div>
+        </main>
+
+        <!--  Scripts-->
