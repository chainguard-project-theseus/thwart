+package de.deadlocker8.budgetmaster.templating;
+
+import com.google.gson.Gson;
+import com.google.gson.reflect.TypeToken;
+import de.deadlocker8.budgetmaster.repeating.RepeatingOption;
+import de.deadlocker8.budgetmaster.repeating.modifier.RepeatingModifierType;
+import de.deadlocker8.budgetmaster.tags.Tag;
+import de.deadlocker8.budgetmaster.transactions.Transaction;
+import de.deadlocker8.budgetmaster.transactions.TransactionBase;
+import de.deadlocker8.budgetmaster.transactions.TransactionImportController;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.context.i18n.LocaleContextHolder;
+import org.springframework.web.context.request.RequestAttributes;
+import org.springframework.web.context.request.RequestContextHolder;
+
+import java.text.NumberFormat;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Functions for the new/edit transaction forms (formerly newTransactionMacros.ftl).
+ */
+@TemplateFunctions("txf")
+public final class TransactionFormFunctions
+{
+	private TransactionFormFunctions()
+	{
+	}
+
+	/** suggestionsJSON (a JSON array string built with Gson) as a list, so a script can write it with [[...]] */
+	@TemplateFunction
+	public static List<String> jsonList(String json)
+	{
+		if(json == null)
+		{
+			return List.of();
+		}
+		final List<String> list = new Gson().fromJson(json, new TypeToken<List<String>>() {}.getType());
+		return list == null ? List.of() : list;
+	}
+
+	/** FreeMarker's default number output (locale-aware, with grouping) */
+	@TemplateFunction
+	public static String num(Number number)
+	{
+		if(number == null)
+		{
+			return "";
+		}
+		return NumberFormat.getNumberInstance(LocaleContextHolder.getLocale()).format(number);
+	}
+
+	/** the session attribute currentCsvTransaction (FreeMarker exposed session attributes) */
+	@TemplateFunction
+	public static boolean hasCurrentCsvTransaction()
+	{
+		final RequestAttributes attributes = RequestContextHolder.getRequestAttributes();
+		if(attributes == null)
+		{
+			return false;
+		}
+		return attributes.getAttribute(TransactionImportController.RequestAttributeNames.CURRENT_CSV_TRANSACTION, RequestAttributes.SCOPE_SESSION) != null;
+	}
+
+	@TemplateFunction
+	public static List<RepeatingModifierType> repeatingModifierTypes()
+	{
+		return Arrays.asList(RepeatingModifierType.values());
+	}
+
+	/** initial tags of the tag chips: [{tag: name}, ...] */
+	@TemplateFunction
+	public static List<Map<String, String>> initialTags(TransactionBase transaction)
+	{
+		final List<Map<String, String>> result = new ArrayList<>();
+		if(transaction == null || transaction.getTags() == null)
+		{
+			return result;
+		}
+		for(Tag tag : transaction.getTags())
+		{
+			final Map<String, String> entry = new LinkedHashMap<>();
+			entry.put("tag", tag.getName());
+			result.add(entry);
+		}
+		return result;
+	}
+
+	/** tag autocomplete data: {name: null, ...} */
+	@TemplateFunction
+	public static Map<String, String> tagAutoComplete()
+	{
+		final Map<String, String> result = new LinkedHashMap<>();
+		for(Tag tag : AppFunctions.allTags())
+		{
+			result.put(tag.getName(), null);
+		}
+		return result;
+	}
+
+	@TemplateFunction
+	public static String endOptionKey(Transaction transaction)
+	{
+		final RepeatingOption option = transaction == null ? null : transaction.getRepeatingOption();
+		if(option == null || option.getEndOption() == null)
+		{
+			return null;
+		}
+		return option.getEndOption().getLocalizationKey();
+	}
+
+	/** value of the repeating end option as FreeMarker printed it */
+	@TemplateFunction
+	public static String endOptionValue(Transaction transaction)
+	{
+		final RepeatingOption option = transaction == null ? null : transaction.getRepeatingOption();
+		if(option == null || option.getEndOption() == null || option.getEndOption().getValue() == null)
+		{
+			return "";
+		}
+		final Object value = option.getEndOption().getValue();
+		if(value instanceof Number number)
+		{
+			return num(number);
+		}
+		return String.valueOf(value);
+	}
+
+	/** end date (long date string) of a repeating end date option */
+	@TemplateFunction
+	public static LocalDate endOptionDate(Transaction transaction)
+	{
+		final RepeatingOption option = transaction == null ? null : transaction.getRepeatingOption();
+		if(option == null || option.getEndOption() == null)
+		{
+			return null;
+		}
+		final Object value = option.getEndOption().getValue();
+		return value instanceof LocalDate date ? date : null;
+	}
+}
