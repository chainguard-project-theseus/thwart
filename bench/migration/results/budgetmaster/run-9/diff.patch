+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.categories.Category;
+import de.deadlocker8.budgetmaster.categories.CategoryType;
+import de.deadlocker8.budgetmaster.templategroup.TemplateGroup;
+import de.deadlocker8.budgetmaster.templategroup.TemplateGroupType;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import java.util.ArrayList;
+import java.util.List;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Functions for categories, templates, template groups and the transaction import (agentC).
+ */
+@TemplateFunctions("cat")
+public final class CategoryFunctions
+{
+	private CategoryFunctions()
+	{
+	}
+
+	/** formerly categoriesFunctions.getCategoryName */
+	@TemplateFunction
+	public static String name(Category category)
+	{
+		if(category == null || category.getName() == null)
+		{
+			return "";
+		}
+		if(category.getType() == CategoryType.NONE)
+		{
+			return Localization.getString("category.none");
+		}
+		if(category.getType() == CategoryType.REST)
+		{
+			return Localization.getString("category.rest");
+		}
+		return category.getName();
+	}
+
+	/** formerly templateFunctions.getTemplateGroupName */
+	@TemplateFunction
+	public static String templateGroupName(TemplateGroup templateGroup)
+	{
+		if(templateGroup.getType() == TemplateGroupType.DEFAULT)
+		{
+			return Localization.getString("template.group.default");
+		}
+		return templateGroup.getName();
+	}
+
+	/**
+	 * Splits the category colors into the rows of newCategory: 6, 6 and the rest
+	 * (the old template opened rows at color 1, 7, 13 and closed them after 6 and 12).
+	 */
+	@TemplateFunction
+	public static List<List<String>> colorRows(List<String> colors)
+	{
+		final List<List<String>> rows = new ArrayList<>();
+		if(colors == null)
+		{
+			return rows;
+		}
+		int start = 0;
+		while(start < colors.size())
+		{
+			final int end = rows.size() < 2 ? Math.min(start + 6, colors.size()) : colors.size();
+			rows.add(colors.subList(start, end));
+			start = end;
+		}
+		return rows;
+	}
+}
