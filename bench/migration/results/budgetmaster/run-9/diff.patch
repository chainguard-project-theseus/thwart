+{
+	boolean hasFontAwesomeIcon();
+
+	String getIcon();
+
+	String getLocalizationKey();
+
+	default boolean isFontAwesomeIcon()
+	{
+		return hasFontAwesomeIcon();
+	}
+
+	/**
+	 * @return the enum constant name (templates cannot call name())
+	 */
+	default String getEnumName()
+	{
+		return ((Enum<?>) this).name();
+	}
+}
