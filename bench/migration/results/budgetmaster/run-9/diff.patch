+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.search.Search, de.deadlocker8.budgetmaster.search.SearchResultPage"
+      t:params="Settings settings, List<Notification> notifications, SearchResultPage page, Search search">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + loc.get('search'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/search.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('home', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="loc.get('menu.search.results', page.totalElements)">results</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                <section t:remove="tag">
+                    <form id="searchForm" t:action="@{/search}" method="get">
+                        <t:block t:replace="~{search/searchMacros :: searchTextAndButton(search)}"></t:block>
+                        <t:block t:replace="~{search/searchMacros :: checkboxes(search)}"></t:block>
+                        <t:block t:replace="~{search/searchMacros :: dateRange(search)}"></t:block>
+                        <input type="hidden" name="page" id="inputPageNumber" t:value="page.number"/>
+                    </form>
+
+                    <t:block t:replace="~{search/searchMacros :: pagination(page, 'top')}"></t:block>
+
+                    <div class="row search-container">
+                        <div class="col s12">
+                            <t:block t:replace="~{search/searchMacros :: renderTransactions(page.content, false)}"></t:block>
+
+                            <div t:if="page.content.isEmpty()" class="row">
+                                <div class="col s12">
+                                    <br><br>
+                                    <div class="headline-advice center-align" t:text="loc.get('search.placeholder')">placeholder</div>
+                                </div>
+                            </div>
+                        </div>
+                    </div>
+
+                    <t:block t:replace="~{search/searchMacros :: pagination(page, 'bottom')}"></t:block>
+                </section>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization()}"></t:block>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/search.js}"></script>
+    </body>
+</html>
