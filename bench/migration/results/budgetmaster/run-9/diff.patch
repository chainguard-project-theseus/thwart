+package de.deadlocker8.budgetmaster.templating;
+
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Replacement for helpers/validation.ftl. On a form input:
+ * <pre>
+ * t:class="val.cls(validation, 'name', 'extra-classes')"
+ * t:data-position="val.position(validation, 'name')"
+ * t:data-delay="val.delay(validation, 'name')"
+ * t:data-tooltip="val.tooltip(validation, 'name')"
+ * </pre>
+ * with "ValidationErrors validation" in t:params (null when there were no errors).
+ */
+@TemplateFunctions("val")
+public final class ValidationFunctions
+{
+	private ValidationFunctions()
+	{
+	}
+
+	@TemplateFunction
+	public static boolean has(ValidationErrors validation, String fieldName)
+	{
+		return validation != null && validation.getFieldErrorCodes().containsKey(fieldName);
+	}
+
+	@TemplateFunction
+	public static String cls(ValidationErrors validation, String fieldName, String classes)
+	{
+		final String extra = classes == null ? "" : classes;
+		return has(validation, fieldName) ? "tooltipped invalid " + extra : "validate " + extra;
+	}
+
+	@TemplateFunction
+	public static String position(ValidationErrors validation, String fieldName)
+	{
+		return has(validation, fieldName) ? "bottom" : null;
+	}
+
+	@TemplateFunction
+	public static String delay(ValidationErrors validation, String fieldName)
+	{
+		return has(validation, fieldName) ? "50" : null;
+	}
+
+	@TemplateFunction
+	public static String tooltip(ValidationErrors validation, String fieldName)
+	{
+		return has(validation, fieldName) ? Localization.getString(validation.getFieldErrorCodes().get(fieldName)) : null;
+	}
+}
