+            <span style="margin: auto" t:text="mischarts.chartName(chart)">name</span>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="dateSelect(ChartSettings chartSettings)" class="container"
+     t:with="startDate=${bm.dateLong(chartSettings.startDate)}, endDate=${bm.dateLong(chartSettings.endDate)}">
+    <div class="row">
+        <div class="col s12">
+            <div class="card" id="chart-date-card">
+                <div class="card-content">
+                    <div class="row">
+                        <div class="input-field col s6 m6 l4 offset-l2">
+                            <input id="chart-datepicker" type="text" class="datepicker" name="startDate" t:value="startDate">
+                            <label for="chart-datepicker" t:text="loc.get('chart.steps.second.label.start')">start</label>
