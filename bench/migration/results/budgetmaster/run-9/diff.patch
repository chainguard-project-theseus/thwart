+                            <label for="chart-datepicker-end" t:text="loc.get('chart.steps.second.label.end')">end</label>
+                        </div>
+                    </div>
+
+                    <div class="row no-margin-bottom">
+    <div class="col s12 m12 l8 offset-l2 no-margin-top">
+        <table class="no-border-table">
+            <tr>
+                <td class="quick-date" data-quick="0" t:text="loc.get('chart.quick.this.week')">x</td>
+                <td class="quick-date" data-quick="1" t:text="loc.get('chart.quick.this.month')">x</td>
+                <td class="quick-date" data-quick="2" t:text="loc.get('chart.quick.this.year')">x</td>
+                <td class="quick-date" data-quick="3" t:text="loc.get('chart.quick.all')">x</td>
+            </tr>
+            <tr>
+                <td class="quick-date" data-quick="4" t:text="loc.get('chart.quick.last.week')">x</td>
+                <td class="quick-date" data-quick="5" t:text="loc.get('chart.quick.last.month')">x</td>
+                <td class="quick-date" data-quick="6" t:text="loc.get('chart.quick.last.year')">x</td>
+                <td class="quick-date" data-quick="7" t:text="loc.get('chart.quick.until.endOfLastYear')">x</td>
+            </tr>
+            <tr>
+                <td class="quick-date" data-quick="8" t:text="loc.get('chart.quick.last.week.days')">x</td>
+                <td class="quick-date" data-quick="9" t:text="loc.get('chart.quick.last.month.days')">x</td>
+                <td class="quick-date" data-quick="10" t:text="loc.get('chart.quick.last.year.days')">x</td>
+                <td class="quick-date" data-quick="11" t:text="loc.get('chart.quick.until.today')">x</td>
+            </tr>
+        </table>
+    </div>
+</div>
+
+                    <script>
