+    <td t:text="cat.name(template.category)">category</td>
+</tr>
+
+<tr t:fragment="templateDescription(Template template)" t:if="!strings.isEmpty(template.description)">
+    <td class="template-content-label" t:text="loc.get('transaction.new.label.description')">label</td>
+    <td t:text="template.description">description</td>
+</tr>
+
+<tr t:fragment="templateTags(Template template)" t:if="template.tags != null && template.tags.size() > 0">
+    <td class="template-content-label" t:text="loc.get('transaction.new.label.tags')">label</td>
