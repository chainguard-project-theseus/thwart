+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.Build"
+      t:params="Settings settings, List<Notification> notifications, Build build">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + loc.get('menu.about'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('about', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="row">
+                    <div class="col s8 offset-s2 center-align">
+                        <t:block t:replace="~{helpers/header :: logo('logo-huge', 'responsive-img')}"></t:block>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                <section t:remove="tag">
+                    <div class="hide-on-small-only"><br><br></div>
+                    <div class="row">
+                        <t:block t:replace="~{about :: cellKey(loc.get('about.version'))}"></t:block>
+                        <div class="col s8 m5 l5">
+                            [[${build.versionName}]] ([[${build.versionCode}]])
+
+                            <a class="whatsNewLink" t:data-url="@{/about/whatsNewModal}">[[${loc.get('about.version.whatsnew')}]]?</a>
+                            <div id="whatsNewModelContainerOnDemand"></div>
+                        </div>
+                    </div>
+                    <div class="row">
+                        <t:block t:replace="~{about :: cellKey(loc.get('about.date'))}"></t:block>
+                        <div class="col s8 m5 l5" t:text="build.versionDate">date</div>
+                    </div>
+                    <div class="row">
+                        <t:block t:replace="~{about :: cellKey(loc.get('about.author'))}"></t:block>
+                        <div class="col s8 m5 l5" t:text="build.author">author</div>
+                    </div>
+                    <div class="row">
+                        <t:block t:replace="~{about :: cellKey(loc.get('about.sourcecode'))}"></t:block>
+                        <div class="col s8 m5 l5 break-all"><a target="_blank" t:href="loc.get('github.url')" t:text="loc.get('github.url')">url</a></div>
+                    </div>
+                    <div class="row">
+                        <t:block t:replace="~{about :: cellKey(loc.get('about.credits'))}"></t:block>
+                        <div class="col s8 m5 l5" t:utext="misc.markup('credits')">credits</div>
+                    </div>
+                </section>
+                </t:block>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/about.js}"></script>
+    </body>
+
+<div t:fragment="cellKey(String key)" class="col s4 m3 offset-m2 l2 offset-l3 bold" t:text="key">key</div>
+</html>
