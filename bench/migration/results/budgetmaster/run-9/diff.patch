+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.templategroup.TemplateGroup, de.deadlocker8.budgetmaster.utils.notification.Notification"
