@@ -0,0 +1,38 @@
+package de.deadlocker8.budgetmaster.templating;
+
+import dev.tessera.runtime.TemplateView;
+import org.springframework.validation.BindingResult;
+import org.springframework.validation.FieldError;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * View-safe copy of the field errors of the "error" BindingResult that controllers put in the model.
+ * Maps each field name to the localization key (error code) of its first error.
+ */
+@TemplateView
+public class ValidationErrors
+{
+	private final Map<String, String> fieldErrorCodes;
+
+	public ValidationErrors(Map<String, String> fieldErrorCodes)
+	{
+		this.fieldErrorCodes = fieldErrorCodes;
+	}
+
+	public static ValidationErrors of(BindingResult bindingResult)
+	{
+		final Map<String, String> codes = new LinkedHashMap<>();
+		for(FieldError fieldError : bindingResult.getFieldErrors())
+		{
+			codes.putIfAbsent(fieldError.getField(), fieldError.getCode());
+		}
+		return new ValidationErrors(codes);
+	}
+
+	public Map<String, String> getFieldErrorCodes()
+	{
+		return fieldErrorCodes;
+	}
+}
