+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.charts.Chart;
+import de.deadlocker8.budgetmaster.charts.ChartType;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Chart helpers for charts/*.html (formerly chartFunctions.ftl / inline FreeMarker logic).
+ */
+@TemplateFunctions("mischarts")
+public final class MiscChartFunctions
+{
+	private MiscChartFunctions()
+	{
+	}
+
+	/**
+	 * Former chartFunctions.getChartName: localized name for default charts, raw name for custom charts.
+	 */
+	@TemplateFunction
+	public static String chartName(Chart chart)
+	{
+		if(chart == null || chart.getName() == null)
+		{
+			return "";
+		}
+		if(chart.getType() == ChartType.DEFAULT)
+		{
+			return Localization.getString(chart.getName());
+		}
+		return chart.getName();
+	}
+
+	/**
+	 * The chart's script with the transaction data and container ID filled in (as the old template did with ?replace).
+	 */
+	@TemplateFunction
+	public static String chartScript(Chart chart, String transactionData, String containerID)
+	{
+		if(chart == null || chart.getScript() == null)
+		{
+			return "";
+		}
+		String script = chart.getScript();
+		script = script.replace("var transactionData = [];", "var transactionData = " + transactionData + ";");
+		script = script.replace("containerID", containerID);
+		return script;
+	}
+}
