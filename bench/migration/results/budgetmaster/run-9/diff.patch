+<div xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.accounts.Account" t:params="List<Account> accounts"
+     id="modalGlobalAccountSelect" class="modal modal-fixed-footer background-color-light">
+    <div class="modal-content">
+        <div class="row no-margin-bottom">
+            <div class="col s12">
+                <h4 t:text="loc.get('account.select')">select</h4>
+            </div>
+        </div>
+
+        <div class="row">
+            <div class="col s12 center-align">
+                <t:block t:replace="~{helpers/header :: buttonLink('/accounts', 'edit', 'account.button.manage', '', 'background-blue', '', false, false, false, '')}"></t:block>
+            </div>
+        </div>
+
+        <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.globalAccountSelect.hotkeys'), 'fas fa-info', '')}"></t:block>
+
+        <div class="row">
+            <div t:each="account : accounts" class="col s12 m6 xl6"
+                 t:with="accountName=account.type == 'ALL' ? loc.get('account.all') : account.name">
+                <a t:href="@{/accounts/{id}/select(id=account.ID)}" class="text-default">
+                    <div class="card-panel global-account-select-option" t:data-account-index="accountStat.index">
+                        <div class="global-account-select-option-header">
+                            <div t:if="accountStat.index < 10" class="keyboard-key bold global-account-select-option-key" t:text="accountStat.index">0</div>
+                            <div t:unless="accountStat.index < 10" class="keyboard-key bold global-account-select-option-key-hidden">&nbsp;</div>
+
+                            <t:block t:if="account.endDate != null" t:with="remainingDays=account.remainingDays">
+                                <i t:if="remainingDays <= 0" class="fas fa-bell text-red tooltipped" data-position="right" t:data-tooltip="loc.get('account.tooltip.endDate.done', -remainingDays)"></i>
+                                <i t:if="remainingDays > 0 && remainingDays <= 30" class="fas fa-bell text-yellow tooltipped" data-position="right" t:data-tooltip="loc.get('account.tooltip.endDate.soon', remainingDays)"></i>
+                            </t:block>
+
+                        </div>
+                        <div class="global-account-select-option-content">
+                            <t:block t:replace="~{helpers/customSelectMacros :: accountIcon(account, accountName, 'category-circle-preview account-icon-big', '')}"></t:block>
+                            <div class="global-account-select-option-column-2" t:with="accountBudget=bm.accountBudgetByID(account.ID)">
+                                <div class="global-account-select-option-name truncate" t:text="accountName">name</div>
+                                <div t:class="|global-account-select-option-balance ${accountBudget <= 0 ? bm.redTextColor() : bm.greenTextColor()}|" t:text="bm.currency(accountBudget)">0</div>
+                            </div>
+                        </div>
+                    </div>
+                </a>
+            </div>
+        </div>
+    </div>
+    <div class="modal-footer background-color-light">
+        <t:block t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', 'buttonCloseGlobalAccountSelect', 'red', 'modal-action modal-close text-white', false, true, false, '')}"></t:block>
+    </div>
+</div>
