+                            <input type="hidden" name="ID" t:value="transaction.ID != null ? '' + transaction.ID : ''">
+                            <input type="hidden" name="isExpenditure" value="true">
+                            <input type="hidden" name="isRepeating" t:value="transaction.isRepeating()">
+
+                            <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.transaction.save'), 'fas fa-info', '')}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(transaction, suggestionsJSON, validation)}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(transaction, validation)}"></t:block>
+
+                            <t:block t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, transaction.category, 'col s12 m12 l8 offset-l2', loc.get('transaction.new.label.category'), 'transaction-category', true, '', false, '')}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionStartDate(transaction, currentDate)}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionDescription(transaction, validation)}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(transaction)}"></t:block>
+
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('account-select-wrapper', 'account', accounts, transaction.account != null ? transaction.account : bm.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', loc.get('transaction.new.label.account'), 'transaction-account', false)}"></t:block>
+
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, transaction.transferAccount != null ? transaction.transferAccount : bm.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', loc.get('transaction.new.label.transfer.account'), 'transaction-destination-account', false)}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionRepeating(transaction, currentDate, validation)}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttons('/transactions', true, false)}"></t:block>
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttonTransactionActions(isEdit, true, changeTypeInProgress, transaction)}"></t:block>
+                        </form>
+
+                        <div id="saveAsTemplateModalContainer"></div>
+
+                        <div id="changeTransactionTypeModalContainer"></div>
+
+                        <div id="transactionNameKeywordWarningModalContainer"></div>
+                    </div>
+                </section>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization()}"></t:block>
+
+        <!-- single-quoted JS string as before: literal per language (English/German) -->
+        <script t:if="bm.isGerman()">
+            createTemplateWithErrorInForm = 'Vorlage konnte nicht erstellt werden, da Fehler im Formular existieren!';
+            templateNameEmptyValidationMessage = [[${loc.get('warning.empty.transaction.name')}]];
+            templateNameDuplicateValidationMessage = [[${loc.get('warning.duplicate.template.name')}]];
+        </script>
+        <script t:unless="bm.isGerman()">
+            createTemplateWithErrorInForm = 'Template could not be created because errors exist in the form!';
+            templateNameEmptyValidationMessage = [[${loc.get('warning.empty.transaction.name')}]];
+            templateNameDuplicateValidationMessage = [[${loc.get('warning.duplicate.template.name')}]];
+        </script>
+
+        <!-- Scripts-->
