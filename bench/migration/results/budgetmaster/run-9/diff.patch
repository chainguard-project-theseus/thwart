+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="Settings settings, List<Notification> notifications, Map<String, Integer> tagUsages">
