new file mode 100644
index 00000000..ee95ee3f
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/transactionImport.html
@@ -0,0 +1,77 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templating.ValidationErrors, de.deadlocker8.budgetmaster.transactions.csvimport.*"
+      t:params="Settings settings, List<Notification> notifications, CsvImport csvImport, List<CsvRow> csvRows, List<CsvTransaction> csvTransactions, List<String> errorsColumnSettings, List<Category> categories, String suggestionsJSON, CsvImportSettings csvImportSettings, ValidationErrors validation">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + loc.get('menu.transactions.import'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactionImport.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+        <link rel="stylesheet" t:href="@{/webjars/datatables/css/dataTables.dataTables.min.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('importCSV', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="fas fa-file-csv"></i> [[${loc.get('menu.transactions.import')}]]</div>
+                    </div>
+                </div>
+
+                <script>
+                    transactionNameSuggestions = {};
+                </script>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                <section t:remove="tag">
+                    <div class="container">
+                        <t:block t:if="csvRows != null">
+                            <div class="row center-align">
+                                <div class="col s12 m12 l8 offset-l2 headline-small text-green truncate" id="csv-file-name">
+                                    <i class="fas fa-file-csv"></i> [[${csvImport.fileName}]]
+                                </div>
+                            </div>
+
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonLink('/transactionImport/cancel', 'clear', 'cancel', 'button-cancel-csv-import', 'red', 'text-white', false, false, false, '')}"></t:block>
+                                </div>
+                            </div>
+                        </t:block>
+                        <t:block t:if="csvRows == null">
+                            <t:block t:replace="~{transactions/transactionImportMacros :: csvUpload(csvImportSettings, validation)}"></t:block>
+                        </t:block>
+                    </div>
+
+                    <t:block t:if="csvTransactions != null">
+                        <t:block t:replace="~{transactions/transactionImportMacros :: renderCsvTransactions(csvTransactions, categories, suggestionsJSON)}"></t:block>
+                        <t:block t:replace="~{transactions/transactionImportMacros :: showColumnSettingsErrors(errorsColumnSettings)}"></t:block>
+                    </t:block>
+                    <t:block t:if="csvTransactions == null && csvRows != null">
+                        <div class="container">
+                            <div class="section center-align">
+                                <div class="headline-small" t:text="loc.get('transactions.import.matchColumns')">match</div>
+                            </div>
+                        </div>
+                        <t:block t:replace="~{transactions/transactionImportMacros :: columnSettings(csvRows, csvImportSettings, validation)}"></t:block>
+                        <t:block t:replace="~{transactions/transactionImportMacros :: renderCsvRows(csvRows)}"></t:block>
+                    </t:block>
+                </section>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- single-quoted JS string as before: literal per language (English/German) -->
+        <script t:if="bm.isGerman()">
+            localizedSearch = 'Suche';
+        </script>
+        <script t:unless="bm.isGerman()">
+            localizedSearch = 'Search';
+        </script>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/datatables/js/dataTables.min.js}"></script>
+        <script t:src="@{/js/transactionImport.js}"></script>
+    </body>
+</html>
