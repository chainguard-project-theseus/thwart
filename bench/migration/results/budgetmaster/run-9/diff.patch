new file mode 100644
index 00000000..164c65a8
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html
@@ -0,0 +1,95 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templating.ValidationErrors"
+      t:params="Settings settings, List<Notification> notifications, Category category, String customColor, List<String> categoryColors, ValidationErrors validation">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + (category.ID != null ? loc.get('title.category.edit') : loc.get('title.category.new')))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('categories', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="category.ID != null ? loc.get('title.category.edit') : loc.get('title.category.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                <section t:remove="tag">
+
+                    <div class="container">
+                        <form name="NewCategory" t:action="@{/categories/newCategory}" method="post">
+                            <input type="hidden" name="ID" t:value="category.ID == null ? '' : '' + category.ID">
+                            <input type="hidden" name="type" t:value="category.type == null ? '' : '' + category.type">
+
+                            <div class="row">
+                                <div class="input-field col s12 m12 l8 offset-l2" t:with="isNameEditingForbidden=category.type != null && (category.type == 'NONE' || category.type == 'REST')">
+                                    <i class="material-icons prefix">edit</i>
+                                    <input t:if="!isNameEditingForbidden" id="category-name" type="text" name="name" t:class="val.cls(validation, 'name', '')" t:data-position="val.position(validation, 'name')" t:data-delay="val.delay(validation, 'name')" t:data-tooltip="val.tooltip(validation, 'name')" t:value="cat.name(category)">
+                                    <input t:if="isNameEditingForbidden" id="category-name" type="text" name="name" t:value="cat.name(category)" readonly>
+                                    <label for="category-name" t:text="loc.get('category.new.label.name')">name</label>
+                                </div>
+                            </div>
+
+                            <input type="hidden" name="color" id="categoryColor" t:value="category.color">
+                            <div t:each="row : cat.colorRows(categoryColors)" class="row">
+                                <t:block t:each="color : row">
+                                    <div t:if="colorStat.first" class="col s2 m1 offset-m3 no-padding">
+                                        <div class="category-color" t:classappend="color == category.color ? 'category-color-active'" t:style="|background-color: ${css.color(color)}|"></div>
+                                    </div>
+                                    <div t:unless="colorStat.first" class="col s2 m1 no-padding">
+                                        <div class="category-color" t:classappend="color == category.color ? 'category-color-active'" t:style="|background-color: ${css.color(color)}|"></div>
+                                    </div>
+                                </t:block>
+                                <div t:if="rowStat.last" class="col s2 m1 no-padding">
+                                    <div id="customColorPickerContainer" class="category-color" t:classappend="customColor == category.color ? 'category-color-active'" t:style="|background-color: ${css.color(customColor)}|">
+                                        <span>+</span>
+                                    </div>
+                                </div>
+                            </div>
+
+                            <t:block t:replace="~{helpers/iconSelect :: iconSelect('category-icon', category, true, '', '', false)}"></t:block>
+
+                            <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(category)}"></t:block>
+
+                            <br>
+
+                            <div class="row hide-on-small-only">
+                                <div class="col s6 right-align">
+                                    <t:block t:replace="~{helpers/header :: buttonLink('/categories', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                                </div>
+
+                                <div class="col s6 left-align">
+                                    <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '', '')}"></t:block>
+                                </div>
+                            </div>
+                            <div class="hide-on-med-and-up">
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{helpers/header :: buttonLink('/categories', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                                    </div>
+                                </div>
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '', '')}"></t:block>
+                                    </div>
+                                </div>
+                            </div>
+                        </form>
+                    </div>
+                </section>
+                </t:block>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/iconSelect :: modalIconSelect('category-name', category)}"></t:block>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/categories.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
