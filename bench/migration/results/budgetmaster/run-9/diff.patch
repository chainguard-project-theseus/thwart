+<t:block t:fragment="repeatingEndDate(boolean checked, Transaction transaction, LocalDate currentDate)">
+    <t:block t:with="endDate=checked ? bm.dateLong(txf.endOptionDate(transaction)) : bm.dateLong(currentDate)">
+    <script>
+        endDate = [[${endDate}]].split(".");
+        endDate = new Date(endDate[2], endDate[1]-1, endDate[0]);
+    </script>
+
+    <div class="row valign-wrapper">
+        <div class="col s1">
+            <label>
+                <input class="with-gap" name="repeatingEndType" type="radio" id="repeating-end-date" t:value="loc.get('repeating.end.key.date')" t:checked="checked"/>
+                <span for="repeating-end-date"></span>
+            </label>
+        </div>
+        <div class="col s11">
+            <table class="table-repeating-end no-border-table">
+                <tr>
+                    <td class="cell" t:text="loc.get('repeating.end.date')">date</td>
+                    <td class="cell input-cell">
+                        <div class="input-field no-margin">
+                            <input t:class="bm.isUseSimpleDatepickerForTransactions() ? 'datepicker-simple no-margin input-min-width' : 'datepicker no-margin input-min-width'" id="transaction-repeating-end-date-input" type="text" t:value="endDate">
+                            <label for="transaction-repeating-end-date-input"></label>
+                        </div>
+                    </td>
+                    <td class="cell stretched-cell"></td>
+                </tr>
+            </table>
+        </div>
+    </div>
+    </t:block>
+</t:block>
+
+<t:block t:fragment="buttons(String cancelURL, boolean includeContinueButton, boolean allowEmptyAmount)">
+    <div id="keywordCheckUrl" class="hidden" t:data-url="@{/keywords/keywordCheck}"></div>
+
+    <br>
+    <hr>
+    <br>
+
+    <div class="row hide-on-small-only">
+        <div class="col s12 center-align">
