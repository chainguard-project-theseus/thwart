+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.charts.Chart, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templating.ValidationErrors"
+      t:params="Settings settings, List<Notification> notifications, Chart chart, ValidationErrors validation"
+      t:with="title=${chart.ID != null ? loc.get('title.chart.edit') : loc.get('title.chart.new')}, isDefault=${chart.type == 'DEFAULT'}">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <link rel="stylesheet" t:href="@{/webjars/codemirror/lib/codemirror.css}">
+        <link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('charts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="title">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                <section t:remove="tag">
+                    <div class="container">
+                    <form name="NewChart" t:action="@{/charts/newChart}" method="post">
+                        <input type="hidden" name="ID" t:value="chart.ID == null ? '' : '' + chart.ID">
+
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">edit</i>
+                                <input id="chart-name" type="text" name="name"
+                                       t:class="val.cls(validation, 'name', '')" t:data-position="val.position(validation, 'name')" t:data-delay="val.delay(validation, 'name')" t:data-tooltip="val.tooltip(validation, 'name')"
+                                       t:value="mischarts.chartName(chart)" t:disabled="isDefault">
+                                <label for="chart-name" t:text="loc.get('chart.new.label.name')">name</label>
+                            </div>
+                        </div>
+
+                        <!-- info message with link to wiki on how to create custom charts (markup of message chart.new.info.wiki, identical in all languages) -->
+                        <t:block t:if="chart.type == 'CUSTOM'"><t:block t:replace="~{charts/chartFunctions :: infoMessage('', ~{::span})}"><span t:remove="tag">Tutorial: <a target="_blank" href="https://github.com/deadlocker8/BudgetMaster/wiki/How-to-create-custom-charts">https://github.com/deadlocker8/BudgetMaster/wiki/How-to-create-custom-charts</a></span></t:block></t:block>
+
+                        <div class="row">
+                            <div class="input-field col sl2" style="width: 100%">
+                                <textarea id="chart-script" name="script"
+                                          t:class="val.cls(validation, 'script', 'materialize-textarea')" t:data-position="val.position(validation, 'script')" t:data-delay="val.delay(validation, 'script')" t:data-tooltip="val.tooltip(validation, 'script')"
+                                          t:text="chart.script"></textarea>
+                            </div>
+                        </div>
+
+                        <br>
+
+                        <t:block t:if="isDefault"><t:block t:replace="~{charts/chartFunctions :: infoMessage(loc.get('chart.new.info.default'), null)}"></t:block></t:block>
+
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <t:block t:replace="~{helpers/header :: buttonLink('/charts/manage', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', isDefault, '', '', '')}"></t:block>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonLink('/charts/manage', 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', isDefault, '', '', '')}"></t:block>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+                </section>
+                </t:block>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/codemirror/lib/codemirror.js}"></script>
+        <script t:src="@{/webjars/codemirror/mode/javascript/javascript.js}"></script>
+        <script t:src="@{/js/charts.js}"></script>
+    </body>
+</html>
