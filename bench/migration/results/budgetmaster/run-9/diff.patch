+        <i class="material-icons prefix">file_copy</i>
+        <input id="template-name" type="text" name="templateName" t:class="val.cls(validation, 'templateName', '')" t:data-position="val.position(validation, 'templateName')" t:data-delay="val.delay(validation, 'templateName')" t:data-tooltip="val.tooltip(validation, 'templateName')" t:value="template.templateName">
+        <label for="template-name" t:text="loc.get('template.new.label.name')">name</label>
+    </div>
+</div>
+
+<div t:fragment="templateIncludeAccountCheckbox(String id, String name, String label, boolean checked)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <label>
+            <input t:id="id" t:name="name" type="checkbox" t:checked="checked">
+            <span class="columnName-checkbox-label text-default" t:text="label">label</span>
+        </label>
+    </div>
+</div>
+</html>
