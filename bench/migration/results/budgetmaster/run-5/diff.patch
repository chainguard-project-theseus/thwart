diff --git a/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html b/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html
new file mode 100644
index 00000000..a28fc352
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html
@@ -0,0 +1,60 @@
+<div xmlns:t="https://tessera.dev"
+     t:import="de.deadlocker8.budgetmaster.charts.ChartDisplayType, de.deadlocker8.budgetmaster.charts.ChartGroupType">
+
+<!-- getChartName(chart) is the function chartsFn.chartName(chart) -->
+
+<div t:fragment="infoMessage(String text)" class="row no-margin-bottom">
+    <div class="col s12 center-align">
+        <table class="text-default login-message no-border-table">
+            <tr>
+                <td><i class="material-icons">info</i></td>
+                <td t:insert="~{helpers/header :: richText(text)}">text</td>
+            </tr>
+        </table>
+    </div>
+</div>
+
+<t:block t:fragment="buttonNew">
+    <t:block t:replace="~{helpers/header :: buttonLink(@{/charts/newChart}, 'add', 'title.chart.new', '', 'background-blue', '', false, false, false, '')}"></t:block>
+</t:block>
+
+<t:block t:fragment="buttonShow">
+    <t:block t:replace="~{helpers/header :: buttonLink(@{/charts}, 'show_chart', 'home.menu.charts.action.show', '', 'background-blue', '', false, false, false, '')}"></t:block>
+</t:block>
+
+<t:block t:fragment="buttons">
+    <div class="row hide-on-small-only valign-wrapper">
+        <div class="col s6 right-align">
+            <t:block t:replace="~{::buttonNew}"></t:block>
+        </div>
+        <div class="col s6 left-align">
+            <t:block t:replace="~{::buttonShow}"></t:block>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up center-align">
+        <div class="row center-align">
+            <div class="row center-align">
+                <div class="col s12">
+                    <t:block t:replace="~{::buttonShow}"></t:block>
+                </div>
+            </div>
+            <div class="col s12">
+                <t:block t:replace="~{::buttonNew}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!-- iconForItem(item) is split by item type: ChartDisplayType and ChartGroupType share no view-safe supertype -->
+<t:block t:fragment="iconForDisplayType(ChartDisplayType item)">
+    <t:block t:if="chartsFn.hasFontAwesomeIcon(item)"><i t:class="|${item.getIcon()} left|"></i> [[${locale.getString(item.getLocalizationKey())}]]</t:block>
+    <t:block t:unless="chartsFn.hasFontAwesomeIcon(item)"><i class="material-icons left" t:text="item.getIcon()">icon</i> [[${locale.getString(item.getLocalizationKey())}]]</t:block>
+</t:block>
+
+<t:block t:fragment="iconForGroupType(ChartGroupType item)">
+    <t:block t:if="chartsFn.hasFontAwesomeIcon(item)"><i t:class="|${item.getIcon()} left|"></i> [[${locale.getString(item.getLocalizationKey())}]]</t:block>
+    <t:block t:unless="chartsFn.hasFontAwesomeIcon(item)"><i class="material-icons left" t:text="item.getIcon()">icon</i> [[${locale.getString(item.getLocalizationKey())}]]</t:block>
+</t:block>
+
+</div>
