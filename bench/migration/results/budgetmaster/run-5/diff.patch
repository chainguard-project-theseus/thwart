+package de.deadlocker8.budgetmaster.tessera;
+
+import de.deadlocker8.budgetmaster.charts.Chart;
+import de.deadlocker8.budgetmaster.charts.ChartDisplayType;
+import de.deadlocker8.budgetmaster.charts.ChartGroupType;
+import de.deadlocker8.budgetmaster.charts.ChartType;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Functions for charts/*.html.
+ */
+@TemplateFunctions("chartsFn")
+public final class ChartsFunctions
+{
+	private ChartsFunctions()
+	{
+	}
+
+	/**
+	 * chartFunctions.getChartName(chart)
+	 */
+	@TemplateFunction
+	public static String chartName(Chart chart)
+	{
+		if(chart == null || chart.getName() == null)
+		{
+			return "";
+		}
+		if(chart.getType() == ChartType.DEFAULT)
+		{
+			return Localization.getString(chart.getName());
+		}
+		return chart.getName();
+	}
+
+	/**
+	 * The chart's script with transaction data and container id filled in (formerly done with ?replace in charts.ftl).
+	 */
+	@TemplateFunction
+	public static String chartScript(Chart chart, String transactionData, String containerID)
+	{
+		String script = chart.getScript();
+		script = script.replace("var transactionData = [];", "var transactionData = " + transactionData + ";");
+		script = script.replace("containerID", containerID);
+		return script;
+	}
+
+	/**
+	 * {@code chart.getPreviewImageFileName()!"placeholder.png"}
+	 */
+	@TemplateFunction
+	public static String previewImageFileName(Chart chart)
+	{
+		final String fileName = chart.getPreviewImageFileName();
+		return fileName == null ? "placeholder.png" : fileName;
+	}
+
+	/**
+	 * {@code item.hasFontAwesomeIcon()}
+	 */
+	@TemplateFunction
+	public static boolean hasFontAwesomeIcon(ChartDisplayType item)
+	{
+		return item.hasFontAwesomeIcon();
+	}
+
+	/**
+	 * {@code item.hasFontAwesomeIcon()}
+	 */
+	@TemplateFunction
+	public static boolean hasFontAwesomeIcon(ChartGroupType item)
+	{
+		return item.hasFontAwesomeIcon();
+	}
+}
