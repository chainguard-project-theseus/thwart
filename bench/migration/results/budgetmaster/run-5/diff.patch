index 00000000..f6c0caa3
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/charts/charts.html
@@ -0,0 +1,227 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.charts.*"
+      t:params="Settings settings, List<Notification> notifications, ChartSettings chartSettings, List<Chart> charts, ChartDisplayType[] displayTypes, ChartGroupType[] groupTypes, Chart chart, String containerID, String transactionData, String dateRange, List<String> localizedMonthNames, List<String> localizedWeekdays">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.charts'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/search.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('charts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">show_chart</i> [[${locale.getString('title.charts')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                    <section t:remove="tag">
+                    <div class="row">
+                        <div class="col s12 center-align">
+                            <t:block t:replace="~{helpers/header :: buttonLink('', 'edit', 'chart.button.settings', 'buttonShowChartSettings', 'background-blue', 'hidden', false, true, false, '')}"></t:block>
+                        </div>
+                    </div>
+
+                    <form name="NewChartSettings" t:action="@{/charts}" method="post" t:class="chartSettings.isChartSelected() ? 'hidden' : ''">
+                        <div class="container">
+                            <div class="row">
+                                <div class="col s12 center-align">
+                                    <t:block t:each="displayType : displayTypes">
+                                        <t:block t:replace="~{::chartTypeButtonDisplay(displayType, 'button-display-type', chartSettings.getDisplayType())}"></t:block>
+                                    </t:block>
+                                </div>
+                            </div>
+                        </div>
+                        <input type="hidden" name="displayType" t:value="chartSettings.getDisplayType()">
+
+                        <div class="container" id="chart-group-type-buttons">
+                            <div class="row">
+                                <div class="col s12 center-align">
+                                    <t:block t:each="groupType : groupTypes">
+                                        <t:block t:replace="~{::chartTypeButtonGroup(groupType, 'button-group-type', chartSettings.getGroupType())}"></t:block>
+                                    </t:block>
+                                </div>
+                            </div>
+                        </div>
+                        <input type="hidden" name="groupType" t:value="chartSettings.getGroupType()">
+
+                        <div class="container">
+                            <div class="row">
+                                <t:block t:each="c : charts">
+                                    <t:block t:replace="~{::chartPreview(c)}"></t:block>
+                                </t:block>
+                                <div class="col s12 center-align hidden" id="buttonCustomCharts">
+                                    <t:block t:replace="~{helpers/header :: buttonLink(@{/charts/manage}, 'edit', 'chart.button.manage', '', 'background-blue', '', false, false, false, '')}"></t:block>
+                                </div>
+                            </div>
+                        </div>
+                        <input type="hidden" name="chartID" t:value="chartSettings.getChartID() == null ? '' : '' + chartSettings.getChartID()">
+
+                        <t:block t:replace="~{::dateSelect(chartSettings)}"></t:block>
+
+                        <t:block t:replace="~{::filterOptions(chartSettings)}"></t:block>
+
+                        <input type="hidden" name="clickedAmountType" value="">
+                        <input type="hidden" name="clickedCategory" value="">
+
+                        <div class="row center-align">
+                            <div class="col s12">
+                                <button class="btn waves-effect waves-light background-blue" type="submit" name="buttonSave" disabled>
+                                    <i class="material-icons left">show_chart</i>[[${locale.getString('chart.show')}]]
+                                </button>
+                            </div>
+                        </div>
+                    </form>
+
+                    <br>
+
+                    <div t:class="!chartSettings.isChartSelected() ? 'hidden' : ''">
+                        <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.charts.click'), 'fas fa-info', @{/hotkeys})}"></t:block>
+                    </div>
+
+                    <div class="container-chart">
+                        <div t:if="containerID != null" t:id="containerID" class="chart-canvas"></div>
+                    </div>
+
+                    <div id="matchingTransactionsOverview"></div>
+                    </section>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></t:block>
+        <script>
+            filterActive = [[${locale.getString('filter.active')}]];
+            filterNotActive = [[${locale.getString('title.filter')}]];
+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts()}"></t:block>
+        <script t:src="@{/js/libs/plotly.min.js}"></script>
+        <script t:src="@{/js/libs/moment.min.js}"></script>
+        <script t:src="@{/js/charts.js}"></script>
+        <script t:src="@{/js/filter.js}"></script>
+
+        <!-- The chart script (JavaScript stored in the database) cannot be printed raw: it is passed as a JSON string and evaluated in global scope -->
+        <script t:if="chart != null && chart.getType() == 'DEFAULT'">
+            localizedLocale = [[${locale.getString('locale')}]];
+            localizedTitle = [[${locale.getString(chart.getName())}]];
+            localizedDateRange = [[${dateRange}]];
+            localizedCurrency = [[${settings.getCurrency()}]];
+            localizedData = JSON.parse([[${locale.getString(chart.getName() + '.localization')}]]);
+
+            (0, eval)([[${chartsFn.chartScript(chart, transactionData, containerID)}]]);
+        </script>
+        <script t:if="chart != null && chart.getType() != 'DEFAULT'">
+            localizedTitle = [[${chart.getName()}]];
+            localizedDateRange = [[${dateRange}]];
+
+            (0, eval)([[${chartsFn.chartScript(chart, transactionData, containerID)}]]);
+        </script>
+    </body>
+
+<!-- formerly macro chartTypeButton(item, buttonClass, initialItem), split by enum type -->
+<a t:fragment="chartTypeButtonDisplay(ChartDisplayType item, String buttonClass, ChartDisplayType initialItem)"
+   t:class="|waves-effect waves-light btn-large text-black ${buttonClass} ${item == initialItem ? 'active' : ''}|" t:data-value="item">
+    <t:block t:replace="~{charts/chartFunctions :: iconForDisplayType(item)}"></t:block>
+</a>
+
+<a t:fragment="chartTypeButtonGroup(ChartGroupType item, String buttonClass, ChartGroupType initialItem)"
+   t:class="|waves-effect waves-light btn-large text-black ${buttonClass} ${item == initialItem ? 'active' : ''}|" t:data-value="item">
+    <t:block t:replace="~{charts/chartFunctions :: iconForGroupType(item)}"></t:block>
+</a>
+
+<div t:fragment="chartPreview(Chart chart)" class="col s6 m4 l3 center-align chart-preview-column hidden" t:data-display-type="chart.getDisplayType()" t:data-group-type="chart.getGroupType()" t:data-id="chart.getID()">
+    <div class="card chart-preview">
+        <div class="card-image">
+            <img t:src="@{/images/charts/{file}(file=chartsFn.previewImageFileName(chart))}">
+        </div>
+        <div class="card-action bold valign-wrapper">
+            <span style="margin: auto" t:text="chartsFn.chartName(chart)">name</span>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="dateSelect(ChartSettings chartSettings)" class="container"
+     t:with="startDate=dateService.getLongDateString(chartSettings.getStartDate()), endDate=dateService.getLongDateString(chartSettings.getEndDate())">
+    <div class="row">
+        <div class="col s12">
+            <div class="card" id="chart-date-card">
+                <div class="card-content">
+                    <div class="row">
+                        <div class="input-field col s6 m6 l4 offset-l2">
+                            <input id="chart-datepicker" type="text" class="datepicker" name="startDate" t:value="startDate">
+                            <label for="chart-datepicker" t:text="locale.getString('chart.steps.second.label.start')">start</label>
+                        </div>
+
