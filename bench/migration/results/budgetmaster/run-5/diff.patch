+                            <div class="headline-small" t:text="locale.getString('charts.default')">default</div>
+                        </div>
+
+                        <table class="bordered">
+                            <thead>
+                                <tr>
+                                    <th t:text="locale.getString('chart.new.label.name')">name</th>
+                                    <th t:text="locale.getString('chart.display.type')">display type</th>
+                                    <th t:text="locale.getString('chart.group.type')">group type</th>
+                                    <th t:text="locale.getString('chart.actions')">actions</th>
+                                </tr>
+                            </thead>
+                            <tr t:each="chart : defaultCharts">
+                                <td t:text="chartsFn.chartName(chart)">name</td>
+                                <td><t:block t:replace="~{charts/chartFunctions :: iconForDisplayType(chart.getDisplayType())}"></t:block></td>
+                                <td><t:block t:replace="~{charts/chartFunctions :: iconForGroupType(chart.getGroupType())}"></t:block></td>
+                                <td>
