diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/globalDatePicker.html b/BudgetMasterServer/src/main/resources/templates/helpers/globalDatePicker.html
new file mode 100644
index 00000000..48a6db1e
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/globalDatePicker.html
@@ -0,0 +1,72 @@
+<div xmlns:t="https://tessera.dev"
+     t:import="de.deadlocker8.budgetmaster.settings.Settings">
+
+<!--  datePicker(fullDate, target): no defaults. FreeMarker read the model attribute currentDate (all callers pass it as fullDate)
+      and localizedMonthNames (now helpersFn.localizedMonthNames()). -->
+<t:block t:fragment="datePicker(LocalDate fullDate, String target)" t:with="currentDate=fullDate, localizedMonthNames=helpersFn.localizedMonthNames()">
+     <div class="container">
+         <div class="section center-align">
+             <a t:href="@{/previousMonth} + '?target=' + target" id="global-datepicker-previous-month" class="waves-effect text-default"><i class="material-icons icon-chevron">chevron_left</i></a>
+             <a href="#modalDate" class="waves-effect headline-date modal-trigger text-default datePicker-fixed-width" t:text="dateService.getDateStringWithMonthAndYear(fullDate)">date</a>
+             <a t:href="@{/nextMonth} + '?target=' + target" id="global-datepicker-next-month" class="waves-effect text-default"><i class="material-icons icon-chevron">chevron_right</i></a>
+             <a t:href="@{/today} + '?target=' + target" id="global-datepicker-today" class="waves-effect text-default"><i class="material-icons icon-today">event</i></a>
+         </div>
+     </div>
+    <!-- modal to select specific month and year -->
+    <div id="modalDate" class="modal modal-fixed-footer">
+        <div class="modal-content background-color">
+
+            <div id="global-datepicker-select-year">
+                <t:block t:replace="~{::datepickerGridYear(currentDate.getYear() - 7, currentDate.getYear())}"></t:block>
+            </div>
+
+            <div id="global-datepicker-select-month">
+                <h4 t:text="locale.getString('title.datepicker.month')">month</h4>
+                <t:block t:replace="~{::datepickerGrid(localizedMonthNames, localizedMonthNames[currentDate.getMonthValue() - 1])}"></t:block>
+            </div>
+        </div>
+        <div class="modal-footer background-color">
+            <t:block t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false, false, '')}"></t:block>
+            <t:block t:replace="~{helpers/header :: buttonLink(@{/setDate} + '?target=' + target, 'done', 'ok', 'buttonChooseDate', 'green', 'modal-action modal-close text-white', false, false, false, '')}"></t:block>
+        </div>
+    </div>
+
+    <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.globalDatePicker.hotkeys'), 'fas fa-info', @{/hotkeys})}"></t:block>
+</t:block>
+
+<!--  datepickerGridYear(startYear, currentYear): no defaults -->
+<t:block t:fragment="datepickerGridYear(int startYear, int currentYear)">
+    <h4 t:text="locale.getString('title.datepicker.year')">year</h4>
+
+    <div class="hidden" id="currentYear" t:text="currentYear">2020</div>
+
+    <div class="center-align">
+        <a class="waves-effect text-default global-datepicker-button" id="global-datepicker-previous"><i class="material-icons icon-chevron">chevron_left</i></a>
+        <a class="waves-effect text-default global-datepicker-button" id="global-datepicker-next"><i class="material-icons icon-chevron">chevron_right</i></a>
+    </div>
+
+    <t:block t:replace="~{::datepickerGrid(helpersFn.yearRange(startYear), '' + currentYear)}"></t:block>
+</t:block>
+
+<!--  datepickerGrid(items, currentItem): no defaults. Rows of 3 (FreeMarker opened <tr> at index 0,3,6,9 and closed at 2,5,8,11). -->
+<table t:fragment="datepickerGrid(List<String> items, String currentItem)" class="no-border-table global-datepicker-table">
+    <tr t:each="row : numbers.sequence(0, (items.size() + 2) / 3 - 1)">
+        <t:block t:each="col : numbers.sequence(0, 2)">
+            <td t:if="row * 3 + col < items.size()" t:class="|global-datepicker-item ${items[row * 3 + col] == currentItem ? 'global-datepicker-selected' : ''}|" t:text="items[row * 3 + col]">item</td>
+        </t:block>
+    </tr>
+</table>
+
+<!--  datePickerLocalization(localizedMonthNames, localizedWeekdays): no defaults; both (formerly model attributes) were added.
+      The arrays are now written as JSON ["a","b"] instead of ['a', 'b', ]. -->
+<script t:fragment="datePickerLocalization(List<String> localizedMonthNames, List<String> localizedWeekdays)">
+    monthNames = [[${localizedMonthNames}]];
+    monthNamesShort = [[${helpersFn.prefixes(localizedMonthNames, 3)}]];
+    weekDays = [[${localizedWeekdays}]];
+    weekDaysShort = [[${helpersFn.prefixes(localizedWeekdays, 2)}]];
+    weekDaysLetters = [[${helpersFn.prefixes(localizedWeekdays, 1)}]];
+    buttonCancel = [[${locale.getString('cancel')}]];
+    buttonClose = [[${locale.getString('ok')}]];
+</script>
+
+</div>
