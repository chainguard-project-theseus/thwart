+package de.deadlocker8.budgetmaster.tessera;
+
+import org.springframework.beans.BeansException;
+import org.springframework.context.ApplicationContext;
+import org.springframework.context.ApplicationContextAware;
+import org.springframework.stereotype.Component;
+
+/**
+ * Gives the static {@code @TemplateFunctions} classes access to the Spring beans that the
+ * FreeMarker templates used to receive as model attributes (helpers, dateService, ...).
+ */
+@Component
+public class TemplateBeans implements ApplicationContextAware
+{
+	private static ApplicationContext context;
+
+	@Override
+	public void setApplicationContext(ApplicationContext applicationContext) throws BeansException
+	{
+		setContext(applicationContext);
+	}
+
+	private static void setContext(ApplicationContext applicationContext)
+	{
+		context = applicationContext;
+	}
+
+	public static <T> T get(Class<T> type)
+	{
+		return context.getBean(type);
+	}
+}
