diff --git a/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html b/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html
new file mode 100644
index 00000000..5e364d95
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html
@@ -0,0 +1,115 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState, de.deadlocker8.budgetmaster.tessera.FormErrors"
+      t:params="Settings settings, List<Notification> notifications, Account account, AccountState[] availableAccountStates, List<String> fontawesomeIcons, LocalDate today, FormErrors formErrors, List<String> localizedMonthNames, List<String> localizedWeekdays">
+    <head t:with="title=account.getID() != null ? locale.getString('title.account.edit') : locale.getString('title.account.new')">
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('accounts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="account.getID() != null ? locale.getString('title.account.edit') : locale.getString('title.account.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                    <section t:remove="tag">
+                    <div class="container">
+                    <form name="NewAccount" t:action="@{/accounts/newAccount}" method="post">
+                        <input type="hidden" name="ID" t:value="account.getID() == null ? '' : '' + account.getID()">
+                        <input type="hidden" name="isSelected" t:value="account.isSelected() == null ? '' : '' + account.isSelected()">
+                        <input type="hidden" name="isDefault" t:value="account.isDefault() == null ? '' : '' + account.isDefault()">
+
+                        <!-- name -->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">edit</i>
+                                <input id="account-name" type="text" name="name" t:class="validation.cssClass(formErrors, 'name', '')" t:data-position="validation.position(formErrors, 'name')" t:data-delay="validation.delay(formErrors, 'name')" t:data-tooltip="validation.tooltip(formErrors, 'name')" t:value="strings.defaultString(account.getName(), '')">
+                                <label for="account-name" t:text="locale.getString('account.new.label.name')">name</label>
+                            </div>
+                        </div>
+
+                        <!-- description (FreeMarker wrote a second class attribute from the validation macro; browsers keep the first one) -->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">article</i>
+                                <textarea id="account-description" class="materialize-textarea" name="description" data-length="250" t:data-position="validation.position(formErrors, 'description')" t:data-delay="validation.delay(formErrors, 'description')" t:data-tooltip="validation.tooltip(formErrors, 'description')" t:text="strings.defaultString(account.getDescription(), '')"></textarea>
+                                <label class="input-label" for="account-description" t:text="locale.getString('transaction.new.label.description')">description</label>
+                            </div>
+                        </div>
+
+                        <!-- icon -->
+                        <t:block t:with="initialBackgroundClasses=account.getIconReference() != null && (account.getIconReference().isImageIcon() || account.getIconReference().isBuiltinIcon()) ? 'category-square' : 'category-square account-square-border'">
+                            <t:block t:replace="~{helpers/iconSelect :: iconSelect('account-icon', account, false, initialBackgroundClasses, 'category-square account-square-border', false, settings)}"></t:block>
+                        </t:block>
+
+                        <!-- font color -->
+                        <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(account, settings)}"></t:block>
+
+                        <!-- state -->
+                        <t:block t:replace="~{helpers/customSelectMacros :: customAccountStateSelect('account-state-select-wrapper', 'accountState', accountsFn.asList(availableAccountStates), account.getAccountState() != null ? account.getAccountState() : availableAccountStates[0], 'col s12 m12 l8 offset-l2', locale.getString('account.new.label.state'), 'account-state')}"></t:block>
+
+                        <!-- end date -->
+                        <t:block t:with="startDate=dateService.getLongDateString(account.getEndDate() != null ? account.getEndDate() : today), accountEndDate=account.getEndDate() != null ? dateService.getLongDateString(account.getEndDate()) : ''">
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">notifications</i>
+                                <input id="account-datepicker" type="text" class="datepicker" name="endDate" t:value="accountEndDate">
+                                <label class="input-label" for="account-datepicker" t:text="locale.getString('account.new.label.endDate')">endDate</label>
+                            </div>
+                        </div>
+
+                        <script>
+                            startDate = [[${startDate}]].split(".");
+                            startDate = new Date(startDate[2], startDate[1]-1, startDate[0]);
+                        </script>
+                        </t:block>
+
+                        <br>
+
+                        <!-- buttons -->
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <t:block t:replace="~{helpers/header :: buttonLink(@{/accounts}, 'clear', 'cancel', 'button-cancel-save-account', 'red', '', false, false, false, '')}"></t:block>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', false, '', '', '')}"></t:block>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonLink(@{/accounts}, 'clear', 'cancel', 'button-cancel-save-account', 'red', '', false, false, false, '')}"></t:block>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', false, '', '', '')}"></t:block>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+                    </section>
+                </t:block>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/iconSelect :: modalIconSelect('account-name', account, fontawesomeIcons)}"></t:block>
+
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></t:block>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts()}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/accounts.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
