+++ b/BudgetMasterServer/src/main/resources/templates/transactions/transactionsMacros.html
@@ -0,0 +1,166 @@
+<div xmlns:t="https://tessera.dev"
+     t:import="de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.settings.Settings">
+
+<!--  transactionType(transaction, size): no defaults -->
+<div t:fragment="transactionType(Transaction transaction, String size)" t:class="|col ${size} left-align transaction-row-transparent-child|">
+    <i t:if="transaction.isRepeating()" class="material-icons">repeat</i>
+    <i t:if="transaction.isTransfer()" class="material-icons tooltipped" data-position="bottom" t:data-tooltip="|${transaction.getAccount().getName()} ➔ ${transaction.getTransferAccount().getName()}|">swap_horiz</i>
+
+    <i t:if="!transaction.isRepeating() && !transaction.isTransfer()" class="material-icons invisible">repeat</i>
+</div>
+
+<!--  transactionCategory(transaction, alignment, settings): settings appended (needed by categoryCircle) -->
+<div t:fragment="transactionCategory(Transaction transaction, String alignment, Settings settings)" t:class="|col s2 l1 xl1 ${alignment} transaction-row-transparent-child|">
+    <div class="hide-on-med-and-down">
+        <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(transaction.getCategory(), '', false, true, settings)}"></t:block>
+    </div>
+    <div class="hide-on-large-only">
+        <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(transaction.getCategory(), 'category-circle-small', false, true, settings)}"></t:block>
+    </div>
+</div>
+
+<!--  transactionNameAndDescription(transaction, size): no defaults -->
+<div t:fragment="transactionNameAndDescription(Transaction transaction, String size)" t:class="|col ${size} transaction-row-transparent-child|">
+    <div class="truncate transaction-text" t:text="transaction.getName()">name</div>
+    <div class="hide-on-med-and-down">
+        <div t:if="transaction.getDescription() != null" class="italic" t:text="transaction.getDescription()">description</div>
+    </div>
+</div>
+
+<!--  transactionAmount(transaction, account, size): no defaults -->
+<t:block t:fragment="transactionAmount(Transaction transaction, Account account, String size)">
+    <t:block t:with="amount=helpers.getAmount(transaction, account)">
+        <div t:if="amount <= 0" t:class="|col ${size} bold ${helpers.redTextColor()} no-wrap right-align transaction-text transaction-row-transparent-child|" t:text="currencyService.getCurrencyString(amount)">amount</div>
+        <div t:unless="amount <= 0" t:class="|col ${size} bold ${helpers.greenTextColor()} no-wrap right-align transaction-text transaction-row-transparent-child|" t:text="currencyService.getCurrencyString(amount)">amount</div>
+    </t:block>
+</t:block>
+
+<!--  transactionButtons(transaction, classes): no defaults -->
+<div t:fragment="transactionButtons(Transaction transaction, String classes)" t:class="|col ${classes} transaction-buttons no-wrap|">
+    <t:block t:if="transaction.isEditable()">
+        <t:block t:replace="~{::transactionEditButton(transaction)}"></t:block>
+        <t:block t:replace="~{helpers/header :: buttonFlat(@{/transactions/{id}/requestDelete(id=transaction.getID())}, 'delete', '', '', 'no-padding text-default button-request-delete-transaction', true, false, '', '', '')}"></t:block>
+    </t:block>
+    <t:block t:if="transaction.isAllowedToFillNewTransaction()">
+        <t:block t:replace="~{helpers/header :: buttonFlat(@{/transactions/{id}/newFromExisting(id=transaction.getID())}, 'content_copy', '', '', 'no-padding text-default button-new-from-existing', false, false, '', '', '')}"></t:block>
+    </t:block>
+</div>
+
+<!--  transactionEditButton(transaction): no defaults -->
+<t:block t:fragment="transactionEditButton(Transaction transaction)">
+    <div t:if="transaction.isRepeating()" class="fixed-action-btn edit-transaction-button">
+        <a class="btn-floating btn-flat waves-effect waves-light no-padding text-default edit-transaction-button-link">
+            <i class="material-icons">edit</i>
+        </a>
+        <ul class="new-transaction-button-list">
+            <li>
+                <a t:href="@{/transactions/{id}/edit(id=transaction.getID())}" class="btn-floating btn mobile-fab-tip no-wrap button-edit-all-occurrences" t:text="locale.getString('title.transaction.edit', locale.getString('title.transaction.new.normal'))">edit</a>
+                <a t:href="@{/transactions/{id}/edit(id=transaction.getID())}" class="btn-floating btn background-green-dark"><i class="material-icons">edit</i></a>
+            </li>
+            <li>
+                <a t:href="@{/transactions/{id}/editFutureRepetitions(id=transaction.getID())}" class="btn-floating btn mobile-fab-tip no-wrap button-edit-future-occurrences" t:text="locale.getString('repeating.button.edit.future')">future</a>
+                <a t:href="@{/transactions/{id}/editFutureRepetitions(id=transaction.getID())}" class="btn-floating btn background-orange"><i class="material-icons">move_up</i></a>
+            </li>
+        </ul>
+    </div>
+    <t:block t:unless="transaction.isRepeating()">
+        <t:block t:replace="~{helpers/header :: buttonFlat(@{/transactions/{id}/edit(id=transaction.getID())}, 'edit', '', '', 'no-padding text-default button-edit', false, false, '', '', '')}"></t:block>
+    </t:block>
+</t:block>
+
+<!--  transactionAccountIcon(transaction): no defaults -->
