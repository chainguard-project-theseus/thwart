+package de.deadlocker8.budgetmaster.tessera;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Replacements for the FreeMarker built-ins the old templates used.
+ */
+@TemplateFunctions("fm")
+public final class FreemarkerBuiltinFunctions
+{
+	private FreemarkerBuiltinFunctions()
+	{
+	}
+
+	/**
+	 * {@code value?capitalize[0]}
+	 */
+	@TemplateFunction
+	public static String firstLetterCapitalized(String value)
+	{
+		if(value == null || value.isEmpty())
+		{
+			return "";
+		}
+		return value.substring(0, 1).toUpperCase();
+	}
+
+	/**
+	 * {@code value?js_string}
+	 */
+	@TemplateFunction
+	public static String jsString(String value)
+	{
+		if(value == null)
+		{
+			return "";
+		}
+		return value.replace("\\", "\\\\").replace("'", "\\'").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r");
+	}
+}
