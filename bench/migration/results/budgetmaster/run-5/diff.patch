+ */
+@TemplateFunctions("helpersFn")
+public final class HelpersFragmentFunctions
+{
+	private HelpersFragmentFunctions()
+	{
+	}
+
+	/**
+	 * {@code item.getFontColor(isDarkTheme)}
+	 */
+	@TemplateFunction
+	public static String fontColor(Iconizable item, boolean isDarkTheme)
+	{
+		return item == null ? null : item.getFontColor(isDarkTheme);
+	}
+
+	/**
+	 * {@code item.getDefaultFontColor(isDarkTheme)}
+	 */
+	@TemplateFunction
+	public static String defaultFontColor(Iconizable item, boolean isDarkTheme)
+	{
+		return item == null ? null : item.getDefaultFontColor(isDarkTheme);
+	}
+
+	/**
+	 * {@code item.getName()} for the Iconizable entities that have a name.
+	 */
+	@TemplateFunction
+	public static String name(Iconizable item)
+	{
+		if(item instanceof Account account)
+		{
+			return account.getName();
+		}
+		if(item instanceof Category category)
+		{
+			return category.getName();
+		}
+		if(item instanceof Template template)
+		{
+			return template.getName();
+		}
+		return null;
+	}
+
+	/**
+	 * {@code item.getColor()} for the Iconizable entities that have a color (categories).
+	 */
+	@TemplateFunction
+	public static String color(Iconizable item)
+	{
+		if(item instanceof Category category)
+		{
+			return category.getColor();
+		}
+		return null;
+	}
+
+	@TemplateFunction
+	public static boolean needToShowBackupReminder(Settings settings)
+	{
+		return settings.needToShowBackupReminder();
+	}
+
+	@TemplateFunction
+	public static boolean needToShowWhatsNew(Settings settings)
+	{
+		return settings.needToShowWhatsNew();
+	}
+
+	/**
+	 * Years startYear..startYear+11 as strings (formerly built with ?c in globalDatePicker).
+	 */
+	@TemplateFunction
+	public static List<String> yearRange(int startYear)
+	{
+		final List<String> years = new ArrayList<>();
+		for(int i = startYear; i <= startYear + 11; i++)
+		{
+			years.add(String.valueOf(i));
+		}
+		return years;
+	}
+
+	/**
+	 * Each item cut to its first length characters (FreeMarker item[0..length-1] in datePickerLocalization).
+	 */
+	@TemplateFunction
+	public static List<String> prefixes(List<String> items, int length)
+	{
+		final List<String> result = new ArrayList<>();
+		if(items == null)
+		{
+			return result;
+		}
+		for(String item : items)
+		{
+			result.add(item.substring(0, Math.min(length, item.length())));
+		}
+		return result;
+	}
+
+	/**
+	 * {@code value.name()} (enums like AccountState override toString()).
+	 */
+	@TemplateFunction
+	public static String enumName(Enum<?> value)
+	{
+		return value == null ? null : value.name();
+	}
+
+	/**
+	 * Same as the model attribute "localizedMonthNames" (CalendarAdvice).
+	 */
+	@TemplateFunction
+	public static List<String> localizedMonthNames()
+	{
+		return MonthNames.getLocalizedStrings();
+	}
+
+	/**
+	 * Splits a localized text at its {@code <br>} tags (the only markup in e.g. "credits"), so that the template can
+	 * write the line breaks as real elements instead of printing the old raw ${...} output.
+	 */
+	@TemplateFunction
+	public static List<String> splitAtLineBreaks(String text)
+	{
+		if(text == null)
+		{
+			return new ArrayList<>();
+		}
+		return List.of(text.split("<br>", -1));
+	}
+}
