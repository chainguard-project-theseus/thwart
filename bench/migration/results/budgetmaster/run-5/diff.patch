diff --git a/BudgetMasterServer/src/main/resources/templates/about.html b/BudgetMasterServer/src/main/resources/templates/about.html
new file mode 100644
index 00000000..ecc5b866
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/about.html
@@ -0,0 +1,59 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.Build"
+      t:params="Settings settings, List<Notification> notifications, Build build">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.about'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('about', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="row">
+                    <div class="col s8 offset-s2 center-align">
+                        <t:block t:replace="~{helpers/header :: logo('logo-huge', 'responsive-img')}"></t:block>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                    <section t:remove="tag">
+                    <div class="hide-on-small-only"><br><br></div>
+                    <div class="row">
+                        <t:block t:replace="~{::cellKey(locale.getString('about.version'))}"></t:block>
+                        <div class="col s8 m5 l5">
+                            [[${build.getVersionName()}]] ([[${build.getVersionCode()}]])
+
+                            <a class="whatsNewLink" t:data-url="@{/about/whatsNewModal}">[[${locale.getString('about.version.whatsnew')}]]?</a>
+                            <div id="whatsNewModelContainerOnDemand"></div>
+                        </div>
+                    </div>
+                    <div class="row">
+                        <t:block t:replace="~{::cellKey(locale.getString('about.date'))}"></t:block>
+                        <div class="col s8 m5 l5" t:text="build.getVersionDate()">date</div>
+                    </div>
+                    <div class="row">
+                        <t:block t:replace="~{::cellKey(locale.getString('about.author'))}"></t:block>
+                        <div class="col s8 m5 l5" t:text="build.getAuthor()">author</div>
+                    </div>
+                    <div class="row">
+                        <t:block t:replace="~{::cellKey(locale.getString('about.sourcecode'))}"></t:block>
+                        <div class="col s8 m5 l5 break-all"><a target="_blank" t:href="locale.getString('github.url')" t:text="locale.getString('github.url')">url</a></div>
+                    </div>
+                    <div class="row">
+                        <t:block t:replace="~{::cellKey(locale.getString('about.credits'))}"></t:block>
+                        <!-- "credits" contains <br> tags (FreeMarker printed it raw): written as real <br> elements -->
+                        <div class="col s8 m5 l5"><t:block t:each="line, lineStat : helpersFn.splitAtLineBreaks(locale.getString('credits'))">[[${line}]]<br t:unless="lineStat.last"></t:block></div>
+                    </div>
+                    </section>
+                </t:block>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts()}"></t:block>
+        <script t:src="@{/js/about.js}"></script>
+
+        <!--  cellKey(key): no defaults -->
+        <div t:fragment="cellKey(String key)" class="col s4 m3 offset-m2 l2 offset-l3 bold" t:text="key">key</div>
+    </body>
+</html>
