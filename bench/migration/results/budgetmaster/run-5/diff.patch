+package de.deadlocker8.budgetmaster.tessera;
+
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Replaces helpers/validation.ftl: on an input write
+ * {@code t:class="validation.cssClass(formErrors, 'name', '')"}, {@code t:data-position="validation.position(formErrors, 'name')"},
+ * {@code t:data-delay="validation.delay(formErrors, 'name')"} and {@code t:data-tooltip="validation.tooltip(formErrors, 'name')"}.
+ */
+@TemplateFunctions("validation")
+public final class ValidationFunctions
+{
+	private ValidationFunctions()
+	{
+	}
+
+	@TemplateFunction
+	public static boolean hasFieldErrors(FormErrors errors, String fieldName)
+	{
+		return errors != null && errors.getFieldErrorCodes().containsKey(fieldName);
+	}
+
+	@TemplateFunction
+	public static String cssClass(FormErrors errors, String fieldName, String classes)
+	{
+		final String extra = classes == null ? "" : classes;
+		return hasFieldErrors(errors, fieldName) ? "tooltipped invalid " + extra : "validate " + extra;
+	}
+
+	@TemplateFunction
+	public static String position(FormErrors errors, String fieldName)
+	{
+		return hasFieldErrors(errors, fieldName) ? "bottom" : null;
+	}
+
+	@TemplateFunction
+	public static String delay(FormErrors errors, String fieldName)
+	{
+		return hasFieldErrors(errors, fieldName) ? "50" : null;
+	}
+
+	@TemplateFunction
+	public static String tooltip(FormErrors errors, String fieldName)
+	{
+		return hasFieldErrors(errors, fieldName) ? Localization.getString(errors.getFieldErrorCodes().get(fieldName)) : null;
+	}
+}
