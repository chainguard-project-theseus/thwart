diff --git a/parity/tools/style_variants.py b/parity/tools/style_variants.py
new file mode 100644
index 00000000..493f4ff3
--- /dev/null
+++ b/parity/tools/style_variants.py
@@ -0,0 +1,88 @@
+"""Rewrites t:data-font-color / t:data-background-color (colors the old templates wrote into style="...")
+into literal style variants: one copy of the element per known color with a literal style attribute
+(Tessera forbids expressions in style attributes), plus a fallback copy that keeps the data-* attribute
+for arbitrary user colors (applied by applyDataColors() in main.js).
+
+Usage: python3 -I style_variants.py <template.html>...   (idempotent: rewritten fallbacks read a styleColorN variable)
+"""
+import re
+import sys
+
+FONT_COLORS = ['#FFFFFF', '#000000']
+BACKGROUND_COLORS = ['#eeeeee', '#888888', '#333333', '#fff177', '#ffcc00', '#ff9500', '#ff3b30', '#a90329', '#ff5197',
+                     '#9b59b6', '#5856d6', '#007afa', '#4f85d6', '#5ac8fa', '#abdb64', '#4cd964', '#2e7c2b',
+                     '#FFFFFF', '#FFFF00', '#FFEB3B', '#000000', '#EEEEEE']
+ATTR = re.compile(r'\s+t:data-(font|background)-color="([^"]*)"')
+START = re.compile(r'<([a-zA-Z][a-zA-Z0-9:]*)\b((?:[^>"]|"[^"]*")*)>', re.S)
+counter = [0]
+
+
+def element_end(text, tag, start):
+    """index after the end tag matching the start tag at `start`"""
+    depth = 0
+    pattern = re.compile(r'<(/?)' + re.escape(tag) + r'\b((?:[^>"]|"[^"]*")*)>', re.S)
+    for m in pattern.finditer(text, start):
+        if m.group(1):
+            depth -= 1
+        elif not m.group(2).rstrip().endswith('/'):
+            depth += 1
+        else:
+            if depth == 0:
+                return m.end()
+        if depth == 0:
+            return m.end()
+    raise ValueError('unclosed <%s> at %d' % (tag, start))
+
+
+def take(attrs, name):
+    m = re.search(r'\s+' + re.escape(name) + r'="([^"]*)"', attrs)
+    if not m:
+        return attrs, None
+    return attrs[:m.start()] + attrs[m.end():], m.group(1)
+
+
+def rewrite_one(text):
+    for m in START.finditer(text):
+        a = ATTR.search(m.group(2))
+        if not a or a.group(2).startswith('styleColor'):
+            continue
+        tag, attrs = m.group(1), m.group(2)
+        end = element_end(text, tag, m.start())
+        self_closing = attrs.rstrip().endswith('/')
+        body = '' if self_closing else text[m.end():end - len('</%s>' % tag)]
+        kind, expr = a.group(1), a.group(2)
+        attrs = attrs[:a.start()] + attrs[a.end():]
+        if self_closing:
+            attrs = attrs.rstrip()[:-1]
+        attrs, fragment = take(attrs, 't:fragment')
+        attrs, each = take(attrs, 't:each')
+        attrs, cond = take(attrs, 't:if')
+        attrs, uncond = take(attrs, 't:unless')
+        counter[0] += 1
+        var = 'styleColor%d' % counter[0]
+        prop = 'color' if kind == 'font' else 'background-color'
+        colors = FONT_COLORS if kind == 'font' else BACKGROUND_COLORS
+
+        def element(extra):
+            close = ' />' if self_closing else '>' + body + '</%s>' % tag
+            return '<%s%s %s%s' % (tag, attrs, extra, close)
+
+        known = ' || '.join("%s == '%s'" % (var, c) for c in colors)
+        parts = [element('t:if="%s == \'%s\'" style="%s: %s"' % (var, c, prop, c)) for c in colors]
+        parts.append(element('t:if="%s == null || %s == \'\'" style="%s: "' % (var, var, prop)))
+        parts.append(element('t:unless="%s == null || %s == \'\' || %s" t:data-%s-color="%s"' % (var, var, known, kind, var)))
+        outer = ''.join(' %s="%s"' % (n, v) for n, v in
+                        (('t:fragment', fragment), ('t:each', each), ('t:if', cond), ('t:unless', uncond)) if v is not None)
+        replacement = '<t:block%s t:with="%s=%s">%s</t:block>' % (outer, var, expr, '\n'.join(parts))
+        return text[:m.start()] + replacement + text[end:], True
+    return text, False
+
+
+for path in sys.argv[1:]:
+    text = open(path, encoding='utf-8').read()
+    counter[0] = len(re.findall(r'styleColor\d+=', text))
+    changed = True
+    while changed:
+        text, changed = rewrite_one(text)
+    open(path, 'w', encoding='utf-8').write(text)
+    print(path, counter[0])
