+package de.deadlocker8.budgetmaster.tessera;
+
+import jakarta.servlet.DispatcherType;
+import org.springframework.boot.web.servlet.FilterRegistrationBean;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.web.servlet.resource.ResourceUrlEncodingFilter;
+
+/**
+ * Spring Boot's FreeMarker auto-configuration registered a {@link ResourceUrlEncodingFilter}, which makes
+ * {@code response.encodeURL} add the webjar versions (/webjars/jquery/jquery.min.js -> /webjars/jquery/3.7.1/jquery.min.js).
+ * Tessera links go through encodeURL as well, so the filter is registered here now.
+ */
+@Configuration
+public class ResourceUrlConfiguration
+{
+	@Bean
+	public FilterRegistrationBean<ResourceUrlEncodingFilter> resourceUrlEncodingFilter()
+	{
+		final FilterRegistrationBean<ResourceUrlEncodingFilter> registration = new FilterRegistrationBean<>(new ResourceUrlEncodingFilter());
+		registration.setDispatcherTypes(DispatcherType.REQUEST, DispatcherType.FORWARD, DispatcherType.ERROR, DispatcherType.ASYNC);
+		return registration;
+	}
+}
diff --git a/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/tessera/RichTextFunctions.java b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/tessera/RichTextFunctions.java
new file mode 100644
index 00000000..0104dace
--- /dev/null
+++ b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/tessera/RichTextFunctions.java
@@ -0,0 +1,96 @@
+package de.deadlocker8.budgetmaster.tessera;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Some localized messages and notifications contain markup ({@code <br>} and links built by
+ * NotificationLinkBuilder), which FreeMarker printed raw, including the user data inside them.
+ * Tessera escapes text, so {@link #parts(String)} splits such a message into plain text, line breaks
+ * and links, and the fragment helpers/header :: richText renders them as elements with escaped text.
+ * Any other markup stays text and is escaped.
+ */
+@TemplateFunctions("richText")
+public final class RichTextFunctions
+{
+	private static final Pattern MARKUP = Pattern.compile(
+			"<br\\s*/?>|<a((?:\\s+(?:href|class|target)=\"[^\"]*\")+)\\s*>(.*?)</a>", Pattern.CASE_INSENSITIVE | Pattern.DOTALL);
+	private static final Pattern ATTRIBUTE = Pattern.compile("(href|class|target)=\"([^\"]*)\"", Pattern.CASE_INSENSITIVE);
+
+	public record MessagePart(String text, boolean lineBreak, String href, String cssClass, String target)
+	{
+		public boolean isLink()
+		{
+			return href != null;
+		}
+
+		public boolean isText()
+		{
+			return !lineBreak && href == null;
+		}
+	}
+
+	private RichTextFunctions()
+	{
+	}
+
+	@TemplateFunction
+	public static List<MessagePart> parts(String message)
+	{
+		final List<MessagePart> parts = new ArrayList<>();
+		if(message == null)
+		{
+			return parts;
+		}
+
+		final Matcher matcher = MARKUP.matcher(message);
+		int position = 0;
+		while(matcher.find())
+		{
+			addText(parts, message.substring(position, matcher.start()));
+			if(matcher.group(1) == null)
+			{
+				parts.add(new MessagePart(null, true, null, null, null));
+			}
+			else
+			{
+				String href = null;
+				String cssClass = null;
+				String target = null;
+				final Matcher attributes = ATTRIBUTE.matcher(matcher.group(1));
+				while(attributes.find())
+				{
+					final String value = unescape(attributes.group(2));
+					switch(attributes.group(1).toLowerCase())
+					{
+						case "href" -> href = value;
+						case "class" -> cssClass = value;
+						default -> target = value;
+					}
+				}
+				parts.add(new MessagePart(unescape(matcher.group(2)), false, href == null ? "" : href, cssClass, target));
+			}
+			position = matcher.end();
+		}
+		addText(parts, message.substring(position));
+		return parts;
+	}
+
+	private static void addText(List<MessagePart> parts, String text)
+	{
+		if(!text.isEmpty())
+		{
+			parts.add(new MessagePart(unescape(text), false, null, null, null));
+		}
+	}
+
+	private static String unescape(String text)
+	{
+		return text.replace("&nbsp;", " ").replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&#39;", "'").replace("&amp;", "&");
+	}
+}
