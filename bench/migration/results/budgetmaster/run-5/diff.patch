+<div xmlns:t="https://tessera.dev"
+     t:import="de.deadlocker8.budgetmaster.settings.Settings">
+
+<!--  error(code, settings, Fragment content): formerly the macro error(code) with <#nested>; settings (formerly the global) was added.
+      settings may be null on error pages, so the theme check is null-safe. -->
+<html t:fragment="error(String code, Settings settings, Fragment content)">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + code)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/login.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings != null && settings.isUseDarkTheme() ? 'dark'">
+        <main>
+            <div class="row valign-wrapper full-height">
+                <div class="col l4 offset-l4 m6 offset-m3 s10 offset-s1">
+                    <div class="card background-color">
+                        <div class="card-content">
+                            <div class="card-title">
+                                <div id="logo-container" class="center-align"><t:block t:replace="~{helpers/header :: logo('logo', '')}"></t:block></div>
+                            </div>
+                            <div class="row">
+                                <div class="col s12 center-align">
+                                    <t:block t:replace="content"></t:block>
+                                </div>
+                            </div>
+                            <div class="center-align">
+                                <t:block t:replace="~{helpers/header :: buttonLink(@{/}, 'home', 'errorpages.home', '', 'background-blue', '', false, false, false, '')}"></t:block>
+                            </div>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </main>
+    </body>
+</html>
+
+</div>
