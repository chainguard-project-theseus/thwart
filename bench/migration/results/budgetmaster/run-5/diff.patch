+
+// Colors computed on the server are rendered as data-* attributes (templates cannot write expressions into style attributes).
+function applyDataColors(root)
+{
+    $(root || document).find('[data-background-color]').each(function()
+    {
+        this.style.backgroundColor = this.dataset.backgroundColor;
+    });
+    $(root || document).find('[data-font-color]').each(function()
+    {
+        this.style.color = this.dataset.fontColor;
+    });
+}
