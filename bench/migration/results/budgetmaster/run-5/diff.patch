+package de.deadlocker8.budgetmaster.tessera;
+
+import de.deadlocker8.budgetmaster.services.DateService;
+import de.deadlocker8.budgetmaster.transactions.Transaction;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.context.i18n.LocaleContextHolder;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+
+@TemplateFunctions("transactionsFn")
+public final class TransactionsFunctions
+{
+	public record TransactionDateGroup(String date, List<Transaction> transactions)
+	{
+	}
+
+	private TransactionsFunctions()
+	{
+	}
+
+	/**
+	 * Groups consecutive transactions with the same (upper-cased) date string,
+	 * replacing the former FreeMarker "lastDate" bookkeeping in transactions.ftl.
+	 */
+	@TemplateFunction
+	public static List<TransactionDateGroup> groupByDate(List<Transaction> transactions)
+	{
+		final DateService dateService = TemplateBeans.get(DateService.class);
+		final List<TransactionDateGroup> groups = new ArrayList<>();
+		if(transactions == null)
+		{
+			return groups;
+		}
+
+		String lastDate = "";
+		List<Transaction> current = null;
+		for(Transaction transaction : transactions)
+		{
+			final String date = dateService.getDateStringWithMonthName(transaction.getDate()).toUpperCase(LocaleContextHolder.getLocale());
+			if(current == null || !date.equals(lastDate))
+			{
+				current = new ArrayList<>();
+				groups.add(new TransactionDateGroup(date, current));
+				lastDate = date;
+			}
+			current.add(transaction);
+		}
+		return groups;
+	}
+
+	@TemplateFunction
+	public static boolean shouldHighlight(Transaction transaction, Integer highlightID)
+	{
+		return highlightID != null && transaction.getID() != null && Objects.equals(transaction.getID(), highlightID);
+	}
+}
