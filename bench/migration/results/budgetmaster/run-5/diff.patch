+                                <i class="material-icons prefix">file_copy</i>
+                                <input id="template-group-name" type="text" name="name" t:class="validation.cssClass(formErrors, 'name', '')" t:data-position="validation.position(formErrors, 'name')" t:data-delay="validation.delay(formErrors, 'name')" t:data-tooltip="validation.tooltip(formErrors, 'name')" t:value="templateGroup.getName() ?: ''">
