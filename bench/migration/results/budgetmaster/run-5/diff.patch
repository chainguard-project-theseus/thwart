diff --git a/BudgetMasterServer/src/main/resources/templates/settings/containers/settingsContainer.html b/BudgetMasterServer/src/main/resources/templates/settings/containers/settingsContainer.html
new file mode 100644
index 00000000..d58cd360
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/settings/containers/settingsContainer.html
@@ -0,0 +1,23 @@
+<div xmlns:t="https://tessera.dev">
+
+<!-- settingsContainer(formName, containerId, importScripts, actionUrl, toastContent, content):
+     actionUrl is passed as a link (@{...}) by the caller; toastContent was formerly read from the model -->
+<t:block t:fragment="settingsContainer(String formName, String containerId, boolean importScripts, String actionUrl, String toastContent, Fragment content)">
+    <form t:name="formName" method="post" t:action="actionUrl">
+        <t:block t:replace="content"></t:block>
+    </form>
+
+    <div class="hidden securityContainerToastContent">
+        [[${toastContent}]]
+    </div>
+
+    <t:block t:if="importScripts">
+        <script t:src="@{/webjars/jquery/3.7.1/jquery.min.js}"></script>
+        <script t:src="@{/webjars/materializecss/1.0.0/js/materialize.min.js}"></script>
+        <script>
+            initSettingsContainer([[${formName}]], [[${containerId}]]);
+        </script>
+    </t:block>
+</t:block>
+
+</div>
