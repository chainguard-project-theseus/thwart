diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/customSelectMacros.html b/BudgetMasterServer/src/main/resources/templates/helpers/customSelectMacros.html
new file mode 100644
index 00000000..50cd5c12
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/customSelectMacros.html
@@ -0,0 +1,179 @@
+<div xmlns:t="https://tessera.dev"
+     t:import="de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState, de.deadlocker8.budgetmaster.icon.Iconizable">
+
+<!--  customSelectStart(selector, inputClasses, labelText, id, icon, disabled, rowClasses, Fragment content, Fragment end)
+      FreeMarker defaults: disabled=false, rowClasses=''.
+      FreeMarker split the markup into customSelectStart/customSelectEnd macros (open tags in one, close tags in the other);
+      here the whole wrapper is one fragment: content goes into .custom-select, end (the hidden input) after it.
+      The unused 'items' parameter was dropped. Internal to this file. -->
+<div t:fragment="customSelectStart(String selector, String inputClasses, String labelText, String id, String icon, boolean disabled, String rowClasses, Fragment content, Fragment end)"
+     t:class="|row ${rowClasses}|">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix" t:text="icon">icon</i>
+        <label t:if="!strings.isEmpty(labelText)" class="input-label" t:for="id" t:text="labelText">label</label>
+        <div t:class="|custom-select-wrapper ${selector} ${disabled ? 'disabled' : ''}|" t:id="id">
+            <div class="custom-select">
+                <t:block t:replace="content"></t:block>
+            </div>
+            <t:block t:replace="end"></t:block>
+        </div>
+    </div>
+</div>
+
+<!--  customSelectEnd(inputName, selectedItem, form); FreeMarker defaults: form=''. Now only the hidden input. -->
+<input t:fragment="customSelectEnd(String inputName, Iconizable selectedItem, String form)"
+       type="hidden" t:name="inputName" class="hidden-input-custom-select"
+       t:value="selectedItem != null ? '' + selectedItem.getID() : null"
+       t:form="strings.isEmpty(form) ? null : form"/>
+
+<!--  customCategorySelect(categories, selectedCategory, inputClasses, labelText, id, showName, rowClasses, disabled, form)
+      FreeMarker defaults: showName=true, rowClasses='', disabled=false, form='' -->
+<t:block t:fragment="customCategorySelect(List<Category> categories, Category selectedCategory, String inputClasses, String labelText, String id, boolean showName, String rowClasses, boolean disabled, String form)">
+    <t:block t:replace="~{::customSelectStart('category-select-wrapper', inputClasses, labelText, id, 'label', disabled, rowClasses, ~{::categorySelectContent(categories, selectedCategory, showName)}, ~{::customSelectEnd('category', selectedCategory, form)})}"></t:block>
+</t:block>
+
+<t:block t:fragment="categorySelectContent(List<Category> categories, Category selectedCategory, boolean showName)">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:if="selectedCategory != null"><t:block t:replace="~{::customSelectOptionCategoryContent(selectedCategory, 'no-margin-left', true, showName)}"></t:block></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="category : categories">
+                    <t:block t:if="category.getType() != 'REST'">
+                        <t:block t:replace="~{::customSelectCategoryOption(category, selectedCategory != null ? selectedCategory.getID() == category.getID() : category.getType() == 'NONE')}"></t:block>
+                    </t:block>
+                </t:block>
+            </div>
+</t:block>
+
+<!--  customAccountSelect(selector, inputName, accounts, selectedAccount, inputClasses, labelText, id, disabled)
+      FreeMarker defaults: disabled=false -->
+<t:block t:fragment="customAccountSelect(String selector, String inputName, List<Account> accounts, Account selectedAccount, String inputClasses, String labelText, String id, boolean disabled)">
+    <t:block t:replace="~{::customSelectStart(selector, inputClasses, labelText, id, 'account_balance', disabled, '', ~{::accountSelectContent(accounts, selectedAccount)}, ~{::customSelectEnd(inputName, selectedAccount, '')})}"></t:block>
+</t:block>
+
+<t:block t:fragment="accountSelectContent(List<Account> accounts, Account selectedAccount)">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:if="selectedAccount != null"><t:block t:replace="~{::customSelectOptionAccountContent(selectedAccount, 'no-margin-left', '')}"></t:block></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="account : accounts">
+                    <t:block t:if="account.getType() == 'CUSTOM'">
+                        <t:block t:replace="~{::customSelectAccountOption(account, selectedAccount != null && selectedAccount.getID() == account.getID())}"></t:block>
+                    </t:block>
+                </t:block>
+            </div>
+</t:block>
+
+<!--  globalAccountSelect(): no parameters -->
+<div t:fragment="globalAccountSelect()" class="input-field no-margin">
+    <div class="custom-select-wrapper global-account-select-wrapper">
+        <div class="custom-select">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:replace="~{::customSelectOptionAccountContent(helpers.getCurrentAccount(), 'no-margin-left', '')}"></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="account : helpers.getAllReadableAccounts()">
+                    <t:block t:replace="~{::customSelectAccountOption(account, account.isSelected())}"></t:block>
+                </t:block>
+            </div>
+        </div>
+
+        <input type="hidden" class="hidden-input-custom-select" t:value="helpers.getCurrentAccount().getID()"/>
+    </div>
+</div>
+
+<!--  customAccountStateSelect(selector, inputName, availableStates, selectedState, inputClasses, labelText, id): no defaults -->
+<t:block t:fragment="customAccountStateSelect(String selector, String inputName, List<AccountState> availableStates, AccountState selectedState, String inputClasses, String labelText, String id)">
+    <t:block t:replace="~{::customSelectStart(selector, inputClasses, labelText, id, 'visibility', false, '', ~{::accountStateSelectContent(availableStates, selectedState)}, ~{::accountStateSelectEnd(inputName, selectedState)})}"></t:block>
+</t:block>
+
+<t:block t:fragment="accountStateSelectContent(List<AccountState> availableStates, AccountState selectedState)">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:if="selectedState != null"><t:block t:replace="~{::customSelectOptionAccountStateContent(selectedState, 'no-margin-left')}"></t:block></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="state : availableStates">
+                    <t:block t:replace="~{::customSelectAccountStateOption(state, selectedState != null && selectedState == state)}"></t:block>
+                </t:block>
+            </div>
+</t:block>
+
+<input t:fragment="accountStateSelectEnd(String inputName, AccountState selectedState)" type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedState != null ? helpersFn.enumName(selectedState) : null"/>
+
+<!--  customSelectCategoryOption(category, isSelected): no defaults -->
+<div t:fragment="customSelectCategoryOption(Category category, boolean isSelected)"
+     t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="category.getID()">
+    <t:block t:replace="~{::customSelectOptionCategoryContent(category, '', false, true)}"></t:block>
+</div>
+
+<!--  customSelectOptionCategoryContent(category, classes, datasetValue, showName)
+      FreeMarker defaults: classes='', datasetValue=false, showName=true -->
+<t:block t:fragment="customSelectOptionCategoryContent(Category category, String classes, boolean datasetValue, boolean showName)">
+    <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(category, 'category-circle-small ' + classes, datasetValue, false, helpers.getSettings())}"></t:block>
+    <span t:if="showName" class="custom-select-item-name" t:text="categoriesFn.getCategoryName(category)">name</span>
+</t:block>
+
+<!--  customSelectAccountOption(account, isSelected): no defaults -->
+<div t:fragment="customSelectAccountOption(Account account, boolean isSelected)"
+     t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="account.getID()">
+    <t:block t:replace="~{::customSelectOptionAccountContent(account, '', '')}"></t:block>
+</div>
+
+<!--  customSelectOptionAccountContent(account, classes, datasetValue); FreeMarker defaults: classes='', datasetValue='' -->
+<t:block t:fragment="customSelectOptionAccountContent(Account account, String classes, String datasetValue)">
+    <t:block t:with="accountName=account.getType() == 'ALL' ? locale.getString('account.all') : account.getName()">
+        <!-- the FreeMarker call mixed positional and named arguments, and rendered data-value -->
+        <t:block t:replace="~{::accountIcon(account, accountName, 'category-circle-small ' + classes, 'true')}"></t:block>
+        <span class="custom-select-item-name" t:text="accountName">name</span>
+    </t:block>
+</t:block>
+
+<!--  accountIcon(account, accountName, classes, datasetValue); FreeMarker defaults: classes='', datasetValue=''
+      Reads the theme via helpers.getSettings() (formerly the global 'settings').
+      style="color: ..." cannot be computed in Tessera: the font color is written to data-font-color instead. -->
+<div t:fragment="accountIcon(Account account, String accountName, String classes, String datasetValue)"
+     t:class="|category-circle ${classes} category-square ${account.getIconReference() != null && account.getIconReference().isFallbackIcon() ? 'account-square-border' : ''}|"
+     t:data-value="strings.isEmpty(datasetValue) ? null : '' + account.getID()">
+    <t:block t:with="styleColor1=helpersFn.fontColor(account, helpers.getSettings().isUseDarkTheme())"><span t:if="styleColor1 == '#FFFFFF'" style="color: #FFFFFF">
+        <t:block t:replace="~{helpers/header :: entityIcon(account, 'account-select-icon', accountName)}"></t:block>
+    </span>
+<span t:if="styleColor1 == '#000000'" style="color: #000000">
+        <t:block t:replace="~{helpers/header :: entityIcon(account, 'account-select-icon', accountName)}"></t:block>
+    </span>
+<span t:if="styleColor1 == null || styleColor1 == ''" style="color: ">
+        <t:block t:replace="~{helpers/header :: entityIcon(account, 'account-select-icon', accountName)}"></t:block>
+    </span>
+<span t:unless="styleColor1 == null || styleColor1 == '' || styleColor1 == '#FFFFFF' || styleColor1 == '#000000'" t:data-font-color="styleColor1">
+        <t:block t:replace="~{helpers/header :: entityIcon(account, 'account-select-icon', accountName)}"></t:block>
+    </span></t:block>
+</div>
+
+<!--  customSelectAccountStateOption(state, isSelected): no defaults -->
+<div t:fragment="customSelectAccountStateOption(AccountState state, boolean isSelected)"
+     t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="helpersFn.enumName(state)">
