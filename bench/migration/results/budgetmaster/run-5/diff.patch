diff --git a/BudgetMasterServer/src/test/java/de/deadlocker8/budgetmaster/unit/RichTextFunctionsTest.java b/BudgetMasterServer/src/test/java/de/deadlocker8/budgetmaster/unit/RichTextFunctionsTest.java
