--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionTransfer.html
@@ -0,0 +1,81 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.tessera.FormErrors"
+      t:params="Settings settings, List<Notification> notifications, boolean isEdit, boolean changeTypeInProgress, LocalDate currentDate, List<Category> categories, List<Account> accounts, Transaction transaction, String suggestionsJSON, FormErrors formErrors, List<String> localizedMonthNames, List<String> localizedWeekdays">
+    <head t:with="title=isEdit ? locale.getString('title.transaction.edit', locale.getString('title.transaction.new.transfer')) : locale.getString('title.transaction.new', locale.getString('title.transaction.new.transfer'))">
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('transactions', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="isEdit ? locale.getString('title.transaction.edit', locale.getString('title.transaction.new.transfer')) : locale.getString('title.transaction.new', locale.getString('title.transaction.new.transfer'))">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::mainContent(isEdit, changeTypeInProgress, currentDate, categories, accounts, transaction, suggestionsJSON, formErrors)})}">
+                    <div class="container" t:fragment="mainContent(boolean isEdit, boolean changeTypeInProgress, LocalDate currentDate, List<Category> categories, List<Account> accounts, Transaction transaction, String suggestionsJSON, FormErrors formErrors)">
+                        <form id="mainForm" name="NewTransaction" t:action="@{/transactions/newTransaction}" method="post">
+                            <!-- only set ID for transactions not templates, otherwise the input is filled with the template ID and saving the transaction
+                            may then override an existing transactions if the ID is also already used in transactions table -->
+                            <input type="hidden" name="ID" t:value="transaction.getID() != null ? '' + transaction.getID() : ''">
+                            <input type="hidden" name="isExpenditure" value="true">
+                            <input type="hidden" name="isRepeating" t:value="transaction.isRepeating()">
+
+
+                            <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.transaction.save'), 'fas fa-info', '')}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(transaction, suggestionsJSON, formErrors)}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(transaction, formErrors)}"></t:block>
+
+                            <t:block t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, transaction.getCategory(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.category'), 'transaction-category', true, '', false, '')}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionStartDate(transaction, currentDate)}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionDescription(transaction, formErrors)}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(transaction)}"></t:block>
+
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('account-select-wrapper', 'account', accounts, transaction.getAccount() != null ? transaction.getAccount() : helpers.getCurrentAccountOrDefault(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.account'), 'transaction-account', false)}"></t:block>
+
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, transaction.getTransferAccount() != null ? transaction.getTransferAccount() : helpers.getCurrentAccountOrDefault(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.transfer.account'), 'transaction-destination-account', false)}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionRepeating(transaction, currentDate, formErrors)}"></t:block>
+
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttons(@{/transactions}, true, false)}"></t:block>
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttonTransactionActions(isEdit, true, changeTypeInProgress, transaction)}"></t:block>
+                        </form>
+
+                        <div id="saveAsTemplateModalContainer"></div>
+
+                        <div id="changeTransactionTypeModalContainer"></div>
+
+                        <div id="transactionNameKeywordWarningModalContainer"></div>
+                    </div>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></t:block>
+
+        <script>
+            createTemplateWithErrorInForm = [[${locale.getString('save.as.template.errorsInForm')}]];
+            templateNameEmptyValidationMessage = [[${locale.getString('warning.empty.transaction.name')}]];
+            templateNameDuplicateValidationMessage = [[${locale.getString('warning.duplicate.template.name')}]];
+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts()}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/transactionActions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+    </body>
+</html>
