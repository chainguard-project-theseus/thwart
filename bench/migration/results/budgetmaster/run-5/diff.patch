+++ b/BudgetMasterServer/src/main/resources/templates/categories/categories.html
@@ -0,0 +1,68 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.categories.Category"
+      t:params="Settings settings, List<Notification> notifications, List<Category> categories, Category preselectedCategory">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.categories'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/customSelect.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('categories', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">label</i> [[${locale.getString('menu.categories')}]]
+                        </div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                    <section t:remove="tag">
+                    <br>
+                    <div class="center-align"><t:block t:replace="~{helpers/header :: buttonLink(@{/categories/newCategory}, 'add', 'title.category.new', '', 'background-blue', '', false, false, false, '')}"></t:block></div>
+                    <br>
+
+                    <div class="container">
+                    <table class="bordered">
+                        <thead>
+                            <tr>
+                                <th></th>
+                                <th t:text="locale.getString('category.new.label.name')">name</th>
+                                <th t:text="locale.getString('categories.usages')">usages</th>
+                                <th t:text="locale.getString('categories.actions')">actions</th>
+                            </tr>
+                        </thead>
+                        <tr t:each="category : categories" t:with="categoryName=categoriesFn.getCategoryName(category), usageCount=helpers.getUsageCountForCategory(category)">
+                            <td><t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(category, '', false, true, settings)}"></t:block></td>
+                            <td>[[${categoryName}]] </td>
+                            <td><a t:href="request.contextPath() + '/search?searchCategory=true&searchText=' + categoryName" class="waves-effect waves-light text-default" t:text="usageCount">0</a></td>
+                            <td>
+                                <t:block t:replace="~{helpers/header :: buttonFlat(@{/categories/{id}/edit(id=category.getID())}, 'edit', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                                <t:block t:replace="~{helpers/header :: buttonFlat(request.contextPath() + '/search?searchCategory=true&searchText=' + categoryName, 'search', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                                <t:block t:if="category.getType() == 'CUSTOM'">
+                                    <t:block t:replace="~{helpers/header :: buttonFlat(@{/categories/{id}/requestDelete(id=category.getID())}, 'delete', '', '', 'no-padding text-default button-request-delete-category', true, false, '', '', '')}"></t:block>
+                                </t:block>
+                            </td>
+                        </tr>
+                    </table>
+                    <div t:if="categories.isEmpty()" class="headline center-align" t:text="locale.getString('placeholder')">placeholder</div>
+                </div>
+                    </section>
+                </t:block>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+        <!--  Scripts-->
+        <script t:if="preselectedCategory != null">
+            selectedCategory = [[${'' + preselectedCategory.getID()}]];
+        </script>
+        <script t:unless="preselectedCategory != null">
+        </script>
+
+        <t:block t:replace="~{helpers/scripts :: scripts()}"></t:block>
+        <script t:src="@{/js/categories.js}"></script>
+    </body>
+</html>
