--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/hotkeys.html
@@ -0,0 +1,63 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.hotkeys.*"
+      t:params="Settings settings, List<Notification> notifications, GeneralHotKey[] hotkeysGeneral, GlobalDatePickerHotKey[] hotkeysGlobalDatePicker, GlobalAccountSelectHotKey[] hotkeysAccountSelect, ChartHotkeys[] hotkeysCharts">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.hotkeys'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('hotkeys', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">keyboard</i> [[${locale.getString('menu.hotkeys')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::section})}">
+                    <section t:remove="tag">
+                    <br>
+
+                    <t:block t:replace="~{::listHotKeys(locale.getString('hotkeys.general'), hotkeysGeneral)}"></t:block>
+
+                    <t:block t:replace="~{::listHotKeys(locale.getString('hotkeys.global.datepicker'), hotkeysGlobalDatePicker)}"></t:block>
+
+                    <t:block t:replace="~{::listHotKeys(locale.getString('hotkeys.global.account.select'), hotkeysAccountSelect)}"></t:block>
+
+                    <t:block t:replace="~{::listHotKeys(locale.getString('hotkeys.charts'), hotkeysCharts)}"></t:block>
+                    </section>
+                </t:block>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts()}"></t:block>
+
+        <!--  cellKey(key): no defaults (unused) -->
+        <div t:fragment="cellKey(String key)" class="col s4 m3 offset-m2 l2 offset-l3 right-align bold">
+            <div class="keyboard-key" t:text="key">key</div>
+        </div>
+
+        <!--  cellKeyWithModifier(modifier, key): no defaults (modifier may be null) -->
+        <div t:fragment="cellKeyWithModifier(String modifier, String key)" class="col s4 m3 offset-m2 l2 offset-l3 right-align bold">
+            <t:block t:if="!strings.isEmpty(modifier)">
+                <div class="keyboard-key modifier-key" t:text="modifier">modifier</div>
+                <span class="bold">+</span>
+            </t:block>
+            <div class="keyboard-key" t:text="key">key</div>
+        </div>
+
+        <!--  listHotKeys(headline, hotKeys): no defaults -->
+        <t:block t:fragment="listHotKeys(String headline, HotKey[] hotKeys)">
+            <div class="row">
+                <div class="col s12 headline center-align" t:text="headline">headline</div>
+            </div>
+
+            <div t:each="hotKey : hotKeys" class="row">
+                <t:block t:replace="~{::cellKeyWithModifier(hotKey.getModifierLocalized(), hotKey.getKeyLocalized())}"></t:block>
+                <div class="col s8 m5 l5" t:text="hotKey.getTextLocalized()">text</div>
+            </div>
+        </t:block>
+    </body>
+</html>
