diff --git a/parity/compare.sh b/parity/compare.sh
new file mode 100755
index 00000000..ac3ea56a
--- /dev/null
+++ b/parity/compare.sh
@@ -0,0 +1,13 @@
+#!/bin/bash
+# Builds the migrated app in a scratch copy, starts it on :9001 against a fresh "neu" database and runs
+# tessera-migrate compare against parity/baseline (recorded from the original FreeMarker app on :9000).
+set -e
+MIGRATE=~/.m2/repository/dev/tessera/tessera-migrate/0.1.0-SNAPSHOT/tessera-migrate-0.1.0-SNAPSHOT.jar
+rm -rf /tmp/neu && mkdir -p /tmp/neu && (cd /work/app && tar cf - --exclude=target --exclude=build --exclude=.git .) | (cd /tmp/neu && tar xf -)
+(cd /tmp/neu && mvn -B -o -q package -DskipTests) 
+[ -f /tmp/neu.pid ] && kill "$(cat /tmp/neu.pid)" 2>/dev/null && sleep 3 || true
+psql -h /tmp/pg -U postgres -qc "drop database if exists neu" -c "create database neu owner budgetmaster"
+nohup java -jar /tmp/neu/BudgetMasterServer/build/2.18.2/BudgetMasterServer-v2.18.2.jar --budgetmaster.database.databaseName=neu --server.port=9001 > /tmp/neu-run.log 2>&1 &
+echo $! > /tmp/neu.pid
+for i in $(seq 90); do curl -s -o /dev/null localhost:9001/login && break; sleep 2; done
+cd /work/app/parity && java -jar $MIGRATE compare http://localhost:9001 pages.txt baseline/ "$@"
