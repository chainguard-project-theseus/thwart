+            <button t:replace="~{::buttonSave(allowEmptyAmount)}"></button>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up">
+        <div class="row center-align">
+            <div class="col s12">
+                <a t:replace="~{::buttonCancel(url)}"></a>
+            </div>
+        </div>
+        <t:block t:if="includeContinueButton">
+            <div class="row center-align">
+                <div class="col s12">
+                    <button t:replace="~{::buttonSaveAndContinue}"></button>
+                </div>
+            </div>
+        </t:block>
+        <div class="row center-align">
+            <div class="col s12">
+                <button t:replace="~{::buttonSave(allowEmptyAmount)}"></button>
+            </div>
+        </div>
+    </div>
+    </t:block>
+</t:block>
+
+<t:block t:fragment="buttonCancel(String url)">
+    <a t:replace="~{helpers/header :: buttonLink(url, 'clear', 'cancel', 'button-cancel-save-transaction', 'red', '', false, false)}"></a>
+</t:block>
+
+<!--/* onclick takes no data: one static button per value of allowEmptyAmount */-->
+<t:block t:fragment="buttonSave(boolean allowEmptyAmount)">
+    <button t:if="!allowEmptyAmount" id="button-save-transaction" class="btn waves-effect waves-light green " type="submit" name="action" onclick="return validateForm(false, false, false)">
+        <i class="material-icons left ">save</i><t:block t:text="loc.get('save')">Save</t:block>
+    </button>
+    <button t:if="allowEmptyAmount" id="button-save-transaction" class="btn waves-effect waves-light green " type="submit" name="action" onclick="return validateForm(false, true, false)">
+        <i class="material-icons left ">save</i><t:block t:text="loc.get('save')">Save</t:block>
+    </button>
+</t:block>
+
+<button t:fragment="buttonSaveAndContinue" id="button-save-transaction-and-continue" class="btn waves-effect waves-light background-blue " type="submit" name="action" value="continue" onclick="return validateForm(true, false, false)">
+    <i class="material-icons left ">save</i><t:block t:text="loc.get('saveAndContinue')">Save &amp; New</t:block>
+</button>
+
+<t:block t:fragment="buttonTransactionActions(boolean canChangeType, boolean canCreateTemplate, boolean changeTypeInProgress, Integer transactionID)">
+    <div t:if="(canChangeType or canCreateTemplate) and !changeTypeInProgress" class="fixed-action-btn" id="transaction-actions-button">
+        <a class="btn-floating btn-large waves-effect waves-light background-blue">
+            <i class="material-icons left">settings</i><t:block t:text="loc.get('save')">Save</t:block>
+        </a>
+        <ul>
+            <li t:if="canChangeType">
+                <a class="btn-floating btn transaction-action mobile-fab-tip no-wrap" data-action-type="changeType" t:data-url="@{/transactions/{id}/changeTypeModal(id=${transactionID})}" t:text="loc.get('transaction.change.type')">Change type</a>
+                <a class="btn-floating btn transaction-action background-blue-baby" data-action-type="changeType" t:data-url="@{/transactions/{id}/changeTypeModal(id=${transactionID})}"><i class="material-icons">shuffle</i></a>
+            </li>
+            <li t:if="canCreateTemplate">
+                <a class="btn-floating btn transaction-action mobile-fab-tip no-wrap" data-action-type="saveAsTemplate" t:data-url="@{/templates/fromTransactionModal}" t:text="loc.get('save.as.template')">Create template</a>
+                <a class="btn-floating btn transaction-action background-orange-dark" data-action-type="saveAsTemplate" t:data-url="@{/templates/fromTransactionModal}"><i class="material-icons">file_copy</i></a>
+            </li>
+        </ul>
+    </div>
+</t:block>
+
+</t:block>
