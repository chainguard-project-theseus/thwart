+++ b/BudgetMasterServer/src/main/resources/templates/filter/filterMacros.html
@@ -0,0 +1,188 @@
+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.filter.FilterConfiguration">
+
+<t:block t:fragment="buttons">
+    <div class="row hide-on-small-only no-margin-bottom">
+        <div class="col s12 right-align">
+            <a t:replace="~{::buttonCloseModal}"></a>
+            <a t:replace="~{::buttonReset}"></a>
+            <button t:replace="~{::buttonApply}"></button>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up valign-wrapper no-margin-bottom">
+        <div class="row center-align">
+            <div class="col s12">
+                <a t:replace="~{::buttonCloseModal}"></a>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
+                <a t:replace="~{::buttonReset}"></a>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
+                <button t:replace="~{::buttonApply}"></button>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<a t:fragment="buttonReset" t:href="@{/filter/reset}" class="waves-effect waves-light btn background-blue"><i class="material-icons left">settings_backup_restore</i>[[${loc.get('filter.reset')}]]</a>
+
+<button t:fragment="buttonApply" class="btn waves-effect waves-light background-green" type="submit" id="buttonApplyFilter">
+    <i class="fas fa-filter left"></i>[[${loc.get('filter.apply')}]]
+</button>
+
+<a t:fragment="buttonResetChart" class="filter-button-reset waves-effect waves-light btn background-blue"><i class="material-icons left">settings_backup_restore</i>[[${loc.get('filter.reset')}]]</a>
+
+<a t:fragment="buttonClose" class="filter-button-close waves-effect waves-light background-blue btn white-text"><i class="fas fa-filter left"></i>[[${loc.get('filter.apply')}]]</a>
+
+<a t:fragment="buttonCloseModal" t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false)}"></a>
+
+<div t:fragment="buttonsAllOrNone" class="row no-margin">
+    <div class="col s6 right-align">
+        <a class="waves-effect waves-light btn background-blue filter-button-all" t:text="loc.get('filter.tags.button.all')">all</a>
+    </div>
+    <div class="col s6">
+        <a class="waves-effect waves-light btn background-blue filter-button-none" t:text="loc.get('filter.tags.button.none')">none</a>
+    </div>
+</div>
+
+<div t:fragment="filterModal(FilterConfiguration filterConfiguration)" id="modalFilter" class="modal modal-fixed-footer background-color">
+    <div class="modal-content">
+        <h4 t:text="loc.get('title.filter')">Filter</h4>
+        <form name="NewFilterConfiguration" t:action="@{/filter/apply}" method="post">
+            <div t:replace="~{::filterModalContent(filterConfiguration, '')}"></div>
+        </form>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{::buttons}"></t:block>
+    </div>
+</div>
+
+<div t:fragment="filterModalContent(FilterConfiguration filterConfiguration, String prefix)" class="row"
+     t:with="prefixValue=${prefix == '' ? '' : prefix + '.'}">
+    <div class="col s12">
+        <ul class="collapsible z-depth-2" id="filterSettings">
+            <li id="section-type">
+                <div class="collapsible-header">
+                    <i class="fas fa-piggy-bank"></i>
+                    [[${loc.get('filter.type')}]]
+                    <div class="collapsible-header-status"></div>
+                </div>
+                <div class="collapsible-body">
+                    <div class="row no-margin">
+                        <div class="col s12 m4 l4">
+                            <label>
+                                <input type="checkbox" t:name="|${prefixValue}includeIncome|" t:checked="filterConfiguration.isIncludeIncome()">
+                                <span class="text-default" t:text="loc.get('filter.type.income')">income</span>
+                            </label>
+                        </div>
+                        <div class="col s12 m4 l4">
+                            <label>
+                                <input type="checkbox" t:name="|${prefixValue}includeExpenditure|" t:checked="filterConfiguration.isIncludeExpenditure()">
+                                <span class="text-default" t:text="loc.get('filter.type.expenditure')">expenditure</span>
+                            </label>
+                        </div>
+                        <div class="col s12 m4 l4">
+                            <label>
+                                <input type="checkbox" t:name="|${prefixValue}includeTransfer|" t:checked="filterConfiguration.isIncludeTransfer()">
+                                <span class="text-default" t:text="loc.get('filter.type.transfer')">transfer</span>
+                            </label>
+                        </div>
+                    </div>
+                </div>
+            </li>
+
+            <li id="section-repeating">
+                <div class="collapsible-header">
+                    <i class="material-icons">repeat</i>
+                    [[${loc.get('filter.repeating')}]]
+                    <div class="collapsible-header-status"></div>
+                </div>
+                <div class="collapsible-body">
+                    <div class="row no-margin">
+                        <div class="col s6 m6 l6">
+                            <label>
+                                <input type="checkbox" t:name="|${prefixValue}includeNotRepeating|" t:checked="filterConfiguration.isIncludeNotRepeating()">
+                                <span class="text-default" t:text="loc.get('filter.repeating.false')">no</span>
+                            </label>
+                        </div>
+                        <div class="col s6 m6 l6">
+                            <label>
+                                <input type="checkbox" t:name="|${prefixValue}includeRepeating|" t:checked="filterConfiguration.isIncludeRepeating()">
+                                <span class="text-default" t:text="loc.get('filter.repeating.true')">yes</span>
+                            </label>
+                        </div>
+                    </div>
+                </div>
+            </li>
+
+            <li id="section-categories">
+                <div class="collapsible-header">
+                    <i class="material-icons">label</i>
+                    [[${loc.get('filter.categories')}]]
+                    <div class="collapsible-header-status"></div>
+                </div>
+                <div class="collapsible-body">
+                    <div t:replace="~{::buttonsAllOrNone}"></div>
+                    <div class="row no-margin">
+                        <div class="col s12">
+                            <div t:each="filterCategory, filterCategoryStat : filterConfiguration.filterCategories">
+                                <label>
+                                    <input type="checkbox" t:name="|${prefixValue}filterCategories['${filterCategoryStat.index}'].include|" t:checked="filterCategory.isInclude()">
+                                    <span class="text-default" t:text="filterCategory.name">name</span>
+                                </label>
+                                <input type="hidden" t:name="|${prefixValue}filterCategories['${filterCategoryStat.index}'].ID|" t:value="filterCategory.ID"/>
+                                <input type="hidden" t:name="|${prefixValue}filterCategories['${filterCategoryStat.index}'].name|" t:value="filterCategory.name"/>
+                            </div>
+                        </div>
+                    </div>
+                </div>
+            </li>
+
+            <li id="section-tags">
+                <div class="collapsible-header">
+                    <i class="material-icons">local_offer</i>
+                    [[${loc.get('filter.tags')}]]
+                    <div class="collapsible-header-status"></div>
+                </div>
+                <div class="collapsible-body">
+                    <div t:replace="~{::buttonsAllOrNone}"></div>
+                    <div class="row no-margin">
+                        <div class="col s12">
+                            <div t:each="filterTag, filterTagStat : filterConfiguration.filterTags">
+                                <label>
+                                    <input type="checkbox" t:name="|${prefixValue}filterTags['${filterTagStat.index}'].include|" t:checked="filterTag.isInclude()">
+                                    <span class="text-default" t:text="filterTag.name">name</span>
+                                </label>
+                                <input type="hidden" t:name="|${prefixValue}filterTags['${filterTagStat.index}'].ID|" t:value="filterTag.ID"/>
+                                <input type="hidden" t:name="|${prefixValue}filterTags['${filterTagStat.index}'].name|" t:value="filterTag.name"/>
+                            </div>
+                        </div>
+                    </div>
+                </div>
+            </li>
+
+            <li id="section-name">
+                <div class="collapsible-header">
+                    <i class="material-icons">subject</i>
+                    [[${loc.get('filter.name')}]]
+                    <div class="collapsible-header-status"></div>
+                </div>
+                <div class="collapsible-body">
+                    <div class="row no-margin">
+                        <div class="input-field col s12">
+                            <input id="filter-name" type="text" t:name="|${prefixValue}name|" t:value="filterConfiguration.name ?: ''">
+                            <label for="filter-name" t:text="loc.get('filter.name.contains')">contains</label>
+                        </div>
+                    </div>
+                </div>
+            </li>
+        </ul>
+    </div>
+</div>
+
+</t:block>
