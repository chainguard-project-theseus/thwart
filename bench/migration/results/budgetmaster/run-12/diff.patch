diff --git a/BudgetMasterServer/src/main/resources/templates/globalAccountSelectModal.html b/BudgetMasterServer/src/main/resources/templates/globalAccountSelectModal.html
new file mode 100644
index 00000000..2e3e57ae
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/globalAccountSelectModal.html
@@ -0,0 +1,62 @@
+<div xmlns:t="https://tessera.dev"
+     t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.accounts.Account"
+     t:params="Settings settings, List<Account> accounts"
+     id="modalGlobalAccountSelect" class="modal modal-fixed-footer background-color-light">
+    <div class="modal-content">
+        <div class="row no-margin-bottom">
+            <div class="col s12">
+                <h4 t:text="loc.get('account.select')">Choose account</h4>
+            </div>
+        </div>
+
+        <div class="row">
+            <div class="col s12 center-align">
+                <a t:replace="~{helpers/header :: buttonLink('/accounts', 'edit', 'account.button.manage', '', 'background-blue', '', false, false)}"></a>
+            </div>
+        </div>
+
+        <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.globalAccountSelect.hotkeys'), 'fas fa-info', null)}"></t:block>
+
+        <div class="row">
+            <div t:each="account, accountStat : accounts" class="col s12 m6 xl6"
+                 t:with="accountName=${account.type == 'ALL' ? loc.get('account.all') : account.name}">
+                <a t:href="@{/accounts/{id}/select(id=${account.ID})}" class="text-default">
+                    <div class="card-panel global-account-select-option" t:data-account-index="accountStat.index">
+                        <div class="global-account-select-option-header">
+                            <div t:if="accountStat.index < 10" class="keyboard-key bold global-account-select-option-key" t:text="accountStat.index">0</div>
+                            <div t:unless="accountStat.index < 10" class="keyboard-key bold global-account-select-option-key-hidden">&nbsp;</div>
+
+                            <t:block t:if="account.endDate != null" t:with="remainingDays=${account.remainingDays}">
+                                <!--/* tooltip text in aria-label; the script below passes it to M.Tooltip (data-tooltip takes no data) */-->
+                                <i t:if="remainingDays <= 0" class="fas fa-bell text-red global-account-select-tooltip" data-position="right"
+                                   t:aria-label="loc.get('account.tooltip.endDate.done', acc.abs(remainingDays))"></i>
+                                <i t:if="remainingDays > 0 and remainingDays <= 30" class="fas fa-bell text-yellow global-account-select-tooltip" data-position="right"
+                                   t:aria-label="loc.get('account.tooltip.endDate.soon', remainingDays)"></i>
+                            </t:block>
+
+                        </div>
+                        <div class="global-account-select-option-content">
+                            <div t:replace="~{helpers/customSelectMacros :: accountIcon(account, accountName, 'category-circle-preview account-icon-big', settings)}"></div>
+                            <div class="global-account-select-option-column-2" t:with="accountBudget=${bm.accountBudget(account.ID)}">
+                                <div class="global-account-select-option-name truncate" t:text="accountName">name</div>
+                                <div t:if="accountBudget <= 0" t:class="settings.useDarkTheme ? 'global-account-select-option-balance text-red-light' : 'global-account-select-option-balance text-red'" t:text="bm.currency(accountBudget)">0.00 €</div>
+                                <div t:unless="accountBudget <= 0" t:class="settings.useDarkTheme ? 'global-account-select-option-balance text-green' : 'global-account-select-option-balance text-green-dark'" t:text="bm.currency(accountBudget)">0.00 €</div>
+                            </div>
+                        </div>
+                    </div>
+                </a>
+            </div>
+        </div>
+    </div>
+    <div class="modal-footer background-color-light">
+        <a t:replace="~{helpers/header :: buttonLink(null, 'clear', 'cancel', 'buttonCloseGlobalAccountSelect', 'red', 'modal-action modal-close text-white', false, false)}"></a>
+    </div>
+    <script>
+        document.querySelectorAll('#modalGlobalAccountSelect .global-account-select-tooltip[aria-label]').forEach(function(element)
+        {
+            let text = document.createElement('div');
+            text.textContent = element.getAttribute('aria-label');
+            M.Tooltip.init(element, {html: text.innerHTML});
+        });
+    </script>
+</div>
