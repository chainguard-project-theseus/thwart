+            <div class="custom-select">
+                <div class="custom-select-trigger" tabindex="0">
+                    <div class="custom-select-selected-item">
+                        <t:block t:if="selectedAccount != null"><t:block t:replace="~{::accountContent(selectedAccount, 'no-margin-left', settings)}"></t:block></t:block>
+                    </div>
+                    <div class="custom-select-arrow"></div>
+                </div>
+                <div class="custom-select-options">
+                    <t:block t:each="account : accounts">
+                        <t:block t:if="account.type == 'CUSTOM'"><t:block t:replace="~{::accountOption(account, selectedAccount != null and selectedAccount.ID == account.ID, settings)}"></t:block></t:block>
+                    </t:block>
+                </div>
+            </div>
+            <input type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedAccount?.ID"/>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="globalAccountSelect(Account currentAccount, List<Account> accounts, Settings settings)" class="input-field no-margin">
