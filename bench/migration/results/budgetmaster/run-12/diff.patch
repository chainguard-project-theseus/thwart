+
+<div t:fragment="repeatingEndOption(Transaction transaction, LocalDate currentDate)" class="row" id="transaction-repeating-end"
+     t:with="endKey=${transaction.repeatingOption == null ? null : transaction.repeatingOption.endOption.localizationKey}">
+        <div class="col s12 m12 l8 offset-l2">
+            <div class="row">
+                <div class="col s12 left-align" t:text="loc.get('repeating.end')">Ends</div>
+            </div>
+            <div t:replace="~{::repeatingEndNever(endKey == null or endKey == 'repeating.end.key.never')}"></div>
+            <div t:replace="~{::repeatingEndAfterXTimes(endKey == 'repeating.end.key.afterXTimes', transaction)}"></div>
+            <t:block t:replace="~{::repeatingEndDate(endKey == 'repeating.end.key.date', transaction, currentDate)}"></t:block>
