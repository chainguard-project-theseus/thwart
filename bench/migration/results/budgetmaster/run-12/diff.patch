+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="fas fa-file-csv"></i> <t:block t:text="loc.get('menu.transactions.import')">Import</t:block></div>
+                    </div>
+                </div>
+
+                <script>
+                    transactionNameSuggestions = {};
+                </script>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                    <div class="container">
+                        <t:block t:if="csvRows != null">
+                            <div class="row center-align">
+                                <div class="col s12 m12 l8 offset-l2 headline-small text-green truncate" id="csv-file-name">
+                                    <i class="fas fa-file-csv"></i> <t:block t:text="csvImportFileName">file.csv</t:block>
+                                </div>
+                            </div>
+
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <a t:replace="~{helpers/header :: buttonLink('/transactionImport/cancel', 'clear', 'cancel', 'button-cancel-csv-import', 'red', 'text-white', false, false)}"></a>
+                                </div>
+                            </div>
+                        </t:block>
+                        <t:block t:if="csvRows == null">
+                            <form t:replace="~{transactions/transactionImportMacros :: csvUpload(csvImportSettings, validationErrors)}"></form>
+                        </t:block>
+                    </div>
+
+                    <t:block t:if="csvTransactions != null">
+                        <t:block t:replace="~{transactions/transactionImportMacros :: renderCsvTransactions(csvTransactions, categories, suggestionsJSON, settings)}"></t:block>
+                        <t:block t:replace="~{transactions/transactionImportMacros :: showColumnSettingsErrors(errorsColumnSettings)}"></t:block>
+                    </t:block>
+                    <t:block t:if="csvTransactions == null and csvRows != null">
+                        <div class="container">
+                            <div class="section center-align">
+                                <div class="headline-small" t:text="loc.get('transactions.import.matchColumns')">Match columns</div>
+                            </div>
+                        </div>
+                        <div t:replace="~{transactions/transactionImportMacros :: columnSettings(csvRows, csvImportSettings, validationErrors)}"></div>
+                        <div t:replace="~{transactions/transactionImportMacros :: renderCsvRows(csvRows)}"></div>
+                    </t:block>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <script>
+            var localizedSearch = [[${loc.get('search')}]];
+        </script>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <t:block t:replace="~{helpers/validation :: messages(validationErrors)}"></t:block>
+        <script t:src="@{/webjars/datatables/js/dataTables.min.js}"></script>
+        <script t:src="@{/js/transactionImport.js}"></script>
+    </body>
+</html>
