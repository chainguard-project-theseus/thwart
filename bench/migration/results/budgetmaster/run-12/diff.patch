+<!--/* FreeMarker: buttons; csvImportInProgress = the old session attribute currentCsvTransaction?? */-->
+<t:block t:fragment="buttons(String cancelURL, boolean includeContinueButton, boolean allowEmptyAmount, Boolean csvImportInProgress)">
