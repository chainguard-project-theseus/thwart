+// Shows the server-side validation messages (JSON block #validationMessages, field name to message)
+// as tooltips on the fields marked with data-validation-field.
+$(document).ready(function()
+{
+    let messagesElement = document.getElementById('validationMessages');
+    if(messagesElement === null)
+    {
+        return;
+    }
+
+    let messages = JSON.parse(messagesElement.textContent);
+    document.querySelectorAll('[data-validation-field]').forEach(function(element)
+    {
+        let message = messages[element.dataset.validationField];
+        if(message === undefined)
+        {
+            return;
+        }
+
+        let text = document.createElement('div');
+        text.textContent = message;
+        let instance = M.Tooltip.getInstance(element);
+        if(instance !== undefined)
+        {
+            instance.destroy();
+        }
+        M.Tooltip.init(element, {html: text.innerHTML});
+    });
+});
