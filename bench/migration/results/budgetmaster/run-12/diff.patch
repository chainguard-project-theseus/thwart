+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.transactions.Transaction;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Functions for the transaction list views (transactions, search, recurring overview, reports).
+ */
+@TemplateFunctions("tl")
+public final class TransactionListViewFunctions
+{
+	private TransactionListViewFunctions()
+	{
+	}
+
+	/**
+	 * Transactions of one day (FreeMarker: transactions.ftl opened a "transaction-date-group" div whenever the date changed).
+	 */
+	public record DateGroup(String date, List<Transaction> transactions)
+	{
+	}
+
+	/**
+	 * Groups consecutive transactions with the same date string (upper case, with month name), keeping the order.
+	 */
+	@TemplateFunction
+	public static List<DateGroup> dateGroups(List<Transaction> transactions)
+	{
+		final List<DateGroup> groups = new ArrayList<>();
+		if(transactions == null)
+		{
+			return groups;
+		}
+
+		String lastDate = null;
+		List<Transaction> current = null;
+		for(Transaction transaction : transactions)
+		{
+			final String date = ViewServices.dateService().getDateStringWithMonthName(transaction.getDate()).toUpperCase(Locale.ROOT);
+			if(!date.equals(lastDate))
+			{
+				current = new ArrayList<>();
+				groups.add(new DateGroup(date, current));
+				lastDate = date;
+			}
+			current.add(transaction);
+		}
+		return groups;
+	}
+}
