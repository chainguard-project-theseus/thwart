+
+<!--/* the cells' sort/search values (old data-order/data-search) are in the JSON block #csvTransactionsTableData */-->
+<t:block t:fragment="renderCsvTransactions(List<CsvTransaction> csvTransactions, List<Category> categories, String suggestionsJSON, Settings settings)">
+    <div id="transaction-import-list">
+        <script type="application/json" id="csvTransactionsTableData">[[${ti.tableData(csvTransactions)}]]</script>
+        <table class="centered" id="table-transaction-rows" style="width:100%">
+            <thead>
+                <tr>
+                    <td class="bold" t:text="loc.get('transactions.import.status')">Status</td>
+                    <td class="bold" t:text="loc.get('transaction.new.label.date')">Date</td>
+                    <td class="bold" t:text="loc.get('transaction.new.label.category')">Category</td>
+                    <td class="bold" t:text="loc.get('transaction.new.label.name')">Name</td>
+                    <td class="bold" t:text="loc.get('transaction.new.label.description')">Description</td>
+                    <td class="bold" t:text="loc.get('transaction.new.label.amount')">Amount</td>
+                    <td class="bold" t:text="loc.get('transactions.import.actions')">Actions</td>
+                </tr>
+            </thead>
+
+            <tbody>
+                <t:block t:each="csvTransaction, stat : csvTransactions">
+                    <tr t:replace="~{::renderCsvTransaction(csvTransaction, stat.index, categories, settings)}"></tr>
+                </t:block>
+            </tbody>
+        </table>
+
+        <div class="hidden">
+            <form t:each="csvTransaction, stat : csvTransactions" name="NewTransactionInPlace" t:id="|newTransactionInPlace_${stat.index}|" method="POST"
+                  t:action="@{/transactionImport/{i}/newTransactionInPlace(i=${stat.index})}" t:data-index="stat.index">
+            </form>
+        </div>
+    </div>
+
+    <script t:replace="~{transactions/newTransactionMacros :: insertNameSuggestions(suggestionsJSON)}"></script>
+</t:block>
+
+<tr t:fragment="renderCsvTransaction(CsvTransaction csvTransaction, int index, List<Category> categories, Settings settings)"
+    t:with="skipped=${csvTransaction.status == 'SKIPPED'}, formId=${'newTransactionInPlace_' + index}"
+    t:class="skipped ? 'transaction-import-row transaction-import-row-skipped' : 'transaction-import-row '" t:id="|transaction-import-row-${index}|">
+            <td><t:block t:replace="~{::statusBanner(csvTransaction.status, settings)}"></t:block></td>
+            <td t:text="csvTransaction.date">2024-01-01</td>
+            <td>
+                <div t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, csvTransaction.category, 'left-align no-margin-top no-margin-bottom', '', 'csvTransaction-category-' + index, false, 'no-margin-bottom', skipped, formId, settings)}"></div>
+            </td>
+            <td>
+                <div class="input-field no-margin-top no-margin-bottom">
+                    <input t:form="formId" class="no-margin-bottom autocomplete" type="text" name="name" autocomplete="off" required t:value="csvTransaction.name" t:disabled="skipped">
+                </div>
+            </td>
+            <td>
+                <div class="input-field no-margin-top no-margin-bottom">
+                    <input t:form="formId" class="no-margin-bottom" type="text" name="description" t:value="csvTransaction.description" t:disabled="skipped">
+                </div>
+            </td>
+            <td t:text="bm.currency(csvTransaction.amount)">1.00 €</td>
+            <td>
+                <t:block t:if="skipped">
+                    <a id="" t:data-index="index" class="waves-effect waves-light btn-flat no-padding text-default button-request-transaction-import-undo-skip"
+                       t:data-url="@{/transactionImport/{i}/undoSkip(i=${index})}"><i class="material-icons left no-margin ">do_disturb_off</i></a>
+                </t:block>
+                <t:block t:unless="skipped">
+                    <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', '', '', 'background-blue', 'text-white', false, '', formId)}"></button>&nbsp;
+                    <div class="fixed-action-btn edit-transaction-button">
+                        <a class="btn-floating btn-flat waves-effect waves-light no-padding text-default edit-transaction-button-link">
+                            <i class="material-icons text-default">edit</i>
+                        </a>
+                        <ul class="new-transaction-button-list">
+                            <li>
+                                <a t:href="@{/transactionImport/{i}/newTransaction/normal(i=${index})}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new', loc.get('title.transaction.new.normal'))">new</a>
+                                <a t:href="@{/transactionImport/{i}/newTransaction/normal(i=${index})}" class="btn-floating btn background-orange"><i class="material-icons">payment</i></a>
+                            </li>
+                            <li>
+                                <a t:href="@{/transactionImport/{i}/newTransaction/transfer(i=${index})}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new', loc.get('title.transaction.new.transfer'))">new</a>
+                                <a t:href="@{/transactionImport/{i}/newTransaction/transfer(i=${index})}" class="btn-floating btn background-green-dark"><i class="material-icons">swap_horiz</i></a>
+                            </li>
+                            <li>
+                                <a t:href="@{/transactionImport/{i}/newFromTemplate(i=${index})}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new', loc.get('title.transaction.new.from.template'))">new</a>
+                                <a t:href="@{/transactionImport/{i}/newFromTemplate(i=${index})}" class="btn-floating btn background-blue-baby"><i class="material-icons">file_copy</i></a>
+                            </li>
+                        </ul>
+                    </div>
+                    <a id="" t:data-index="index" class="waves-effect waves-light btn-flat no-padding text-default button-request-transaction-import-skip"
+                       t:data-url="@{/transactionImport/{i}/skip(i=${index})}"><i class="material-icons left no-margin ">do_not_disturb_on</i></a>
+                </t:block>
+            </td>
+</tr>
+
+<t:block t:fragment="showColumnSettingsErrors(List<String> errorsColumnSettings)">
+    <div t:if="errorsColumnSettings != null and !errorsColumnSettings.isEmpty()" class="container" id="parseErrors">
+            <div class="row">
+                <div class="col s12">
+                    <ul class="collapsible">
+                        <li>
+                            <div class="collapsible-header bold">
+                                <i class="fas fa-exclamation-triangle text-red"></i>
+                                <t:block t:text="loc.get('info.database.import.result.errors')">Errors</t:block>
+                            </div>
+                            <div class="collapsible-body">
+                                <table class="bordered">
+                                    <tbody t:unless="errorsColumnSettings == null or errorsColumnSettings.isEmpty()">
+                                    <tr t:each="error : errorsColumnSettings">
+                                        <td><i class="fas fa-exclamation-triangle text-red"></i></td>
+                                        <td t:text="error">error</td>
+                                    </tr>
+                                    </tbody>
+                                </table>
+                            </div>
+                        </li>
+                    </ul>
+                </div>
+            </div>
+    </div>
+</t:block>
+
+<div t:fragment="statusBanner(CsvTransactionStatus status, Settings settings)"
+     t:class="status == 'PENDING' ? 'banner background-blue text-white' : (status == 'IMPORTED' ? 'banner background-green text-white' : (settings.useDarkTheme ? 'banner background-grey text-black' : 'banner background-grey text-white'))"
+     t:text="loc.get(status.localizationKey)">Pending</div>
+
+</t:block>
