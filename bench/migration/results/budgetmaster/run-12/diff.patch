+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.transactions.csvimport.CsvTransaction;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Functions for the CSV import views (FreeMarker: transactions/transactionImportMacros.ftl).
+ */
+@TemplateFunctions("ti")
+public final class TransactionImportViewFunctions
+{
+	private TransactionImportViewFunctions()
+	{
+	}
+
+	/**
+	 * The DataTables sort/search value of each cell (FreeMarker wrote them as data-order/data-search attributes):
+	 * one list per row with status, date, category, name, description and amount. Read by js/transactionImport.js.
+	 */
+	@TemplateFunction
+	public static List<List<String>> tableData(List<CsvTransaction> csvTransactions)
+	{
+		final List<List<String>> rows = new ArrayList<>();
+		if(csvTransactions == null)
+		{
+			return rows;
+		}
+
+		for(CsvTransaction csvTransaction : csvTransactions)
+		{
+			final List<String> row = new ArrayList<>();
+			row.add(Localization.getString(csvTransaction.getStatus().getLocalizationKey()));
+			row.add(String.valueOf(csvTransaction.getDate()));
+			row.add(csvTransaction.getCategory() == null ? "" : String.valueOf(csvTransaction.getCategory().getName()));
+			row.add(String.valueOf(csvTransaction.getName()));
+			row.add(String.valueOf(csvTransaction.getDescription()));
+			row.add(ViewServices.currencyService().getCurrencyString(csvTransaction.getAmount()));
+			rows.add(row);
+		}
+		return rows;
+	}
+}
