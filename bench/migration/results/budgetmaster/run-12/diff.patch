+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.charts.*"
+      t:params="Settings settings, List<Notification> notifications, ChartSettings chartSettings, List<Chart> charts, ChartDisplayType[] displayTypes, ChartGroupType[] groupTypes, Chart chart, String containerID, String transactionData, String dateRange, List<String> localizedMonthNames, List<String> localizedWeekdays">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('menu.charts'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/search.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('charts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">show_chart</i> <t:block t:text="loc.get('title.charts')">Charts</t:block></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                    <div class="row">
+                        <div class="col s12 center-align">
+                            <a t:replace="~{helpers/header :: buttonLink(null, 'edit', 'chart.button.settings', 'buttonShowChartSettings', 'background-blue', 'hidden', false, false)}"></a>
+                        </div>
+                    </div>
+
+                    <form name="NewChartSettings" t:action="@{/charts}" method="post" t:class="chartSettings.chartSelected ? 'hidden' : ''">
+                        <div class="container">
+                            <div class="row">
+                                <div class="col s12 center-align">
+                                    <a t:each="displayType : displayTypes"
+                                       t:class="displayType == chartSettings.displayType ? 'waves-effect waves-light btn-large text-black button-display-type active' : 'waves-effect waves-light btn-large text-black button-display-type '"
+                                       t:data-value="displayType == 'PIE' ? 'PIE' : (displayType == 'BAR' ? 'BAR' : (displayType == 'LINE' ? 'LINE' : 'CUSTOM'))">
+                                        <t:block t:replace="~{charts/chartFunctions :: iconForItem(ch.fontAwesome(displayType), displayType.icon, displayType.localizationKey)}"></t:block>
+                                    </a>
+                                </div>
+                            </div>
+                        </div>
+                        <input type="hidden" name="displayType" t:value="chartSettings.displayType">
+
+                        <div class="container" id="chart-group-type-buttons">
+                            <div class="row">
+                                <div class="col s12 center-align">
+                                    <a t:each="groupType : groupTypes"
+                                       t:class="groupType == chartSettings.groupType ? 'waves-effect waves-light btn-large text-black button-group-type active' : 'waves-effect waves-light btn-large text-black button-group-type '"
+                                       t:data-value="groupType == 'NONE' ? 'NONE' : (groupType == 'MONTH' ? 'MONTH' : 'YEAR')">
+                                        <t:block t:replace="~{charts/chartFunctions :: iconForItem(ch.fontAwesome(groupType), groupType.icon, groupType.localizationKey)}"></t:block>
+                                    </a>
+                                </div>
+                            </div>
+                        </div>
+                        <input type="hidden" name="groupType" t:value="chartSettings.groupType">
+
+                        <div class="container">
+                            <div class="row">
+                                <div t:each="previewChart : charts" class="col s6 m4 l3 center-align chart-preview-column hidden"
+                                     t:data-display-type="previewChart.displayType == 'PIE' ? 'PIE' : (previewChart.displayType == 'BAR' ? 'BAR' : (previewChart.displayType == 'LINE' ? 'LINE' : 'CUSTOM'))" t:data-group-type="previewChart.groupType == 'NONE' ? 'NONE' : (previewChart.groupType == 'MONTH' ? 'MONTH' : 'YEAR')" t:data-id="previewChart.ID">
+                                    <div class="card chart-preview">
+                                        <div class="card-image">
+                                            <img t:src="'/images/charts/' + (previewChart.previewImageFileName ?: 'placeholder.png')">
+                                        </div>
+                                        <div class="card-action bold valign-wrapper">
+                                            <span style="margin: auto" t:text="ch.chartName(previewChart)">name</span>
+                                        </div>
+                                    </div>
+                                </div>
+                                <div class="col s12 center-align hidden" id="buttonCustomCharts">
+                                    <a t:replace="~{helpers/header :: buttonLink('/charts/manage', 'edit', 'chart.button.manage', '', 'background-blue', '', false, false)}"></a>
+                                </div>
+                            </div>
+                        </div>
+                        <input type="hidden" name="chartID" t:value="chartSettings.chartID == null ? '' : '' + chartSettings.chartID">
+
+                        <!--/* dateSelect */-->
+                        <div class="container">
+                            <div class="row">
+                                <div class="col s12">
+                                    <div class="card" id="chart-date-card">
+                                        <div class="card-content">
+                                            <div class="row">
+                                                <div class="input-field col s6 m6 l4 offset-l2">
+                                                    <input id="chart-datepicker" type="text" class="datepicker" name="startDate" t:value="bm.dateLong(chartSettings.startDate)">
+                                                    <label for="chart-datepicker" t:text="loc.get('chart.steps.second.label.start')">Start date</label>
+                                                </div>
+
+                                                <div class="input-field col s6 m6 l4 ">
+                                                    <input id="chart-datepicker-end" type="text" class="datepicker" name="endDate" t:value="bm.dateLong(chartSettings.endDate)">
+                                                    <label for="chart-datepicker-end" t:text="loc.get('chart.steps.second.label.end')">End date</label>
+                                                </div>
+                                            </div>
+
+                                            <!--/* quickDateOptions */-->
+                                            <div class="row no-margin-bottom">
+                                                <div class="col s12 m12 l8 offset-l2 no-margin-top">
+                                                    <table class="no-border-table">
+                                                        <tbody>
+                                                        <tr>
+                                                            <td class="quick-date" data-quick="0" t:text="loc.get('chart.quick.this.week')">This week</td>
+                                                            <td class="quick-date" data-quick="1" t:text="loc.get('chart.quick.this.month')">This month</td>
+                                                            <td class="quick-date" data-quick="2" t:text="loc.get('chart.quick.this.year')">This year</td>
+                                                            <td class="quick-date" data-quick="3" t:text="loc.get('chart.quick.all')">All</td>
+                                                        </tr>
+                                                        <tr>
+                                                            <td class="quick-date" data-quick="4" t:text="loc.get('chart.quick.last.week')">Last week</td>
+                                                            <td class="quick-date" data-quick="5" t:text="loc.get('chart.quick.last.month')">Last month</td>
+                                                            <td class="quick-date" data-quick="6" t:text="loc.get('chart.quick.last.year')">Last year</td>
+                                                            <td class="quick-date" data-quick="7" t:text="loc.get('chart.quick.until.endOfLastYear')">Until end of last year</td>
+                                                        </tr>
+                                                        <tr>
+                                                            <td class="quick-date" data-quick="8" t:text="loc.get('chart.quick.last.week.days')">Last 7 days</td>
+                                                            <td class="quick-date" data-quick="9" t:text="loc.get('chart.quick.last.month.days')">Last 30 days</td>
+                                                            <td class="quick-date" data-quick="10" t:text="loc.get('chart.quick.last.year.days')">Last 365 days</td>
+                                                            <td class="quick-date" data-quick="11" t:text="loc.get('chart.quick.until.today')">Until today</td>
+                                                        </tr>
+                                                        </tbody>
+                                                    </table>
+                                                </div>
+                                            </div>
+
+                                            <script>
+                                                var startDate = [[${bm.dateLong(chartSettings.startDate)}]];
+                                                var endDate = [[${bm.dateLong(chartSettings.endDate)}]];
+                                                startDate = startDate.split(".");
+                                                startDate = new Date(startDate[2], startDate[1] - 1, startDate[0]);
+                                                endDate = endDate.split(".");
+                                                endDate = new Date(endDate[2], endDate[1] - 1, endDate[0]);
+                                            </script>
+                                        </div>
+                                    </div>
+                                </div>
+                            </div>
+                        </div>
+
+                        <!--/* filterOptions */-->
+                        <div class="container" id="chart-filter-container">
+                            <div class="row">
+                                <div class="col s12 no-margin-top center-align">
+                                    <ul class="collapsible">
+                                        <li>
+                                            <div class="collapsible-header"><i class="fas fa-filter"></i><t:block t:text="loc.get('title.filter')">Filter</t:block> <span class="badge background-red hidden text-white" id="filterActiveBadge" t:text="loc.get('filter.active.short')">active</span></div>
+                                            <div class="collapsible-body left-align">
+                                                <t:block t:replace="~{filter/filterMacros :: filterModalContent(chartSettings.filterConfiguration, 'filterConfiguration')}"></t:block>
+                                                <div class="center-align">
+                                                    <a t:replace="~{filter/filterMacros :: buttonResetChart}"></a>
+                                                </div>
+                                            </div>
+                                        </li>
+                                    </ul>
+                                </div>
+                            </div>
+                        </div>
+
+                        <input type="hidden" name="clickedAmountType" value="">
+                        <input type="hidden" name="clickedCategory" value="">
+
+                        <!--/* buttons */-->
+                        <div class="row center-align">
+                            <div class="col s12">
+                                <button class="btn waves-effect waves-light background-blue" type="submit" name="buttonSave" disabled>
+                                    <i class="material-icons left">show_chart</i><t:block t:text="loc.get('chart.show')">Show chart</t:block>
+                                </button>
+                            </div>
+                        </div>
+                    </form>
+
+                    <br>
+
+                    <div t:class="chartSettings.chartSelected ? '' : 'hidden'">
+                        <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.charts.click'), 'fas fa-info', '/hotkeys')}"></t:block>
+                    </div>
+
+                    <div class="container-chart">
+                        <div t:if="containerID != null" t:id="containerID" class="chart-canvas"></div>
+                    </div>
+
+                    <div id="matchingTransactionsOverview"></div>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <script t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></script>
+        <script>
+            var filterActive = [[${loc.get('filter.active')}]];
+            var filterNotActive = [[${loc.get('title.filter')}]];
+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/libs/plotly.min.js}"></script>
+        <script t:src="@{/js/libs/moment.min.js}"></script>
+        <script t:src="@{/js/charts.js}"></script>
+        <script t:src="@{/js/filter.js}"></script>
+
+        <t:block t:if="chart != null">
+            <script t:if="chart.type == 'DEFAULT'">
+                var localizedLocale = [[${loc.get('locale')}]];
+                var localizedTitle = [[${loc.get(chart.name)}]];
+                var localizedDateRange = [[${dateRange}]];
+                var localizedCurrency = [[${settings.currency}]];
+                var localizedDataJson = [[${loc.get(chart.name + '.localization')}]];
+                localizedData = JSON.parse(localizedDataJson);
+            </script>
+            <script t:unless="chart.type == 'DEFAULT'">
+                var localizedTitle = [[${chart.name}]];
+                var localizedDateRange = [[${dateRange}]];
+            </script>
+            <!--/* FreeMarker inlined the chart's script (with transactionData and containerID substituted) into this
+                   <script>. Tessera writes no code from data: the script travels as a JSON string and is run globally. */-->
+            <script>
+                var chartScriptSource = [[${chart.script}]];
+                var chartTransactionData = [[${transactionData}]];
+                var chartContainerID = [[${containerID}]];
+                (0, eval)(chartScriptSource
+                    .split("var transactionData = [];").join("var transactionData = " + chartTransactionData + ";")
+                    .split("containerID").join(chartContainerID));
+            </script>
+        </t:block>
+    </body>
