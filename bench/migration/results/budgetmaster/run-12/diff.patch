+<t:block t:fragment="buttons">
+    <div class="row hide-on-small-only valign-wrapper">
+        <div class="col s6 right-align">
+            <a t:replace="~{helpers/header :: buttonLink('/charts/newChart', 'add', 'title.chart.new', '', 'background-blue', '', false, false)}"></a>
