+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.backup.AutoBackupTime, de.deadlocker8.budgetmaster.backup.BackupStatus">
+
+<!--/* FreeMarker: settingsMacros.switches */-->
+<div t:fragment="switches(Settings settings)" class="row">
+    <div class="col s12">
+        <div class="table-container">
+            <div class="table-cell">
+                <div class="switch-cell-margin" t:text="loc.get('settings.category.circle.style')">Show categories as</div>
+            </div>
+            <div class="table-cell table-cell-spacer"></div>
+            <div class="table-cell">
+                <div t:replace="~{settings/settingsMacros :: switch('category.circle.style', 'showCategoriesAsCircles', settings.showCategoriesAsCircles == true)}"></div>
+            </div>
+            <div class="table-cell table-cell-spacer"></div>
+            <div class="table-cell">
+                <div class="switch-cell-margin">
+                    <a t:replace="~{settings/settingsMacros :: helpButton('settings.category.circle.style.description')}"></a>
+                </div>
+            </div>
+        </div>
+    </div>
+</div>
+
+<!--/* FreeMarker: settingsMacros.switch */-->
+<div t:fragment="switch(String localizationKey, String name, boolean isActive)" class="switch switch-cell-margin">
+    <label>
+        <t:block t:text="loc.get('settings.' + localizationKey + '.deactivated')">off</t:block>
+        <input type="checkbox" t:name="name" t:checked="isActive"/>
+        <span class="lever"></span>
+        <t:block t:text="loc.get('settings.' + localizationKey + '.activated')">on</t:block>
+    </label>
+</div>
+
+<!--/* help button with a tooltip; the text is in aria-label (a computed data-tooltip is not allowed),
+       settingsContainers.js (initSettingsTooltips) passes it to the materialize tooltip */-->
+<a t:fragment="helpButton(String localizationKey)" class="btn btn-flat tooltipped text-default" data-position="bottom" t:aria-label="loc.get(localizationKey)"><i class="material-icons">help_outline</i></a>
+
+<!--/* FreeMarker: settingsMacros.databaseNormal */-->
+<div t:fragment="databaseNormal" class="row hide-on-small-only no-margin-bottom">
+    <div class="col m4 l4 center-align">
+        <a t:replace="~{helpers/header :: buttonLink('/settings/database/requestImport', 'cloud_upload', 'settings.database.import', '', 'background-blue', '', false, false)}"></a>
+    </div>
+
+    <div class="col m4 l4 center-align">
+        <a t:replace="~{helpers/header :: buttonLink('/settings/database/requestExport', 'cloud_download', 'settings.database.export', '', 'background-blue', '', false, false)}"></a>
+    </div>
+
+    <div class="col m4 l4 center-align">
+        <a t:replace="~{helpers/header :: buttonLink('/settings/database/requestDelete', 'delete_forever', 'settings.database.delete', '', 'background-red', '', false, false)}"></a>
+    </div>
+</div>
+
+<!--/* FreeMarker: settingsMacros.databaseSmall */-->
+<div t:fragment="databaseSmall" class="hide-on-med-and-up">
+    <div class="row center-align">
+        <div class="col s12">
+            <a t:replace="~{helpers/header :: buttonLink('/settings/database/requestImport', 'cloud_upload', 'settings.database.import', '', 'background-blue', '', false, false)}"></a>
+        </div>
+    </div>
+
+    <div class="row center-align">
+        <div class="col s12">
+            <a t:replace="~{helpers/header :: buttonLink('/settings/database/requestExport', 'cloud_download', 'settings.database.export', '', 'background-blue', '', false, false)}"></a>
+        </div>
+    </div>
+
+    <div class="row center-align">
+        <div class="col s12">
+            <a t:replace="~{helpers/header :: buttonLink('/settings/database/requestDelete', 'delete_forever', 'settings.database.delete', '', 'background-red', '', false, false)}"></a>
+        </div>
+    </div>
+</div>
+
+<!--/* FreeMarker: settingsMacros.deleteDB */-->
+<div t:fragment="deleteDB(String verificationCode)" id="modalConfirmDelete" class="modal background-color">
+    <div class="modal-content">
+        <h4 t:text="loc.get('info.title.database.delete')">Delete database</h4>
+        <p t:utext="loc.html('info.header.text.database.delete')">text</p>
+        <p class="valign-wrapper"><t:block t:text="loc.get('info.text.database.delete')">code:</t:block> <span id="verificationCode" t:text="verificationCode">ABCD</span></p>
+
+        <form id="form-confirm-database-delete" t:action="@{/settings/database/delete}" method="post">
+            <input type="hidden" name="verificationCode" t:value="verificationCode"/>
+
+            <div class="row">
+                <div class="input-field col s12 m8 l6">
+                    <input id="verification" type="text" name="verificationUserInput">
+                    <label for="verification" t:text="loc.get('settings.database.delete.verification')">Verification</label>
+                </div>
+            </div>
+        </form>
+    </div>
+    <div class="modal-footer background-color">
+        <a t:replace="~{helpers/header :: buttonLink('/settings', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false)}"></a>
+        <!--/* the old classes argument started with a stray quote, so browsers only saw the color class */-->
+        <button t:replace="~{helpers/header :: buttonSubmit('action', 'delete_forever', 'delete', 'button-confirm-database-delete', 'green', '', false, '', '')}"></button>
+    </div>
+</div>
+
+<!--/* FreeMarker: settingsMacros.importDB */-->
+<div t:fragment="importDB" id="modalImportDatabase" class="modal background-color">
+    <div class="modal-content">
+        <h4 t:text="loc.get('info.title.database.import.dialog')">Import</h4>
+
+        <div class="row notification-row">
+            <div class="col s12 center-align">
+                <div class="notification-wrapper">
+                    <div class="notification background-yellow text-black">
+                        <i class="fas fa-exclamation-triangle notification-item"></i>
+                        <span class="notification-item left-align" t:text="loc.get('import.warning.delete.database')">warning</span>
+                    </div>
+                </div>
+            </div>
+        </div>
+
+        <form id="form-database-import" method="post" t:action="@{/settings/database/upload}" enctype="multipart/form-data" accept-charset="UTF-8">
+            <div class="file-field input-field">
+                <div class="btn background-blue">
+                    <i class="material-icons">cloud_upload</i>
+                    <input id="inputDatabaseImport" type="file" accept=".json" name="file">
+                </div>
+                <div class="file-path-wrapper">
+                    <input class="file-path validate" type="text">
+                </div>
+            </div>
+        </form>
+    </div>
+    <div class="modal-footer background-color">
+        <a t:replace="~{helpers/header :: buttonLink('/settings', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false)}"></a>
