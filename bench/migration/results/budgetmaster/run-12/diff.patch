+++ b/BudgetMasterServer/src/main/resources/templates/search/search.html
@@ -0,0 +1,60 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.search.Search, de.deadlocker8.budgetmaster.search.SearchResultPage"
+      t:params="Settings settings, List<Notification> notifications, List<String> localizedMonthNames, List<String> localizedWeekdays, SearchResultPage page, Search search">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('search'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/search.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('home', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="loc.get('menu.search.results', page.totalElements())">results</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                    <form id="searchForm" t:action="@{/search}" method="get">
+                        <div t:replace="~{search/searchMacros :: searchTextAndButton(search)}"></div>
+                        <div t:replace="~{search/searchMacros :: checkboxes(search)}"></div>
+                        <div t:replace="~{search/searchMacros :: dateRange(search)}"></div>
+                        <input type="hidden" name="page" id="inputPageNumber" t:value="page.number()"/>
+                    </form>
+
+                    <div t:replace="~{search/searchMacros :: pagination(page, 'top')}"></div>
+
+                    <div class="row search-container">
+                        <div class="col s12">
+                            <t:block t:replace="~{search/searchMacros :: renderTransactions(page.content(), false, settings)}"></t:block>
+
+                            <!--/* placeholder */-->
+                            <div class="row" t:if="page.content().isEmpty()">
+                                <div class="col s12">
+                                    <br><br>
+                                    <div class="headline-advice center-align" t:text="loc.get('search.placeholder')">placeholder</div>
+                                </div>
+                            </div>
+                        </div>
+                    </div>
+
+                    <div t:replace="~{search/searchMacros :: pagination(page, 'bottom')}"></div>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <script t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></script>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/search.js}"></script>
+        <script t:src="@{/js/titleTooltips.js}"></script>
+    </body>
+</html>
