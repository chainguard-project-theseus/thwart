+                                            ~{settings/containers/settingsContainer :: security(validationErrors, toastContent)})}"></t:block>
+
+                                    <t:block t:replace="~{settings/settingsMacros :: settingsCollapsibleItem('personalizationSettingsContainer', 'format_paint', loc.get('settings.personalization'), false, settings.useDarkTheme,
+                                            ~{settings/containers/settingsContainer :: personalization(settings, validationErrors, toastContent, searchResultsPerPageOptions, false)})}"></t:block>
+
+                                    <t:block t:replace="~{settings/settingsMacros :: settingsCollapsibleItem('accountsSettingsContainer', 'account_balance', loc.get('settings.accounts'), false, settings.useDarkTheme,
+                                            ~{settings/containers/settingsContainer :: accounts(settings, toastContent)})}"></t:block>
+
+                                    <t:block t:replace="~{settings/settingsMacros :: settingsCollapsibleItem('transactionsSettingsContainer', 'list', loc.get('settings.transactions'), false, settings.useDarkTheme,
+                                            ~{settings/containers/settingsContainer :: transactions(settings, toastContent, transactionNameKeywords)})}"></t:block>
+
+                                    <t:block t:replace="~{settings/settingsMacros :: settingsCollapsibleItem('backupSettingsContainer', 'cloud_download', loc.get('settings.backup'), false, settings.useDarkTheme,
+                                            ~{settings/containers/settingsContainer :: backup(settings, validationErrors, toastContent, autoBackupTimes, nextBackupTime, autoBackupStatus)})}"></t:block>
+
+                                    <t:block t:replace="~{settings/settingsMacros :: settingsCollapsibleItem('updateSettingsContainer', 'system_update', loc.get('settings.updates'), false, settings.useDarkTheme,
+                                            ~{settings/containers/settingsContainer :: update(settings, build, toastContent)})}"></t:block>
+
+                                    <t:block t:replace="~{settings/settingsMacros :: settingsCollapsibleItem('miscSettingsContainer', 'miscellaneous_services', loc.get('settings.misc'), false, settings.useDarkTheme,
+                                            ~{settings/containers/settingsContainer :: misc(toastContent)})}"></t:block>
