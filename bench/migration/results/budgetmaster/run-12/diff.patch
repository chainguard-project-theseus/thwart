diff --git a/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html b/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html
new file mode 100644
index 00000000..1be5460a
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html
@@ -0,0 +1,103 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.categories.Category"
+      t:params="Settings settings, List<Notification> notifications, Map<String, String> validationErrors, List<String> categoryColors, Category category, String customColor, List<String> fontawesomeIcons">
+    <head t:with="title=${category.ID != null ? loc.get('title.category.edit') : loc.get('title.category.new')}">
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + title)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('categories', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="category.ID != null ? loc.get('title.category.edit') : loc.get('title.category.new')">New Category</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+
+                        <div class="container">
+                            <form name="NewCategory" t:action="@{/categories/newCategory}" method="post">
+                                <input type="hidden" name="ID" t:value="category.ID == null ? '' : '' + category.ID">
+                                <input type="hidden" name="type" t:value="category.type == null ? '' : '' + category.type">
+
+                                <!--/* name */-->
+                                <div class="row">
+                                    <div class="input-field col s12 m12 l8 offset-l2"
+                                         t:with="isNameEditingForbidden=${category.type == 'NONE' or category.type == 'REST'}">
+                                        <i class="material-icons prefix">edit</i>
+                                        <input id="category-name" type="text" name="name"
+                                               t:class="isNameEditingForbidden ? null : bm.validationClass(validationErrors, 'name', '')"
+                                               t:data-position="!isNameEditingForbidden and bm.hasError(validationErrors, 'name') ? 'bottom'"
+                                               t:data-delay="!isNameEditingForbidden and bm.hasError(validationErrors, 'name') ? 50"
+                                               t:data-validation-field="!isNameEditingForbidden and bm.hasError(validationErrors, 'name') ? 'name'"
+                                               t:value="bm.categoryName(category)" t:readonly="isNameEditingForbidden">
+                                        <label for="category-name" t:text="loc.get('category.new.label.name')">Name</label>
+                                    </div>
+                                </div>
+
+                                <!--/* color: rows of 6, the custom color picker ends the last row */-->
+                                <input type="hidden" name="color" id="categoryColor" t:value="category.color">
+                                <div class="row" t:each="rowColors, rowStat : acc.chunks(categoryColors, 6)">
+                                    <div t:each="color, colorStat : rowColors" t:class="colorStat.first ? 'col s2 m1 offset-m3 no-padding' : 'col s2 m1 no-padding'">
+                                        <div t:class="color == category.color ? 'category-color category-color-active' : 'category-color '" t:style="|background-color: ${css.color(color)}|"></div>
+                                    </div>
+                                    <!--/* add custom color picker */-->
+                                    <div t:if="rowStat.last" class="col s2 m1 no-padding">
+                                        <div id="customColorPickerContainer" t:class="customColor == category.color ? 'category-color category-color-active' : 'category-color '" t:style="|background-color: ${css.color(customColor)}|">
+                                            <span>+</span>
+                                        </div>
+                                    </div>
+                                </div>
+
+                                <!--/* icon */-->
+                                <div t:replace="~{helpers/iconSelect :: iconSelect('category-icon', category.iconReference, bm.fontColor(category, settings.useDarkTheme), category.color, category.name, '', '', false, settings)}"></div>
+
+                                <!--/* font color */-->
+                                <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(bm.fontColor(category, settings.useDarkTheme), acc.defaultFontColor(category, settings.useDarkTheme))}"></t:block>
+
+                                <br>
+
+                                <!--/* buttons */-->
+                                <div class="row hide-on-small-only">
+                                    <div class="col s6 right-align">
+                                        <a t:replace="~{helpers/header :: buttonLink('/categories', 'clear', 'cancel', '', 'red', '', false, false)}"></a>
+                                    </div>
+
+                                    <div class="col s6 left-align">
+                                        <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '')}"></button>
+                                    </div>
+                                </div>
+                                <div class="hide-on-med-and-up">
+                                    <div class="row center-align">
+                                        <div class="col s12">
+                                            <a t:replace="~{helpers/header :: buttonLink('/categories', 'clear', 'cancel', '', 'red', '', false, false)}"></a>
+                                        </div>
+                                    </div>
+                                    <div class="row center-align">
+                                        <div class="col s12">
+                                            <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '')}"></button>
+                                        </div>
+                                    </div>
+                                </div>
+                            </form>
+                        </div>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <div t:replace="~{helpers/iconSelect :: modalIconSelect('category-name', category.iconReference, fontawesomeIcons)}"></div>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <t:block t:replace="~{helpers/validation :: messages(validationErrors)}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/categories.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
