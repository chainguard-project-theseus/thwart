index 00000000..9c0314ce
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/settings/containers/settingsContainer.html
@@ -0,0 +1,628 @@
+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.Build, de.deadlocker8.budgetmaster.backup.AutoBackupTime, de.deadlocker8.budgetmaster.backup.BackupStatus, de.deadlocker8.budgetmaster.transactions.keywords.TransactionNameKeyword">
+<!--/*
+    The settings containers (FreeMarker: the macros of containers/*.ftl, wrapped by settingsContainer.settingsContainer).
+    Each one is used by settings/settings (inside its collapsible item) and by its own view
+    settings/containers/settingsX (the AJAX response of /settings/save/x), which adds the scripts the old
+    "importScripts=true" wrote. The form gets its CSRF input automatically (the old one had id="token").
+*/-->
+
+<!--/* FreeMarker: settingsContainer.settingsContainer, the hidden toast data read by settingsContainers.js */-->
+<div t:fragment="toast(String toastContent)" class="hidden securityContainerToastContent" t:text="toastContent"></div>
+
+<!--/* FreeMarker: settingsSecurity.securitySettingsContainer */-->
+<t:block t:fragment="security(Map<String, String> validationErrors, String toastContent)">
+    <form name="SecuritySettingsContainer" method="post" t:action="@{/settings/save/security}">
+        <div class="row">
+            <div class="input-field col s12 m12 l8 offset-l2">
+                <i class="material-icons prefix">vpn_key</i>
+                <input id="settings-password" type="password" name="password"
+                       t:class="bm.validationClass(validationErrors, 'password', '')" t:data-position="bm.hasError(validationErrors, 'password') ? 'bottom'" t:data-delay="bm.hasError(validationErrors, 'password') ? 50" t:data-validation-field="bm.hasError(validationErrors, 'password') ? 'password'"
+                       value="•••••">
+                <label for="settings-password" t:text="loc.get('settings.password')">Password</label>
+            </div>
+        </div>
+
+        <div class="row">
+            <div class="input-field col s12 m12 l8 offset-l2">
+                <i class="material-icons prefix">vpn_key</i>
+                <input id="settings-password-confirmation" type="password" name="passwordConfirmation"
+                       t:class="bm.validationClass(validationErrors, 'passwordConfirmation', '')" t:data-position="bm.hasError(validationErrors, 'passwordConfirmation') ? 'bottom'" t:data-delay="bm.hasError(validationErrors, 'passwordConfirmation') ? 50" t:data-validation-field="bm.hasError(validationErrors, 'passwordConfirmation') ? 'passwordConfirmation'"
+                       value="•••••">
+                <label for="settings-password-confirmation" t:text="loc.get('settings.password.confirmation')">Password Confirmation</label>
+            </div>
+        </div>
+
+        <div class="row">
+            <div class="col s12 center-align">
+                <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'background-green', '', false, '', '')}"></button>
+            </div>
+        </div>
+
+        <script>
+            $('#settings-password').on('change keydown paste input', function()
+            {
+                toggleSettingsContainerHeader('securitySettingsContainerHeader', false);
+            });
+            $('#settings-password-confirmation').on('change keydown paste input', function()
+            {
+                toggleSettingsContainerHeader('securitySettingsContainerHeader', false);
+            });
+        </script>
+    </form>
+
+    <div t:replace="~{settings/containers/settingsContainer :: toast(toastContent)}"></div>
+</t:block>
+
+<!--/* FreeMarker: settingsPersonalization.personalizationSettingsContainer */-->
+<t:block t:fragment="personalization(Settings settings, Map<String, String> validationErrors, String toastContent, List<Integer> searchResultsPerPageOptions, boolean showReloadWarning)">
+    <form name="PersonalizationSettingsContainer" method="post" t:action="@{/settings/save/personalization}">
+        <div class="row">
+            <div class="input-field col s12 m12 l8 offset-l2">
+                <i class="material-icons prefix">translate</i>
+                <select id="settings-language" name="language"
+                        t:class="bm.validationClass(validationErrors, 'language', '')" t:data-position="bm.hasError(validationErrors, 'language') ? 'bottom'" t:data-delay="bm.hasError(validationErrors, 'language') ? 50" t:data-validation-field="bm.hasError(validationErrors, 'language') ? 'language'">
+                    <option t:each="language : st.availableLanguages()" t:selected="settings.language == language" t:value="language.name" t:text="language.name">English</option>
+                </select>
+                <label for="settings-language" t:text="loc.get('settings.language')">Language</label>
+            </div>
+        </div>
+
+        <div class="row">
+            <div class="input-field col s12 m12 l8 offset-l2">
+                <i class="material-icons prefix">euro</i>
+                <input id="settings-currency" type="text" name="currency"
+                       t:class="bm.validationClass(validationErrors, 'currency', '')" t:data-position="bm.hasError(validationErrors, 'currency') ? 'bottom'" t:data-delay="bm.hasError(validationErrors, 'currency') ? 50" t:data-validation-field="bm.hasError(validationErrors, 'currency') ? 'currency'"
+                       t:value="settings.currency ?: ''">
+                <label for="settings-currency" t:text="loc.get('settings.currency')">Currency</label>
+            </div>
+        </div>
+
+        <!-- theme -->
+        <div class="row center-align">
+            <div class="col col s6 m6 l4 offset-l2">
+                <div t:text="loc.get('settings.darkTheme.deactivated')">Light Theme</div>
+                <img t:class="settings.useDarkTheme ? 'responsive-img settings-preview-image ' : 'responsive-img settings-preview-image settings-preview-image-selected'" t:src="@{/images/settings/themeLight.png}" data-use-dark-theme="false"/>
+            </div>
+
+            <div class="col col s6 m6 l4">
+                <div t:text="loc.get('settings.darkTheme.activated')">Dark Theme</div>
+                <img t:class="settings.useDarkTheme ? 'responsive-img settings-preview-image settings-preview-image-selected' : 'responsive-img settings-preview-image '" t:src="@{/images/settings/themeDark.png}" data-use-dark-theme="true"/>
+            </div>
+
+            <input type="hidden" id="useDarkTheme" name="useDarkTheme" t:value="settings.useDarkTheme"/>
+        </div>
+
+        <div t:replace="~{settings/settingsMacros :: switches(settings)}"></div>
+
+        <div class="row">
+            <div class="input-field col s12 m12 l8 offset-l2">
+                <i class="material-icons prefix">search</i>
+                <select id="settings-search-items-per-page" name="searchItemsPerPage"
+                        t:class="bm.validationClass(validationErrors, 'searchItemsPerPage', '')" t:data-position="bm.hasError(validationErrors, 'searchItemsPerPage') ? 'bottom'" t:data-delay="bm.hasError(validationErrors, 'searchItemsPerPage') ? 50" t:data-validation-field="bm.hasError(validationErrors, 'searchItemsPerPage') ? 'searchItemsPerPage'">
+                    <option t:each="number : searchResultsPerPageOptions" t:selected="settings.searchItemsPerPage == number" t:value="number" t:text="number">10</option>
+                </select>
+                <label for="settings-search-items-per-page" t:text="loc.get('settings.search.itemsPerPage')">Items per page</label>
+            </div>
+        </div>
+
+        <div class="row">
+            <div class="col s12 center-align">
+                <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'background-green', '', false, '', '')}"></button>
+            </div>
+        </div>
+
+        <div class="row notification-row" t:if="showReloadWarning">
+            <div class="col s12 center-align">
+                <div class="notification-wrapper">
+                    <div class="notification background-yellow text-black">
+                        <i class="fas fa-exclamation-triangle notification-item"></i>
+                        <span class="notification-item left-align" t:utext="loc.block('settings.personalization.reload.page')">Reload page</span>
+                    </div>
+                </div>
+            </div>
+        </div>
+
+        <script>
+
+            $('.settings-preview-image').click(function()
+            {
+                for(let item of document.getElementsByClassName('settings-preview-image'))
+                {
+                    item.classList.toggle('settings-preview-image-selected', false);
+                }
+
+                this.classList.toggle('settings-preview-image-selected', true);
+
+                document.getElementById('useDarkTheme').value = this.dataset.useDarkTheme;
+                toggleSettingsContainerHeader('personalizationSettingsContainerHeader', false);
+            });
+
+            // show unsaved changes warning
+            $('#settings-language').change(function()
+            {
+                toggleSettingsContainerHeader('personalizationSettingsContainerHeader', false);
+            });
+
+            $('#settings-currency').on('change keydown paste input', function()
