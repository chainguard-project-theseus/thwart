+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('menu.categories'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/customSelect.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('categories', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">label</i> <t:block t:text="loc.get('menu.categories')">Categories</t:block>
+                        </div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                        <br>
+                        <div class="center-align"><a t:replace="~{helpers/header :: buttonLink('/categories/newCategory', 'add', 'title.category.new', '', 'background-blue', '', false, false)}"></a></div>
+                        <br>
+
+                        <div class="container">
+                        <table class="bordered">
+                            <thead>
+                                <tr>
+                                    <th></th>
+                                    <th t:text="loc.get('category.new.label.name')">Name</th>
+                                    <th t:text="loc.get('categories.usages')">Usages</th>
+                                    <th t:text="loc.get('categories.actions')">Actions</th>
+                                </tr>
+                            </thead>
+                            <tbody>
+                                <tr t:each="category : categories" t:with="categoryName=${bm.categoryName(category)}">
+                                    <td><t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(category, '', false, true, settings)}"></t:block></td>
+                                    <td><t:block t:text="categoryName">name</t:block> </td>
+                                    <td><a t:href="'/search?searchCategory=true&searchText=' + categoryName" class="waves-effect waves-light text-default" t:text="bm.usageCount(category)">0</a></td>
+                                    <td>
+                                        <a t:replace="~{helpers/header :: buttonFlat('/categories/' + category.ID + '/edit', 'edit', '', '', 'no-padding text-default', '', false)}"></a>
+                                        <a t:replace="~{helpers/header :: buttonFlat('/search?searchCategory=true&searchText=' + categoryName, 'search', '', '', 'no-padding text-default', '', false)}"></a>
+                                        <a t:if="category.type == 'CUSTOM'" id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-category"
+                                           t:data-url="@{/categories/{id}/requestDelete(id=${category.ID})}">
+                                            <i class="material-icons left no-margin ">delete</i>
+                                        </a>
+                                    </td>
+                                </tr>
+                            </tbody>
+                        </table>
+                        <div t:if="categories.isEmpty()" class="headline center-align" t:text="loc.get('placeholder')">No data available</div>
