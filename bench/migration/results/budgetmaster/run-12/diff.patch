+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="account : accounts"><t:block t:replace="~{::accountOption(account, account.isSelected(), settings)}"></t:block></t:block>
+            </div>
+        </div>
+
+        <input type="hidden" class="hidden-input-custom-select" t:value="currentAccount.ID"/>
+    </div>
+</div>
+
+<div t:fragment="customAccountStateSelect(String selector, String inputName, List<AccountState> availableStates, AccountState selectedState, String inputClasses, String labelText, String id)"
+     class="row ">
