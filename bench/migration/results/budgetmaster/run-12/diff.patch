+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.icon.Icon, de.deadlocker8.budgetmaster.settings.Settings">
+
+<!--/*
+    FreeMarker: iconSelectMacros.iconSelect id item showBackground initialBackgroundClasses backgroundClasses preventFallbackIcon
+      iconReference   = item.iconReference (may be null)
+      fontColor       = bm.fontColor(item, settings.useDarkTheme)
+      backgroundColor = item.color, or null for showBackground=false
+      name            = item.name (may be null), its first letter is the fallback icon
+*/-->
+<div t:fragment="iconSelect(String id, Icon iconReference, String fontColor, String backgroundColor, String name, String initialBackgroundClasses, String backgroundClasses, boolean preventFallbackIcon, Settings settings)"
+     class="row">
+    <div class="input-field col s12 m12 l8 offset-l2" t:with="hasImageIcon=${iconReference != null and iconReference.isImageIcon()}, hasBuiltinIcon=${iconReference != null and iconReference.isBuiltinIcon()}">
+        <i class="fas fa-icons prefix"></i>
+        <label class="input-label" t:for="id" t:text="loc.get('account.new.label.icon')">Icon</label>
+
+        <div t:id="id" class="valign-wrapper item-icon">
+            <div class="item-icon-preview-container">
+                <a id="item-icon-preview" t:style="fontColor == null ? 'color: ' : |color: ${css.color(fontColor)}|">
+                    <script>var iconSelectAdditionalBackgroundClasses = [[${backgroundClasses}]];</script>
+                    <div id="item-icon-preview-background"
+                         t:class="settings.showCategoriesAsCircles != null and settings.showCategoriesAsCircles == false ? |category-circle category-circle-preview category-square ${initialBackgroundClasses}| : |category-circle category-circle-preview  ${initialBackgroundClasses}|"
+                         t:style="backgroundColor == null ? 'background-color: ' : |background-color: ${css.color(backgroundColor)}|">
+                        <i id="builtin-icon-preview-icon" t:class="hasBuiltinIcon ? iconReference.builtinIdentifier : 'hidden'"></i>
+                        <img id="item-icon-preview-icon" t:src="hasImageIcon ? @{/media/getImageByIconID/{id}(id=${iconReference.ID})} : ''"
+                             t:class="hasImageIcon ? ' item-icon-preview category-icon ' : ' item-icon-preview category-icon hidden'"/>
+                        <span t:if="!preventFallbackIcon" id="item-icon-fallback-name" t:class="hasBuiltinIcon or hasImageIcon ? 'hidden' : ''"
+                              t:text="strings.isEmpty(name) ? '' : strings.substring(strings.capitalize(name), 0, 1)">A</span>
+                    </div>
+                </a>
+                <a t:replace="~{helpers/header :: buttonFlat(null, 'delete', '', '', 'no-padding text-default button-remove-icon-from-item', '', false)}"></a>
+            </div>
+
+            <div id="item-icon-placeholder" t:text="loc.get('account.new.icon.placeholder')">Click preview to select an icon</div>
+
+            <input id="hidden-input-icon-image-id" type="hidden" name="iconImageID" t:value="hasImageIcon ? '' + iconReference.image.ID : ''">
+            <input id="hidden-input-icon-builtin-identifier" type="hidden" name="builtinIconIdentifier" t:value="hasBuiltinIcon ? iconReference.builtinIdentifier : ''">
+        </div>
+    </div>
+</div>
+
+<!--/*
+    FreeMarker: iconSelectMacros.modalIconSelect idToFocusOnClose item
+      idToFocusOnClose: one of 'account-name', 'category-name', 'template-name' (data-* only takes literals)
+      iconReference   = item.iconReference (may be null)
+      fontawesomeIcons: the controller's model attribute "fontawesomeIcons"
+*/-->
+<div t:fragment="modalIconSelect(String idToFocusOnClose, Icon iconReference, List<String> fontawesomeIcons)"
+     id="modalIconSelect" class="modal modal-fixed-footer background-color"
+     t:data-focus-on-close="idToFocusOnClose == 'account-name' ? 'account-name' : (idToFocusOnClose == 'category-name' ? 'category-name' : 'template-name')">
+    <div class="modal-content center-align" t:with="hasImageIcon=${iconReference != null and iconReference.isImageIcon()}">
+        <div class="row">
+            <div class="col s12">
+                <ul class="tabs" id="iconTabs">
+                    <li class="tab col s6"><a t:class="hasImageIcon ? 'text-blue valign-wrapper ' : 'text-blue valign-wrapper active'" href="#tabBuiltinIcons" data-name="builtinIcons"><i class="fas fa-icons"></i> <t:block t:text="loc.get('icons.builtin')">Built-in Icons</t:block></a></li>
+                    <li class="tab col s6"><a t:class="hasImageIcon ? 'text-blue valign-wrapper active' : 'text-blue valign-wrapper '" href="#tabImages" data-name="images"><i class="fas fa-image"></i> <t:block t:text="loc.get('icons.images')">Custom Images</t:block></a></li>
+                </ul>
+            </div>
+            <div id="tabBuiltinIcons" class="col s12">
+                <div class="row no-margin-bottom">
+                    <div class="input-field col s12 m12 l8 offset-l2">
+                        <i class="material-icons prefix">search</i>
+                        <input id="searchIcons" type="text" onchange="searchBuiltinIcons();" onkeypress="searchBuiltinIcons();" onpaste="searchBuiltinIcons()" oninput="searchBuiltinIcons();">
+                        <label for="searchIcons" t:text="loc.get('search')">Search</label>
+                    </div>
+                </div>
+                <div class="row">
+                    <div class="col s12 center-align" id="numberOfIcons"><span id="numberOfMatchingIcons" t:text="fontawesomeIcons.size()">0</span>/<t:block t:text="fontawesomeIcons.size()">0</t:block> <t:block t:text="loc.get('icons.numberOf')">Icons</t:block></div>
+                </div>
+
+                <hr>
+
+                <div class="row" t:with="selectedIconName=${iconReference != null and iconReference.isBuiltinIcon() ? iconReference.builtinIdentifier : ''}">
+                    <div t:each="icon : fontawesomeIcons" class="col s4 m2 l2 builtin-icon-option-column">
+                        <div t:class="selectedIconName == icon ? 'builtin-icon-option selected' : 'builtin-icon-option '">
+                            <i t:class="|builtin-icon-option-icon ${icon}|"></i>
+                            <div class="builtin-icon-option-name truncate" t:text="icon">icon</div>
+                        </div>
+                    </div>
+                </div>
+            </div>
+            <div id="tabImages" class="col s12">
+                <div class="row">
+                    <div class="col s12">
+                        <div class="headline" t:text="loc.get('upload.image.headline')">Upload image</div>
+                    </div>
+                </div>
+
+                <div class="row">
+                    <form id="form-upload-image" method="post" t:action="@{/media/uploadImage}" enctype="multipart/form-data">
+                        <div class="file-field input-field col s12">
+                            <div class="container">
+                                <div class="btn background-blue">
+                                    <i class="material-icons left">folder</i>
+                                    <t:block t:text="loc.get('account.new.icon.upload.choose.file')">Choose file</t:block>
+                                    <input id="inputUploadFile" type="file" t:accept="bm.validImageUploadTypes()" name="file">
+                                </div>
+                                <div class="file-path-wrapper">
+                                    <input class="file-path validate" type="text">
+                                </div>
+                                <a t:replace="~{helpers/header :: buttonLink(null, 'upload', 'account.new.icon.upload', 'button-upload-new-image', 'background-blue', 'right', false, false)}"></a>
+                            </div>
+                        </div>
+                    </form>
+
+                    <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.icon.upload.image.size'), 'fas fa-info', null)}"></t:block>
+                </div>
+
+                <hr>
+
+                <div class="row">
+                    <div class="col s12">
+                        <div class="headline" t:text="loc.get('available.images')">Available Images</div>
+                    </div>
+                </div>
+
+                <div class="preloader-wrapper active margin" id="progressIndicator">
+                    <div class="spinner-layer spinner-blue-only">
+                        <div class="circle-clipper left">
+                            <div class="circle"></div>
+                        </div>
+                        <div class="gap-patch">
+                            <div class="circle"></div>
+                        </div>
+                        <div class="circle-clipper right">
+                            <div class="circle"></div>
+                        </div>
+                    </div>
+                </div>
+
+                <div class="row" id="available-images"
+                     t:data-url="hasImageIcon ? @{/media/getAvailableImages/{id}(id=${iconReference.image.ID})} : @{/media/getAvailableImages}">
+                </div>
+            </div>
+        </div>
+    </div>
+    <div class="modal-footer background-color">
+        <a t:replace="~{helpers/header :: buttonLink(null, 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false)}"></a>
+        <a t:replace="~{helpers/header :: buttonLink(null, 'done', 'ok', 'button-icon-confirm', 'green', 'modal-action modal-close text-white', true, false)}"></a>
+    </div>
+</div>
+
+</t:block>
