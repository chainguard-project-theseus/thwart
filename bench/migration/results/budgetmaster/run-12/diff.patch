diff --git a/BudgetMasterServer/src/main/resources/templates/transactions/transactionsMacros.html b/BudgetMasterServer/src/main/resources/templates/transactions/transactionsMacros.html
new file mode 100644
index 00000000..250b7c66
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/transactionsMacros.html
@@ -0,0 +1,154 @@
+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.settings.Settings">
+
+<!--/* Tooltips with names: the text is in "title"; js/titleTooltips.js hands it (escaped) to Materialize's tooltip */-->
+<div t:fragment="transactionType(Transaction transaction, String size)" t:class="|col ${size} left-align transaction-row-transparent-child|">
+    <i t:if="transaction.isRepeating()" class="material-icons">repeat</i>
+    <i t:if="transaction.isTransfer()" class="material-icons tooltipped" data-position="bottom" t:title="|${transaction.account.name} ➔ ${transaction.transferAccount.name}|">swap_horiz</i>
+    <i t:if="!transaction.isRepeating() and !transaction.isTransfer()" class="material-icons invisible">repeat</i>
+</div>
+
+<div t:fragment="transactionCategory(Transaction transaction, String alignment, Settings settings)" t:class="|col s2 l1 xl1 ${alignment} transaction-row-transparent-child|">
+    <div class="hide-on-med-and-down">
+        <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(transaction.category, '', false, true, settings)}"></t:block>
+    </div>
+    <div class="hide-on-large-only">
+        <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(transaction.category, 'category-circle-small', false, true, settings)}"></t:block>
+    </div>
+</div>
+
+<div t:fragment="transactionNameAndDescription(Transaction transaction, String size)" t:class="|col ${size} transaction-row-transparent-child|">
+    <div class="truncate transaction-text" t:text="transaction.name">name</div>
+    <div class="hide-on-med-and-down">
+        <div t:if="transaction.description != null" class="italic" t:text="transaction.description">description</div>
+    </div>
+</div>
+
+<t:block t:fragment="transactionAmount(Transaction transaction, Account account, String size, Settings settings)">
+    <t:block t:with="amount=${bm.amountForAccount(transaction, account)}">
+        <div t:if="amount &lt;= 0" t:class="|col ${size} bold ${settings.useDarkTheme ? 'text-red-light' : 'text-red'} no-wrap right-align transaction-text transaction-row-transparent-child|" t:text="bm.currency(amount)">-1.00 €</div>
+        <div t:unless="amount &lt;= 0" t:class="|col ${size} bold ${settings.useDarkTheme ? 'text-green' : 'text-green-dark'} no-wrap right-align transaction-text transaction-row-transparent-child|" t:text="bm.currency(amount)">1.00 €</div>
+    </t:block>
+</t:block>
+
+<div t:fragment="transactionButtons(Transaction transaction, String classes)" t:class="|col ${classes} transaction-buttons no-wrap|">
+    <t:block t:if="transaction.isEditable()">
+        <t:block t:replace="~{::transactionEditButton(transaction)}"></t:block>
+        <a id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-transaction"
+           t:data-url="@{/transactions/{id}/requestDelete(id=${transaction.ID})}">
+            <i class="material-icons left no-margin ">delete</i>
+        </a>
+    </t:block>
+    <t:block t:if="transaction.isAllowedToFillNewTransaction()">
+        <a t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/newFromExisting', 'content_copy', '', '', 'no-padding text-default button-new-from-existing', '', false)}"></a>
+    </t:block>
+</div>
+
+<t:block t:fragment="transactionEditButton(Transaction transaction)">
+    <div t:if="transaction.isRepeating()" class="fixed-action-btn edit-transaction-button">
+        <a class="btn-floating btn-flat waves-effect waves-light no-padding text-default edit-transaction-button-link">
+            <i class="material-icons">edit</i>
+        </a>
+        <ul class="new-transaction-button-list">
+            <li>
+                <a t:href="@{/transactions/{id}/edit(id=${transaction.ID})}" class="btn-floating btn mobile-fab-tip no-wrap button-edit-all-occurrences" t:text="loc.get('title.transaction.edit', loc.get('title.transaction.new.normal'))">edit</a>
+                <a t:href="@{/transactions/{id}/edit(id=${transaction.ID})}" class="btn-floating btn background-green-dark"><i class="material-icons">edit</i></a>
+            </li>
+            <li>
+                <a t:href="@{/transactions/{id}/editFutureRepetitions(id=${transaction.ID})}" class="btn-floating btn mobile-fab-tip no-wrap button-edit-future-occurrences" t:text="loc.get('repeating.button.edit.future')">future</a>
+                <a t:href="@{/transactions/{id}/editFutureRepetitions(id=${transaction.ID})}" class="btn-floating btn background-orange"><i class="material-icons">move_up</i></a>
+            </li>
+        </ul>
+    </div>
+    <t:block t:unless="transaction.isRepeating()">
+        <a t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/edit', 'edit', '', '', 'no-padding text-default button-edit', '', false)}"></a>
+    </t:block>
+</t:block>
+
+<t:block t:fragment="transactionAccountIcon(Transaction transaction, Settings settings)">
+    <a t:if="bm.currentAccount().type == 'ALL' and transaction.account != null" t:href="@{/accounts/{id}/select(id=${transaction.account.ID})}">
+        <div class="col s2 l1 xl1 tooltipped no-padding transaction-row-transparent-child" data-position="bottom" t:title="transaction.account.name">
+            <div class="hide-on-med-and-down">
+                <div t:replace="~{helpers/customSelectMacros :: accountIcon(transaction.account, transaction.account.name, '', settings)}"></div>
+            </div>
+            <div class="hide-on-large-only">
+                <div t:replace="~{helpers/customSelectMacros :: accountIcon(transaction.account, transaction.account.name, 'category-circle-small', settings)}"></div>
+            </div>
+        </div>
+    </a>
+</t:block>
+
+<div t:fragment="transactionLinks(Transaction transaction, boolean newTab)" class="col s4 l2 xl1 right-align transaction-buttons no-wrap">
+    <a t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/highlight', 'open_in_new', '', '', 'no-padding text-default buttonHighlight', '', newTab)}"></a>
+    <t:block t:if="transaction.account.accountState == 'FULL_ACCESS'">
+        <a t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/edit', 'edit', '', '', 'no-padding text-default', '', newTab)}"></a>
+    </t:block>
+</div>
+
+<t:block t:fragment="placeholder(List<Transaction> transactions)">
+    <br>
+    <div class="row" t:if="transactions.size() == 0 or (transactions.size() == 2 and transactions[0].category.type == 'REST' and transactions[1].category.type == 'REST')">
+        <div class="col s12">
+            <div class="headline center-align" t:text="loc.get('placeholder.seems.empty')">empty</div>
+            <div class="headline-advice center-align" t:text="loc.get('placeholder.advice', loc.get('menu.transactions'))">advice</div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="buttons(boolean isFilterActive)">
+    <t:block t:with="currentAccount=${bm.currentAccount()}">
+        <div class="row hide-on-small-only valign-wrapper">
+            <t:block t:if="currentAccount.accountState == 'FULL_ACCESS'">
+                <div class="col s6 right-align transactions-buttons-col">
+                    <t:block t:replace="~{::buttonNew('new-transaction-button-list new-transaction-button-list-large', currentAccount)}"></t:block>
+                </div>
+                <div class="col s6 left-align">
+                    <a t:replace="~{::buttonFilter(isFilterActive)}"></a>
+                </div>
+            </t:block>
+            <div t:unless="currentAccount.accountState == 'FULL_ACCESS'" class="col s12 center-align">
+                <a t:replace="~{::buttonFilter(isFilterActive)}"></a>
+            </div>
+        </div>
+
+        <div class="hide-on-med-and-up center-align">
+            <div class="row center-align">
+                <div class="row center-align">
+                    <div class="col s12">
+                        <a t:replace="~{::buttonFilter(isFilterActive)}"></a>
+                    </div>
+                </div>
+                <div class="col s12 transactions-buttons-col">
+                    <t:block t:replace="~{::buttonNew('new-transaction-button-list ', currentAccount)}"></t:block>
+                </div>
+            </div>
+        </div>
+    </t:block>
+</t:block>
+
+<t:block t:fragment="buttonNew(String listClasses, Account currentAccount)">
+    <div t:if="currentAccount.accountState == 'FULL_ACCESS'" class="fixed-action-btn new-transaction-button">
+        <a class="btn-floating btn-large btn waves-effect waves-light background-blue" id="button-new-transaction">
+            <i class="material-icons left">add</i>[[${loc.get('title.transaction.new.short')}]]
+        </a>
+        <ul t:class="listClasses">
+            <li>
+                <a t:href="@{/templates}" class="btn-floating btn background-blue-baby"><i class="material-icons">file_copy</i></a>
+                <a t:href="@{/templates}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new.from.template')">template</a>
+            </li>
+            <li>
+                <a t:href="@{/transactions/newTransaction/transfer}" class="btn-floating btn background-green-dark"><i class="material-icons">swap_horiz</i></a>
+                <a t:href="@{/transactions/newTransaction/transfer}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new.transfer')">transfer</a>
+            </li>
+            <li>
+                <a t:href="@{/transactions/newTransaction/normal}" class="btn-floating btn background-orange"><i class="material-icons">payment</i></a>
+                <a t:href="@{/transactions/newTransaction/normal}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new.normal')">normal</a>
+            </li>
+        </ul>
+    </div>
+</t:block>
+
+<a t:fragment="buttonFilter(boolean isFilterActive)" href="#modalFilter" id="modalFilterTrigger"
+   t:class="isFilterActive ? 'modal-trigger waves-effect waves-light btn background-red' : 'modal-trigger waves-effect waves-light btn background-blue'"><i class="fas fa-filter left"></i>[[${isFilterActive ? loc.get('filter.active') : loc.get('title.filter')}]]</a>
+
+</t:block>
