@@ -0,0 +1,72 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings"
+      t:params="Settings settings, Boolean isError, Boolean isLogout, LocalDate currentDate">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('login.button'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/login.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <main>
+            <div class="row valign-wrapper full-height">
+                <div class="col l4 offset-l4 m6 offset-m3 s10 offset-s1">
+                    <div class="card" id="card-login">
+                        <div class="card-content">
+                            <div class="card-title">
+                                <div id="logo-container" class="center-align"><img t:replace="~{helpers/header :: logo('logo', '', settings.useDarkTheme)}"></div>
+                            </div>
+                            <form t:action="@{/login}" method="post" onsubmit="return validateLoginForm()">
+                                <input type="hidden" name="username" value="Default">
+
+                                <div class="row no-margin-bottom">
+                                    <div class="input-field col s12">
+                                        <input id="login-password" type="password" name="password">
+                                        <label for="login-password" t:text="loc.get('login.password')">Password</label>
+                                    </div>
+                                </div>
+
+                                <div class="row no-margin-bottom" t:if="isError != null">
+                                    <div class="col s12 center-align">
+                                        <table t:class="settings.useDarkTheme ? 'text-red-light login-message no-border-table' : 'text-red login-message no-border-table'">
+                                            <tbody>
+                                            <tr>
+                                                <td><i class="material-icons">warning</i></td>
+                                                <td id="loginMessage" t:text="loc.get('warning.wrong.password')">wrong</td>
+                                            </tr>
+                                            </tbody>
+                                        </table>
+                                    </div>
+                                </div>
+
+                                <div class="row no-margin-bottom" t:if="isLogout != null">
+                                    <div class="col s12 center-align">
+                                        <table t:class="settings.useDarkTheme ? 'text-green login-message no-border-table' : 'text-green-dark login-message no-border-table'">
+                                            <tbody>
+                                            <tr>
+                                                <td><i class="material-icons">info_outline</i></td>
+                                                <td id="loginMessage" t:text="loc.get('logout.success')">logout</td>
+                                            </tr>
+                                            </tbody>
+                                        </table>
+                                    </div>
+                                </div>
+
+                                <div class="row login-margin-top">
+                                    <div class="col s12 right-align">
+                                        <button t:replace="~{helpers/header :: buttonSubmit('action', 'send', 'login.button', '', 'background-blue', '', false, '', '')}"></button>
+                                    </div>
+                                </div>
+                            </form>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script>
+            var currentDateCookie = [[${'currentDate=' + bm.dateNormal(currentDate)}]];
+            document.cookie = currentDateCookie;
+        </script>
+    </body>
+</html>
