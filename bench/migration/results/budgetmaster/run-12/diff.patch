diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/header.html b/BudgetMasterServer/src/main/resources/templates/helpers/header.html
new file mode 100644
index 00000000..d2a636b9
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/header.html
@@ -0,0 +1,113 @@
+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.hints.Hint, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.icon.Iconizable, de.deadlocker8.budgetmaster.icon.Icon">
+
+<!--/* <head> content shared by all pages (FreeMarker: header.header) */-->
+<t:block t:fragment="head(String title)">
+    <title t:text="title">BudgetMaster</title>
+    <meta charset="UTF-8"/>
+    <link rel="stylesheet" t:href="@{/webjars/font-awesome/css/all.min.css}">
+    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
+    <link rel="stylesheet" t:href="@{/webjars/materializecss/css/materialize.min.css}">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/colors.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/style.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/navbar.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/categories.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/accounts.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/customSelect.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/hotkeys.css}"/>
+
+    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
+
+    <link rel="apple-touch-icon" t:href="@{/touch_icon.png}">
+</t:block>
+
+<img t:fragment="logo(String id, String classes, boolean darkTheme)" t:class="classes" t:id="id"
+     t:src="darkTheme ? @{/images/Logo_with_white_text_medium_res.png} : @{/images/Logo_with_text_medium_res.png}">
+
+<!--/* FreeMarker: header.content; shows the notifications above the page content */-->
+<t:block t:fragment="content(List<Notification> notifications, Fragment body)">
+    <t:block t:if="notifications != null">
+        <div class="row notification-row" t:each="notification, stat : notifications" t:id="|notification-${stat.index}|">
+            <div class="col s12 center-align">
+                <div class="notification-wrapper">
+                    <div t:class="|notification ${notification.backgroundColor} ${notification.textColor}|">
+                        <i t:if="notification.icon != null" t:class="|${notification.icon} notification-item|"></i>
+                        <!--/* notification messages are built in Java and may contain links */-->
+                        <span class="notification-item" t:utext="bm.notificationMessage(notification.message)">message</span>
+                        <a t:class="|notification-item notification-clear ${notification.textColor}|" t:data-id="stat.index">
+                            <i class="material-icons">clear</i>
+                        </a>
+                    </div>
+                </div>
+            </div>
+        </div>
+    </t:block>
+    <t:block t:replace="body"></t:block>
+</t:block>
+
+<!--/* FreeMarker: header.hint; actionUrl may be null */-->
+<t:block t:fragment="hint(Hint hint, String icon, String actionUrl)">
+    <div class="row" t:unless="hint.dismissed" t:id="|hint-${hint.ID}|">
+        <div class="col s12 center-align">
+            <div class="notification-wrapper">
+                <div class="notification notification-border text-default">
+                    <i t:class="|${icon} notification-item|"></i>
+                    <a t:if="actionUrl != null" t:href="actionUrl" class="text-default">
+                        <span class="notification-item left-align" t:text="loc.get(hint.localizationKey)">hint</span>
+                    </a>
+                    <span t:if="actionUrl == null" class="notification-item left-align" t:text="loc.get(hint.localizationKey)">hint</span>
+                    <a class="notification-item hint-clear text-default" t:data-url="@{/hints/dismiss/{id}(id=${hint.ID})}" t:data-id="hint.ID">
+                        <i class="material-icons">clear</i>
+                    </a>
+                </div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!--/* FreeMarker: header.buttonLink; url null = no href (noUrl), localizationKey '' = icon only */-->
+<a t:fragment="buttonLink(String url, String icon, String localizationKey, String id, String color, String classes, boolean disabled, boolean newTab)"
+   t:target="newTab ? '_blank'" t:href="url" t:id="id"
+   t:class="|waves-effect waves-light btn ${color} ${classes}|" t:disabled="disabled">
+    <i t:class="localizationKey == '' ? 'material-icons left no-margin' : 'material-icons left'" t:text="icon">icon</i><t:block t:if="localizationKey != ''" t:text="loc.get(localizationKey)">text</t:block>
+</a>
+
+<!--/* FreeMarker: header.buttonFlat */-->
+<a t:fragment="buttonFlat(String url, String icon, String localizationKey, String id, String classes, String iconClasses, boolean newTab)"
+   t:target="newTab ? '_blank'" t:href="url" t:id="id"
+   t:class="|waves-effect waves-light btn-flat ${classes}|">
+    <i t:class="localizationKey == '' ? |material-icons left no-margin ${iconClasses}| : |material-icons left  ${iconClasses}|" t:text="icon">icon</i><span t:if="localizationKey != ''" t:text="loc.get(localizationKey)">text</span>
+</a>
+
+<!--/* FreeMarker: header.buttonSubmit without formaction/onclick (write those buttons at the call site) */-->
+<button t:fragment="buttonSubmit(String name, String icon, String localizationKey, String id, String color, String classes, boolean disabled, String value, String form)"
+        t:id="id == '' ? null : id" t:class="|btn waves-effect waves-light ${color} ${classes}|" type="submit" t:name="name"
+        t:disabled="disabled" t:value="value == '' ? null : value" t:form="form == '' ? null : form">
+    <i t:class="localizationKey == '' ? 'material-icons left no-margin' : 'material-icons left'" t:text="icon">icon</i><t:block t:if="localizationKey != ''" t:text="loc.get(localizationKey)">text</t:block>
+</button>
+
+<!--/* FreeMarker: header.entityIcon */-->
+<t:block t:fragment="entityIcon(Icon iconReference, String classes, String fallbackName)">
+    <t:block t:if="iconReference != null and iconReference.isImageIcon()">
+        <img t:src="@{/media/getImageByIconID/{id}(id=${iconReference.ID})}" t:class="classes"/>
+    </t:block>
+    <t:block t:if="iconReference != null and !iconReference.isImageIcon() and iconReference.isBuiltinIcon()">
+        <i t:class="|${iconReference.builtinIdentifier} ${classes}|"></i>
+    </t:block>
+    <t:block t:if="iconReference == null or (!iconReference.isImageIcon() and !iconReference.isBuiltinIcon())" t:text="strings.substring(strings.capitalize(fallbackName), 0, 1)">A</t:block>
+</t:block>
+
+<!--/* FreeMarker: header.modalConfirmDelete; deleteUrl is the full confirm link */-->
+<div t:fragment="modalConfirmDelete(String title, String deleteUrl, String confirmButtonTextKey, String id, String classes, Fragment body)"
+     t:id="id" t:class="|modal background-color ${classes}|">
+    <div class="modal-content">
+        <h4 t:text="title">title</h4>
+        <t:block t:replace="body"></t:block>
+    </div>
+    <div class="modal-footer background-color">
+        <a t:replace="~{helpers/header :: buttonLink(null, 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false)}"></a>
+        <a t:replace="~{helpers/header :: buttonLink(deleteUrl, 'delete', confirmButtonTextKey, '', 'green', 'modal-action modal-close text-white', false, false)}"></a>
+    </div>
+</div>
+
+</t:block>
