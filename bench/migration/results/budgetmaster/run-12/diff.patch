+    </span>
+</div>
+
+<div t:fragment="accountIconWithValue(Account account, String accountName, String classes, Settings settings)"
+     t:class="account.iconReference != null and account.iconReference.isFallbackIcon() ? |category-circle ${classes} category-square account-square-border| : |category-circle ${classes} category-square |" t:data-value="account.ID">
+    <span t:style="|color: ${css.color(bm.fontColor(account, settings.useDarkTheme))}|">
+        <t:block t:replace="~{helpers/header :: entityIcon(account.iconReference, 'account-select-icon', accountName)}"></t:block>
+    </span>
+</div>
+
+<t:block t:fragment="accountStateContent(AccountState state, String classes)">
+    <div t:class="|category-circle category-circle-small ${classes}|" t:data-value="state == 'FULL_ACCESS' ? 'FULL_ACCESS' : (state == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN')">
+        <span class="text-blue">
+            <i t:class="state.icon"></i>
