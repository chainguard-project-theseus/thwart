diff --git a/BudgetMasterServer/src/main/resources/templates/firstUse.html b/BudgetMasterServer/src/main/resources/templates/firstUse.html
new file mode 100644
index 00000000..12186dfb
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/firstUse.html
@@ -0,0 +1,128 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="Settings settings, List<Notification> notifications">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('menu.firstUseGuide'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('firstUseGuide', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="fas fa-graduation-cap"></i> <t:block t:text="loc.get('home.first.use')">First use</t:block></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                    <br>
+
+                    <div class="container">
+                        <div class="container center-align">
+                            <div class="row left-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{::stepContent('home.first.use.step.1.headline', 'home.first.use.step.1.contentText', '/accounts', 'home.menu.accounts.action.manage', '', null)}"></t:block>
+                                </div>
+                            </div>
+                            <hr>
+
+                            <div class="row left-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{::stepContent('home.first.use.step.2.headline', 'home.first.use.step.2.contentText', '/categories', 'home.menu.categories.action.manage', '', null)}"></t:block>
+                                </div>
+                            </div>
+                            <hr>
+
+                            <div class="row left-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{::stepContent('home.first.use.step.3.headline', 'home.first.use.step.3.contentText', '/transactions/newTransaction/normal', 'home.menu.transactions.action.new', '', ~{::step3})}">
+                                        <step3 t:remove="tag">
+                                            <ul class="browser-default">
+                                                <li t:text="loc.get('home.first.use.step.3.sub.1')">sub 1</li>
+                                                <li t:text="loc.get('home.first.use.step.3.sub.2')">sub 2</li>
+                                                <li t:text="loc.get('home.first.use.step.3.sub.3')">sub 3</li>
+                                                <li t:text="loc.get('home.first.use.step.3.sub.4')">sub 4</li>
+                                                <li t:text="loc.get('home.first.use.step.3.sub.5')">sub 5</li>
+                                                <li t:text="loc.get('home.first.use.step.3.sub.6')">sub 6</li>
+                                            </ul>
+                                        </step3>
+                                    </t:block>
+                                </div>
+                            </div>
+                            <hr>
+
+                            <div class="row left-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{::stepContent('home.first.use.step.4.headline', 'home.menu.transactions', '/transactions', 'home.menu.transactions.action.manage', 'home.first.use.step.4.contentText', ~{::step4})}">
+                                        <step4 t:remove="tag">
+                                            <ul class="browser-default">
+                                                <li t:text="loc.get('home.first.use.step.4.sub.1')">sub 1</li>
+                                                <li t:text="loc.get('home.first.use.step.4.sub.2')">sub 2</li>
+                                            </ul>
+                                        </step4>
+                                    </t:block>
+                                </div>
+                            </div>
+                            <hr>
+
+                            <div class="row left-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{::stepContent('home.first.use.step.5.headline', 'home.first.use.step.5.contentText', '', '', '', ~{::step5})}">
+                                        <step5 t:remove="tag">
+                                            <h5 t:text="loc.get('menu.transactions.templates')">Templates</h5>
+                                            <p t:text="loc.get('home.first.use.step.5.sub.1')">sub 1</p>
+                                            <p>
+                                                <a t:replace="~{indexFunctions :: action('/templates', 'home.menu.templates.action.manage')}"></a>
+                                            </p>
+
+                                            <h5 t:text="loc.get('menu.charts')">Charts</h5>
+                                            <p t:text="loc.get('home.first.use.step.5.sub.2')">sub 2</p>
+                                            <p>
+                                                <a t:replace="~{indexFunctions :: action('/charts', 'home.menu.charts.action.manage')}"></a>
+                                            </p>
+
+                                            <h5 t:text="loc.get('menu.reports')">Reports</h5>
+                                            <p t:text="loc.get('home.first.use.step.5.sub.3')">sub 3</p>
+                                            <p>
+                                                <a t:replace="~{indexFunctions :: action('/reports', 'home.menu.reports.action.new')}"></a>
+                                            </p>
+
+                                            <h5 t:text="loc.get('home.first.use.step.5.sub.4')">and much more</h5>
+
+                                            <p class="center-align">
+                                                <a t:replace="~{helpers/header :: buttonLink('/', 'home', 'home.first.use.home', '', 'background-blue', '', false, false)}"></a>
+                                            </p>
+                                        </step5>
+                                    </t:block>
+                                </div>
+                            </div>
+                        </div>
+                    </div>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+
+        <t:block t:remove="all">
+            <!--/* FreeMarker: indexFunctions.stepContent. The old macro wrote <#nested> inside the <p> of the content text
+                   (browsers closed the <p> before the nested <ul>/<h5>); the nested content now follows the <p>. */-->
+            <t:block t:fragment="stepContent(String headline, String contentText, String actionUrl, String actionName, String extraTextKey, Fragment nested)">
+                <h5 t:text="loc.get(headline)">Step</h5>
+                <p>[(${loc.html(contentText)})]<t:block t:if="extraTextKey != ''"><br>[[${loc.get(extraTextKey)}]]</t:block></p>
+                <t:block t:replace="nested"></t:block>
+                <!--/* the old markup closed the <p> twice; browsers turned the second </p> into an empty paragraph */-->
+                <t:block t:if="nested != null"><p></p></t:block>
+                <p>
+                    <t:block t:if="actionUrl != ''">
+                        <a t:replace="~{indexFunctions :: action(actionUrl, actionName)}"></a>
+                    </t:block>
+                </p>
+            </t:block>
+        </t:block>
+    </body>
+</html>
