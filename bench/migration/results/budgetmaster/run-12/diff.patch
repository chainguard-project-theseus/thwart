diff --git a/BudgetMasterServer/src/main/resources/static/js/titleTooltips.js b/BudgetMasterServer/src/main/resources/static/js/titleTooltips.js
new file mode 100644
index 00000000..4db883f2
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/static/js/titleTooltips.js
@@ -0,0 +1,26 @@
+// Tooltips whose text comes from data are rendered with the text in the "title" attribute
+// (Tessera does not put data strings into data-* attributes). Materialize's tooltip only takes HTML,
+// so the text is escaped and passed through its API; the title is removed to avoid a second native tooltip.
+function initTitleTooltips(root)
+{
+    $(root).find('.tooltipped[title]').each(function()
+    {
+        let text = this.getAttribute('title');
+        this.removeAttribute('title');
+
+        let escapeHelper = document.createElement('div');
+        escapeHelper.textContent = text;
+
+        let existing = M.Tooltip.getInstance(this);
+        if(existing !== undefined)
+        {
+            existing.destroy();
+        }
+        M.Tooltip.init(this, {html: escapeHelper.innerHTML});
+    });
+}
+
+$(document).ready(function()
+{
+    initTitleTooltips(document);
+});
