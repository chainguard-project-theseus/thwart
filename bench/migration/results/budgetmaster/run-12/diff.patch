diff --git a/BudgetMasterServer/src/main/resources/templates/charts/newChart.html b/BudgetMasterServer/src/main/resources/templates/charts/newChart.html
new file mode 100644
index 00000000..f20781c3
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/charts/newChart.html
@@ -0,0 +1,101 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.charts.Chart"
+      t:params="Settings settings, List<Notification> notifications, Chart chart, Map<String, String> validationErrors"
+      t:with="title=${chart.ID != null ? loc.get('title.chart.edit') : loc.get('title.chart.new')}, isDefault=${chart.type == 'DEFAULT'}">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + title)}"></t:block>
+        <link rel="stylesheet" t:href="@{/webjars/codemirror/lib/codemirror.css}">
+        <link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('charts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="title">New Chart</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                    <div class="container">
+                    <form name="NewChart" t:action="@{/charts/newChart}" method="post">
+                        <input type="hidden" name="ID" t:value="chart.ID == null ? '' : '' + chart.ID">
+
+                        <!--/* name */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">edit</i>
+                                <input id="chart-name" type="text" name="name"
+                                       t:class="bm.validationClass(validationErrors, 'name', '')"
+                                       t:data-position="bm.hasError(validationErrors, 'name') ? 'bottom'"
+                                       t:data-delay="bm.hasError(validationErrors, 'name') ? 50"
+                                       t:data-validation-field="bm.hasError(validationErrors, 'name') ? 'name'"
+                                       t:value="ch.chartName(chart)" t:disabled="isDefault">
+                                <label for="chart-name" t:text="loc.get('chart.new.label.name')">Name</label>
+                            </div>
+                        </div>
+
+                        <!-- info message with link to wiki on how to create custom charts -->
+                        <t:block t:if="chart.type == 'CUSTOM'">
+                            <div t:replace="~{charts/chartFunctions :: infoMessage(loc.block('chart.new.info.wiki'))}"></div>
+                        </t:block>
+
+                        <!--/* script */-->
+                        <div class="row">
+                            <div class="input-field col sl2" style="width: 100%">
+                                <textarea id="chart-script" name="script"
+                                          t:class="bm.validationClass(validationErrors, 'script', 'materialize-textarea')"
+                                          t:data-position="bm.hasError(validationErrors, 'script') ? 'bottom'"
+                                          t:data-delay="bm.hasError(validationErrors, 'script') ? 50"
+                                          t:data-validation-field="bm.hasError(validationErrors, 'script') ? 'script'"
+                                          t:text="chart.script"></textarea>
+                            </div>
+                        </div>
+
+                        <br>
+
+                        <!--/* info message if chart is not editable */-->
+                        <t:block t:if="isDefault">
+                            <div t:replace="~{charts/chartFunctions :: infoMessage(loc.block('chart.new.info.default'))}"></div>
+                        </t:block>
+
+                        <!--/* buttons */-->
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <a t:replace="~{helpers/header :: buttonLink('/charts/manage', 'clear', 'cancel', '', 'red', '', false, false)}"></a>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', isDefault, '', '')}"></button>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <a t:replace="~{helpers/header :: buttonLink('/charts/manage', 'clear', 'cancel', '', 'red', '', false, false)}"></a>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', isDefault, '', '')}"></button>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <t:block t:replace="~{helpers/validation :: messages(validationErrors)}"></t:block>
+        <script t:src="@{/webjars/codemirror/lib/codemirror.js}"></script>
+        <script t:src="@{/webjars/codemirror/mode/javascript/javascript.js}"></script>
+        <script t:src="@{/js/charts.js}"></script>
+    </body>
+</html>
