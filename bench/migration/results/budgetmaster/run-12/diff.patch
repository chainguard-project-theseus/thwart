index 00000000..4752d48e
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/accounts/accounts.html
@@ -0,0 +1,154 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountsFilterConfiguration"
+      t:params="Settings settings, List<Notification> notifications, List<Account> accounts, AccountsFilterConfiguration accountsFilterConfiguration, Boolean accountNotDeletable, Account currentAccount">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('menu.accounts'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('accounts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">account_balance</i> <t:block t:text="loc.get('menu.accounts')">Accounts</t:block></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                        <br>
+                        <div class="center-align"><a t:replace="~{helpers/header :: buttonLink('/accounts/newAccount', 'add', 'title.account.new', 'button-new-account', 'background-blue', '', false, false)}"></a></div>
+                        <br>
+                        <div class="container account-container">
+                            <form name="AccountsFilter" t:action="@{/accounts/applyFilter}" method="post">
+                                <table class="bordered">
+                                    <thead class="hide-on-med-and-down">
+                                        <tr>
+                                            <th></th>
+                                            <th>
+                                                <div t:text="loc.get('account.new.label.state')">Visibility</div>
+                                                <div>
+                                                    <label>
+                                                        <input type="checkbox" name="includeFullAccess" t:checked="accountsFilterConfiguration != null and accountsFilterConfiguration.includeFullAccess"/>
+                                                        <span><i class="fas fa-edit placeholder-icon-right"></i><t:block t:text="loc.get('account.state.full.access')">Full access</t:block></span>
+                                                    </label>
+                                                </div>
+                                                <div>
+                                                    <label>
+                                                        <input type="checkbox" name="includeReadOnly" t:checked="accountsFilterConfiguration != null and accountsFilterConfiguration.includeReadOnly"/>
+                                                        <span><i class="fas fa-lock placeholder-icon-right"></i><t:block t:text="loc.get('account.state.read.only')">Read-only</t:block></span>
+                                                    </label>
+                                                </div>
+                                                <div>
+                                                    <label>
+                                                        <input type="checkbox" name="includeHidden" t:checked="accountsFilterConfiguration != null and accountsFilterConfiguration.includeHidden"/>
+                                                        <span id="includeHidden"><i class="far fa-eye-slash placeholder-icon-right"></i><t:block t:text="loc.get('account.state.hidden')">Hidden</t:block></span>
+                                                    </label>
+                                                </div>
+                                            </th>
+                                            <th>
+                                                <div t:text="loc.get('account.new.label.endDate')">End Date</div>
+                                                <div>
+                                                    <label>
+                                                        <input type="checkbox" name="includeWithEndDate" t:checked="accountsFilterConfiguration != null and accountsFilterConfiguration.includeWithEndDate"/>
+                                                        <span><i class="fas fa-bell placeholder-icon-right"></i><t:block t:text="loc.get('account.label.endDate.with')">with</t:block></span>
+                                                    </label>
+                                                </div>
+                                                <div>
+                                                    <label>
+                                                        <input type="checkbox" name="includeWithoutEndDate" t:checked="accountsFilterConfiguration != null and accountsFilterConfiguration.includeWithoutEndDate"/>
+                                                        <span><i class="fas fa-bell-slash placeholder-icon-right"></i><t:block t:text="loc.get('account.label.endDate.without')">without</t:block></span>
+                                                    </label>
+                                                </div>
+                                            </th>
+                                            <th>
+                                                <div t:text="loc.get('account.new.label.name')">Name</div>
+                                                <div class="input-field">
+                                                    <input type="text" name="name" t:value="accountsFilterConfiguration != null ? (accountsFilterConfiguration.name ?: '') : ''"/>
+                                                </div>
+                                            </th>
+                                            <th>
+                                                <div t:text="loc.get('transaction.new.label.description')">Description</div>
+                                                <div class="input-field">
+                                                    <input type="text" name="description" t:value="accountsFilterConfiguration != null ? (accountsFilterConfiguration.description ?: '') : ''"/>
+                                                </div>
+                                            </th>
+                                            <th class="vertical-align-middle">
+                                                <button class="btn waves-effect waves-light background-green" type="submit" id="accounts-filter-button">
+                                                    <i class="fas fa-filter left"></i><t:block t:text="loc.get('filter.apply')">Apply Filter</t:block>
+                                                </button>
+                                            </th>
+                                        </tr>
+                                    </thead>
+
+                                    <tbody>
+                                        <t:block t:each="account : accounts">
+                                            <tr t:if="account.type == 'CUSTOM'" class="account-overview-row">
+                                                <td><div t:replace="~{helpers/customSelectMacros :: accountIcon(account, account.name, 'text-blue', settings)}"></div></td>
+                                                <td>
+                                                    <t:block t:if="account.accountState == 'READ_ONLY'">
+                                                        <div class="placeholder-icon placeholder-icon-right"></div>
+                                                        <i class="fas fa-lock placeholder-icon-right"></i>
+                                                    </t:block>
+                                                    <t:block t:if="account.accountState == 'HIDDEN'">
+                                                        <div class="placeholder-icon placeholder-icon-right"></div>
+                                                        <i class="far fa-eye-slash placeholder-icon-right"></i>
+                                                    </t:block>
+                                                    <t:block t:if="account.accountState != 'READ_ONLY' and account.accountState != 'HIDDEN'">
+                                                        <!--/* tooltip text in aria-label; accounts.js passes it to M.Tooltip (data-tooltip takes no data) */-->
+                                                        <a t:href="@{/accounts/{id}/setAsDefault(id=${account.ID})}" class="btn-flat no-padding text-default tooltipped" data-position="left" t:aria-label="loc.get('account.tooltip.default')"><i class="material-icons left" t:text="account.isDefault() ? 'star' : 'star_border'">star</i></a>
+                                                        <i class="fas fa-edit placeholder-icon-right"></i>
+                                                    </t:block>
+                                                </td>
+                                                <td>
+                                                    <t:block t:if="account.endDate != null">
+                                                        <i class="fas fa-bell placeholder-icon-right"></i> <t:block t:text="bm.dateNormal(account.endDate)">01.01.2020</t:block>
+                                                    </t:block>
+                                                    <div t:if="account.endDate == null" class="placeholder-icon"></div>
+                                                </td>
+                                                <td t:text="account.name">name</td>
+                                                <td>
+                                                    <div class="truncate account-description" t:text="account.description">
+                                                        description
+                                                    </div>
+                                                </td>
+                                                <td>
+                                                    <a t:href="@{/accounts/{id}/edit(id=${account.ID})}" class="btn-flat no-padding text-default"><i class="material-icons left">edit</i></a>
+                                                    <a id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-account"
+                                                       t:data-url="@{/accounts/{id}/requestDelete(id=${account.ID})}">
+                                                        <i class="material-icons left no-margin ">delete</i>
+                                                    </a>
+                                                </td>
+                                            </tr>
+                                        </t:block>
+                                    </tbody>
+                                </table>
+                            </form>
+                            <div t:if="accounts.isEmpty()" class="headline center-align" t:text="loc.get('placeholder')">No data available</div>
+                        </div>
+                    </page-content>
+                </t:block>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+        <t:block t:if="accountNotDeletable != null">
+            <!-- warning account not deletable -->
+            <div id="modalAccountNotDeletable" class="modal background-color">
+                <div class="modal-content">
+                    <h4 t:text="loc.get('info.title.account.delete')">Delete Account</h4>
+                    <p t:text="loc.get('warning.text.account.delete', currentAccount.name)">text</p>
+                </div>
+                <div class="modal-footer background-color">
+                    <a t:replace="~{helpers/header :: buttonLink('/accounts', 'done', 'ok', 'buttonCloseWhatsNew', 'green', 'modal-action modal-close text-white', false, false)}"></a>
+                </div>
+            </div>
+        </t:block>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/accounts.js}"></script>
+    </body>
+</html>
