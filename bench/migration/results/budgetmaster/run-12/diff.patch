+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account"
+      t:params="Settings settings, List<Notification> notifications, Map<String, String> validationErrors, List<String> localizedMonthNames, List<String> localizedWeekdays, boolean isEdit, List<Category> categories, List<Account> accounts, Template template, String suggestionsJSON, List<String> fontawesomeIcons, Boolean csvImportInProgress"
+      t:with="title=${isEdit ? loc.get('title.template.edit') : loc.get('title.template.new')}">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + title)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="title">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                    <div class="container">
+                    <form id="mainForm" name="NewTemplate" t:action="@{/templates/newTemplate}" method="post">
+                        <input type="hidden" name="ID" t:value="template.ID == null ? '' : '' + template.ID">
+                        <input type="hidden" name="templateGroup" t:value="template.templateGroup == null ? '' : '' + template.templateGroup.ID">
+
+                        <!--/* isPayment switch */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: isExpenditureSwitch(template.isExpenditure())}"></t:block>
+
+                        <!--/* template name */-->
+                        <div t:replace="~{templates/templateFunctions :: templateNameInput(template.templateName, validationErrors)}"></div>
+
+                        <!--/* name */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(template.name, suggestionsJSON, validationErrors)}"></t:block>
+
+                        <!--/* amount */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(template.amount, validationErrors)}"></t:block>
+
+                        <!--/* category */-->
+                        <div t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, template.category, 'col s12 m12 l8 offset-l2', loc.get('transaction.new.label.category'), 'transaction-category', true, '', false, '', settings)}"></div>
+
+                        <!--/* description */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionDescription(template.description, validationErrors)}"></t:block>
+
+                        <!--/* tags */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(template.tags)}"></t:block>
+
+                        <!--/* account */-->
+                        <div t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-account', 'includeAccount', loc.get('template.checkbox.include.account'), template.account != null)}"></div>
+                        <div t:replace="~{helpers/customSelectMacros :: customAccountSelect('account-select-wrapper', 'account', accounts, template.account != null ? template.account : bm.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', '', 'transaction-account', template.account == null, settings)}"></div>
+
+                        <!--/* transfer account */-->
+                        <div t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-transfer-account', 'includeTransferAccount', loc.get('template.checkbox.include.account.transfer'), template.transferAccount != null)}"></div>
+                        <div t:replace="~{helpers/customSelectMacros :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, template.transferAccount != null ? template.transferAccount : bm.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', '', 'transaction-destination-account', template.transferAccount == null, settings)}"></div>
+
+                        <!--/* icon */-->
+                        <div t:replace="~{templates/templateIconSelect :: iconSelect(template, settings)}"></div>
+
+                        <!--/* font color */-->
+                        <t:block t:replace="~{templates/templateIconSelect :: fontColorPicker(template, settings)}"></t:block>
+
+                        <!--/* buttons */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: buttons('/templates', false, true, csvImportInProgress)}"></t:block>
+                    </form>
+
+                    <div id="transactionNameKeywordWarningModalContainer"></div>
+                </div>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <div t:replace="~{templates/templateIconSelect :: modalIconSelect(template, fontawesomeIcons)}"></div>
+
+        <!-- Pass localization to JS -->
+        <script t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <t:block t:replace="~{helpers/validation :: messages(validationErrors)}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
