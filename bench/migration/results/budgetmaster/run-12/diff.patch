+package de.deadlocker8.budgetmaster.templating;
+
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.SafeInlineHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Replaces FreeMarker's {@code locale.getString(...)} (de.thecodelabs Localization).
+ */
+@TemplateFunctions("loc")
+public final class LocalizationFunctions
+{
+	private static final HtmlPolicy INLINE_POLICY = HtmlPolicy.inlineBuilder().allowElements("b", "i", "br", "span").build();
+	private static final HtmlPolicy BLOCK_POLICY = HtmlPolicy.builder().allowElements("b", "i", "br", "span", "a").allowLinkTarget().linkRel().build();
+
+	private LocalizationFunctions()
+	{
+	}
+
+	@TemplateFunction
+	public static String get(String key)
+	{
+		return Localization.getString(key);
+	}
+
+	@TemplateFunction
+	public static String get(String key, Object arg1)
+	{
+		return Localization.getString(key, arg1);
+	}
+
+	@TemplateFunction
+	public static String get(String key, Object arg1, Object arg2)
+	{
+		return Localization.getString(key, arg1, arg2);
+	}
+
+	@TemplateFunction
+	public static String get(String key, Object arg1, Object arg2, Object arg3)
+	{
+		return Localization.getString(key, arg1, arg2, arg3);
+	}
+
+	/**
+	 * A message whose bundle text contains inline markup ({@code <br>}, {@code <b>}); arguments are escaped.
+	 */
+	@TemplateFunction
+	public static SafeInlineHtml html(String key)
+	{
+		return SafeInlineHtml.sanitize(Localization.getString(key), INLINE_POLICY);
+	}
+
+	@TemplateFunction
+	public static SafeInlineHtml html(String key, Object arg1)
+	{
+		return SafeInlineHtml.sanitize(Localization.getString(key, escape(arg1)), INLINE_POLICY);
+	}
+
+	@TemplateFunction
+	public static SafeInlineHtml html(String key, Object arg1, Object arg2)
+	{
+		return SafeInlineHtml.sanitize(Localization.getString(key, escape(arg1), escape(arg2)), INLINE_POLICY);
+	}
+
+	@TemplateFunction
+	public static SafeInlineHtml html(String key, Object arg1, Object arg2, Object arg3)
+	{
+		return SafeInlineHtml.sanitize(Localization.getString(key, escape(arg1), escape(arg2), escape(arg3)), INLINE_POLICY);
+	}
+
+	/**
+	 * A message whose bundle text contains links; must be inserted where block content is allowed.
+	 */
+	@TemplateFunction
+	public static SafeHtml block(String key)
+	{
+		return SafeHtml.sanitize(Localization.getString(key), BLOCK_POLICY);
+	}
+
+	private static Object escape(Object value)
+	{
+		if(!(value instanceof CharSequence))
+		{
+			return value;
+		}
+		return value.toString().replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;");
+	}
+}
