+            <i class="material-icons left ">file_copy</i><t:block t:text="loc.get('save.as.template')">Create template</t:block>
+        </a>
+    </div>
+
+    <script>
+        var existingTemplateNames = [[${tf.jsonStringList(existingTemplateNames)}]];
+    </script>
+</div>
