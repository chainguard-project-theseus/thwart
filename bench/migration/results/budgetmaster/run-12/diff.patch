+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.templategroup.TemplateGroup, de.deadlocker8.budgetmaster.settings.Settings">
+
+<t:block t:fragment="buttonNew">
+    <a t:replace="~{helpers/header :: buttonLink('/templates/newTemplate', 'add', 'title.template.new', '', 'background-blue', '', false, false)}"></a>
+</t:block>
+
+<t:block t:fragment="buttonEditTemplateGroups">
+    <a t:replace="~{helpers/header :: buttonLink('/templateGroups', 'folder', 'title.template.group.edit.short', '', 'background-blue', '', false, false)}"></a>
+</t:block>
+
+<t:block t:fragment="buttons">
+    <div class="row valign-wrapper hide-on-small-only">
+        <div class="col s6 right-align">
+            <a t:replace="~{::buttonNew}"></a>
+        </div>
+
+        <div class="col s6 left-align">
+            <a t:replace="~{::buttonEditTemplateGroups}"></a>
+        </div>
+    </div>
+    <div class="hide-on-med-and-up">
+        <div class="row valign-wrapper center-align">
+            <div class="col s12">
+                <a t:replace="~{::buttonNew}"></a>
+            </div>
+        </div>
+        <div class="row valign-wrapper center-align">
+            <div class="col s12">
+                <a t:replace="~{::buttonEditTemplateGroups}"></a>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="listTemplates(Map<TemplateGroup, List<Template>> templatesByGroup, Settings settings)">
+    <div class="container">
+        <div class="row">
+            <div class="col s12">
+                <ul t:each="entry : templatesByGroup" class="collapsible expandable templateCollapsible" t:data-group-id="entry.key.ID">
+                    <div t:if="templatesByGroup.size() != 1" class="template-group-headline" t:text="entry.key.type == 'DEFAULT' ? loc.get('template.group.default') : entry.key.name">group</div>
+
+                    <t:block t:each="template : entry.value"><li t:replace="~{::templateItem(template, settings)}"></li></t:block>
+                </ul>
+            </div>
+        </div>
+    </div>
+
+     <form id="form-move-template-to-group" method="post" t:action="@{/templateGroups/moveTemplateToGroup}">
+        <input type="hidden" name="templateID" value=""/>
+        <input type="hidden" name="groupID" value=""/>
+     </form>
+</t:block>
+
+<li t:fragment="templateItem(Template template, Settings settings)" class="template-item z-depth-2" t:data-template-id="template.ID">
+    <div class="collapsible-header bold">
+        <t:block t:replace="~{::templateHeader(template, settings)}"></t:block>
+        <div class="collapsible-header-button">
+            <a t:replace="~{helpers/header :: buttonFlat('/templates/' + template.ID + '/edit', 'edit', '', '', 'no-padding text-default', '', false)}"></a>
+            <!--/* header.buttonFlat with isDataUrl */-->
+            <a id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-template" t:data-url="@{/templates/{id}/requestDelete(id=${template.ID})}">
+                <i class="material-icons left no-margin ">delete</i>
+            </a>
+            <a t:replace="~{helpers/header :: buttonLink('/templates/' + template.ID + '/select', 'note_add', '', '', 'background-blue', 'button-select-template', false, false)}"></a>
+        </div>
+    </div>
+    <div class="collapsible-body">
+        <div class="row no-margin-bottom">
+            <table class="table-template-content text-default">
+                <tbody>
+                <tr t:if="!strings.isEmpty(template.name)">
+                    <td class="template-content-label" t:text="loc.get('transaction.new.label.name')">Name</td>
+                    <td t:text="template.name">name</td>
+                </tr>
+                <tr t:if="template.amount != null">
+                    <td class="template-content-label" t:text="loc.get('transaction.new.label.amount')">Amount</td>
+                    <td t:text="bm.currency(template.amount)">amount</td>
+                </tr>
+                <tr t:if="template.category != null">
+                    <td class="template-content-label" t:text="loc.get('transaction.new.label.category')">Category</td>
+                    <td t:text="bm.categoryName(template.category)">category</td>
+                </tr>
+                <tr t:if="!strings.isEmpty(template.description)">
+                    <td class="template-content-label" t:text="loc.get('transaction.new.label.description')">Description</td>
+                    <td t:text="template.description">description</td>
+                </tr>
+                <tr t:if="template.tags != null and !template.tags.isEmpty()">
+                    <td class="template-content-label" t:text="loc.get('transaction.new.label.tags')">Tags</td>
+                    <td class="chips-placeholder">
+                        <div t:each="tag : template.tags" class="chip" t:text="tag.name">tag</div>
+                    </td>
+                </tr>
+                <tr t:if="template.account != null">
+                    <td class="template-content-label" t:text="loc.get('transaction.new.label.account')">Account</td>
+                    <td t:text="template.account.name">account</td>
+                </tr>
+                <tr t:if="template.transferAccount != null">
+                    <td class="template-content-label" t:text="loc.get('transaction.new.label.transfer.account')">Transfer account</td>
+                    <td t:text="template.transferAccount.name">account</td>
+                </tr>
+                </tbody>
+            </table>
+        </div>
+    </div>
+</li>
+
+<t:block t:fragment="templateHeader(Template template, Settings settings)">
+    <span t:style="|color: ${css.color(bm.fontColor(template, settings.useDarkTheme))}|"
+          t:with="hasIcon=${template.iconReference != null and (template.iconReference.isImageIcon() or template.iconReference.isBuiltinIcon())}">
+        <t:block t:if="hasIcon"><t:block t:replace="~{helpers/header :: entityIcon(template.iconReference, 'template-icon', '')}"></t:block></t:block>
+        <i t:if="!hasIcon and template.transferAccount != null" class="material-icons">swap_horiz</i>
+        <i t:if="!hasIcon and template.transferAccount == null" class="material-icons">payment</i>
+    </span>
+    <div class="truncate template-header-name" t:text="template.templateName">name</div>
+</t:block>
+
+<div t:fragment="templateNameInput(String templateName, Map<String, String> validationErrors)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <i class="material-icons prefix">file_copy</i>
+        <input id="template-name" type="text" name="templateName"
+               t:class="bm.validationClass(validationErrors, 'templateName', '')" t:data-position="bm.hasError(validationErrors, 'templateName') ? 'bottom'" t:data-delay="bm.hasError(validationErrors, 'templateName') ? 50" t:data-validation-field="bm.hasError(validationErrors, 'templateName') ? 'templateName'"
+               t:value="templateName ?: ''">
+        <label for="template-name" t:text="loc.get('template.new.label.name')">Template name</label>
+    </div>
+</div>
+
+<div t:fragment="templateIncludeAccountCheckbox(String id, String name, String label, boolean checked)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2">
