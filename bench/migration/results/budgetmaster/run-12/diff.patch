+                    <div class="section center-align">
+                        <div class="headline" t:text="title">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                    <div class="container">
+                    <form name="NewTemplateGroup" t:action="@{/templateGroups/newTemplateGroup}" method="post" onsubmit="return validateForm(true)">
+                        <input type="hidden" name="ID" t:value="templateGroup.ID == null ? '' : '' + templateGroup.ID">
+
+                        <!--/* template group name */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">file_copy</i>
+                                <input id="template-group-name" type="text" name="name"
+                                       t:class="bm.validationClass(validationErrors, 'name', '')" t:data-position="bm.hasError(validationErrors, 'name') ? 'bottom'" t:data-delay="bm.hasError(validationErrors, 'name') ? 50" t:data-validation-field="bm.hasError(validationErrors, 'name') ? 'name'"
+                                       t:value="templateGroup.name ?: ''">
+                                <label for="template-group-name" t:text="loc.get('transaction.new.label.name')">Name</label>
+                            </div>
+                        </div>
+
+                        <br>
+
+                        <!--/* buttons */-->
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <a t:replace="~{helpers/header :: buttonLink('/templateGroups', 'clear', 'cancel', '', 'red', '', false, false)}"></a>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '')}"></button>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <a t:replace="~{helpers/header :: buttonLink('/templateGroups', 'clear', 'cancel', '', 'red', '', false, false)}"></a>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '')}"></button>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                    </div>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
