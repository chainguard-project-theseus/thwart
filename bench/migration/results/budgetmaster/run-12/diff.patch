+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.services.ImportResultItem"
+      t:params="Settings settings, List<ImportResultItem> importResultItems, List<String> errorMessages">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('settings.database.import'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('settings', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="loc.get('info.title.database.import.dialog')">Import</div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline-small" t:text="loc.get('info.database.import.result')">Result</div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="row">
+                        <div class="col s10 offset-s1 m8 offset-m2 l6 offset-l3">
+                            <table class="bordered">
+                                <tbody t:unless="importResultItems == null or importResultItems.isEmpty()">
+                                    <tr t:each="item : importResultItems">
+                                        <td><i class="material-icons left" t:text="item.entityType.icon">label</i>
+                                            <div class="import-entity-name" t:text="loc.get(item.entityType.localizationKey)">Categories</div>
+                                        </td>
+                                        <td><i t:if="item.numberOfImportedItems != item.numberOfAvailableItems" class="fas fa-exclamation-triangle text-red"></i></td>
+                                        <td t:text="|${item.numberOfImportedItems}/${item.numberOfAvailableItems}|">1/1</td>
+                                    </tr>
+                                </tbody>
+                            </table>
+                        </div>
+                    </div>
+                </div>
+
+                <div class="container" t:if="errorMessages != null and !errorMessages.isEmpty()">
+                    <div class="row">
+                        <div class="col s12">
+                            <ul class="collapsible">
+                                <li>
+                                    <div class="collapsible-header bold">
+                                        <i class="fas fa-exclamation-triangle text-red"></i>
+                                        <t:block t:text="loc.get('info.database.import.result.errors')">Errors</t:block>
+                                    </div>
+                                    <div class="collapsible-body">
+                                        <table class="bordered">
+                                            <tbody t:unless="errorMessages == null or errorMessages.isEmpty()">
+                                                <tr t:each="error : errorMessages">
+                                                    <td><i class="fas fa-exclamation-triangle text-red"></i></td>
+                                                    <td t:text="error">error</td>
+                                                </tr>
+                                            </tbody>
+                                        </table>
+                                    </div>
+                                </li>
+                            </ul>
+                        </div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="row">
+                        <div class="col s12 center-align">
+                            <a t:replace="~{helpers/header :: buttonLink('/settings', 'done', 'ok', 'button-finish-import', 'background-blue', '', false, false)}"></a>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </main>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/import.js}"></script>
+    </body>
+</html>
