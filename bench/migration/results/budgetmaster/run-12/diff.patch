new file mode 100644
index 00000000..1925fa5c
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html
@@ -0,0 +1,125 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState, java.time.LocalDate"
+      t:params="Settings settings, List<Notification> notifications, Map<String, String> validationErrors, List<String> localizedMonthNames, List<String> localizedWeekdays, Account account, List<AccountState> availableAccountStates, List<String> fontawesomeIcons, LocalDate today">
+    <head t:with="title=${account.ID != null ? loc.get('title.account.edit') : loc.get('title.account.new')}">
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + title)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('accounts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="account.ID != null ? loc.get('title.account.edit') : loc.get('title.account.new')">New Account</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                        <div class="container">
+                        <form name="NewAccount" t:action="@{/accounts/newAccount}" method="post">
+                            <input type="hidden" name="ID" t:value="account.ID == null ? '' : '' + account.ID">
+                            <input type="hidden" name="isSelected" t:value="account.isSelected() == null ? '' : '' + account.isSelected()">
+                            <input type="hidden" name="isDefault" t:value="account.isDefault() == null ? '' : '' + account.isDefault()">
+
+                            <!--/* name */-->
+                            <div class="row">
+                                <div class="input-field col s12 m12 l8 offset-l2">
+                                    <i class="material-icons prefix">edit</i>
+                                    <input id="account-name" type="text" name="name"
+                                           t:class="bm.validationClass(validationErrors, 'name', '')"
+                                           t:data-position="bm.hasError(validationErrors, 'name') ? 'bottom'"
+                                           t:data-delay="bm.hasError(validationErrors, 'name') ? 50"
+                                           t:data-validation-field="bm.hasError(validationErrors, 'name') ? 'name'"
+                                           t:value="account.name ?: ''">
+                                    <label for="account-name" t:text="loc.get('account.new.label.name')">Name</label>
+                                </div>
+                            </div>
+
+                            <!--/* description (the old second class attribute was ignored by browsers, so only the validation data is kept) */-->
+                            <div class="row">
+                                <div class="input-field col s12 m12 l8 offset-l2">
+                                    <i class="material-icons prefix">article</i>
+                                    <textarea id="account-description" class="materialize-textarea" name="description" data-length="250"
+                                              t:data-position="bm.hasError(validationErrors, 'description') ? 'bottom'"
+                                              t:data-delay="bm.hasError(validationErrors, 'description') ? 50"
+                                              t:data-validation-field="bm.hasError(validationErrors, 'description') ? 'description'"
+                                              t:text="account.description">description</textarea>
+                                    <label class="input-label" for="account-description" t:text="loc.get('transaction.new.label.description')">Description</label>
+                                </div>
+                            </div>
+
+                            <!--/* icon */-->
+                            <div t:replace="~{helpers/iconSelect :: iconSelect('account-icon', account.iconReference, bm.fontColor(account, settings.useDarkTheme), null, account.name,
+                                    account.iconReference != null and (account.iconReference.isImageIcon() or account.iconReference.isBuiltinIcon()) ? 'category-square' : 'category-square account-square-border',
+                                    'category-square account-square-border', false, settings)}"></div>
+
+                            <!--/* font color */-->
+                            <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(bm.fontColor(account, settings.useDarkTheme), acc.defaultFontColor(account, settings.useDarkTheme))}"></t:block>
+
+                            <!--/* state */-->
+                            <div t:replace="~{helpers/customSelectMacros :: customAccountStateSelect('account-state-select-wrapper', 'accountState', availableAccountStates,
+                                    account.accountState != null ? account.accountState : availableAccountStates[0], 'col s12 m12 l8 offset-l2', loc.get('account.new.label.state'), 'account-state')}"></div>
+
+                            <!--/* end date */-->
+                            <div class="row">
+                                <div class="input-field col s12 m12 l8 offset-l2">
+                                    <i class="material-icons prefix">notifications</i>
+                                    <input id="account-datepicker" type="text" class="datepicker" name="endDate" t:value="account.endDate != null ? bm.dateLong(account.endDate) : ''">
+                                    <label class="input-label" for="account-datepicker" t:text="loc.get('account.new.label.endDate')">End Date</label>
+                                </div>
+                            </div>
+
+                            <script>
+                                var startDate = [[${bm.dateLong(account.endDate != null ? account.endDate : today)}]];
+                                startDate = startDate.split(".");
+                                startDate = new Date(startDate[2], startDate[1]-1, startDate[0]);
+                            </script>
+
+                            <br>
+
+                            <!--/* buttons */-->
+                            <div class="row hide-on-small-only">
+                                <div class="col s6 right-align">
+                                    <a t:replace="~{helpers/header :: buttonLink('/accounts', 'clear', 'cancel', 'button-cancel-save-account', 'red', '', false, false)}"></a>
+                                </div>
+
+                                <div class="col s6 left-align">
+                                    <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', false, '', '')}"></button>
+                                </div>
+                            </div>
+                            <div class="hide-on-med-and-up">
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <a t:replace="~{helpers/header :: buttonLink('/accounts', 'clear', 'cancel', 'button-cancel-save-account', 'red', '', false, false)}"></a>
+                                    </div>
+                                </div>
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', false, '', '')}"></button>
+                                    </div>
+                                </div>
+                            </div>
+                        </form>
+                        </div>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <div t:replace="~{helpers/iconSelect :: modalIconSelect('account-name', account.iconReference, fontawesomeIcons)}"></div>
+
+        <script t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <t:block t:replace="~{helpers/validation :: messages(validationErrors)}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/accounts.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
