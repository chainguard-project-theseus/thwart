+                <div id="fontColorPickerContainer" class="valign-wrapper">
+                    <div id="fontColorPicker" t:style="|background-color: ${css.color(fontColor)}|"></div>
+                </div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+</t:block>
