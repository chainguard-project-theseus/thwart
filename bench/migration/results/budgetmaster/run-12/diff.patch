+                    </div>
+                    <div class="custom-select-arrow"></div>
+                </div>
+                <div class="custom-select-options">
+                    <div t:each="state : availableStates" t:class="selectedState == state ? 'custom-select-option selected' : 'custom-select-option '"
+                         t:data-value="state == 'FULL_ACCESS' ? 'FULL_ACCESS' : (state == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN')">
+                        <t:block t:replace="~{::accountStateContent(state, '')}"></t:block>
+                    </div>
+                </div>
+            </div>
+            <input type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedState == null ? null : (selectedState == 'FULL_ACCESS' ? 'FULL_ACCESS' : (selectedState == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN'))"/>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="accountOption(Account account, boolean isSelected, Settings settings)"
+     t:class="isSelected ? 'custom-select-option selected' : 'custom-select-option '" t:data-value="account.ID">
+    <t:block t:replace="~{::accountContent(account, '', settings)}"></t:block>
+</div>
+
+<t:block t:fragment="accountContent(Account account, String classes, Settings settings)">
+    <t:block t:with="accountName=${account.type == 'ALL' ? loc.get('account.all') : account.name}">
+        <div t:replace="~{::accountIconWithValue(account, accountName, 'category-circle-small ' + classes, settings)}"></div>
+        <span class="custom-select-item-name" t:text="accountName">name</span>
+    </t:block>
+</t:block>
+
+<div t:fragment="accountIcon(Account account, String accountName, String classes, Settings settings)"
+     t:class="account.iconReference != null and account.iconReference.isFallbackIcon() ? |category-circle ${classes} category-square account-square-border| : |category-circle ${classes} category-square |">
+    <span t:style="|color: ${css.color(bm.fontColor(account, settings.useDarkTheme))}|">
