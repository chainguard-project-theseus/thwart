+    </script>
+
+    <div class="row valign-wrapper">
+        <div class="col s1">
+            <label>
+                <input class="with-gap" name="repeatingEndType" type="radio" id="repeating-end-date" t:value="loc.get('repeating.end.key.date')" t:checked="checked"/>
