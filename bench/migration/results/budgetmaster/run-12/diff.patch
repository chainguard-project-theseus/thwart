+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.hotkeys.*"
+      t:params="Settings settings, List<Notification> notifications, GeneralHotKey[] hotkeysGeneral, GlobalDatePickerHotKey[] hotkeysGlobalDatePicker, GlobalAccountSelectHotKey[] hotkeysAccountSelect, ChartHotkeys[] hotkeysCharts">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('menu.hotkeys'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('hotkeys', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">keyboard</i> <t:block t:text="loc.get('menu.hotkeys')">Hotkeys</t:block></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                    <br>
+
+                    <t:block t:replace="~{::listHotKeys(loc.get('hotkeys.general'), hotkeysGeneral)}"></t:block>
+
+                    <t:block t:replace="~{::listHotKeys(loc.get('hotkeys.global.datepicker'), hotkeysGlobalDatePicker)}"></t:block>
+
+                    <t:block t:replace="~{::listHotKeys(loc.get('hotkeys.global.account.select'), hotkeysAccountSelect)}"></t:block>
+
+                    <t:block t:replace="~{::listHotKeys(loc.get('hotkeys.charts'), hotkeysCharts)}"></t:block>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+
+        <t:block t:remove="all">
+            <!--/* FreeMarker: listHotKeys with cellKeyWithModifier */-->
+            <t:block t:fragment="listHotKeys(String headline, HotKey[] hotKeys)">
+                <div class="row">
+                    <div class="col s12 headline center-align" t:text="headline">General</div>
+                </div>
+
+                <div class="row" t:each="hotKey : hotKeys">
+                    <div class="col s4 m3 offset-m2 l2 offset-l3 right-align bold">
+                        <t:block t:if="!strings.isEmpty(hotKey.modifierLocalized)">
+                            <div class="keyboard-key modifier-key" t:text="hotKey.modifierLocalized">Ctrl</div>
+                            <span class="bold">+</span>
+                        </t:block>
+                        <div class="keyboard-key" t:text="hotKey.keyLocalized">o</div>
+                    </div>
+                    <div class="col s8 m5 l5" t:text="hotKey.textLocalized">text</div>
+                </div>
+            </t:block>
+        </t:block>
+    </body>
+</html>
