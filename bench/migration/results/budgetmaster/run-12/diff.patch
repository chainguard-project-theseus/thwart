diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/validation.html b/BudgetMasterServer/src/main/resources/templates/helpers/validation.html
new file mode 100644
index 00000000..142d889b
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/validation.html
@@ -0,0 +1,16 @@
+<t:block xmlns:t="https://tessera.dev">
+<!--/*
+    FreeMarker's validation macro wrote class/data-tooltip attributes into the field. Write them at the call site:
+      t:class="bm.validationClass(validationErrors, 'name', '')"
+      t:data-position="bm.hasError(validationErrors, 'name') ? 'bottom'"
+      t:data-delay="bm.hasError(validationErrors, 'name') ? 50"
+      t:data-validation-field="bm.hasError(validationErrors, 'name') ? 'name'"
+    and include this fragment (before the page's scripts) so js/validation.js can show the messages.
+*/-->
+<t:block t:fragment="messages(Map<String, String> validationErrors)">
+    <t:block t:if="validationErrors != null and !validationErrors.isEmpty()">
+        <script type="application/json" id="validationMessages">[[${validationErrors}]]</script>
+        <script t:src="@{/js/validation.js}"></script>
+    </t:block>
+</t:block>
+</t:block>
