diff --git a/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionNormal.html b/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionNormal.html
new file mode 100644
index 00000000..d0410dc8
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionNormal.html
@@ -0,0 +1,93 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account"
+      t:params="Settings settings, List<Notification> notifications, Map<String, String> validationErrors, List<String> localizedMonthNames, List<String> localizedWeekdays, boolean isEdit, boolean changeTypeInProgress, LocalDate currentDate, List<Category> categories, List<Account> accounts, Transaction transaction, String suggestionsJSON, Boolean csvImportInProgress"
+      t:with="title=${isEdit ? loc.get('title.transaction.edit', loc.get('title.transaction.new.normal')) : loc.get('title.transaction.new', loc.get('title.transaction.new.normal'))}">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + title)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('transactions', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="title">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                    <div class="container">
+                        <form id="mainForm" name="NewTransaction" t:action="@{/transactions/newTransaction}" method="post">
+                            <!-- only set ID for transactions not templates, otherwise the input is filled with the template ID and saving the transaction
+                            may then override an existing transactions if the ID is also already used in transactions table -->
+                            <input type="hidden" name="ID" t:value="transaction.ID == null ? '' : '' + transaction.ID">
+                            <input type="hidden" name="isRepeating" t:value="transaction.isRepeating()">
+
+                            <!--/* isPayment switch */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: isExpenditureSwitch(transaction.isExpenditure())}"></t:block>
+
+                            <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.transaction.save'), 'fas fa-info', null)}"></t:block>
+
+                            <!--/* name */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(transaction.name, suggestionsJSON, validationErrors)}"></t:block>
+
+                            <!--/* amount */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(transaction.amount, validationErrors)}"></t:block>
+
+                            <!--/* category */-->
+                            <div t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, transaction.category, 'col s12 m12 l8 offset-l2', loc.get('transaction.new.label.category'), 'transaction-category', true, '', false, '', settings)}"></div>
+
+                            <!--/* date */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionStartDate(transaction.date, currentDate)}"></t:block>
+
+                            <!--/* description */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionDescription(transaction.description, validationErrors)}"></t:block>
+
+                            <!--/* tags */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(transaction.tags)}"></t:block>
+
+                            <!--/* account */-->
+                            <div t:replace="~{helpers/customSelectMacros :: customAccountSelect('account-select-wrapper', 'account', accounts, transaction.account != null ? transaction.account : bm.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', loc.get('transaction.new.label.account'), 'transaction-account', false, settings)}"></div>
+
+                            <!--/* repeating options */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionRepeating(transaction, currentDate, validationErrors)}"></t:block>
+
+                            <!--/* buttons */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttons('/transactions', true, false, csvImportInProgress)}"></t:block>
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttonTransactionActions(isEdit, true, changeTypeInProgress, transaction.ID)}"></t:block>
+                        </form>
+
+                        <div id="saveAsTemplateModalContainer"></div>
+
+                        <div id="changeTransactionTypeModalContainer"></div>
+
+                        <div id="transactionNameKeywordWarningModalContainer"></div>
+                    </div>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <script t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></script>
+
+        <script>
+            var createTemplateWithErrorInForm = [[${loc.get('save.as.template.errorsInForm')}]];
+            var templateNameEmptyValidationMessage = [[${loc.get('warning.empty.transaction.name')}]];
+            var templateNameDuplicateValidationMessage = [[${loc.get('warning.duplicate.template.name')}]];
+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <t:block t:replace="~{helpers/validation :: messages(validationErrors)}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/transactionActions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+    </body>
+</html>
