diff --git a/BudgetMasterServer/src/main/resources/templates/templates/templateIconSelect.html b/BudgetMasterServer/src/main/resources/templates/templates/templateIconSelect.html
new file mode 100644
index 00000000..55af07fc
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/templates/templateIconSelect.html
@@ -0,0 +1,160 @@
+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.settings.Settings">
+<!--/*
+    Local copy of helpers/iconSelect.ftl and helpers/fontColorPicker.ftl for templates/newTemplate, with the arguments
+    newTemplate passed: id='template-icon', showBackground=false, preventFallbackIcon=true, no extra background classes,
+    idToFocusOnClose='template-name'.
+*/-->
+
+<div t:fragment="iconSelect(Template item, Settings settings)" class="row"
+     t:with="hasImageIcon=${item.iconReference != null and item.iconReference.isImageIcon()}, hasBuiltinIcon=${item.iconReference != null and item.iconReference.isBuiltinIcon()}">
+        <div class="input-field col s12 m12 l8 offset-l2">
+            <i class="fas fa-icons prefix"></i>
+            <label class="input-label" for="template-icon" t:text="loc.get('account.new.label.icon')">Icon</label>
+
+            <div id="template-icon" class="valign-wrapper item-icon">
+                <div class="item-icon-preview-container">
+                    <a id="item-icon-preview" t:style="|color: ${css.color(bm.fontColor(item, settings.useDarkTheme))}|">
+                        <script>iconSelectAdditionalBackgroundClasses = "";</script>
+                        <div id="item-icon-preview-background"
+                             t:class="settings.showCategoriesAsCircles != null and settings.showCategoriesAsCircles == false ? 'category-circle category-circle-preview category-square ' : 'category-circle category-circle-preview  '"
+                             style="background-color: ">
+                            <i id="builtin-icon-preview-icon" t:class="hasBuiltinIcon ? item.iconReference.builtinIdentifier : 'hidden'"></i>
+                            <img id="item-icon-preview-icon" t:src="hasImageIcon ? @{/media/getImageByIconID/{id}(id=${item.iconReference.ID})} : ''"
+                                 t:class="hasImageIcon ? ' item-icon-preview category-icon ' : ' item-icon-preview category-icon hidden'"/>
+                        </div>
+                    </a>
+                    <a t:replace="~{helpers/header :: buttonFlat(null, 'delete', '', '', 'no-padding text-default button-remove-icon-from-item', '', false)}"></a>
+                </div>
+
+                <div id="item-icon-placeholder" t:text="loc.get('account.new.icon.placeholder')">placeholder</div>
+
+                <input id="hidden-input-icon-image-id" type="hidden" name="iconImageID" t:value="hasImageIcon ? '' + item.iconReference.image.ID : ''">
+                <input id="hidden-input-icon-builtin-identifier" type="hidden" name="builtinIconIdentifier" t:value="hasBuiltinIcon ? item.iconReference.builtinIdentifier : ''">
+            </div>
+        </div>
+</div>
+
+<div t:fragment="modalIconSelect(Template item, List<String> fontawesomeIcons)" id="modalIconSelect" class="modal modal-fixed-footer background-color" data-focus-on-close="template-name"
+     t:with="hasImageIcon=${item.iconReference != null and item.iconReference.isImageIcon()}">
+        <div class="modal-content center-align">
+            <div class="row">
+                <div class="col s12">
+                    <ul class="tabs" id="iconTabs">
+                        <li class="tab col s6"><a t:class="hasImageIcon ? 'text-blue valign-wrapper ' : 'text-blue valign-wrapper active'" href="#tabBuiltinIcons" data-name="builtinIcons"><i class="fas fa-icons"></i> <t:block t:text="loc.get('icons.builtin')">Built-in Icons</t:block></a></li>
+                        <li class="tab col s6"><a t:class="hasImageIcon ? 'text-blue valign-wrapper active' : 'text-blue valign-wrapper '" href="#tabImages" data-name="images"><i class="fas fa-image"></i> <t:block t:text="loc.get('icons.images')">Custom Images</t:block></a></li>
+                    </ul>
+                </div>
+                <div id="tabBuiltinIcons" class="col s12"><t:block t:replace="~{::tabBuiltinIcons(item, fontawesomeIcons)}"></t:block></div>
+                <div id="tabImages" class="col s12"><t:block t:replace="~{::tabImages(item)}"></t:block></div>
+            </div>
+        </div>
+        <div class="modal-footer background-color">
+            <a t:replace="~{helpers/header :: buttonLink(null, 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false)}"></a>
+            <a t:replace="~{helpers/header :: buttonLink(null, 'done', 'ok', 'button-icon-confirm', 'green', 'modal-action modal-close text-white', true, false)}"></a>
+        </div>
+</div>
+
+<t:block t:fragment="tabImages(Template item)">
+     <div class="row">
+        <div class="col s12">
+            <div class="headline" t:text="loc.get('upload.image.headline')">Upload</div>
+        </div>
+    </div>
+
+    <div class="row">
+        <form id="form-upload-image" method="post" t:action="@{/media/uploadImage}" enctype="multipart/form-data">
+            <div class="file-field input-field col s12">
+                <div class="container">
+                    <div class="btn background-blue">
+                        <i class="material-icons left">folder</i>
+                        <t:block t:text="loc.get('account.new.icon.upload.choose.file')">Choose file</t:block>
+                        <input id="inputUploadFile" type="file" t:accept="bm.validImageUploadTypes()" name="file">
+                    </div>
+                    <div class="file-path-wrapper">
+                        <input class="file-path validate" type="text">
+                    </div>
+                    <a t:replace="~{helpers/header :: buttonLink(null, 'upload', 'account.new.icon.upload', 'button-upload-new-image', 'background-blue', 'right', false, false)}"></a>
+                </div>
+            </div>
+        </form>
+
+        <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.icon.upload.image.size'), 'fas fa-info', null)}"></t:block>
+    </div>
+
+    <hr>
+
+    <div class="row">
+        <div class="col s12">
+            <div class="headline" t:text="loc.get('available.images')">Available images</div>
+        </div>
+    </div>
+
+    <div class="preloader-wrapper active margin" id="progressIndicator">
+        <div class="spinner-layer spinner-blue-only">
+            <div class="circle-clipper left">
+                <div class="circle"></div>
+            </div>
+            <div class="gap-patch">
+                <div class="circle"></div>
+            </div>
+            <div class="circle-clipper right">
+                <div class="circle"></div>
+            </div>
+        </div>
+    </div>
+
+    <div class="row" id="available-images"
+         t:data-url="item.iconReference != null and item.iconReference.isImageIcon() ? @{/media/getAvailableImages/{id}(id=${item.iconReference.image.ID})} : @{/media/getAvailableImages}">
+    </div>
+</t:block>
+
+<t:block t:fragment="tabBuiltinIcons(Template item, List<String> fontawesomeIcons)">
+    <div class="row no-margin-bottom">
+        <div class="input-field col s12 m12 l8 offset-l2">
+            <i class="material-icons prefix">search</i>
+            <input id="searchIcons" type="text" onchange="searchBuiltinIcons();" onkeypress="searchBuiltinIcons();" onpaste="searchBuiltinIcons()" oninput="searchBuiltinIcons();">
+            <label for="searchIcons" t:text="loc.get('search')">Search</label>
+        </div>
+    </div>
+    <div class="row">
+        <div class="col s12 center-align" id="numberOfIcons"><span id="numberOfMatchingIcons" t:text="fontawesomeIcons.size()">0</span>/<t:block t:text="fontawesomeIcons.size()">0</t:block> <t:block t:text="loc.get('icons.numberOf')">Icons</t:block></div>
+    </div>
+
+    <hr>
+
+    <div class="row" t:with="selectedIconName=${item.iconReference != null and item.iconReference.isBuiltinIcon() ? item.iconReference.builtinIdentifier : ''}">
+        <div t:each="icon : fontawesomeIcons" class="col s4 m2 l2 builtin-icon-option-column">
+            <div t:class="selectedIconName == icon ? 'builtin-icon-option selected' : 'builtin-icon-option '">
+                <i t:class="|builtin-icon-option-icon ${icon}|"></i>
+                <div class="builtin-icon-option-name truncate" t:text="icon">icon</div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="fontColorPicker(Template item, Settings settings)">
+    <t:block t:with="fontColor=${bm.fontColor(item, settings.useDarkTheme)}">
+    <input type="hidden" name="fontColor" id="fontColor" t:value="fontColor">
+    <script>
+        var fontColorPickerDefaultColor = [[${tf.defaultFontColor(item, settings.useDarkTheme)}]];
+    </script>
+
+    <div class="row">
+        <div class="input-field col s12 m12 l8 offset-l2">
+            <i class="material-icons prefix">palette</i>
+            <label class="input-label" for="fontColorPickerContainer" t:text="loc.get('account.new.label.icon.fontcolor')">Font color</label>
+
+            <div class="center-align">
+                <a t:replace="~{helpers/header :: buttonLink(null, 'auto_fix_high', 'account.new.icon.fontcolor.clear', 'buttonFontColorAuto', 'background-blue', '', false, false)}"></a>
+
+                <div id="fontColorPickerContainer" class="valign-wrapper">
+                    <div id="fontColorPicker" t:style="|background-color: ${css.color(fontColor)}|"></div>
+                </div>
+            </div>
+        </div>
+    </div>
+    </t:block>
+</t:block>
+
+</t:block>
