+	{
+		if(json == null || json.isBlank())
+		{
+			return List.of();
+		}
+		final List<String> list = GSON.fromJson(json, new TypeToken<List<String>>() {}.getType());
+		return list == null ? List.of() : list;
+	}
+
+	@TemplateFunction
+	public static List<TagChip> tagChips(List<Tag> tags)
+	{
