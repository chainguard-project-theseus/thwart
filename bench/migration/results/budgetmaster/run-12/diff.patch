+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('menu.tags'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('tags', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">local_offer</i> <t:block t:text="loc.get('menu.tags')">Tags</t:block></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                        <div class="container">
+                            <div t:if="tagUsages.isEmpty()" class="headline center-align" t:text="loc.get('placeholder')">No data available</div>
+                            <table t:unless="tagUsages.isEmpty()" class="bordered">
+                                <thead>
+                                    <tr>
+                                        <th t:text="loc.get('category.new.label.name')">Name</th>
+                                        <th t:text="loc.get('categories.usages')">Usages</th>
+                                        <th t:text="loc.get('categories.actions')">Actions</th>
+                                    </tr>
+                                </thead>
+                                <tbody t:unless="tagUsages == null or tagUsages.isEmpty()">
+                                    <tr t:each="usage : tagUsages">
+                                        <td><t:block t:text="usage.key">tag</t:block> </td>
+                                        <td>
+                                            <a t:href="'/search?searchTags=true&searchText=' + usage.key" class="waves-effect waves-light text-default" t:text="usage.value">0</a>
+                                        </td>
+                                        <td>
+                                            <a t:replace="~{helpers/header :: buttonFlat('/search?searchTags=true&searchText=' + usage.key, 'search', '', '', 'no-padding text-default', '', false)}"></a>
+                                        </td>
+                                    </tr>
+                                </tbody>
+                            </table>
+                        </div>
+                    </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+    </body>
+</html>
