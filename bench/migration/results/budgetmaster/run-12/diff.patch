+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.icon.Iconizable;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Functions for the account, category, tag and icon select views.
+ */
+@TemplateFunctions("acc")
+public final class AccountViewFunctions
+{
+	private AccountViewFunctions()
+	{
+	}
+
+	/**
+	 * FreeMarker: item.getDefaultFontColor(isDarkTheme)
+	 */
+	@TemplateFunction
+	public static String defaultFontColor(Iconizable item, boolean darkTheme)
+	{
+		return item.getDefaultFontColor(darkTheme);
+	}
+
+	/**
+	 * Splits a list into consecutive chunks of {@code size} items (the last one may be shorter).
+	 */
+	@TemplateFunction
+	public static List<List<String>> chunks(List<String> items, int size)
+	{
+		final List<List<String>> result = new ArrayList<>();
+		if(items == null)
+		{
+			return result;
+		}
+		for(int i = 0; i < items.size(); i += size)
+		{
+			result.add(items.subList(i, Math.min(i + size, items.size())));
+		}
+		return result;
+	}
+
+	/**
+	 * FreeMarker: number?abs
+	 */
+	@TemplateFunction
+	public static long abs(Long value)
+	{
+		return value == null ? 0 : Math.abs(value);
+	}
+}
