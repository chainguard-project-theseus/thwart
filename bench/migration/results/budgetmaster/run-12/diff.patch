+package de.deadlocker8.budgetmaster.templating;
+
+import de.thecodelabs.utils.util.Localization;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import org.springframework.validation.BindingResult;
+import org.springframework.validation.FieldError;
+import org.springframework.web.servlet.HandlerInterceptor;
+import org.springframework.web.servlet.ModelAndView;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * The FreeMarker templates read the {@link BindingResult} the controllers put in the model as "error"
+ * (helpers/validation.ftl). Templates can't read a BindingResult, so this exposes the first error of each field,
+ * localized, as "validationErrors" (field name to message).
+ */
+public class ValidationErrorsInterceptor implements HandlerInterceptor
+{
+	public static final String VALIDATION_ERRORS = "validationErrors";
+
+	@Override
+	public void postHandle(HttpServletRequest request, HttpServletResponse response, Object handler, ModelAndView modelAndView)
+	{
+		if(modelAndView == null)
+		{
+			return;
+		}
+
+		final Map<String, String> validationErrors = new LinkedHashMap<>();
+		if(modelAndView.getModel().get("error") instanceof BindingResult bindingResult)
+		{
+			for(FieldError fieldError : bindingResult.getFieldErrors())
+			{
+				validationErrors.putIfAbsent(fieldError.getField(), Localization.getString(bindingResult.getFieldError(fieldError.getField()).getCode()));
+			}
+		}
+		modelAndView.addObject(VALIDATION_ERRORS, validationErrors);
+	}
+}
