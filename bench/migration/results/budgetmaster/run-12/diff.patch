diff --git a/BudgetMasterServer/src/main/resources/templates/charts/manage.html b/BudgetMasterServer/src/main/resources/templates/charts/manage.html
new file mode 100644
index 00000000..33cbb571
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/charts/manage.html
@@ -0,0 +1,89 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.charts.Chart"
+      t:params="Settings settings, List<Notification> notifications, List<Chart> defaultCharts, List<Chart> customCharts">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('menu.charts'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('charts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="loc.get('menu.charts')">Charts</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                    <page-content t:remove="tag">
+                    <br>
+                    <t:block t:replace="~{charts/chartFunctions :: buttons}"></t:block>
+                    <br>
+                    <div class="container">
+                        <div class="section center-align">
+                            <div class="headline-small" t:text="loc.get('charts.custom')">Custom Charts</div>
+                        </div>
+
+                        <table class="bordered">
+                            <thead>
+                                <tr>
+                                    <th t:text="loc.get('chart.new.label.name')">Name</th>
+                                    <th t:text="loc.get('chart.actions')">Actions</th>
+                                </tr>
+                            </thead>
+                            <tbody t:unless="customCharts.isEmpty()">
+                                <tr t:each="chart : customCharts">
+                                    <td t:text="ch.chartName(chart)">name</td>
+                                    <td>
+                                        <a t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.ID + '/edit', 'edit', '', '', 'no-padding text-default', '', false)}"></a>
+                                        <a id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-chart"
+                                           t:data-url="@{/charts/{id}/requestDelete(id=${chart.ID})}">
+                                            <i class="material-icons left no-margin ">delete</i>
+                                        </a>
+                                    </td>
+                                </tr>
+                            </tbody>
+                        </table>
+                        <t:block t:if="customCharts.isEmpty()">
+                            <div class="center-align charts-default-margin" t:text="loc.get('placeholder')">No data available</div>
+                            <br>
+                        </t:block>
+
+                        <div class="section center-align charts-default-margin">
+                            <div class="headline-small" t:text="loc.get('charts.default')">Default Charts</div>
+                        </div>
+
+                        <table class="bordered">
+                            <thead>
+                                <tr>
+                                    <th t:text="loc.get('chart.new.label.name')">Name</th>
+                                    <th t:text="loc.get('chart.display.type')">Display type</th>
+                                    <th t:text="loc.get('chart.group.type')">Group type</th>
+                                    <th t:text="loc.get('chart.actions')">Actions</th>
+                                </tr>
+                            </thead>
+                            <tbody t:unless="defaultCharts.isEmpty()">
+                                <tr t:each="chart : defaultCharts">
+                                    <td t:text="ch.chartName(chart)">name</td>
+                                    <td><t:block t:replace="~{charts/chartFunctions :: iconForItem(ch.fontAwesome(chart.displayType), chart.displayType.icon, chart.displayType.localizationKey)}"></t:block></td>
+                                    <td><t:block t:replace="~{charts/chartFunctions :: iconForItem(ch.fontAwesome(chart.groupType), chart.groupType.icon, chart.groupType.localizationKey)}"></t:block></td>
+                                    <td>
+                                        <a t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.ID + '/edit', 'visibility', '', '', 'no-padding text-default', '', false)}"></a>
+                                    </td>
+                                </tr>
+                            </tbody>
+                        </table>
+                    </div>
+                    </page-content>
+                </t:block>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/charts.js}"></script>
+    </body>
+</html>
