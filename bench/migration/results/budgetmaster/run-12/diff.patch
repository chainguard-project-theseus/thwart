+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.templategroup.TemplateGroup"
+      t:params="Settings settings, List<Notification> notifications, Map<TemplateGroup, List<Template>> templatesByGroup">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('menu.transactions.templates'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/templates.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.useDarkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">file_copy</i> <t:block t:text="loc.get('menu.transactions.templates')">Templates</t:block></div>
+                    </div>
+
+                    <!--/* the old page opened header.content here and closed it after the list (unbalanced); the notifications land at the same place */-->
+                    <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                        <page-content t:remove="tag">
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">search</i>
+                                <input id="searchTemplate" type="text" class="mousetrap">
+                                <label for="searchTemplate" t:text="loc.get('search')">Search</label>
+                            </div>
+                        </div>
+                        </page-content>
+                    </t:block>
+                </div>
+                <br>
+                <t:block t:replace="~{templates/templateFunctions :: buttons}"></t:block>
+                <br>
+                <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.template.arrow.keys'), 'fas fa-info', null)}"></t:block>
+                <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.template.sort.groups'), 'fas fa-info', null)}"></t:block>
+                <br>
+                <div t:if="templatesByGroup.isEmpty()" class="container">
+                    <div class="headline center-align" t:text="loc.get('placeholder')">placeholder</div>
+                </div>
+                <t:block t:unless="templatesByGroup.isEmpty()"><t:block t:replace="~{templates/templateFunctions :: listTemplates(templatesByGroup, settings)}"></t:block></t:block>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/sortablejs/Sortable.min.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+    </body>
+</html>
