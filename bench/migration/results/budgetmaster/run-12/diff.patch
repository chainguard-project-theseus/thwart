+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.transactions.csvimport.*"
+      t:params="Settings settings, List<Notification> notifications, Map<String, String> validationErrors, List<Category> categories, String suggestionsJSON, CsvImportSettings csvImportSettings, String csvImportFileName, List<CsvRow> csvRows, List<CsvTransaction> csvTransactions, List<String> errorsColumnSettings">
+    <head>
+        <t:block t:replace="~{helpers/header :: head('BudgetMaster - ' + loc.get('menu.transactions.import'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
