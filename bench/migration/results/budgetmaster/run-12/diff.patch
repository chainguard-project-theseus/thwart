diff --git a/BudgetMasterServer/src/main/resources/templates/search/searchMacros.html b/BudgetMasterServer/src/main/resources/templates/search/searchMacros.html
new file mode 100644
index 00000000..ee263062
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/search/searchMacros.html
@@ -0,0 +1,139 @@
+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.search.Search, de.deadlocker8.budgetmaster.search.SearchResultPage">
+
+<div t:fragment="searchTextAndButton(Search search)" class="row no-margin-bottom valign-wrapper">
+    <div class="col s10 m6 offset-m2 l5 offset-l3">
+        <div class="input-field">
+            <input id="searchText" type="text" name="searchText" t:value="search.searchText">
+            <label for="searchText" t:text="loc.get('search')">Search</label>
+        </div>
+    </div>
+
+    <div class="col s2 m4 l4">
+        <div class="hide-on-small-only">
+            <button t:replace="~{helpers/header :: buttonSubmit('action', 'search', 'search.submit', 'button-perform-search', 'background-blue', '', false, '', '')}"></button>
+        </div>
+        <div class="hide-on-med-and-up">
+            <button t:replace="~{helpers/header :: buttonSubmit('action', 'search', '', 'button-perform-search', 'background-blue', '', false, '', '')}"></button>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="checkboxes(Search search)" class="row">
+    <div class="col s8 offset-s2 m4 offset-m2 l3 offset-l3">
+        <div class="search-checkbox-container">
+            <label>
+                <input type="checkbox" name="searchName" t:checked="search.isSearchName()">
+                <span class="text-default" t:text="loc.get('search.in.name')">name</span>
+            </label>
+        </div>
+    </div>
+    <div class="col s8 offset-s2 m6 l6">
+        <div class="search-checkbox-container">
+            <label>
+                <input type="checkbox" name="searchDescription" t:checked="search.isSearchDescription()">
+                <span class="text-default" t:text="loc.get('search.in.description')">description</span>
+            </label>
+        </div>
+    </div>
+    <div class="col s8 offset-s2 m4 offset-m2 l3 offset-l3">
+        <div class="search-checkbox-container">
+            <label>
+                <input type="checkbox" name="searchCategory" t:checked="search.isSearchCategory()">
+                <span class="text-default" t:text="loc.get('search.in.category')">category</span>
+            </label>
+        </div>
+    </div>
+    <div class="col s8 offset-s2 m6 l6">
+        <div class="search-checkbox-container">
+            <label>
+                <input type="checkbox" name="searchTags" t:checked="search.isSearchTags()">
+                <span class="text-default" t:text="loc.get('search.in.tags')">tags</span>
+            </label>
+        </div>
+    </div>
+    <div class="col s8 offset-s2 m4 offset-m2 l3 offset-l3">
+        <div class="search-checkbox-container">
+            <label>
+                <input type="checkbox" name="includeHiddenAccounts" t:checked="search.isIncludeHiddenAccounts()">
+                <span class="text-default" t:text="loc.get('search.include.hidden.accounts')">hidden</span>
+            </label>
+        </div>
+    </div>
+</div>
+
+<!--/* startDate/endDate are JS globals read by js/search.js (null without a date) */-->
+<div t:fragment="dateRange(Search search)" class="row">
+    <div class="input-field col s6 m4 offset-m2 l3 offset-l3" id="search-datepicker-container">
+        <script>
+            var searchStartDateString = [[${search.startDate != null ? bm.dateLong(search.startDate)}]];
+            startDate = null;
+            if(searchStartDateString !== null)
+            {
+                startDate = searchStartDateString.split(".");
+                startDate = new Date(startDate[2], startDate[1] - 1, startDate[0]);
+            }
+        </script>
+
+        <i class="material-icons prefix">today</i>
+        <input id="search-datepicker" type="text" class="datepicker" name="startDate" t:value="search.startDate != null ? bm.dateLong(search.startDate) : ''">
+        <label for="search-datepicker" t:text="loc.get('chart.steps.second.label.start')">start</label>
+    </div>
+
+    <div class="input-field col s6 m4 l3" id="search-datepicker-end-container">
+        <script>
+            var searchEndDateString = [[${search.endDate != null ? bm.dateLong(search.endDate)}]];
+            endDate = null;
+            if(searchEndDateString !== null)
+            {
+                endDate = searchEndDateString.split(".");
+                endDate = new Date(endDate[2], endDate[1] - 1, endDate[0]);
+            }
+        </script>
+
+        <i class="material-icons prefix">event</i>
+        <input id="search-datepicker-end" type="text" class="datepicker" name="endDate" t:value="search.endDate != null ? bm.dateLong(search.endDate) : ''">
+        <label for="search-datepicker-end" t:text="loc.get('chart.steps.second.label.end')">end</label>
+    </div>
+</div>
+
+<div t:fragment="pagination(SearchResultPage page, String position)" t:class="|row pagination-position-${position}|">
+    <div class="col s12 center-align">
+        <ul class="pagination" t:if="page.totalPages() &gt; 0">
+            <li t:class="page.number() == 0 ? 'text-default disabled' : 'text-default '"><a class="page-link" t:data-page="page.number() - 1"><i class="material-icons">chevron_left</i></a></li>
+            <li t:each="i : ${numbers.sequence(0, page.totalPages() - 1)}" t:class="page.number() == i ? 'waves-effect text-default active' : 'waves-effect text-default '"><a class="page-link" t:data-page="i" t:text="i + 1">1</a></li>
+            <li t:class="page.number() == page.totalPages() - 1 ? 'text-default disabled' : 'text-default '"><a class="page-link" t:data-page="page.number() + 1"><i class="material-icons">chevron_right</i></a></li>
+        </ul>
+    </div>
+</div>
+
+<t:block t:fragment="renderTransactions(List<Transaction> transactions, boolean openLinksInNewTab, Settings settings)">
+    <div class="card-panel search-result" t:each="transaction : transactions">
+        <div class="hide-on-large-only">
+            <div class="row valign-wrapper">
+                <div class="col s3 center-align bold transaction-text" t:text="bm.dateNormal(transaction.date)">01.01.2020</div>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction, settings)}"></t:block>
+                <div t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 's2')}"></div>
+                <div t:replace="~{transactions/transactionsMacros :: transactionLinks(transaction, openLinksInNewTab)}"></div>
+            </div>
+            <div class="row valign-wrapper no-margin-bottom">
+                <div t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'center-align', settings)}"></div>
+                <div t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 's5')}"></div>
