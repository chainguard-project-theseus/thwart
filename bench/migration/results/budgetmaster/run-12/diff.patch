+                <span for="repeating-end-never"></span>
+            </label>
+        </div>
+        <div class="col s11" t:text="loc.get('repeating.end.never')">never</div>
+</div>
+
+<div t:fragment="repeatingEndAfterXTimes(boolean checked, Transaction transaction)" class="row valign-wrapper">
+        <div class="col s1">
+            <label>
+                <input class="with-gap" name="repeatingEndType" type="radio" id="repeating-end-after-x-times" t:value="loc.get('repeating.end.key.afterXTimes')" t:checked="checked"/>
+                <span for="repeating-end-after-x-times"></span>
