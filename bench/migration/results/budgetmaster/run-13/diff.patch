--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/transactionsMacros.html
@@ -0,0 +1,175 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.accounts.Account">
+
+<!--/*
+Fragments (FreeMarker transactionsMacros.ftl). The current account and the dark theme flag are read
+through helpers.getCurrentAccount() / helpers.getSettings() as the old globals did.
+- transactionType(Transaction transaction, String size)
+- transactionCategory(Transaction transaction, String alignment)
+- transactionNameAndDescription(Transaction transaction, String size)
+- transactionAmount(Transaction transaction, Account account, String size)
+- transactionButtons(Transaction transaction, String classes)
+- transactionEditButton(Transaction transaction)
+- transactionAccountIcon(Transaction transaction): only rendered if the current account is "all accounts"
+- transactionLinks(Transaction transaction, boolean openInNewTab): old target='' / '_blank'
+- placeholder(List<Transaction> transactions)
+- buttons(boolean isFilterActive)
+- buttonNew(String listClasses, Account currentAccount)
+- buttonFilter(boolean isFilterActive)
+- buttonRequestDelete(Integer transactionId): flat delete button whose data-url is /transactions/{id}/requestDelete
+- buttonFlatTarget(String url, String icon, String classes, boolean openInNewTab): header.buttonFlat without label and with target
+*/-->
+
+<div t:fragment="transactionType(Transaction transaction, String size)" t:class="|col ${size} left-align transaction-row-transparent-child|">
+    <i t:if="transaction.isRepeating()" class="material-icons">repeat</i>
+    <i t:if="transaction.isTransfer()" class="material-icons tooltipped" data-position="bottom" t:title="|${transaction.getAccount().getName()} ➔ ${transaction.getTransferAccount().getName()}|">swap_horiz</i>
+
+    <i t:if="!transaction.isRepeating() && !transaction.isTransfer()" class="material-icons invisible">repeat</i>
+</div>
+
+<div t:fragment="transactionCategory(Transaction transaction, String alignment)" t:class="|col s2 l1 xl1 ${alignment} transaction-row-transparent-child|">
+    <div class="hide-on-med-and-down">
+        <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(transaction.getCategory(), '', false, true)}"></t:block>
+    </div>
+    <div class="hide-on-large-only">
+        <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(transaction.getCategory(), 'category-circle-small', false, true)}"></t:block>
+    </div>
+</div>
+
+<div t:fragment="transactionNameAndDescription(Transaction transaction, String size)" t:class="|col ${size} transaction-row-transparent-child|">
+    <div class="truncate transaction-text" t:text="transaction.getName()"></div>
+    <div class="hide-on-med-and-down">
+        <div t:if="transaction.getDescription() != null" class="italic" t:text="transaction.getDescription()"></div>
+    </div>
+</div>
+
+<t:block t:fragment="transactionAmount(Transaction transaction, Account account, String size)" t:with="amount=${helpers.getAmount(transaction, account)}, dark=${helpers.getSettings().isUseDarkTheme()}">
+    <div t:if="amount <= 0" t:class="|col ${size} bold ${dark ? 'text-red-light' : 'text-red'} no-wrap right-align transaction-text transaction-row-transparent-child|" t:text="fmt.currency(amount)"></div>
+    <div t:unless="amount <= 0" t:class="|col ${size} bold ${dark ? 'text-green' : 'text-green-dark'} no-wrap right-align transaction-text transaction-row-transparent-child|" t:text="fmt.currency(amount)"></div>
+</t:block>
+
+<div t:fragment="transactionButtons(Transaction transaction, String classes)" t:class="|col ${classes} transaction-buttons no-wrap|">
+    <t:block t:if="transaction.isEditable()">
+        <t:block t:replace="~{::transactionEditButton(transaction)}"></t:block>
+        <t:block t:replace="~{::buttonRequestDelete(transaction.getID())}"></t:block>
+    </t:block>
+    <t:block t:if="transaction.isAllowedToFillNewTransaction()">
+        <t:block t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.getID() + '/newFromExisting', 'content_copy', '', '', 'no-padding text-default button-new-from-existing', '')}"></t:block>
+    </t:block>
+</div>
+
+<t:block t:fragment="transactionEditButton(Transaction transaction)">
+    <div t:if="transaction.isRepeating()" class="fixed-action-btn edit-transaction-button">
+        <a class="btn-floating btn-flat waves-effect waves-light no-padding text-default edit-transaction-button-link">
+            <i class="material-icons">edit</i>
+        </a>
+        <ul class="new-transaction-button-list">
+            <li>
+                <a t:href="@{/transactions/{id}/edit(id=transaction.getID())}" class="btn-floating btn mobile-fab-tip no-wrap button-edit-all-occurrences" t:text="locale.getString('title.transaction.edit', locale.getString('title.transaction.new.normal'))"></a>
+                <a t:href="@{/transactions/{id}/edit(id=transaction.getID())}" class="btn-floating btn background-green-dark"><i class="material-icons">edit</i></a>
+            </li>
+            <li>
+                <a t:href="@{/transactions/{id}/editFutureRepetitions(id=transaction.getID())}" class="btn-floating btn mobile-fab-tip no-wrap button-edit-future-occurrences" t:text="locale.getString('repeating.button.edit.future')"></a>
+                <a t:href="@{/transactions/{id}/editFutureRepetitions(id=transaction.getID())}" class="btn-floating btn background-orange"><i class="material-icons">move_up</i></a>
+            </li>
+        </ul>
+    </div>
+    <t:block t:unless="transaction.isRepeating()">
+        <t:block t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.getID() + '/edit', 'edit', '', '', 'no-padding text-default button-edit', '')}"></t:block>
+    </t:block>
+</t:block>
+
+<t:block t:fragment="transactionAccountIcon(Transaction transaction)">
+    <a t:if="helpers.getCurrentAccount().getType() == 'ALL' && transaction.getAccount() != null" t:href="@{/accounts/{id}/select(id=transaction.getAccount().getID())}">
+        <div class="col s2 l1 xl1 tooltipped no-padding transaction-row-transparent-child" data-position="bottom" t:title="transaction.getAccount().getName()">
+            <div class="hide-on-med-and-down">
+                <t:block t:replace="~{helpers/customSelect :: accountIcon(transaction.getAccount(), transaction.getAccount().getName(), '', helpers.getSettings().isUseDarkTheme())}"></t:block>
+            </div>
+            <div class="hide-on-large-only">
+                <t:block t:replace="~{helpers/customSelect :: accountIcon(transaction.getAccount(), transaction.getAccount().getName(), 'category-circle-small', helpers.getSettings().isUseDarkTheme())}"></t:block>
+            </div>
