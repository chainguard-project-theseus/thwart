+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="Settings settings, List<Notification> notifications, Map<String, Integer> tagUsages">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.tags'))}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark' : null">
+        <t:block t:replace="~{helpers/navbar :: navbar('tags', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">local_offer</i> [[${locale.getString('menu.tags')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: notifications(notifications)}"></t:block>
+                    <div class="container">
+                        <div t:if="tagUsages.isEmpty()" class="headline center-align" t:text="locale.getString('placeholder')"></div>
+                        <table t:unless="tagUsages.isEmpty()" class="bordered">
+                            <thead>
+                                <tr>
+                                    <th t:text="locale.getString('category.new.label.name')"></th>
+                                    <th t:text="locale.getString('categories.usages')"></th>
+                                    <th t:text="locale.getString('categories.actions')"></th>
+                                </tr>
+                            </thead>
+                            <tbody>
+                                <tr t:each="tagUsage : tagUsages">
+                                    <td>[[${tagUsage.key}]] </td>
+                                    <td>
+                                        <a t:href="|/search?searchTags=true&searchText=${tagUsage.key}|" class="waves-effect waves-light text-default" t:text="tagUsage.value"></a>
+                                    </td>
+                                    <td>
+                                        <t:block t:replace="~{helpers/header :: buttonFlat('/search?searchTags=true&searchText=' + tagUsage.key, 'search', '', '', 'no-padding text-default', '')}"></t:block>
+                                    </td>
+                                </tr>
+                            </tbody>
+                        </table>
+                    </div>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+    </body>
+</html>
