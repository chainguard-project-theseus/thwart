+                    <input type="hidden" name="chartID" t:value="chartSettings.getChartID() != null ? '' + chartSettings.getChartID() : ''">
+
+                    <div class="container" t:with="startDate=${fmt.dateLong(chartSettings.getStartDate())}, endDate=${fmt.dateLong(chartSettings.getEndDate())}">
+                        <div class="row">
+                            <div class="col s12">
+                                <div class="card" id="chart-date-card">
