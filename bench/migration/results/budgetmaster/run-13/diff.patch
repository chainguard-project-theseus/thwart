+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.templategroup.TemplateGroup">
+
+<!--/*
+templateFunctions.ftl
+  buttons
+  listTemplates(Map<TemplateGroup, List<Template>> templatesByGroup)
+  templateItem(Template template)
+  templateHeader(Template template)
+  templateNameInput(Template template, Map<String, String> validationErrors)
+  templateIncludeAccountCheckbox(String id, String name, String label, boolean checked)
+*/-->
+
+<t:block t:fragment="buttons">
+    <div class="row valign-wrapper hide-on-small-only">
+        <div class="col s6 right-align">
+            <t:block t:replace="~{helpers/header :: buttonLink('/templates/newTemplate', 'add', 'title.template.new', '', 'background-blue', '')}"></t:block>
+        </div>
+
+        <div class="col s6 left-align">
+            <t:block t:replace="~{helpers/header :: buttonLink('/templateGroups', 'folder', 'title.template.group.edit.short', '', 'background-blue', '')}"></t:block>
+        </div>
+    </div>
+    <div class="hide-on-med-and-up">
+        <div class="row valign-wrapper center-align">
+            <div class="col s12">
+                <t:block t:replace="~{helpers/header :: buttonLink('/templates/newTemplate', 'add', 'title.template.new', '', 'background-blue', '')}"></t:block>
+            </div>
+        </div>
+        <div class="row valign-wrapper center-align">
+            <div class="col s12">
+                <t:block t:replace="~{helpers/header :: buttonLink('/templateGroups', 'folder', 'title.template.group.edit.short', '', 'background-blue', '')}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="listTemplates(Map<TemplateGroup, List<Template>> templatesByGroup)">
+    <div class="container">
+        <div class="row">
+            <div class="col s12">
+                <ul t:each="entry : templatesByGroup" class="collapsible expandable templateCollapsible" t:data-group-id="entry.key.ID">
+                    <div t:if="templatesByGroup.size() != 1" class="template-group-headline" t:text="entry.key.getType() == 'DEFAULT' ? locale.getString('template.group.default') : entry.key.getName()"></div>
+
+                    <t:block t:each="template : entry.value"><t:block t:replace="~{::templateItem(template)}"></t:block></t:block>
+                </ul>
+            </div>
+        </div>
+    </div>
+
+    <form id="form-move-template-to-group" method="post" t:action="@{/templateGroups/moveTemplateToGroup}">
+        <input type="hidden" name="templateID" value=""/>
+        <input type="hidden" name="groupID" value=""/>
+    </form>
+</t:block>
+
+<li t:fragment="templateItem(Template template)" class="template-item z-depth-2" t:data-template-id="template.ID">
+    <div class="collapsible-header bold">
+        <t:block t:replace="~{::templateHeader(template)}"></t:block>
+        <div class="collapsible-header-button">
+            <t:block t:replace="~{helpers/header :: buttonFlat('/templates/' + template.ID + '/edit', 'edit', '', '', 'no-padding text-default', '')}"></t:block>
+            <a id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-template" t:data-url="@{/templates/{id}/requestDelete(id=template.ID)}">
+                <i class="material-icons left no-margin ">delete</i>
+            </a>
+            <t:block t:replace="~{helpers/header :: buttonLink('/templates/' + template.ID + '/select', 'note_add', '', '', 'background-blue', 'button-select-template')}"></t:block>
+        </div>
+    </div>
+    <div class="collapsible-body">
+        <div class="row no-margin-bottom">
+            <table class="table-template-content text-default">
+                <tbody>
+                <tr t:if="!strings.isEmpty(template.getName())">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.name')"></td>
+                    <td t:text="template.getName()"></td>
+                </tr>
+                <tr t:if="template.getAmount() != null">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.amount')"></td>
+                    <td t:text="fmt.currency(template.getAmount())"></td>
+                </tr>
+                <tr t:if="template.getCategory() != null">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.category')"></td>
+                    <td t:text="helpers.categoryName(template.category)"></td>
+                </tr>
+                <tr t:if="!strings.isEmpty(template.getDescription())">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.description')"></td>
+                    <td t:text="template.getDescription()"></td>
+                </tr>
+                <tr t:if="template.getTags() != null && template.getTags().size() > 0">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.tags')"></td>
+                    <td class="chips-placeholder">
+                        <div t:each="tag : template.getTags()" class="chip" t:text="tag.getName()"></div>
+                    </td>
+                </tr>
+                <tr t:if="template.getAccount() != null">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.account')"></td>
+                    <td t:text="template.getAccount().getName()"></td>
+                </tr>
+                <tr t:if="template.getTransferAccount() != null">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.transfer.account')"></td>
+                    <td t:text="template.getTransferAccount().getName()"></td>
+                </tr>
+                </tbody>
+            </table>
+        </div>
+    </div>
+</li>
+
+<t:block t:fragment="templateHeader(Template template)">
+    <span t:style="|color: ${css.color(helpers.templateFontColor(template, helpers.getSettings().isUseDarkTheme()))}|">
+        <t:block t:if="template.getIconReference() != null && (template.getIconReference().isImageIcon() || template.getIconReference().isBuiltinIcon())" t:replace="~{helpers/header :: entityIcon(template.getIconReference(), 'template-icon', '')}"></t:block>
+        <i t:if="!(template.getIconReference() != null && (template.getIconReference().isImageIcon() || template.getIconReference().isBuiltinIcon())) && template.getTransferAccount() != null" class="material-icons">swap_horiz</i>
+        <i t:if="!(template.getIconReference() != null && (template.getIconReference().isImageIcon() || template.getIconReference().isBuiltinIcon())) && template.getTransferAccount() == null" class="material-icons">payment</i>
+    </span>
+    <div class="truncate template-header-name" t:text="template.getTemplateName()"></div>
+</t:block>
+
+<div t:fragment="templateNameInput(Template template, Map<String, String> validationErrors)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <i class="material-icons prefix">file_copy</i>
+        <input id="template-name" type="text" name="templateName" t:class="validation.cls(validationErrors, 'templateName', '')" t:data-position="validation.has(validationErrors, 'templateName') ? 'bottom' : null" t:data-delay="validation.has(validationErrors, 'templateName') ? 50 : null" t:title="validation.tooltip(validationErrors, 'templateName')" t:value="template.getTemplateName() ?: ''">
+        <label for="template-name" t:text="locale.getString('template.new.label.name')"></label>
+    </div>
+</div>
+
+<div t:fragment="templateIncludeAccountCheckbox(String id, String name, String label, boolean checked)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <label>
+            <input t:id="id" t:name="name" type="checkbox" t:checked="checked">
+            <span class="columnName-checkbox-label text-default" t:text="label"></span>
+        </label>
+    </div>
+</div>
+
+</t:block>
