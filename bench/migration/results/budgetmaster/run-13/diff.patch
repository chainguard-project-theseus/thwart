+++ b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/templating/AccFunctions.java
@@ -0,0 +1,124 @@
+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.accounts.AccountState;
+import de.deadlocker8.budgetmaster.icon.Iconizable;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeInlineHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * Functions for the accounts, categories (new/delete), tags, icon select and font color picker templates.
+ */
+@TemplateFunctions("acc")
+public final class AccFunctions
+{
+	private static final HtmlPolicy BREAKS_ONLY = HtmlPolicy.inlineBuilder().allowElements("br").build();
+
+	private AccFunctions()
+	{
+	}
+
+	/**
+	 * A localized message whose bundle text contains {@code <br>} (printed raw by FreeMarker).
+	 * The arguments are escaped, then only {@code <br>} is kept.
+	 */
+	@TemplateFunction
+	public static SafeInlineHtml messageWithBreaks(String key, Object arg1, Object arg2)
+	{
+		final String text = Localization.getString(key, escape(arg1), escape(arg2));
+		return SafeInlineHtml.sanitize(text, BREAKS_ONLY);
+	}
+
+	private static Object escape(Object value)
+	{
+		if(value instanceof String string)
+		{
+			return SafeInlineHtml.escape(string).html();
+		}
+		return value;
+	}
+
+	/**
+	 * Replaces {@code item.getFontColor(isDarkTheme)} for any entity with an icon.
+	 */
+	@TemplateFunction
+	public static String fontColor(Iconizable item, boolean isDarkTheme)
+	{
+		return item == null ? null : item.getFontColor(isDarkTheme);
+	}
+
+	/**
+	 * Replaces {@code item.getDefaultFontColor(isDarkTheme)} for any entity with an icon.
+	 */
+	@TemplateFunction
+	public static String defaultFontColor(Iconizable item, boolean isDarkTheme)
+	{
+		return item == null ? null : item.getDefaultFontColor(isDarkTheme);
+	}
+
+	/**
+	 * Replaces FreeMarker's {@code number?abs}.
+	 */
+	@TemplateFunction
+	public static long abs(Long value)
+	{
+		return value == null ? 0 : Math.abs(value);
+	}
+
+	/**
+	 * Splits a list into consecutive chunks of the given size (the last one may be shorter).
+	 */
+	@TemplateFunction
+	public static List<List<String>> chunks(List<String> items, int size)
+	{
+		final List<List<String>> result = new ArrayList<>();
+		if(items == null)
+		{
+			return result;
+		}
+		for(int i = 0; i < items.size(); i += size)
+		{
+			result.add(new ArrayList<>(items.subList(i, Math.min(i + size, items.size()))));
+		}
+		return result;
+	}
+
+	/**
+	 * Replaces FreeMarker's {@code s[0..n-1]} for each element of a list (month / weekday abbreviations).
+	 */
+	@TemplateFunction
+	public static List<String> prefixes(List<String> items, int length)
+	{
+		final List<String> result = new ArrayList<>();
+		if(items == null)
+		{
+			return result;
+		}
+		for(String item : items)
+		{
+			result.add(item.substring(0, Math.min(length, item.length())));
+		}
+		return result;
+	}
+
