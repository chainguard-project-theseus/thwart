diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/globalDatePicker.html b/BudgetMasterServer/src/main/resources/templates/helpers/globalDatePicker.html
new file mode 100644
index 00000000..81a5f138
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/globalDatePicker.html
@@ -0,0 +1,80 @@
+<t:block xmlns:t="https://tessera.dev">
+
+<!--/*
+Fragments (FreeMarker globalDatePicker.ftl):
+- datePicker(LocalDate fullDate, String target, LocalDate currentDate, List<String> localizedMonthNames)
+    month navigation + modal to pick month/year. target is the page path, e.g. '/transactions'.
+    currentDate and localizedMonthNames were globals (model attributes) of the old macro.
+- datepickerGridYear(int startYear, int currentYear)
+- datepickerGrid(List<String> items, String currentItem): table with 3 items per row
+- datePickerLocalization(List<String> localizedMonthNames, List<String> localizedWeekdays)
+    script with the globals monthNames, monthNamesShort, weekDays, weekDaysShort, weekDaysLetters,
+    buttonCancel, buttonClose for the materialize date pickers.
+*/-->
+
+<t:block t:fragment="datePicker(LocalDate fullDate, String target, LocalDate currentDate, List<String> localizedMonthNames)">
+     <div class="container">
+         <div class="section center-align">
+             <a t:href="|/previousMonth?target=${target}|" id="global-datepicker-previous-month" class="waves-effect text-default"><i class="material-icons icon-chevron">chevron_left</i></a>
+             <a href="#modalDate" class="waves-effect headline-date modal-trigger text-default datePicker-fixed-width" t:text="fmt.dateMonthAndYear(fullDate)"></a>
+             <a t:href="|/nextMonth?target=${target}|" id="global-datepicker-next-month" class="waves-effect text-default"><i class="material-icons icon-chevron">chevron_right</i></a>
+             <a t:href="|/today?target=${target}|" id="global-datepicker-today" class="waves-effect text-default"><i class="material-icons icon-today">event</i></a>
+         </div>
+     </div>
+    <!-- modal to select specific month and year -->
+    <div id="modalDate" class="modal modal-fixed-footer">
+        <div class="modal-content background-color">
+
+            <div id="global-datepicker-select-year">
+                <t:block t:replace="~{::datepickerGridYear(currentDate.getYear() - 7, currentDate.getYear())}"></t:block>
+            </div>
+
+            <div id="global-datepicker-select-month">
+                <h4 t:text="locale.getString('title.datepicker.month')"></h4>
+                <t:block t:replace="~{::datepickerGrid(localizedMonthNames, localizedMonthNames[currentDate.getMonthValue() - 1])}"></t:block>
+            </div>
+        </div>
+        <div class="modal-footer background-color">
+            <t:block t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white')}"></t:block>
+            <t:block t:replace="~{helpers/header :: buttonLink('/setDate?target=' + target, 'done', 'ok', 'buttonChooseDate', 'green', 'modal-action modal-close text-white')}"></t:block>
+        </div>
+    </div>
+
+    <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.globalDatePicker.hotkeys'), 'fas fa-info', '/hotkeys')}"></t:block>
+</t:block>
+
+<t:block t:fragment="datepickerGridYear(int startYear, int currentYear)">
+    <h4 t:text="locale.getString('title.datepicker.year')"></h4>
+
+    <div class="hidden" id="currentYear" t:text="currentYear"></div>
+
+    <div class="center-align">
+        <a class="waves-effect text-default global-datepicker-button" id="global-datepicker-previous"><i class="material-icons icon-chevron">chevron_left</i></a>
+        <a class="waves-effect text-default global-datepicker-button" id="global-datepicker-next"><i class="material-icons icon-chevron">chevron_right</i></a>
+    </div>
+
+    <t:block t:replace="~{::datepickerGrid(tx.yearRange(startYear, 12), '' + currentYear)}"></t:block>
+</t:block>
+
+<table t:fragment="datepickerGrid(List<String> items, String currentItem)" class="no-border-table global-datepicker-table">
+    <tbody>
+        <tr t:each="row : tx.rows(items, 3)">
+            <td t:each="item : row" t:class="item == currentItem ? 'global-datepicker-item global-datepicker-selected' : 'global-datepicker-item '" t:text="item"></td>
+        </tr>
+    </tbody>
+</table>
+
+<t:block t:fragment="datePickerLocalization(List<String> localizedMonthNames, List<String> localizedWeekdays)">
+    <!--/* localization for scripts */-->
+    <script>
+        var monthNames = [[${localizedMonthNames}]];
+        var monthNamesShort = [[${tx.prefixes(localizedMonthNames, 3)}]];
+        var weekDays = [[${localizedWeekdays}]];
+        var weekDaysShort = [[${tx.prefixes(localizedWeekdays, 2)}]];
+        var weekDaysLetters = [[${tx.prefixes(localizedWeekdays, 1)}]];
+        var buttonCancel = [[${locale.getString('cancel')}]];
+        var buttonClose = [[${locale.getString('ok')}]];
+    </script>
+</t:block>
+
+</t:block>
