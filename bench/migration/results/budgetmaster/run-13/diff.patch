+<div xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.accounts.Account" t:params="List<Account> accounts"
+     id="modalGlobalAccountSelect" class="modal modal-fixed-footer background-color-light">
+    <div class="modal-content">
+        <div class="row no-margin-bottom">
+            <div class="col s12">
+                <h4 t:text="locale.getString('account.select')"></h4>
+            </div>
+        </div>
+
+        <div class="row">
+            <div class="col s12 center-align">
+                <t:block t:replace="~{helpers/header :: buttonLink('/accounts', 'edit', 'account.button.manage', '', 'background-blue', '')}"></t:block>
+            </div>
+        </div>
+
+        <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.globalAccountSelect.hotkeys'), 'fas fa-info', '')}"></t:block>
+
+        <div class="row">
+            <div t:each="account, stat : accounts" class="col s12 m6 xl6"
+                 t:with="accountName=${account.getType() == 'ALL' ? locale.getString('account.all') : account.getName()}, accountBudget=${helpers.getAccountBudgetByID(account.getID())}, dark=${helpers.getSettings().isUseDarkTheme()}">
+                <a t:href="@{/accounts/{id}/select(id=account.getID())}" class="text-default">
+                    <div class="card-panel global-account-select-option" t:data-account-index="stat.index">
+                        <div class="global-account-select-option-header">
+                            <div t:if="stat.index < 10" class="keyboard-key bold global-account-select-option-key" t:text="stat.index"></div>
+                            <div t:unless="stat.index < 10" class="keyboard-key bold global-account-select-option-key-hidden">&nbsp;</div>
+
+                            <t:block t:if="account.getEndDate() != null" t:with="remainingDays=${account.getRemainingDays()}">
+                                <i t:if="remainingDays <= 0" class="fas fa-bell text-red tooltipped" data-position="right" t:title="locale.getString('account.tooltip.endDate.done', acc.abs(remainingDays))"></i>
+                                <i t:if="remainingDays > 0 && remainingDays <= 30" class="fas fa-bell text-yellow tooltipped" data-position="right" t:title="locale.getString('account.tooltip.endDate.soon', remainingDays)"></i>
+                            </t:block>
+
+                        </div>
+                        <div class="global-account-select-option-content">
+                            <t:block t:replace="~{helpers/customSelect :: accountIcon(account, accountName, 'category-circle-preview account-icon-big', dark)}"></t:block>
+                            <div class="global-account-select-option-column-2">
+                                <div class="global-account-select-option-name truncate" t:text="accountName"></div>
+                                <div t:if="accountBudget <= 0" t:class="|global-account-select-option-balance ${dark ? 'text-red-light' : 'text-red'}|" t:text="fmt.currency(accountBudget)"></div>
+                                <div t:unless="accountBudget <= 0" t:class="|global-account-select-option-balance ${dark ? 'text-green' : 'text-green-dark'}|" t:text="fmt.currency(accountBudget)"></div>
+                            </div>
+                        </div>
+                    </div>
+                </a>
+            </div>
+        </div>
+    </div>
+    <div class="modal-footer background-color-light">
+        <t:block t:replace="~{helpers/header :: buttonLinkNoUrl('clear', 'cancel', 'buttonCloseGlobalAccountSelect', 'red', 'modal-action modal-close text-white')}"></t:block>
+    </div>
+</div>
