+    </div>
+</t:block>
+</t:block>
diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/customSelect.html b/BudgetMasterServer/src/main/resources/templates/helpers/customSelect.html
new file mode 100644
index 00000000..be0cbc2e
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/customSelect.html
@@ -0,0 +1,141 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState, de.deadlocker8.budgetmaster.categories.Category">
+
+<!--/* customSelectMacros.ftl. customSelectStart/customSelectEnd are written out in each select. */-->
+
+<div t:fragment="customCategorySelect(List<Category> categories, Category selectedCategory, String inputClasses, String labelText, String id, boolean showName, String rowClasses, boolean disabled, String form)" t:class="|row ${rowClasses}|">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix">label</i>
+        <label t:unless="strings.isEmpty(labelText)" class="input-label" t:for="id" t:text="labelText"></label>
+        <div t:class="|custom-select-wrapper category-select-wrapper ${disabled ? 'disabled' : ''}|" t:id="id">
+            <div class="custom-select">
+                <div class="custom-select-trigger" tabindex="0">
+                    <div class="custom-select-selected-item">
+                        <t:block t:if="selectedCategory != null" t:replace="~{::customSelectOptionCategoryContent(selectedCategory, 'no-margin-left', true, showName)}"></t:block>
+                    </div>
+                    <div class="custom-select-arrow"></div>
+                </div>
+                <div class="custom-select-options">
+                    <t:block t:each="category : categories">
+                        <t:block t:if="category.getType() != 'REST'">
+                            <t:block t:if="selectedCategory != null" t:replace="~{::customSelectCategoryOption(category, selectedCategory.getID() == category.getID())}"></t:block>
+                            <t:block t:if="selectedCategory == null" t:replace="~{::customSelectCategoryOption(category, category.getType() == 'NONE')}"></t:block>
+                        </t:block>
+                    </t:block>
+                </div>
+            </div>
+            <input type="hidden" name="category" class="hidden-input-custom-select" t:value="selectedCategory != null ? '' + selectedCategory.getID() : null" t:form="strings.isEmpty(form) ? null : form"/>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="customAccountSelect(String selector, String inputName, List<Account> accounts, Account selectedAccount, String inputClasses, String labelText, String id, boolean disabled)" class="row ">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix">account_balance</i>
+        <label t:unless="strings.isEmpty(labelText)" class="input-label" t:for="id" t:text="labelText"></label>
+        <div t:class="|custom-select-wrapper ${selector} ${disabled ? 'disabled' : ''}|" t:id="id">
+            <div class="custom-select">
+                <div class="custom-select-trigger" tabindex="0">
+                    <div class="custom-select-selected-item">
+                        <t:block t:if="selectedAccount != null" t:replace="~{::customSelectOptionAccountContent(selectedAccount, 'no-margin-left')}"></t:block>
+                    </div>
+                    <div class="custom-select-arrow"></div>
+                </div>
+                <div class="custom-select-options">
+                    <t:block t:each="account : accounts">
+                        <t:block t:if="account.getType() == 'CUSTOM'">
+                            <t:block t:if="selectedAccount != null" t:replace="~{::customSelectAccountOption(account, selectedAccount.getID() == account.getID())}"></t:block>
+                            <t:block t:if="selectedAccount == null" t:replace="~{::customSelectAccountOption(account, false)}"></t:block>
+                        </t:block>
+                    </t:block>
+                </div>
+            </div>
+            <input type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedAccount != null ? '' + selectedAccount.getID() : null"/>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="globalAccountSelect" class="input-field no-margin">
+    <div class="custom-select-wrapper global-account-select-wrapper">
+        <div class="custom-select">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:replace="~{::customSelectOptionAccountContent(helpers.getCurrentAccount(), 'no-margin-left')}"></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="account : helpers.getAllReadableAccounts()"><t:block t:replace="~{::customSelectAccountOption(account, account.isSelected())}"></t:block></t:block>
+            </div>
+        </div>
+
+        <input type="hidden" class="hidden-input-custom-select" t:value="'' + helpers.getCurrentAccount().getID()"/>
+    </div>
+</div>
+
+<div t:fragment="customAccountStateSelect(String selector, String inputName, List<AccountState> availableStates, AccountState selectedState, String inputClasses, String labelText, String id)" class="row ">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix">visibility</i>
+        <label t:unless="strings.isEmpty(labelText)" class="input-label" t:for="id" t:text="labelText"></label>
+        <div t:class="|custom-select-wrapper ${selector} |" t:id="id">
+            <div class="custom-select">
+                <div class="custom-select-trigger" tabindex="0">
+                    <div class="custom-select-selected-item">
+                        <t:block t:if="selectedState != null" t:replace="~{::customSelectOptionAccountStateContent(selectedState, 'no-margin-left')}"></t:block>
+                    </div>
+                    <div class="custom-select-arrow"></div>
+                </div>
+                <div class="custom-select-options">
+                    <t:block t:each="state : availableStates"><t:block t:replace="~{::customSelectAccountStateOption(state, selectedState != null && selectedState == state)}"></t:block></t:block>
+                </div>
+            </div>
+            <input type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedState != null ? acc.enumName(selectedState) : null"/>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="customSelectCategoryOption(Category category, boolean isSelected)" t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="category.getID()">
+    <t:block t:replace="~{::customSelectOptionCategoryContent(category, '', false, true)}"></t:block>
+</div>
+
+<t:block t:fragment="customSelectOptionCategoryContent(Category category, String classes, boolean datasetValue, boolean showName)">
+    <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(category, 'category-circle-small ' + classes, datasetValue, false)}"></t:block>
+    <span t:if="showName" class="custom-select-item-name" t:text="helpers.categoryName(category)"></span>
+</t:block>
+
+<div t:fragment="customSelectAccountOption(Account account, boolean isSelected)" t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="account.getID()">
+    <t:block t:replace="~{::customSelectOptionAccountContent(account, '')}"></t:block>
+</div>
+
+<t:block t:fragment="customSelectOptionAccountContent(Account account, String classes)" t:with="accountName=${account.getType() == 'ALL' ? locale.getString('account.all') : account.getName()}">
+    <t:block t:replace="~{::accountIconWithValue(account, accountName, 'category-circle-small ' + classes, helpers.getSettings().isUseDarkTheme())}"></t:block>
+    <span class="custom-select-item-name" t:text="accountName"></span>
+</t:block>
+
+<!--/* accountIcon with datasetValue: the old select options wrote data-value with the account's ID */-->
+<div t:fragment="accountIconWithValue(Account account, String accountName, String classes, boolean dark)" t:class="|category-circle ${classes} category-square ${account.getIconReference() != null && account.getIconReference().isFallbackIcon() ? 'account-square-border' : ''}|" t:data-value="account.getID()">
+    <span t:style="|color: ${css.color(helpers.accountFontColor(account, dark))}|">
+        <t:block t:replace="~{helpers/header :: entityIcon(account.getIconReference(), 'account-select-icon', accountName)}"></t:block>
+    </span>
+</div>
+
+<!--/* accountIcon without datasetValue (navbar, account list) */-->
+<div t:fragment="accountIcon(Account account, String accountName, String classes, boolean dark)" t:class="|category-circle ${classes} category-square ${account.getIconReference() != null && account.getIconReference().isFallbackIcon() ? 'account-square-border' : ''}|">
+    <span t:style="|color: ${css.color(helpers.accountFontColor(account, dark))}|">
+        <t:block t:replace="~{helpers/header :: entityIcon(account.getIconReference(), 'account-select-icon', accountName)}"></t:block>
+    </span>
+</div>
+
+<div t:fragment="customSelectAccountStateOption(AccountState state, boolean isSelected)" t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="state == 'FULL_ACCESS' ? 'FULL_ACCESS' : (state == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN')">
+    <t:block t:replace="~{::customSelectOptionAccountStateContent(state, '')}"></t:block>
+</div>
+
+<t:block t:fragment="customSelectOptionAccountStateContent(AccountState state, String classes)">
+    <div t:class="|category-circle category-circle-small ${classes}|" t:data-value="state == 'FULL_ACCESS' ? 'FULL_ACCESS' : (state == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN')">
+        <span class="text-blue">
+            <i t:class="state.getIcon()"></i>
+        </span>
+    </div>
+    <span class="custom-select-item-name" t:text="locale.getString(state.getLocalizationKey())"></span>
+</t:block>
+
+</t:block>
