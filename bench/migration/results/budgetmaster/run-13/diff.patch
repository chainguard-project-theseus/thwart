--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/settings/containers/settingsPersonalization.html
@@ -0,0 +1,124 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings" t:params="Settings settings, List<Integer> searchResultsPerPageOptions, Map<String, String> validationErrors, String toastContent">
+<t:block t:replace="~{::personalizationSettingsContainer(true, settings, true, searchResultsPerPageOptions, validationErrors, toastContent)}"></t:block>
+
+<t:block t:fragment="personalizationSettingsContainer(boolean importScripts, Settings settings, boolean showReloadWarning, List<Integer> searchResultsPerPageOptions, Map<String, String> validationErrors, String toastContent)">
+    <form name="PersonalizationSettingsContainer" method="post" t:action="@{/settings/save/personalization}">
+        <!--/* language */-->
+        <div class="row">
+            <div class="input-field col s12 m12 l8 offset-l2">
+                <i class="material-icons prefix">translate</i>
+                <select id="settings-language" name="language" t:class="validation.cls(validationErrors, 'language', '')" t:data-position="validation.has(validationErrors, 'language') ? 'bottom' : null" t:data-delay="validation.has(validationErrors, 'language') ? 50 : null" t:title="validation.tooltip(validationErrors, 'language')">
+                    <option t:each="language : helpers.getAvailableLanguages()" t:selected="settings.getLanguage() == language" t:value="language.getName()" t:text="language.getName()"></option>
+                </select>
+                <label for="settings-language" t:text="locale.getString('settings.language')"></label>
+            </div>
+        </div>
+
+        <!--/* currency */-->
+        <div class="row">
+            <div class="input-field col s12 m12 l8 offset-l2">
+                <i class="material-icons prefix">euro</i>
+                <input id="settings-currency" type="text" name="currency" t:class="validation.cls(validationErrors, 'currency', '')" t:data-position="validation.has(validationErrors, 'currency') ? 'bottom' : null" t:data-delay="validation.has(validationErrors, 'currency') ? 50 : null" t:title="validation.tooltip(validationErrors, 'currency')" t:value="settings.getCurrency() ?: ''">
+                <label for="settings-currency" t:text="locale.getString('settings.currency')"></label>
+            </div>
+        </div>
+
+        <!-- theme -->
+        <div class="row center-align">
+            <div class="col col s6 m6 l4 offset-l2">
+                <div t:text="locale.getString('settings.darkTheme.deactivated')"></div>
+                <img t:class="settings.isUseDarkTheme() ? 'responsive-img settings-preview-image ' : 'responsive-img settings-preview-image settings-preview-image-selected'" t:src="@{/images/settings/themeLight.png}" data-use-dark-theme="false"/>
+            </div>
+
+            <div class="col col s6 m6 l4">
+                <div t:text="locale.getString('settings.darkTheme.activated')"></div>
+                <img t:class="settings.isUseDarkTheme() ? 'responsive-img settings-preview-image settings-preview-image-selected' : 'responsive-img settings-preview-image '" t:src="@{/images/settings/themeDark.png}" data-use-dark-theme="true"/>
+            </div>
+
+            <input type="hidden" id="useDarkTheme" name="useDarkTheme" t:value="'' + settings.isUseDarkTheme()"/>
+        </div>
+
+        <!--/* dark theme and category style */-->
+        <t:block t:replace="~{settings/settingsMacros :: switches(settings)}"></t:block>
+
+        <!--/* search items per page */-->
+        <div class="row">
+            <div class="input-field col s12 m12 l8 offset-l2">
+                <i class="material-icons prefix">search</i>
+                <select id="settings-search-items-per-page" name="searchItemsPerPage" t:class="validation.cls(validationErrors, 'searchItemsPerPage', '')" t:data-position="validation.has(validationErrors, 'searchItemsPerPage') ? 'bottom' : null" t:data-delay="validation.has(validationErrors, 'searchItemsPerPage') ? 50 : null" t:title="validation.tooltip(validationErrors, 'searchItemsPerPage')">
+                    <option t:each="number : searchResultsPerPageOptions" t:selected="settings.getSearchItemsPerPage() == number" t:value="number" t:text="number"></option>
+                </select>
+                <label for="settings-search-items-per-page" t:text="locale.getString('settings.search.itemsPerPage')"></label>
+            </div>
+        </div>
+
+        <div class="row">
+            <div class="col s12 center-align">
+                <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'background-green', '')}"></t:block>
+            </div>
+        </div>
+
+        <div t:if="showReloadWarning" class="row notification-row">
+            <div class="col s12 center-align">
+                <div class="notification-wrapper">
+                    <div class="notification background-yellow text-black">
+                        <i class="fas fa-exclamation-triangle notification-item"></i>
+                        <span class="notification-item left-align" t:utext="set.linkMessage('settings.personalization.reload.page')"></span>
+                    </div>
+                </div>
+            </div>
+        </div>
+
+        <script>
+
+            $('.settings-preview-image').click(function()
+            {
+                for(let item of document.getElementsByClassName('settings-preview-image'))
+                {
+                    item.classList.toggle('settings-preview-image-selected', false);
+                }
+
+                this.classList.toggle('settings-preview-image-selected', true);
+
+                document.getElementById('useDarkTheme').value = this.dataset.useDarkTheme;
+                toggleSettingsContainerHeader('personalizationSettingsContainerHeader', false);
+            });
+
+            // show unsaved changes warning
+            $('#settings-language').change(function()
+            {
+                toggleSettingsContainerHeader('personalizationSettingsContainerHeader', false);
+            });
+
+            $('#settings-currency').on('change keydown paste input', function()
+            {
+                toggleSettingsContainerHeader('personalizationSettingsContainerHeader', false);
+            });
+
+            $('input[name="showCategoriesAsCircles"]').change(function()
+            {
+                toggleSettingsContainerHeader('personalizationSettingsContainerHeader', false);
+            });
+
+            $('#settings-password-confirmation').on('change keydown paste input', function()
+            {
+                toggleSettingsContainerHeader('personalizationSettingsContainerHeader', false);
+            });
+
+            $('#settings-search-items-per-page').change(function()
+            {
+                toggleSettingsContainerHeader('personalizationSettingsContainerHeader', false);
+            });
+        </script>
+    </form>
+
+    <t:block t:replace="~{settings/settingsMacros :: toastContent(toastContent)}"></t:block>
+
+    <t:block t:if="importScripts">
+        <t:block t:replace="~{settings/settingsMacros :: containerLibraries}"></t:block>
+        <script>
+            initSettingsContainer('PersonalizationSettingsContainer', 'personalizationSettingsContainer');
+        </script>
+    </t:block>
+</t:block>
+</t:block>
