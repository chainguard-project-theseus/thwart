@@ -0,0 +1,27 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.accounts.AccountState">
+
+<!--/* Copy of helpers/customSelect :: customAccountStateSelect with the hidden input fixed: the shared one writes
+       '' + selectedState, which is AccountState.toString() ("AccountState{icon=...} FULL_ACCESS") instead of the name.
+       Delete this once the shared fragment is fixed. */-->
+<div t:fragment="customAccountStateSelect(String selector, String inputName, List<AccountState> availableStates, AccountState selectedState, String inputClasses, String labelText, String id)" class="row ">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix">visibility</i>
+        <label t:unless="strings.isEmpty(labelText)" class="input-label" t:for="id" t:text="labelText"></label>
+        <div t:class="|custom-select-wrapper ${selector} |" t:id="id">
+            <div class="custom-select">
+                <div class="custom-select-trigger" tabindex="0">
+                    <div class="custom-select-selected-item">
+                        <t:block t:if="selectedState != null" t:replace="~{helpers/customSelect :: customSelectOptionAccountStateContent(selectedState, 'no-margin-left')}"></t:block>
+                    </div>
+                    <div class="custom-select-arrow"></div>
+                </div>
+                <div class="custom-select-options">
+                    <t:block t:each="state : availableStates"><t:block t:replace="~{helpers/customSelect :: customSelectAccountStateOption(state, selectedState != null && selectedState == state)}"></t:block></t:block>
+                </div>
+            </div>
+            <input type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="acc.enumName(selectedState)"/>
+        </div>
+    </div>
+</div>
+
+</t:block>
