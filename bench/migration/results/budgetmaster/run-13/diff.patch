index 00000000..4fae4926
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionMacros.html
@@ -0,0 +1,363 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.repeating.RepeatingOption, de.deadlocker8.budgetmaster.tags.Tag">
+
+<!--/*
+    newTransactionMacros.ftl as fragments (shared by the new/edit transaction pages, templates/newTemplate and transactionImport).
+    Every argument must be passed. validationErrors is the page's Map<String, String> validationErrors (may be null).
+
+    isExpenditureSwitch(Boolean isExpenditure)                         null counts as expenditure
+    transactionName(String name, String suggestionsJSON, Map<String, String> validationErrors)
+    insertNameSuggestions(String suggestionsJSON)                     suggestionsJSON: the JSON array string from the model
+    transactionAmount(Integer amount, Map<String, String> validationErrors)
+    transactionStartDate(LocalDate date, LocalDate currentDate)       date may be null (currentDate is then the picker default)
+    transactionDescription(String description, Map<String, String> validationErrors)
+    transactionTags(List<Tag> tags)                                   tags may be null
+    transactionRepeating(RepeatingOption repeatingOption, LocalDate currentDate, Map<String, String> validationErrors)
+    buttons(String cancelURL, boolean includeContinueButton, boolean allowEmptyAmount)
+        cancelURL is final: the old buttonCancel replaced it with '/transactionImport' when the session had a
+        currentCsvTransaction, so callers pass  currentCsvTransaction != null ? '/transactionImport' : '/transactions'
+        (the model attribute currentCsvTransaction is filled by NewTxSessionModelConfiguration).
+        The save buttons' old onclick="return validateForm(...)" is bound in transactions.js
+        (allowEmptyAmount is derived there from the presence of #template-name, as openKeywordWarningModal already did).
+    buttonTransactionActions(boolean canChangeType, boolean canCreateTemplate, boolean changeTypeInProgress, Integer transactionID)
+    datePickerLocalization(List<String> localizedMonthNames, List<String> localizedWeekdays)
+        TEMPORARY local copy of helpers/globalDatePicker.ftl's datePickerLocalization, until helpers/globalDatePicker.html exists.
+*/-->
+
+<t:block t:fragment="isExpenditureSwitch(Boolean isExpenditure)" t:with="expenditure=${isExpenditure != false}, colorButtonIncome=${expenditure ? 'background-grey text-isPayment' : 'background-green'}, colorButtonExpenditure=${expenditure ? 'background-red' : 'background-grey text-isPayment'}">
+    <input type="hidden" name="isExpenditure" id="input-isPayment" t:value="expenditure ? 'true' : 'false'">
+
+    <div class="row">
+        <div class="col s12 center-align">
+            <div class="row hide-on-small-only">
+                <div class="col s6 right-align">
+                    <t:block t:replace="~{::buttonIncome(colorButtonIncome)}"></t:block>
+                </div>
+                <div class="col s6 left-align">
+                    <t:block t:replace="~{::buttonExpenditure(colorButtonExpenditure)}"></t:block>
+                </div>
+            </div>
+
+            <div class="hide-on-med-and-up">
+                <div class="row center-align">
+                    <div class="col s12">
+                        <t:block t:replace="~{::buttonIncome(colorButtonIncome)}"></t:block>
+                    </div>
+                </div>
+                <div class="row center-align">
+                    <div class="col s12">
+                        <t:block t:replace="~{::buttonExpenditure(colorButtonExpenditure)}"></t:block>
+                    </div>
+                </div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="buttonIncome(String color)">
+    <t:block t:replace="~{helpers/header :: buttonLinkNoUrl('file_download', 'title.income', '', color, 'buttonIncome')}"></t:block>
+</t:block>
+
+<t:block t:fragment="buttonExpenditure(String color)">
+    <t:block t:replace="~{helpers/header :: buttonLinkNoUrl('file_upload', 'title.expenditure', '', color, 'buttonExpenditure')}"></t:block>
+</t:block>
+
+<t:block t:fragment="transactionName(String name, String suggestionsJSON, Map<String, String> validationErrors)">
+    <div class="row">
