+		{
+			final Object value = request.getAttribute(name, RequestAttributes.SCOPE_SESSION);
+			if(value != null)
+			{
+				model.addAttribute(name, value);
+			}
+		}
+
+		final Object csvImport = request.getAttribute(RequestAttributeNames.CSV_IMPORT, RequestAttributes.SCOPE_SESSION);
+		if(csvImport instanceof CsvImport existingCsvImport)
+		{
+			model.addAttribute("csvFileName", existingCsvImport.getFileName());
+		}
+		final List<String> nameSuggestions = new Gson().fromJson(transactionService.getNameSuggestionsJson(), new TypeToken<List<String>>(){}.getType());
+		model.addAttribute("importNameSuggestions", nameSuggestions);
+	}
