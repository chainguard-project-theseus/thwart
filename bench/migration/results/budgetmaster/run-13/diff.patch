diff --git a/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html b/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html
new file mode 100644
index 00000000..c49d3bbc
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html
@@ -0,0 +1,85 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account"
+      t:params="Settings settings, List<Notification> notifications, boolean isEdit, Template template, List<Category> categories, List<Account> accounts, String suggestionsJSON, List<String> fontawesomeIcons, Map<String, String> validationErrors, List<String> localizedMonthNames, List<String> localizedWeekdays">
+    <head t:with="title=${isEdit ? locale.getString('title.template.edit') : locale.getString('title.template.new')}">
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('transactions')}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('datepicker')}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('collapsible')}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('iconSelect')}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark' : null">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="isEdit ? locale.getString('title.template.edit') : locale.getString('title.template.new')"></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: notifications(notifications)}"></t:block>
+                <div class="container">
+                <form id="mainForm" name="NewTemplate" t:action="@{/templates/newTemplate}" method="post">
+                    <input type="hidden" name="ID" t:value="template.getID() != null ? '' + template.getID() : ''">
+                    <input type="hidden" name="templateGroup" t:value="template.getTemplateGroup() != null ? '' + template.getTemplateGroup().getID() : ''">
+
+                    <t:block t:replace="~{transactions/newTransactionMacros :: isExpenditureSwitch(template.getExpenditure())}"></t:block>
+
+                    <t:block t:replace="~{templates/templateFunctions :: templateNameInput(template, validationErrors)}"></t:block>
+
+                    <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(template.getName(), suggestionsJSON, validationErrors)}"></t:block>
+
+                    <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(template.getAmount(), validationErrors)}"></t:block>
+
+                    <t:block t:replace="~{helpers/customSelect :: customCategorySelect(categories, template.getCategory(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.category'), 'transaction-category', true, '', false, '')}"></t:block>
+
+                    <t:block t:replace="~{transactions/newTransactionMacros :: transactionDescription(template.getDescription(), validationErrors)}"></t:block>
+
+                    <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(template.getTags())}"></t:block>
+
+                    <t:block t:if="template.getAccount() != null">
+                        <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-account', 'includeAccount', locale.getString('template.checkbox.include.account'), true)}"></t:block>
+                        <t:block t:replace="~{helpers/customSelect :: customAccountSelect('account-select-wrapper', 'account', accounts, template.getAccount(), 'col s12 m12 l8 offset-l2', '', 'transaction-account', false)}"></t:block>
+                    </t:block>
+                    <t:block t:if="template.getAccount() == null">
+                        <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-account', 'includeAccount', locale.getString('template.checkbox.include.account'), false)}"></t:block>
+                        <t:block t:replace="~{helpers/customSelect :: customAccountSelect('account-select-wrapper', 'account', accounts, helpers.getCurrentAccountOrDefault(), 'col s12 m12 l8 offset-l2', '', 'transaction-account', true)}"></t:block>
+                    </t:block>
+
+                    <t:block t:if="template.getTransferAccount() != null">
+                        <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-transfer-account', 'includeTransferAccount', locale.getString('template.checkbox.include.account.transfer'), true)}"></t:block>
+                        <t:block t:replace="~{helpers/customSelect :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, template.getTransferAccount(), 'col s12 m12 l8 offset-l2', '', 'transaction-destination-account', false)}"></t:block>
+                    </t:block>
+                    <t:block t:if="template.getTransferAccount() == null">
+                        <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-transfer-account', 'includeTransferAccount', locale.getString('template.checkbox.include.account.transfer'), false)}"></t:block>
+                        <t:block t:replace="~{helpers/customSelect :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, helpers.getCurrentAccountOrDefault(), 'col s12 m12 l8 offset-l2', '', 'transaction-destination-account', true)}"></t:block>
+                    </t:block>
+
+                    <t:block t:replace="~{helpers/iconSelect :: iconSelect('template-icon', template.getIconReference(), template.getName(), null, acc.fontColor(template, settings.isUseDarkTheme()), false, '', '', true)}"></t:block>
+
+                    <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(acc.fontColor(template, settings.isUseDarkTheme()), acc.defaultFontColor(template, settings.isUseDarkTheme()))}"></t:block>
+
+                    <t:block t:replace="~{transactions/newTransactionMacros :: buttons('/templates', false, true)}"></t:block>
+                </form>
+
+                <div id="transactionNameKeywordWarningModalContainer"></div>
+                </div>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/iconSelect :: modalIconSelect('template-name', template.getIconReference(), fontawesomeIcons)}"></t:block>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></t:block>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
