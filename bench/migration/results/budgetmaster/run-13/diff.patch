+        <t:block t:replace="~{helpers/navbar :: navbar('charts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">show_chart</i> [[${locale.getString('title.charts')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: notifications(notifications)}"></t:block>
+                <div class="row">
+                    <div class="col s12 center-align">
+                        <t:block t:replace="~{helpers/header :: buttonLinkNoUrl('edit', 'chart.button.settings', 'buttonShowChartSettings', 'background-blue', 'hidden')}"></t:block>
+                    </div>
+                </div>
+
+                <form name="NewChartSettings" t:action="@{/charts}" method="post" t:class="chartSettings.isChartSelected() ? 'hidden' : ''">
+                    <div class="container">
+                        <div class="row">
+                            <div class="col s12 center-align">
+                                <t:block t:each="displayType : displayTypes">
+                                    <a t:class="|waves-effect waves-light btn-large text-black button-display-type ${displayType == chartSettings.getDisplayType() ? 'active' : ''}|" t:data-value="displayType == 'PIE' ? 'PIE' : (displayType == 'BAR' ? 'BAR' : (displayType == 'LINE' ? 'LINE' : 'CUSTOM'))">
+                                        <t:block t:replace="~{charts/chartFunctions :: iconForItem(misc.hasFontAwesomeIcon(displayType), displayType.getIcon(), displayType.getLocalizationKey())}"></t:block>
+                                    </a>
+                                </t:block>
+                            </div>
+                        </div>
+                    </div>
+                    <input type="hidden" name="displayType" t:value="acc.enumName(chartSettings.getDisplayType())">
+
+                    <div class="container" id="chart-group-type-buttons">
+                        <div class="row">
+                            <div class="col s12 center-align">
+                                <t:block t:each="groupType : groupTypes">
+                                    <a t:class="|waves-effect waves-light btn-large text-black button-group-type ${groupType == chartSettings.getGroupType() ? 'active' : ''}|" t:data-value="groupType == 'NONE' ? 'NONE' : (groupType == 'MONTH' ? 'MONTH' : 'YEAR')">
+                                        <t:block t:replace="~{charts/chartFunctions :: iconForItem(misc.hasFontAwesomeIcon(groupType), groupType.getIcon(), groupType.getLocalizationKey())}"></t:block>
+                                    </a>
+                                </t:block>
+                            </div>
+                        </div>
+                    </div>
+                    <input type="hidden" name="groupType" t:value="acc.enumName(chartSettings.getGroupType())">
