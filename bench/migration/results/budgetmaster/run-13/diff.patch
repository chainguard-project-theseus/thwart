diff --git a/BudgetMasterServer/src/main/resources/templates/search/searchMacros.html b/BudgetMasterServer/src/main/resources/templates/search/searchMacros.html
new file mode 100644
index 00000000..b82d5f69
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/search/searchMacros.html
@@ -0,0 +1,145 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.search.Search, de.deadlocker8.budgetmaster.transactions.Transaction">
+
+<!--/*
+Fragments (FreeMarker searchMacros.ftl):
+- searchTextAndButton(Search search)
+- checkboxes(Search search)
+- dateRange(Search search): sets the script globals startDate / endDate (Date or null)
+- pagination(int number, int totalPages, String position): old macro took the Spring Data page;
+    number is the current page index (0-based), position 'top' or 'bottom'
+- renderTransactions(List<Transaction> transactions, boolean openLinksInNewTab)
+*/-->
+
+<div t:fragment="searchTextAndButton(Search search)" class="row no-margin-bottom valign-wrapper">
+    <div class="col s10 m6 offset-m2 l5 offset-l3">
+        <div class="input-field">
+            <input id="searchText" type="text" name="searchText" t:value="search.getSearchText()">
+            <label for="searchText" t:text="locale.getString('search')"></label>
+        </div>
+    </div>
+
+    <div class="col s2 m4 l4">
+        <div class="hide-on-small-only">
+            <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'search', 'search.submit', 'button-perform-search', 'background-blue', '')}"></t:block>
+        </div>
+        <div class="hide-on-med-and-up">
+            <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'search', '', 'button-perform-search', 'background-blue', '')}"></t:block>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="checkboxes(Search search)" class="row">
+    <div class="col s8 offset-s2 m4 offset-m2 l3 offset-l3">
+        <div class="search-checkbox-container">
+            <label>
+                <input type="checkbox" name="searchName" t:checked="search.isSearchName()">
+                <span class="text-default" t:text="locale.getString('search.in.name')"></span>
+            </label>
+        </div>
+    </div>
+    <div class="col s8 offset-s2 m6 l6">
+        <div class="search-checkbox-container">
+            <label>
+                <input type="checkbox" name="searchDescription" t:checked="search.isSearchDescription()">
+                <span class="text-default" t:text="locale.getString('search.in.description')"></span>
+            </label>
+        </div>
+    </div>
+    <div class="col s8 offset-s2 m4 offset-m2 l3 offset-l3">
+        <div class="search-checkbox-container">
+            <label>
+                <input type="checkbox" name="searchCategory" t:checked="search.isSearchCategory()">
+                <span class="text-default" t:text="locale.getString('search.in.category')"></span>
+            </label>
+        </div>
+    </div>
+    <div class="col s8 offset-s2 m6 l6">
+        <div class="search-checkbox-container">
+            <label>
+                <input type="checkbox" name="searchTags" t:checked="search.isSearchTags()">
+                <span class="text-default" t:text="locale.getString('search.in.tags')"></span>
+            </label>
+        </div>
+    </div>
+    <div class="col s8 offset-s2 m4 offset-m2 l3 offset-l3">
+        <div class="search-checkbox-container">
+            <label>
+                <input type="checkbox" name="includeHiddenAccounts" t:checked="search.isIncludeHiddenAccounts()">
+                <span class="text-default" t:text="locale.getString('search.include.hidden.accounts')"></span>
+            </label>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="dateRange(Search search)" class="row" t:with="startDate=${search.getStartDate() == null ? '' : fmt.dateLong(search.getStartDate())}, endDate=${search.getEndDate() == null ? '' : fmt.dateLong(search.getEndDate())}">
+    <div class="input-field col s6 m4 offset-m2 l3 offset-l3" id="search-datepicker-container">
+        <script t:if="search.getStartDate() != null">
+            var startDate = [[${startDate}]];
+            startDate = startDate.split(".");
+            startDate = new Date(startDate[2], startDate[1] - 1, startDate[0]);
+        </script>
+        <script t:if="search.getStartDate() == null">
+            startDate = null;
+        </script>
+
+        <i class="material-icons prefix">today</i>
+        <input id="search-datepicker" type="text" class="datepicker" name="startDate" t:value="startDate">
+        <label for="search-datepicker" t:text="locale.getString('chart.steps.second.label.start')"></label>
+    </div>
+
+    <div class="input-field col s6 m4 l3" id="search-datepicker-end-container">
+        <script t:if="search.getEndDate() != null">
+            var endDate = [[${endDate}]];
+            endDate = endDate.split(".");
+            endDate = new Date(endDate[2], endDate[1] - 1, endDate[0]);
+        </script>
+        <script t:if="search.getEndDate() == null">
+            endDate = null;
+        </script>
+
+        <i class="material-icons prefix">event</i>
+        <input id="search-datepicker-end" type="text" class="datepicker" name="endDate" t:value="endDate">
+        <label for="search-datepicker-end" t:text="locale.getString('chart.steps.second.label.end')"></label>
+    </div>
+</div>
+
+<div t:fragment="pagination(int number, int totalPages, String position)" t:class="|row pagination-position-${position}|">
+    <div class="col s12 center-align">
+        <ul t:if="totalPages > 0" class="pagination">
+            <li t:class="number == 0 ? 'text-default disabled' : 'text-default '"><a class="page-link" t:data-page="number - 1"><i class="material-icons">chevron_left</i></a></li>
+                <li t:each="i : numbers.sequence(0, totalPages - 1)" t:class="number == i ? 'waves-effect text-default active' : 'waves-effect text-default '"><a class="page-link" t:data-page="i" t:text="i + 1"></a></li>
+            <li t:class="number == totalPages - 1 ? 'text-default disabled' : 'text-default '"><a class="page-link" t:data-page="number + 1"><i class="material-icons">chevron_right</i></a></li>
+        </ul>
+    </div>
+</div>
+
+<t:block t:fragment="renderTransactions(List<Transaction> transactions, boolean openLinksInNewTab)">
+    <div t:each="transaction : transactions" class="card-panel search-result">
+        <div class="hide-on-large-only">
+            <div class="row valign-wrapper">
+                <div class="col s3 center-align bold transaction-text" t:text="fmt.dateNormal(transaction.getDate())"></div>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction)}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 's2')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionLinks(transaction, openLinksInNewTab)}"></t:block>
+            </div>
+            <div class="row valign-wrapper no-margin-bottom">
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'center-align')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 's5')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(transaction, transaction.getAccount(), 's4')}"></t:block>
+            </div>
+        </div>
+        <div class="hide-on-med-and-down">
+            <div class="row valign-wrapper no-margin-bottom transaction-row-desktop">
+                <div class="col l2 xl1 bold transaction-text transaction-date valign-wrapper" t:text="fmt.dateNormal(transaction.getDate())"></div>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'left-align')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction)}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 'l1 xl1')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 'l3 xl4')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(transaction, transaction.getAccount(), 'l2 xl2')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionLinks(transaction, openLinksInNewTab)}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+</t:block>
