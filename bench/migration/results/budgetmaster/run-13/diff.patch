+                                <t:block t:replace="~{indexFunctions :: action('/accounts', 'home.menu.accounts.action.manage')}"></t:block>
+                                <t:block t:replace="~{indexFunctions :: action('/accounts/newAccount', 'home.menu.accounts.action.new')}"></t:block>
+                            </accounts-actions>
