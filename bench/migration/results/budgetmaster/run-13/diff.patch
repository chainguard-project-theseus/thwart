+	/**
+	 * The FreeMarker views read the import state from the session (spring.freemarker.expose-session-attributes).
+	 * Tessera templates only see the model, so the state is copied into it.
+	 */
+	private void addImportStateToModel(WebRequest request, Model model)
+	{
