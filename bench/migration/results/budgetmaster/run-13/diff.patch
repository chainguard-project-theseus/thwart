@@ -0,0 +1,89 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.transactions.csvimport.CsvTransaction, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account"
+      t:params="Settings settings, List<Notification> notifications, boolean isEdit, boolean changeTypeInProgress, Transaction transaction, LocalDate currentDate, List<Category> categories, List<Account> accounts, String suggestionsJSON, Map<String, String> validationErrors, CsvTransaction currentCsvTransaction, List<String> localizedMonthNames, List<String> localizedWeekdays"
+      t:with="title=${locale.getString(isEdit ? 'title.transaction.edit' : 'title.transaction.new', locale.getString('title.transaction.new.transfer'))}">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('transactions')}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('datepicker')}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('collapsible')}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark' : null">
+        <t:block t:replace="~{helpers/navbar :: navbar('transactions', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="title"></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: notifications(notifications)}"></t:block>
+                    <div class="container">
+                        <form id="mainForm" name="NewTransaction" t:action="@{/transactions/newTransaction}" method="post">
+                            <!-- only set ID for transactions not templates, otherwise the input is filled with the template ID and saving the transaction
+                            may then override an existing transactions if the ID is also already used in transactions table -->
+                            <input type="hidden" name="ID" t:value="transaction.getID() != null ? '' + transaction.getID() : ''">
+                            <input type="hidden" name="isExpenditure" value="true">
+                            <input type="hidden" name="isRepeating" t:value="transaction.isRepeating() ? 'true' : 'false'">
+
+                            <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.transaction.save'), 'fas fa-info', '')}"></t:block>
+
+                            <!--/* name */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(transaction.getName(), suggestionsJSON, validationErrors)}"></t:block>
+
+                            <!--/* amount */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(transaction.getAmount(), validationErrors)}"></t:block>
+
+                            <!--/* category */-->
+                            <t:block t:replace="~{helpers/customSelect :: customCategorySelect(categories, transaction.getCategory(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.category'), 'transaction-category', true, '', false, '')}"></t:block>
+
+                            <!--/* date */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionStartDate(transaction.getDate(), currentDate)}"></t:block>
+
+                            <!--/* description */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionDescription(transaction.getDescription(), validationErrors)}"></t:block>
+
+                            <!--/* tags */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(transaction.getTags())}"></t:block>
+
+                            <!--/* account */-->
+                            <t:block t:replace="~{helpers/customSelect :: customAccountSelect('account-select-wrapper', 'account', accounts, transaction.getAccount() != null ? transaction.getAccount() : helpers.getCurrentAccountOrDefault(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.account'), 'transaction-account', false)}"></t:block>
+
+                            <!--/* transfer account */-->
+                            <t:block t:replace="~{helpers/customSelect :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, transaction.getTransferAccount() != null ? transaction.getTransferAccount() : helpers.getCurrentAccountOrDefault(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.transfer.account'), 'transaction-destination-account', false)}"></t:block>
+
+                            <!--/* repeating options */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionRepeating(transaction.getRepeatingOption(), currentDate, validationErrors)}"></t:block>
+
+                            <!--/* buttons */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttons(currentCsvTransaction != null ? '/transactionImport' : '/transactions', true, false)}"></t:block>
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttonTransactionActions(isEdit, true, changeTypeInProgress, transaction.getID())}"></t:block>
+                        </form>
+
+                        <div id="saveAsTemplateModalContainer"></div>
+
+                        <div id="changeTransactionTypeModalContainer"></div>
+
+                        <div id="transactionNameKeywordWarningModalContainer"></div>
+                    </div>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{transactions/newTransactionMacros :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></t:block>
+
+        <script>
+            var createTemplateWithErrorInForm = [[${locale.getString('save.as.template.errorsInForm')}]];
+            var templateNameEmptyValidationMessage = [[${locale.getString('warning.empty.transaction.name')}]];
+            var templateNameDuplicateValidationMessage = [[${locale.getString('warning.duplicate.template.name')}]];
+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/transactionActions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+    </body>
+</html>
