+                            <div t:each="previewChart : charts" class="col s6 m4 l3 center-align chart-preview-column hidden"
+                                 t:data-display-type="previewChart.getDisplayType() == 'PIE' ? 'PIE' : (previewChart.getDisplayType() == 'BAR' ? 'BAR' : (previewChart.getDisplayType() == 'LINE' ? 'LINE' : 'CUSTOM'))"
