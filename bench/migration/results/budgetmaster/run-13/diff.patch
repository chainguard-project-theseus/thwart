+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.categories.Category">
+
+<!--/* categoriesFunctions.getCategoryName is the function helpers.categoryName(category) */-->
+
+<!--/* categoryCircle(category, classes, datasetValue, enableSearchWrapper); dark and showCategoriesAsCircles come from settings */-->
+<t:block t:fragment="categoryCircle(Category category, String classes, boolean datasetValue, boolean enableSearchWrapper)">
+    <a t:if="enableSearchWrapper" t:href="|/search?searchCategory=true&searchText=${category.getName()}|">
+        <t:block t:replace="~{::circle(category, classes, datasetValue)}"></t:block>
+    </a>
+    <t:block t:unless="enableSearchWrapper" t:replace="~{::circle(category, classes, datasetValue)}"></t:block>
+</t:block>
+
+<div t:fragment="circle(Category category, String classes, boolean datasetValue)" t:with="settings=${helpers.getSettings()}"
+     t:class="|category-circle ${classes} ${settings.getShowCategoriesAsCircles() != null && settings.getShowCategoriesAsCircles() == false ? 'category-square' : ''}|"
+     t:style="|background-color: ${css.color(category.color)}|" t:data-value="datasetValue ? category.getID() : null">
+    <span t:style="|color: ${css.color(helpers.categoryFontColor(category, settings.isUseDarkTheme()))}|">
+        <t:block t:replace="~{helpers/header :: entityIcon(category.getIconReference(), 'category-icon', helpers.categoryName(category))}"></t:block>
+    </span>
+</div>
+
+<div t:fragment="modalIconSelect" id="modalIconSelect" class="modal modal-fixed-footer background-color">
+    <div class="modal-content">
+
+
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{helpers/header :: buttonLinkNoUrl('clear', 'cancel', '', 'red', 'modal-action modal-close text-white')}"></t:block>
+        <a id="button-category-icon-confirm" class="waves-effect waves-light btn green modal-action modal-close text-white" disabled>
+            <i class="material-icons left ">done</i>[[${locale.getString('ok')}]]
+        </a>
+    </div>
+</div>
+
+</t:block>
