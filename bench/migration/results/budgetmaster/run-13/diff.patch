diff --git a/BudgetMasterServer/src/main/resources/templates/transactions/transactions.html b/BudgetMasterServer/src/main/resources/templates/transactions/transactions.html
new file mode 100644
index 00000000..42ec99ba
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/transactions.html
@@ -0,0 +1,110 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.reports.Budget, de.deadlocker8.budgetmaster.filter.FilterConfiguration"
+      t:params="Settings settings, List<Notification> notifications, List<String> localizedMonthNames, List<Transaction> transactions, Account account, Budget budget, LocalDate currentDate, FilterConfiguration filterConfiguration, Integer highlightID">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.transactions'))}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('transactions')}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('globalDatepicker')}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('collapsible')}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark' : null">
+        <t:block t:replace="~{helpers/navbar :: navbar('transactions', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <t:block t:replace="~{helpers/globalDatePicker :: datePicker(currentDate, '/transactions', currentDate, localizedMonthNames)}"></t:block>
+
+                <t:block t:replace="~{helpers/header :: notifications(notifications)}"></t:block>
+                    <div class="container transaction-container">
+                        <div class="row">
+                            <div class="col s4">
+                                <div class="icon-block center-align">
+                                    <img class="budget-headline-icon" t:src="@{/images/piggy_income.svg}">
+                                    <h5 class="budget" t:text="fmt.currency(budget.incomeSum())"></h5>
+                                </div>
+                            </div>
+                            <div class="col s4">
+                                <div class="icon-block center-align">
+                                    <img class="budget-headline-icon" t:src="@{/images/piggy_expenditure.svg}">
+                                    <h5 class="center budget" t:text="fmt.currency(budget.expenditureSum())"></h5>
+                                </div>
+                            </div>
+                            <div class="col s4">
+                                <div class="icon-block center-align">
+                                    <img class="budget-headline-icon" t:src="@{/images/piggy_rest.svg}">
+                                    <h5 class="center budget" t:text="fmt.currency(budget.getRest())"></h5>
+                                </div>
+                            </div>
+                        </div>
+
+                        <!--/* buttons */-->
+                        <t:block t:replace="~{transactions/transactionsMacros :: buttons(filterConfiguration.isActive())}"></t:block>
+
+                        <!--/* transactions list (grouped by date in Java instead of unbalanced divs) */-->
+                        <!--/* the old template never closed the last date group: the placeholder ended up inside it and the
+                             delete modal container and filter modal inside the card; reproduced here for page parity */-->
+                        <div t:each="group, groupStat : tx.groupByDate(transactions)" class="transaction-date-group">
+                            <div class="col s12 center-align bold transaction-text transaction-date" t:text="group.date()"></div>
+
+                            <t:block t:each="transaction : group.transactions()" t:with="shouldHighlight=${highlightID != null && transaction.getID() != null && transaction.getID() == highlightID}, rowClasses=${(transaction.isFuture() ? 'transaction-row-transparent' : '') + ' ' + (shouldHighlight ? 'transaction-row-highlighted' : '')}">
+                            <div t:class="|hide-on-large-only transaction-row-top card transaction-card background-light ${rowClasses}|" t:id="shouldHighlight ? 'highlighted-small' : null">
+                                <div class="row valign-wrapper transaction-row-bottom no-margin-bottom">
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 's6')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(transaction, account, 's6')}"></t:block>
+                                </div>
+                                <div class="row valign-wrapper transaction-row-bottom">
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'left-align no-margin-left')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction)}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 's2')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionButtons(transaction, 's6 right-align')}"></t:block>
+                                </div>
+                            </div>
+
+                            <div t:class="|hide-on-med-and-down transaction-row-top card transaction-card transaction-row-bottom background-light ${rowClasses}|" t:id="shouldHighlight ? 'highlighted-large' : null">
+                                <div class="row valign-wrapper no-margin-bottom transaction-row-desktop">
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'left-align')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction)}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 'l1 xl1')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 'l4 xl5')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(transaction, account, 'l3 xl3 center-align')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionButtons(transaction, 'l2 xl1')}"></t:block>
+                                </div>
+                            </div>
+                            </t:block>
+
+                            <t:block t:if="groupStat.last">
+                                <t:block t:replace="~{transactions/transactionsMacros :: placeholder(transactions)}"></t:block>
+                            </t:block>
+                        </div>
+
+                        <!--/* show placeholder text if no transactions are present in the current month or REST is the only transaction */-->
+                        <t:block t:if="transactions.isEmpty()">
+                            <t:block t:replace="~{transactions/transactionsMacros :: placeholder(transactions)}"></t:block>
+                        </t:block>
+                    </div>
+
+                    <t:block t:unless="transactions.isEmpty()">
+                        <div id="deleteModalContainerOnDemand"></div>
+
+                        <t:block t:replace="~{filter/filterMacros :: filterModal(filterConfiguration)}"></t:block>
+                    </t:block>
+            </div>
+
+            <t:block t:if="transactions.isEmpty()">
+                <div id="deleteModalContainerOnDemand"></div>
+
+                <t:block t:replace="~{filter/filterMacros :: filterModal(filterConfiguration)}"></t:block>
+            </t:block>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/globalDatePicker.js}"></script>
+        <script t:src="@{/js/filter.js}"></script>
+        <script>
+            var currentDateString = [[${fmt.dateNormal(currentDate)}]];
+            document.cookie = "currentDate=" + currentDateString;
+        </script>
+    </body>
+</html>
