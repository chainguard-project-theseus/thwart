+                                    <span class="columnName-checkbox-label text-default" t:text="locale.getString('report.checkbox.inclue.categorybudgets')"></span>
+                                </label>
+                            </div>
+                        </div>
+                    </div>
+                    <br>
+
+                    <div class="row no-margin">
