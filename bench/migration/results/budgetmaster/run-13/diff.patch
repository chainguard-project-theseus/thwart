+                                <t:block t:replace="~{indexFunctions :: action('/charts', 'home.menu.charts.action.show')}"></t:block>
+                            </charts-actions>
+                        </t:block>
+                        <t:block t:replace="~{indexFunctions :: homeEntry('/reports', helpers.entityType('REPORT').getIcon(), helpers.entityType('REPORT').getColorAsTextColor(), 'menu.reports', 'home.menu.reports', ~{::reports-actions})}">
+                            <reports-actions t:remove="tag">
+                                <t:block t:replace="~{indexFunctions :: action('/reports', 'home.menu.reports.action.new')}"></t:block>
+                            </reports-actions>
+                        </t:block>
+                        <t:block t:replace="~{indexFunctions :: homeEntry('/categories', helpers.entityType('CATEGORY').getIcon(), helpers.entityType('CATEGORY').getColorAsTextColor(), 'menu.categories', 'home.menu.categories', ~{::categories-actions})}">
