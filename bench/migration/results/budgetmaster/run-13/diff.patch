+	/**
+	 * Serves a chart's script. The FreeMarker view printed it into an inline script with the transaction data
+	 * and the container id spliced in; a Tessera template can't write code into a script, so the page
+	 * declares {@code chartTransactionData} and loads the script from here.
+	 */
+	@GetMapping(value = "/{ID}/script/{containerID}.js", produces = "text/javascript")
+	@ResponseBody
+	public String chartScript(@PathVariable("ID") Integer ID, @PathVariable("containerID") String containerID)
+	{
+		final Optional<Chart> chartOptional = chartService.getRepository().findById(ID);
+		if(chartOptional.isEmpty())
+		{
+			throw new ResourceNotFoundException();
+		}
+
+		final String validContainerID = UUID.fromString(containerID).toString();
+		return chartOptional.get().getScript()
+				.replace("var transactionData = [];", "var transactionData = chartTransactionData;")
+				.replace("containerID", validContainerID);
+	}
+
