+
+/**
+ * Functions for the new/edit transaction pages (transactions/newTransactionMacros.html).
+ */
+@TemplateFunctions("newtx")
+public final class NewTxFunctions
+{
+	private NewTxFunctions()
+	{
+	}
+
+	/**
+	 * Localization key of the end option of the given repeating option ("repeating.end.key.never", ...), or null.
+	 */
+	@TemplateFunction
+	public static String endKey(RepeatingOption repeatingOption)
+	{
+		if(repeatingOption == null || repeatingOption.getEndOption() == null)
+		{
+			return null;
+		}
+		return repeatingOption.getEndOption().getLocalizationKey();
+	}
+
+	/**
+	 * The end option's value as text (number of times), or "" if there is none.
+	 */
+	@TemplateFunction
+	public static String endValue(RepeatingOption repeatingOption)
+	{
+		if(repeatingOption == null || repeatingOption.getEndOption() == null || repeatingOption.getEndOption().getValue() == null)
+		{
+			return "";
+		}
+		return String.valueOf(repeatingOption.getEndOption().getValue());
+	}
+
+	/**
+	 * The end date of the repeating option as long date string if it ends at a date, else the given fallback date.
+	 */
+	@TemplateFunction
+	public static String endDate(RepeatingOption repeatingOption, LocalDate fallback)
+	{
+		if(repeatingOption != null && repeatingOption.getEndOption() != null && repeatingOption.getEndOption().getValue() instanceof LocalDate date)
+		{
+			return TemplateBeans.dates().getLongDateString(date);
+		}
+		return TemplateBeans.dates().getLongDateString(fallback);
+	}
+
+	/**
+	 * Tags as chips data for materialize: [{tag: name}, ...].
+	 */
+	@TemplateFunction
+	public static List<Map<String, String>> chipsData(List<Tag> tags)
+	{
+		final List<Map<String, String>> result = new ArrayList<>();
+		if(tags != null)
+		{
+			for(Tag tag : tags)
+			{
+				result.add(Map.of("tag", tag.getName()));
+			}
+		}
+		return result;
+	}
+
+	/**
+	 * Tag names as autocomplete data for materialize: {name: null, ...}.
+	 */
+	@TemplateFunction
+	public static Map<String, String> autocompleteData(List<Tag> tags)
+	{
+		final Map<String, String> result = new LinkedHashMap<>();
+		if(tags != null)
+		{
+			for(Tag tag : tags)
+			{
+				result.put(tag.getName(), null);
+			}
+		}
+		return result;
+	}
+
+	/**
+	 * The first {@code length} characters of each string (FreeMarker's name[0..length-1]).
+	 */
+	@TemplateFunction
+	public static List<String> prefixes(List<String> values, int length)
+	{
+		final List<String> result = new ArrayList<>();
+		if(values != null)
+		{
+			for(String value : values)
+			{
+				result.add(value.substring(0, Math.min(length, value.length())));
+			}
+		}
+		return result;
+	}
+}
