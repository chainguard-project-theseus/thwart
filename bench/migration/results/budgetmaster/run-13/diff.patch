+                        <t:block t:replace="~{indexFunctions :: homeEntry('/transactions', helpers.entityType('TRANSACTION').getIcon(), helpers.entityType('TRANSACTION').getColorAsTextColor(), 'menu.transactions', 'home.menu.transactions', ~{::transactions-actions})}">
+                            <transactions-actions t:remove="tag">
+                                <t:block t:replace="~{indexFunctions :: action('/transactions', 'home.menu.transactions.action.manage')}"></t:block>
+                                <t:block t:replace="~{indexFunctions :: action('/transactions/newTransaction/normal', 'home.menu.transactions.action.new')}"></t:block>
+                                <t:block t:replace="~{indexFunctions :: action('/transactionImport', 'home.menu.transactions.action.csvImport')}"></t:block>
+                            </transactions-actions>
+                        </t:block>
+                        <t:block t:replace="~{indexFunctions :: homeEntry('/templates', helpers.entityType('TEMPLATE').getIcon(), helpers.entityType('TEMPLATE').getColorAsTextColor(), 'menu.transactions.templates', 'home.menu.templates', ~{::templates-actions})}">
+                            <templates-actions t:remove="tag">
+                                <t:block t:replace="~{indexFunctions :: action('/templates', 'home.menu.templates.action.manage')}"></t:block>
+                            </templates-actions>
+                        </t:block>
+                        <t:block t:replace="~{indexFunctions :: homeEntry('/charts', helpers.entityType('CHART').getIcon(), helpers.entityType('CHART').getColorAsTextColor(), 'menu.charts', 'home.menu.charts', ~{::charts-actions})}">
