diff --git a/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html b/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html
new file mode 100644
index 00000000..49d384c6
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html
@@ -0,0 +1,72 @@
+<t:block xmlns:t="https://tessera.dev">
+
+<!--/* chartFunctions.getChartName(chart) is misc.chartName(chart) */-->
+
+<!--/* infoMessage with plain text */-->
+<div t:fragment="infoMessage(String text)" class="row no-margin-bottom">
+    <div class="col s12 center-align">
+        <table class="text-default login-message no-border-table">
+            <tbody>
+                <tr>
+                    <td><i class="material-icons">info</i></td>
+                    <td t:text="text"></td>
+                </tr>
+            </tbody>
+        </table>
+    </div>
+</div>
+
+<!--/* infoMessage with markup (e.g. misc.linkMessage('chart.new.info.wiki')) */-->
+<div t:fragment="infoMessageHtml(SafeHtml text)" class="row no-margin-bottom">
+    <div class="col s12 center-align">
+        <table class="text-default login-message no-border-table">
+            <tbody>
+                <tr>
+                    <td><i class="material-icons">info</i></td>
+                    <td t:utext="text"></td>
+                </tr>
+            </tbody>
+        </table>
+    </div>
+</div>
+
+<t:block t:fragment="buttonNew">
+    <t:block t:replace="~{helpers/header :: buttonLink('/charts/newChart', 'add', 'title.chart.new', '', 'background-blue', '')}"></t:block>
+</t:block>
+
+<t:block t:fragment="buttonShow">
+    <t:block t:replace="~{helpers/header :: buttonLink('/charts', 'show_chart', 'home.menu.charts.action.show', '', 'background-blue', '')}"></t:block>
+</t:block>
+
+<t:block t:fragment="buttons">
+    <div class="row hide-on-small-only valign-wrapper">
+        <div class="col s6 right-align">
+            <t:block t:replace="~{::buttonNew}"></t:block>
+        </div>
+        <div class="col s6 left-align">
+            <t:block t:replace="~{::buttonShow}"></t:block>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up center-align">
+        <div class="row center-align">
+            <div class="row center-align">
+                <div class="col s12">
+                    <t:block t:replace="~{::buttonShow}"></t:block>
+                </div>
+            </div>
+            <div class="col s12">
+                <t:block t:replace="~{::buttonNew}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!--/* iconForItem item: pass misc.hasFontAwesomeIcon(item), item.getIcon(), item.getLocalizationKey()
+       (misc.hasFontAwesomeIcon(item) for ChartDisplayType and ChartGroupType) */-->
+<t:block t:fragment="iconForItem(boolean fontAwesome, String icon, String localizationKey)">
+    <t:block t:if="fontAwesome"><i t:class="|${icon} left|"></i> [[${locale.getString(localizationKey)}]]</t:block>
+    <t:block t:unless="fontAwesome"><i class="material-icons left" t:text="icon"></i> [[${locale.getString(localizationKey)}]]</t:block>
+</t:block>
+
+</t:block>
