+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.transactions.Transaction;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeInlineHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Template functions for the transactions, search, filter and global date picker templates
+ * (logic the FreeMarker templates did with assign/list/unbalanced markup).
+ */
+@TemplateFunctions("tx")
+public final class TxFunctions
+{
+	private static final HtmlPolicy BR_POLICY = HtmlPolicy.inlineBuilder().allowElements("br").build();
+	private static final SafeInlineHtml BR = SafeInlineHtml.sanitize("<br>", BR_POLICY);
+	private static final String ARG_MARKER = "\u0000ARG\u0000";
+
+	private TxFunctions()
+	{
+	}
+
+	/**
+	 * A localized message whose text contains literal &lt;br&gt; line breaks (printed raw by the old
+	 * template). Everything except the &lt;br&gt;s, including the argument, is escaped.
+	 */
+	@TemplateFunction
+	public static SafeInlineHtml messageWithBreaks(String key, Object arg)
+	{
+		final String message = Localization.getString(key, ARG_MARKER);
+		final String argText = String.valueOf(arg);
+		final String[] lines = message.split("<br>", -1);
+		final List<SafeInlineHtml> parts = new ArrayList<>();
+		for(int i = 0; i < lines.length; i++)
+		{
+			if(i > 0)
+			{
+				parts.add(BR);
+			}
+			final String[] pieces = lines[i].split(ARG_MARKER, -1);
+			for(int j = 0; j < pieces.length; j++)
+			{
+				if(j > 0)
+				{
+					parts.add(SafeInlineHtml.escape(argText));
+				}
+				parts.add(SafeInlineHtml.escape(pieces[j]));
+			}
+		}
+		return SafeInlineHtml.concat(parts.toArray(new SafeInlineHtml[0]));
+	}
+
+	/**
+	 * Transactions of one date heading of the transactions list ("transaction-date-group").
+	 */
+	public record DateGroup(String date, List<Transaction> transactions)
+	{
+	}
+
+	/**
+	 * Groups consecutive transactions with the same (upper-cased, month name) date string,
+	 * as the old template did with its "lastDate" variable.
+	 */
+	@TemplateFunction
+	public static List<DateGroup> groupByDate(List<Transaction> transactions)
+	{
+		final List<DateGroup> groups = new ArrayList<>();
+		if(transactions == null)
+		{
+			return groups;
+		}
+
+		String lastDate = null;
+		List<Transaction> current = null;
+		for(Transaction transaction : transactions)
+		{
+			final String date = TemplateBeans.dates().getDateStringWithMonthName(transaction.getDate()).toUpperCase();
+			if(current == null || !Objects.equals(date, lastDate))
+			{
+				current = new ArrayList<>();
+				groups.add(new DateGroup(date, current));
+				lastDate = date;
+			}
+			current.add(transaction);
+		}
+		return groups;
+	}
+
+	/**
+	 * count consecutive years starting at start, as strings (FreeMarker ?c)
+	 */
+	@TemplateFunction
+	public static List<String> yearRange(int start, int count)
+	{
+		final List<String> years = new ArrayList<>();
+		for(int i = 0; i < count; i++)
+		{
+			years.add(String.valueOf(start + i));
+		}
+		return years;
+	}
+
+	/**
+	 * Splits items into rows of perRow items.
+	 */
+	@TemplateFunction
+	public static List<List<String>> rows(List<String> items, int perRow)
+	{
+		final List<List<String>> rows = new ArrayList<>();
+		if(items == null)
+		{
+			return rows;
+		}
+		for(int i = 0; i < items.size(); i += perRow)
+		{
+			rows.add(new ArrayList<>(items.subList(i, Math.min(i + perRow, items.size()))));
+		}
+		return rows;
+	}
+
+	/**
+	 * The first length characters of every item (FreeMarker item[0..length-1]).
+	 */
+	@TemplateFunction
+	public static List<String> prefixes(List<String> items, int length)
+	{
+		final List<String> result = new ArrayList<>();
+		if(items == null)
+		{
+			return result;
+		}
+		for(String item : items)
+		{
+			result.add(item.substring(0, Math.min(length, item.length())));
+		}
+		return result;
+	}
+
+	/**
+	 * true if the list consists only of the two REST (balance) transactions
+	 */
+	@TemplateFunction
+	public static boolean isOnlyRest(List<Transaction> transactions)
+	{
+		return transactions != null && transactions.size() == 2
+				&& transactions.get(0).getCategory().getType().name().equals("REST")
+				&& transactions.get(1).getCategory().getType().name().equals("REST");
+	}
+}
