diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/iconSelect.html b/BudgetMasterServer/src/main/resources/templates/helpers/iconSelect.html
new file mode 100644
index 00000000..f51f9029
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/iconSelect.html
@@ -0,0 +1,148 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.icon.Icon">
+
+<!--/* iconSelect.iconSelect: generic over the entity; pass its icon reference, name, background color and font color
+       (acc.fontColor(item, dark)). color is only used if showBackground. */-->
+<div t:fragment="iconSelect(String id, Icon icon, String name, String color, String fontColor, boolean showBackground, String initialBackgroundClasses, String backgroundClasses, boolean preventFallbackIcon)" class="row"
+     t:with="hasImageIcon=${icon != null && icon.isImageIcon()}, hasBuiltinIcon=${icon != null && icon.isBuiltinIcon()}, settings=${helpers.getSettings()}">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <i class="fas fa-icons prefix"></i>
+        <label class="input-label" t:for="id" t:text="locale.getString('account.new.label.icon')"></label>
+
+        <div t:id="id" class="valign-wrapper item-icon">
+            <div class="item-icon-preview-container">
+                <a id="item-icon-preview" t:style="fontColor != null ? |color: ${css.color(fontColor)}| : 'color: '">
+                    <script>
+                        var iconSelectAdditionalBackgroundClasses = [[${backgroundClasses}]];
+                    </script>
+                    <div id="item-icon-preview-background" t:class="|category-circle category-circle-preview ${settings.getShowCategoriesAsCircles() != null && settings.getShowCategoriesAsCircles() == false ? 'category-square' : ''} ${initialBackgroundClasses}|" t:style="showBackground ? |background-color: ${css.color(color)}| : 'background-color: '">
+                        <i id="builtin-icon-preview-icon" t:class="hasBuiltinIcon ? icon.getBuiltinIdentifier() : 'hidden'"></i>
+                        <img id="item-icon-preview-icon" t:src="hasImageIcon ? @{/media/getImageByIconID/{id}(id=icon.getID())} : ''" t:class="| item-icon-preview category-icon ${hasImageIcon == false ? 'hidden' : ''}|"/>
+                        <span t:unless="preventFallbackIcon" id="item-icon-fallback-name" t:class="hasBuiltinIcon || hasImageIcon ? 'hidden' : ''" t:text="helpers.initial(name)"></span>
+                    </div>
+                </a>
+                <a    id="" class="waves-effect waves-light btn-flat no-padding text-default button-remove-icon-from-item">
+                    <i class="material-icons left no-margin ">delete</i>
+                </a>
+            </div>
+
+            <div id="item-icon-placeholder" t:text="locale.getString('account.new.icon.placeholder')"></div>
+
+            <input id="hidden-input-icon-image-id" type="hidden" name="iconImageID" t:value="hasImageIcon ? '' + icon.getImage().getID() : ''">
+            <input id="hidden-input-icon-builtin-identifier" type="hidden" name="builtinIconIdentifier" t:value="hasBuiltinIcon ? icon.getBuiltinIdentifier() : ''">
+        </div>
+    </div>
+</div>
+
+<!--/* iconSelect.modalIconSelect: the element id to focus on close was data-focus-on-close; it is a string,
+       so it is now the script variable iconSelectFocusOnClose read by iconSelect.js */-->
+<div t:fragment="modalIconSelect(String idToFocusOnClose, Icon icon, List<String> fontawesomeIcons)" id="modalIconSelect" class="modal modal-fixed-footer background-color"
+     t:with="hasImageIcon=${icon != null && icon.isImageIcon()}">
+    <script>
+        var iconSelectFocusOnClose = [[${idToFocusOnClose}]];
+    </script>
+    <div class="modal-content center-align">
+        <div class="row">
+            <div class="col s12">
+                <ul class="tabs" id="iconTabs">
+                    <li class="tab col s6"><a t:class="|text-blue valign-wrapper ${hasImageIcon == false ? 'active' : ''}|" href="#tabBuiltinIcons" data-name="builtinIcons"><i class="fas fa-icons"></i> [[${locale.getString('icons.builtin')}]]</a></li>
+                    <li class="tab col s6"><a t:class="|text-blue valign-wrapper ${hasImageIcon ? 'active' : ''}|" href="#tabImages" data-name="images"><i class="fas fa-image"></i> [[${locale.getString('icons.images')}]]</a></li>
+                </ul>
+            </div>
+            <div id="tabBuiltinIcons" class="col s12"><t:block t:replace="~{::tabBuiltinIcons(icon, fontawesomeIcons)}"></t:block></div>
+            <div id="tabImages" class="col s12"><t:block t:replace="~{::tabImages(icon)}"></t:block></div>
+        </div>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{helpers/header :: buttonLinkNoUrl('clear', 'cancel', '', 'red', 'modal-action modal-close text-white')}"></t:block>
+        <a    id="button-icon-confirm" class="waves-effect waves-light btn green modal-action modal-close text-white" disabled>
+            <i class="material-icons left ">done</i>[[${locale.getString('ok')}]]
+        </a>
+    </div>
+</div>
+
+<t:block t:fragment="tabImages(Icon icon)" t:with="hasImageIcon=${icon != null && icon.isImageIcon()}">
+    <div class="row">
+        <div class="col s12">
+            <div class="headline" t:text="locale.getString('upload.image.headline')"></div>
+        </div>
+    </div>
+
+    <div class="row">
+        <t:block t:replace="~{::uploadImageForm}"></t:block>
+    </div>
+
+    <hr>
+
+    <div class="row">
+        <div class="col s12">
+            <div class="headline" t:text="locale.getString('available.images')"></div>
+        </div>
+    </div>
+
+    <t:block t:replace="~{::progressIndicator}"></t:block>
+
+    <div t:if="hasImageIcon" class="row" id="available-images" t:data-url="@{/media/getAvailableImages/{id}(id=icon.getImage().getID())}">
+    </div>
+    <div t:unless="hasImageIcon" class="row" id="available-images" t:data-url="@{/media/getAvailableImages}">
+    </div>
+</t:block>
+
+<t:block t:fragment="tabBuiltinIcons(Icon icon, List<String> fontawesomeIcons)" t:with="selectedIconName=${icon != null && icon.isBuiltinIcon() ? icon.getBuiltinIdentifier() : ''}">
+    <div class="row no-margin-bottom">
+        <div class="input-field col s12 m12 l8 offset-l2">
+            <i class="material-icons prefix">search</i>
+            <input id="searchIcons" type="text">
+            <label for="searchIcons" t:text="locale.getString('search')"></label>
+        </div>
+    </div>
+    <div class="row">
+        <div class="col s12 center-align" id="numberOfIcons"><span id="numberOfMatchingIcons" t:text="fontawesomeIcons.size()"></span>/[[${fontawesomeIcons.size()}]] [[${locale.getString('icons.numberOf')}]]</div>
+    </div>
+
+    <hr>
+
+    <div class="row">
+        <div t:each="icon : fontawesomeIcons" class="col s4 m2 l2 builtin-icon-option-column">
+            <div t:class="|builtin-icon-option ${selectedIconName == icon ? 'selected' : ''}|">
+                <i t:class="|builtin-icon-option-icon ${icon}|"></i>
+                <div class="builtin-icon-option-name truncate" t:text="icon"></div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="uploadImageForm">
+    <form id="form-upload-image" method="post" t:action="@{/media/uploadImage}" enctype="multipart/form-data">
+        <div class="file-field input-field col s12">
+            <div class="container">
+                <div class="btn background-blue">
+                    <i class="material-icons left">folder</i>
+                    [[${locale.getString('account.new.icon.upload.choose.file')}]]
+                    <input id="inputUploadFile" type="file" t:accept="helpers.getValidImageUploadTypes()" name="file">
+                </div>
+                <div class="file-path-wrapper">
+                    <input class="file-path validate" type="text">
+                </div>
+                <t:block t:replace="~{helpers/header :: buttonLinkNoUrl('upload', 'account.new.icon.upload', 'button-upload-new-image', 'background-blue', 'right')}"></t:block>
+            </div>
+        </div>
+    </form>
+
+    <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.icon.upload.image.size'), 'fas fa-info', '')}"></t:block>
+</t:block>
+
+<div t:fragment="progressIndicator" class="preloader-wrapper active margin" id="progressIndicator">
+    <div class="spinner-layer spinner-blue-only">
+        <div class="circle-clipper left">
+            <div class="circle"></div>
+        </div>
+        <div class="gap-patch">
+            <div class="circle"></div>
+        </div>
+        <div class="circle-clipper right">
+            <div class="circle"></div>
+        </div>
+    </div>
+</div>
+
+</t:block>
