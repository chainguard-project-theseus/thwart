+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.reports.settings.ReportSettings, de.deadlocker8.budgetmaster.filter.FilterConfiguration"
