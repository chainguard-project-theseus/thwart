+package de.deadlocker8.budgetmaster.templating;
+
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.Map;
+
+/**
+ * Replaces helpers/validation.ftl, which wrote
+ * {@code class="tooltipped invalid ..." data-position="bottom" data-delay="50" data-tooltip="..."} for an
+ * invalid field and {@code class="validate ..."} otherwise.
+ */
+@TemplateFunctions("validation")
+public final class ValidationFunctions
+{
+	private ValidationFunctions()
+	{
+	}
+
+	@TemplateFunction
+	public static boolean has(Map<String, String> errors, String fieldName)
+	{
+		return errors != null && errors.containsKey(fieldName);
+	}
+
+	@TemplateFunction
+	public static String cls(Map<String, String> errors, String fieldName, String classes)
+	{
+		final String extra = classes == null ? "" : classes;
+		return has(errors, fieldName) ? "tooltipped invalid " + extra : "validate " + extra;
+	}
+
+	@TemplateFunction
+	public static String tooltip(Map<String, String> errors, String fieldName)
+	{
+		return has(errors, fieldName) ? Localization.getString(errors.get(fieldName)) : null;
+	}
+}
