+                                            </t:block>
+                                            <t:block t:if="account.getAccountState() != 'READ_ONLY' && account.getAccountState() != 'HIDDEN'">
+                                                <a t:href="@{/accounts/{id}/setAsDefault(id=account.getID())}" class="btn-flat no-padding text-default tooltipped" data-position="left" t:title="locale.getString('account.tooltip.default')"><i class="material-icons left" t:text="account.isDefault() ? 'star' : 'star_border'"></i></a>
+                                                <i class="fas fa-edit placeholder-icon-right"></i>
+                                            </t:block>
+                                        </td>
+                                        <td>
+                                            <t:block t:if="account.getEndDate() != null">
+                                                <i class="fas fa-bell placeholder-icon-right"></i> [[${fmt.dateNormal(account.getEndDate())}]]
+                                            </t:block>
+                                            <div t:if="account.getEndDate() == null" class="placeholder-icon"></div>
+                                        </td>
+                                        <td t:text="account.getName()"></td>
+                                        <td>
+                                            <div class="truncate account-description" t:text="account.getDescription()">
+                                            </div>
+                                        </td>
+                                        <td>
+                                            <a t:href="@{/accounts/{id}/edit(id=account.getID())}" class="btn-flat no-padding text-default"><i class="material-icons left">edit</i></a>
+                                            <a    id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-account" t:data-url="@{/accounts/{id}/requestDelete(id=account.getID())}">
+                                                <i class="material-icons left no-margin ">delete</i>
+                                            </a>
+                                        </td>
+                                    </tr>
+                                </t:block>
+                                </tbody>
+                            </table>
+                        </form>
+                        <div t:if="accounts.isEmpty()" class="headline center-align" t:text="locale.getString('placeholder')"></div>
+                    </div>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+
+        <t:block t:if="accountNotDeletable != null">
+            <!-- warning account not deletable -->
+            <div id="modalAccountNotDeletable" class="modal background-color">
+                <div class="modal-content">
+                    <h4 t:text="locale.getString('info.title.account.delete')"></h4>
+                    <p t:text="locale.getString('warning.text.account.delete', currentAccount.getName())"></p>
+                </div>
+                <div class="modal-footer background-color">
+                    <t:block t:replace="~{helpers/header :: buttonLink('/accounts', 'done', 'ok', 'buttonCloseWhatsNew', 'green', 'modal-action modal-close text-white')}"></t:block>
+                </div>
+            </div>
+        </t:block>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/accounts.js}"></script>
+    </body>
+</html>
diff --git a/BudgetMasterServer/src/main/resources/templates/accounts/accountsFunctions.html b/BudgetMasterServer/src/main/resources/templates/accounts/accountsFunctions.html
