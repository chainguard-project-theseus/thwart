@@ -0,0 +1,114 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.hints.Hint, de.deadlocker8.budgetmaster.icon.Icon, de.deadlocker8.budgetmaster.utils.notification.Notification">
+
+<!--/* <head> content shared by all pages (FreeMarker: header.globals + header.header) */-->
+<t:block t:fragment="header(String title)">
+    <title t:text="title">BudgetMaster</title>
+    <meta charset="UTF-8"/>
+    <link rel="stylesheet" t:href="@{/webjars/font-awesome/css/all.min.css}">
+    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
+    <link rel="stylesheet" t:href="@{/webjars/materializecss/css/materialize.min.css}">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/colors.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/style.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/navbar.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/categories.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/accounts.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/customSelect.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/hotkeys.css}"/>
+
+    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
+
+    <link rel="apple-touch-icon" t:href="@{/touch_icon.png}">
+</t:block>
+
+<t:block t:fragment="style(String name)"><link type="text/css" rel="stylesheet" t:href="@{/css/{name}.css(name=name)}"/></t:block>
+
+<t:block t:fragment="logo(String id, String classes)">
+    <img t:if="helpers.getSettings().isUseDarkTheme()" t:class="classes" t:id="id" t:src="@{/images/Logo_with_white_text_medium_res.png}">
+    <img t:unless="helpers.getSettings().isUseDarkTheme()" t:class="classes" t:id="id" t:src="@{/images/Logo_with_text_medium_res.png}">
+</t:block>
+
+<!--/* header.content: notifications before the page content */-->
+<t:block t:fragment="notifications(List<Notification> notifications)">
+    <t:block t:if="notifications != null">
+        <div t:each="notification, stat : notifications" class="row notification-row" t:id="|notification-${stat.index}|">
+            <div class="col s12 center-align">
+                <div class="notification-wrapper">
+                    <div t:class="|notification ${notification.getBackgroundColor()} ${notification.getTextColor()}|">
+                        <i t:if="notification.getIcon() != null" t:class="|${notification.getIcon()} notification-item|"></i>
+                        <span class="notification-item" t:utext="notice.message(notification.getMessage())"></span>
+                        <a t:class="|notification-item notification-clear ${notification.getTextColor()}|" t:data-id="stat.index">
+                            <i class="material-icons">clear</i>
+                        </a>
+                    </div>
+                </div>
+            </div>
+        </div>
+    </t:block>
+</t:block>
+
+<t:block t:fragment="hint(Hint hint, String icon, String actionUrl)">
+    <div t:unless="hint.isDismissed()" class="row" t:id="|hint-${hint.getID()}|">
+        <div class="col s12 center-align">
+            <div class="notification-wrapper">
+                <div class="notification notification-border text-default">
+                    <i t:class="|${icon} notification-item|"></i>
+                    <a t:if="!strings.isEmpty(actionUrl)" t:href="actionUrl" class="text-default">
+                        <span class="notification-item left-align" t:text="locale.getString(hint.getLocalizationKey())"></span>
+                    </a>
+                    <span t:if="strings.isEmpty(actionUrl)" class="notification-item left-align" t:text="locale.getString(hint.getLocalizationKey())"></span>
+                    <a class="notification-item hint-clear text-default" t:data-url="@{/hints/dismiss/{id}(id=hint.getID())}" t:data-id="hint.getID()">
+                        <i class="material-icons">clear</i>
+                    </a>
+                </div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="buttonLink(String url, String icon, String localizationKey, String id, String color, String classes)">
+    <a t:href="url" t:id="id" t:class="|waves-effect waves-light btn ${color} ${classes}|">
+        <i t:class="strings.isEmpty(localizationKey) ? 'material-icons left no-margin' : 'material-icons left '" t:text="icon">icon</i><t:block t:unless="strings.isEmpty(localizationKey)" t:text="locale.getString(localizationKey)"></t:block>
+    </a>
+</t:block>
+
+<t:block t:fragment="buttonLinkNoUrl(String icon, String localizationKey, String id, String color, String classes)">
+    <a t:id="id" t:class="|waves-effect waves-light btn ${color} ${classes}|">
+        <i t:class="strings.isEmpty(localizationKey) ? 'material-icons left no-margin' : 'material-icons left '" t:text="icon">icon</i><t:block t:unless="strings.isEmpty(localizationKey)" t:text="locale.getString(localizationKey)"></t:block>
+    </a>
+</t:block>
+
+<t:block t:fragment="buttonSubmit(String name, String icon, String localizationKey, String id, String color, String classes)">
+    <button t:id="strings.isEmpty(id) ? null : id" t:class="|btn waves-effect waves-light ${color} ${classes}|" type="submit" t:name="name">
+        <i t:class="strings.isEmpty(localizationKey) ? 'material-icons left no-margin' : 'material-icons left '" t:text="icon">icon</i><t:block t:unless="strings.isEmpty(localizationKey)" t:text="locale.getString(localizationKey)"></t:block>
+    </button>
+</t:block>
+
+<t:block t:fragment="buttonFlat(String url, String icon, String localizationKey, String id, String classes, String iconClasses)">
+    <a t:href="url" t:id="id" t:class="|waves-effect waves-light btn-flat ${classes}|">
+        <i t:class="|material-icons left ${strings.isEmpty(localizationKey) ? 'no-margin' : ''} ${iconClasses}|" t:text="icon">icon</i><span t:unless="strings.isEmpty(localizationKey)" t:text="locale.getString(localizationKey)"></span>
+    </a>
+</t:block>
+
+<t:block t:fragment="entityIcon(Icon icon, String classes, String fallbackName)">
+    <t:block t:if="icon != null">
+        <img t:if="icon.isImageIcon()" t:src="@{/media/getImageByIconID/{id}(id=icon.getID())}" t:class="classes"/>
+        <i t:if="!icon.isImageIcon() && icon.isBuiltinIcon()" t:class="|${icon.getBuiltinIdentifier()} ${classes}|"></i>
+        <t:block t:if="!icon.isImageIcon() && !icon.isBuiltinIcon()" t:text="helpers.initial(fallbackName)"></t:block>
+    </t:block>
+    <t:block t:if="icon == null" t:text="helpers.initial(fallbackName)"></t:block>
+</t:block>
+
+<!--/* header.modalConfirmDelete: deleteUrl is confirmUrl + '/' + itemId + '/delete' */-->
+<div t:fragment="modalConfirmDelete(String title, String deleteUrl, String confirmButtonTextKey, String id, String classes, Fragment content)" t:id="id" t:class="|modal background-color ${classes}|">
+    <div class="modal-content">
+        <h4 t:text="title">title</h4>
+
+        <t:block t:replace="content"></t:block>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{::buttonLinkNoUrl('clear', 'cancel', '', 'red', 'modal-action modal-close text-white')}"></t:block>
+        <t:block t:replace="~{::buttonLink(deleteUrl, 'delete', confirmButtonTextKey, '', 'green', 'modal-action modal-close text-white')}"></t:block>
+    </div>
+</div>
+
+</t:block>
