+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.services.ImportResultItem"
+      t:params="Settings settings, List<ImportResultItem> importResultItems, List<String> errorMessages">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('settings.database.import'))}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('collapsible')}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark' : null">
+        <t:block t:replace="~{helpers/navbar :: navbar('settings', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="locale.getString('info.title.database.import.dialog')"></div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline-small" t:text="locale.getString('info.database.import.result')"></div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="row">
+                        <div class="col s10 offset-s1 m8 offset-m2 l6 offset-l3">
+                            <table class="bordered">
+                                <tbody>
+                                <tr t:each="item : importResultItems">
+                                    <td><i class="material-icons left" t:text="item.getEntityType().getIcon()"></i>
+                                        <div class="import-entity-name" t:text="locale.getString(item.getEntityType().getLocalizationKey())"></div>
+                                    </td>
+                                    <td><i t:if="item.getNumberOfImportedItems() != item.getNumberOfAvailableItems()" class="fas fa-exclamation-triangle text-red"></i></td>
+                                    <td t:text="|${item.getNumberOfImportedItems()}/${item.getNumberOfAvailableItems()}|"></td>
+                                </tr>
+                                </tbody>
+                            </table>
+                        </div>
+                    </div>
+                </div>
+
+                <div t:if="errorMessages != null && !errorMessages.isEmpty()" class="container">
+                    <div class="row">
+                        <div class="col s12">
+                            <ul class="collapsible">
+                                <li>
+                                    <div class="collapsible-header bold">
+                                        <i class="fas fa-exclamation-triangle text-red"></i>
+                                        <t:block t:text="locale.getString('info.database.import.result.errors')"></t:block>
+                                    </div>
+                                    <div class="collapsible-body">
+                                        <table class="bordered">
+                                            <tbody>
+                                            <tr t:each="error : errorMessages">
+                                                <td><i class="fas fa-exclamation-triangle text-red"></i></td>
+                                                <td t:text="error"></td>
+                                            </tr>
+                                            </tbody>
+                                        </table>
+                                    </div>
+                                </li>
+                            </ul>
+                        </div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="row">
+                        <div class="col s12 center-align">
+                            <t:block t:replace="~{helpers/header :: buttonLink('/settings', 'done', 'ok', 'button-finish-import', 'background-blue', '')}"></t:block>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </main>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/import.js}"></script>
