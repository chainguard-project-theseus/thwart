diff --git a/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html b/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html
new file mode 100644
index 00000000..2b128e8d
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html
@@ -0,0 +1,119 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState"
+      t:params="Settings settings, List<Notification> notifications, Account account, AccountState[] availableAccountStates, List<String> fontawesomeIcons, LocalDate today, Map<String, String> validationErrors, List<String> localizedMonthNames, List<String> localizedWeekdays"
+      t:with="title=${account.getID() != null ? locale.getString('title.account.edit') : locale.getString('title.account.new')}">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('iconSelect')}"></t:block>
+        <t:block t:replace="~{helpers/header :: style('datepicker')}"></t:block>
+    </head>
+    <body class="background-blue-light" t:data-theme="settings.isUseDarkTheme() ? 'dark' : null">
+        <t:block t:replace="~{helpers/navbar :: navbar('accounts', settings)}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="title"></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: notifications(notifications)}"></t:block>
+                    <div class="container">
+                    <form name="NewAccount" t:action="@{/accounts/newAccount}" method="post">
+                        <input type="hidden" name="ID" t:value="account.getID() != null ? '' + account.getID() : ''">
+                        <input type="hidden" name="isSelected" t:value="account.isSelected() != null ? '' + account.isSelected() : ''">
+                        <input type="hidden" name="isDefault" t:value="account.isDefault() != null ? '' + account.isDefault() : ''">
+
+                        <!--/* name */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">edit</i>
+                                <input id="account-name" type="text" name="name" t:class="validation.cls(validationErrors, 'name', '')" t:data-position="validation.has(validationErrors, 'name') ? 'bottom' : null" t:data-delay="validation.has(validationErrors, 'name') ? 50 : null" t:title="validation.tooltip(validationErrors, 'name')" t:value="account.getName() ?: ''">
+                                <label for="account-name" t:text="locale.getString('account.new.label.name')"></label>
+                            </div>
+                        </div>
+
+                        <!--/* description */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">article</i>
+                                <textarea id="account-description" class="materialize-textarea" name="description" data-length="250" t:data-position="validation.has(validationErrors, 'description') ? 'bottom' : null" t:data-delay="validation.has(validationErrors, 'description') ? 50 : null" t:title="validation.tooltip(validationErrors, 'description')" t:text="account.getDescription()"></textarea>
+                                <label class="input-label" for="account-description" t:text="locale.getString('transaction.new.label.description')"></label>
+                            </div>
+                        </div>
+
+                        <!--/* icon */-->
+                        <t:block t:replace="~{helpers/iconSelect :: iconSelect('account-icon', account.getIconReference(), account.getName(), null, acc.fontColor(account, settings.isUseDarkTheme()), false, account.getIconReference() != null && (account.getIconReference().isImageIcon() || account.getIconReference().isBuiltinIcon()) ? 'category-square' : 'category-square account-square-border', 'category-square account-square-border', false)}"></t:block>
+
+                        <!--/* font color */-->
+                        <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(acc.fontColor(account, settings.isUseDarkTheme()), acc.defaultFontColor(account, settings.isUseDarkTheme()))}"></t:block>
+
+                        <!--/* state */-->
+                        <t:block t:replace="~{accounts/accountsFunctions :: customAccountStateSelect('account-state-select-wrapper', 'accountState', acc.accountStates(availableAccountStates), account.getAccountState() != null ? account.getAccountState() : availableAccountStates[0], 'col s12 m12 l8 offset-l2', locale.getString('account.new.label.state'), 'account-state')}"></t:block>
+
+                        <!--/* end date */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">notifications</i>
+                                <input id="account-datepicker" type="text" class="datepicker" name="endDate" t:value="account.getEndDate() != null ? fmt.dateLong(account.getEndDate()) : ''">
+                                <label class="input-label" for="account-datepicker" t:text="locale.getString('account.new.label.endDate')"></label>
+                            </div>
+                        </div>
+
+                        <script>
+                            var startDate = [[${account.getEndDate() != null ? fmt.dateLong(account.getEndDate()) : fmt.dateLong(today)}]];
+                            startDate = startDate.split(".");
+                            startDate = new Date(startDate[2], startDate[1]-1, startDate[0]);
+                        </script>
+
+                        <br>
+
+                        <!--/* buttons */-->
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <t:block t:replace="~{helpers/header :: buttonLink('/accounts', 'clear', 'cancel', 'button-cancel-save-account', 'red', '')}"></t:block>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '')}"></t:block>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonLink('/accounts', 'clear', 'cancel', 'button-cancel-save-account', 'red', '')}"></t:block>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '')}"></t:block>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/iconSelect :: modalIconSelect('account-name', account.getIconReference(), fontawesomeIcons)}"></t:block>
+
+        <!--/* local stand-in for helpers/globalDatePicker :: datePickerLocalization (converted in parallel by another agent) */-->
+        <script>
+            var monthNames = [[${localizedMonthNames}]];
+            var monthNamesShort = [[${acc.prefixes(localizedMonthNames, 3)}]];
+            var weekDays = [[${localizedWeekdays}]];
+            var weekDaysShort = [[${acc.prefixes(localizedWeekdays, 2)}]];
+            var weekDaysLetters = [[${acc.prefixes(localizedWeekdays, 1)}]];
+            var buttonCancel = [[${locale.getString('cancel')}]];
+            var buttonClose = [[${locale.getString('ok')}]];
+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/accounts.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
+
