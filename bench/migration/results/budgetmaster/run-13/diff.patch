+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.settings.Settings" t:params="Settings settings, String toastContent">
+<t:block t:replace="~{::accountsSettingsContainer(true, settings, toastContent)}"></t:block>
+
+<t:block t:fragment="accountsSettingsContainer(boolean importScripts, Settings settings, String toastContent)">
+    <form name="AccountsSettingsContainer" method="post" t:action="@{/settings/save/accounts}">
+        <div class="row">
+            <div class="col s12">
+                <div class="table-container">
+                    <div class="table-cell">
+                        <div class="switch-cell-margin" t:text="locale.getString('settings.accountEndDateReminder')"></div>
+                    </div>
+                    <div class="table-cell table-cell-spacer"></div>
+                    <div class="table-cell">
+                        <t:block t:replace="~{settings/settingsMacros :: switch('accountEndDateReminder', 'accountEndDateReminderActivated', settings.getAccountEndDateReminderActivated())}"></t:block>
+                    </div>
+                    <div class="table-cell table-cell-spacer"></div>
+                    <div class="table-cell">
+                        <div class="switch-cell-margin">
+                            <a class="btn btn-flat tooltipped text-default" data-position="bottom" t:title="locale.getString('settings.accountEndDateReminder.description')"><i class="material-icons">help_outline</i></a>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </div>
+
+        <div class="row">
+            <div class="col s12 center-align">
+                <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'background-green', '')}"></t:block>
+            </div>
+        </div>
+
+        <script>
+            function validateAccountsForm()
+            {
+                return true;
+            }
+
+            $('form[name="AccountsSettingsContainer"] button[name="action"]').click(function()
+            {
+                return validateAccountsForm();
+            });
+
+            // toggle unsaved changes warning
+
+            $('input[name="accountEndDateReminderActivated"]').change(function()
+            {
+                toggleSettingsContainerHeader('accountsSettingsContainerHeader', false);
+            });
+        </script>
+    </form>
+
+    <t:block t:replace="~{settings/settingsMacros :: toastContent(toastContent)}"></t:block>
+
+    <t:block t:if="importScripts">
+        <t:block t:replace="~{settings/settingsMacros :: containerLibraries}"></t:block>
+        <script>
+            initSettingsContainer('AccountsSettingsContainer', 'accountsSettingsContainer');
+        </script>
+    </t:block>
+</t:block>
+</t:block>
