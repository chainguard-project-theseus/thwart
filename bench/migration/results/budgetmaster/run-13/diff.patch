+                            <br>
+                            <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.report.columns'), 'fas fa-info', '')}"></t:block>
+                        </div>
+                    </div>
+                    <div class="row">
+                        <div class="col s12 m8 offset-m2">
+                            <div id="columnNames">
+                                <div t:each="column, stat : reportSettings.getColumnsSorted()" class="columnName">
+                                    <label>
+                                        <input type="checkbox" class="columnName-checkbox" t:data-index="stat.index" t:name="|columns['${stat.index}'].activated|" t:checked="column.isActivated()"/>
