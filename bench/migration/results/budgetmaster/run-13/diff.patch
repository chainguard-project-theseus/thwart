+                                            <li t:text="locale.getString('home.first.use.step.3.sub.3')"></li>
+                                            <li t:text="locale.getString('home.first.use.step.3.sub.4')"></li>
+                                            <li t:text="locale.getString('home.first.use.step.3.sub.5')"></li>
+                                            <li t:text="locale.getString('home.first.use.step.3.sub.6')"></li>
