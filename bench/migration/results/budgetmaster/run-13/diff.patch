+- buttonReset, buttonApply, buttonResetChart, buttonClose, buttonCloseModal, buttonsAllOrNone
+- filterModal(FilterConfiguration filterConfiguration): modal #modalFilter with form posting to /filter/apply
+- filterModalContent(FilterConfiguration filterConfiguration, String prefix): the filter sections;
+    prefix '' for none, else every input name is prefixed with prefix + '.' (e.g. 'filterConfiguration')
+*/-->
+
+<t:block t:fragment="buttons">
+    <div class="row hide-on-small-only no-margin-bottom">
+        <div class="col s12 right-align">
+            <t:block t:replace="~{::buttonCloseModal}"></t:block>
+            <t:block t:replace="~{::buttonReset}"></t:block>
+            <t:block t:replace="~{::buttonApply}"></t:block>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up valign-wrapper no-margin-bottom">
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonCloseModal}"></t:block>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonReset}"></t:block>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonApply}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<a t:fragment="buttonReset" t:href="@{/filter/reset}" class="waves-effect waves-light btn background-blue"><i class="material-icons left">settings_backup_restore</i>[[${locale.getString('filter.reset')}]]</a>
+
+<button t:fragment="buttonApply" class="btn waves-effect waves-light background-green" type="submit" id="buttonApplyFilter">
+    <i class="fas fa-filter left"></i>[[${locale.getString('filter.apply')}]]
+</button>
+
+<a t:fragment="buttonResetChart" class="filter-button-reset waves-effect waves-light btn background-blue"><i class="material-icons left">settings_backup_restore</i>[[${locale.getString('filter.reset')}]]</a>
+
+<a t:fragment="buttonClose" class="filter-button-close waves-effect waves-light background-blue btn white-text"><i class="fas fa-filter left"></i>[[${locale.getString('filter.apply')}]]</a>
+
+<t:block t:fragment="buttonCloseModal">
+    <t:block t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white')}"></t:block>
+</t:block>
+
+<div t:fragment="buttonsAllOrNone" class="row no-margin">
+    <div class="col s6 right-align">
+        <a class="waves-effect waves-light btn background-blue filter-button-all" t:text="locale.getString('filter.tags.button.all')"></a>
+    </div>
+    <div class="col s6">
+        <a class="waves-effect waves-light btn background-blue filter-button-none" t:text="locale.getString('filter.tags.button.none')"></a>
+    </div>
+</div>
+
+<div t:fragment="filterModal(FilterConfiguration filterConfiguration)" id="modalFilter" class="modal modal-fixed-footer background-color">
+    <div class="modal-content">
+        <h4 t:text="locale.getString('title.filter')"></h4>
+        <form name="NewFilterConfiguration" t:action="@{/filter/apply}" method="post">
+            <t:block t:replace="~{::filterModalContent(filterConfiguration, '')}"></t:block>
+        </form>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{::buttons}"></t:block>
+    </div>
+</div>
+
+<t:block t:fragment="filterModalContent(FilterConfiguration filterConfiguration, String prefix)" t:with="prefixValue=${strings.isEmpty(prefix) ? '' : prefix + '.'}">
+    <div class="row">
+        <div class="col s12">
+            <ul class="collapsible z-depth-2" id="filterSettings">
+                <li id="section-type">
+                    <div class="collapsible-header">
+                        <i class="fas fa-piggy-bank"></i>
+                        <t:block t:text="locale.getString('filter.type')"></t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                    <div class="collapsible-body">
+                        <div class="row no-margin">
+                            <div class="col s12 m4 l4">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeIncome'" t:checked="filterConfiguration.isIncludeIncome()">
+                                    <span class="text-default" t:text="locale.getString('filter.type.income')"></span>
+                                </label>
+                            </div>
+                            <div class="col s12 m4 l4">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeExpenditure'" t:checked="filterConfiguration.isIncludeExpenditure()">
+                                    <span class="text-default" t:text="locale.getString('filter.type.expenditure')"></span>
+                                </label>
+                            </div>
+                            <div class="col s12 m4 l4">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeTransfer'" t:checked="filterConfiguration.isIncludeTransfer()">
+                                    <span class="text-default" t:text="locale.getString('filter.type.transfer')"></span>
+                                </label>
+                            </div>
+                        </div>
+                    </div>
+                </li>
+
+                <li id="section-repeating">
+                    <div class="collapsible-header">
+                        <i class="material-icons">repeat</i>
+                        <t:block t:text="locale.getString('filter.repeating')"></t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                    <div class="collapsible-body">
+                        <div class="row no-margin">
+                            <div class="col s6 m6 l6">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeNotRepeating'" t:checked="filterConfiguration.isIncludeNotRepeating()">
+                                    <span class="text-default" t:text="locale.getString('filter.repeating.false')"></span>
+                                </label>
+                            </div>
+                            <div class="col s6 m6 l6">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeRepeating'" t:checked="filterConfiguration.isIncludeRepeating()">
+                                    <span class="text-default" t:text="locale.getString('filter.repeating.true')"></span>
+                                </label>
+                            </div>
+                        </div>
+                    </div>
+                </li>
+
+                <li id="section-categories">
+                    <div class="collapsible-header">
+                        <i class="material-icons">label</i>
+                        <t:block t:text="locale.getString('filter.categories')"></t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                    <div class="collapsible-body">
+                        <t:block t:replace="~{::buttonsAllOrNone}"></t:block>
+                        <div class="row no-margin">
+                            <div class="col s12">
+                                <div t:each="filterCategory, stat : filterConfiguration.getFilterCategories()">
+                                        <label>
+                                            <input type="checkbox" t:name="|${prefixValue}filterCategories['${stat.index}'].include|" t:checked="filterCategory.isInclude()">
+                                            <span class="text-default" t:text="filterCategory.getName()"></span>
+                                        </label>
+                                        <input type="hidden" t:name="|${prefixValue}filterCategories['${stat.index}'].ID|" t:value="filterCategory.getID()"/>
+                                        <input type="hidden" t:name="|${prefixValue}filterCategories['${stat.index}'].name|" t:value="filterCategory.getName()"/>
+                                    </div>
+                            </div>
+                        </div>
+                    </div>
+                </li>
+
+                <li id="section-tags">
+                    <div class="collapsible-header">
+                        <i class="material-icons">local_offer</i>
+                        <t:block t:text="locale.getString('filter.tags')"></t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                    <div class="collapsible-body">
+                        <t:block t:replace="~{::buttonsAllOrNone}"></t:block>
+                        <div class="row no-margin">
+                            <div class="col s12">
+                                <div t:each="filterTag, stat : filterConfiguration.getFilterTags()">
+                                        <label>
+                                            <input type="checkbox" t:name="|${prefixValue}filterTags['${stat.index}'].include|" t:checked="filterTag.isInclude()">
+                                            <span class="text-default" t:text="filterTag.getName()"></span>
+                                        </label>
+                                        <input type="hidden" t:name="|${prefixValue}filterTags['${stat.index}'].ID|" t:value="filterTag.getID()"/>
+                                        <input type="hidden" t:name="|${prefixValue}filterTags['${stat.index}'].name|" t:value="filterTag.getName()"/>
+                                    </div>
+                            </div>
+                        </div>
+                    </div>
+                </li>
+
+                <li id="section-name">
+                    <div class="collapsible-header">
+                        <i class="material-icons">subject</i>
+                        <t:block t:text="locale.getString('filter.name')"></t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                    <div class="collapsible-body">
+                        <div class="row no-margin">
+                            <div class="input-field col s12">
+                                <input id="filter-name" type="text" t:name="prefixValue + 'name'" t:value="filterConfiguration.getName() ?: ''">
+                                <label for="filter-name" t:text="locale.getString('filter.name.contains')"></label>
+                            </div>
+                        </div>
+                    </div>
+                </li>
+            </ul>
+        </div>
+    </div>
+</t:block>
+
+</t:block>
