+	 * Text that was built in Java from a localized message with inline markup (e.g. updateString).
+	 */
+	@TemplateFunction
+	public static SafeInlineHtml inlineText(String text)
+	{
+		return SafeInlineHtml.sanitize(text, INLINE_POLICY);
+	}
+
+	/**
+	 * A localized message that contains a link (e.g. settings.personalization.reload.page).
+	 */
+	@TemplateFunction
+	public static SafeHtml linkMessage(String key)
+	{
+		return SafeHtml.sanitize(Localization.getString(key), LINK_POLICY);
+	}
+
+	/**
+	 * The keywords as the chips plugin's initial data: {@code [{tag: 'value'}, ...]}.
+	 */
+	@TemplateFunction
+	public static List<Map<String, String>> keywordTags(List<TransactionNameKeyword> keywords)
+	{
+		final List<Map<String, String>> result = new ArrayList<>();
+		if(keywords != null)
+		{
+			for(TransactionNameKeyword keyword : keywords)
+			{
+				final Map<String, String> tag = new LinkedHashMap<>();
+				tag.put("tag", keyword.getValue());
+				result.add(tag);
+			}
+		}
+		return result;
+	}
+
+	/**
+	 * Title and help text per entity type (in map iteration order) for the import help modal, which
+	 * the old template wrote into data-title and data-text attributes.
+	 */
+	@TemplateFunction
+	public static List<Map<String, String>> importHelpTexts(Map<EntityType, Integer> numberOfEntitiesByType)
+	{
+		final List<Map<String, String>> result = new ArrayList<>();
+		if(numberOfEntitiesByType != null)
+		{
+			for(EntityType entityType : numberOfEntitiesByType.keySet())
+			{
+				final Map<String, String> item = new LinkedHashMap<>();
+				item.put("title", Localization.getString(entityType.getLocalizationKey()));
+				item.put("text", Localization.getString("import.entity." + entityType.name().toLowerCase()));
+				result.add(item);
+			}
+		}
+		return result;
+	}
+}
