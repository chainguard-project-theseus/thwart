diff --git a/BudgetMasterServer/src/main/resources/templates/miscFunctions.html b/BudgetMasterServer/src/main/resources/templates/miscFunctions.html
new file mode 100644
index 00000000..9c5e270d
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/miscFunctions.html
@@ -0,0 +1,49 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.hotkeys.HotKey">
+
+<!--/* indexFunctions.stepContent (first use guide). The old macro wrote the nested block content
+       inside the <p>; a browser closes the <p> before it and turns the stray </p> into an empty <p>.
+       inline: content that stays in the <p>, blocks: content after it (followed by that empty <p>). */-->
+<t:block t:fragment="stepContent(String headline, String contentText, String actionUrl, String actionName, Fragment inline, Fragment blocks)">
+    <h5 t:text="locale.getString(headline)"></h5>
+    <p>
+        <t:block t:utext="misc.inlineMessage(contentText)"></t:block>
+        <t:block t:replace="inline"></t:block>
+    </p>
+    <t:block t:if="blocks != null">
+        <t:block t:replace="blocks"></t:block>
+        <p></p>
+    </t:block>
+    <p>
+        <t:block t:if="!strings.isEmpty(actionUrl)"><t:block t:replace="~{indexFunctions :: action(actionUrl, actionName)}"></t:block></t:block>
+    </p>
+</t:block>
+
+<!--/* about.ftl cellKey */-->
+<div t:fragment="aboutCellKey(String key)" class="col s4 m3 offset-m2 l2 offset-l3 bold" t:text="key"></div>
+
+<!--/* hotkeys.ftl listHotKeys */-->
+<t:block t:fragment="listHotKeys(String headline, HotKey[] hotKeys)">
+    <div class="row">
+        <div class="col s12 headline center-align" t:text="headline"></div>
+    </div>
+
+    <div class="row" t:each="hotKey : hotKeys">
+        <div class="col s4 m3 offset-m2 l2 offset-l3 right-align bold">
+            <t:block t:if="!strings.isEmpty(hotKey.getModifierLocalized())">
+                <div class="keyboard-key modifier-key" t:text="hotKey.getModifierLocalized()"></div>
+                <span class="bold">+</span>
+            </t:block>
+            <div class="keyboard-key" t:text="hotKey.getKeyLocalized()"></div>
+        </div>
+        <div class="col s8 m5 l5" t:text="hotKey.getTextLocalized()"></div>
+    </div>
+</t:block>
+
+<!--/* header.buttonSubmit with its disabled argument (the shared fragment has none) */-->
+<t:block t:fragment="buttonSubmitDisabled(String name, String icon, String localizationKey, String id, String color, String classes, boolean disabled)">
+    <button t:id="strings.isEmpty(id) ? null : id" t:class="|btn waves-effect waves-light ${color} ${classes}|" type="submit" t:name="name" t:disabled="disabled">
+        <i t:class="strings.isEmpty(localizationKey) ? 'material-icons left no-margin' : 'material-icons left '" t:text="icon">icon</i><t:block t:unless="strings.isEmpty(localizationKey)" t:text="locale.getString(localizationKey)"></t:block>
+    </button>
+</t:block>
+
+</t:block>
