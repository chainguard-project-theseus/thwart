+            <div t:replace="~{helpers/iconSelect :: builtinIconOption(icon, item)}"></div>
+        </t:block>
+    </div>
+</t:block>
+
+<div t:fragment="builtinIconOption(String icon, Iconizable item)" class="col s4 m2 l2 builtin-icon-option-column"
+     t:with="selectedIconName=item.getIconReference() != null && item.getIconReference().isBuiltinIcon() ? item.getIconReference().getBuiltinIdentifier() : ''">
+    <div t:class="|builtin-icon-option ${selectedIconName == icon ? 'selected' : ''}|">
+        <i t:class="|builtin-icon-option-icon ${icon}|"></i>
+        <div class="builtin-icon-option-name truncate" t:text="icon"></div>
+    </div>
+</div>
+
+<t:block t:fragment="uploadImageForm">
+    <form id="form-upload-image" method="post" t:action="@{/media/uploadImage}" enctype="multipart/form-data">
+        <div class="file-field input-field col s12">
+            <div class="container">
