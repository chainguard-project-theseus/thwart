diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/customSelectMacros.html b/BudgetMasterServer/src/main/resources/templates/helpers/customSelectMacros.html
new file mode 100644
index 00000000..1e474437
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/customSelectMacros.html
@@ -0,0 +1,149 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState, de.deadlocker8.budgetmaster.categories.Category">
+<!--/* Fragments of the old helpers/customSelectMacros.ftl */-->
+
+<!--/* customSelectStart + customSelectEnd: FreeMarker opened the wrapper in one macro and closed it in the other.
+     Here it is one fragment: content = the old nested content, end = what came between the two macros' markup
+     (the hidden input). The unused "items" parameter of customSelectStart is dropped. */-->
+<div t:fragment="customSelectStart(String selector, String inputClasses, String labelText, String id, String icon, boolean disabled, String rowClasses, Fragment content, Fragment end)"
+     t:class="|row ${rowClasses}|">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix" t:text="icon"></i>
+        <label t:if="labelText != null && !labelText.isEmpty()" class="input-label" t:for="id" t:text="labelText"></label>
+        <div t:class="|custom-select-wrapper ${selector} ${disabled ? 'disabled' : ''}|" t:id="id">
+            <div class="custom-select">
+                <t:block t:replace="content"></t:block>
+            </div>
+            <t:block t:replace="end"></t:block>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="customCategorySelect(List<Category> categories, Category selectedCategory, String inputClasses, String labelText, String id, boolean showName, String rowClasses, boolean disabled, String form)"
+     t:replace="~{helpers/customSelectMacros :: customSelectStart('category-select-wrapper', inputClasses, labelText, id, 'label', disabled, rowClasses, ~{::category-select-content}, ~{::category-select-end})}">
+    <category-select-content t:remove="tag">
+        <div class="custom-select-trigger" tabindex="0">
+            <div class="custom-select-selected-item">
+                <t:block t:if="selectedCategory != null" t:replace="~{helpers/customSelectMacros :: customSelectOptionCategoryContent(selectedCategory, 'no-margin-left', true, showName)}"></t:block>
+            </div>
+            <div class="custom-select-arrow"></div>
+        </div>
+        <div class="custom-select-options">
+            <t:block t:each="category : categories">
+                <t:block t:unless="category.getType() == 'REST'">
+                    <div t:replace="~{helpers/customSelectMacros :: customSelectCategoryOption(category, selectedCategory != null ? selectedCategory.getID() == category.getID() : category.getType() == 'NONE')}"></div>
+                </t:block>
+            </t:block>
+        </div>
+    </category-select-content>
+    <category-select-end t:remove="tag">
+        <input type="hidden" name="category" class="hidden-input-custom-select" t:value="selectedCategory != null ? fmt.c(selectedCategory.getID()) : null" t:form="form.isEmpty() ? null : form"/>
+    </category-select-end>
+</div>
+
+<div t:fragment="customAccountSelect(String selector, String inputName, List<Account> accounts, Account selectedAccount, String inputClasses, String labelText, String id, boolean disabled)"
+     t:replace="~{helpers/customSelectMacros :: customSelectStart(selector, inputClasses, labelText, id, 'account_balance', disabled, '', ~{::account-select-content}, ~{::account-select-end})}">
+    <account-select-content t:remove="tag">
+        <div class="custom-select-trigger" tabindex="0">
+            <div class="custom-select-selected-item">
+                <t:block t:if="selectedAccount != null" t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountContent(selectedAccount, 'no-margin-left', '')}"></t:block>
+            </div>
+            <div class="custom-select-arrow"></div>
+        </div>
+        <div class="custom-select-options">
+            <t:block t:each="account : accounts">
+                <t:block t:if="account.getType() == 'CUSTOM'">
+                    <div t:replace="~{helpers/customSelectMacros :: customSelectAccountOption(account, selectedAccount != null && selectedAccount.getID() == account.getID())}"></div>
+                </t:block>
+            </t:block>
+        </div>
+    </account-select-content>
+    <account-select-end t:remove="tag">
+        <input type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedAccount != null ? fmt.c(selectedAccount.getID()) : null"/>
+    </account-select-end>
+</div>
+
+<div t:fragment="globalAccountSelect" class="input-field no-margin">
+    <div class="custom-select-wrapper global-account-select-wrapper">
+        <div class="custom-select">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountContent(helpers.getCurrentAccount(), 'no-margin-left', '')}"></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="account : helpers.getAllReadableAccounts()">
+                    <div t:replace="~{helpers/customSelectMacros :: customSelectAccountOption(account, account.isSelected() == true)}"></div>
+                </t:block>
+            </div>
+        </div>
+
+        <input type="hidden" class="hidden-input-custom-select" t:value="fmt.c(helpers.getCurrentAccount().getID())"/>
+    </div>
+</div>
+
+<div t:fragment="customAccountStateSelect(String selector, String inputName, AccountState[] availableStates, AccountState selectedState, String inputClasses, String labelText, String id)"
+     t:replace="~{helpers/customSelectMacros :: customSelectStart(selector, inputClasses, labelText, id, 'visibility', false, '', ~{::state-select-content}, ~{::state-select-end})}">
+    <state-select-content t:remove="tag">
+        <div class="custom-select-trigger" tabindex="0">
+            <div class="custom-select-selected-item">
+                <t:block t:if="selectedState != null" t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountStateContent(selectedState, 'no-margin-left')}"></t:block>
+            </div>
+            <div class="custom-select-arrow"></div>
+        </div>
+        <div class="custom-select-options">
+            <t:block t:each="state : availableStates">
+                <div t:replace="~{helpers/customSelectMacros :: customSelectAccountStateOption(state, selectedState != null && selectedState == state)}"></div>
+            </t:block>
+        </div>
+    </state-select-content>
+    <state-select-end t:remove="tag">
+        <input type="hidden" t:name="inputName" class="hidden-input-custom-select"
+               t:value="selectedState == null ? null : (selectedState == 'FULL_ACCESS' ? 'FULL_ACCESS' : (selectedState == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN'))"/>
+    </state-select-end>
+</div>
+
+<div t:fragment="customSelectCategoryOption(Category category, boolean isSelected)"
+     t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="category.getID()">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionCategoryContent(category, '', false, true)}"></t:block>
+</div>
+
+<t:block t:fragment="customSelectOptionCategoryContent(Category category, String classes, boolean datasetValue, boolean showName)">
+    <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(category, 'category-circle-small ' + classes, datasetValue, false)}"></t:block>
+    <span t:if="showName" class="custom-select-item-name" t:text="helpers.categoryName(category)"></span>
+</t:block>
+
+<div t:fragment="customSelectAccountOption(Account account, boolean isSelected)"
+     t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="account.getID()">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountContent(account, '', '')}"></t:block>
+</div>
+
+<t:block t:fragment="customSelectOptionAccountContent(Account account, String classes, String datasetValue)">
+    <div t:replace="~{helpers/customSelectMacros :: accountIcon(account, helpers.accountName(account), 'category-circle-small ' + classes, true)}"></div>
+    <span class="custom-select-item-name" t:text="helpers.accountName(account)"></span>
+</t:block>
+
+<div t:fragment="accountIcon(Account account, String accountName, String classes, boolean datasetValue)"
+     t:class="|category-circle ${classes} category-square ${account.getIconReference() != null && account.getIconReference().isFallbackIcon() ? 'account-square-border' : ''}|"
+     t:data-value="datasetValue ? account.getID() : null">
+    <span t:style="|color: ${css.color(helpers.fontColor(account))}|">
+        <t:block t:replace="~{helpers/header :: entityIcon(account, 'account-select-icon', accountName)}"></t:block>
+    </span>
+</div>
+
+<div t:fragment="customSelectAccountStateOption(AccountState state, boolean isSelected)"
+     t:class="|custom-select-option ${isSelected ? 'selected' : ''}|"
+     t:data-value="state == 'FULL_ACCESS' ? 'FULL_ACCESS' : (state == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN')">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountStateContent(state, '')}"></t:block>
+</div>
+
+<t:block t:fragment="customSelectOptionAccountStateContent(AccountState state, String classes)">
+    <div t:class="|category-circle category-circle-small ${classes}|"
+         t:data-value="state == 'FULL_ACCESS' ? 'FULL_ACCESS' : (state == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN')">
+        <span class="text-blue">
+            <i t:class="state.getIcon()"></i>
+        </span>
+    </div>
+    <span class="custom-select-item-name" t:text="locale.getString(state.getLocalizationKey())"></span>
+</t:block>
+</html>
