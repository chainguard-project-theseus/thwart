@@ -0,0 +1,49 @@
+package de.deadlocker8.budgetmaster.viewsupport;
+
+import de.deadlocker8.budgetmaster.services.CurrencyService;
+import de.deadlocker8.budgetmaster.services.DateService;
+import de.deadlocker8.budgetmaster.services.HelpersService;
+import de.deadlocker8.budgetmaster.update.BudgetMasterUpdateService;
+import org.springframework.stereotype.Component;
+
+/**
+ * Holds the services the template function namespaces delegate to.
+ * The FreeMarker views read these services from the model; Tessera fragments only see their parameters,
+ * so the application-wide services are exposed through {@code @TemplateFunctions} classes instead.
+ */
+@Component
+public class ViewServices
+{
+	private static HelpersService helpers;
+	private static DateService dateService;
+	private static CurrencyService currencyService;
+	private static BudgetMasterUpdateService updateService;
+
+	public ViewServices(HelpersService helpers, DateService dateService, CurrencyService currencyService, BudgetMasterUpdateService updateService)
+	{
+		ViewServices.helpers = helpers;
+		ViewServices.dateService = dateService;
+		ViewServices.currencyService = currencyService;
+		ViewServices.updateService = updateService;
+	}
+
+	static HelpersService helpers()
+	{
+		return helpers;
+	}
+
+	static DateService dateService()
+	{
+		return dateService;
+	}
+
+	static CurrencyService currencyService()
+	{
+		return currencyService;
+	}
+
+	static BudgetMasterUpdateService updateService()
+	{
+		return updateService;
+	}
+}
