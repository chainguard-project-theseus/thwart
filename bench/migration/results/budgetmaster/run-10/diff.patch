+package de.deadlocker8.budgetmaster.viewsupport;
+
+import org.springframework.context.MessageSource;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.support.ResourceBundleMessageSource;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+
+/**
+ * The bundles of {@link de.thecodelabs.utils.util.Localization} as Spring messages, for {@code #{key}} in templates.
+ * Spring Boot's auto-configuration needs a base file without locale suffix, which these bundles don't have.
+ */
+@Configuration
+public class MessagesConfiguration
+{
+	@Bean
+	public MessageSource messageSource()
+	{
+		final ResourceBundleMessageSource messageSource = new ResourceBundleMessageSource();
+		messageSource.setBasenames("languages/base", "languages/news", "languages/hints");
+		messageSource.setDefaultEncoding(StandardCharsets.UTF_8.name());
+		messageSource.setFallbackToSystemLocale(false);
+		messageSource.setDefaultLocale(Locale.ENGLISH);
+		messageSource.setAlwaysUseMessageFormat(true);
+		return messageSource;
+	}
+}
