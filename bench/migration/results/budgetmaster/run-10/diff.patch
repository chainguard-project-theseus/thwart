@@ -0,0 +1,162 @@
+package de.deadlocker8.budgetmaster.viewsupport;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+
+/**
+ * Date and currency formatting of the {@code dateService}/{@code currencyService} model attributes,
+ * plus the FreeMarker built-ins the views used ({@code ?c}, {@code ?capitalize}).
+ */
+@TemplateFunctions("fmt")
+public final class FormatFunctions
+{
+	private FormatFunctions()
+	{
+	}
+
+	@TemplateFunction
+	public static String getDateStringNormal(LocalDate date)
+	{
+		return ViewServices.dateService().getDateStringNormal(date);
+	}
+
+	@TemplateFunction
+	public static String getDateStringWithoutYear(LocalDate date)
+	{
+		return ViewServices.dateService().getDateStringWithoutYear(date);
+	}
+
+	@TemplateFunction
+	public static String getLongDateString(LocalDate date)
+	{
+		return ViewServices.dateService().getLongDateString(date);
+	}
+
+	@TemplateFunction
+	public static String getDateStringWithMonthAndYear(LocalDate date)
+	{
+		return ViewServices.dateService().getDateStringWithMonthAndYear(date);
+	}
+
+	@TemplateFunction
+	public static String getDateTimeString(LocalDate date)
+	{
+		return ViewServices.dateService().getDateTimeString(date);
+	}
+
+	@TemplateFunction
+	public static String getDateTimeString(LocalDateTime dateTime)
+	{
+		return ViewServices.dateService().getDateTimeString(dateTime);
+	}
+
+	@TemplateFunction
+	public static String getDateStringWithMonthName(LocalDate date)
+	{
+		return ViewServices.dateService().getDateStringWithMonthName(date);
+	}
+
+	@TemplateFunction
+	public static String getCurrencyString(int amount)
+	{
+		return ViewServices.currencyService().getCurrencyString(amount);
+	}
+
+	@TemplateFunction
+	public static String getCurrencyString(double amount)
+	{
+		return ViewServices.currencyService().getCurrencyString(amount);
+	}
+
+	@TemplateFunction
+	public static String getAmountString(int amount)
+	{
+		return ViewServices.currencyService().getAmountString(amount);
+	}
+
+	@TemplateFunction
+	public static String getAmountString(double amount, boolean useGrouping)
+	{
+		return ViewServices.currencyService().getAmountString(amount, useGrouping);
+	}
+
+	/** FreeMarker {@code ?c}: a number for computers, no grouping. */
+	@TemplateFunction
+	public static String c(Number number)
+	{
+		if(number == null)
+		{
+			return "";
+		}
+		if(number instanceof Double || number instanceof Float)
+		{
+			final double value = number.doubleValue();
+			if(value == Math.rint(value) && !Double.isInfinite(value))
+			{
+				return String.valueOf((long) value);
+			}
+			return new java.math.BigDecimal(String.valueOf(value)).stripTrailingZeros().toPlainString();
+		}
+		return number.toString();
+	}
+
+	/** FreeMarker's default number output {@code ${number}}: locale grouping, at most three decimals. */
+	@TemplateFunction
+	public static String number(java.util.Locale locale, Number number)
+	{
+		if(number == null)
+		{
+			return "";
+		}
+		final java.text.NumberFormat format = java.text.NumberFormat.getNumberInstance(locale);
+		format.setMaximumFractionDigits(3);
+		return format.format(number);
+	}
+
+	/** FreeMarker {@code ?capitalize}: first letter of each word upper case. */
+	@TemplateFunction
+	public static String capitalize(String text)
+	{
+		if(text == null)
+		{
+			return "";
+		}
+		final StringBuilder builder = new StringBuilder(text.length());
+		boolean wordStart = true;
+		for(char character : text.toCharArray())
+		{
+			if(Character.isWhitespace(character))
+			{
+				wordStart = true;
+				builder.append(character);
+			}
+			else if(wordStart)
+			{
+				builder.append(Character.toUpperCase(character));
+				wordStart = false;
+			}
+			else
+			{
+				builder.append(Character.toLowerCase(character));
+			}
+		}
+		return builder.toString();
+	}
+
+	/** FreeMarker {@code text[0]}: the first character, or "" */
+	@TemplateFunction
+	public static String firstChar(String text)
+	{
+		return text == null || text.isEmpty() ? "" : text.substring(0, 1);
+	}
+
+	/** FreeMarker {@code ?has_content} for strings. */
+	@TemplateFunction
+	public static boolean hasContent(String text)
+	{
+		return text != null && !text.isEmpty();
+	}
+}
