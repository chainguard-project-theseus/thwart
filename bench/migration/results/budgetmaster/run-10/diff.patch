+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.templategroup.TemplateGroup">
+<!--/* Fragments of the old templates/templateFunctions.ftl */-->
+
+<a t:fragment="buttonNew" t:replace="~{helpers/header :: buttonLink(url='/templates/newTemplate', icon='add', localizationKey='title.template.new', id='', color='background-blue', classes='', noUrl=false, disabled=false, target='')}"></a>
+
+<a t:fragment="buttonEditTemplateGroups" t:replace="~{helpers/header :: buttonLink(url='/templateGroups', icon='folder', localizationKey='title.template.group.edit.short', id='', color='background-blue', classes='', noUrl=false, disabled=false, target='')}"></a>
+
+<t:block t:fragment="buttons">
+    <div class="row valign-wrapper hide-on-small-only">
+        <div class="col s6 right-align">
+            <a t:replace="~{templates/templateFunctions :: buttonNew}"></a>
+        </div>
+
+        <div class="col s6 left-align">
+            <a t:replace="~{templates/templateFunctions :: buttonEditTemplateGroups}"></a>
+        </div>
+    </div>
+    <div class="hide-on-med-and-up">
+        <div class="row valign-wrapper center-align">
+            <div class="col s12">
+                <a t:replace="~{templates/templateFunctions :: buttonNew}"></a>
+            </div>
+        </div>
+        <div class="row valign-wrapper center-align">
+            <div class="col s12">
+                <a t:replace="~{templates/templateFunctions :: buttonEditTemplateGroups}"></a>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="listTemplates(Map<TemplateGroup, List<Template>> templatesByGroup)">
+    <div class="container">
+        <div class="row">
+            <div class="col s12">
+                <ul t:each="entry : templatesByGroup" class="collapsible expandable templateCollapsible" t:data-group-id="entry.key.getID()">
+                    <div t:if="templatesByGroup.size() != 1" class="template-group-headline" t:text="entry.key.getType() == 'DEFAULT' ? locale.getString('template.group.default') : entry.key.getName()"></div>
+
+                    <t:block t:each="template : entry.value"><li t:replace="~{templates/templateFunctions :: templateItem(template)}"></li></t:block>
+                </ul>
+            </div>
+        </div>
+    </div>
+
+     <form id="form-move-template-to-group" method="post" t:action="@{/templateGroups/moveTemplateToGroup}">
+        <input type="hidden" name="templateID" value=""/>
+        <input type="hidden" name="groupID" value=""/>
+     </form>
+</t:block>
+
+<li t:fragment="templateItem(Template template)" class="template-item z-depth-2" t:data-template-id="template.getID()">
+    <div class="collapsible-header bold">
