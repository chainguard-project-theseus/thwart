+package de.deadlocker8.budgetmaster.viewsupport;
+
+import com.google.gson.Gson;
+import com.google.gson.reflect.TypeToken;
+import de.deadlocker8.budgetmaster.tags.Tag;
+import de.deadlocker8.budgetmaster.transactions.Transaction;
+import de.deadlocker8.budgetmaster.transactions.TransactionBase;
+import de.deadlocker8.budgetmaster.transactions.TransactionImportController;
+import de.deadlocker8.budgetmaster.transactions.csvimport.CsvTransaction;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.web.context.request.RequestAttributes;
+import org.springframework.web.context.request.RequestContextHolder;
+
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * View helpers of the transactions, transaction import and search pages
+ * (what the FreeMarker views computed with assigns, session attributes or JSON strings).
+ */
+@TemplateFunctions("transactionViews")
+public final class TransactionViewFunctions
+{
+	private static final Gson GSON = new Gson();
+
+	private TransactionViewFunctions()
+	{
+	}
+
+	/** One heading of the transactions list: consecutive transactions with the same (upper-cased) date string. */
+	public record TransactionDateGroup(String date, List<Transaction> transactions)
+	{
+	}
+
+	@TemplateFunction
+	public static List<TransactionDateGroup> groupByDate(List<Transaction> transactions)
+	{
+		final List<TransactionDateGroup> groups = new ArrayList<>();
+		String lastDate = null;
+		List<Transaction> current = null;
+		for(Transaction transaction : transactions)
+		{
+			final String date = ViewServices.dateService().getDateStringWithMonthName(transaction.getDate()).toUpperCase(Locale.ROOT);
+			if(current == null || !date.equals(lastDate))
+			{
+				current = new ArrayList<>();
+				groups.add(new TransactionDateGroup(date, current));
+				lastDate = date;
+			}
+			current.add(transaction);
+		}
+		return groups;
+	}
+
+	/** The {@code suggestionsJSON} model attribute (a JSON array of names) as a list. */
+	@TemplateFunction
+	public static List<String> nameSuggestions(String suggestionsJSON)
+	{
+		if(suggestionsJSON == null || suggestionsJSON.isBlank())
+		{
+			return List.of();
+		}
+		final List<String> names = GSON.fromJson(suggestionsJSON, new TypeToken<List<String>>() {}.getType());
+		return names == null ? List.of() : names;
+	}
+
+	/** {@code [{tag: 'name'}, ...]} of the old {@code initialTags} script. */
+	@TemplateFunction
+	public static List<Map<String, String>> initialTags(TransactionBase transaction)
+	{
+		final List<Map<String, String>> tags = new ArrayList<>();
+		if(transaction != null && transaction.getTags() != null)
+		{
+			for(Tag tag : transaction.getTags())
+			{
+				tags.add(Map.of("tag", tag.getName()));
+			}
+		}
+		return tags;
+	}
+
+	/** {@code {'name': null, ...}} of the old {@code tagAutoComplete} script. */
+	@TemplateFunction
+	public static Map<String, String> tagAutoComplete()
+	{
+		final Map<String, String> tags = new LinkedHashMap<>();
+		for(Tag tag : ViewServices.helpers().getAllTags())
+		{
+			tags.put(tag.getName(), null);
+		}
+		return tags;
+	}
+
+	/** {@code currentCsvTransaction??}: the session attribute set while a CSV row is turned into a transaction. */
+	@TemplateFunction
+	public static boolean isCsvImportActive()
+	{
+		final RequestAttributes attributes = RequestContextHolder.getRequestAttributes();
+		return attributes != null && attributes.getAttribute(TransactionImportController.RequestAttributeNames.CURRENT_CSV_TRANSACTION, RequestAttributes.SCOPE_SESSION) != null;
+	}
+
+	/** {@code transaction.getRepeatingOption().getEndOption().getValue()} for "after x times" */
+	@TemplateFunction
+	public static String repeatingEndValue(Transaction transaction)
+	{
+		if(transaction == null || transaction.getRepeatingOption() == null || transaction.getRepeatingOption().getEndOption() == null)
+		{
+			return "";
+		}
+		final Object value = transaction.getRepeatingOption().getEndOption().getValue();
+		return value == null ? "" : value.toString();
+	}
+
+	/** the end date of a repeating transaction (long date string), or of {@code currentDate} */
+	@TemplateFunction
+	public static String repeatingEndDate(boolean checked, Transaction transaction, LocalDate currentDate)
+	{
+		if(checked && transaction.getRepeatingOption().getEndOption().getValue() instanceof LocalDate endDate)
+		{
+			return ViewServices.dateService().getLongDateString(endDate);
+		}
+		return ViewServices.dateService().getLongDateString(currentDate);
+	}
+
+	/**
+	 * The DataTables sort/search values of the CSV import table (the old {@code data-order}/{@code data-search}
+	 * attributes), per row: status, date, category, name, description, amount.
+	 */
+	@TemplateFunction
+	public static List<List<String>> csvSortValues(List<CsvTransaction> csvTransactions)
+	{
+		final List<List<String>> rows = new ArrayList<>();
+		for(CsvTransaction csvTransaction : csvTransactions)
+		{
+			final List<String> row = new ArrayList<>();
+			row.add(Localization.getString(csvTransaction.getStatus().getLocalizationKey()));
+			row.add(String.valueOf(csvTransaction.getDate()));
+			row.add(csvTransaction.getCategory() == null ? "" : String.valueOf(csvTransaction.getCategory().getName()));
+			row.add(String.valueOf(csvTransaction.getName()));
+			row.add(String.valueOf(csvTransaction.getDescription()));
+			row.add(ViewServices.currencyService().getCurrencyString(csvTransaction.getAmount()));
+			rows.add(row);
+		}
+		return rows;
+	}
+}
