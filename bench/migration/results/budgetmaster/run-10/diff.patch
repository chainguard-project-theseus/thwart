diff --git a/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html b/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html
new file mode 100644
index 00000000..2ed16c69
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html
@@ -0,0 +1,123 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="Account account, AccountState[] availableAccountStates, LocalDate today, Map<String, String> fieldErrors, List<Notification> notifications"
+      t:replace="~{helpers/header :: page('BudgetMaster - ' + (account.getID() != null ? locale.getString('title.account.edit') : locale.getString('title.account.new')), ~{::head}, ~{::body})}">
+<head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+</head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('accounts')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="account.getID() != null ? locale.getString('title.account.edit') : locale.getString('title.account.new')"></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::account-content})}">
+                <account-content t:remove="tag">
+                    <div class="container">
+                    <form name="NewAccount" t:action="@{/accounts/newAccount}" method="post">
+                        <input type="hidden" name="ID" t:value="account.getID() != null ? fmt.c(account.getID()) : ''">
+                        <input type="hidden" name="isSelected" t:value="account.isSelected() != null ? '' + account.isSelected() : ''">
+                        <input type="hidden" name="isDefault" t:value="account.isDefault() != null ? '' + account.isDefault() : ''">
+
+                        <!--/* name */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">edit</i>
+                                <input id="account-name" type="text" name="name"
+                                       t:class="|${fieldErrors['name'] != null ? 'tooltipped invalid' : 'validate'} |"
+                                       t:data-position="fieldErrors['name'] != null ? 'bottom'" t:data-delay="fieldErrors['name'] != null ? 50"
+                                       t:title="fieldErrors['name']"
+                                       t:value="account.getName() ?: ''">
+                                <label for="account-name" t:text="locale.getString('account.new.label.name')"></label>
+                            </div>
+                        </div>
+
+                        <!--/* description */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">article</i>
+                                <!--/* the old page wrote a second class attribute (validation), which the browser ignored: only materialize-textarea */-->
+                                <textarea id="account-description" class="materialize-textarea" name="description" data-length="250"
+                                          t:data-position="fieldErrors['description'] != null ? 'bottom'" t:data-delay="fieldErrors['description'] != null ? 50"
+                                          t:title="fieldErrors['description']"
+                                          t:text="account.getDescription() ?: ''"></textarea>
+                                <label class="input-label" for="account-description" t:text="locale.getString('transaction.new.label.description')"></label>
+                            </div>
+                        </div>
+
+                        <!--/* icon */-->
+                        <div t:replace="~{helpers/iconSelect :: iconSelect('account-icon', account, false,
+                                account.getIconReference() != null && (account.getIconReference().isImageIcon() || account.getIconReference().isBuiltinIcon()) ? 'category-square' : 'category-square account-square-border',
+                                'category-square account-square-border', false)}"></div>
+
+                        <!--/* font color */-->
+                        <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(account)}"></t:block>
+
+                        <!--/* state */-->
+                        <div t:replace="~{helpers/customSelectMacros :: customAccountStateSelect('account-state-select-wrapper', 'accountState', availableAccountStates,
+                                account.getAccountState() != null ? account.getAccountState() : availableAccountStates[0],
+                                'col s12 m12 l8 offset-l2', locale.getString('account.new.label.state'), 'account-state')}"></div>
+
+                        <!--/* end date */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">notifications</i>
+                                <input id="account-datepicker" type="text" class="datepicker" name="endDate" t:value="account.getEndDate() != null ? fmt.getLongDateString(account.getEndDate()) : ''">
+                                <label class="input-label" for="account-datepicker" t:text="locale.getString('account.new.label.endDate')"></label>
+                            </div>
+                        </div>
+
+                        <script>
+                            var startDateString = [[${fmt.getLongDateString(account.getEndDate() != null ? account.getEndDate() : today)}]];
+                            startDate = startDateString.split(".");
+                            startDate = new Date(startDate[2], startDate[1]-1, startDate[0]);
+                        </script>
+
+                        <br>
+
+                        <!--/* buttons */-->
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <a t:replace="~{helpers/header :: buttonLink(url='/accounts', icon='clear', localizationKey='cancel', id='button-cancel-save-account', color='red', classes='', noUrl=false, disabled=false, target='')}"></a>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <button t:replace="~{helpers/header :: buttonSubmit(name='action', icon='save', localizationKey='save', id='button-save-account', color='green', classes='', disabled=false, formaction='', value='', form='')}"></button>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <a t:replace="~{helpers/header :: buttonLink(url='/accounts', icon='clear', localizationKey='cancel', id='button-cancel-save-account', color='red', classes='', noUrl=false, disabled=false, target='')}"></a>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <button t:replace="~{helpers/header :: buttonSubmit(name='action', icon='save', localizationKey='save', id='button-save-account', color='green', classes='', disabled=false, formaction='', value='', form='')}"></button>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+                </account-content>
+                </t:block>
+            </div>
+        </main>
+
+        <div t:replace="~{helpers/iconSelect :: modalIconSelect('account-name', account)}"></div>
+
+        <script t:replace="~{helpers/globalDatePicker :: datePickerLocalization}"></script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/accounts.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+</body>
+</html>
