+                            </div>
+
+                            <div class="col m6 l4 left-align">
+                                <button t:replace="~{helpers/header :: buttonSubmit(name='action', icon='unarchive', localizationKey='settings.database.import', id='buttonImport', color='green', classes='', disabled=false, formaction='', value='', form='')}"></button>
+                            </div>
+                        </div>
+                    </form>
+
+                    <div id="modal-import-entity-help" class="modal background-color">
