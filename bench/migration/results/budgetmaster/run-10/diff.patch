+package de.deadlocker8.budgetmaster.viewsupport;
+
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.HtmlPolicy;
+import dev.tessera.runtime.SafeHtml;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Localized strings for templates ({@code locale.getString('key', args...)}).
+ * Bundle messages that contain markup ({@code <br>}, links) are written with {@code t:utext="#{key(args)}"} instead,
+ * which Tessera checks at build time.
+ */
+@TemplateFunctions("locale")
+public final class LocaleFunctions
+{
+	private static final HtmlPolicy NOTIFICATION_POLICY = HtmlPolicy.builder()
+			.allowElements(HtmlPolicy.ELEMENTS.toArray(new String[0]))
+			.allowAttributes(HtmlPolicy.ATTRIBUTES.toArray(new String[0]))
+			.allowClasses("text-default")
+			.linkRel()
+			.build();
+
+	private LocaleFunctions()
+	{
+	}
+
+	@TemplateFunction
+	public static String getString(String key)
+	{
+		return Localization.getString(key);
+	}
+
+	@TemplateFunction
+	public static String getString(String key, Object arg0)
+	{
+		return Localization.getString(key, arg0);
+	}
+
+	@TemplateFunction
+	public static String getString(String key, Object arg0, Object arg1)
+	{
+		return Localization.getString(key, arg0, arg1);
+	}
+
+	@TemplateFunction
+	public static String getString(String key, Object arg0, Object arg1, Object arg2)
+	{
+		return Localization.getString(key, arg0, arg1, arg2);
+	}
+
+	/** Notification messages are built in Java and may contain an edit link. */
+	@TemplateFunction
+	public static SafeHtml notificationHtml(String message)
+	{
+		return SafeHtml.sanitize(message, NOTIFICATION_POLICY);
+	}
+
+}
