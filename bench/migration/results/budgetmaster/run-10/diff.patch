+	/**
+	 * The script of a chart, as charts/charts used to inline it: {@code var transactionData = [];} is replaced by
+	 * {@code var transactionData = chartTransactionData;} (declared by the page before it loads this script)
+	 * and {@code containerID} by the id of the page's chart container.
+	 */
+	@GetMapping(value = "/{ID}/script/{containerID}", produces = "text/javascript;charset=UTF-8")
+	@ResponseBody
+	public String chartScript(@PathVariable("ID") Integer ID, @PathVariable("containerID") String containerID)
+	{
+		final Optional<Chart> chartOptional = chartService.getRepository().findById(ID);
+		if(chartOptional.isEmpty())
+		{
+			throw new ResourceNotFoundException();
+		}
+
+		// the id is written into JavaScript code: accept only a UUID, as generated by showChart
+		final String validatedContainerID;
+		try
+		{
+			validatedContainerID = UUID.fromString(containerID).toString();
+		}
+		catch(IllegalArgumentException e)
+		{
+			throw new ResourceNotFoundException();
+		}
+
+		return chartOptional.get().getScript()
+				.replace("var transactionData = [];", "var transactionData = chartTransactionData;")
+				.replace("containerID", validatedContainerID);
+	}
+
