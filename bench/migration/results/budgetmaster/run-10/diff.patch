+                                            <div t:text="locale.getString('transaction.new.label.description')"></div>
+                                            <div class="input-field">
+                                                <input type="text" name="description" t:value="accountsFilterConfiguration != null ? accountsFilterConfiguration.getDescription() : ''"/>
+                                            </div>
+                                        </th>
+                                        <th class="vertical-align-middle">
+                                            <button class="btn waves-effect waves-light background-green" type="submit" id="accounts-filter-button">
+                                                <i class="fas fa-filter left"></i>[[${locale.getString('filter.apply')}]]
+                                            </button>
+                                        </th>
+                                    </tr>
+                                </thead><tbody>
+
+                                <t:block t:each="account : accounts">
+                                    <tr t:if="account.getType() == 'CUSTOM'" class="account-overview-row">
+                                        <td><div t:replace="~{helpers/customSelectMacros :: accountIcon(account, account.getName(), 'text-blue', false)}"></div></td>
+                                        <td>
+                                            <t:block t:if="account.getAccountState() == 'READ_ONLY'">
+                                                <div class="placeholder-icon placeholder-icon-right"></div>
+                                                <i class="fas fa-lock placeholder-icon-right"></i>
+                                            </t:block>
+                                            <t:block t:if="account.getAccountState() == 'HIDDEN'">
+                                                <div class="placeholder-icon placeholder-icon-right"></div>
+                                                <i class="far fa-eye-slash placeholder-icon-right"></i>
+                                            </t:block>
+                                            <t:block t:unless="account.getAccountState() == 'READ_ONLY' || account.getAccountState() == 'HIDDEN'">
+                                                <!--/* account.tooltip.default as a choice between its literal texts: a computed String can't go into data-tooltip */-->
+                                                <a t:href="@{/accounts/{id}/setAsDefault(id=account.getID())}" class="btn-flat no-padding text-default tooltipped" data-position="left" t:data-tooltip="helpers.getSettings().getLanguage() == 'GERMAN' ? 'Als Standardkonto festlegen' : 'Set as default account'"><i class="material-icons left" t:text="account.isDefault() == true ? 'star' : 'star_border'"></i></a>
+                                                <i class="fas fa-edit placeholder-icon-right"></i>
+                                            </t:block>
+                                        </td>
+                                        <td>
+                                            <t:block t:if="account.getEndDate() != null">
+                                                <i class="fas fa-bell placeholder-icon-right"></i> [[${fmt.getDateStringNormal(account.getEndDate())}]]
+                                            </t:block>
+                                            <div t:if="account.getEndDate() == null" class="placeholder-icon"></div>
+                                        </td>
+                                        <td t:text="account.getName()"></td>
+                                        <td>
+                                            <div class="truncate account-description">
+                                                [[${account.getDescription()}]]
+                                            </div>
+                                        </td>
+                                        <td>
+                                            <a t:href="@{/accounts/{id}/edit(id=account.getID())}" class="btn-flat no-padding text-default"><i class="material-icons left">edit</i></a>
+                                            <a id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-account" t:data-url="@{/accounts/{id}/requestDelete(id=account.getID())}">
+                                                <i class="material-icons left no-margin ">delete</i>
+                                            </a>
+                                        </td>
+                                    </tr>
+                                </t:block>
+                            </tbody></table>
+                        </form>
+                        <div t:if="accounts.isEmpty()" class="headline center-align" t:text="locale.getString('placeholder')"></div>
+                    </div>
+                </accounts-content>
+                </t:block>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+
+        <t:block t:if="accountNotDeletable != null && currentAccount != null">
+            <!-- warning account not deletable -->
+            <div id="modalAccountNotDeletable" class="modal background-color">
+                <div class="modal-content">
+                    <h4 t:text="locale.getString('info.title.account.delete')"></h4>
+                    <p t:text="locale.getString('warning.text.account.delete', currentAccount.getName())"></p>
+                </div>
+                <div class="modal-footer background-color">
+                    <a t:replace="~{helpers/header :: buttonLink(url='/accounts', icon='done', localizationKey='ok', id='buttonCloseWhatsNew', color='green', classes='modal-action modal-close text-white', noUrl=false, disabled=false, target='')}"></a>
+                </div>
+            </div>
+        </t:block>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/accounts.js}"></script>
+</body>
+</html>
