diff --git a/BudgetMasterServer/src/main/resources/templates/indexFunctions.html b/BudgetMasterServer/src/main/resources/templates/indexFunctions.html
new file mode 100644
index 00000000..346316ce
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/indexFunctions.html
@@ -0,0 +1,30 @@
+<html xmlns:t="https://tessera.dev">
+<!--/* Macros of the old indexFunctions.ftl */-->
+<div t:fragment="homeEntry(String url, String icon, String iconColor, String headlineText, String bodyText, Fragment content)" class="col s12 m6 l4 home-menu-cell">
+    <a t:replace="~{helpers/header :: buttonFlat(url=url, icon=icon, localizationKey=headlineText, id='', classes='home-menu-link budget', noUrl=false, iconClasses='icon-budget ' + iconColor, target='', datasetIndex=null)}"></a>
+    <p class="text-grey home-menu-text" t:text="locale.getString(bodyText)"></p>
+    <div class="left-align">
+        <t:block t:replace="content"></t:block>
+    </div>
+</div>
+
+<a t:fragment="action(String url, String name)" t:replace="~{helpers/header :: buttonFlat(url=url, icon='play_arrow', localizationKey=name, id='', classes='home-menu-link-item', noUrl=false, iconClasses='', target='', datasetIndex=null)}"></a>
+
+<!--/* The old macro wrote <#nested> inside <p>; every caller's content starts with a block element, so the browser
+     closed the <p> before it and made an empty <p> of the stray </p>. This fragment writes that structure directly.
+     contentText messages may contain <br>: they are written with t:utext="#{key}" (keys must be literal). */-->
+<t:block t:fragment="stepContent(String headline, String contentText, String actionUrl, String actionName, Fragment content)">
+    <h5 t:text="locale.getString(headline)"></h5>
+    <p t:if="contentText == 'home.first.use.step.1.contentText'" t:utext="#{home.first.use.step.1.contentText}"></p>
+    <p t:if="contentText == 'home.first.use.step.2.contentText'" t:utext="#{home.first.use.step.2.contentText}"></p>
+    <p t:if="contentText == 'home.first.use.step.3.contentText'" t:utext="#{home.first.use.step.3.contentText}"></p>
+    <p t:if="contentText == 'home.first.use.step.4.contentText'" t:utext="#{home.first.use.step.4.contentText}"></p>
+    <p t:if="contentText == 'home.first.use.step.5.contentText'" t:utext="#{home.first.use.step.5.contentText}"></p>
+    <p t:if="contentText == 'home.menu.transactions'" t:utext="#{home.menu.transactions}"></p>
+    <t:block t:replace="content"></t:block>
+    <p t:if="content != null"></p>
+    <p>
+        <t:block t:if="!actionUrl.isEmpty()"><a t:replace="~{indexFunctions :: action(actionUrl, actionName)}"></a></t:block>
+    </p>
+</t:block>
+</html>
