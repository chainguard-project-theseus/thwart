+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templategroup.TemplateGroup"
+      t:params="TemplateGroup templateGroup, Map<String, String> fieldErrors, List<Notification> notifications"
+      t:replace="~{helpers/header :: page('BudgetMaster - ' + (templateGroup.getID() != null ? locale.getString('title.template.group.edit') : locale.getString('title.template.group.new')), ~{::head}, ~{::body})}">
+<head t:remove="tag">
+</head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="(templateGroup.getID() != null ? locale.getString('title.template.group.edit') : locale.getString('title.template.group.new'))"></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::new-template-group-content})}">
+                <new-template-group-content t:remove="tag">
+                    <div class="container">
+                    <form name="NewTemplateGroup" t:action="@{/templateGroups/newTemplateGroup}" method="post" onsubmit="return validateForm(true)">
+                        <input type="hidden" name="ID" t:value="templateGroup.getID() == null ? '' : fmt.c(templateGroup.getID())">
+
+                        <!--/* template group name */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">file_copy</i>
+                                <input id="template-group-name" type="text" name="name"
+                                       t:class="fieldErrors['name'] != null ? 'tooltipped invalid' : 'validate'"
+                                       t:data-position="fieldErrors['name'] != null ? 'bottom'" t:data-delay="fieldErrors['name'] != null ? 50"
+                                       t:title="fieldErrors['name']"
+                                       t:value="templateGroup.getName() ?: ''">
+                                <label for="template-group-name" t:text="locale.getString('transaction.new.label.name')"></label>
+                            </div>
+                        </div>
+
+                        <br>
+
+                        <!--/* buttons */-->
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <a t:replace="~{helpers/header :: buttonLink(url='/templateGroups', icon='clear', localizationKey='cancel', id='', color='red', classes='', noUrl=false, disabled=false, target='')}"></a>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <button t:replace="~{helpers/header :: buttonSubmit(name='action', icon='save', localizationKey='save', id='', color='green', classes='', disabled=false, formaction='', value='', form='')}"></button>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <a t:replace="~{helpers/header :: buttonLink(url='/templateGroups', icon='clear', localizationKey='cancel', id='', color='red', classes='', noUrl=false, disabled=false, target='')}"></a>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <button t:replace="~{helpers/header :: buttonSubmit(name='action', icon='save', localizationKey='save', id='', color='green', classes='', disabled=false, formaction='', value='', form='')}"></button>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+                </new-template-group-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/templateGroups.js}"></script>
+</body>
+</html>
