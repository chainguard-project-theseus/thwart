diff --git a/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionNormal.html b/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionNormal.html
new file mode 100644
index 00000000..a25516ea
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionNormal.html
@@ -0,0 +1,89 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="boolean isEdit, LocalDate currentDate, boolean changeTypeInProgress, List<Category> categories, List<Account> accounts, Transaction transaction, String suggestionsJSON, List<Notification> notifications, Map<String, String> fieldErrors"
+      t:replace="~{helpers/header :: page('BudgetMaster - ' + (isEdit ? locale.getString('title.transaction.edit', locale.getString('title.transaction.new.normal')) : locale.getString('title.transaction.new', locale.getString('title.transaction.new.normal'))), ~{::head}, ~{::body})}">
+<head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+</head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('transactions')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="(isEdit ? locale.getString('title.transaction.edit', locale.getString('title.transaction.new.normal')) : locale.getString('title.transaction.new', locale.getString('title.transaction.new.normal')))"></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::transaction-content})}">
+                <transaction-content t:remove="tag">
+                    <div class="container">
+                        <form id="mainForm" name="NewTransaction" t:action="@{/transactions/newTransaction}" method="post">
+                            <!-- only set ID for transactions not templates, otherwise the input is filled with the template ID and saving the transaction
+                            may then override an existing transactions if the ID is also already used in transactions table -->
+                            <input type="hidden" name="ID" t:value="transaction.getID() != null ? fmt.c(transaction.getID()) : ''">
+                            <input type="hidden" name="isRepeating" t:value="transaction.isRepeating() ? 'true' : 'false'">
+
+                            <!--/* isPayment switch */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: isExpenditureSwitch(transaction)}"></t:block>
+
+                            <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.transaction.save'), 'fas fa-info', '')}"></t:block>
+
+                            <!--/* name */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(transaction, suggestionsJSON, fieldErrors)}"></t:block>
+
+                            <!--/* amount */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(transaction, fieldErrors)}"></t:block>
+
+                            <!--/* category */-->
+                            <t:block t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, transaction.getCategory(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.category'), 'transaction-category', true, '', false, '')}"></t:block>
+
+                            <!--/* date */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionStartDate(transaction, currentDate)}"></t:block>
+
+                            <!--/* description */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionDescription(transaction, fieldErrors)}"></t:block>
+
+                            <!--/* tags */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(transaction)}"></t:block>
+
+                            <!--/* account */-->
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('account-select-wrapper', 'account', accounts, transaction.getAccount() != null ? transaction.getAccount() : helpers.getCurrentAccountOrDefault(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.account'), 'transaction-account', false)}"></t:block>
+                            <!--/* repeating options */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionRepeating(transaction, currentDate, fieldErrors)}"></t:block>
+
+                            <!--/* buttons */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttons('/transactions', true, false)}"></t:block>
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttonTransactionActions(isEdit, true, changeTypeInProgress, transaction)}"></t:block>
+                        </form>
+
+                        <div id="saveAsTemplateModalContainer"></div>
+
+                        <div id="changeTransactionTypeModalContainer"></div>
+
+                        <div id="transactionNameKeywordWarningModalContainer"></div>
+                    </div>
+                </transaction-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization}"></t:block>
+
+        <script>
+            var createTemplateWithErrorInForm = [[${locale.getString('save.as.template.errorsInForm')}]];
+            var templateNameEmptyValidationMessage = [[${locale.getString('warning.empty.transaction.name')}]];
+            var templateNameDuplicateValidationMessage = [[${locale.getString('warning.duplicate.template.name')}]];
+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/transactionActions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+</body>
+</html>
