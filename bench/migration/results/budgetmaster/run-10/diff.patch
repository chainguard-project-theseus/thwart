+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.reports.settings.ReportSettings, de.deadlocker8.budgetmaster.filter.FilterConfiguration"
+      t:params="ReportSettings reportSettings, LocalDate currentDate, FilterConfiguration filterConfiguration, List<Notification> notifications"
+      t:replace="~{helpers/header :: page('BudgetMaster - ' + locale.getString('menu.reports'), ~{::head}, ~{::body})}">
+<head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/reports.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/globalDatepicker.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+</head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('reports')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <t:block t:replace="~{helpers/globalDatePicker :: datePicker(currentDate, '/reports')}"></t:block>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::reports-content})}">
+                <reports-content t:remove="tag">
+                    <br>
+
+                    <div class="container">
+                    <form name="NewReportSettings" t:action="@{/reports/generate}" method="post" onsubmit="return validateForm()">
+                        <input type="hidden" name="ID" t:value="fmt.c(reportSettings.getID())"/>
+                        <input type="hidden" name="date" t:value="fmt.getLongDateString(currentDate)"/>
+
+                        <div class="row">
+                            <div class="col s12 center-align">
+                                <t:block t:replace="~{transactions/transactionsMacros :: buttonFilter(filterConfiguration.isActive())}"></t:block>
+                            </div>
+                        </div>
+
+                        <!--/* settings */-->
+                        <div class="row">
+                            <div class="col s12 center-align">
+                                <div class="headline-small text-default" t:text="locale.getString('report.settings')"></div>
+                            </div>
+                        </div>
+                        <div class="row">
+                            <div class="col s12 m8 offset-m2">
+                                <div class="report-checkbox-container">
+                                    <label>
+                                        <input type="checkbox" name="includeBudget" t:checked="reportSettings.isIncludeBudget()">
+                                        <span class="columnName-checkbox-label text-default" t:text="locale.getString('report.checkbox.include.budget')"></span>
+                                    </label>
+                                </div>
+                                <div class="report-checkbox-container">
+                                    <label>
+                                        <input type="checkbox" name="splitTables" t:checked="reportSettings.isSplitTables()">
+                                        <span class="columnName-checkbox-label text-default" t:text="locale.getString('report.checkbox.split.tables')"></span>
+                                    </label>
+                                </div>
+                                <div class="report-checkbox-container">
+                                    <label>
+                                        <input type="checkbox" name="includeCategoryBudgets" t:checked="reportSettings.isIncludeCategoryBudgets()"/>
+                                        <span class="columnName-checkbox-label text-default" t:text="locale.getString('report.checkbox.inclue.categorybudgets')"></span>
+                                    </label>
+                                </div>
+                            </div>
+                        </div>
+                        <br>
+
+                        <!--/* columns */-->
+                        <div class="row no-margin">
+                            <div class="col s12 center-align">
+                                <div class="headline-small text-default" t:text="locale.getString('report.columns')"></div>
+                                <br>
+                                <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.report.columns'), 'fas fa-info', '')}"></t:block>
+                            </div>
+                        </div>
+                        <div class="row">
+                            <div class="col s12 m8 offset-m2">
+                                <div id="columnNames">
+                                    <div t:each="column, columnStat : reportSettings.getColumnsSorted()" class="columnName">
+                                        <label>
+                                            <input type="checkbox" class="columnName-checkbox" t:data-index="columnStat.index" t:name="|columns['${columnStat.index}'].activated|" t:checked="column.isActivated()"/>
+                                            <span class="columnName-label" t:text="locale.getString(column.getLocalizationKey())"></span>
+                                        </label>
+                                        <input type="hidden" t:name="|columns['${columnStat.index}'].ID|" t:value="fmt.c(column.getID())"/>
+                                        <input type="hidden" t:name="|columns['${columnStat.index}'].localizationKey|" t:value="column.getLocalizationKey()"/>
+                                        <input type="hidden" t:name="|columns['${columnStat.index}'].columnPosition|" value=""/>
+                                    </div>
+                                </div>
+                            </div>
+                        </div>
+
+                        <!--/* button generate */-->
+                        <div class="row valign-wrapper">
+                            <div class="col s12 center-align">
+                                <button t:replace="~{helpers/header :: buttonSubmit(name='buttonSave', icon='save', localizationKey='report.button.generate', id='', color='background-blue', classes='', disabled=false, formaction='', value='', form='')}"></button>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+                </reports-content>
+                </t:block>
+            </div>
+
+            <t:block t:replace="~{filter/filterMacros :: filterModal(filterConfiguration)}"></t:block>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/sortablejs/Sortable.min.js}"></script>
+        <script t:src="@{/js/reports.js}"></script>
+        <script t:src="@{/js/globalDatePicker.js}"></script>
+        <script t:src="@{/js/filter.js}"></script>
+        <script>
+            var currentDateCookieValue = [[${fmt.getDateStringNormal(currentDate)}]];
+            document.cookie = "currentDate=" + currentDateCookieValue;
+        </script>
+</body>
+</html>
