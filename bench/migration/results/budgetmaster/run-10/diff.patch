diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/globalDatePicker.html b/BudgetMasterServer/src/main/resources/templates/helpers/globalDatePicker.html
new file mode 100644
index 00000000..7f93251f
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/globalDatePicker.html
@@ -0,0 +1,77 @@
+<t:block xmlns:t="https://tessera.dev">
+<!--/* Fragments of the old helpers/globalDatePicker.ftl.
+     datePicker: the old macro read the currentDate model attribute besides fullDate; every caller passes currentDate as fullDate, so fullDate is used. */-->
+<t:block t:fragment="datePicker(LocalDate fullDate, String target)">
+     <div class="container">
+         <div class="section center-align">
+             <a t:href="'/previousMonth?target=' + target" id="global-datepicker-previous-month" class="waves-effect text-default"><i class="material-icons icon-chevron">chevron_left</i></a>
+             <a href="#modalDate" class="waves-effect headline-date modal-trigger text-default datePicker-fixed-width" t:text="fmt.getDateStringWithMonthAndYear(fullDate)"></a>
+             <a t:href="'/nextMonth?target=' + target" id="global-datepicker-next-month" class="waves-effect text-default"><i class="material-icons icon-chevron">chevron_right</i></a>
+             <a t:href="'/today?target=' + target" id="global-datepicker-today" class="waves-effect text-default"><i class="material-icons icon-today">event</i></a>
+         </div>
+     </div>
+    <!-- modal to select specific month and year -->
+    <div id="modalDate" class="modal modal-fixed-footer">
+        <div class="modal-content background-color">
+
+            <div id="global-datepicker-select-year">
+                <t:block t:replace="~{helpers/globalDatePicker :: datepickerGridYear(fullDate.getYear() - 7, fullDate.getYear())}"></t:block>
+            </div>
+
+            <div id="global-datepicker-select-month">
+                <h4 t:text="locale.getString('title.datepicker.month')"></h4>
+                <t:block t:replace="~{helpers/globalDatePicker :: datepickerGrid(itemViews.monthNames(), itemViews.monthNames()[fullDate.getMonthValue() - 1])}"></t:block>
+            </div>
+        </div>
+        <div class="modal-footer background-color">
+            <a t:replace="~{helpers/header :: buttonLink(url='', icon='clear', localizationKey='cancel', id='', color='red', classes='modal-action modal-close text-white', noUrl=false, disabled=false, target='')}"></a>
+            <a t:replace="~{helpers/header :: buttonLink(url='/setDate?target=' + target, icon='done', localizationKey='ok', id='buttonChooseDate', color='green', classes='modal-action modal-close text-white', noUrl=false, disabled=false, target='')}"></a>
+        </div>
+    </div>
+
+    <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.globalDatePicker.hotkeys'), 'fas fa-info', '/hotkeys')}"></t:block>
+</t:block>
+
+<t:block t:fragment="datepickerGridYear(int startYear, int currentYear)">
+    <h4 t:text="locale.getString('title.datepicker.year')"></h4>
+
+    <div class="hidden" id="currentYear" t:text="currentYear"></div>
+
+    <div class="center-align">
+        <a class="waves-effect text-default global-datepicker-button" id="global-datepicker-previous"><i class="material-icons icon-chevron">chevron_left</i></a>
+        <a class="waves-effect text-default global-datepicker-button" id="global-datepicker-next"><i class="material-icons icon-chevron">chevron_right</i></a>
+    </div>
+
+    <t:block t:replace="~{helpers/globalDatePicker :: datepickerGrid(itemViews.years(startYear), '' + currentYear)}"></t:block>
+</t:block>
+
+<table t:fragment="datepickerGrid(List<String> items, String currentItem)" class="no-border-table global-datepicker-table"><tbody>
+    <tr t:each="row : itemViews.rows(items, 3)">
+        <td t:each="item : row" t:class="|global-datepicker-item ${item == currentItem ? 'global-datepicker-selected' : ''}|" t:text="item"></td>
+    </tr>
+</tbody></table>
+
+<!--/* localization for scripts */-->
+<!--/* The localized names as literals per language (as base_*.properties have them): a computed value in a script
+     would be written as a "var x = (...)" declaration */-->
+<t:block t:fragment="datePickerLocalization">
+    <script t:if="helpers.getSettings().getLanguage() == 'GERMAN'">
+        monthNames = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember', ];
+        monthNamesShort = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez', ];
+        weekDays = ['Sonntag', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', ];
+        weekDaysShort = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', ];
+        weekDaysLetters = ['S', 'M', 'D', 'M', 'D', 'F', 'S', ];
+        buttonCancel = 'Abbrechen';
+        buttonClose = 'OK';
+    </script>
+    <script t:unless="helpers.getSettings().getLanguage() == 'GERMAN'">
+        monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December', ];
+        monthNamesShort = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec', ];
+        weekDays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', ];
+        weekDaysShort = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', ];
+        weekDaysLetters = ['S', 'M', 'T', 'W', 'T', 'F', 'S', ];
+        buttonCancel = 'Cancel';
+        buttonClose = 'OK';
+    </script>
+</t:block>
+</t:block>
