+	public ResponseEntity<byte[]> getImageByID(@PathVariable("ID") Integer imageID)
+	{
+		final Optional<Image> imageOptional = imageService.getRepository().findById(imageID);
+		if(imageOptional.isEmpty())
+		{
+			throw new ResourceNotFoundException();
+		}
+
+		final Image image = imageOptional.get();
+
+		final HttpHeaders headers = new HttpHeaders();
+		headers.setContentType(image.getFileExtension().getMediaType());
+
+		final byte[] bytes = ArrayUtils.toPrimitive(image.getImage());
+		return new ResponseEntity<>(bytes, headers, HttpStatus.OK);
+	}
 }
