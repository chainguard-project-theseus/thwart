+                                                            <td class="quick-date" data-quick="9" t:text="locale.getString('chart.quick.last.month.days')"></td>
+                                                            <td class="quick-date" data-quick="10" t:text="locale.getString('chart.quick.last.year.days')"></td>
+                                                            <td class="quick-date" data-quick="11" t:text="locale.getString('chart.quick.until.today')"></td>
+                                                        </tr>
+                                                    </table>
+                                                </div>
