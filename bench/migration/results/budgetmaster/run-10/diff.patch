+
+                        <input type="hidden" name="clickedAmountType" value="">
+                        <input type="hidden" name="clickedCategory" value="">
+
+                        <!--/* buttons */-->
+                        <div class="row center-align">
+                            <div class="col s12">
+                                <button class="btn waves-effect waves-light background-blue" type="submit" name="buttonSave" disabled>
+                                    <i class="material-icons left">show_chart</i>[[${locale.getString('chart.show')}]]
+                                </button>
+                            </div>
+                        </div>
+                    </form>
+
+                    <br>
+
+                    <div t:class="chartSettings.isChartSelected() ? '' : 'hidden'">
+                        <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.charts.click'), 'fas fa-info', '/hotkeys')}"></t:block>
+                    </div>
+
+                    <div class="container-chart">
+                        <div t:if="containerID != null" t:id="containerID" class="chart-canvas"></div>
+                    </div>
+
+                    <div id="matchingTransactionsOverview"></div>
+                </charts-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization}"></t:block>
+        <script>
+            var filterActive = [[${locale.getString('filter.active')}]];
+            var filterNotActive = [[${locale.getString('title.filter')}]];
+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/libs/plotly.min.js}"></script>
+        <script t:src="@{/js/libs/moment.min.js}"></script>
+        <script t:src="@{/js/charts.js}"></script>
+        <script t:src="@{/js/filter.js}"></script>
+
+        <t:block t:if="chart != null">
+            <!--/* The chart's own script (user code for custom charts) is served by ChartController as /charts/{id}/script/{containerID},
+                 with "var transactionData = [];" replaced by "var transactionData = chartTransactionData;" and "containerID" by the id.
+                 The values it reads are declared here first. */-->
+            <script t:if="chart.getType() == 'DEFAULT'">
+                var localizedLocale = [[${locale.getString('locale')}]];
+                var localizedTitle = [[${locale.getString(chart.getName())}]];
+                var localizedDateRange = [[${dateRange}]];
+                var localizedCurrency = [[${helpers.getSettings().getCurrency()}]];
+                var localizedDataJson = [[${locale.getString(chart.getName() + '.localization')}]];
+                var chartTransactionDataJson = [[${transactionData}]];
+                localizedData = JSON.parse(localizedDataJson);
+                chartTransactionData = JSON.parse(chartTransactionDataJson);
+            </script>
+            <script t:unless="chart.getType() == 'DEFAULT'">
+                var localizedTitle = [[${chart.getName()}]];
+                var localizedDateRange = [[${dateRange}]];
+                var chartTransactionDataJson = [[${transactionData}]];
+                chartTransactionData = JSON.parse(chartTransactionDataJson);
+            </script>
+            <script t:src="@{/charts/{id}/script/{containerID}(id=chart.getID(), containerID=containerID)}"></script>
+        </t:block>
+</body>
+</html>
