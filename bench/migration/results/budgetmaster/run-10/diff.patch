+package de.deadlocker8.budgetmaster.viewsupport;
+
+import de.deadlocker8.budgetmaster.accounts.Account;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Texts of the account pages that the FreeMarker views wrote into {@code data-tooltip} attributes.
+ * A template can't write a String into a data-* attribute, so the pages put these texts in a JSON block
+ * and their script hands them to the Materialize tooltips.
+ */
+@TemplateFunctions("accountViews")
+public final class AccountViewFunctions
+{
+	private AccountViewFunctions()
+	{
+	}
+
+	/** The end date tooltip of the global account select (null if the account shows no bell). */
+	@TemplateFunction
+	public static String endDateTooltip(Account account)
+	{
+		if(account.getEndDate() == null)
+		{
+			return null;
+		}
+
+		final long remainingDays = account.getRemainingDays();
+		if(remainingDays <= 0)
+		{
+			return Localization.getString("account.tooltip.endDate.done", Math.abs(remainingDays));
+		}
+		if(remainingDays <= 30)
+		{
+			return Localization.getString("account.tooltip.endDate.soon", remainingDays);
+		}
+		return null;
+	}
+
+	/** {@link #endDateTooltip(Account)} of each account, by list index */
+	@TemplateFunction
+	public static List<String> endDateTooltips(List<Account> accounts)
+	{
+		final List<String> tooltips = new ArrayList<>();
+		for(Account account : accounts)
+		{
+			tooltips.add(endDateTooltip(account));
+		}
+		return tooltips;
+	}
+
+	/** whether one of the accounts shows an end date tooltip */
+	@TemplateFunction
+	public static boolean hasEndDateTooltip(List<Account> accounts)
+	{
+		return accounts.stream().anyMatch(account -> endDateTooltip(account) != null);
+	}
+}
