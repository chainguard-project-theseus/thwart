diff --git a/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html b/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html
new file mode 100644
index 00000000..436d7193
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html
@@ -0,0 +1,100 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account"
+      t:params="boolean isEdit, Template template, String suggestionsJSON, List<Category> categories, List<Account> accounts, List<Notification> notifications, Map<String, String> fieldErrors"
+      t:replace="~{helpers/header :: page('BudgetMaster - ' + (isEdit ? locale.getString('title.template.edit') : locale.getString('title.template.new')), ~{::head}, ~{::body})}">
+<head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+</head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="isEdit ? locale.getString('title.template.edit') : locale.getString('title.template.new')"></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::template-form})}">
+                <template-form t:remove="tag">
+                    <div class="container">
+                    <form id="mainForm" name="NewTemplate" t:action="@{/templates/newTemplate}" method="post">
+                        <input type="hidden" name="ID" t:value="template.getID() == null ? '' : fmt.c(template.getID())">
+                        <input type="hidden" name="templateGroup" t:value="template.getTemplateGroup() == null ? '' : fmt.c(template.getTemplateGroup().getID())">
+
+                        <!--/* isPayment switch */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: isExpenditureSwitch(template)}"></t:block>
+
+                        <!--/* template name */-->
+                        <t:block t:replace="~{templates/templateFunctions :: templateNameInput(template, fieldErrors)}"></t:block>
+
+                        <!--/* name */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(template, suggestionsJSON, fieldErrors)}"></t:block>
+
+                        <!--/* amount */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(template, fieldErrors)}"></t:block>
+
+                        <!--/* category */-->
+                        <t:block t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, template.getCategory(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.category'), 'transaction-category', true, '', false, '')}"></t:block>
+
+                        <!--/* description */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionDescription(template, fieldErrors)}"></t:block>
+
+                        <!--/* tags */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(template)}"></t:block>
+
+                        <!--/* account */-->
+                        <t:block t:if="template.getAccount() != null">
+                            <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-account', 'includeAccount', locale.getString('template.checkbox.include.account'), true)}"></t:block>
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('account-select-wrapper', 'account', accounts, template.getAccount(), 'col s12 m12 l8 offset-l2', '', 'transaction-account', false)}"></t:block>
+                        </t:block>
+                        <t:block t:if="template.getAccount() == null">
+                            <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-account', 'includeAccount', locale.getString('template.checkbox.include.account'), false)}"></t:block>
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('account-select-wrapper', 'account', accounts, helpers.getCurrentAccountOrDefault(), 'col s12 m12 l8 offset-l2', '', 'transaction-account', true)}"></t:block>
+                        </t:block>
+
+                        <!--/* transfer account */-->
+                        <t:block t:if="template.getTransferAccount() != null">
+                            <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-transfer-account', 'includeTransferAccount', locale.getString('template.checkbox.include.account.transfer'), true)}"></t:block>
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, template.getTransferAccount(), 'col s12 m12 l8 offset-l2', '', 'transaction-destination-account', false)}"></t:block>
+                        </t:block>
+                        <t:block t:if="template.getTransferAccount() == null">
+                            <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-transfer-account', 'includeTransferAccount', locale.getString('template.checkbox.include.account.transfer'), false)}"></t:block>
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, helpers.getCurrentAccountOrDefault(), 'col s12 m12 l8 offset-l2', '', 'transaction-destination-account', true)}"></t:block>
+                        </t:block>
+
+                        <!--/* icon */-->
+                        <t:block t:replace="~{helpers/iconSelect :: iconSelect('template-icon', template, false, '', '', true)}"></t:block>
+
+                        <!--/* font color */-->
+                        <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(template)}"></t:block>
+
+                        <!--/* buttons */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: buttons('/templates', false, true)}"></t:block>
+                    </form>
+
+                    <div id="transactionNameKeywordWarningModalContainer"></div>
+                </div>
+                </template-form>
+                </t:block>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/iconSelect :: modalIconSelect('template-name', template)}"></t:block>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization}"></t:block>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+</body>
+</html>
