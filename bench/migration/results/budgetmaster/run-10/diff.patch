+
+/**
+ * Values the icon select, font color picker and global date picker macros read from the model or
+ * through methods with arguments ({@code item.getFontColor(settings.isUseDarkTheme())}).
+ */
+@TemplateFunctions("itemViews")
+public final class ItemViewFunctions
+{
+	private ItemViewFunctions()
+	{
+	}
+
+	/** {@code item.getFontColor(settings.isUseDarkTheme())} */
+	@TemplateFunction
+	public static String fontColor(Iconizable item)
+	{
+		return item.getFontColor(ViewServices.helpers().getSettings().isUseDarkTheme());
+	}
+
+	/** {@code item.getDefaultFontColor(settings.isUseDarkTheme())} */
+	@TemplateFunction
+	public static String defaultFontColor(Iconizable item)
+	{
+		return item.getDefaultFontColor(ViewServices.helpers().getSettings().isUseDarkTheme());
+	}
+
+	/** {@code item.getName()} of an account, category or template */
+	@TemplateFunction
+	public static String name(Iconizable item)
+	{
+		if(item instanceof Account account)
+		{
+			return account.getName();
+		}
+		if(item instanceof Category category)
+		{
+			return category.getName();
+		}
+		if(item instanceof Template template)
+		{
+			return template.getName();
+		}
+		return null;
+	}
+
+	/** {@code item.getColor()} of a category ({@code null} for other items) */
+	@TemplateFunction
+	public static String color(Iconizable item)
+	{
+		if(item instanceof Category category)
+		{
+			return category.getColor();
+		}
+		return null;
+	}
+
+	/** the {@code fontawesomeIcons} model attribute */
+	@TemplateFunction
+	public static List<String> fontawesomeIcons()
+	{
+		return FontAwesomeIcons.ICONS;
+	}
+
+	/** the {@code localizedMonthNames} model attribute (CalendarAdvice) */
+	@TemplateFunction
+	public static List<String> monthNames()
+	{
+		return MonthNames.getLocalizedStrings();
+	}
+
+	/** the first {@code length} characters of each string ({@code name[0..length-1]} in FreeMarker) */
+	@TemplateFunction
+	public static List<String> prefixes(List<String> names, int length)
+	{
+		return names.stream().map(name -> name.substring(0, Math.min(length, name.length()))).toList();
+	}
+
+	/** the {@code localizedWeekdays} model attribute (CalendarAdvice) */
+	@TemplateFunction
+	public static List<String> weekDays()
+	{
+		return WeekDay.getLocalizedStrings();
+	}
+
+	/** {@code startYear..startYear + 11} as strings ({@code ?c}) */
+	@TemplateFunction
+	public static List<String> years(int startYear)
+	{
+		final List<String> years = new ArrayList<>();
+		for(int i = startYear; i <= startYear + 11; i++)
+		{
+			years.add(String.valueOf(i));
+		}
+		return years;
+	}
+
+	/** the items in rows of {@code size} (the global date picker grid, the category colors) */
+	@TemplateFunction
+	public static List<List<String>> rows(List<String> items, int size)
+	{
+		final List<List<String>> rows = new ArrayList<>();
+		for(int i = 0; i < items.size(); i += size)
+		{
+			rows.add(items.subList(i, Math.min(i + size, items.size())));
+		}
+		return rows;
+	}
+}
