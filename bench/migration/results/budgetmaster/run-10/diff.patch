+                    </div>
+                </a>
+                <a t:replace="~{helpers/header :: buttonFlat(url='', icon='delete', localizationKey='', id='', classes='no-padding text-default button-remove-icon-from-item', noUrl=true, iconClasses='', target='', datasetIndex=null)}"></a>
