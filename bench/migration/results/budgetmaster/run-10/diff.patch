@@ -0,0 +1,59 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.hotkeys.*"
+      t:params="GeneralHotKey[] hotkeysGeneral, GlobalDatePickerHotKey[] hotkeysGlobalDatePicker, GlobalAccountSelectHotKey[] hotkeysAccountSelect, ChartHotkeys[] hotkeysCharts, List<Notification> notifications"
+      t:replace="~{helpers/header :: page('BudgetMaster - ' + locale.getString('menu.hotkeys'), ~{::head}, ~{::body})}">
+<head t:remove="tag">
+</head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('hotkeys')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">keyboard</i> [[${locale.getString('menu.hotkeys')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::hotkeys-content})}">
+                <hotkeys-content t:remove="tag">
+                    <br>
+
+                    <t:block t:replace="~{hotkeys :: listHotKeys(locale.getString('hotkeys.general'), hotkeysGeneral)}"></t:block>
+
+                    <t:block t:replace="~{hotkeys :: listHotKeys(locale.getString('hotkeys.global.datepicker'), hotkeysGlobalDatePicker)}"></t:block>
+
+                    <t:block t:replace="~{hotkeys :: listHotKeys(locale.getString('hotkeys.global.account.select'), hotkeysAccountSelect)}"></t:block>
+
+                    <t:block t:replace="~{hotkeys :: listHotKeys(locale.getString('hotkeys.charts'), hotkeysCharts)}"></t:block>
+                </hotkeys-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+</body>
+
+<div t:fragment="cellKey(String key)" class="col s4 m3 offset-m2 l2 offset-l3 right-align bold">
+    <div class="keyboard-key" t:text="key"></div>
+</div>
+
+<div t:fragment="cellKeyWithModifier(String modifier, String key)" class="col s4 m3 offset-m2 l2 offset-l3 right-align bold">
+    <t:block t:if="modifier != null && !modifier.isEmpty()">
+        <div class="keyboard-key modifier-key" t:text="modifier"></div>
+        <span class="bold">+</span>
+    </t:block>
+    <div class="keyboard-key" t:text="key"></div>
+</div>
+
+<t:block t:fragment="listHotKeys(String headline, HotKey[] hotKeys)">
+    <div class="row">
+        <div class="col s12 headline center-align" t:text="headline"></div>
+    </div>
+
+    <div t:each="hotKey : hotKeys" class="row">
+        <div t:replace="~{hotkeys :: cellKeyWithModifier(hotKey.getModifierLocalized() ?: '', hotKey.getKeyLocalized())}"></div>
+        <div class="col s8 m5 l5" t:text="hotKey.getTextLocalized()"></div>
+    </div>
+</t:block>
+</html>
