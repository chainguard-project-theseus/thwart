+                                                            <td class="quick-date" data-quick="2" t:text="locale.getString('chart.quick.this.year')"></td>
+                                                            <td class="quick-date" data-quick="3" t:text="locale.getString('chart.quick.all')"></td>
+                                                        </tr>
+                                                        <tr>
+                                                            <td class="quick-date" data-quick="4" t:text="locale.getString('chart.quick.last.week')"></td>
+                                                            <td class="quick-date" data-quick="5" t:text="locale.getString('chart.quick.last.month')"></td>
+                                                            <td class="quick-date" data-quick="6" t:text="locale.getString('chart.quick.last.year')"></td>
+                                                            <td class="quick-date" data-quick="7" t:text="locale.getString('chart.quick.until.endOfLastYear')"></td>
+                                                        </tr>
