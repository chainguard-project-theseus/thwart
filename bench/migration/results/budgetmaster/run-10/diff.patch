+        <t:block t:replace="~{helpers/header :: hint(helpers.getHintByLocalizationKey('hint.globalAccountSelect.hotkeys'), 'fas fa-info', '')}"></t:block>
+
+        <div class="row">
+            <div t:each="account, accountStat : accounts" class="col s12 m6 xl6" t:with="accountName=helpers.accountName(account), accountBudget=helpers.getAccountBudgetByID(account.getID()), remainingDays=account.getRemainingDays()">
+                <a t:href="@{/accounts/{id}/select(id=account.getID())}" class="text-default">
+                    <div class="card-panel global-account-select-option" t:data-account-index="accountStat.index">
+                        <div class="global-account-select-option-header">
+                            <div t:if="accountStat.index < 10" class="keyboard-key bold global-account-select-option-key" t:text="accountStat.index"></div>
+                            <div t:unless="accountStat.index < 10" class="keyboard-key bold global-account-select-option-key-hidden">&nbsp;</div>
+
+                            <t:block t:if="remainingDays != null">
+                                <i t:if="remainingDays <= 0" class="fas fa-bell text-red tooltipped" data-position="right" t:data-tooltip-index="accountStat.index"></i>
+                                <i t:if="remainingDays > 0 && remainingDays <= 30" class="fas fa-bell text-yellow tooltipped" data-position="right" t:data-tooltip-index="accountStat.index"></i>
+                            </t:block>
+
+                        </div>
+                        <div class="global-account-select-option-content">
+                            <div t:replace="~{helpers/customSelectMacros :: accountIcon(account, accountName, 'category-circle-preview account-icon-big', false)}"></div>
+                            <div class="global-account-select-option-column-2">
+                                <div class="global-account-select-option-name truncate" t:text="accountName"></div>
+                                <div t:if="accountBudget <= 0" t:class="|global-account-select-option-balance ${helpers.redTextColor()}|" t:text="fmt.getCurrencyString(accountBudget)"></div>
+                                <div t:unless="accountBudget <= 0" t:class="|global-account-select-option-balance ${helpers.greenTextColor()}|" t:text="fmt.getCurrencyString(accountBudget)"></div>
+                            </div>
+                        </div>
+                    </div>
+                </a>
+            </div>
+        </div>
+        <!--/* the end date tooltips (a String can't go into data-tooltip): main.js initializes the tooltips after this script ran */-->
+        <t:block t:if="accountViews.hasEndDateTooltip(accounts)">
+        <script type="application/json" id="global-account-select-tooltips">[[${accountViews.endDateTooltips(accounts)}]]</script>
+        <script>
+            (function()
+            {
+                const tooltips = JSON.parse(document.getElementById('global-account-select-tooltips').textContent);
+                document.querySelectorAll('#modalGlobalAccountSelect .tooltipped[data-tooltip-index]').forEach(function(element)
+                {
+                    const text = document.createElement('div');
+                    text.textContent = tooltips[element.dataset.tooltipIndex];
+                    element.dataset.tooltip = text.innerHTML;
+                });
+            })();
+        </script>
+        </t:block>
+    </div>
+    <div class="modal-footer background-color-light">
+        <a t:replace="~{helpers/header :: buttonLink(url='', icon='clear', localizationKey='cancel', id='buttonCloseGlobalAccountSelect', color='red', classes='modal-action modal-close text-white', noUrl=true, disabled=false, target='')}"></a>
+    </div>
+</div>
