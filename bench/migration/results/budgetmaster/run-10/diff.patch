+                            <a t:href="@{/transactionImport/{i}/newTransaction/normal(i=index)}" class="btn-floating btn background-orange"><i class="material-icons">payment</i></a>
+                        </li>
+                        <li>
+                            <a t:href="@{/transactionImport/{i}/newTransaction/transfer(i=index)}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="locale.getString('title.transaction.new', locale.getString('title.transaction.new.transfer'))"></a>
+                            <a t:href="@{/transactionImport/{i}/newTransaction/transfer(i=index)}" class="btn-floating btn background-green-dark"><i class="material-icons">swap_horiz</i></a>
+                        </li>
+                        <li>
+                            <a t:href="@{/transactionImport/{i}/newFromTemplate(i=index)}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="locale.getString('title.transaction.new', locale.getString('title.transaction.new.from.template'))"></a>
+                            <a t:href="@{/transactionImport/{i}/newFromTemplate(i=index)}" class="btn-floating btn background-blue-baby"><i class="material-icons">file_copy</i></a>
+                        </li>
+                    </ul>
+                </div>
+                <a id="" t:data-index="index" class="waves-effect waves-light btn-flat no-padding text-default button-request-transaction-import-skip" t:data-url="@{/transactionImport/{i}/skip(i=index)}">
+                    <i class="material-icons left no-margin ">do_not_disturb_on</i>
+                </a>
+            </t:block>
+        </td>
+</tr>
+</tbody></table>
+
+<div t:fragment="showColumnSettingsErrors(List<String> errorsColumnSettings)" t:if="errorsColumnSettings != null && !errorsColumnSettings.isEmpty()" class="container" id="parseErrors">
+    <div class="row">
+        <div class="col s12">
+            <ul class="collapsible">
+                <li>
+                    <div class="collapsible-header bold">
+                        <i class="fas fa-exclamation-triangle text-red"></i>
+                        [[${locale.getString('info.database.import.result.errors')}]]
+                    </div>
+                    <div class="collapsible-body">
+                        <table class="bordered"><tbody>
+                            <tr t:each="error : errorsColumnSettings">
+                                <td><i class="fas fa-exclamation-triangle text-red"></i></td>
+                                <td t:text="error"></td>
+                            </tr>
+                        </tbody></table>
+                    </div>
+                </li>
+            </ul>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="statusBanner(CsvTransactionStatus status)"
+     t:class="|banner ${status == 'PENDING' ? 'background-blue text-white' : (status == 'IMPORTED' ? 'background-green text-white' : (helpers.getSettings().isUseDarkTheme() ? 'background-grey text-black' : 'background-grey text-white'))}|"
+     t:text="locale.getString(status.getLocalizationKey())"></div>
+</html>
