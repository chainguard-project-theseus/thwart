diff --git a/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html b/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html
new file mode 100644
index 00000000..510464f9
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html
@@ -0,0 +1,49 @@
+<t:block xmlns:t="https://tessera.dev">
+<!--/* Fragments of the old charts/chartFunctions.ftl; getChartName(chart) is chartViews.chartName(chart) */-->
+
+<!--/* infoMessage text: the text (a bundle message, one with a link) is passed as content */-->
+<div t:fragment="infoMessage(Fragment content)" class="row no-margin-bottom">
+    <div class="col s12 center-align">
+        <table class="text-default login-message no-border-table">
+            <tr>
+                <td><i class="material-icons">info</i></td>
+                <td><t:block t:replace="content"></t:block></td>
+            </tr>
+        </table>
+    </div>
+</div>
+
+<a t:fragment="buttonNew" t:replace="~{helpers/header :: buttonLink(url='/charts/newChart', icon='add', localizationKey='title.chart.new', id='', color='background-blue', classes='', noUrl=false, disabled=false, target='')}"></a>
+
+<a t:fragment="buttonShow" t:replace="~{helpers/header :: buttonLink(url='/charts', icon='show_chart', localizationKey='home.menu.charts.action.show', id='', color='background-blue', classes='', noUrl=false, disabled=false, target='')}"></a>
+
+<t:block t:fragment="buttons">
+    <div class="row hide-on-small-only valign-wrapper">
+        <div class="col s6 right-align">
+            <a t:replace="~{charts/chartFunctions :: buttonNew}"></a>
+        </div>
+        <div class="col s6 left-align">
+            <a t:replace="~{charts/chartFunctions :: buttonShow}"></a>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up center-align">
+        <div class="row center-align">
+            <div class="row center-align">
+                <div class="col s12">
+                    <a t:replace="~{charts/chartFunctions :: buttonShow}"></a>
+                </div>
+            </div>
+            <div class="col s12">
+                <a t:replace="~{charts/chartFunctions :: buttonNew}"></a>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!--/* iconForItem item: item was a ChartDisplayType or a ChartGroupType; pass item.getIcon(), chartViews.hasFontAwesomeIcon(item), item.getLocalizationKey() */-->
+<t:block t:fragment="iconForItem(String icon, boolean fontAwesome, String localizationKey)">
+    <t:block t:if="fontAwesome"><i t:class="|${icon} left|"></i> [[${locale.getString(localizationKey)}]]</t:block>
+    <t:block t:unless="fontAwesome"><i class="material-icons left" t:text="icon"></i> [[${locale.getString(localizationKey)}]]</t:block>
+</t:block>
+</t:block>
