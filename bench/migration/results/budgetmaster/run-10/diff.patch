+                        <div class="switch-cell-margin">
+                            <a class="btn btn-flat tooltipped text-default" data-position="bottom" t:data-tooltip="helpers.getSettings().getLanguage() == 'GERMAN' ? 'Zeigt den Saldo des letzten Monats und des aktuellen Monatsendes in der Buchungsübersicht an' : 'Show the balance of the last month and of the current month end in the transaction overview'"><i class="material-icons">help_outline</i></a>
+                        </div>
+                        <div class="switch-cell-margin">
+                            <a class="btn btn-flat tooltipped text-default" data-position="bottom" t:data-tooltip="helpers.getSettings().getLanguage() == 'GERMAN' ? 'Legt die Sortierung von Namensvorschlägen für Buchungen fest' : 'Defines how the transaction name suggestions are ordered.'"><i class="material-icons">help_outline</i></a>
+                        </div>
