+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.transactions.csvimport.*, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="CsvImportSettings csvImportSettings, List<Category> categories, String suggestionsJSON, String csvFileName, List<CsvRow> csvRows, List<CsvTransaction> csvTransactions, List<String> errorsColumnSettings, List<Notification> notifications, Map<String, String> fieldErrors"
+      t:replace="~{helpers/header :: page('BudgetMaster - ' + locale.getString('menu.transactions.import'), ~{::head}, ~{::body})}">
+<head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/transactionImport.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+    <link rel="stylesheet" t:href="@{/webjars/datatables/css/dataTables.dataTables.min.css}"/>
+</head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('importCSV')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="fas fa-file-csv"></i> [[${locale.getString('menu.transactions.import')}]]</div>
+                    </div>
+                </div>
+
+                <script>
+                    transactionNameSuggestions = {};
+                </script>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::import-content})}">
+                <import-content t:remove="tag">
+                    <div class="container">
+                        <t:block t:if="csvRows != null">
+                            <div class="row center-align">
+                                <div class="col s12 m12 l8 offset-l2 headline-small text-green truncate" id="csv-file-name">
+                                    <i class="fas fa-file-csv"></i> [[${csvFileName}]]
+                                </div>
+                            </div>
+
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <a t:replace="~{helpers/header :: buttonLink('/transactionImport/cancel', 'clear', 'cancel', 'button-cancel-csv-import', 'red', 'text-white', false, false, '')}"></a>
+                                </div>
+                            </div>
+                        </t:block>
+                        <t:block t:if="csvRows == null">
+                            <form t:replace="~{transactions/transactionImportMacros :: csvUpload(csvImportSettings, fieldErrors)}"></form>
+                        </t:block>
+                    </div>
+
+                    <t:block t:if="csvTransactions != null">
+                        <t:block t:replace="~{transactions/transactionImportMacros :: renderCsvTransactions(csvTransactions, categories, suggestionsJSON)}"></t:block>
+                        <t:block t:replace="~{transactions/transactionImportMacros :: showColumnSettingsErrors(errorsColumnSettings)}"></t:block>
+                    </t:block>
+                    <t:block t:if="csvTransactions == null && csvRows != null">
+                        <div class="container">
+                            <div class="section center-align">
+                                <div class="headline-small" t:text="locale.getString('transactions.import.matchColumns')"></div>
+                            </div>
+                        </div>
+                        <t:block t:replace="~{transactions/transactionImportMacros :: columnSettings(csvRows, csvImportSettings, fieldErrors)}"></t:block>
+                        <t:block t:replace="~{transactions/transactionImportMacros :: renderCsvRows(csvRows)}"></t:block>
+                    </t:block>
+                </import-content>
+                </t:block>
+            </div>
+        </main>
+
+        <script>
+            var localizedSearch = [[${locale.getString('search')}]];
+        </script>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/datatables/js/dataTables.min.js}"></script>
+        <script t:src="@{/js/transactionImport.js}"></script>
+</body>
+</html>
