diff --git a/BudgetMasterServer/src/main/resources/templates/transactions/transactions.html b/BudgetMasterServer/src/main/resources/templates/transactions/transactions.html
new file mode 100644
index 00000000..8b2ff7fb
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/transactions.html
@@ -0,0 +1,108 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.reports.Budget, de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.filter.FilterConfiguration, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="Account account, Budget budget, LocalDate currentDate, List<Transaction> transactions, FilterConfiguration filterConfiguration, Integer highlightID, List<Notification> notifications"
+      t:replace="~{helpers/header :: page('BudgetMaster - ' + locale.getString('menu.transactions'), ~{::head}, ~{::body})}">
+<head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/globalDatepicker.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+</head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('transactions')}"></t:block>
+
+        <main t:with="groups=${transactionViews.groupByDate(transactions)}">
+            <div class="card main-card background-color">
+                <t:block t:replace="~{helpers/globalDatePicker :: datePicker(currentDate, '/transactions')}"></t:block>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::transactions-content})}">
+                <transactions-content t:remove="tag">
+                    <div class="container transaction-container">
+                        <div class="row">
+                            <div class="col s4">
+                                <div class="icon-block center-align">
+                                    <img class="budget-headline-icon" t:src="@{/images/piggy_income.svg}">
+                                    <h5 class="budget" t:text="fmt.getCurrencyString(budget.incomeSum())"></h5>
+                                </div>
+                            </div>
+                            <div class="col s4">
+                                <div class="icon-block center-align">
+                                    <img class="budget-headline-icon" t:src="@{/images/piggy_expenditure.svg}">
+                                    <h5 class="center budget" t:text="fmt.getCurrencyString(budget.expenditureSum())"></h5>
+                                </div>
+                            </div>
+                            <div class="col s4">
+                                <div class="icon-block center-align">
+                                    <img class="budget-headline-icon" t:src="@{/images/piggy_rest.svg}">
+                                    <h5 class="center budget" t:text="fmt.getCurrencyString(budget.getRest())"></h5>
+                                </div>
+                            </div>
+                        </div>
+
+                        <!--/* buttons */-->
+                        <t:block t:replace="~{transactions/transactionsMacros :: buttons(filterConfiguration.isActive())}"></t:block>
+
+                        <!--/* transactions list, grouped by date. The old page left the last group open, so the placeholder
+                             (and, below, the modals) ended up inside it: kept that way for an identical DOM */-->
+                        <div t:each="group, groupStat : groups" class="transaction-date-group">
+                            <div class="col s12 center-align bold transaction-text transaction-date" t:text="group.date()"></div>
+
+                            <t:block t:each="transaction : group.transactions()">
+                            <t:block t:with="shouldHighlight=${highlightID != null && transaction.getID() != null && transaction.getID() == highlightID}">
+                            <div t:class="|hide-on-large-only transaction-row-top card transaction-card background-light ${transaction.isFuture() ? 'transaction-row-transparent' : ''} ${shouldHighlight ? 'transaction-row-highlighted' : ''}|" t:id="shouldHighlight ? 'highlighted-small'">
+                                <div class="row valign-wrapper transaction-row-bottom no-margin-bottom">
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 's6')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(transaction, account, 's6')}"></t:block>
+                                </div>
+                                <div class="row valign-wrapper transaction-row-bottom">
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'left-align no-margin-left')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction)}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 's2')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionButtons(transaction, 's6 right-align')}"></t:block>
+                                </div>
+                            </div>
+
+                            <div t:class="|hide-on-med-and-down transaction-row-top card transaction-card transaction-row-bottom background-light ${transaction.isFuture() ? 'transaction-row-transparent' : ''} ${shouldHighlight ? 'transaction-row-highlighted' : ''}|" t:id="shouldHighlight ? 'highlighted-large'">
+                                <div class="row valign-wrapper no-margin-bottom transaction-row-desktop">
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'left-align')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction)}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 'l1 xl1')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 'l4 xl5')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(transaction, account, 'l3 xl3 center-align')}"></t:block>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionButtons(transaction, 'l2 xl1')}"></t:block>
+                                </div>
+                            </div>
+                            </t:block>
+                            </t:block>
+
+                            <t:block t:if="groupStat.last"><t:block t:replace="~{transactions/transactionsMacros :: placeholder(transactions)}"></t:block></t:block>
+                        </div>
+
+                        <!--/* show placeholder text if no transactions are present in the current month or REST is the only transaction */-->
+                        <t:block t:if="groups.isEmpty()">
+                            <t:block t:replace="~{transactions/transactionsMacros :: placeholder(transactions)}"></t:block>
+                        </t:block>
+                    </div>
+                </transactions-content>
+                </t:block>
+
+                <t:block t:if="!groups.isEmpty()">
+                    <div id="deleteModalContainerOnDemand"></div>
+                    <t:block t:replace="~{filter/filterMacros :: filterModal(filterConfiguration)}"></t:block>
+                </t:block>
+            </div>
+
+            <t:block t:if="groups.isEmpty()">
+                <div id="deleteModalContainerOnDemand"></div>
+                <t:block t:replace="~{filter/filterMacros :: filterModal(filterConfiguration)}"></t:block>
+            </t:block>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/globalDatePicker.js}"></script>
+        <script t:src="@{/js/filter.js}"></script>
+        <script>var currentDateCookie = [[${'currentDate=' + fmt.getDateStringNormal(currentDate)}]];
+            document.cookie = currentDateCookie;</script>
+</body>
+</html>
