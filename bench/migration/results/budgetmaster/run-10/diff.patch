+
+                                            <script>
+                                                startDate = document.getElementById("chart-datepicker").value.split(".");
+                                                startDate = new Date(startDate[2], startDate[1] - 1, startDate[0]);
+                                                endDate = document.getElementById("chart-datepicker-end").value.split(".");
+                                                endDate = new Date(endDate[2], endDate[1] - 1, endDate[0]);
