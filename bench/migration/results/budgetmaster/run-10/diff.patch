+package de.deadlocker8.budgetmaster.viewsupport;
+
+import de.deadlocker8.budgetmaster.transactions.keywords.TransactionNameKeyword;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import jakarta.servlet.http.HttpServletRequest;
+import org.springframework.security.web.csrf.CsrfToken;
+import org.springframework.web.context.request.RequestContextHolder;
+import org.springframework.web.context.request.ServletRequestAttributes;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Values the settings pages (settings/*) need that FreeMarker read from globals or printed into scripts and data-* attributes.
+ */
+@TemplateFunctions("settingsViews")
+public final class SettingsViewFunctions
+{
+	private SettingsViewFunctions()
+	{
+	}
+
+	/**
+	 * The CSRF token of the current request. The settings container forms write their own token input with id="token"
+	 * (as the FreeMarker pages did), because settingsBackup's script reads it by id for an AJAX request.
+	 */
+	@TemplateFunction
+	public static String csrfToken()
+	{
+		if(RequestContextHolder.getRequestAttributes() instanceof ServletRequestAttributes attributes)
+		{
+			final HttpServletRequest request = attributes.getRequest();
+			if(request.getAttribute(CsrfToken.class.getName()) instanceof CsrfToken token)
+			{
+				return token.getToken();
+			}
+		}
+		return "";
+	}
+
+	@TemplateFunction
+	public static List<Map<String, String>> keywordChips(List<TransactionNameKeyword> keywords)
+	{
+		final List<Map<String, String>> chips = new ArrayList<>();
+		for(TransactionNameKeyword keyword : keywords)
+		{
+			chips.add(Map.of("tag", keyword.getValue()));
+		}
+		return chips;
+	}
+}
