+    <div class="row">
+        <div class="col s12 center-align" id="numberOfIcons"><span id="numberOfMatchingIcons" t:text="itemViews.fontawesomeIcons().size()"></span>/[[${itemViews.fontawesomeIcons().size()}]] [[${locale.getString('icons.numberOf')}]]</div>
+    </div>
+
+    <hr>
+
+    <div class="row">
