+    </div>
+</div>
+
+<t:block t:fragment="repeatingEndDate(boolean checked, Transaction transaction, LocalDate currentDate)">
+<t:block t:with="endDate=${transactionViews.repeatingEndDate(checked, transaction, currentDate)}">
+    <script>
+        var endDate = [[${endDate}]];
+        endDate = endDate.split(".");
+        endDate = new Date(endDate[2], endDate[1]-1, endDate[0]);
+    </script>
+
+    <div class="row valign-wrapper">
+        <div class="col s1">
+            <label>
+                <input class="with-gap" name="repeatingEndType" type="radio" id="repeating-end-date" t:value="locale.getString('repeating.end.key.date')" t:checked="checked"/>
+                <span for="repeating-end-date"></span>
+            </label>
+        </div>
+        <div class="col s11">
+            <table class="table-repeating-end no-border-table">
+                <tr>
+                    <td class="cell" t:text="locale.getString('repeating.end.date')"></td>
+                    <td class="cell input-cell">
+                        <div class="input-field no-margin">
+                            <input t:class="|datepicker${helpers.isUseSimpleDatepickerForTransactions() ? '-simple' : ''} no-margin input-min-width|" id="transaction-repeating-end-date-input" type="text" t:value="endDate">
+                            <label for="transaction-repeating-end-date-input"></label>
+                        </div>
+                    </td>
+                    <td class="cell stretched-cell"></td>
+                </tr>
+            </table>
+        </div>
+    </div>
+</t:block>
+</t:block>
+
+<t:block t:fragment="buttons(String cancelURL, boolean includeContinueButton, boolean allowEmptyAmount)">
+    <div id="keywordCheckUrl" class="hidden" t:data-url="@{/keywords/keywordCheck}"></div>
+
+    <br>
+    <hr>
+    <br>
+
+    <div class="row hide-on-small-only">
+        <div class="col s12 center-align">
+            <t:block t:replace="~{transactions/newTransactionMacros :: buttonCancel(cancelURL)}"></t:block>&nbsp;
+            <t:block t:if="includeContinueButton"><t:block t:replace="~{transactions/newTransactionMacros :: buttonSaveAndContinue}"></t:block>&nbsp;</t:block>
+            <t:block t:replace="~{transactions/newTransactionMacros :: buttonSave(allowEmptyAmount)}"></t:block>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up">
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{transactions/newTransactionMacros :: buttonCancel(cancelURL)}"></t:block>
+            </div>
+        </div>
+        <div t:if="includeContinueButton" class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{transactions/newTransactionMacros :: buttonSaveAndContinue}"></t:block>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{transactions/newTransactionMacros :: buttonSave(allowEmptyAmount)}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!--/* The old macro read the currentCsvTransaction session attribute: transactionViews.isCsvImportActive() */-->
+<a t:fragment="buttonCancel(String cancelURL)"
+   t:replace="~{helpers/header :: buttonLink(transactionViews.isCsvImportActive() ? '/transactionImport' : cancelURL, 'clear', 'cancel', 'button-cancel-save-transaction', 'red', '', false, false, '')}"></a>
+
+<!--/* Written out instead of header :: buttonSubmit, which can't take an onclick (computed on* attributes don't compile). */-->
+<t:block t:fragment="buttonSave(boolean allowEmptyAmount)">
+    <button t:if="allowEmptyAmount" id="button-save-transaction" class="btn waves-effect waves-light green " type="submit" name="action" onclick="return validateForm(false, true, false)">
+        <i class="material-icons left ">save</i>[[${locale.getString('save')}]]
+    </button>
+    <button t:unless="allowEmptyAmount" id="button-save-transaction" class="btn waves-effect waves-light green " type="submit" name="action" onclick="return validateForm(false, false, false)">
+        <i class="material-icons left ">save</i>[[${locale.getString('save')}]]
+    </button>
+</t:block>
+
+<button t:fragment="buttonSaveAndContinue" id="button-save-transaction-and-continue" class="btn waves-effect waves-light background-blue " type="submit" name="action" value="continue" onclick="return validateForm(true, false, false)">
+    <i class="material-icons left ">save</i>[[${locale.getString('saveAndContinue')}]]
+</button>
+
+<!--/* The old macro read the page's transaction variable; it is a parameter now. */-->
+<t:block t:fragment="buttonTransactionActions(boolean canChangeType, boolean canCreateTemplate, boolean changeTypeInProgress, Transaction transaction)">
+    <div t:if="(canChangeType || canCreateTemplate) && !changeTypeInProgress" class="fixed-action-btn" id="transaction-actions-button">
+        <a class="btn-floating btn-large waves-effect waves-light background-blue">
+            <i class="material-icons left">settings</i>[[${locale.getString('save')}]]
+        </a>
+        <ul>
+            <li t:if="canChangeType">
+                <a class="btn-floating btn transaction-action mobile-fab-tip no-wrap" data-action-type="changeType" t:data-url="@{/transactions/{id}/changeTypeModal(id=transaction.getID())}" t:text="locale.getString('transaction.change.type')"></a>
+                <a class="btn-floating btn transaction-action background-blue-baby" data-action-type="changeType" t:data-url="@{/transactions/{id}/changeTypeModal(id=transaction.getID())}"><i class="material-icons">shuffle</i></a>
+            </li>
+            <li t:if="canCreateTemplate">
+                <a class="btn-floating btn transaction-action mobile-fab-tip no-wrap" data-action-type="saveAsTemplate" t:data-url="@{/templates/fromTransactionModal}" t:text="locale.getString('save.as.template')"></a>
+                <a class="btn-floating btn transaction-action background-orange-dark" data-action-type="saveAsTemplate" t:data-url="@{/templates/fromTransactionModal}"><i class="material-icons">file_copy</i></a>
+            </li>
+        </ul>
+    </div>
+</t:block>
+</html>
