diff --git a/BudgetMasterServer/src/main/resources/templates/charts/manage.html b/BudgetMasterServer/src/main/resources/templates/charts/manage.html
new file mode 100644
index 00000000..ff415469
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/charts/manage.html
@@ -0,0 +1,86 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.charts.Chart, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications, List<Chart> customCharts, List<Chart> defaultCharts"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + loc.get('menu.charts'), ~{::page-head}, ~{::body})}">
+<page-head t:remove="tag"><link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/></page-head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('charts')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="loc.get('menu.charts')">Charts</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <br>
+                    <t:block t:replace="~{charts/chartFunctions :: buttons}"></t:block>
+                    <br>
+                    <div class="container">
+                        <div class="section center-align">
+                            <div class="headline-small" t:text="loc.get('charts.custom')">custom</div>
+                        </div>
+
+                        <table class="bordered">
+                            <thead>
+                                <tr>
+                                    <th t:text="loc.get('chart.new.label.name')">name</th>
+                                    <th t:text="loc.get('chart.actions')">actions</th>
+                                </tr>
+                            </thead>
+                            <!--/* a browser creates the <tbody> only when there is a row */-->
+                            <tbody t:unless="customCharts.isEmpty()">
+                            <tr t:each="chart : customCharts">
+                                <td t:text="viz.chartName(chart)">name</td>
+                                <td>
+                                    <a t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.ID + '/edit', 'edit', '', '', 'no-padding text-default', false, '', '')}"></a>
+                                    <a id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-chart" t:data-url="@{/charts/{id}/requestDelete(id=chart.ID)}">
+                                        <i class="material-icons left no-margin ">delete</i>
+                                    </a>
+                                </td>
+                            </tr>
+                            </tbody>
+                        </table>
+                        <t:block t:if="customCharts.isEmpty()">
+                            <div class="center-align charts-default-margin" t:text="loc.get('placeholder')">placeholder</div>
+                            <br>
+                        </t:block>
+
+                        <div class="section center-align charts-default-margin">
+                            <div class="headline-small" t:text="loc.get('charts.default')">default</div>
+                        </div>
+
+                        <table class="bordered">
+                            <thead>
+                                <tr>
+                                    <th t:text="loc.get('chart.new.label.name')">name</th>
+                                    <th t:text="loc.get('chart.display.type')">display</th>
+                                    <th t:text="loc.get('chart.group.type')">group</th>
+                                    <th t:text="loc.get('chart.actions')">actions</th>
+                                </tr>
+                            </thead>
+                            <tbody t:unless="defaultCharts.isEmpty()">
+                            <tr t:each="chart : defaultCharts">
+                                <td t:text="viz.chartName(chart)">name</td>
+                                <td><t:block t:replace="~{charts/chartFunctions :: iconForItem(chart.displayType.icon, chart.displayType.localizationKey)}"></t:block></td>
+                                <td><t:block t:replace="~{charts/chartFunctions :: iconForItem(chart.groupType.icon, chart.groupType.localizationKey)}"></t:block></td>
+                                <td>
+                                    <a t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.ID + '/edit', 'visibility', '', '', 'no-padding text-default', false, '', '')}"></a>
+                                </td>
+                            </tr>
+                            </tbody>
+                        </table>
+                    </div>
+                </page-content>
+                </t:block>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/charts.js}"></script>
+</body>
+</html>
