+	/** The first {@code length} characters of each string (FreeMarker {@code s[0..length-1]}). */
+	@TemplateFunction
+	public static List<String> prefixes(List<String> values, int length)
+	{
+		final List<String> result = new ArrayList<>();
+		for(String value : values)
+		{
+			result.add(value.substring(0, Math.min(length, value.length())));
+		}
+		return result;
