+/**
+ * Initializes Materialize tooltips.
+ * Tooltip texts computed by the server are rendered into the title attribute (Tessera does not allow computed text in data-* attributes).
+ * Materialize renders its tooltip option as HTML, so the text is escaped before it is handed to the plugin.
+ */
+function initTooltips(elements)
+{
+    $(elements).each(function()
+    {
+        if(this.hasAttribute('title') && this.dataset.tooltip === undefined)
+        {
+            const text = this.getAttribute('title');
+            this.removeAttribute('title');
+            M.Tooltip.init(this, {html: escapeTooltipText(text)});
+        }
+        else
+        {
+            $(this).tooltip();
+        }
+    });
+}
+
+function escapeTooltipText(text)
+{
+    const div = document.createElement('div');
+    div.textContent = text;
+    return div.innerHTML;
+}
