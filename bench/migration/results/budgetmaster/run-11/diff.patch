index 00000000..511c65e2
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/tags/tags.html
@@ -0,0 +1,48 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications, Map<String, Integer> tagUsages"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + loc.get('menu.tags'), null, ~{::body})}">
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('tags')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">local_offer</i> [[${loc.get('menu.tags')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <div class="container">
+                        <div t:if="tagUsages.isEmpty()" class="headline center-align" t:text="loc.get('placeholder')">placeholder</div>
+                        <table t:unless="tagUsages.isEmpty()" class="bordered">
+                            <thead>
+                                <tr>
+                                    <th t:text="loc.get('category.new.label.name')">name</th>
+                                    <th t:text="loc.get('categories.usages')">usages</th>
+                                    <th t:text="loc.get('categories.actions')">actions</th>
+                                </tr>
+                            </thead>
+                            <tbody>
+                                <tr t:each="entry : tagUsages">
+                                    <td>[[${entry.key}]] </td>
+                                    <td>
+                                        <a t:href="'/search?searchTags=true&searchText=' + entry.key" class="waves-effect waves-light text-default" t:text="entry.value">1</a>
+                                    </td>
+                                    <td>
+                                        <a t:replace="~{helpers/header :: buttonFlat('/search?searchTags=true&searchText=' + entry.key, 'search', '', '', 'no-padding text-default', false, '', '')}"></a>
+                                    </td>
+                                </tr>
+                            </tbody>
+                        </table>
+                    </div>
+                </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+</body>
+</html>
