diff --git a/BudgetMasterServer/src/main/resources/templates/indexFunctions.html b/BudgetMasterServer/src/main/resources/templates/indexFunctions.html
new file mode 100644
index 00000000..1a0c8c71
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/indexFunctions.html
@@ -0,0 +1,26 @@
+<t:block xmlns:t="https://tessera.dev">
+
+<div t:fragment="homeEntry(String url, String icon, String iconColor, String headlineText, String bodyText, Fragment content)" class="col s12 m6 l4 home-menu-cell">
+    <a t:replace="~{helpers/header :: buttonFlat(url, icon, headlineText, '', 'home-menu-link budget', false, 'icon-budget ' + iconColor, '')}"></a>
+    <p class="text-grey home-menu-text" t:text="loc.get(bodyText)">text</p>
+    <div class="left-align">
+        <t:block t:replace="content"></t:block>
+
+    </div>
+</div>
+
+<a t:fragment="action(String url, String name)" t:replace="~{helpers/header :: buttonFlat(url, 'play_arrow', name, '', 'home-menu-link-item', false, '', '')}"></a>
+
+<!--/* Only for steps without nested content: FreeMarker wrote the nested block markup into the <p>, which a browser
+       closes before the block; write such steps inline with the markup a browser builds. */-->
+<t:block t:fragment="stepContent(String headline, String contentText, String actionUrl, String actionName)">
+    <h5 t:text="loc.get(headline)">headline</h5>
+    <p>
+        <t:block t:text="loc.get(contentText)">text</t:block>
+    </p>
+    <p>
+        <a t:unless="strings.isEmpty(actionUrl)" t:replace="~{indexFunctions :: action(actionUrl, actionName)}"></a>
+    </p>
+</t:block>
+
+</t:block>
