+                                        <li>
+                                            <div class="collapsible-header"><i class="fas fa-filter"></i><t:block t:text="loc.get('title.filter')">Filter</t:block> <span class="badge background-red hidden text-white" id="filterActiveBadge" t:text="loc.get('filter.active.short')">active</span></div>
