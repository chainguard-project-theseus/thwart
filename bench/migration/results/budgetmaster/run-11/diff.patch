diff --git a/BudgetMasterServer/src/main/resources/templates/transactions/transactions.html b/BudgetMasterServer/src/main/resources/templates/transactions/transactions.html
new file mode 100644
index 00000000..8a9f6ac6
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/transactions.html
@@ -0,0 +1,116 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.reports.Budget, de.deadlocker8.budgetmaster.filter.FilterConfiguration, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications, List<Transaction> transactions, Account account, Budget budget, LocalDate currentDate, FilterConfiguration filterConfiguration, Integer highlightID"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + loc.get('menu.transactions'), ~{::page-head}, ~{::body})}">
+<page-head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/globalDatepicker.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+</page-head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('transactions')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <t:block t:replace="~{helpers/globalDatePicker :: datePicker(currentDate, '/transactions')}"></t:block>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <div class="container transaction-container">
+                        <div class="row">
+                            <div class="col s4">
+                                <div class="icon-block center-align">
+                                    <img class="budget-headline-icon" t:src="@{/images/piggy_income.svg}">
+                                    <h5 class="budget" t:text="bm.currency(budget.incomeSum)">0</h5>
+                                </div>
+                            </div>
+                            <div class="col s4">
+                                <div class="icon-block center-align">
+                                    <img class="budget-headline-icon" t:src="@{/images/piggy_expenditure.svg}">
+                                    <h5 class="center budget" t:text="bm.currency(budget.expenditureSum)">0</h5>
+                                </div>
+                            </div>
+                            <div class="col s4">
+                                <div class="icon-block center-align">
+                                    <img class="budget-headline-icon" t:src="@{/images/piggy_rest.svg}">
+                                    <h5 class="center budget" t:text="bm.currency(budget.rest)">0</h5>
+                                </div>
+                            </div>
+                        </div>
+
+                        <!--/* buttons */-->
+                        <t:block t:replace="~{transactions/transactionsMacros :: buttons(filterConfiguration.active)}"></t:block>
+
+                        <!--/* transactions list */-->
+                        <!--/* FreeMarker never closed the last date group: the placeholder and (after the main card's content) the
+                               delete/filter modal containers ended up nested one level deeper; this reproduces the browser's tree */-->
+                        <div t:each="group, groupStat : tx.groupByDate(transactions)" class="transaction-date-group">
+                            <div class="col s12 center-align bold transaction-text transaction-date" t:text="group.date">DATE</div>
+
+                            <t:block t:each="transaction : group.transactions" t:with="shouldHighlight=highlightID != null && transaction.ID != null && transaction.ID == highlightID">
+                            <div t:class="|hide-on-large-only transaction-row-top card transaction-card background-light ${transaction.future ? 'transaction-row-transparent' : ''} ${shouldHighlight ? 'transaction-row-highlighted' : ''}|"
+                                 t:id="shouldHighlight ? 'highlighted-small'">
+                                <div class="row valign-wrapper transaction-row-bottom no-margin-bottom">
+                                    <div t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 's6')}"></div>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(transaction, account, 's6')}"></t:block>
+                                </div>
+                                <div class="row valign-wrapper transaction-row-bottom">
+                                    <div t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'left-align no-margin-left')}"></div>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction)}"></t:block>
+                                    <div t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 's2')}"></div>
+                                    <div t:replace="~{transactions/transactionsMacros :: transactionButtons(transaction, 's6 right-align')}"></div>
+                                </div>
+                            </div>
+
+                            <div t:class="|hide-on-med-and-down transaction-row-top card transaction-card transaction-row-bottom background-light ${transaction.future ? 'transaction-row-transparent' : ''} ${shouldHighlight ? 'transaction-row-highlighted' : ''}|"
+                                 t:id="shouldHighlight ? 'highlighted-large'">
+                                <div class="row valign-wrapper no-margin-bottom transaction-row-desktop">
+                                    <div t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'left-align')}"></div>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction)}"></t:block>
+                                    <div t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 'l1 xl1')}"></div>
+                                    <div t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 'l4 xl5')}"></div>
+                                    <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(transaction, account, 'l3 xl3 center-align')}"></t:block>
+                                    <div t:replace="~{transactions/transactionsMacros :: transactionButtons(transaction, 'l2 xl1')}"></div>
+                                </div>
+                            </div>
+                            </t:block>
+
+                            <!--/* show placeholder text if no transactions are present in the current month or REST is the only transaction */-->
+                            <t:block t:if="groupStat.last">
+                                <t:block t:replace="~{transactions/transactionsMacros :: placeholder(transactions)}"></t:block>
+                            </t:block>
+                        </div>
+
+                        <t:block t:if="transactions.isEmpty()">
+                            <t:block t:replace="~{transactions/transactionsMacros :: placeholder(transactions)}"></t:block>
+                        </t:block>
+                    </div>
+                </page-content>
+                </t:block>
+
+                <t:block t:if="!transactions.isEmpty()">
+                    <div id="deleteModalContainerOnDemand"></div>
+
+                    <div t:replace="~{filter/filterMacros :: filterModal(filterConfiguration)}"></div>
+                </t:block>
+            </div>
+
+            <t:block t:if="transactions.isEmpty()">
+                <div id="deleteModalContainerOnDemand"></div>
+
+                <div t:replace="~{filter/filterMacros :: filterModal(filterConfiguration)}"></div>
+            </t:block>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/globalDatePicker.js}"></script>
+        <script t:src="@{/js/filter.js}"></script>
+        <script>
+            var currentDateString = [[${bm.dateNormal(currentDate)}]];
+            document.cookie = "currentDate=" + currentDateString;
+        </script>
+</body>
+</html>
