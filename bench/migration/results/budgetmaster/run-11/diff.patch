+
+                        <div class="hide-on-small-only"><br></div>
+
+                        <div class="row home-menu-flex">
+                            <div t:replace="~{indexFunctions :: homeEntry('/accounts', bm.entity('ACCOUNT').icon, '', 'menu.accounts', 'home.menu.accounts', ~{::accounts-actions})}">
+                                <accounts-actions t:remove="tag">
+                                <a t:replace="~{indexFunctions :: action('/accounts', 'home.menu.accounts.action.manage')}"></a>
+                                <a t:replace="~{indexFunctions :: action('/accounts/newAccount', 'home.menu.accounts.action.new')}"></a>
+                                </accounts-actions>
+                            </div>
+
+                            <div t:replace="~{indexFunctions :: homeEntry('/transactions', bm.entity('TRANSACTION').icon, bm.entity('TRANSACTION').colorAsTextColor, 'menu.transactions', 'home.menu.transactions', ~{::transactions-actions})}">
+                                <transactions-actions t:remove="tag">
+                                <a t:replace="~{indexFunctions :: action('/transactions', 'home.menu.transactions.action.manage')}"></a>
+                                <a t:replace="~{indexFunctions :: action('/transactions/newTransaction/normal', 'home.menu.transactions.action.new')}"></a>
+                                <a t:replace="~{indexFunctions :: action('/transactionImport', 'home.menu.transactions.action.csvImport')}"></a>
+                                </transactions-actions>
+                            </div>
+
+                            <div t:replace="~{indexFunctions :: homeEntry('/templates', bm.entity('TEMPLATE').icon, bm.entity('TEMPLATE').colorAsTextColor, 'menu.transactions.templates', 'home.menu.templates', ~{::templates-actions})}">
+                                <templates-actions t:remove="tag">
+                                <a t:replace="~{indexFunctions :: action('/templates', 'home.menu.templates.action.manage')}"></a>
+                                </templates-actions>
+                            </div>
+
+                            <div t:replace="~{indexFunctions :: homeEntry('/charts', bm.entity('CHART').icon, bm.entity('CHART').colorAsTextColor, 'menu.charts', 'home.menu.charts', ~{::charts-actions})}">
+                                <charts-actions t:remove="tag">
+                                <a t:replace="~{indexFunctions :: action('/charts/manage', 'home.menu.charts.action.manage')}"></a>
+                                <br>
+                                <a t:replace="~{indexFunctions :: action('/charts', 'home.menu.charts.action.show')}"></a>
+                                </charts-actions>
+                            </div>
+
+                            <div t:replace="~{indexFunctions :: homeEntry('/reports', bm.entity('REPORT').icon, bm.entity('REPORT').colorAsTextColor, 'menu.reports', 'home.menu.reports', ~{::reports-actions})}">
+                                <reports-actions t:remove="tag">
+                                <a t:replace="~{indexFunctions :: action('/reports', 'home.menu.reports.action.new')}"></a>
+                                </reports-actions>
+                            </div>
+
+                            <div t:replace="~{indexFunctions :: homeEntry('/categories', bm.entity('CATEGORY').icon, bm.entity('CATEGORY').colorAsTextColor, 'menu.categories', 'home.menu.categories', ~{::categories-actions})}">
