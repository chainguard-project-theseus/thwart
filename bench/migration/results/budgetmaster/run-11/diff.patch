new file mode 100644
index 00000000..8e9ad92d
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html
@@ -0,0 +1,120 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState, de.deadlocker8.budgetmaster.templating.FormErrors, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications, Account account, FormErrors error, List<AccountState> availableAccountStates, LocalDate today, List<String> fontawesomeIcons"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + (account.ID != null ? loc.get('title.account.edit') : loc.get('title.account.new')), ~{::page-head}, ~{::body})}">
+<page-head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+</page-head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('accounts')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="account.ID != null ? loc.get('title.account.edit') : loc.get('title.account.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <div class="container">
+                    <form name="NewAccount" t:action="@{/accounts/newAccount}" method="post">
+                        <input type="hidden" name="ID" t:value="account.ID != null ? '' + account.ID : ''">
+                        <input type="hidden" name="isSelected" t:value="account.isSelected() != null ? '' + account.isSelected() : ''">
+                        <input type="hidden" name="isDefault" t:value="account.isDefault() != null ? '' + account.isDefault() : ''">
+
+                        <!--/* name */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">edit</i>
+                                <input id="account-name" type="text" name="name"
+                                       t:class="val.cls(error, 'name', '')" t:data-position="val.has(error, 'name') ? 'bottom'" t:data-delay="val.has(error, 'name') ? 50" t:title="val.message(error, 'name')"
+                                       t:value="account.name ?: ''">
+                                <label for="account-name" t:text="loc.get('account.new.label.name')">name</label>
+                            </div>
+                        </div>
+
+                        <!--/* description */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">article</i>
+                                <!--/* FreeMarker wrote the validation class as a second class attribute, which browsers drop: keep only the first */-->
+                                <textarea id="account-description" class="materialize-textarea" name="description" data-length="250"
+                                          t:data-position="val.has(error, 'description') ? 'bottom'" t:data-delay="val.has(error, 'description') ? 50" t:title="val.message(error, 'description')"
+                                          t:text="account.description">description</textarea>
+                                <label class="input-label" for="account-description" t:text="loc.get('transaction.new.label.description')">description</label>
+                            </div>
+                        </div>
+
+                        <!--/* icon */-->
+                        <div t:replace="~{helpers/iconSelect :: iconSelect('account-icon', account, false,
+                                (account.iconReference != null && (account.iconReference.imageIcon || account.iconReference.builtinIcon)) ? 'category-square' : 'category-square account-square-border',
+                                'category-square account-square-border', false)}"></div>
+
+                        <!--/* font color */-->
+                        <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(account)}"></t:block>
+
+                        <!--/* state */-->
+                        <t:block t:replace="~{helpers/customSelectMacros :: customAccountStateSelect('account-state-select-wrapper', 'accountState', availableAccountStates,
+                                account.accountState != null ? account.accountState : availableAccountStates[0], 'col s12 m12 l8 offset-l2', loc.get('account.new.label.state'), 'account-state')}"></t:block>
+
+                        <!--/* end date */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">notifications</i>
+                                <input id="account-datepicker" type="text" class="datepicker" name="endDate" t:value="account.endDate != null ? bm.longDate(account.endDate) : ''">
+                                <label class="input-label" for="account-datepicker" t:text="loc.get('account.new.label.endDate')">end date</label>
+                            </div>
+                        </div>
+
+                        <script>
+                            var startDateString = [[${bm.longDate(account.endDate != null ? account.endDate : today)}]];
+                            startDate = startDateString.split(".");
+                            startDate = new Date(startDate[2], startDate[1]-1, startDate[0]);
+                        </script>
+
+                        <br>
+
+                        <!--/* buttons */-->
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <a t:replace="~{helpers/header :: buttonLink('/accounts', 'clear', 'cancel', 'button-cancel-save-account', 'red', '', false, false, '')}"></a>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', false, '', '')}"></button>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <a t:replace="~{helpers/header :: buttonLink('/accounts', 'clear', 'cancel', 'button-cancel-save-account', 'red', '', false, false, '')}"></a>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', false, '', '')}"></button>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+                </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <div t:replace="~{helpers/iconSelect :: modalIconSelect('account-name', account, fontawesomeIcons)}"></div>
+
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization}"></t:block>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/accounts.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+</body>
+</html>
