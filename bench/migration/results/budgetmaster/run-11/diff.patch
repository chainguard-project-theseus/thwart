@@ -0,0 +1,45 @@
+/*
+ * Runs the stored script of the selected chart (charts/charts.html).
+ *
+ * The page used to splice the chart script and its values directly into an inline <script>:
+ *   localizedTitle = '<chart name>'; localizedDateRange = '...'; (default charts also localizedLocale,
+ *   localizedCurrency, localizedData = JSON.parse('<localization>'))
+ *   <chart script with "var transactionData = [];" replaced by the transaction JSON and every "containerID"
+ *   replaced by the id of the chart container>
+ *
+ * Now these values arrive as data in the JSON block #chart-script-data. This file sets the same globals, applies the
+ * same two text replacements to the script (the transactions are passed as a global instead of as spliced JSON text)
+ * and runs the resulting script as a classic inline script, at the same point of page loading as before.
+ */
+(function()
+{
+    const dataElement = document.getElementById('chart-script-data');
+    if(!dataElement)
+    {
+        return;
+    }
+
+    const data = JSON.parse(dataElement.textContent);
+
+    if(data.isDefault)
+    {
+        window.localizedLocale = data.locale;
+        window.localizedCurrency = data.currency;
+        window.localizedData = JSON.parse(data.localization);
+    }
+    window.localizedTitle = data.title;
+    window.localizedDateRange = data.dateRange;
+
+    window.chartTransactionData = JSON.parse(data.transactionData);
+
+    let script = data.script.split('var transactionData = [];').join('var transactionData = window.chartTransactionData;');
+    script = script.split('containerID').join(data.containerID);
+
+    const scriptElement = document.createElement('script');
+    if(document.currentScript && document.currentScript.nonce)
+    {
+        scriptElement.nonce = document.currentScript.nonce;
+    }
+    scriptElement.textContent = script;
+    document.body.appendChild(scriptElement);
+})();
