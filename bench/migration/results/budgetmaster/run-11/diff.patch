@@ -0,0 +1,51 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.templategroup.TemplateGroup, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications, List<TemplateGroup> templateGroups"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + loc.get('menu.template.groups'), ~{::page-head}, ~{::body})}">
+<page-head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/templates.css}"/>
+</page-head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">file_copy</i> <t:block t:text="loc.get('menu.template.groups')">Template groups</t:block></div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <br>
+                    <t:block t:replace="~{templateGroups/templateGroupFunctions :: buttons}"></t:block>
+                    <br>
+
+                    <div class="container">
+                        <table class="bordered">
+                            <tbody t:if="!templateGroups.isEmpty()">
+                            <tr t:each="group : templateGroups">
+                                <td t:text="|${group.name} |">name</td>
+                                <td>
+                                    <a t:replace="~{helpers/header :: buttonFlat('/templateGroups/' + group.ID + '/edit', 'edit', '', '', 'no-padding text-default', false, '', '')}"></a>
+                                    <a id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-template-group" t:data-url="@{/templateGroups/{id}/requestDelete(id=group.ID)}">
+                                        <i class="material-icons left no-margin ">delete</i>
+                                    </a>
+                                </td>
+                            </tr>
+                            </tbody>
+                        </table>
+                        <div t:if="templateGroups.isEmpty()" class="headline center-align" t:text="loc.get('placeholder')">placeholder</div>
+                    </div>
+                </page-content>
+                </t:block>
+
+            <div id="deleteModalContainerOnDemand"></div>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/templateGroups.js}"></script>
+</body>
+</html>
