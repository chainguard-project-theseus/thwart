+
+/**
+ * Functions for the login, error, about, hotkeys, first use and what's new views.
+ */
+@TemplateFunctions("misc")
+public final class MiscFunctions
+{
+	/**
+	 * Localized texts that contain markup (line breaks, credit links): FreeMarker printed them raw.
+	 */
+	private static final HtmlPolicy LOCALIZATION_POLICY = HtmlPolicy.builder()
+			.allowElements("br", "a")
+			.allowAttributes("title")
+			.allowLinkTarget()
+			.linkRel()
+			.build();
+
+	private static final Pattern LINE_BREAK = Pattern.compile("<br\\s*/?>", Pattern.CASE_INSENSITIVE);
+
+	private MiscFunctions()
+	{
+	}
+
+	/**
+	 * A localized string that may contain markup (e.g. {@code <br>} or links), sanitized.
+	 */
+	@TemplateFunction
+	public static SafeHtml locHtml(String key)
+	{
+		return SafeHtml.sanitize(Localization.getString(key), LOCALIZATION_POLICY);
+	}
+
+	/**
+	 * A localized string whose only markup is {@code <br>}, split into its lines (for use inside a {@code <p>}:
+	 * print each line as text with a {@code <br>} between them).
+	 */
+	@TemplateFunction
+	public static List<String> locLines(String key)
+	{
+		return List.of(LINE_BREAK.split(Localization.getString(key), -1));
+	}
+}
