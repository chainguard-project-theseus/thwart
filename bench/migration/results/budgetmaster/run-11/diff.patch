diff --git a/BudgetMasterServer/src/main/resources/templates/settings/importResult.html b/BudgetMasterServer/src/main/resources/templates/settings/importResult.html
new file mode 100644
index 00000000..24ef85d1
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/settings/importResult.html
@@ -0,0 +1,79 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.services.ImportResultItem"
+      t:params="List<ImportResultItem> importResultItems, List<String> errorMessages"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + loc.get('settings.database.import'), ~{::page-head}, ~{::body})}">
+<page-head t:remove="tag"><link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/></page-head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('settings')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="loc.get('info.title.database.import.dialog')">Import</div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline-small" t:text="loc.get('info.database.import.result')">Result</div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="row">
+                        <div class="col s10 offset-s1 m8 offset-m2 l6 offset-l3">
+                            <table class="bordered">
+                                <tbody>
+                                <tr t:each="item : importResultItems">
+                                    <td><i class="material-icons left" t:text="item.entityType.icon">icon</i>
+                                        <div class="import-entity-name" t:text="loc.get(item.entityType.localizationKey)">name</div>
+                                    </td>
+                                    <td><i t:if="item.numberOfImportedItems != item.numberOfAvailableItems" class="fas fa-exclamation-triangle text-red"></i></td>
+                                    <td t:text="|${item.numberOfImportedItems}/${item.numberOfAvailableItems}|">0/0</td>
+                                </tr>
+                                </tbody>
+                            </table>
+                        </div>
+                    </div>
+                </div>
+
+                <div t:if="errorMessages != null && !errorMessages.isEmpty()" class="container">
+                    <div class="row">
+                        <div class="col s12">
+                            <ul class="collapsible">
+                                <li>
+                                    <div class="collapsible-header bold">
+                                        <i class="fas fa-exclamation-triangle text-red"></i>
+                                        <t:block t:text="loc.get('info.database.import.result.errors')">errors</t:block>
+                                    </div>
+                                    <div class="collapsible-body">
+                                        <table class="bordered">
+                                            <tbody>
+                                            <tr t:each="error : errorMessages">
+                                                <td><i class="fas fa-exclamation-triangle text-red"></i></td>
+                                                <td t:text="error">error</td>
+                                            </tr>
+                                            </tbody>
+                                        </table>
+                                    </div>
+                                </li>
+                            </ul>
+                        </div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="row">
+                        <div class="col s12 center-align">
+                            <a t:replace="~{helpers/header :: buttonLink('/settings', 'done', 'ok', 'button-finish-import', 'background-blue', '', false, false, '')}"></a>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </main>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/import.js}"></script>
+</body>
+</html>
