+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.charts.Chart, de.deadlocker8.budgetmaster.templating.FormErrors, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications, Chart chart, FormErrors error"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + (chart.ID != null ? loc.get('title.chart.edit') : loc.get('title.chart.new')), ~{::page-head}, ~{::body})}">
+<page-head t:remove="tag">
+        <link rel="stylesheet" t:href="@{/webjars/codemirror/lib/codemirror.css}">
+        <link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/>
+</page-head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('charts')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="chart.ID != null ? loc.get('title.chart.edit') : loc.get('title.chart.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <div class="container">
+                    <form name="NewChart" t:action="@{/charts/newChart}" method="post">
+                        <input type="hidden" name="ID" t:value="chart.ID == null ? '' : '' + chart.ID">
+
+                        <!--/* name */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">edit</i>
+                                <input id="chart-name" type="text" name="name" t:class="val.cls(error, 'name', '')" t:data-position="val.has(error, 'name') ? 'bottom'" t:data-delay="val.has(error, 'name') ? 50" t:title="val.message(error, 'name')" t:value="viz.chartName(chart)" t:disabled="chart.type == 'DEFAULT'">
+                                <label for="chart-name" t:text="loc.get('chart.new.label.name')">name</label>
+                            </div>
+                        </div>
+
+                        <!-- info message with link to wiki on how to create custom charts -->
+                        <t:block t:if="chart.type == 'CUSTOM'">
+                            <div t:replace="~{charts/chartFunctions :: infoMessage(misc.locHtml('chart.new.info.wiki'))}"></div>
+                        </t:block>
+
+                        <!--/* script */-->
+                        <div class="row">
+                            <div class="input-field col sl2" style="width: 100%">
+                                <textarea id="chart-script" name="script" t:class="val.cls(error, 'script', 'materialize-textarea')" t:data-position="val.has(error, 'script') ? 'bottom'" t:data-delay="val.has(error, 'script') ? 50" t:title="val.message(error, 'script')" t:text="chart.script">script</textarea>
+                            </div>
+                        </div>
+
+                        <br>
+
+                        <!--/* info message if chart is not editable */-->
+                        <t:block t:if="chart.type == 'DEFAULT'">
+                            <div t:replace="~{charts/chartFunctions :: infoMessage(misc.locHtml('chart.new.info.default'))}"></div>
+                        </t:block>
+
+                        <!--/* buttons */-->
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <a t:replace="~{helpers/header :: buttonLink('/charts/manage', 'clear', 'cancel', '', 'red', '', false, false, '')}"></a>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', chart.type == 'DEFAULT', '', '')}"></button>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <a t:replace="~{helpers/header :: buttonLink('/charts/manage', 'clear', 'cancel', '', 'red', '', false, false, '')}"></a>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', chart.type == 'DEFAULT', '', '')}"></button>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+                </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/codemirror/lib/codemirror.js}"></script>
+        <script t:src="@{/webjars/codemirror/mode/javascript/javascript.js}"></script>
+        <script t:src="@{/js/charts.js}"></script>
+</body>
+</html>
