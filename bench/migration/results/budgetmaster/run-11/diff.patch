+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/libs/plotly.min.js}"></script>
+        <script t:src="@{/js/libs/moment.min.js}"></script>
+        <script t:src="@{/js/charts.js}"></script>
+        <script t:src="@{/js/filter.js}"></script>
+
+        <!--/* The stored chart script and the values the old page spliced into it travel as data; /js/chartScript.js runs
+               the script exactly as the old inline <script> did (see the comment in that file). */-->
+        <t:block t:if="chart != null">
+            <script type="application/json" id="chart-script-data">{
+                "isDefault": [[${chart.type == 'DEFAULT'}]],
+                "locale": [[${loc.get('locale')}]],
+                "title": [[${viz.chartName(chart)}]],
+                "dateRange": [[${dateRange}]],
