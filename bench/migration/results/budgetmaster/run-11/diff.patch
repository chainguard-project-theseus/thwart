diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/header.html b/BudgetMasterServer/src/main/resources/templates/helpers/header.html
new file mode 100644
index 00000000..3d29039f
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/header.html
@@ -0,0 +1,119 @@
+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.hints.Hint, de.deadlocker8.budgetmaster.icon.Iconizable, de.deadlocker8.budgetmaster.utils.notification.Notification">
+
+<!--/* <head> content shared by all pages (FreeMarker: header.globals + header.header) */-->
+<t:block t:fragment="header(String title)">
+    <title t:text="title">BudgetMaster</title>
+    <meta charset="UTF-8"/>
+    <link rel="stylesheet" t:href="@{/webjars/font-awesome/css/all.min.css}">
+    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
+    <link rel="stylesheet" t:href="@{/webjars/materializecss/css/materialize.min.css}">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/colors.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/style.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/navbar.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/categories.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/accounts.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/customSelect.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/hotkeys.css}"/>
+
+    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
+
+    <link rel="apple-touch-icon" t:href="@{/touch_icon.png}">
+</t:block>
+
+<t:block t:fragment="logo(String id, String classes)">
+    <img t:if="bm.darkTheme()" t:class="classes" t:id="id" t:src="@{/images/Logo_with_white_text_medium_res.png}">
+    <img t:unless="bm.darkTheme()" t:class="classes" t:id="id" t:src="@{/images/Logo_with_text_medium_res.png}">
+</t:block>
+
+<!--/* FreeMarker header.content: notifications followed by the page content */-->
+<t:block t:fragment="content(List<Notification> notifications, Fragment content)">
+    <t:block t:if="notifications != null"><t:block t:replace="~{helpers/header :: showNotifications(notifications)}"></t:block></t:block>
+    <t:block t:replace="content"></t:block>
+</t:block>
+
+<t:block t:fragment="showNotifications(List<Notification> notifications)">
+    <div t:each="notification, st : notifications" class="row notification-row" t:id="|notification-${st.index}|">
+        <div class="col s12 center-align">
+            <div class="notification-wrapper">
+                <div t:class="|notification ${notification.backgroundColor} ${notification.textColor}|">
+                    <i t:if="notification.icon != null" t:class="|${notification.icon} notification-item|"></i>
+                    <span class="notification-item" t:utext="html.sanitize(notification.message)">message</span>
+                    <a t:class="|notification-item notification-clear ${notification.textColor}|" t:data-id="st.index">
+                        <i class="material-icons">clear</i>
+                    </a>
+                </div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!--/* actionUrl: '' for none */-->
+<t:block t:fragment="hint(Hint hint, String icon, String actionUrl)">
+    <div t:unless="hint.dismissed" class="row" t:id="|hint-${hint.ID}|">
+        <div class="col s12 center-align">
+            <div class="notification-wrapper">
+                <div class="notification notification-border text-default">
+                    <i t:class="|${icon} notification-item|"></i>
+                    <a t:if="!strings.isEmpty(actionUrl)" t:href="actionUrl" class="text-default">
+                        <span class="notification-item left-align" t:text="loc.get(hint.localizationKey)">hint</span>
+                    </a>
+                    <span t:if="strings.isEmpty(actionUrl)" class="notification-item left-align" t:text="loc.get(hint.localizationKey)">hint</span>
+                    <a class="notification-item hint-clear text-default" t:data-url="@{/hints/dismiss/{id}(id=hint.ID)}" t:data-id="hint.ID">
+                        <i class="material-icons">clear</i>
+                    </a>
+                </div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!--/* FreeMarker defaults: id="" color="background-blue" classes="" noUrl=false disabled=false target=""
+       isDataUrl=true is not supported here: write the <a> with t:data-url="@{...}" at the call site. */-->
+<a t:fragment="buttonLink(String url, String icon, String localizationKey, String id, String color, String classes, boolean noUrl, boolean disabled, String target)"
+   t:target="target == '_blank' ? '_blank'" t:href="noUrl ? null : url"
+   t:id="id ?: ''"
+   t:class="|waves-effect waves-light btn ${color} ${classes}|"
+   t:disabled="disabled">
+    <i t:class="strings.isEmpty(localizationKey) ? 'material-icons left no-margin' : 'material-icons left '" t:text="icon">icon</i><t:block t:unless="strings.isEmpty(localizationKey)" t:text="loc.get(localizationKey)">text</t:block>
+</a>
+
+<!--/* FreeMarker defaults: id="" color="background-blue" classes="" disabled=false formaction="" value="" onclick="" form="" */-->
+<button t:fragment="buttonSubmit(String name, String icon, String localizationKey, String id, String color, String classes, boolean disabled, String value, String form)"
+        t:id="strings.isEmpty(id) ? null : id" t:class="|btn waves-effect waves-light ${color} ${classes}|" type="submit" t:name="name" t:disabled="disabled"
+        t:value="strings.isEmpty(value) ? null : value" t:form="strings.isEmpty(form) ? null : form">
+    <i t:class="strings.isEmpty(localizationKey) ? 'material-icons left no-margin' : 'material-icons left '" t:text="icon">icon</i><t:block t:unless="strings.isEmpty(localizationKey)" t:text="loc.get(localizationKey)">text</t:block>
+</button>
+
+<!--/* FreeMarker defaults: id="" classes="" noUrl=false iconClasses='' target='' (isDataUrl / datasetIndex: write inline) */-->
+<a t:fragment="buttonFlat(String url, String icon, String localizationKey, String id, String classes, boolean noUrl, String iconClasses, String target)"
+   t:target="target == '_blank' ? '_blank'" t:href="noUrl ? null : url"
+   t:id="id ?: ''"
+   t:class="|waves-effect waves-light btn-flat ${classes}|">
+    <i t:class="|material-icons left ${strings.isEmpty(localizationKey) ? 'no-margin' : ''} ${iconClasses}|" t:text="icon">icon</i><span t:unless="strings.isEmpty(localizationKey)" t:text="loc.get(localizationKey)">text</span>
+</a>
+
+<!--/* FreeMarker defaults: id="modalConfirmDelete" classes="" */-->
+<div t:fragment="modalConfirmDelete(String title, String confirmUrl, Integer itemId, String confirmButtonTextKey, String id, String classes, Fragment content)"
+     t:id="id" t:class="|modal background-color ${classes}|">
+    <div class="modal-content">
+        <h4 t:text="title">title</h4>
+
+        <t:block t:replace="content"></t:block>
+    </div>
+    <div class="modal-footer background-color">
+        <a t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', true, false, '')}"></a>
+        <a t:replace="~{helpers/header :: buttonLink(confirmUrl + '/' + itemId + '/delete', 'delete', confirmButtonTextKey, '', 'green', 'modal-action modal-close text-white', false, false, '')}"></a>
+    </div>
+</div>
+
+<t:block t:fragment="entityIcon(Iconizable entity, String classes, String fallbackName)">
+    <t:block t:if="entity.iconReference != null">
+        <img t:if="entity.iconReference.imageIcon" t:src="@{/media/getImageByIconID/{id}(id=entity.iconReference.ID)}" t:class="classes"/>
+        <i t:if="!entity.iconReference.imageIcon && entity.iconReference.builtinIcon" t:class="|${entity.iconReference.builtinIdentifier} ${classes}|"></i>
+        <t:block t:if="!entity.iconReference.imageIcon && !entity.iconReference.builtinIcon" t:text="bm.firstLetterCapitalized(fallbackName)">A</t:block>
+    </t:block>
+    <t:block t:if="entity.iconReference == null" t:text="bm.firstLetterCapitalized(fallbackName)">A</t:block>
+</t:block>
+
+</t:block>
