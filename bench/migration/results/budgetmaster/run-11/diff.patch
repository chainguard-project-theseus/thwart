+<t:block xmlns:t="https://tessera.dev">
+<!--/*
+  Fragments (converted from globalDatePicker.ftl):
+  - datePicker(LocalDate fullDate, String target)
+      FreeMarker <@datePicker.datePicker currentDate "/transactions"/> -> ~{helpers/globalDatePicker :: datePicker(currentDate, '/transactions')}
+      (declare LocalDate currentDate in t:params). Month names come from tx.monthNames(); no localizedMonthNames param needed.
+  - datepickerGridYear(int startYear, int currentYear)
+  - datepickerGrid(List<String> items, String currentItem)   (items: 12 entries, 4 rows of 3)
+  - datePickerLocalization   (no params; the <script> declaring monthNames, monthNamesShort, weekDays, weekDaysShort,
+      weekDaysLetters, buttonCancel, buttonClose as globals)
+*/-->
+
+<t:block t:fragment="datePicker(LocalDate fullDate, String target)">
+     <div class="container">
+         <div class="section center-align">
+             <a t:href="|/previousMonth?target=${target}|" id="global-datepicker-previous-month" class="waves-effect text-default"><i class="material-icons icon-chevron">chevron_left</i></a>
+             <a href="#modalDate" class="waves-effect headline-date modal-trigger text-default datePicker-fixed-width" t:text="bm.dateMonthYear(fullDate)">date</a>
+             <a t:href="|/nextMonth?target=${target}|" id="global-datepicker-next-month" class="waves-effect text-default"><i class="material-icons icon-chevron">chevron_right</i></a>
+             <a t:href="|/today?target=${target}|" id="global-datepicker-today" class="waves-effect text-default"><i class="material-icons icon-today">event</i></a>
+         </div>
+     </div>
+    <!-- modal to select specific month and year -->
+    <div id="modalDate" class="modal modal-fixed-footer">
+        <div class="modal-content background-color">
+
+            <div id="global-datepicker-select-year">
+                <t:block t:replace="~{helpers/globalDatePicker :: datepickerGridYear(fullDate.year - 7, fullDate.year)}"></t:block>
+            </div>
+
+            <div id="global-datepicker-select-month">
+                <h4 t:text="loc.get('title.datepicker.month')">month</h4>
+                <t:block t:replace="~{helpers/globalDatePicker :: datepickerGrid(tx.monthNames(), tx.monthNames()[fullDate.monthValue - 1])}"></t:block>
+            </div>
+        </div>
+        <div class="modal-footer background-color">
+            <a t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false, '')}"></a>
+            <a t:replace="~{helpers/header :: buttonLink('/setDate?target=' + target, 'done', 'ok', 'buttonChooseDate', 'green', 'modal-action modal-close text-white', false, false, '')}"></a>
+        </div>
+    </div>
+
+    <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.globalDatePicker.hotkeys'), 'fas fa-info', '/hotkeys')}"></t:block>
+</t:block>
+
+<t:block t:fragment="datepickerGridYear(int startYear, int currentYear)">
+    <h4 t:text="loc.get('title.datepicker.year')">year</h4>
+
+    <div class="hidden" id="currentYear" t:text="currentYear">2024</div>
+
+    <div class="center-align">
+        <a class="waves-effect text-default global-datepicker-button" id="global-datepicker-previous"><i class="material-icons icon-chevron">chevron_left</i></a>
+        <a class="waves-effect text-default global-datepicker-button" id="global-datepicker-next"><i class="material-icons icon-chevron">chevron_right</i></a>
+    </div>
+
+    <t:block t:replace="~{helpers/globalDatePicker :: datepickerGrid(tx.years(startYear, 12), '' + currentYear)}"></t:block>
+</t:block>
+
+<table t:fragment="datepickerGrid(List<String> items, String currentItem)" class="no-border-table global-datepicker-table">
+    <tbody>
+        <tr t:each="row : numbers.sequence(0, 3)">
+            <td t:each="col : numbers.sequence(0, 2)" t:with="item=items[row * 3 + col]"
+                t:class="|global-datepicker-item ${item == currentItem ? 'global-datepicker-selected' : ''}|" t:text="item">item</td>
+        </tr>
+    </tbody>
+</table>
+
+<t:block t:fragment="datePickerLocalization">
+    <script>
+        var monthNames = [[${tx.monthNames()}]];
+        var monthNamesShort = [[${tx.prefixes(tx.monthNames(), 3)}]];
+        var weekDays = [[${tx.weekdays()}]];
+        var weekDaysShort = [[${tx.prefixes(tx.weekdays(), 2)}]];
+        var weekDaysLetters = [[${tx.prefixes(tx.weekdays(), 1)}]];
+        var buttonCancel = [[${loc.get('cancel')}]];
+        var buttonClose = [[${loc.get('ok')}]];
+    </script>
+</t:block>
+</t:block>
