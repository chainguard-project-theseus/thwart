+                                           t:data-value="groupType == 'NONE' ? 'NONE' : (groupType == 'MONTH' ? 'MONTH' : 'YEAR')">
+                                            <t:block t:replace="~{charts/chartFunctions :: iconForItem(groupType.icon, groupType.localizationKey)}"></t:block>
