diff --git a/BudgetMasterServer/src/main/resources/templates/login.html b/BudgetMasterServer/src/main/resources/templates/login.html
new file mode 100644
index 00000000..fd3b3e4d
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/login.html
@@ -0,0 +1,69 @@
+<html xmlns:t="https://tessera.dev"
+      t:params="Boolean isError, Boolean isLogout, LocalDate currentDate"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + loc.get('login.button'), ~{::page-head}, ~{::body})}">
+<page-head t:remove="tag"><link type="text/css" rel="stylesheet" t:href="@{/css/login.css}"/></page-head>
+<body t:remove="tag">
+        <main>
+            <div class="row valign-wrapper full-height">
+                <div class="col l4 offset-l4 m6 offset-m3 s10 offset-s1">
+                    <div class="card" id="card-login">
+                        <div class="card-content">
+                            <div class="card-title">
+                                <div id="logo-container" class="center-align"><t:block t:replace="~{helpers/header :: logo('logo', '')}"></t:block></div>
+                            </div>
+                            <form t:action="@{/login}" method="post" onsubmit="return validateLoginForm()">
+                                <input type="hidden" name="username" value="Default">
+
+                                <div class="row no-margin-bottom">
+                                    <div class="input-field col s12">
+                                        <input id="login-password" type="password" name="password">
+                                        <label for="login-password" t:text="loc.get('login.password')">Password</label>
+                                    </div>
+                                </div>
+
+                                <div t:if="isError != null" class="row no-margin-bottom">
+                                    <div class="col s12 center-align">
+                                        <table t:class="|${bm.redTextColor()} login-message no-border-table|">
+                                            <tbody>
+                                            <tr>
+                                                <td><i class="material-icons">warning</i></td>
+                                                <td id="loginMessage" t:text="loc.get('warning.wrong.password')">wrong password</td>
+                                            </tr>
+                                            </tbody>
+                                        </table>
+                                    </div>
+                                </div>
+
+                                <div t:if="isLogout != null" class="row no-margin-bottom">
+                                    <div class="col s12 center-align">
+                                        <table t:class="|${bm.greenTextColor()} login-message no-border-table|">
+                                            <tbody>
+                                            <tr>
+                                                <td><i class="material-icons">info_outline</i></td>
+                                                <td id="loginMessage" t:text="loc.get('logout.success')">logged out</td>
+                                            </tr>
+                                            </tbody>
+                                        </table>
+                                    </div>
+                                </div>
+
+                                <div class="row login-margin-top">
+                                    <div class="col s12 right-align">
+                                        <button t:replace="~{helpers/header :: buttonSubmit('action', 'send', 'login.button', '', 'background-blue', '', false, '', '')}"></button>
+                                    </div>
+                                </div>
+                            </form>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script>
+            var currentDateString = [[${bm.dateNormal(currentDate)}]];
+            document.cookie = "currentDate=" + currentDateString;
+        </script>
+</body>
+</html>
