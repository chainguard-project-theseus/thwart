+            <form t:each="csvTransaction, st : csvTransactions" name="NewTransactionInPlace" t:id="|newTransactionInPlace_${st.index}|" method="POST"
+                  t:action="@{/transactionImport/{index}/newTransactionInPlace(index=st.index)}" t:data-index="st.index">
+            </form>
+        </div>
+    </div>
+
+    <t:block t:replace="~{transactions/newTransactionMacros :: insertNameSuggestions(suggestionsJSON)}"></t:block>
+</t:block>
+
+<tr t:fragment="renderCsvTransaction(CsvTransaction csvTransaction, int index, List<Category> categories)"
+    t:with="skipped=csvTransaction.status == 'SKIPPED'"
+    t:class="|transaction-import-row ${skipped ? 'transaction-import-row-skipped' : ''}|" t:id="|transaction-import-row-${index}|">
+        <td><div t:replace="~{transactions/transactionImportMacros :: statusBanner(csvTransaction.status)}"></div></td>
+        <td t:text="csvTransaction.date">2024-01-01</td>
+        <td>
+            <t:block t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, csvTransaction.category, 'left-align no-margin-top no-margin-bottom', '', 'csvTransaction-category-' + index, false, 'no-margin-bottom', skipped, 'newTransactionInPlace_' + index)}"></t:block>
+        </td>
+        <td>
+            <div class="input-field no-margin-top no-margin-bottom">
+                <input t:form="|newTransactionInPlace_${index}|" class="no-margin-bottom autocomplete" type="text" name="name" autocomplete="off" required t:value="csvTransaction.name" t:disabled="skipped">
+            </div>
+        </td>
+        <td>
+            <div class="input-field no-margin-top no-margin-bottom">
+                <input t:form="|newTransactionInPlace_${index}|" class="no-margin-bottom" type="text" name="description" t:value="csvTransaction.description" t:disabled="skipped">
+            </div>
+        </td>
+        <td t:text="bm.currency(csvTransaction.amount)">0</td>
+        <td>
+            <a t:if="skipped" id="" t:data-index="index" class="waves-effect waves-light btn-flat no-padding text-default button-request-transaction-import-undo-skip"
+               t:data-url="@{/transactionImport/{index}/undoSkip(index=index)}">
+                <i class="material-icons left no-margin ">do_disturb_off</i>
+            </a>
+            <t:block t:unless="skipped">
+                <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', '', '', 'background-blue', 'text-white', false, '', 'newTransactionInPlace_' + index)}"></button>&nbsp;
+                <div class="fixed-action-btn edit-transaction-button">
+                    <a class="btn-floating btn-flat waves-effect waves-light no-padding text-default edit-transaction-button-link">
+                        <i class="material-icons text-default">edit</i>
+                    </a>
+                    <ul class="new-transaction-button-list">
+                        <li>
+                            <a t:href="@{/transactionImport/{index}/newTransaction/normal(index=index)}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new', loc.get('title.transaction.new.normal'))">normal</a>
+                            <a t:href="@{/transactionImport/{index}/newTransaction/normal(index=index)}" class="btn-floating btn background-orange"><i class="material-icons">payment</i></a>
+                        </li>
+                        <li>
+                            <a t:href="@{/transactionImport/{index}/newTransaction/transfer(index=index)}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new', loc.get('title.transaction.new.transfer'))">transfer</a>
+                            <a t:href="@{/transactionImport/{index}/newTransaction/transfer(index=index)}" class="btn-floating btn background-green-dark"><i class="material-icons">swap_horiz</i></a>
+                        </li>
+                        <li>
+                            <a t:href="@{/transactionImport/{index}/newFromTemplate(index=index)}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new', loc.get('title.transaction.new.from.template'))">template</a>
+                            <a t:href="@{/transactionImport/{index}/newFromTemplate(index=index)}" class="btn-floating btn background-blue-baby"><i class="material-icons">file_copy</i></a>
+                        </li>
+                    </ul>
+                </div>
+                <a id="" t:data-index="index" class="waves-effect waves-light btn-flat no-padding text-default button-request-transaction-import-skip"
+                   t:data-url="@{/transactionImport/{index}/skip(index=index)}">
+                    <i class="material-icons left no-margin ">do_not_disturb_on</i>
+                </a>
+            </t:block>
+        </td>
+</tr>
+
+<t:block t:fragment="showColumnSettingsErrors(List<String> errorsColumnSettings)">
+    <div t:if="errorsColumnSettings != null && !errorsColumnSettings.isEmpty()" class="container" id="parseErrors">
+        <div class="row">
+            <div class="col s12">
+                <ul class="collapsible">
+                    <li>
+                        <div class="collapsible-header bold">
+                            <i class="fas fa-exclamation-triangle text-red"></i>
+                            <t:block t:text="loc.get('info.database.import.result.errors')">errors</t:block>
+                        </div>
+                        <div class="collapsible-body">
+                            <table class="bordered">
+                                <tbody>
+                                <tr t:each="error : errorsColumnSettings">
+                                    <td><i class="fas fa-exclamation-triangle text-red"></i></td>
+                                    <td t:text="error">error</td>
+                                </tr>
+                                </tbody>
+                            </table>
+                        </div>
+                    </li>
+                </ul>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<div t:fragment="statusBanner(CsvTransactionStatus status)"
+     t:class="|banner ${status == 'PENDING' ? 'background-blue text-white' : (status == 'IMPORTED' ? 'background-green text-white' : (bm.darkTheme() ? 'background-grey text-black' : 'background-grey text-white'))}|"
+     t:text="loc.get(status.localizationKey)">status</div>
+</t:block>
