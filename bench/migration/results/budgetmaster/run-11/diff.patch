@@ -0,0 +1,149 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountsFilterConfiguration, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications, List<Account> accounts, AccountsFilterConfiguration accountsFilterConfiguration, Boolean accountNotDeletable, Account currentAccount"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + loc.get('menu.accounts'), null, ~{::body})}">
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('accounts')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="material-icons">account_balance</i> [[${loc.get('menu.accounts')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <br>
+                    <div class="center-align"><a t:replace="~{helpers/header :: buttonLink('/accounts/newAccount', 'add', 'title.account.new', 'button-new-account', 'background-blue', '', false, false, '')}"></a></div>
+                    <br>
+                    <div class="container account-container" t:with="filter=accountsFilterConfiguration">
+                        <form name="AccountsFilter" t:action="@{/accounts/applyFilter}" method="post">
+                            <table class="bordered">
+                                <thead class="hide-on-med-and-down">
+                                    <tr>
+                                        <th></th>
+                                        <th>
+                                            <div t:text="loc.get('account.new.label.state')">state</div>
+                                            <div>
+                                                <label>
+                                                    <input type="checkbox" name="includeFullAccess" t:checked="filter != null && filter.includeFullAccess"/>
+                                                    <span><i class="fas fa-edit placeholder-icon-right"></i>[[${loc.get('account.state.full.access')}]]</span>
+                                                </label>
+                                            </div>
+                                            <div>
+                                                <label>
+                                                    <input type="checkbox" name="includeReadOnly" t:checked="filter != null && filter.includeReadOnly"/>
+                                                    <span><i class="fas fa-lock placeholder-icon-right"></i>[[${loc.get('account.state.read.only')}]]</span>
+                                                </label>
+                                            </div>
+                                            <div>
+                                                <label>
+                                                    <input type="checkbox" name="includeHidden" t:checked="filter != null && filter.includeHidden"/>
+                                                    <span id="includeHidden"><i class="far fa-eye-slash placeholder-icon-right"></i>[[${loc.get('account.state.hidden')}]]</span>
+                                                </label>
+                                            </div>
+                                        </th>
+                                        <th>
+                                            <div t:text="loc.get('account.new.label.endDate')">end date</div>
+                                            <div>
+                                                <label>
+                                                    <input type="checkbox" name="includeWithEndDate" t:checked="filter != null && filter.includeWithEndDate"/>
+                                                    <span><i class="fas fa-bell placeholder-icon-right"></i>[[${loc.get('account.label.endDate.with')}]]</span>
+                                                </label>
+                                            </div>
+                                            <div>
+                                                <label>
+                                                    <input type="checkbox" name="includeWithoutEndDate" t:checked="filter != null && filter.includeWithoutEndDate"/>
+                                                    <span><i class="fas fa-bell-slash placeholder-icon-right"></i>[[${loc.get('account.label.endDate.without')}]]</span>
+                                                </label>
+                                            </div>
+                                        </th>
+                                        <th>
+                                            <div t:text="loc.get('account.new.label.name')">name</div>
+                                            <div class="input-field">
+                                                <input type="text" name="name" t:value="filter != null ? filter.name : ''"/>
+                                            </div>
+                                        </th>
+                                        <th>
+                                            <div t:text="loc.get('transaction.new.label.description')">description</div>
+                                            <div class="input-field">
+                                                <input type="text" name="description" t:value="filter != null ? filter.description : ''"/>
+                                            </div>
+                                        </th>
+                                        <th class="vertical-align-middle">
+                                            <button class="btn waves-effect waves-light background-green" type="submit" id="accounts-filter-button">
+                                                <i class="fas fa-filter left"></i>[[${loc.get('filter.apply')}]]
+                                            </button>
+                                        </th>
+                                    </tr>
+                                </thead>
+
+                                <tbody>
+                                <t:block t:each="account : accounts">
+                                    <tr t:if="account.type == 'CUSTOM'" class="account-overview-row">
+                                        <td><div t:replace="~{helpers/customSelectMacros :: accountIcon(account, account.name, 'text-blue', false)}"></div></td>
+                                        <td>
+                                            <t:block t:if="account.accountState == 'READ_ONLY'">
+                                                <div class="placeholder-icon placeholder-icon-right"></div>
+                                                <i class="fas fa-lock placeholder-icon-right"></i>
+                                            </t:block>
+                                            <t:block t:if="account.accountState == 'HIDDEN'">
+                                                <div class="placeholder-icon placeholder-icon-right"></div>
+                                                <i class="far fa-eye-slash placeholder-icon-right"></i>
+                                            </t:block>
+                                            <t:block t:if="account.accountState != 'READ_ONLY' && account.accountState != 'HIDDEN'">
+                                                <a t:href="@{/accounts/{id}/setAsDefault(id=account.ID)}" class="btn-flat no-padding text-default tooltipped" data-position="left" t:title="loc.get('account.tooltip.default')"><i class="material-icons left" t:text="account.isDefault() ? 'star' : 'star_border'">star</i></a>
+                                                <i class="fas fa-edit placeholder-icon-right"></i>
+                                            </t:block>
+                                        </td>
+                                        <td>
+                                            <t:block t:if="account.endDate != null">
+                                                <i class="fas fa-bell placeholder-icon-right"></i> [[${bm.dateNormal(account.endDate)}]]
+                                            </t:block>
+                                            <div t:if="account.endDate == null" class="placeholder-icon"></div>
+                                        </td>
+                                        <td t:text="account.name">name</td>
+                                        <td>
+                                            <div class="truncate account-description" t:text="account.description">description</div>
+                                        </td>
+                                        <td>
+                                            <a t:href="@{/accounts/{id}/edit(id=account.ID)}" class="btn-flat no-padding text-default"><i class="material-icons left">edit</i></a>
+                                            <a id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-account" t:data-url="@{/accounts/{id}/requestDelete(id=account.ID)}">
+                                                <i class="material-icons left no-margin ">delete</i>
+                                            </a>
+                                        </td>
+                                    </tr>
+                                </t:block>
+                                </tbody>
+                            </table>
+                        </form>
+                        <div t:if="accounts.isEmpty()" class="headline center-align" t:text="loc.get('placeholder')">placeholder</div>
+                    </div>
+                </page-content>
+                </t:block>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+
+        <t:block t:if="accountNotDeletable != null">
+            <!-- warning account not deletable -->
+            <div id="modalAccountNotDeletable" class="modal background-color">
+                <div class="modal-content">
+                    <h4 t:text="loc.get('info.title.account.delete')">title</h4>
+                    <p t:text="loc.get('warning.text.account.delete', currentAccount.name)">text</p>
+                </div>
+                <div class="modal-footer background-color">
+                    <a t:replace="~{helpers/header :: buttonLink('/accounts', 'done', 'ok', 'buttonCloseWhatsNew', 'green', 'modal-action modal-close text-white', false, false, '')}"></a>
+                </div>
+            </div>
+        </t:block>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/accounts.js}"></script>
+</body>
+</html>
