+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.accounts.Account">
+<!--/*
+  Fragments (converted from transactionsMacros.ftl). No FreeMarker defaults except transactionLinks:
+  - transactionType(Transaction transaction, String size)
+  - transactionCategory(Transaction transaction, String alignment)
+  - transactionNameAndDescription(Transaction transaction, String size)
+  - transactionAmount(Transaction transaction, Account account, String size)
+  - transactionButtons(Transaction transaction, String classes)
+  - transactionEditButton(Transaction transaction)
+  - transactionAccountIcon(Transaction transaction)
+  - transactionLinks(Transaction transaction, String target)        FreeMarker default target='' -> pass ''
+  - placeholder(List<Transaction> transactions)
+  - buttons(boolean isFilterActive)
+  - buttonNew(String listClasses, Account currentAccount)
+  - buttonFilter(boolean isFilterActive)       e.g. buttonFilter(filterConfiguration.active)
+  The account tooltip of transactionType/transactionAccountIcon is now a title attribute (main.js initTooltips reads it).
+*/-->
+
+<div t:fragment="transactionType(Transaction transaction, String size)" t:class="|col ${size} left-align transaction-row-transparent-child|">
+    <i t:if="transaction.repeating" class="material-icons">repeat</i>
+    <i t:if="transaction.transfer" class="material-icons tooltipped" data-position="bottom" t:title="|${transaction.account.name} ➔ ${transaction.transferAccount.name}|">swap_horiz</i>
+    <i t:if="!transaction.repeating && !transaction.transfer" class="material-icons invisible">repeat</i>
+</div>
+
+<div t:fragment="transactionCategory(Transaction transaction, String alignment)" t:class="|col s2 l1 xl1 ${alignment} transaction-row-transparent-child|">
+    <div class="hide-on-med-and-down">
+        <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(transaction.category, '', false, true)}"></t:block>
+    </div>
+    <div class="hide-on-large-only">
+        <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(transaction.category, 'category-circle-small', false, true)}"></t:block>
+    </div>
+</div>
+
+<div t:fragment="transactionNameAndDescription(Transaction transaction, String size)" t:class="|col ${size} transaction-row-transparent-child|">
+    <div class="truncate transaction-text" t:text="transaction.name">name</div>
+    <div class="hide-on-med-and-down">
+        <div t:if="transaction.description != null" class="italic" t:text="transaction.description">description</div>
+    </div>
+</div>
+
+<t:block t:fragment="transactionAmount(Transaction transaction, Account account, String size)" t:with="amount=bm.amountForAccount(transaction, account)">
+    <div t:class="|col ${size} bold ${amount <= 0 ? bm.redTextColor() : bm.greenTextColor()} no-wrap right-align transaction-text transaction-row-transparent-child|" t:text="bm.currency(amount)">0,00 €</div>
+</t:block>
+
+<div t:fragment="transactionButtons(Transaction transaction, String classes)" t:class="|col ${classes} transaction-buttons no-wrap|">
+    <t:block t:if="transaction.editable">
+        <t:block t:replace="~{transactions/transactionsMacros :: transactionEditButton(transaction)}"></t:block>
+        <a id="" class="waves-effect waves-light btn-flat no-padding text-default button-request-delete-transaction"
+           t:data-url="@{/transactions/{id}/requestDelete(id=transaction.ID)}">
+            <i class="material-icons left no-margin ">delete</i>
+        </a>
+    </t:block>
+    <t:block t:if="transaction.allowedToFillNewTransaction">
+        <a t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/newFromExisting', 'content_copy', '', '', 'no-padding text-default button-new-from-existing', false, '', '')}"></a>
+    </t:block>
+</div>
+
+<t:block t:fragment="transactionEditButton(Transaction transaction)">
+    <div t:if="transaction.repeating" class="fixed-action-btn edit-transaction-button">
+        <a class="btn-floating btn-flat waves-effect waves-light no-padding text-default edit-transaction-button-link">
+            <i class="material-icons">edit</i>
+        </a>
+        <ul class="new-transaction-button-list">
+            <li>
+                <a t:href="@{/transactions/{id}/edit(id=transaction.ID)}" class="btn-floating btn mobile-fab-tip no-wrap button-edit-all-occurrences" t:text="loc.get('title.transaction.edit', loc.get('title.transaction.new.normal'))">edit</a>
+                <a t:href="@{/transactions/{id}/edit(id=transaction.ID)}" class="btn-floating btn background-green-dark"><i class="material-icons">edit</i></a>
+            </li>
+            <li>
+                <a t:href="@{/transactions/{id}/editFutureRepetitions(id=transaction.ID)}" class="btn-floating btn mobile-fab-tip no-wrap button-edit-future-occurrences" t:text="loc.get('repeating.button.edit.future')">future</a>
+                <a t:href="@{/transactions/{id}/editFutureRepetitions(id=transaction.ID)}" class="btn-floating btn background-orange"><i class="material-icons">move_up</i></a>
+            </li>
+        </ul>
+    </div>
+    <t:block t:unless="transaction.repeating">
+        <a t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/edit', 'edit', '', '', 'no-padding text-default button-edit', false, '', '')}"></a>
+    </t:block>
+</t:block>
+
+<t:block t:fragment="transactionAccountIcon(Transaction transaction)">
+    <a t:if="bm.currentAccount().type == 'ALL' && transaction.account != null" t:href="@{/accounts/{id}/select(id=transaction.account.ID)}">
+        <div class="col s2 l1 xl1 tooltipped no-padding transaction-row-transparent-child" data-position="bottom" t:title="transaction.account.name">
+            <div class="hide-on-med-and-down">
+                <div t:replace="~{helpers/customSelectMacros :: accountIcon(transaction.account, transaction.account.name, '', false)}"></div>
+            </div>
+            <div class="hide-on-large-only">
+                <div t:replace="~{helpers/customSelectMacros :: accountIcon(transaction.account, transaction.account.name, 'category-circle-small', false)}"></div>
+            </div>
+        </div>
+    </a>
+</t:block>
+
+<div t:fragment="transactionLinks(Transaction transaction, String target)" class="col s4 l2 xl1 right-align transaction-buttons no-wrap">
+    <a t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/highlight', 'open_in_new', '', '', 'no-padding text-default buttonHighlight', false, '', target)}"></a>
+    <t:block t:if="transaction.account.accountState == 'FULL_ACCESS'">
+        <a t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/edit', 'edit', '', '', 'no-padding text-default', false, '', target)}"></a>
+    </t:block>
+</div>
+
+<t:block t:fragment="placeholder(List<Transaction> transactions)">
+    <br>
+
+    <div t:if="transactions.isEmpty() || (transactions.size() == 2 && transactions[0].category.type == 'REST' && transactions[1].category.type == 'REST')" class="row">
+        <div class="col s12">
+            <div class="headline center-align" t:text="loc.get('placeholder.seems.empty')">empty</div>
+            <div class="headline-advice center-align" t:text="loc.get('placeholder.advice', loc.get('menu.transactions'))">advice</div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="buttons(boolean isFilterActive)">
+    <div class="row hide-on-small-only valign-wrapper">
+        <t:block t:if="bm.currentAccount().accountState == 'FULL_ACCESS'">
+            <div class="col s6 right-align transactions-buttons-col">
+                <t:block t:replace="~{transactions/transactionsMacros :: buttonNew('new-transaction-button-list new-transaction-button-list-large', bm.currentAccount())}"></t:block>
+            </div>
+            <div class="col s6 left-align">
+                <a t:replace="~{transactions/transactionsMacros :: buttonFilter(isFilterActive)}"></a>
+            </div>
+        </t:block>
+        <div t:unless="bm.currentAccount().accountState == 'FULL_ACCESS'" class="col s12 center-align">
+            <a t:replace="~{transactions/transactionsMacros :: buttonFilter(isFilterActive)}"></a>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up center-align">
+        <div class="row center-align">
+            <div class="row center-align">
+                <div class="col s12">
+                    <a t:replace="~{transactions/transactionsMacros :: buttonFilter(isFilterActive)}"></a>
+                </div>
+            </div>
+            <div class="col s12 transactions-buttons-col">
+                <t:block t:replace="~{transactions/transactionsMacros :: buttonNew('new-transaction-button-list ', bm.currentAccount())}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="buttonNew(String listClasses, Account currentAccount)">
+    <div t:if="currentAccount.accountState == 'FULL_ACCESS'" class="fixed-action-btn new-transaction-button">
+        <a class="btn-floating btn-large btn waves-effect waves-light background-blue" id="button-new-transaction">
+            <i class="material-icons left">add</i><t:block t:text="loc.get('title.transaction.new.short')">new</t:block>
+        </a>
+        <ul t:class="listClasses">
+            <li>
+                <a t:href="@{/templates}" class="btn-floating btn background-blue-baby"><i class="material-icons">file_copy</i></a>
+                <a t:href="@{/templates}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new.from.template')">template</a>
+            </li>
+            <li>
+                <a t:href="@{/transactions/newTransaction/transfer}" class="btn-floating btn background-green-dark"><i class="material-icons">swap_horiz</i></a>
+                <a t:href="@{/transactions/newTransaction/transfer}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new.transfer')">transfer</a>
+            </li>
+            <li>
+                <a t:href="@{/transactions/newTransaction/normal}" class="btn-floating btn background-orange"><i class="material-icons">payment</i></a>
+                <a t:href="@{/transactions/newTransaction/normal}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="loc.get('title.transaction.new.normal')">normal</a>
+            </li>
+        </ul>
+    </div>
+</t:block>
+
+<a t:fragment="buttonFilter(boolean isFilterActive)" href="#modalFilter" id="modalFilterTrigger"
+   t:class="isFilterActive ? 'modal-trigger waves-effect waves-light btn background-red' : 'modal-trigger waves-effect waves-light btn background-blue'"><i class="fas fa-filter left"></i><t:block t:text="isFilterActive ? loc.get('filter.active') : loc.get('title.filter')">filter</t:block></a>
+</t:block>
