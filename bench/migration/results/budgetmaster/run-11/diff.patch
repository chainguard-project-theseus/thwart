@@ -0,0 +1,195 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.filter.FilterConfiguration">
+<!--/*
+  Fragments (converted from filterMacros.ftl), all without FreeMarker defaults except filterModalContent:
+  - buttons, buttonReset, buttonApply, buttonResetChart, buttonClose, buttonCloseModal, buttonsAllOrNone   (no params)
+  - filterModal(FilterConfiguration filterConfiguration)   (the whole #modalFilter with its POST form to /filter/apply)
+  - filterModalContent(FilterConfiguration filterConfiguration, String prefix)
+      FreeMarker default prefix="" -> pass ''. charts: filterModalContent(chartSettings.filterConfiguration, 'filterConfiguration')
+*/-->
+
+<t:block t:fragment="buttons">
+    <div class="row hide-on-small-only no-margin-bottom">
+        <div class="col s12 right-align">
+            <a t:replace="~{filter/filterMacros :: buttonCloseModal}"></a>
+            <a t:replace="~{filter/filterMacros :: buttonReset}"></a>
+            <button t:replace="~{filter/filterMacros :: buttonApply}"></button>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up valign-wrapper no-margin-bottom">
+        <div class="row center-align">
+            <div class="col s12">
+                <a t:replace="~{filter/filterMacros :: buttonCloseModal}"></a>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
+                <a t:replace="~{filter/filterMacros :: buttonReset}"></a>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
+                <button t:replace="~{filter/filterMacros :: buttonApply}"></button>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<a t:fragment="buttonReset" t:href="@{/filter/reset}" class="waves-effect waves-light btn background-blue"><i class="material-icons left">settings_backup_restore</i><t:block t:text="loc.get('filter.reset')">reset</t:block></a>
+
+<button t:fragment="buttonApply" class="btn waves-effect waves-light background-green" type="submit" id="buttonApplyFilter">
+    <i class="fas fa-filter left"></i><t:block t:text="loc.get('filter.apply')">apply</t:block>
+</button>
+
+<a t:fragment="buttonResetChart" class="filter-button-reset waves-effect waves-light btn background-blue"><i class="material-icons left">settings_backup_restore</i><t:block t:text="loc.get('filter.reset')">reset</t:block></a>
+
+<a t:fragment="buttonClose" class="filter-button-close waves-effect waves-light background-blue btn white-text"><i class="fas fa-filter left"></i><t:block t:text="loc.get('filter.apply')">apply</t:block></a>
+
+<t:block t:fragment="buttonCloseModal">
+    <a t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false, '')}"></a>
+</t:block>
+
+<div t:fragment="buttonsAllOrNone" class="row no-margin">
+    <div class="col s6 right-align">
+        <a class="waves-effect waves-light btn background-blue filter-button-all" t:text="loc.get('filter.tags.button.all')">all</a>
+    </div>
+    <div class="col s6">
+        <a class="waves-effect waves-light btn background-blue filter-button-none" t:text="loc.get('filter.tags.button.none')">none</a>
+    </div>
+</div>
+
+<div t:fragment="filterModal(FilterConfiguration filterConfiguration)" id="modalFilter" class="modal modal-fixed-footer background-color">
+    <div class="modal-content">
+        <h4 t:text="loc.get('title.filter')">filter</h4>
+        <form name="NewFilterConfiguration" t:action="@{/filter/apply}" method="post">
+            <t:block t:replace="~{filter/filterMacros :: filterModalContent(filterConfiguration, '')}"></t:block>
+        </form>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{filter/filterMacros :: buttons}"></t:block>
+    </div>
+</div>
+
+<div t:fragment="filterModalContent(FilterConfiguration filterConfiguration, String prefix)" class="row"
+     t:with="prefixValue=strings.isEmpty(prefix) ? '' : prefix + '.'">
+        <div class="col s12">
+            <ul class="collapsible z-depth-2" id="filterSettings">
+                <li id="section-type">
+                    <div class="collapsible-header">
+                        <i class="fas fa-piggy-bank"></i>
+                        <t:block t:text="loc.get('filter.type')">type</t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                    <div class="collapsible-body">
+                        <div class="row no-margin">
+                            <div class="col s12 m4 l4">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeIncome'" t:checked="filterConfiguration.includeIncome">
+                                    <span class="text-default" t:text="loc.get('filter.type.income')">income</span>
+                                </label>
+                            </div>
+                            <div class="col s12 m4 l4">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeExpenditure'" t:checked="filterConfiguration.includeExpenditure">
+                                    <span class="text-default" t:text="loc.get('filter.type.expenditure')">expenditure</span>
+                                </label>
+                            </div>
+                            <div class="col s12 m4 l4">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeTransfer'" t:checked="filterConfiguration.includeTransfer">
+                                    <span class="text-default" t:text="loc.get('filter.type.transfer')">transfer</span>
+                                </label>
+                            </div>
+                        </div>
+                    </div>
+                </li>
+
+                <li id="section-repeating">
+                    <div class="collapsible-header">
+                        <i class="material-icons">repeat</i>
+                        <t:block t:text="loc.get('filter.repeating')">repeating</t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                    <div class="collapsible-body">
+                        <div class="row no-margin">
+                            <div class="col s6 m6 l6">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeNotRepeating'" t:checked="filterConfiguration.includeNotRepeating">
+                                    <span class="text-default" t:text="loc.get('filter.repeating.false')">no</span>
+                                </label>
+                            </div>
+                            <div class="col s6 m6 l6">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeRepeating'" t:checked="filterConfiguration.includeRepeating">
+                                    <span class="text-default" t:text="loc.get('filter.repeating.true')">yes</span>
+                                </label>
+                            </div>
+                        </div>
+                    </div>
+                </li>
+
+                <li id="section-categories">
+                    <div class="collapsible-header">
+                        <i class="material-icons">label</i>
+                        <t:block t:text="loc.get('filter.categories')">categories</t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                    <div class="collapsible-body">
+                        <div t:replace="~{filter/filterMacros :: buttonsAllOrNone}"></div>
+                        <div class="row no-margin">
+                            <div class="col s12">
+                                <div t:each="filterCategory, st : filterConfiguration.filterCategories">
+                                    <label>
+                                        <input type="checkbox" t:name="|${prefixValue}filterCategories['${st.index}'].include|" t:checked="filterCategory.include">
+                                        <span class="text-default" t:text="filterCategory.name">name</span>
+                                    </label>
+                                    <input type="hidden" t:name="|${prefixValue}filterCategories['${st.index}'].ID|" t:value="filterCategory.ID"/>
+                                    <input type="hidden" t:name="|${prefixValue}filterCategories['${st.index}'].name|" t:value="filterCategory.name"/>
+                                </div>
+                            </div>
+                        </div>
+                    </div>
+                </li>
+
+                <li id="section-tags">
+                    <div class="collapsible-header">
+                        <i class="material-icons">local_offer</i>
+                        <t:block t:text="loc.get('filter.tags')">tags</t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                    <div class="collapsible-body">
+                        <div t:replace="~{filter/filterMacros :: buttonsAllOrNone}"></div>
+                        <div class="row no-margin">
+                            <div class="col s12">
+                                <div t:each="filterTag, st : filterConfiguration.filterTags">
+                                    <label>
+                                        <input type="checkbox" t:name="|${prefixValue}filterTags['${st.index}'].include|" t:checked="filterTag.include">
+                                        <span class="text-default" t:text="filterTag.name">name</span>
+                                    </label>
+                                    <input type="hidden" t:name="|${prefixValue}filterTags['${st.index}'].ID|" t:value="filterTag.ID"/>
+                                    <input type="hidden" t:name="|${prefixValue}filterTags['${st.index}'].name|" t:value="filterTag.name"/>
+                                </div>
+                            </div>
+                        </div>
+                    </div>
+                </li>
+
+                <li id="section-name">
+                    <div class="collapsible-header">
+                        <i class="material-icons">subject</i>
+                        <t:block t:text="loc.get('filter.name')">name</t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                    <div class="collapsible-body">
+                        <div class="row no-margin">
+                            <div class="input-field col s12">
+                                <input id="filter-name" type="text" t:name="prefixValue + 'name'" t:value="filterConfiguration.name ?: ''">
+                                <label for="filter-name" t:text="loc.get('filter.name.contains')">contains</label>
+                            </div>
+                        </div>
+                    </div>
+                </li>
+            </ul>
+        </div>
+</div>
+</t:block>
