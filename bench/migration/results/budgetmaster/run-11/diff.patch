+        <input id="search-datepicker" type="text" class="datepicker" name="startDate" t:value="search.startDate == null ? '' : bm.longDate(search.startDate)">
+        <label for="search-datepicker" t:text="loc.get('chart.steps.second.label.start')">start</label>
+    </div>
+
+    <div class="input-field col s6 m4 l3" id="search-datepicker-end-container">
+        <script t:if="search.endDate != null">
+            var endDate = [[${bm.longDate(search.endDate)}]];
+            endDate = endDate.split(".");
+            endDate = new Date(endDate[2], endDate[1] - 1, endDate[0]);
+        </script>
+        <script t:if="search.endDate == null">
+            endDate = null;
+        </script>
+
+        <i class="material-icons prefix">event</i>
+        <input id="search-datepicker-end" type="text" class="datepicker" name="endDate" t:value="search.endDate == null ? '' : bm.longDate(search.endDate)">
+        <label for="search-datepicker-end" t:text="loc.get('chart.steps.second.label.end')">end</label>
+    </div>
+</div>
+
+<div t:fragment="pagination(SearchResultPage page, String position)" t:class="|row pagination-position-${position}|">
+    <div class="col s12 center-align">
+        <ul t:if="page.totalPages > 0" class="pagination">
+            <li t:class="page.number == 0 ? 'text-default disabled' : 'text-default '"><a class="page-link" t:data-page="page.number - 1"><i class="material-icons">chevron_left</i></a></li>
+            <li t:each="i : numbers.sequence(0, page.totalPages - 1)" t:class="page.number == i ? 'waves-effect text-default active' : 'waves-effect text-default '"><a class="page-link" t:data-page="i" t:text="i + 1">1</a></li>
+            <li t:class="page.number == page.totalPages - 1 ? 'text-default disabled' : 'text-default '"><a class="page-link" t:data-page="page.number + 1"><i class="material-icons">chevron_right</i></a></li>
+        </ul>
+    </div>
+</div>
+
+<t:block t:fragment="renderTransactions(List<Transaction> transactions, boolean openLinksInNewTab)">
+    <div t:each="transaction : transactions" class="card-panel search-result">
+        <div class="hide-on-large-only">
+            <div class="row valign-wrapper">
+                <div class="col s3 center-align bold transaction-text" t:text="bm.dateNormal(transaction.date)">date</div>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction)}"></t:block>
+                <div t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 's2')}"></div>
+                <div t:replace="~{transactions/transactionsMacros :: transactionLinks(transaction, openLinksInNewTab ? '_blank' : '')}"></div>
+            </div>
+            <div class="row valign-wrapper no-margin-bottom">
+                <div t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'center-align')}"></div>
+                <div t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 's5')}"></div>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(transaction, transaction.account, 's4')}"></t:block>
+            </div>
+        </div>
+        <div class="hide-on-med-and-down">
+            <div class="row valign-wrapper no-margin-bottom transaction-row-desktop">
+                <div class="col l2 xl1 bold transaction-text transaction-date valign-wrapper" t:text="bm.dateNormal(transaction.date)">date</div>
+                <div t:replace="~{transactions/transactionsMacros :: transactionCategory(transaction, 'left-align')}"></div>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(transaction)}"></t:block>
+                <div t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 'l1 xl1')}"></div>
+                <div t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 'l3 xl4')}"></div>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(transaction, transaction.account, 'l2 xl2')}"></t:block>
+                <div t:replace="~{transactions/transactionsMacros :: transactionLinks(transaction, openLinksInNewTab ? '_blank' : '')}"></div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+</t:block>
