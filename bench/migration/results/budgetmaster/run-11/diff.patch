diff --git a/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html b/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html
new file mode 100644
index 00000000..c9a0c47d
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html
@@ -0,0 +1,101 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.transactions.csvimport.CsvTransaction, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templating.FormErrors"
+      t:params="List<Notification> notifications, boolean isEdit, Template template, List<Category> categories, List<Account> accounts, String suggestionsJSON, List<String> fontawesomeIcons, FormErrors error, CsvTransaction currentCsvTransaction"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + (isEdit ? loc.get('title.template.edit') : loc.get('title.template.new')), ~{::page-head}, ~{::body})}">
+<page-head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+</page-head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="isEdit ? loc.get('title.template.edit') : loc.get('title.template.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <div class="container">
+                    <form id="mainForm" name="NewTemplate" t:action="@{/templates/newTemplate}" method="post">
+                        <input type="hidden" name="ID" t:value="template.ID == null ? '' : '' + template.ID">
+                        <input type="hidden" name="templateGroup" t:value="template.templateGroup == null ? '' : '' + template.templateGroup.ID">
+
+                        <!--/* isPayment switch */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: isExpenditureSwitch(template)}"></t:block>
+
+                        <!--/* template name */-->
+                        <t:block t:replace="~{templates/templateFunctions :: templateNameInput(template, error)}"></t:block>
+
+                        <!--/* name */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(template, suggestionsJSON, error)}"></t:block>
+
+                        <!--/* amount */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(template, error)}"></t:block>
+
+                        <!--/* category */-->
+                        <t:block t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, template.category, 'col s12 m12 l8 offset-l2', loc.get('transaction.new.label.category'), 'transaction-category', true, '', false, '')}"></t:block>
+
+                        <!--/* description */-->
+                        <div t:replace="~{transactions/newTransactionMacros :: transactionDescription(template, error)}"></div>
+
+                        <!--/* tags */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(template)}"></t:block>
+
+                        <!--/* account */-->
+                        <t:block t:if="template.account != null">
+                            <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-account', 'includeAccount', loc.get('template.checkbox.include.account'), true)}"></t:block>
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('account-select-wrapper', 'account', accounts, template.account, 'col s12 m12 l8 offset-l2', '', 'transaction-account', false)}"></t:block>
+                        </t:block>
+                        <t:block t:if="template.account == null">
+                            <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-account', 'includeAccount', loc.get('template.checkbox.include.account'), false)}"></t:block>
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('account-select-wrapper', 'account', accounts, bm.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', '', 'transaction-account', true)}"></t:block>
+                        </t:block>
+
+                        <!--/* transfer account */-->
+                        <t:block t:if="template.transferAccount != null">
+                            <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-transfer-account', 'includeTransferAccount', loc.get('template.checkbox.include.account.transfer'), true)}"></t:block>
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, template.transferAccount, 'col s12 m12 l8 offset-l2', '', 'transaction-destination-account', false)}"></t:block>
+                        </t:block>
+                        <t:block t:if="template.transferAccount == null">
+                            <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-transfer-account', 'includeTransferAccount', loc.get('template.checkbox.include.account.transfer'), false)}"></t:block>
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, bm.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', '', 'transaction-destination-account', true)}"></t:block>
+                        </t:block>
+
+                        <!--/* icon */-->
+                        <div t:replace="~{helpers/iconSelect :: iconSelect('template-icon', template, false, '', '', true)}"></div>
+
+                        <!--/* font color */-->
+                        <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(template)}"></t:block>
+
+                        <!--/* buttons */-->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: buttons(currentCsvTransaction != null ? '/transactionImport' : '/templates', false, true)}"></t:block>
+                    </form>
+
+                    <div id="transactionNameKeywordWarningModalContainer"></div>
+                </div>
+                </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <div t:replace="~{helpers/iconSelect :: modalIconSelect('template-name', template, fontawesomeIcons)}"></div>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization}"></t:block>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+</body>
+</html>
