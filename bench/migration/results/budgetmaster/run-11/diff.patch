@@ -0,0 +1,99 @@
+package de.deadlocker8.budgetmaster.templating;
+
+import de.deadlocker8.budgetmaster.accounts.Account;
+import de.deadlocker8.budgetmaster.categories.Category;
+import de.deadlocker8.budgetmaster.icon.Iconizable;
+import de.deadlocker8.budgetmaster.templates.Template;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Functions for the icon select / font color picker helpers and the account, category and tag views.
+ */
+@TemplateFunctions("acc")
+public final class AccFunctions
+{
+	private AccFunctions()
+	{
+	}
+
+	/**
+	 * FreeMarker {@code item.getColor()} on an Iconizable (only categories have a color)
+	 */
+	@TemplateFunction
+	public static String iconColor(Iconizable item)
+	{
+		if(item instanceof Category category)
+		{
+			return category.getColor();
+		}
+		return null;
+	}
+
+	/**
+	 * FreeMarker {@code item.getName()} on an Iconizable
+	 */
+	@TemplateFunction
+	public static String iconName(Iconizable item)
+	{
+		if(item instanceof Category category)
+		{
+			return category.getName();
+		}
+		if(item instanceof Account account)
+		{
+			return account.getName();
+		}
+		if(item instanceof Template template)
+		{
+			return template.getName();
+		}
+		return null;
+	}
+
+	/**
+	 * FreeMarker {@code item.getDefaultFontColor(settings.isUseDarkTheme())}
+	 */
+	@TemplateFunction
+	public static String defaultFontColor(Iconizable item)
+	{
+		return item.getDefaultFontColor(BudgetMasterFunctions.darkTheme());
+	}
+
+	/**
+	 * Splits a list into consecutive rows of {@code size} elements (the last row may be shorter).
+	 */
+	@TemplateFunction
+	public static List<List<String>> chunk(List<String> items, int size)
+	{
+		final List<List<String>> rows = new ArrayList<>();
+		for(int i = 0; i < items.size(); i += size)
+		{
+			rows.add(items.subList(i, Math.min(items.size(), i + size)));
+		}
+		return rows;
+	}
+
+	/**
+	 * FreeMarker {@code ?abs}
+	 */
+	@TemplateFunction
+	public static long abs(Long value)
+	{
+		return value == null ? 0 : Math.abs(value);
+	}
+
