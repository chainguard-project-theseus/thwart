diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/iconSelect.html b/BudgetMasterServer/src/main/resources/templates/helpers/iconSelect.html
new file mode 100644
index 00000000..b76c1eb7
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/iconSelect.html
@@ -0,0 +1,163 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.icon.Iconizable">
+
+<!--/*
+  Converted from helpers/iconSelect.ftl. Fragments (no defaults: pass the FreeMarker defaults explicitly):
+
+  iconSelect(String id, Iconizable item, boolean showBackground, String initialBackgroundClasses, String backgroundClasses, boolean preventFallbackIcon)
+      FreeMarker defaults: showBackground=true initialBackgroundClasses='' backgroundClasses='' preventFallbackIcon=false
+      The background color is acc.iconColor(item) (Category.color; other Iconizables have none, so pass showBackground=false),
+      the fallback letter is the first letter of acc.iconName(item).
+      e.g. ~{helpers/iconSelect :: iconSelect('template-icon', template, false, '', '', true)}
+
+  modalIconSelect(String idToFocusOnClose, Iconizable item, List<String> fontawesomeIcons)
+      fontawesomeIcons is the model attribute "fontawesomeIcons" the macro read implicitly: declare it in t:params and pass it.
+      idToFocusOnClose must be one of 'account-name', 'category-name', 'template-name' (data-* only takes a choice between
+      literals; extend the choice below for a new caller).
+
+  Page needs: <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>, <script t:src="@{/js/iconSelect.js}"></script>.
+  Images in the modal are loaded via AJAX from helpers/availableImages (now served as /media/getImage/{id} instead of data: URLs).
+*/-->
+
+<div t:fragment="iconSelect(String id, Iconizable item, boolean showBackground, String initialBackgroundClasses, String backgroundClasses, boolean preventFallbackIcon)"
+     class="row"
+     t:with="hasImageIcon=item.iconReference != null && item.iconReference.imageIcon, hasBuiltinIcon=item.iconReference != null && item.iconReference.builtinIcon">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <i class="fas fa-icons prefix"></i>
+        <label class="input-label" t:for="id" t:text="loc.get('account.new.label.icon')">Icon</label>
+
+        <div t:id="id" class="valign-wrapper item-icon">
+            <div class="item-icon-preview-container">
+                <a id="item-icon-preview" t:style="|color: ${css.color(bm.fontColor(item, bm.darkTheme()))}|">
+                    <script>
+                        var iconSelectAdditionalBackgroundClasses = [[${backgroundClasses}]];
+                    </script>
+                    <div id="item-icon-preview-background"
+                         t:class="|category-circle category-circle-preview ${bm.settings().showCategoriesAsCircles == false ? 'category-square' : ''} ${initialBackgroundClasses}|"
+                         t:style="showBackground ? |background-color: ${css.color(acc.iconColor(item))}| : 'background-color: '">
+                        <i id="builtin-icon-preview-icon" t:class="hasBuiltinIcon ? item.iconReference.builtinIdentifier : 'hidden'"></i>
+                        <img id="item-icon-preview-icon" t:src="hasImageIcon ? @{/media/getImageByIconID/{iconId}(iconId=item.iconReference.ID)} : ''"
+                             t:class="|item-icon-preview category-icon ${hasImageIcon ? '' : 'hidden'}|"/>
+                        <span t:unless="preventFallbackIcon" id="item-icon-fallback-name" t:class="hasBuiltinIcon || hasImageIcon ? 'hidden' : ''"
+                              t:text="bm.firstLetterCapitalized(acc.iconName(item))">A</span>
+                    </div>
+                </a>
+                <a t:replace="~{helpers/header :: buttonFlat('', 'delete', '', '', 'no-padding text-default button-remove-icon-from-item', true, '', '')}"></a>
+            </div>
+
+            <div id="item-icon-placeholder" t:text="loc.get('account.new.icon.placeholder')">placeholder</div>
+
+            <input id="hidden-input-icon-image-id" type="hidden" name="iconImageID" t:value="hasImageIcon ? '' + item.iconReference.image.ID : ''">
+            <input id="hidden-input-icon-builtin-identifier" type="hidden" name="builtinIconIdentifier" t:value="hasBuiltinIcon ? item.iconReference.builtinIdentifier : ''">
+        </div>
+    </div>
+</div>
+
+
+<div t:fragment="modalIconSelect(String idToFocusOnClose, Iconizable item, List<String> fontawesomeIcons)"
+     id="modalIconSelect" class="modal modal-fixed-footer background-color"
+     t:data-focus-on-close="idToFocusOnClose == 'account-name' ? 'account-name' : (idToFocusOnClose == 'category-name' ? 'category-name' : 'template-name')"
+     t:with="hasImageIcon=item.iconReference != null && item.iconReference.imageIcon">
+    <div class="modal-content center-align">
+        <div class="row">
+            <div class="col s12">
+                <ul class="tabs" id="iconTabs">
+                    <li class="tab col s6"><a t:class="|text-blue valign-wrapper ${hasImageIcon ? '' : 'active'}|" href="#tabBuiltinIcons" data-name="builtinIcons"><i class="fas fa-icons"></i> <t:block t:text="loc.get('icons.builtin')">builtin</t:block></a></li>
+                    <li class="tab col s6"><a t:class="|text-blue valign-wrapper ${hasImageIcon ? 'active' : ''}|" href="#tabImages" data-name="images"><i class="fas fa-image"></i> <t:block t:text="loc.get('icons.images')">images</t:block></a></li>
+                </ul>
+            </div>
+            <div id="tabBuiltinIcons" class="col s12"><t:block t:replace="~{helpers/iconSelect :: tabBuiltinIcons(item, fontawesomeIcons)}"></t:block></div>
+            <div id="tabImages" class="col s12"><t:block t:replace="~{helpers/iconSelect :: tabImages(item)}"></t:block></div>
+        </div>
+    </div>
+    <div class="modal-footer background-color">
+        <a t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', true, false, '')}"></a>
+        <a t:replace="~{helpers/header :: buttonLink('', 'done', 'ok', 'button-icon-confirm', 'green', 'modal-action modal-close text-white', true, true, '')}"></a>
+    </div>
+</div>
+
+<t:block t:fragment="tabImages(Iconizable item)">
+    <div class="row">
+        <div class="col s12">
+            <div class="headline" t:text="loc.get('upload.image.headline')">upload</div>
+        </div>
+    </div>
+
+    <div class="row">
+        <t:block t:replace="~{helpers/iconSelect :: uploadImageForm}"></t:block>
+    </div>
+
+    <hr>
+
+    <div class="row">
+        <div class="col s12">
+            <div class="headline" t:text="loc.get('available.images')">available</div>
+        </div>
+    </div>
+
+    <t:block t:replace="~{helpers/iconSelect :: progressIndicator}"></t:block>
+
+    <div class="row" id="available-images"
+         t:data-url="item.iconReference != null && item.iconReference.imageIcon ? @{/media/getAvailableImages/{imageId}(imageId=item.iconReference.image.ID)} : @{/media/getAvailableImages}">
+    </div>
+</t:block>
+
+<t:block t:fragment="tabBuiltinIcons(Iconizable item, List<String> fontawesomeIcons)"
+         t:with="selectedIconName=item.iconReference != null && item.iconReference.builtinIcon ? item.iconReference.builtinIdentifier : ''">
+    <div class="row no-margin-bottom">
+        <div class="input-field col s12 m12 l8 offset-l2">
+            <i class="material-icons prefix">search</i>
+            <input id="searchIcons" type="text" onchange="searchBuiltinIcons();" onkeypress="searchBuiltinIcons();" onpaste="searchBuiltinIcons()" oninput="searchBuiltinIcons();">
+            <label for="searchIcons" t:text="loc.get('search')">search</label>
+        </div>
+    </div>
+    <div class="row">
+        <div class="col s12 center-align" id="numberOfIcons"><span id="numberOfMatchingIcons" t:text="fontawesomeIcons.size()">0</span>/[[${fontawesomeIcons.size()}]] [[${loc.get('icons.numberOf')}]]</div>
+    </div>
+
+    <hr>
+
+    <div class="row">
+        <div t:each="icon : fontawesomeIcons" class="col s4 m2 l2 builtin-icon-option-column">
+            <div t:class="|builtin-icon-option ${selectedIconName == icon ? 'selected' : ''}|">
+                <i t:class="|builtin-icon-option-icon ${icon}|"></i>
+                <div class="builtin-icon-option-name truncate" t:text="icon">icon</div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="uploadImageForm">
+    <form id="form-upload-image" method="post" t:action="@{/media/uploadImage}" enctype="multipart/form-data">
+        <div class="file-field input-field col s12">
+            <div class="container">
+                <div class="btn background-blue">
+                    <i class="material-icons left">folder</i>
+                    [[${loc.get('account.new.icon.upload.choose.file')}]]
+                    <input id="inputUploadFile" type="file" t:accept="bm.validImageUploadTypes()" name="file">
+                </div>
+                <div class="file-path-wrapper">
+                    <input class="file-path validate" type="text">
+                </div>
+                <a t:replace="~{helpers/header :: buttonLink('', 'upload', 'account.new.icon.upload', 'button-upload-new-image', 'background-blue', 'right', true, false, '')}"></a>
+            </div>
+        </div>
+    </form>
+
+    <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.icon.upload.image.size'), 'fas fa-info', '')}"></t:block>
+</t:block>
+
+<div t:fragment="progressIndicator" class="preloader-wrapper active margin" id="progressIndicator">
+    <div class="spinner-layer spinner-blue-only">
+        <div class="circle-clipper left">
+            <div class="circle"></div>
+        </div>
+        <div class="gap-patch">
+            <div class="circle"></div>
+        </div>
+        <div class="circle-clipper right">
+            <div class="circle"></div>
+        </div>
+    </div>
+</div>
+
+</t:block>
