+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.categories.Category">
+
+<!--/* getCategoryName is the function bm.categoryName(category) */-->
+
+<!--/* FreeMarker defaults: classes="" datasetValue=false enableSearchWrapper=false */-->
+<t:block t:fragment="categoryCircle(Category category, String classes, boolean datasetValue, boolean enableSearchWrapper)">
+    <a t:if="enableSearchWrapper" t:href="'/search?searchCategory=true&searchText=' + category.name">
+        <div t:replace="~{categories/categoriesFunctions :: categoryCircleInner(category, classes, datasetValue)}"></div>
+    </a>
+    <div t:unless="enableSearchWrapper" t:replace="~{categories/categoriesFunctions :: categoryCircleInner(category, classes, datasetValue)}"></div>
+</t:block>
+
+<div t:fragment="categoryCircleInner(Category category, String classes, boolean datasetValue)"
+     t:class="|category-circle ${classes} ${bm.settings().showCategoriesAsCircles == false ? 'category-square' : ''}|"
+     t:style="|background-color: ${css.color(category.color)}|" t:data-value="datasetValue ? category.ID">
+    <span t:style="|color: ${css.color(bm.fontColor(category, bm.darkTheme()))}|">
