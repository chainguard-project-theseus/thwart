diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/customSelectMacros.html b/BudgetMasterServer/src/main/resources/templates/helpers/customSelectMacros.html
new file mode 100644
index 00000000..1f85e702
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/customSelectMacros.html
@@ -0,0 +1,153 @@
+<t:block xmlns:t="https://tessera.dev"
+         t:import="de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState">
+
+<!--/* FreeMarker customSelectStart ... customSelectEnd: options and the hidden input are passed as fragments.
+       FreeMarker defaults: disabled=false rowClasses="" */-->
+<div t:fragment="customSelect(String selector, String inputClasses, String labelText, String id, String icon, boolean disabled, String rowClasses, Fragment options, Fragment hiddenInput)"
+     t:class="|row ${rowClasses}|">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix" t:text="icon">icon</i>
+        <label t:unless="strings.isEmpty(labelText)" class="input-label" t:for="id" t:text="labelText">label</label>
+        <div t:class="|custom-select-wrapper ${selector} ${disabled ? 'disabled' : ''}|" t:id="id">
+            <div class="custom-select">
+                <t:block t:replace="options"></t:block>
+            </div>
+            <t:block t:replace="hiddenInput"></t:block>
+        </div>
+    </div>
+</div>
+
+<!--/* FreeMarker defaults: showName=true rowClasses="" disabled=false form="" ; selectedCategory may be null */-->
+<t:block t:fragment="customCategorySelect(List<Category> categories, Category selectedCategory, String inputClasses, String labelText, String id, boolean showName, String rowClasses, boolean disabled, String form)">
+    <div t:replace="~{helpers/customSelectMacros :: customSelect('category-select-wrapper', inputClasses, labelText, id, 'label', disabled, rowClasses, ~{::category-options}, ~{::category-hidden})}">
+        <category-options t:remove="tag">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:if="selectedCategory != null" t:replace="~{helpers/customSelectMacros :: customSelectOptionCategoryContent(selectedCategory, 'no-margin-left', true, showName)}"></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="category : categories">
+                    <t:block t:unless="category.type == 'REST'">
+                        <div t:if="selectedCategory != null" t:replace="~{helpers/customSelectMacros :: customSelectCategoryOption(category, selectedCategory.ID == category.ID)}"></div>
+                        <div t:if="selectedCategory == null" t:replace="~{helpers/customSelectMacros :: customSelectCategoryOption(category, category.type == 'NONE')}"></div>
+                    </t:block>
+                </t:block>
+            </div>
+        </category-options>
+        <category-hidden t:remove="tag">
+            <input type="hidden" name="category" class="hidden-input-custom-select" t:value="selectedCategory?.ID" t:form="strings.isEmpty(form) ? null : form"/>
+        </category-hidden>
+    </div>
+</t:block>
+
+<!--/* FreeMarker defaults: disabled=false ; selectedAccount may be null */-->
+<t:block t:fragment="customAccountSelect(String selector, String inputName, List<Account> accounts, Account selectedAccount, String inputClasses, String labelText, String id, boolean disabled)">
+    <div t:replace="~{helpers/customSelectMacros :: customSelect(selector, inputClasses, labelText, id, 'account_balance', disabled, '', ~{::account-options}, ~{::account-hidden})}">
+        <account-options t:remove="tag">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:if="selectedAccount != null" t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountContent(selectedAccount, 'no-margin-left')}"></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="account : accounts">
+                    <t:block t:if="account.type == 'CUSTOM'">
+                        <div t:replace="~{helpers/customSelectMacros :: customSelectAccountOption(account, selectedAccount != null && selectedAccount.ID == account.ID)}"></div>
+                    </t:block>
+                </t:block>
+            </div>
+        </account-options>
+        <account-hidden t:remove="tag">
+            <input type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedAccount?.ID"/>
+        </account-hidden>
+    </div>
+</t:block>
+
+<div t:fragment="globalAccountSelect" class="input-field no-margin">
+    <div class="custom-select-wrapper global-account-select-wrapper">
+        <div class="custom-select">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountContent(bm.currentAccount(), 'no-margin-left')}"></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="account : bm.allReadableAccounts()"><div t:replace="~{helpers/customSelectMacros :: customSelectAccountOption(account, account.isSelected() == true)}"></div></t:block>
+            </div>
+        </div>
+
+        <input type="hidden" class="hidden-input-custom-select" t:value="bm.currentAccount().ID"/>
+    </div>
+</div>
+
+<!--/* selectedState may be null */-->
+<t:block t:fragment="customAccountStateSelect(String selector, String inputName, List<AccountState> availableStates, AccountState selectedState, String inputClasses, String labelText, String id)">
+    <div t:replace="~{helpers/customSelectMacros :: customSelect(selector, inputClasses, labelText, id, 'visibility', false, '', ~{::state-options}, ~{::state-hidden})}">
+        <state-options t:remove="tag">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:if="selectedState != null" t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountStateContent(selectedState, 'no-margin-left')}"></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="state : availableStates"><div t:replace="~{helpers/customSelectMacros :: customSelectAccountStateOption(state, selectedState == state)}"></div></t:block>
+            </div>
+        </state-options>
+        <state-hidden t:remove="tag">
+            <input type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedState == null ? null : (selectedState == 'FULL_ACCESS' ? 'FULL_ACCESS' : (selectedState == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN'))"/>
+        </state-hidden>
+    </div>
+</t:block>
+
+<div t:fragment="customSelectCategoryOption(Category category, boolean isSelected)" t:class="isSelected ? 'custom-select-option selected' : 'custom-select-option '" t:data-value="category.ID">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionCategoryContent(category, '', false, true)}"></t:block>
+</div>
+
+<!--/* FreeMarker defaults: classes="" datasetValue=false showName=true */-->
+<t:block t:fragment="customSelectOptionCategoryContent(Category category, String classes, boolean datasetValue, boolean showName)">
+    <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(category, 'category-circle-small ' + classes, datasetValue, false)}"></t:block>
+    <span t:if="showName" class="custom-select-item-name" t:text="bm.categoryName(category)">name</span>
+</t:block>
+
+<div t:fragment="customSelectAccountOption(Account account, boolean isSelected)" t:class="isSelected ? 'custom-select-option selected' : 'custom-select-option '" t:data-value="account.ID">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountContent(account, '')}"></t:block>
+</div>
+
+<!--/* FreeMarker default: classes="". The FreeMarker call `datasetValue=""` after positional arguments was evaluated as
+       the comparison datasetValue == "" (true), so the icon always carried data-value. */-->
+<t:block t:fragment="customSelectOptionAccountContent(Account account, String classes)">
+    <t:block t:with="accountName=(account.type == 'ALL' ? loc.get('account.all') : account.name)">
+        <div t:replace="~{helpers/customSelectMacros :: accountIcon(account, accountName, 'category-circle-small ' + classes, true)}"></div>
+        <span class="custom-select-item-name" t:text="accountName">name</span>
+    </t:block>
+</t:block>
+
+<!--/* FreeMarker datasetValue (non-empty string) is the boolean datasetValue */-->
+<div t:fragment="accountIcon(Account account, String accountName, String classes, boolean datasetValue)"
+     t:class="|category-circle ${classes} category-square ${account.iconReference != null && account.iconReference.fallbackIcon ? 'account-square-border' : ''}|"
+     t:data-value="datasetValue ? account.ID">
+    <span t:style="|color: ${css.color(bm.fontColor(account, bm.darkTheme()))}|">
+        <t:block t:replace="~{helpers/header :: entityIcon(account, 'account-select-icon', accountName)}"></t:block>
+    </span>
+</div>
+
+<div t:fragment="customSelectAccountStateOption(AccountState state, boolean isSelected)" t:class="isSelected ? 'custom-select-option selected' : 'custom-select-option '"
+     t:data-value="state == 'FULL_ACCESS' ? 'FULL_ACCESS' : (state == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN')">
+    <t:block t:replace="~{helpers/customSelectMacros :: customSelectOptionAccountStateContent(state, '')}"></t:block>
+</div>
+
+<t:block t:fragment="customSelectOptionAccountStateContent(AccountState state, String classes)">
+    <div t:class="|category-circle category-circle-small ${classes}|" t:data-value="state == 'FULL_ACCESS' ? 'FULL_ACCESS' : (state == 'READ_ONLY' ? 'READ_ONLY' : 'HIDDEN')">
+        <span class="text-blue">
+            <i t:class="state.icon"></i>
+        </span>
+    </div>
+    <span class="custom-select-item-name" t:text="loc.get(state.localizationKey)">name</span>
+</t:block>
+
+</t:block>
