+package de.deadlocker8.budgetmaster.templating;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Replaces the FreeMarker macro helpers/validation.ftl.
+ * Usage on the validated element:
+ * {@code t:class="val.cls(error, 'name', '')" t:data-position="val.has(error, 'name') ? 'bottom'" t:data-delay="val.has(error, 'name') ? 50" t:title="val.message(error, 'name')"}
+ */
+@TemplateFunctions("val")
+public final class ValidationFunctions
+{
+	private ValidationFunctions()
+	{
+	}
+
+	@TemplateFunction
+	public static boolean has(FormErrors error, String fieldName)
+	{
+		return error != null && error.fieldCodes().containsKey(fieldName);
+	}
+
+	/**
+	 * class attribute value written by the old validation macro
+	 */
+	@TemplateFunction
+	public static String cls(FormErrors error, String fieldName, String classes)
+	{
+		final String suffix = classes == null ? "" : classes;
+		return has(error, fieldName) ? "tooltipped invalid " + suffix : "validate " + suffix;
+	}
+
+	/**
+	 * localized message of the first field error, or null if the field has none
+	 */
+	@TemplateFunction
+	public static String message(FormErrors error, String fieldName)
+	{
+		return has(error, fieldName) ? error.fieldMessages().get(fieldName) : null;
+	}
+}
diff --git a/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/templating/ViewModelInterceptor.java b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/templating/ViewModelInterceptor.java
new file mode 100644
index 00000000..3b90a45e
--- /dev/null
+++ b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/templating/ViewModelInterceptor.java
@@ -0,0 +1,53 @@
+package de.deadlocker8.budgetmaster.templating;
+
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import jakarta.servlet.http.HttpSession;
+import org.springframework.validation.Errors;
+import org.springframework.web.servlet.HandlerInterceptor;
+import org.springframework.web.servlet.ModelAndView;
+
+import java.util.Collections;
+import java.util.Map;
+
+/**
+ * Prepares the model for the Tessera views:
+ * <ul>
+ *     <li>exposes the session attributes, as FreeMarker did with {@code spring.freemarker.expose-session-attributes=true}</li>
+ *     <li>replaces the {@code BindingResult} stored as "error" by the view-safe {@link FormErrors}</li>
+ * </ul>
+ */
+public class ViewModelInterceptor implements HandlerInterceptor
+{
+	@Override
+	public void postHandle(HttpServletRequest request, HttpServletResponse response, Object handler, ModelAndView modelAndView)
+	{
+		if(modelAndView == null || !modelAndView.isReference())
+		{
+			return;
+		}
+		final String viewName = modelAndView.getViewName();
+		if(viewName == null || viewName.startsWith("redirect:") || viewName.startsWith("forward:"))
+		{
+			return;
+		}
+
+		final Map<String, Object> model = modelAndView.getModel();
+		final HttpSession session = request.getSession(false);
+		if(session != null)
+		{
+			for(String name : Collections.list(session.getAttributeNames()))
+			{
+				if(!model.containsKey(name))
+				{
+					model.put(name, session.getAttribute(name));
+				}
+			}
+		}
+
+		if(model.get("error") instanceof Errors errors)
+		{
+			model.put("error", FormErrors.of(errors));
+		}
+	}
+}
