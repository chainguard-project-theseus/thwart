diff --git a/BudgetMasterServer/src/main/resources/templates/firstUse.html b/BudgetMasterServer/src/main/resources/templates/firstUse.html
new file mode 100644
index 00000000..5714a9e5
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/firstUse.html
@@ -0,0 +1,129 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + loc.get('menu.firstUseGuide'), null, ~{::body})}">
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('firstUseGuide')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="fas fa-graduation-cap"></i> [[${loc.get('home.first.use')}]]</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <br>
+
+                    <!--/* The step texts contain <br>: FreeMarker printed them raw; misc.locLines splits them into lines.
+                           Steps with nested content are written as the DOM a browser built from the old output
+                           (the nested block markup closed the step's <p>, the macro's </p> then opened an empty one). */-->
+                    <div class="container">
+                        <div class="container center-align">
+                            <div class="row left-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{::stepIntro('home.first.use.step.1.headline', 'home.first.use.step.1.contentText')}"></t:block>
+                                    <p>
+                                        <a t:replace="~{indexFunctions :: action('/accounts', 'home.menu.accounts.action.manage')}"></a>
+                                    </p>
+                                </div>
+                            </div>
+                            <hr>
+
+                            <div class="row left-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{::stepIntro('home.first.use.step.2.headline', 'home.first.use.step.2.contentText')}"></t:block>
+                                    <p>
+                                        <a t:replace="~{indexFunctions :: action('/categories', 'home.menu.categories.action.manage')}"></a>
+                                    </p>
+                                </div>
+                            </div>
+                            <hr>
+
+                            <div class="row left-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{::stepIntro('home.first.use.step.3.headline', 'home.first.use.step.3.contentText')}"></t:block>
+                                    <ul class="browser-default">
+                                        <li t:text="loc.get('home.first.use.step.3.sub.1')">sub</li>
+                                        <li t:text="loc.get('home.first.use.step.3.sub.2')">sub</li>
+                                        <li t:text="loc.get('home.first.use.step.3.sub.3')">sub</li>
+                                        <li t:text="loc.get('home.first.use.step.3.sub.4')">sub</li>
+                                        <li t:text="loc.get('home.first.use.step.3.sub.5')">sub</li>
+                                        <li t:text="loc.get('home.first.use.step.3.sub.6')">sub</li>
+                                    </ul>
+                                    <p></p>
+                                    <p>
+                                        <a t:replace="~{indexFunctions :: action('/transactions/newTransaction/normal', 'home.menu.transactions.action.new')}"></a>
+                                    </p>
+                                </div>
+                            </div>
+                            <hr>
+
+                            <div class="row left-align">
+                                <div class="col s12">
+                                    <h5 t:text="loc.get('home.first.use.step.4.headline')">headline</h5>
+                                    <p>
+                                        <t:block t:each="line, st : misc.locLines('home.menu.transactions')">[[${line}]]<br t:unless="st.last"></t:block>
+                                        <br>
+                                        [[${loc.get('home.first.use.step.4.contentText')}]]
+                                    </p>
+                                    <ul class="browser-default">
+                                        <li t:text="loc.get('home.first.use.step.4.sub.1')">sub</li>
+                                        <li t:text="loc.get('home.first.use.step.4.sub.2')">sub</li>
+                                    </ul>
+                                    <p></p>
+                                    <p>
+                                        <a t:replace="~{indexFunctions :: action('/transactions', 'home.menu.transactions.action.manage')}"></a>
+                                    </p>
+                                </div>
+                            </div>
+                            <hr>
+
+                            <div class="row left-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{::stepIntro('home.first.use.step.5.headline', 'home.first.use.step.5.contentText')}"></t:block>
+                                    <h5 t:text="loc.get('menu.transactions.templates')">Templates</h5>
+                                    <p t:text="loc.get('home.first.use.step.5.sub.1')">text</p>
+                                    <p>
+                                        <a t:replace="~{indexFunctions :: action('/templates', 'home.menu.templates.action.manage')}"></a>
+                                    </p>
+
+                                    <h5 t:text="loc.get('menu.charts')">Charts</h5>
+                                    <p t:text="loc.get('home.first.use.step.5.sub.2')">text</p>
+                                    <p>
+                                        <a t:replace="~{indexFunctions :: action('/charts', 'home.menu.charts.action.manage')}"></a>
+                                    </p>
+
+                                    <h5 t:text="loc.get('menu.reports')">Reports</h5>
+                                    <p t:text="loc.get('home.first.use.step.5.sub.3')">text</p>
+                                    <p>
+                                        <a t:replace="~{indexFunctions :: action('/reports', 'home.menu.reports.action.new')}"></a>
+                                    </p>
+
+                                    <h5 t:text="loc.get('home.first.use.step.5.sub.4')">and much more</h5>
+
+                                    <p class="center-align">
+                                        <a t:replace="~{helpers/header :: buttonLink('/', 'home', 'home.first.use.home', '', 'background-blue', '', false, false, '')}"></a>
+                                    </p>
+                                    <p></p>
+                                    <p>
+                                    </p>
+                                </div>
+                            </div>
+                        </div>
+                    </div>
+                </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+</body>
+<!--/* indexFunctions.stepContent without the action paragraph; the text may contain <br> */-->
+<t:block t:fragment="stepIntro(String headline, String contentText)">
+    <h5 t:text="loc.get(headline)">headline</h5>
+    <p><t:block t:each="line, st : misc.locLines(contentText)">[[${line}]]<br t:unless="st.last"></t:block></p>
+</t:block>
+</html>
