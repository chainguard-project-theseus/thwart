+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.charts.*, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications, ChartSettings chartSettings, List<Chart> charts, List<ChartDisplayType> displayTypes, List<ChartGroupType> groupTypes, Chart chart, String containerID, String transactionData, String dateRange"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + loc.get('menu.charts'), ~{::page-head}, ~{::body})}">
