+        <t:block t:replace="~{helpers/navbar :: navbar('home')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <!--/* icon */-->
+                    <div class="row">
+                        <div class="col s8 offset-s2 center-align">
+                            <a t:href="@{/about}">
