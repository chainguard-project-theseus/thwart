--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/charts/chartFunctions.html
@@ -0,0 +1,52 @@
+<t:block xmlns:t="https://tessera.dev">
+
+<!--/* FreeMarker getChartName(chart) is the function viz.chartName(chart).
+       infoMessage: text may hold markup from the localization (link to the wiki), so it is a SafeHtml (misc.locHtml(key)). */-->
+<div t:fragment="infoMessage(SafeHtml text)" class="row no-margin-bottom">
+    <div class="col s12 center-align">
+        <table class="text-default login-message no-border-table">
+            <tbody>
+            <tr>
+                <td><i class="material-icons">info</i></td>
+                <td t:utext="text">text</td>
+            </tr>
+            </tbody>
+        </table>
+    </div>
+</div>
+
+<a t:fragment="buttonNew" t:replace="~{helpers/header :: buttonLink('/charts/newChart', 'add', 'title.chart.new', '', 'background-blue', '', false, false, '')}"></a>
+
+<a t:fragment="buttonShow" t:replace="~{helpers/header :: buttonLink('/charts', 'show_chart', 'home.menu.charts.action.show', '', 'background-blue', '', false, false, '')}"></a>
+
+<t:block t:fragment="buttons">
+    <div class="row hide-on-small-only valign-wrapper">
+        <div class="col s6 right-align">
+            <a t:replace="~{charts/chartFunctions :: buttonNew}"></a>
+        </div>
+        <div class="col s6 left-align">
+            <a t:replace="~{charts/chartFunctions :: buttonShow}"></a>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up center-align">
+        <div class="row center-align">
+            <div class="row center-align">
+                <div class="col s12">
+                    <a t:replace="~{charts/chartFunctions :: buttonShow}"></a>
+                </div>
+            </div>
+            <div class="col s12">
+                <a t:replace="~{charts/chartFunctions :: buttonNew}"></a>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!--/* FreeMarker iconForItem(item) for a ChartDisplayType / ChartGroupType: pass item.icon and item.localizationKey */-->
+<t:block t:fragment="iconForItem(String icon, String localizationKey)">
+    <t:block t:if="strings.startsWith(icon, 'fa')"><i t:class="|${icon} left|"></i> <t:block t:text="loc.get(localizationKey)">name</t:block></t:block>
+    <t:block t:unless="strings.startsWith(icon, 'fa')"><i class="material-icons left" t:text="icon">icon</i> <t:block t:text="loc.get(localizationKey)">name</t:block></t:block>
+</t:block>
+
+</t:block>
