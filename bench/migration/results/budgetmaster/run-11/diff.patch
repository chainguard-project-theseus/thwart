diff --git a/BudgetMasterServer/src/main/resources/templates/templateGroups/newTemplateGroup.html b/BudgetMasterServer/src/main/resources/templates/templateGroups/newTemplateGroup.html
new file mode 100644
index 00000000..58fc278d
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/templateGroups/newTemplateGroup.html
@@ -0,0 +1,66 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.templategroup.TemplateGroup, de.deadlocker8.budgetmaster.utils.notification.Notification, de.deadlocker8.budgetmaster.templating.FormErrors"
+      t:params="List<Notification> notifications, TemplateGroup templateGroup, FormErrors error"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + (templateGroup.ID != null ? loc.get('title.template.group.edit') : loc.get('title.template.group.new')), null, ~{::body})}">
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('templates')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="templateGroup.ID != null ? loc.get('title.template.group.edit') : loc.get('title.template.group.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <div class="container">
+                    <form name="NewTemplateGroup" t:action="@{/templateGroups/newTemplateGroup}" method="post" onsubmit="return validateForm(true)">
+                        <input type="hidden" name="ID" t:value="templateGroup.ID == null ? '' : '' + templateGroup.ID">
+
+                        <!--/* template group name */-->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">file_copy</i>
+                                <input id="template-group-name" type="text" name="name" t:class="val.cls(error, 'name', '')" t:data-position="val.has(error, 'name') ? 'bottom'" t:data-delay="val.has(error, 'name') ? 50" t:title="val.message(error, 'name')" t:value="templateGroup.name ?: ''">
+                                <label for="template-group-name" t:text="loc.get('transaction.new.label.name')">Name</label>
+                            </div>
+                        </div>
+
+                        <br>
+
+                        <!--/* buttons */-->
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <a t:replace="~{helpers/header :: buttonLink('/templateGroups', 'clear', 'cancel', '', 'red', '', false, false, '')}"></a>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '')}"></button>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <a t:replace="~{helpers/header :: buttonLink('/templateGroups', 'clear', 'cancel', '', 'red', '', false, false, '')}"></a>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '')}"></button>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+                </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/templateGroups.js}"></script>
+</body>
+</html>
