+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.images.Image"
+         t:params="List<Image> availableImages, Integer selectedImageID">
+<!--/*
+  Converted from helpers/availableImages.ftl: AJAX view returned by MediaController.getAvailableImages (no fragments).
+  The image src was a data: URL (Image.getBase64EncodedImage), which a URL attribute can't take: it is now
+  @{/media/getImage/{id}} (new endpoint MediaController.getImageByID); iconSelect.js copies that src to the preview unchanged.
+  The delete button (FreeMarker buttonFlat isDataUrl=true) is written inline with a data-url link.
+*/-->
+<div t:each="image : availableImages" class="col s4 m2 l2 item-icon-option-column">
+    <div t:class="|item-icon-option ${selectedImageID == image.ID ? 'selected' : ''}|">
+        <img t:src="@{/media/getImage/{imageId}(imageId=image.ID)}" class="item-icon-preview" t:data-image-id="image.ID"/>
+    </div>
+    <a id="" class="waves-effect waves-light btn-flat no-padding text-default item-icon-option-delete" t:data-url="@{/media/deleteImage/{imageId}(imageId=image.ID)}">
+        <i class="material-icons left  ">delete</i><span t:text="loc.get('delete.question')">delete?</span>
+    </a>
+</div>
+</t:block>
