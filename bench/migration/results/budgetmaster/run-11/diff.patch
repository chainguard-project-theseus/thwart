+	public static String endValue(RepeatingEnd endOption)
+	{
+		if(endOption == null || endOption.getValue() == null)
+		{
+			return "";
+		}
+		return String.valueOf(endOption.getValue());
+	}
+
+	/** The end date of a {@code RepeatingEndDate}, or {@code null}. */
+	@TemplateFunction
+	public static LocalDate endDate(RepeatingEnd endOption)
+	{
+		if(endOption != null && endOption.getValue() instanceof LocalDate date)
+		{
+			return date;
+		}
+		return null;
+	}
+
+	/** Consecutive transactions with the same (upper-cased, month name) date string. */
+	public record DateGroup(String date, List<Transaction> transactions)
+	{
+	}
+
+	/** Groups consecutive transactions by date, as transactions.ftl did while listing them. */
+	@TemplateFunction
+	public static List<DateGroup> groupByDate(List<Transaction> transactions)
+	{
+		final DateService dateService = TemplateBeans.get(DateService.class);
+		final List<DateGroup> groups = new ArrayList<>();
+		String lastDate = null;
+		List<Transaction> current = null;
+		for(Transaction transaction : transactions)
+		{
+			final String date = dateService.getDateStringWithMonthName(transaction.getDate()).toUpperCase();
+			if(!date.equals(lastDate))
+			{
+				current = new ArrayList<>();
+				groups.add(new DateGroup(date, current));
+				lastDate = date;
+			}
+			current.add(transaction);
+		}
+		return groups;
+	}
+
+	/**
+	 * The sort/search strings of each csv transaction row (FreeMarker wrote them as data-order/data-search),
+	 * per row: status, date, category, name, description, amount. transactionImport.js passes them to DataTables.
+	 */
+	@TemplateFunction
+	public static List<List<String>> csvSortData(List<CsvTransaction> csvTransactions)
+	{
+		final CurrencyService currencyService = TemplateBeans.get(CurrencyService.class);
+		final List<List<String>> rows = new ArrayList<>();
+		for(CsvTransaction csvTransaction : csvTransactions)
+		{
+			final List<String> row = new ArrayList<>();
+			row.add(Localization.getString(csvTransaction.getStatus().getLocalizationKey()));
+			row.add(String.valueOf(csvTransaction.getDate()));
+			row.add(csvTransaction.getCategory().getName());
+			row.add(csvTransaction.getName());
+			row.add(csvTransaction.getDescription());
+			row.add(currencyService.getCurrencyString(csvTransaction.getAmount()));
+			rows.add(row);
+		}
+		return rows;
+	}
+}
