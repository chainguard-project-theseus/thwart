index 00000000..3dbb9ee6
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionTransfer.html
@@ -0,0 +1,92 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.transactions.csvimport.CsvTransaction, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.templating.FormErrors, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications, Transaction transaction, boolean isEdit, boolean changeTypeInProgress, LocalDate currentDate, List<Category> categories, List<Account> accounts, String suggestionsJSON, FormErrors error, CsvTransaction currentCsvTransaction"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + (isEdit ? loc.get('title.transaction.edit', loc.get('title.transaction.new.transfer')) : loc.get('title.transaction.new', loc.get('title.transaction.new.transfer'))), ~{::page-head}, ~{::body})}">
+<page-head t:remove="tag">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+</page-head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('transactions')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="isEdit ? loc.get('title.transaction.edit', loc.get('title.transaction.new.transfer')) : loc.get('title.transaction.new', loc.get('title.transaction.new.transfer'))">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+                    <div class="container">
+                        <form id="mainForm" name="NewTransaction" t:action="@{/transactions/newTransaction}" method="post">
+                            <!-- only set ID for transactions not templates, otherwise the input is filled with the template ID and saving the transaction
+                            may then override an existing transactions if the ID is also already used in transactions table -->
+                            <input type="hidden" name="ID" t:value="transaction.ID == null ? '' : '' + transaction.ID">
+                            <input type="hidden" name="isExpenditure" value="true">
+                            <input type="hidden" name="isRepeating" t:value="transaction.repeating">
+
+                            <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.transaction.save'), 'fas fa-info', '')}"></t:block>
+
+                            <!--/* name */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(transaction, suggestionsJSON, error)}"></t:block>
+
+                            <!--/* amount */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(transaction, error)}"></t:block>
+
+                            <!--/* category */-->
+                            <t:block t:replace="~{helpers/customSelectMacros :: customCategorySelect(categories, transaction.category, 'col s12 m12 l8 offset-l2', loc.get('transaction.new.label.category'), 'transaction-category', true, '', false, '')}"></t:block>
+
+                            <!--/* date */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionStartDate(transaction, currentDate)}"></t:block>
+
+                            <!--/* description */-->
+                            <div t:replace="~{transactions/newTransactionMacros :: transactionDescription(transaction, error)}"></div>
+
+                            <!--/* tags */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(transaction)}"></t:block>
+
+                            <!--/* account */-->
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('account-select-wrapper', 'account', accounts, transaction.account ?: bm.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', loc.get('transaction.new.label.account'), 'transaction-account', false)}"></t:block>
+
+                            <!--/* transfer account */-->
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect('transfer-account-select-wrapper', 'transferAccount', accounts, transaction.transferAccount ?: bm.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', loc.get('transaction.new.label.transfer.account'), 'transaction-destination-account', false)}"></t:block>
+
+                            <!--/* repeating options */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionRepeating(transaction, currentDate, error)}"></t:block>
+
+                            <!--/* buttons */-->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttons(currentCsvTransaction != null ? '/transactionImport' : '/transactions', true, false)}"></t:block>
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttonTransactionActions(isEdit, true, changeTypeInProgress, transaction.ID)}"></t:block>
+                        </form>
+
+                        <div id="saveAsTemplateModalContainer"></div>
+
+                        <div id="changeTransactionTypeModalContainer"></div>
+
+                        <div id="transactionNameKeywordWarningModalContainer"></div>
+                    </div>
+                </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization}"></t:block>
+
+        <script>
+            var createTemplateWithErrorInForm = [[${loc.get('save.as.template.errorsInForm')}]];
+            var templateNameEmptyValidationMessage = [[${loc.get('warning.empty.transaction.name')}]];
+            var templateNameDuplicateValidationMessage = [[${loc.get('warning.duplicate.template.name')}]];
+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/transactionActions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+</body>
+</html>
