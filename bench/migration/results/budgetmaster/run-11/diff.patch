+package de.deadlocker8.budgetmaster.templating;
+
+import de.thecodelabs.utils.util.Localization;
+import org.springframework.validation.Errors;
+import org.springframework.validation.FieldError;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * View-safe replacement for the {@code BindingResult} that controllers put into the model as "error".
+ *
+ * @param fieldMessages localized message of the first error of each field
+ * @param fieldCodes    code of the first error of each field
+ * @param globalCodes   codes of the global errors
+ */
+public record FormErrors(Map<String, String> fieldMessages, Map<String, String> fieldCodes, List<String> globalCodes)
+{
+	public static FormErrors of(Errors errors)
+	{
+		final Map<String, String> messages = new HashMap<>();
+		final Map<String, String> codes = new HashMap<>();
+		for(FieldError fieldError : errors.getFieldErrors())
+		{
+			if(!codes.containsKey(fieldError.getField()))
+			{
+				codes.put(fieldError.getField(), fieldError.getCode());
+				messages.put(fieldError.getField(), Localization.getString(fieldError.getCode()));
+			}
+		}
+		final List<String> globalCodes = errors.getGlobalErrors().stream().map(e -> e.getCode()).toList();
+		return new FormErrors(messages, codes, globalCodes);
+	}
+
+	public boolean hasErrors()
+	{
+		return !fieldCodes.isEmpty() || !globalCodes.isEmpty();
+	}
+}
