+                                    <i class="material-icons left">show_chart</i><t:block t:text="loc.get('chart.show')">show</t:block>
+                                </button>
+                            </div>
+                        </div>
+                    </form>
+
+                    <br>
+
+                    <div t:class="chartSettings.chartSelected ? '' : 'hidden'">
+                        <t:block t:replace="~{helpers/header :: hint(bm.hint('hint.charts.click'), 'fas fa-info', '/hotkeys')}"></t:block>
+                    </div>
+
+                    <div class="container-chart">
+                        <div t:if="containerID != null" t:id="containerID" class="chart-canvas"></div>
+                    </div>
+
+                    <div id="matchingTransactionsOverview"></div>
+                </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization}"></t:block>
+        <script>
+            var filterActive = [[${loc.get('filter.active')}]];
