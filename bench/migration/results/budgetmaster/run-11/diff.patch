diff --git a/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html b/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html
new file mode 100644
index 00000000..12f8d242
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html
@@ -0,0 +1,97 @@
+<html xmlns:t="https://tessera.dev"
+      t:import="de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.templating.FormErrors, de.deadlocker8.budgetmaster.utils.notification.Notification"
+      t:params="List<Notification> notifications, Category category, FormErrors error, List<String> categoryColors, String customColor, List<String> fontawesomeIcons"
+      t:replace="~{helpers/layout :: page('BudgetMaster - ' + (category.ID != null ? loc.get('title.category.edit') : loc.get('title.category.new')), ~{::page-head}, ~{::body})}">
+<page-head t:remove="tag"><link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/></page-head>
+<body t:remove="tag">
+        <t:block t:replace="~{helpers/navbar :: navbar('categories')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="category.ID != null ? loc.get('title.category.edit') : loc.get('title.category.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: content(notifications, ~{::page-content})}">
+                <page-content t:remove="tag">
+
+                    <div class="container">
+                        <form name="NewCategory" t:action="@{/categories/newCategory}" method="post">
+                            <input type="hidden" name="ID" t:value="category.ID != null ? '' + category.ID : ''">
+                            <input type="hidden" name="type" t:value="category.type != null ? '' + category.type : ''">
+
+                            <!--/* name */-->
+                            <div class="row" t:with="isNameEditingForbidden=category.type == 'NONE' || category.type == 'REST'">
+                                <div class="input-field col s12 m12 l8 offset-l2">
+                                    <i class="material-icons prefix">edit</i>
+                                    <input t:if="!isNameEditingForbidden" id="category-name" type="text" name="name"
+                                           t:class="val.cls(error, 'name', '')" t:data-position="val.has(error, 'name') ? 'bottom'" t:data-delay="val.has(error, 'name') ? 50" t:title="val.message(error, 'name')"
+                                           t:value="bm.categoryName(category)">
+                                    <input t:if="isNameEditingForbidden" id="category-name" type="text" name="name" t:value="bm.categoryName(category)" readonly>
+                                    <label for="category-name" t:text="loc.get('category.new.label.name')">name</label>
+                                </div>
+                            </div>
+
+                            <!--/* color */-->
+                            <input type="hidden" name="color" id="categoryColor" t:value="category.color">
+                            <div class="row" t:each="colorRow, rowStat : acc.chunk(categoryColors, 6)">
+                                <div t:each="color, st : colorRow" t:class="st.first ? 'col s2 m1 offset-m3 no-padding' : 'col s2 m1 no-padding'">
+                                    <div t:class="|category-color ${color == category.color ? 'category-color-active' : ''}|" t:style="|background-color: ${css.color(color)}|"></div>
+                                </div>
+                                <!--/* add custom color picker */-->
+                                <div t:if="rowStat.last" class="col s2 m1 no-padding">
+                                    <div id="customColorPickerContainer" t:class="|category-color ${customColor == category.color ? 'category-color-active' : ''}|" t:style="|background-color: ${css.color(customColor)}|">
+                                        <span>+</span>
+                                    </div>
+                                </div>
+                            </div>
+
+                            <!--/* icon */-->
+                            <div t:replace="~{helpers/iconSelect :: iconSelect('category-icon', category, true, '', '', false)}"></div>
+
+                            <!--/* font color */-->
+                            <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(category)}"></t:block>
+
+                            <br>
+
+                            <!--/* buttons */-->
+                            <div class="row hide-on-small-only">
+                                <div class="col s6 right-align">
+                                    <a t:replace="~{helpers/header :: buttonLink('/categories', 'clear', 'cancel', '', 'red', '', false, false, '')}"></a>
+                                </div>
+
+                                <div class="col s6 left-align">
+                                    <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '')}"></button>
+                                </div>
+                            </div>
+                            <div class="hide-on-med-and-up">
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <a t:replace="~{helpers/header :: buttonLink('/categories', 'clear', 'cancel', '', 'red', '', false, false, '')}"></a>
+                                    </div>
+                                </div>
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <button t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '')}"></button>
+                                    </div>
+                                </div>
+                            </div>
+                        </form>
+                    </div>
+                </page-content>
+                </t:block>
+            </div>
+        </main>
+
+        <div t:replace="~{helpers/iconSelect :: modalIconSelect('category-name', category, fontawesomeIcons)}"></div>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/categories.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+</body>
+</html>
