+++ b/BudgetMasterServer/src/main/resources/templates/charts/manage.html
@@ -0,0 +1,78 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.charts.Chart"
+      t:params="PageContext page, List<Chart> customCharts, List<Chart> defaultCharts">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.charts'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/charts.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="page.darkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar(page, 'charts')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="locale.getString('menu.charts')">Charts</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: showNotifications(page.notifications)}"></t:block>
+                <br>
+                <t:block t:replace="~{charts/chartFunctions :: buttons}"></t:block>
+                <br>
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline-small" t:text="locale.getString('charts.custom')">custom</div>
+                    </div>
+
+                    <table class="bordered">
+                        <thead>
+                            <tr>
+                                <th t:text="locale.getString('chart.new.label.name')">name</th>
+                                <th t:text="locale.getString('chart.actions')">actions</th>
+                            </tr>
+                        </thead>
+                        <tr t:each="chart : customCharts">
+                            <td t:text="chartView.name(chart)">name</td>
+                            <td>
+                                <t:block t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.ID + '/edit', 'edit', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                                <t:block t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.ID + '/requestDelete', 'delete', '', '', 'no-padding text-default button-request-delete-chart', true, false, '', '', '')}"></t:block>
+                            </td>
+                        </tr>
+                    </table>
+                    <t:block t:if="customCharts.isEmpty()">
+                        <div class="center-align charts-default-margin" t:text="locale.getString('placeholder')">placeholder</div>
+                        <br>
+                    </t:block>
+
+                    <div class="section center-align charts-default-margin">
+                        <div class="headline-small" t:text="locale.getString('charts.default')">default</div>
+                    </div>
+
+                    <table class="bordered">
+                        <thead>
+                            <tr>
+                                <th t:text="locale.getString('chart.new.label.name')">name</th>
+                                <th t:text="locale.getString('chart.display.type')">display</th>
+                                <th t:text="locale.getString('chart.group.type')">group</th>
+                                <th t:text="locale.getString('chart.actions')">actions</th>
+                            </tr>
+                        </thead>
+                        <tr t:each="chart : defaultCharts">
+                            <td t:text="chartView.name(chart)">name</td>
+                            <td><t:block t:replace="~{charts/chartFunctions :: iconForItem(chart.displayType.icon, chart.displayType.localizationKey)}"></t:block></td>
+                            <td><t:block t:replace="~{charts/chartFunctions :: iconForItem(chart.groupType.icon, chart.groupType.localizationKey)}"></t:block></td>
+                            <td>
+                                <t:block t:replace="~{helpers/header :: buttonFlat('/charts/' + chart.ID + '/edit', 'visibility', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+                            </td>
+                        </tr>
+                    </table>
+                </div>
+            </div>
+
+            <div id="deleteModalContainerOnDemand"></div>
+        </main>
+
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/charts.js}"></script>
+    </body>
+</html>
