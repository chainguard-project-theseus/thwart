diff --git a/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionNormal.html b/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionNormal.html
new file mode 100644
index 00000000..ba428a87
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/transactions/newTransactionNormal.html
@@ -0,0 +1,88 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.view.ValidationErrors, de.deadlocker8.budgetmaster.transactions.Transaction, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account"
+      t:params="PageContext page, Transaction transaction, boolean isEdit, boolean changeTypeInProgress, LocalDate currentDate, List<Category> categories, List<Account> accounts, List<String> nameSuggestions, ValidationErrors validationErrors, List<String> localizedMonthNames, List<String> localizedWeekdays"
+      t:with="title=(isEdit ? locale.getString('title.transaction.edit', locale.getString('title.transaction.new.normal')) : locale.getString('title.transaction.new', locale.getString('title.transaction.new.normal')))">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="page.darkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar(page, 'transactions')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="title">Title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: showNotifications(page.notifications)}"></t:block>
+                    <div class="container">
+                        <form id="mainForm" name="NewTransaction" t:action="@{/transactions/newTransaction}" method="post">
+                            <!-- only set ID for transactions not templates, otherwise the input is filled with the template ID and saving the transaction
+                            may then override an existing transactions if the ID is also already used in transactions table -->
+                            <input type="hidden" name="ID" t:value="view.c(transaction.ID)">
+                            <input type="hidden" name="isRepeating" t:value="transaction.repeating ? 'true' : 'false'">
+
+                            <!-- isPayment switch -->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: isExpenditureSwitch(transaction.isExpenditure())}"></t:block>
+
+                            <t:block t:replace="~{helpers/header :: hint(transactionView.hint('hint.transaction.save'), 'fas fa-info', '')}"></t:block>
+
+                            <!-- name -->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(transaction.name, nameSuggestions, validationErrors)}"></t:block>
+
+                            <!-- amount -->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(transaction.amount, validationErrors)}"></t:block>
+
+                            <!-- category -->
+                            <t:block t:replace="~{helpers/customSelectMacros :: customCategorySelect(page, categories, transaction.category, 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.category'), 'transaction-category', true, '', false, '')}"></t:block>
+
+                            <!-- date -->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionStartDate(transaction.date, currentDate)}"></t:block>
+
+                            <!-- description -->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionDescription(transaction.description, validationErrors)}"></t:block>
+
+                            <!-- tags -->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(transaction.tags)}"></t:block>
+
+                            <!-- account -->
+                            <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect(page, 'account-select-wrapper', 'account', accounts, transaction.account != null ? transaction.account : transactionView.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.account'), 'transaction-account', false)}"></t:block>
+
+                            <!-- repeating options -->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: transactionRepeating(transaction, currentDate, validationErrors)}"></t:block>
+
+                            <!-- buttons -->
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttons('/transactions', true, false, transactionView.csvImportActive())}"></t:block>
+                            <t:block t:replace="~{transactions/newTransactionMacros :: buttonTransactionActions(isEdit, true, changeTypeInProgress, transaction.ID)}"></t:block>
+                        </form>
+
+                        <div id="saveAsTemplateModalContainer"></div>
+
+                        <div id="changeTransactionTypeModalContainer"></div>
+
+                        <div id="transactionNameKeywordWarningModalContainer"></div>
+                    </div>
+            </div>
+        </main>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></t:block>
+
+        <script>
+            createTemplateWithErrorInForm = [[${locale.getString('save.as.template.errorsInForm')}]];
+            templateNameEmptyValidationMessage = [[${locale.getString('warning.empty.transaction.name')}]];
+            templateNameDuplicateValidationMessage = [[${locale.getString('warning.duplicate.template.name')}]];
+        </script>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/transactionActions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+    </body>
+</html>
