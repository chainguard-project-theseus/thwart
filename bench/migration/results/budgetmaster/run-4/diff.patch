diff --git a/BudgetMasterServer/src/main/resources/templates/search/searchMacros.html b/BudgetMasterServer/src/main/resources/templates/search/searchMacros.html
new file mode 100644
index 00000000..fe9b8d71
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/search/searchMacros.html
@@ -0,0 +1,135 @@
+<div xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.search.Search, de.deadlocker8.budgetmaster.transactions.Transaction">
+
+<div t:fragment="searchTextAndButton(Search search)" class="row no-margin-bottom valign-wrapper">
+    <div class="col s10 m6 offset-m2 l5 offset-l3">
+        <div class="input-field">
+            <input id="searchText" type="text" name="searchText" t:value="search.searchText">
+            <label for="searchText" t:text="locale.getString('search')">search</label>
+        </div>
+    </div>
+
+    <div class="col s2 m4 l4">
+        <div class="hide-on-small-only">
+            <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'search', 'search.submit', 'button-perform-search', 'background-blue', '', false, '', '', '')}"></t:block>
+        </div>
+        <div class="hide-on-med-and-up">
+            <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'search', '', 'button-perform-search', 'background-blue', '', false, '', '', '')}"></t:block>
+        </div>
+    </div>
+</div>
+
+<div t:fragment="checkboxes(Search search)" class="row">
+        <div class="col s8 offset-s2 m4 offset-m2 l3 offset-l3">
+            <div class="search-checkbox-container">
+                <label>
+                    <input type="checkbox" name="searchName" t:checked="search.searchName">
+                    <span class="text-default" t:text="locale.getString('search.in.name')">x</span>
+                </label>
+            </div>
+        </div>
+        <div class="col s8 offset-s2 m6 l6">
+            <div class="search-checkbox-container">
+                <label>
+                    <input type="checkbox" name="searchDescription" t:checked="search.searchDescription">
+                    <span class="text-default" t:text="locale.getString('search.in.description')">x</span>
+                </label>
+            </div>
+        </div>
+        <div class="col s8 offset-s2 m4 offset-m2 l3 offset-l3">
+            <div class="search-checkbox-container">
+                <label>
+                    <input type="checkbox" name="searchCategory" t:checked="search.searchCategory">
+                    <span class="text-default" t:text="locale.getString('search.in.category')">x</span>
+                </label>
+            </div>
+        </div>
+        <div class="col s8 offset-s2 m6 l6">
+            <div class="search-checkbox-container">
+                <label>
+                    <input type="checkbox" name="searchTags" t:checked="search.searchTags">
+                    <span class="text-default" t:text="locale.getString('search.in.tags')">x</span>
+                </label>
+            </div>
+        </div>
+        <div class="col s8 offset-s2 m4 offset-m2 l3 offset-l3">
+            <div class="search-checkbox-container">
+                <label>
+                    <input type="checkbox" name="includeHiddenAccounts" t:checked="search.includeHiddenAccounts">
+                    <span class="text-default" t:text="locale.getString('search.include.hidden.accounts')">x</span>
+                </label>
+            </div>
+        </div>
+</div>
+
+<div t:fragment="dateRange(Search search)" class="row">
+        <div class="input-field col s6 m4 offset-m2 l3 offset-l3" id="search-datepicker-container">
+            <script t:if="search.startDate != null">
+                startDate = [[${txList.longDate(search.startDate)}]].split(".");
+                startDate = new Date(startDate[2], startDate[1] - 1, startDate[0]);
+            </script>
+            <script t:if="search.startDate == null">
+                startDate = null;
+            </script>
+
+            <i class="material-icons prefix">today</i>
+            <input id="search-datepicker" type="text" class="datepicker" name="startDate" t:value="txList.longDate(search.startDate)">
+            <label for="search-datepicker" t:text="locale.getString('chart.steps.second.label.start')">x</label>
+        </div>
+
+        <div class="input-field col s6 m4 l3" id="search-datepicker-end-container">
+            <script t:if="search.endDate != null">
+                endDate = [[${txList.longDate(search.endDate)}]].split(".");
+                endDate = new Date(endDate[2], endDate[1] - 1, endDate[0]);
+            </script>
+            <script t:if="search.endDate == null">
+                endDate = null;
+            </script>
+
+            <i class="material-icons prefix">event</i>
+            <input id="search-datepicker-end" type="text" class="datepicker" name="endDate" t:value="txList.longDate(search.endDate)">
+            <label for="search-datepicker-end" t:text="locale.getString('chart.steps.second.label.end')">x</label>
+        </div>
+</div>
+
+<!-- searchMacros.ftl: <@pagination page position/>; pass page.getNumber() and page.getTotalPages() of the Spring Data Page -->
+<div t:fragment="pagination(int number, int totalPages, String position)" t:class="|row pagination-position-${position}|">
+    <div class="col s12 center-align">
+        <ul t:if="totalPages > 0" class="pagination">
+            <li t:class="|text-default ${number == 0 ? 'disabled' : ''}|"><a class="page-link" t:data-page="number - 1"><i class="material-icons">chevron_left</i></a></li>
+                <li t:each="i : numbers.sequence(0, totalPages - 1)" t:class="|waves-effect text-default ${number == i ? 'active' : ''}|"><a class="page-link" t:data-page="i" t:text="i + 1">1</a></li>
+            <li t:class="|text-default ${number == totalPages - 1 ? 'disabled' : ''}|"><a class="page-link" t:data-page="number + 1"><i class="material-icons">chevron_right</i></a></li>
+        </ul>
+    </div>
+</div>
+
+<!-- searchMacros.ftl: <@renderTransactions transactions openLinksInNewTab/> (FreeMarker default openLinksInNewTab=false) -->
+<t:block t:fragment="renderTransactions(PageContext page, List<Transaction> transactions, boolean openLinksInNewTab)">
+    <div t:each="transaction : transactions" class="card-panel search-result" t:with="linkTarget=openLinksInNewTab ? '_blank' : ''">
+        <div class="hide-on-large-only">
+            <div class="row valign-wrapper">
+                <div class="col s3 center-align bold transaction-text" t:text="txList.dateNormal(transaction.date)">date</div>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(page, transaction)}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 's2')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionLinks(transaction, linkTarget)}"></t:block>
+            </div>
+            <div class="row valign-wrapper no-margin-bottom">
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionCategory(page, transaction, 'center-align')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 's5')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(page, transaction, transaction.account, 's4')}"></t:block>
+            </div>
+        </div>
+        <div class="hide-on-med-and-down">
+            <div class="row valign-wrapper no-margin-bottom transaction-row-desktop">
+                <div class="col l2 xl1 bold transaction-text transaction-date valign-wrapper" t:text="txList.dateNormal(transaction.date)">date</div>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionCategory(page, transaction, 'left-align')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAccountIcon(page, transaction)}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionType(transaction, 'l1 xl1')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionNameAndDescription(transaction, 'l3 xl4')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionAmount(page, transaction, transaction.account, 'l2 xl2')}"></t:block>
+                <t:block t:replace="~{transactions/transactionsMacros :: transactionLinks(transaction, linkTarget)}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+</div>
