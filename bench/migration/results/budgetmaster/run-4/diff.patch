+            </div>
+        </div>
+        <div class="modal-footer background-color">
+            <t:block t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false, false, '')}"></t:block>
+            <t:block t:replace="~{helpers/header :: buttonLink('/setDate?target=' + target, 'done', 'ok', 'buttonChooseDate', 'green', 'modal-action modal-close text-white', false, false, false, '')}"></t:block>
+        </div>
+    </div>
+
+    <t:block t:replace="~{helpers/header :: hint(datePicker.hint('hint.globalDatePicker.hotkeys'), 'fas fa-info', '/hotkeys')}"></t:block>
+</t:block>
+
+<t:block t:fragment="datepickerGridYear(int currentYear)">
+    <h4 t:text="locale.getString('title.datepicker.year')">year</h4>
+
+    <div class="hidden" id="currentYear" t:text="currentYear">2024</div>
+
+    <div class="center-align">
+        <a class="waves-effect text-default global-datepicker-button" id="global-datepicker-previous"><i class="material-icons icon-chevron">chevron_left</i></a>
+        <a class="waves-effect text-default global-datepicker-button" id="global-datepicker-next"><i class="material-icons icon-chevron">chevron_right</i></a>
+    </div>
+
+    <t:block t:replace="~{::datepickerGrid(datePicker.years(currentYear), '' + currentYear)}"></t:block>
+</t:block>
+
+<!-- rows of 3 items (the FreeMarker version opened/closed <tr> around every third item) -->
+<table t:fragment="datepickerGrid(List<String> items, String currentItem)" class="no-border-table global-datepicker-table">
+    <tr t:each="row : numbers.sequence(0, (items.size() - 1) / 3)">
+        <t:block t:each="i : numbers.sequence(row * 3, row * 3 + 2)">
+            <td t:if="i < items.size()" t:class="|global-datepicker-item ${items[i] == currentItem ? 'global-datepicker-selected' : ''}|" t:text="items[i]">item</td>
+        </t:block>
+    </tr>
+</table>
+
+<!-- globalDatePicker.ftl: <@datePickerLocalization/>; pass the model attributes localizedMonthNames and localizedWeekdays.
+     The arrays are now written as JSON (double quotes). -->
+<script t:fragment="datePickerLocalization(List<String> localizedMonthNames, List<String> localizedWeekdays)">
+    monthNames = [[${localizedMonthNames}]];
+    monthNamesShort = [[${datePicker.prefixes(localizedMonthNames, 3)}]];
+    weekDays = [[${localizedWeekdays}]];
+    weekDaysShort = [[${datePicker.prefixes(localizedWeekdays, 2)}]];
+    weekDaysLetters = [[${datePicker.prefixes(localizedWeekdays, 1)}]];
+    buttonCancel = [[${locale.getString('cancel')}]];
+    buttonClose = [[${locale.getString('ok')}]];
+</script>
+
+</div>
diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/header.html b/BudgetMasterServer/src/main/resources/templates/helpers/header.html
new file mode 100644
index 00000000..5a148722
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/header.html
@@ -0,0 +1,133 @@
+<div xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.icon.Icon, de.deadlocker8.budgetmaster.hints.Hint, de.deadlocker8.budgetmaster.utils.notification.Notification">
+
+<!-- header.ftl: <@header.header title/> -->
+<t:block t:fragment="header(String title)">
+    <title t:text="title">BudgetMaster</title>
+    <meta charset="UTF-8"/>
+    <link rel="stylesheet" t:href="@{/webjars/font-awesome/css/all.min.css}">
+    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
+    <link rel="stylesheet" t:href="@{/webjars/materializecss/css/materialize.min.css}">
+    <link type="text/css" rel="stylesheet" t:href="@{/css/colors.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/style.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/navbar.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/categories.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/accounts.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/customSelect.css}"/>
+    <link type="text/css" rel="stylesheet" t:href="@{/css/hotkeys.css}"/>
+
+    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
+
+    <link rel="apple-touch-icon" t:href="@{/touch_icon.png}">
+</t:block>
+
+<!-- header.ftl: <@header.logo id classes/> -->
+<t:block t:fragment="logo(PageContext page, String id, String classes)">
+    <img t:if="page.darkTheme" t:class="classes" t:id="id" t:src="@{/images/Logo_with_white_text_medium_res.png}">
+    <img t:unless="page.darkTheme" t:class="classes" t:id="id" t:src="@{/images/Logo_with_text_medium_res.png}">
+</t:block>
+
+<!-- header.ftl: <@header.modalConfirmDelete .../>; the nested content is passed as a Fragment;
+     confirmUrl is the URL prefix, the delete URL is confirmUrl/itemId/delete -->
+<div t:fragment="modalConfirmDelete(String title, String confirmUrl, Integer itemId, String confirmButtonTextKey, String id, String classes, Fragment content)"
+     t:id="id" t:class="|modal background-color ${classes}|">
+    <div class="modal-content">
+        <h4 t:text="title">Title</h4>
+
+        <t:block t:replace="content"></t:block>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{::buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, true, false, '')}"></t:block>
+        <t:block t:replace="~{::buttonLink(confirmUrl + '/' + itemId + '/delete', 'delete', confirmButtonTextKey, '', 'green', 'modal-action modal-close text-white', false, false, false, '')}"></t:block>
+    </div>
+</div>
+
+<!-- header.ftl: <@header.body>; the page's content is passed as a Fragment -->
+<body t:fragment="body(PageContext page, Fragment content)" class="background-blue-light" t:data-theme="page.darkTheme ? 'dark'">
+    <t:block t:replace="content"></t:block>
+</body>
+
+<!-- header.ftl: <@header.content>: notifications followed by the nested content -->
+<t:block t:fragment="content(PageContext page, Fragment content)">
+    <t:block t:if="page.notifications != null" t:replace="~{::showNotifications(page.notifications)}"></t:block>
+    <t:block t:replace="content"></t:block>
+</t:block>
+
+<t:block t:fragment="showNotifications(List<Notification> notifications)">
+    <div t:each="notification, stat : notifications" class="row notification-row" t:id="|notification-${stat.index}|">
+        <div class="col s12 center-align">
+            <div class="notification-wrapper">
+                <div t:class="|notification ${notification.backgroundColor} ${notification.textColor}|">
+                    <i t:if="notification.icon != null" t:class="|${notification.icon} notification-item|"></i>
+                    <span class="notification-item" t:text="notification.message">message</span>
+                    <a t:class="|notification-item notification-clear ${notification.textColor}|" t:data-id="|notification-${stat.index}|">
+                        <i class="material-icons">clear</i>
+                    </a>
+                </div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!-- header.ftl: <@header.hint hint icon actionUrl/>; actionUrl may be '' -->
+<t:block t:fragment="hint(Hint hint, String icon, String actionUrl)">
+    <div t:unless="hint.isDismissed()" class="row" t:id="|hint-${hint.ID}|">
+        <div class="col s12 center-align">
+            <div class="notification-wrapper">
+                <div class="notification notification-border text-default">
+                    <i t:class="|${icon} notification-item|"></i>
+                    <a t:if="!#strings.isEmpty(actionUrl)" t:href="actionUrl" class="text-default">
+                        <span class="notification-item left-align" t:text="locale.getString(hint.localizationKey)">hint</span>
+                    </a>
+                    <span t:if="#strings.isEmpty(actionUrl)" class="notification-item left-align" t:text="locale.getString(hint.localizationKey)">hint</span>
+                    <a class="notification-item hint-clear text-default" t:data-url="@{/hints/dismiss/{id}(id=hint.ID)}" t:data-id="|hint-${hint.ID}|">
+                        <i class="material-icons">clear</i>
+                    </a>
+                </div>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!-- header.ftl: <@header.buttonLink url icon localizationKey id color classes isDataUrl noUrl disabled target/>
+     FreeMarker defaults: id='', color='background-blue', classes='', isDataUrl=false, noUrl=false, disabled=false, target='' -->
+<a t:fragment="buttonLink(String url, String icon, String localizationKey, String id, String color, String classes, boolean isDataUrl, boolean noUrl, boolean disabled, String target)"
+   t:target="#strings.isEmpty(target) ? null : target"
+   t:href="!isDataUrl && !noUrl ? url : null"
+   t:id="id"
+   t:class="|waves-effect waves-light btn ${color} ${classes}|"
+   t:data-url="isDataUrl ? url : null"
+   t:disabled="disabled">
+    <i t:class="|material-icons left ${#strings.isEmpty(localizationKey) ? 'no-margin' : ''}|" t:text="icon">icon</i><t:block t:unless="#strings.isEmpty(localizationKey)" t:text="locale.getString(localizationKey)">text</t:block>
+</a>
+
+<!-- header.ftl: <@header.buttonSubmit name icon localizationKey id color classes disabled formaction value form/>
+     FreeMarker defaults: id='', color='background-blue', classes='', disabled=false, formaction='', value='', form='' -->
+<button t:fragment="buttonSubmit(String name, String icon, String localizationKey, String id, String color, String classes, boolean disabled, String formaction, String value, String form)"
+        t:id="#strings.isEmpty(id) ? null : id" t:class="|btn waves-effect waves-light ${color} ${classes}|" type="submit" t:name="name"
+        t:disabled="disabled"
+        t:formaction="#strings.isEmpty(formaction) ? null : formaction"
+        t:value="#strings.isEmpty(value) ? null : value"
+        t:form="#strings.isEmpty(form) ? null : form">
+    <i t:class="|material-icons left ${#strings.isEmpty(localizationKey) ? 'no-margin' : ''}|" t:text="icon">icon</i><t:block t:unless="#strings.isEmpty(localizationKey)" t:text="locale.getString(localizationKey)">text</t:block>
+</button>
+
+<!-- header.ftl: <@header.buttonFlat url icon localizationKey id classes isDataUrl noUrl iconClasses target datasetIndex/>
+     FreeMarker defaults: id='', classes='', isDataUrl=false, noUrl=false, iconClasses='', target='', datasetIndex='' -->
+<a t:fragment="buttonFlat(String url, String icon, String localizationKey, String id, String classes, boolean isDataUrl, boolean noUrl, String iconClasses, String target, String datasetIndex)"
+   t:target="#strings.isEmpty(target) ? null : target"
+   t:href="!isDataUrl && !noUrl ? url : null"
+   t:id="id"
+   t:data-index="#strings.isEmpty(datasetIndex) ? null : datasetIndex"
+   t:class="|waves-effect waves-light btn-flat ${classes}|"
+   t:data-url="isDataUrl ? url : null">
+    <i t:class="|material-icons left ${#strings.isEmpty(localizationKey) ? 'no-margin' : ''} ${iconClasses}|" t:text="icon">icon</i><span t:unless="#strings.isEmpty(localizationKey)" t:text="locale.getString(localizationKey)">text</span>
+</a>
+
+<!-- header.ftl: <@header.entityIcon entity classes fallbackName/>; pass entity.iconReference -->
+<t:block t:fragment="entityIcon(Icon icon, String classes, String fallbackName)">
+    <t:block t:if="icon != null && icon.isImageIcon()"><img t:src="@{/media/getImageByIconID/{id}(id=icon.ID)}" t:class="classes"/></t:block>
+    <t:block t:if="icon != null && !icon.isImageIcon() && icon.isBuiltinIcon()"><i t:class="|${icon.builtinIdentifier} ${classes}|"></i></t:block>
+    <t:block t:if="icon == null || (!icon.isImageIcon() && !icon.isBuiltinIcon())" t:text="view.initial(fallbackName)">A</t:block>
+</t:block>
+
+</div>
