diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/availableImages.html b/BudgetMasterServer/src/main/resources/templates/helpers/availableImages.html
new file mode 100644
index 00000000..76a7d0a4
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/availableImages.html
@@ -0,0 +1,13 @@
+<t:block xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.images.Image" t:params="List<Image> availableImages, Integer selectedImageID">
+<t:block t:each="image : availableImages"><t:block t:replace="~{::imageOption(image, 'item-icon', selectedImageID)}"></t:block></t:block>
+
+<!-- availableImages.ftl: <@imageOption image classPrefix selectedImageID/>.
+     The image was inlined as a data: URL (image.getBase64EncodedImage()); Tessera only lets
+     http(s)/relative URLs into src, so it is now loaded from /media/getImageByID/{id}. -->
+<div t:fragment="imageOption(Image image, String classPrefix, Integer selectedImageID)" t:class="|col s4 m2 l2 ${classPrefix}-option-column|">
+    <div t:class="|${classPrefix}-option ${selectedImageID != null && selectedImageID == image.ID ? 'selected' : ''}|">
+        <img t:src="@{/media/getImageByID/{id}(id=image.ID)}" t:class="|${classPrefix}-preview|" t:data-image-id="image.ID"/>
+    </div>
+    <t:block t:replace="~{helpers/header :: buttonFlat('/media/deleteImage/' + image.ID, 'delete', 'delete.question', '', 'no-padding text-default ' + classPrefix + '-option-delete', true, false, '', '', '')}"></t:block>
+</div>
+</t:block>
