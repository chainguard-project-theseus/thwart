+package de.deadlocker8.budgetmaster.view;
+
+import de.deadlocker8.budgetmaster.charts.Chart;
+import de.deadlocker8.budgetmaster.charts.ChartType;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Replaces the functions of charts/chartFunctions.ftl.
+ */
+@TemplateFunctions("chartView")
+public final class ChartViewFunctions
+{
+	private ChartViewFunctions()
+	{
+	}
+
+	/**
+	 * chartFunctions.getChartName(chart): default charts store a localization key as name.
+	 */
+	@TemplateFunction
+	public static String name(Chart chart)
+	{
+		if(chart == null || chart.getName() == null)
+		{
+			return "";
+		}
+		if(chart.getType() == ChartType.DEFAULT)
+		{
+			return Localization.getString(chart.getName());
+		}
+		return chart.getName();
+	}
+
+	/**
+	 * ChartDisplayType/ChartGroupType.hasFontAwesomeIcon() for the item's icon.
+	 */
+	@TemplateFunction
+	public static boolean isFontAwesomeIcon(String icon)
+	{
+		return icon != null && icon.startsWith("fa");
+	}
+}
