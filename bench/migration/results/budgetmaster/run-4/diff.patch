+package de.deadlocker8.budgetmaster.view;
+
+import dev.tessera.runtime.TemplateView;
+import org.springframework.validation.BindingResult;
+import org.springframework.validation.FieldError;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * View-safe snapshot of the field errors of the BindingResult that controllers put into the model as "error".
+ * Provided as model attribute "validationErrors" by {@link ValidationErrorsInterceptor}; read via the
+ * {@code validation.*} functions ({@link ValidationFunctions}).
+ */
+@TemplateView
+public final class ValidationErrors
+{
+	private final Map<String, String> fieldErrorCodes = new HashMap<>();
+
+	public ValidationErrors(BindingResult bindingResult)
+	{
+		for(FieldError fieldError : bindingResult.getFieldErrors())
+		{
+			fieldErrorCodes.putIfAbsent(fieldError.getField(), fieldError.getCode());
+		}
+	}
+
+	boolean hasFieldError(String fieldName)
+	{
+		return fieldErrorCodes.containsKey(fieldName);
+	}
+
+	String getFieldErrorCode(String fieldName)
+	{
+		return fieldErrorCodes.get(fieldName);
+	}
+}
