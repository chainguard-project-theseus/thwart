+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.services.ImportResultItem"
+      t:params="PageContext page, List<ImportResultItem> importResultItems, List<String> errorMessages">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('settings.database.import'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="page.darkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar(page, 'settings')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="locale.getString('info.title.database.import.dialog')">title</div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline-small" t:text="locale.getString('info.database.import.result')">text</div>
+                    </div>
+                </div>
+
+                <div class="container">
+                    <div class="row">
+                        <div class="col s10 offset-s1 m8 offset-m2 l6 offset-l3">
+                            <table class="bordered">
+                                <tr t:each="item : importResultItems">
+                                    <td><i class="material-icons left" t:text="item.entityType.icon">icon</i>
+                                        <div class="import-entity-name" t:text="locale.getString(item.entityType.localizationKey)">name</div>
+                                    </td>
+                                    <td><i t:if="item.numberOfImportedItems != item.numberOfAvailableItems" class="fas fa-exclamation-triangle text-red"></i></td>
+                                    <td>[[${item.numberOfImportedItems}]]/[[${item.numberOfAvailableItems}]]</td>
+                                </tr>
+                            </table>
+                        </div>
+                    </div>
+                </div>
+
+                <div t:if="errorMessages != null && !errorMessages.isEmpty()" class="container">
