+            </li>
+            <li>
+                <a t:href="@{/transactions/newTransaction/normal}" class="btn-floating btn background-orange"><i class="material-icons">payment</i></a>
+                <a t:href="@{/transactions/newTransaction/normal}" class="btn-floating btn mobile-fab-tip no-wrap" t:text="locale.getString('title.transaction.new.normal')">x</a>
