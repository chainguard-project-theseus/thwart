+	}
+
+	/**
+	 * The chart's script with the transaction data and container ID filled in (charts.ftl did this with ?replace).
+	 */
+	private static String buildChartScript(Chart chart, String transactionJson, String containerID)
+	{
+		String script = chart.getScript();
+		if(script == null)
+		{
+			return "";
+		}
+		script = script.replace("var transactionData = [];", "var transactionData = " + transactionJson + ";");
+		return script.replace("containerID", containerID);
+	}
+
