+package de.deadlocker8.budgetmaster.view;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Helpers for the settings, index, about and error pages (agent a6).
+ */
+@TemplateFunctions("text")
+public final class TextFunctions
+{
+	private TextFunctions()
+	{
+	}
+
+	/**
+	 * Splits a localized message at its {@code <br>} tags. FreeMarker printed these messages raw;
+	 * the template prints each line escaped and puts a real {@code <br>} element between them.
+	 */
+	@TemplateFunction
+	public static List<String> lines(String text)
+	{
+		if(text == null)
+		{
+			return List.of();
+		}
+		return Arrays.asList(text.split("(?i)<br\\s*/?>", -1));
+	}
+
+	/**
+	 * FreeMarker's {@code enumValue.name()?lower_case}.
+	 */
+	@TemplateFunction
+	public static String lowerName(Object value)
+	{
+		return value == null ? "" : ((Enum<?>) value).name().toLowerCase(Locale.ROOT);
+	}
+}
