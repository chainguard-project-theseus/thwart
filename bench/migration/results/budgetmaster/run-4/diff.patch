+<div xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState, de.deadlocker8.budgetmaster.categories.Category">
+
+<!-- customSelectMacros.ftl: <@accountIcon account accountName classes datasetValue/> -->
+<div t:fragment="accountIcon(PageContext page, Account account, String accountName, String classes, String datasetValue)"
+     t:class="|category-circle ${classes} category-square ${account.iconReference != null && account.iconReference.isFallbackIcon() ? 'account-square-border' : ''}|"
+     t:data-value="#strings.isEmpty(datasetValue) ? null : view.c(account.ID)">
+    <t:block t:replace="~{helpers/colors :: iconSpan(view.fontColor(account, page.darkTheme), account.iconReference, 'account-select-icon', accountName)}"></t:block>
+</div>
+
+<!-- customSelectMacros.ftl: customSelectStart/customSelectEnd are inlined into the three select fragments below. -->
+
+<!-- customSelectMacros.ftl: <@customCategorySelect categories selectedCategory inputClasses labelText id showName rowClasses disabled form/>
+     FreeMarker defaults: showName=true, rowClasses='', disabled=false, form=''. selectedCategory may be null. -->
+<div t:fragment="customCategorySelect(PageContext page, List<Category> categories, Category selectedCategory, String inputClasses, String labelText, String id, boolean showName, String rowClasses, boolean disabled, String form)"
+     t:class="|row ${rowClasses}|">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix">label</i>
+        <label t:unless="#strings.isEmpty(labelText)" class="input-label" t:for="id" t:text="labelText">label</label>
+        <div t:class="|custom-select-wrapper category-select-wrapper ${disabled ? 'disabled' : ''}|" t:id="id">
+            <div class="custom-select">
+                <div class="custom-select-trigger" tabindex="0">
+                    <div class="custom-select-selected-item">
+                        <t:block t:if="selectedCategory != null"><t:block t:replace="~{::customSelectOptionCategoryContent(page, selectedCategory, 'no-margin-left', true, showName)}"></t:block></t:block>
+                    </div>
+                    <div class="custom-select-arrow"></div>
+                </div>
+                <div class="custom-select-options">
+                    <t:block t:each="category : categories">
+                        <t:block t:unless="category.type == 'REST'"><t:block t:replace="~{::customSelectCategoryOption(page, category, selectedCategory != null ? selectedCategory.ID == category.ID : category.type == 'NONE')}"></t:block></t:block>
+                    </t:block>
+                </div>
+            </div>
+            <input type="hidden" name="category" class="hidden-input-custom-select" t:value="selectedCategory != null ? view.c(selectedCategory.ID) : null" t:form="#strings.isEmpty(form) ? null : form"/>
+        </div>
+    </div>
+</div>
+
+<!-- customSelectMacros.ftl: <@customAccountSelect selector inputName accounts selectedAccount inputClasses labelText id disabled/>
+     FreeMarker default: disabled=false. Only CUSTOM accounts are listed. selectedAccount may be null. -->
+<div t:fragment="customAccountSelect(PageContext page, String selector, String inputName, List<Account> accounts, Account selectedAccount, String inputClasses, String labelText, String id, boolean disabled)"
+     class="row">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix">account_balance</i>
+        <label t:unless="#strings.isEmpty(labelText)" class="input-label" t:for="id" t:text="labelText">label</label>
+        <div t:class="|custom-select-wrapper ${selector} ${disabled ? 'disabled' : ''}|" t:id="id">
+            <div class="custom-select">
+                <div class="custom-select-trigger" tabindex="0">
+                    <div class="custom-select-selected-item">
+                        <t:block t:if="selectedAccount != null"><t:block t:replace="~{::customSelectOptionAccountContent(page, selectedAccount, 'no-margin-left')}"></t:block></t:block>
+                    </div>
+                    <div class="custom-select-arrow"></div>
+                </div>
+                <div class="custom-select-options">
+                    <t:block t:each="account : accounts">
+                        <t:block t:if="account.type == 'CUSTOM'"><t:block t:replace="~{::customSelectAccountOption(page, account, selectedAccount != null && selectedAccount.ID == account.ID)}"></t:block></t:block>
+                    </t:block>
+                </div>
+            </div>
+            <input type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedAccount != null ? view.c(selectedAccount.ID) : null"/>
+        </div>
+    </div>
+</div>
+
+<!-- customSelectMacros.ftl: <@globalAccountSelect/>; pass page.currentAccount and the readable accounts (helpers.getAllReadableAccounts()) -->
+<div t:fragment="globalAccountSelect(PageContext page, Account currentAccount, List<Account> readableAccounts)" class="input-field no-margin">
+    <div class="custom-select-wrapper global-account-select-wrapper">
+        <div class="custom-select">
+            <div class="custom-select-trigger" tabindex="0">
+                <div class="custom-select-selected-item">
+                    <t:block t:replace="~{::customSelectOptionAccountContent(page, currentAccount, 'no-margin-left')}"></t:block>
+                </div>
+                <div class="custom-select-arrow"></div>
+            </div>
+            <div class="custom-select-options">
+                <t:block t:each="account : readableAccounts"><t:block t:replace="~{::customSelectAccountOption(page, account, account.isSelected())}"></t:block></t:block>
+            </div>
+        </div>
+
+        <input type="hidden" class="hidden-input-custom-select" t:value="view.c(currentAccount.ID)"/>
+    </div>
+</div>
+
+<!-- customSelectMacros.ftl: <@customAccountStateSelect selector inputName availableStates selectedState inputClasses labelText id/>; selectedState may be null -->
+<div t:fragment="customAccountStateSelect(String selector, String inputName, List<AccountState> availableStates, AccountState selectedState, String inputClasses, String labelText, String id)"
+     class="row">
+    <div t:class="|input-field ${inputClasses}|">
+        <i class="material-icons prefix">visibility</i>
+        <label t:unless="#strings.isEmpty(labelText)" class="input-label" t:for="id" t:text="labelText">label</label>
+        <div t:class="|custom-select-wrapper ${selector}|" t:id="id">
+            <div class="custom-select">
+                <div class="custom-select-trigger" tabindex="0">
+                    <div class="custom-select-selected-item">
+                        <t:block t:if="selectedState != null"><t:block t:replace="~{::customSelectOptionAccountStateContent(selectedState, 'no-margin-left')}"></t:block></t:block>
+                    </div>
+                    <div class="custom-select-arrow"></div>
+                </div>
+                <div class="custom-select-options">
+                    <t:block t:each="state : availableStates"><t:block t:replace="~{::customSelectAccountStateOption(state, selectedState == state)}"></t:block></t:block>
+                </div>
+            </div>
+            <input type="hidden" t:name="inputName" class="hidden-input-custom-select" t:value="selectedState != null ? enums.name(selectedState) : null"/>
+        </div>
+    </div>
+</div>
+
+<!-- customSelectMacros.ftl: <@customSelectCategoryOption category isSelected/> -->
+<div t:fragment="customSelectCategoryOption(PageContext page, Category category, boolean isSelected)"
+     t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="view.c(category.ID)">
+    <t:block t:replace="~{::customSelectOptionCategoryContent(page, category, '', false, true)}"></t:block>
+</div>
+
+<!-- customSelectMacros.ftl: <@customSelectOptionCategoryContent category classes datasetValue showName/>
+     FreeMarker defaults: classes='', datasetValue=false, showName=true -->
+<t:block t:fragment="customSelectOptionCategoryContent(PageContext page, Category category, String classes, boolean datasetValue, boolean showName)">
+    <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(page, category, |category-circle-small ${classes}|, datasetValue, false)}"></t:block>
+    <span t:if="showName" class="custom-select-item-name" t:text="categories.name(category)">name</span>
+</t:block>
+
+<!-- customSelectMacros.ftl: <@customSelectAccountOption account isSelected/> -->
+<div t:fragment="customSelectAccountOption(PageContext page, Account account, boolean isSelected)"
+     t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="view.c(account.ID)">
+    <t:block t:replace="~{::customSelectOptionAccountContent(page, account, '')}"></t:block>
+</div>
+
+<!-- customSelectMacros.ftl: <@customSelectOptionAccountContent account classes/> (FreeMarker default classes='') -->
+<t:block t:fragment="customSelectOptionAccountContent(PageContext page, Account account, String classes)"
+         t:with="accountName=account.type == 'ALL' ? locale.getString('account.all') : account.name">
+    <t:block t:replace="~{::accountIcon(page, account, accountName, |category-circle-small ${classes}|, '')}"></t:block>
+    <span class="custom-select-item-name" t:text="accountName">name</span>
+</t:block>
+
+<!-- customSelectMacros.ftl: <@customSelectAccountStateOption state isSelected/> -->
+<div t:fragment="customSelectAccountStateOption(AccountState state, boolean isSelected)"
+     t:class="|custom-select-option ${isSelected ? 'selected' : ''}|" t:data-value="enums.name(state)">
+    <t:block t:replace="~{::customSelectOptionAccountStateContent(state, '')}"></t:block>
+</div>
+
+<!-- customSelectMacros.ftl: <@customSelectOptionAccountStateContent state classes/> (FreeMarker default classes='') -->
+<t:block t:fragment="customSelectOptionAccountStateContent(AccountState state, String classes)">
+    <div t:class="|category-circle category-circle-small ${classes}|" t:data-value="enums.name(state)">
+        <span class="text-blue">
+            <i t:class="state.icon"></i>
+        </span>
+    </div>
+    <span class="custom-select-item-name" t:text="locale.getString(state.localizationKey)">name</span>
+</t:block>
+
+</div>
