+<div xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.transactions.Transaction">
+
+<div t:fragment="transactionType(Transaction transaction, String size)" t:class="|col ${size} left-align transaction-row-transparent-child|">
+    <i t:if="transaction.isRepeating()" class="material-icons">repeat</i>
+    <i t:if="transaction.isTransfer()" class="material-icons tooltipped" data-position="bottom" t:data-tooltip="|${transaction.account.name} ➔ ${transaction.transferAccount.name}|">swap_horiz</i>
+
+    <i t:if="!transaction.isRepeating() && !transaction.isTransfer()" class="material-icons invisible">repeat</i>
+</div>
+
+<div t:fragment="transactionCategory(PageContext page, Transaction transaction, String alignment)" t:class="|col s2 l1 xl1 ${alignment} transaction-row-transparent-child|">
+    <div class="hide-on-med-and-down">
+        <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(page, transaction.category, '', false, true)}"></t:block>
+    </div>
+    <div class="hide-on-large-only">
+        <t:block t:replace="~{categories/categoriesFunctions :: categoryCircle(page, transaction.category, 'category-circle-small', false, true)}"></t:block>
+    </div>
+</div>
+
+<div t:fragment="transactionNameAndDescription(Transaction transaction, String size)" t:class="|col ${size} transaction-row-transparent-child|">
+    <div class="truncate transaction-text" t:text="transaction.name">name</div>
+    <div class="hide-on-med-and-down">
+        <div t:if="transaction.description != null" class="italic" t:text="transaction.description">description</div>
+    </div>
+</div>
+
+<div t:fragment="transactionAmount(PageContext page, Transaction transaction, Account account, String size)"
+     t:with="amount=txList.amount(transaction, account)"
+     t:class="|col ${size} bold ${amount <= 0 ? page.redTextColor : page.greenTextColor} no-wrap right-align transaction-text transaction-row-transparent-child|"
+     t:text="txList.currency(amount)">0</div>
+
+<div t:fragment="transactionButtons(Transaction transaction, String classes)" t:class="|col ${classes} transaction-buttons no-wrap|">
+    <t:block t:if="transaction.isEditable()">
+        <t:block t:replace="~{::transactionEditButton(transaction)}"></t:block>
+        <t:block t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/requestDelete', 'delete', '', '', 'no-padding text-default button-request-delete-transaction', true, false, '', '', '')}"></t:block>
+    </t:block>
+    <t:block t:if="transaction.isAllowedToFillNewTransaction()">
+        <t:block t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/newFromExisting', 'content_copy', '', '', 'no-padding text-default button-new-from-existing', false, false, '', '', '')}"></t:block>
+    </t:block>
+</div>
+
+<t:block t:fragment="transactionEditButton(Transaction transaction)">
+    <div t:if="transaction.isRepeating()" class="fixed-action-btn edit-transaction-button">
+        <a class="btn-floating btn-flat waves-effect waves-light no-padding text-default edit-transaction-button-link">
+            <i class="material-icons">edit</i>
+        </a>
+        <ul class="new-transaction-button-list">
+            <li>
+                <a t:href="@{/transactions/{id}/edit(id=transaction.ID)}" class="btn-floating btn mobile-fab-tip no-wrap button-edit-all-occurrences" t:text="locale.getString('title.transaction.edit', locale.getString('title.transaction.new.normal'))">edit</a>
+                <a t:href="@{/transactions/{id}/edit(id=transaction.ID)}" class="btn-floating btn background-green-dark"><i class="material-icons">edit</i></a>
+            </li>
+            <li>
+                <a t:href="@{/transactions/{id}/editFutureRepetitions(id=transaction.ID)}" class="btn-floating btn mobile-fab-tip no-wrap button-edit-future-occurrences" t:text="locale.getString('repeating.button.edit.future')">future</a>
+                <a t:href="@{/transactions/{id}/editFutureRepetitions(id=transaction.ID)}" class="btn-floating btn background-orange"><i class="material-icons">move_up</i></a>
+            </li>
+        </ul>
+    </div>
+    <t:block t:unless="transaction.isRepeating()">
+        <t:block t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/edit', 'edit', '', '', 'no-padding text-default button-edit', false, false, '', '', '')}"></t:block>
+    </t:block>
+</t:block>
+
+<t:block t:fragment="transactionAccountIcon(PageContext page, Transaction transaction)">
+    <a t:if="page.currentAccount.type == 'ALL' && transaction.account != null" t:href="@{/accounts/{id}/select(id=transaction.account.ID)}">
+        <div class="col s2 l1 xl1 tooltipped no-padding transaction-row-transparent-child" data-position="bottom" t:data-tooltip="transaction.account.name">
+            <div class="hide-on-med-and-down">
+                <t:block t:replace="~{helpers/customSelectMacros :: accountIcon(page, transaction.account, transaction.account.name, '', '')}"></t:block>
+            </div>
+            <div class="hide-on-large-only">
+                <t:block t:replace="~{helpers/customSelectMacros :: accountIcon(page, transaction.account, transaction.account.name, 'category-circle-small', '')}"></t:block>
+            </div>
+        </div>
+    </a>
+</t:block>
+
+<!-- transactionLinks(transaction, target): FreeMarker default target='' -->
