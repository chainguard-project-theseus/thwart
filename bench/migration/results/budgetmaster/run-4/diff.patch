+import java.time.LocalDate;
+
+/**
+ * Values that accounts/* and categories/* templates got from {@code dateService} and {@code helpers}
+ * (owner: agent a3).
+ */
+@TemplateFunctions("a3view")
+public final class AccountViewFunctions
+{
+	private AccountViewFunctions()
+	{
+	}
+
+	/**
+	 * {@code dateService.getDateStringNormal(date)}.
+	 */
+	@TemplateFunction
+	public static String dateNormal(LocalDate date)
+	{
+		return date == null ? "" : SpringBeans.get(DateService.class).getDateStringNormal(date);
+	}
+
+	/**
+	 * {@code helpers.getUsageCountForCategory(category)}.
+	 */
+	@TemplateFunction
+	public static Long usageCount(Category category)
+	{
+		return SpringBeans.get(HelpersService.class).getUsageCountForCategory(category);
+	}
+
+	/**
+	 * {@code dateService.getLongDateString(date)}.
+	 */
+	@TemplateFunction
+	public static String dateLong(LocalDate date)
+	{
+		return date == null ? "" : SpringBeans.get(DateService.class).getLongDateString(date);
+	}
+
+	/**
+	 * The controller's AccountState[] as a List (customAccountStateSelect takes a List).
+	 */
+	@TemplateFunction
+	public static java.util.List<de.deadlocker8.budgetmaster.accounts.AccountState> states(de.deadlocker8.budgetmaster.accounts.AccountState[] states)
+	{
+		return states == null ? java.util.List.of() : java.util.Arrays.asList(states);
+	}
+}
