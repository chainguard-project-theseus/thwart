+import de.deadlocker8.budgetmaster.update.BudgetMasterUpdateService;
+import de.deadlocker8.budgetmaster.utils.notification.Notification;
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateView;
+
+import java.util.List;
+
+/**
+ * Everything the shared page chrome (header, navbar, notifications, scripts) reads.
+ * Provided to every view as model attribute "page" by {@link PageContextAdvice}.
+ * Values are computed lazily so that pages which don't render the navbar don't pay for it.
+ */
+@TemplateView
+public class PageContext
+{
+	private final Settings settings;
+	private final List<Notification> notifications;
+	private final HelpersService helpers;
+	private final CurrencyService currencyService;
+	private final BudgetMasterUpdateService updateService;
+
+	public PageContext(Settings settings, List<Notification> notifications, HelpersService helpers, CurrencyService currencyService, BudgetMasterUpdateService updateService)
+	{
+		this.settings = settings;
+		this.notifications = notifications;
+		this.helpers = helpers;
+		this.currencyService = currencyService;
+		this.updateService = updateService;
+	}
+
+	public Settings getSettings()
+	{
+		return settings;
+	}
+
+	public boolean isDarkTheme()
+	{
+		return settings != null && settings.isUseDarkTheme();
+	}
+
+	public boolean isCategorySquare()
+	{
+		return settings != null && settings.getShowCategoriesAsCircles() != null && !settings.getShowCategoriesAsCircles();
+	}
+
+	public String getGreenTextColor()
+	{
+		return isDarkTheme() ? "text-green" : "text-green-dark";
+	}
+
+	public String getRedTextColor()
+	{
+		return isDarkTheme() ? "text-red-light" : "text-red";
+	}
+
+	public List<Notification> getNotifications()
+	{
+		return notifications;
+	}
+
+	public Account getCurrentAccount()
+	{
+		return helpers.getCurrentAccount();
+	}
+
+	public String getCurrentAccountName()
+	{
+		final Account account = getCurrentAccount();
+		if(account.getType() == AccountType.ALL)
+		{
+			return Localization.getString("account.all");
+		}
+		return account.getName();
+	}
+
+	public int getCurrentAccountBudget()
+	{
+		return helpers.getCurrentAccountBudget();
+	}
+
+	public String getCurrentAccountBudgetString()
+	{
+		return currencyService.getCurrencyString(getCurrentAccountBudget());
+	}
+
+	public boolean isUpdateAvailable()
+	{
+		return updateService.isUpdateAvailable();
+	}
+
+	public boolean isTestMode()
+	{
+		return ProgramArgs.isTest();
+	}
+
+	public boolean isDebugMode()
+	{
+		return ProgramArgs.isDebug();
+	}
+
+	public boolean isShowBackupReminder()
+	{
+		return settings.needToShowBackupReminder();
+	}
+
+	public boolean isShowWhatsNew()
+	{
+		return settings.needToShowWhatsNew();
+	}
+
+	public AccountEndDateReminderData getAccountEndDateReminderData()
+	{
+		return helpers.getAccountEndDateReminderData();
+	}
+}
