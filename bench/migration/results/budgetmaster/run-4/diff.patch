@@ -0,0 +1,64 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext"
+      t:params="PageContext page, Boolean isError, Boolean isLogout, String currentDate">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('login.button'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/login.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="page.darkTheme ? 'dark'">
+        <main>
+            <div class="row valign-wrapper full-height">
+                <div class="col l4 offset-l4 m6 offset-m3 s10 offset-s1">
+                    <div class="card" id="card-login">
+                        <div class="card-content">
+                            <div class="card-title">
+                                <div id="logo-container" class="center-align"><t:block t:replace="~{helpers/header :: logo(page, 'logo', '')}"></t:block></div>
+                            </div>
+                            <form t:action="@{/login}" method="post" onsubmit="return validateLoginForm()">
+                                <input type="hidden" name="username" value="Default">
+
+                                <div class="row no-margin-bottom">
+                                    <div class="input-field col s12">
+                                        <input id="login-password" type="password" name="password">
+                                        <label for="login-password" t:text="locale.getString('login.password')">Password</label>
+                                    </div>
+                                </div>
+
+                                <div t:if="isError != null" class="row no-margin-bottom">
+                                    <div class="col s12 center-align">
+                                        <table t:class="|${page.redTextColor} login-message no-border-table|">
+                                            <tr>
+                                                <td><i class="material-icons">warning</i></td>
+                                                <td id="loginMessage" t:text="locale.getString('warning.wrong.password')">wrong</td>
+                                            </tr>
+                                        </table>
+                                    </div>
+                                </div>
+
+                                <div t:if="isLogout != null" class="row no-margin-bottom">
+                                    <div class="col s12 center-align">
+                                        <table t:class="|${page.greenTextColor} login-message no-border-table|">
+                                            <tr>
+                                                <td><i class="material-icons">info_outline</i></td>
+                                                <td id="loginMessage" t:text="locale.getString('logout.success')">logout</td>
+                                            </tr>
+                                        </table>
+                                    </div>
+                                </div>
+
+                                <div class="row login-margin-top">
+                                    <div class="col s12 right-align">
+                                        <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'send', 'login.button', '', 'background-blue', '', false, '', '', '')}"></t:block>
+                                    </div>
+                                </div>
+                            </form>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </main>
+
+        <!--  Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script>document.cookie = [['currentDate=' + ${currentDate}]];</script>
+    </body>
+</html>
