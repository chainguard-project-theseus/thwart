diff --git a/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html b/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html
new file mode 100644
index 00000000..0102341b
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/accounts/newAccount.html
@@ -0,0 +1,113 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.view.ValidationErrors, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.accounts.AccountState"
+      t:params="PageContext page, Account account, AccountState[] availableAccountStates, List<String> fontawesomeIcons, LocalDate today, ValidationErrors validationErrors, List<String> localizedMonthNames, List<String> localizedWeekdays">
+    <head t:with="title=account.ID != null ? locale.getString('title.account.edit') : locale.getString('title.account.new')">
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="page.darkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar(page, 'accounts')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="account.ID != null ? locale.getString('title.account.edit') : locale.getString('title.account.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: showNotifications(page.notifications)}"></t:block>
+                    <div class="container">
+                    <form name="NewAccount" t:action="@{/accounts/newAccount}" method="post">
+                        <input type="hidden" name="ID" t:value="view.c(account.ID)">
+                        <input type="hidden" name="isSelected" t:value="account.isSelected() == null ? '' : '' + account.isSelected()">
+                        <input type="hidden" name="isDefault" t:value="account.isDefault() == null ? '' : '' + account.isDefault()">
+
+                        <!-- name -->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">edit</i>
+                                <input id="account-name" type="text" name="name"
+                                       t:class="validation.classes(validationErrors, 'name', '')" t:data-position="validation.position(validationErrors, 'name')"
+                                       t:data-delay="validation.delay(validationErrors, 'name')" t:data-tooltip="validation.tooltip(validationErrors, 'name')"
+                                       t:value="account.name ?: ''">
+                                <label for="account-name" t:text="locale.getString('account.new.label.name')">Name</label>
+                            </div>
+                        </div>
+
+                        <!-- description -->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">article</i>
+                                <textarea id="account-description" name="description" data-length="250"
+                                          t:class="validation.classes(validationErrors, 'description', 'materialize-textarea')" t:data-position="validation.position(validationErrors, 'description')"
+                                          t:data-delay="validation.delay(validationErrors, 'description')" t:data-tooltip="validation.tooltip(validationErrors, 'description')"
+                                          t:text="account.description">description</textarea>
+                                <label class="input-label" for="account-description" t:text="locale.getString('transaction.new.label.description')">Description</label>
+                            </div>
+                        </div>
+
+                        <!-- icon -->
+                        <t:block t:replace="~{helpers/iconSelect :: iconSelect(page, 'account-icon', account.iconReference, view.fontColor(account, page.darkTheme), '', account.name, false, account.iconReference != null && (account.iconReference.isImageIcon() || account.iconReference.isBuiltinIcon()) ? 'category-square' : 'category-square account-square-border', 'category-square account-square-border', false)}"></t:block>
+
+                        <!-- font color -->
+                        <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(view.fontColor(account, page.darkTheme), icons.defaultFontColor(account, page.darkTheme))}"></t:block>
+
+                        <!-- state -->
+                        <t:block t:replace="~{helpers/customSelectMacros :: customAccountStateSelect('account-state-select-wrapper', 'accountState', a3view.states(availableAccountStates), account.accountState != null ? account.accountState : availableAccountStates[0], 'col s12 m12 l8 offset-l2', locale.getString('account.new.label.state'), 'account-state')}"></t:block>
+
+                        <!-- end date -->
+                        <div class="row">
+                            <div class="input-field col s12 m12 l8 offset-l2">
+                                <i class="material-icons prefix">notifications</i>
+                                <input id="account-datepicker" type="text" class="datepicker" name="endDate" t:value="a3view.dateLong(account.endDate)">
+                                <label class="input-label" for="account-datepicker" t:text="locale.getString('account.new.label.endDate')">End date</label>
+                            </div>
+                        </div>
+
+                        <script>
+                            startDate = [[${a3view.dateLong(account.endDate != null ? account.endDate : today)}]].split(".");
+                            startDate = new Date(startDate[2], startDate[1]-1, startDate[0]);
+                        </script>
+
+                        <br>
+
+                        <!-- buttons -->
+                        <div class="row hide-on-small-only">
+                            <div class="col s6 right-align">
+                                <t:block t:replace="~{helpers/header :: buttonLink(@{/accounts}, 'clear', 'cancel', 'button-cancel-save-account', 'red', '', false, false, false, '')}"></t:block>
+                            </div>
+
+                            <div class="col s6 left-align">
+                                <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', false, '', '', '')}"></t:block>
+                            </div>
+                        </div>
+                        <div class="hide-on-med-and-up">
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonLink(@{/accounts}, 'clear', 'cancel', 'button-cancel-save-account', 'red', '', false, false, false, '')}"></t:block>
+                                </div>
+                            </div>
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', 'button-save-account', 'green', '', false, '', '', '')}"></t:block>
+                                </div>
+                            </div>
+                        </div>
+                    </form>
+                </div>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/iconSelect :: modalIconSelect('account-name', account.iconReference, fontawesomeIcons)}"></t:block>
+
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></t:block>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/accounts.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
