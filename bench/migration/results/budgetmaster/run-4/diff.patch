new file mode 100644
index 00000000..a345b829
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/templates/templateFunctions.html
@@ -0,0 +1,138 @@
+<div xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.templategroup.TemplateGroup, de.deadlocker8.budgetmaster.view.ValidationErrors">
+
+<!-- templateFunctions.ftl: <@buttonNew/> -->
+<t:block t:fragment="buttonNew">
+    <t:block t:replace="~{helpers/header :: buttonLink('/templates/newTemplate', 'add', 'title.template.new', '', 'background-blue', '', false, false, false, '')}"></t:block>
+</t:block>
+
+<!-- templateFunctions.ftl: <@buttonEditTemplateGroups/> -->
+<t:block t:fragment="buttonEditTemplateGroups">
+    <t:block t:replace="~{helpers/header :: buttonLink('/templateGroups', 'folder', 'title.template.group.edit.short', '', 'background-blue', '', false, false, false, '')}"></t:block>
+</t:block>
+
+<!-- templateFunctions.ftl: <@buttons/> -->
+<t:block t:fragment="buttons">
+    <div class="row valign-wrapper hide-on-small-only">
+        <div class="col s6 right-align">
+            <t:block t:replace="~{::buttonNew}"></t:block>
+        </div>
+
+        <div class="col s6 left-align">
+            <t:block t:replace="~{::buttonEditTemplateGroups}"></t:block>
+        </div>
+    </div>
+    <div class="hide-on-med-and-up">
+        <div class="row valign-wrapper center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonNew}"></t:block>
+            </div>
+        </div>
+        <div class="row valign-wrapper center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonEditTemplateGroups}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!-- templateFunctions.ftl: <@listTemplates templatesByGroup/> -->
+<t:block t:fragment="listTemplates(PageContext page, Map<TemplateGroup, List<Template>> templatesByGroup)">
+    <div class="container">
+        <div class="row">
+            <div class="col s12">
+                <ul t:each="entry : templatesByGroup" class="collapsible expandable templateCollapsible" t:data-group-id="entry.key.ID">
+                    <div t:if="templatesByGroup.size() != 1" class="template-group-headline" t:text="templatesView.groupName(entry.key)">group</div>
+
+                    <t:block t:each="template : entry.value"><t:block t:replace="~{::templateItem(page, template)}"></t:block></t:block>
+                </ul>
+            </div>
+        </div>
+    </div>
+
+    <form id="form-move-template-to-group" method="post" t:action="@{/templateGroups/moveTemplateToGroup}">
+        <input type="hidden" name="templateID" value=""/>
+        <input type="hidden" name="groupID" value=""/>
+    </form>
+</t:block>
+
+<!-- templateFunctions.ftl: <@templateItem template/> -->
+<li t:fragment="templateItem(PageContext page, Template template)" class="template-item z-depth-2" t:data-template-id="template.ID">
+    <div class="collapsible-header bold">
+        <t:block t:replace="~{::templateHeader(page, template)}"></t:block>
+        <div class="collapsible-header-button">
+            <t:block t:replace="~{helpers/header :: buttonFlat('/templates/' + template.ID + '/edit', 'edit', '', '', 'no-padding text-default', false, false, '', '', '')}"></t:block>
+            <t:block t:replace="~{helpers/header :: buttonFlat('/templates/' + template.ID + '/requestDelete', 'delete', '', '', 'no-padding text-default button-request-delete-template', true, false, '', '', '')}"></t:block>
+            <t:block t:replace="~{helpers/header :: buttonLink('/templates/' + template.ID + '/select', 'note_add', '', '', 'background-blue', 'button-select-template', false, false, false, '')}"></t:block>
+        </div>
+    </div>
+    <div class="collapsible-body">
+        <div class="row no-margin-bottom">
+            <table class="table-template-content text-default">
+                <tr t:if="!#strings.isEmpty(template.name)">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.name')">label</td>
+                    <td t:text="template.name">name</td>
+                </tr>
+                <tr t:if="template.amount != null">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.amount')">label</td>
+                    <td t:text="transactionView.currencyString(template.amount)">amount</td>
+                </tr>
+                <tr t:if="template.category != null">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.category')">label</td>
+                    <td t:text="categories.name(template.category)">category</td>
+                </tr>
+                <tr t:if="!#strings.isEmpty(template.description)">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.description')">label</td>
+                    <td t:text="template.description">description</td>
+                </tr>
+                <tr t:if="template.tags != null && !template.tags.isEmpty()">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.tags')">label</td>
+                    <td class="chips-placeholder">
+                        <div t:each="tag : template.tags" class="chip" t:text="tag.name">tag</div>
+                    </td>
+                </tr>
+                <tr t:if="template.account != null">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.account')">label</td>
+                    <td t:text="template.account.name">account</td>
+                </tr>
+                <tr t:if="template.transferAccount != null">
+                    <td class="template-content-label" t:text="locale.getString('transaction.new.label.transfer.account')">label</td>
+                    <td t:text="template.transferAccount.name">account</td>
+                </tr>
+            </table>
+        </div>
+    </div>
+</li>
+
+<!-- templateFunctions.ftl: <@templateHeader template/> -->
+<t:block t:fragment="templateHeader(PageContext page, Template template)">
+    <t:block t:replace="~{helpers/colors :: span('color', view.fontColor(template, page.darkTheme), null, null, null, ~{::templateHeaderIcon(template)})}"></t:block>
+    <div class="truncate template-header-name" t:text="template.templateName">name</div>
+</t:block>
+
+<!-- the content of templateHeader's coloured span -->
+<t:block t:fragment="templateHeaderIcon(Template template)">
+    <t:block t:if="template.iconReference != null && (template.iconReference.isImageIcon() || template.iconReference.isBuiltinIcon())"><t:block t:replace="~{helpers/header :: entityIcon(template.iconReference, 'template-icon', '')}"></t:block></t:block>
+    <i t:if="!(template.iconReference != null && (template.iconReference.isImageIcon() || template.iconReference.isBuiltinIcon())) && template.transferAccount != null" class="material-icons">swap_horiz</i>
+    <i t:if="!(template.iconReference != null && (template.iconReference.isImageIcon() || template.iconReference.isBuiltinIcon())) && template.transferAccount == null" class="material-icons">payment</i>
+</t:block>
+
+<!-- templateFunctions.ftl: <@templateNameInput template/> -->
+<div t:fragment="templateNameInput(Template template, ValidationErrors validationErrors)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <i class="material-icons prefix">file_copy</i>
+        <input id="template-name" type="text" name="templateName" t:class="validation.classes(validationErrors, 'templateName', '')" t:data-position="validation.position(validationErrors, 'templateName')" t:data-delay="validation.delay(validationErrors, 'templateName')" t:data-tooltip="validation.tooltip(validationErrors, 'templateName')" t:value="template.templateName">
+        <label for="template-name" t:text="locale.getString('template.new.label.name')">label</label>
+    </div>
+</div>
+
+<!-- templateFunctions.ftl: <@templateIncludeAccountCheckbox id name label checked/> -->
+<div t:fragment="templateIncludeAccountCheckbox(String id, String name, String label, boolean checked)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <label>
+            <input t:id="id" t:name="name" type="checkbox" t:checked="checked">
+            <span class="columnName-checkbox-label text-default" t:text="label">label</span>
+        </label>
+    </div>
+</div>
+
+</div>
