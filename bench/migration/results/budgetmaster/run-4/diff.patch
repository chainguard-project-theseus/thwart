diff --git a/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html b/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html
new file mode 100644
index 00000000..0ea916d8
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/templates/newTemplate.html
@@ -0,0 +1,85 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.templates.Template, de.deadlocker8.budgetmaster.categories.Category, de.deadlocker8.budgetmaster.accounts.Account, de.deadlocker8.budgetmaster.view.ValidationErrors"
+      t:params="PageContext page, boolean isEdit, Template template, List<Category> categories, List<Account> accounts, List<String> nameSuggestions, List<String> fontawesomeIcons, ValidationErrors validationErrors, List<String> localizedMonthNames, List<String> localizedWeekdays">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + (isEdit ? locale.getString('title.template.edit') : locale.getString('title.template.new')))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/datepicker.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="page.darkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar(page, 'templates')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="isEdit ? locale.getString('title.template.edit') : locale.getString('title.template.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: showNotifications(page.notifications)}"></t:block>
+                <div class="container">
+                    <form id="mainForm" name="NewTemplate" t:action="@{/templates/newTemplate}" method="post">
+                        <input type="hidden" name="ID" t:value="view.c(template.ID)">
+                        <input type="hidden" name="templateGroup" t:value="template.templateGroup == null ? '' : view.c(template.templateGroup.ID)">
+
+                        <!-- isPayment switch -->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: isExpenditureSwitch(template.getExpenditure())}"></t:block>
+
+                        <!-- template name -->
+                        <t:block t:replace="~{templates/templateFunctions :: templateNameInput(template, validationErrors)}"></t:block>
+
+                        <!-- name -->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionName(template.name, nameSuggestions, validationErrors)}"></t:block>
+
+                        <!-- amount -->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionAmount(template.amount, validationErrors)}"></t:block>
+
+                        <!-- category -->
+                        <t:block t:replace="~{helpers/customSelectMacros :: customCategorySelect(page, categories, template.category, 'col s12 m12 l8 offset-l2', locale.getString('transaction.new.label.category'), 'transaction-category', true, '', false, '')}"></t:block>
+
+                        <!-- description -->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionDescription(template.description, validationErrors)}"></t:block>
+
+                        <!-- tags -->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: transactionTags(template.tags)}"></t:block>
+
+                        <!-- account -->
+                        <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-account', 'includeAccount', locale.getString('template.checkbox.include.account'), template.account != null)}"></t:block>
+                        <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect(page, 'account-select-wrapper', 'account', accounts, template.account != null ? template.account : transactionView.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', '', 'transaction-account', template.account == null)}"></t:block>
+
+                        <!-- transfer account -->
+                        <t:block t:replace="~{templates/templateFunctions :: templateIncludeAccountCheckbox('include-transfer-account', 'includeTransferAccount', locale.getString('template.checkbox.include.account.transfer'), template.transferAccount != null)}"></t:block>
+                        <t:block t:replace="~{helpers/customSelectMacros :: customAccountSelect(page, 'transfer-account-select-wrapper', 'transferAccount', accounts, template.transferAccount != null ? template.transferAccount : transactionView.currentAccountOrDefault(), 'col s12 m12 l8 offset-l2', '', 'transaction-destination-account', template.transferAccount == null)}"></t:block>
+
+                        <!-- icon -->
+                        <t:block t:replace="~{helpers/iconSelect :: iconSelect(page, 'template-icon', template.iconReference, view.fontColor(template, page.darkTheme), '', '', false, '', '', true)}"></t:block>
+
+                        <!-- font color -->
+                        <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(view.fontColor(template, page.darkTheme), icons.defaultFontColor(template, page.darkTheme))}"></t:block>
+
+                        <!-- buttons -->
+                        <t:block t:replace="~{transactions/newTransactionMacros :: buttons('/templates', false, true, false)}"></t:block>
+                    </form>
+
+                    <div id="transactionNameKeywordWarningModalContainer"></div>
+                </div>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/iconSelect :: modalIconSelect('template-name', template.iconReference, fontawesomeIcons)}"></t:block>
+
+        <!-- Pass localization to JS -->
+        <t:block t:replace="~{helpers/globalDatePicker :: datePickerLocalization(localizedMonthNames, localizedWeekdays)}"></t:block>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/helpers.js}"></script>
+        <script t:src="@{/js/transactions.js}"></script>
+        <script t:src="@{/js/templates.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
