+	/**
+	 * Values charts/charts.html read from dateService and helpers under FreeMarker.
+	 */
+	private void addViewAttributes(Model model, ChartSettings chartSettings)
+	{
+		model.addAttribute(ModelAttributes.START_DATE, dateService.getLongDateString(chartSettings.getStartDate()));
+		model.addAttribute(ModelAttributes.END_DATE, dateService.getLongDateString(chartSettings.getEndDate()));
