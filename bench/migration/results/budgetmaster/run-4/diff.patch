+                   t:value="quantity">
+            <label for="transaction-repeating-modifier" t:text="locale.getString('transaction.new.label.repeating.all')">All</label>
+        </div>
+        <input type="hidden" id="hidden-transaction-repeating-modifier" name="repeatingModifierNumber" t:value="quantity">
+
+        <div class="input-field col s6 m6 l4" t:with="selectedOption=locale.getString(repeatingOption != null ? repeatingOption.modifier.localizationKey : 'repeating.modifier.months')">
+            <select id="transaction-repeating-modifier-type" name="repeatingModifierType">
+                <option t:each="modifierType : transactionView.repeatingModifierTypes()"
+                        t:with="modifierName=locale.getString(modifierType.localizationKey)"
+                        t:selected="selectedOption == modifierName" t:value="modifierName" t:text="modifierName">Months</option>
+            </select>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="repeatingEndOption(RepeatingOption repeatingOption, LocalDate currentDate)">
+    <div class="row" id="transaction-repeating-end" t:with="endKey=transactionView.endOptionKey(repeatingOption)">
+        <div class="col s12 m12 l8 offset-l2">
+            <div class="row">
+                <div class="col s12 left-align" t:text="locale.getString('repeating.end')">End</div>
+            </div>
+            <t:block t:replace="~{::repeatingEndNever(repeatingOption == null || endKey == 'repeating.end.key.never')}"></t:block>
+            <t:block t:replace="~{::repeatingEndAfterXTimes(endKey == 'repeating.end.key.afterXTimes', repeatingOption)}"></t:block>
+            <t:block t:replace="~{::repeatingEndDate(endKey == 'repeating.end.key.date', repeatingOption, currentDate)}"></t:block>
+            <input type="hidden" id="hidden-transaction-repeating-end-value" name="repeatingEndValue" value="">
+        </div>
+    </div>
+</t:block>
+
+<div t:fragment="repeatingEndNever(boolean checked)" class="row valign-wrapper">
+    <div class="col s1">
+        <label>
+            <input class="with-gap" name="repeatingEndType" type="radio" id="repeating-end-never" t:value="locale.getString('repeating.end.key.never')" t:checked="checked"/>
+            <span for="repeating-end-never"></span>
+        </label>
+    </div>
+    <div class="col s11" t:text="locale.getString('repeating.end.never')">Never</div>
+</div>
+
+<div t:fragment="repeatingEndAfterXTimes(boolean checked, RepeatingOption repeatingOption)" class="row valign-wrapper">
+    <div class="col s1">
+        <label>
+            <input class="with-gap" name="repeatingEndType" type="radio" id="repeating-end-after-x-times" t:value="locale.getString('repeating.end.key.afterXTimes')" t:checked="checked"/>
+            <span for="repeating-end-after-x-times"></span>
+        </label>
+    </div>
+    <div class="col s11">
+        <table class="table-repeating-end no-border-table">
+            <tr>
+                <td class="cell" t:text="locale.getString('repeating.end.afterXTimes.A')">A</td>
+                <td class="cell input-cell">
+                    <div class="input-field no-margin">
+                        <input class="no-margin input-min-width" id="transaction-repeating-end-after-x-times-input" type="text" t:value="checked ? transactionView.endOptionValue(repeatingOption) : ''">
+                        <label for="transaction-repeating-end-after-x-times-input"></label>
+                    </div>
+                </td>
+                <td class="cell stretched-cell" t:text="locale.getString('repeating.end.afterXTimes.B')">B</td>
+            </tr>
+        </table>
+    </div>
+</div>
+
+<t:block t:fragment="repeatingEndDate(boolean checked, RepeatingOption repeatingOption, LocalDate currentDate)" t:with="endDate=transactionView.endDate(checked ? repeatingOption : null, currentDate)">
+    <script>
+        endDate = [[${endDate}]].split(".");
+        endDate = new Date(endDate[2], endDate[1]-1, endDate[0]);
+    </script>
+
+    <div class="row valign-wrapper">
+        <div class="col s1">
+            <label>
+                <input class="with-gap" name="repeatingEndType" type="radio" id="repeating-end-date" t:value="locale.getString('repeating.end.key.date')" t:checked="checked"/>
+                <span for="repeating-end-date"></span>
+            </label>
+        </div>
+        <div class="col s11">
+            <table class="table-repeating-end no-border-table">
+                <tr>
+                    <td class="cell" t:text="locale.getString('repeating.end.date')">Date</td>
+                    <td class="cell input-cell">
+                        <div class="input-field no-margin">
+                            <input t:class="|${transactionView.simpleDatepicker() ? 'datepicker-simple' : 'datepicker'} no-margin input-min-width|" id="transaction-repeating-end-date-input" type="text" t:value="endDate">
+                            <label for="transaction-repeating-end-date-input"></label>
+                        </div>
+                    </td>
+                    <td class="cell stretched-cell"></td>
+                </tr>
+            </table>
+        </div>
+    </div>
+</t:block>
+
+<!-- <@buttons cancelURL includeContinueButton allowEmptyAmount/>; csvImportActive = model attribute "csvImportActive"
+     (was: session attribute currentCsvTransaction?? ; pass false where no CSV import can be active) -->
+<t:block t:fragment="buttons(String cancelURL, boolean includeContinueButton, boolean allowEmptyAmount, boolean csvImportActive)">
+    <div id="keywordCheckUrl" class="hidden" t:data-url="@{/keywords/keywordCheck}"></div>
+
+    <br>
+    <hr>
+    <br>
+
+    <div class="row hide-on-small-only">
+        <div class="col s12 center-align">
+            <t:block t:replace="~{::buttonCancel(cancelURL, csvImportActive)}"></t:block>&nbsp;
+            <t:block t:if="includeContinueButton"><t:block t:replace="~{::buttonSaveAndContinue}"></t:block>&nbsp;</t:block>
+            <t:block t:replace="~{::buttonSave(allowEmptyAmount)}"></t:block>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up">
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonCancel(cancelURL, csvImportActive)}"></t:block>
+            </div>
+        </div>
+        <div t:if="includeContinueButton" class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonSaveAndContinue}"></t:block>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonSave(allowEmptyAmount)}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="buttonCancel(String cancelURL, boolean csvImportActive)">
+    <t:block t:replace="~{helpers/header :: buttonLink(csvImportActive ? '/transactionImport' : cancelURL, 'clear', 'cancel', 'button-cancel-save-transaction', 'red', '', false, false, false, '')}"></t:block>
+</t:block>
+
+<!-- header.buttonSubmit has no onclick parameter (expressions in on* are rejected), so the buttons are written out -->
+<t:block t:fragment="buttonSave(boolean allowEmptyAmount)">
+    <button t:if="allowEmptyAmount" id="button-save-transaction" class="btn waves-effect waves-light green" type="submit" name="action" onclick="return validateForm(false, true, false)">
+        <i class="material-icons left">save</i><t:block t:text="locale.getString('save')">Save</t:block>
+    </button>
+    <button t:unless="allowEmptyAmount" id="button-save-transaction" class="btn waves-effect waves-light green" type="submit" name="action" onclick="return validateForm(false, false, false)">
+        <i class="material-icons left">save</i><t:block t:text="locale.getString('save')">Save</t:block>
+    </button>
+</t:block>
+
+<button t:fragment="buttonSaveAndContinue" id="button-save-transaction-and-continue" class="btn waves-effect waves-light background-blue" type="submit" name="action" value="continue" onclick="return validateForm(true, false, false)">
+    <i class="material-icons left">save</i><t:block t:text="locale.getString('saveAndContinue')">Save and continue</t:block>
+</button>
+
+<!-- <@buttonTransactionActions canChangeType canCreateTemplate changeTypeInProgress/>; transactionId = transaction.ID
+     (only read when canChangeType) -->
+<t:block t:fragment="buttonTransactionActions(boolean canChangeType, boolean canCreateTemplate, boolean changeTypeInProgress, Integer transactionId)">
+    <div t:if="(canChangeType || canCreateTemplate) && !changeTypeInProgress" class="fixed-action-btn" id="transaction-actions-button">
+        <a class="btn-floating btn-large waves-effect waves-light background-blue">
+            <i class="material-icons left">settings</i><t:block t:text="locale.getString('save')">Save</t:block>
+        </a>
+        <ul>
+            <li t:if="canChangeType">
+                <a class="btn-floating btn transaction-action mobile-fab-tip no-wrap" data-action-type="changeType" t:data-url="@{/transactions/{id}/changeTypeModal(id=transactionId)}" t:text="locale.getString('transaction.change.type')">Change type</a>
+                <a class="btn-floating btn transaction-action background-blue-baby" data-action-type="changeType" t:data-url="@{/transactions/{id}/changeTypeModal(id=transactionId)}"><i class="material-icons">shuffle</i></a>
+            </li>
+            <li t:if="canCreateTemplate">
+                <a class="btn-floating btn transaction-action mobile-fab-tip no-wrap" data-action-type="saveAsTemplate" t:data-url="@{/templates/fromTransactionModal}" t:text="locale.getString('save.as.template')">Save as template</a>
+                <a class="btn-floating btn transaction-action background-orange-dark" data-action-type="saveAsTemplate" t:data-url="@{/templates/fromTransactionModal}"><i class="material-icons">file_copy</i></a>
+            </li>
+        </ul>
+    </div>
+</t:block>
+
+</div>
