+    <t:block t:if="transaction.account.accountState == 'FULL_ACCESS'">
+        <t:block t:replace="~{helpers/header :: buttonFlat('/transactions/' + transaction.ID + '/edit', 'edit', '', '', 'no-padding text-default', false, false, '', target, '')}"></t:block>
+    </t:block>
+</div>
+
+<t:block t:fragment="placeholder(List<Transaction> transactions)">
+    <br>
+
+    <div t:if="transactions.size() == 0 || (transactions.size() == 2 && transactions[0].category.type == 'REST' && transactions[1].category.type == 'REST')" class="row">
+        <div class="col s12">
+            <div class="headline center-align" t:text="locale.getString('placeholder.seems.empty')">empty</div>
+            <div class="headline-advice center-align" t:text="locale.getString('placeholder.advice', locale.getString('menu.transactions'))">advice</div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="buttons(PageContext page, boolean isFilterActive)">
+    <div class="row hide-on-small-only valign-wrapper">
+        <t:block t:if="page.currentAccount.accountState == 'FULL_ACCESS'">
+            <div class="col s6 right-align transactions-buttons-col">
+                <t:block t:replace="~{::buttonNew('new-transaction-button-list new-transaction-button-list-large', page.currentAccount)}"></t:block>
+            </div>
+            <div class="col s6 left-align">
+                <t:block t:replace="~{::buttonFilter(isFilterActive)}"></t:block>
+            </div>
+        </t:block>
+        <div t:unless="page.currentAccount.accountState == 'FULL_ACCESS'" class="col s12 center-align">
+            <t:block t:replace="~{::buttonFilter(isFilterActive)}"></t:block>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up center-align">
+        <div class="row center-align">
+            <div class="row center-align">
+                <div class="col s12">
+                    <t:block t:replace="~{::buttonFilter(isFilterActive)}"></t:block>
+                </div>
+            </div>
+            <div class="col s12 transactions-buttons-col">
+                <t:block t:replace="~{::buttonNew('new-transaction-button-list ', page.currentAccount)}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<t:block t:fragment="buttonNew(String listClasses, Account currentAccount)">
+    <div t:if="currentAccount.accountState == 'FULL_ACCESS'" class="fixed-action-btn new-transaction-button">
+        <a class="btn-floating btn-large btn waves-effect waves-light background-blue" id="button-new-transaction">
