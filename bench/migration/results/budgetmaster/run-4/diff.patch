+++ b/migration/tools/gen_colors.py
@@ -0,0 +1,41 @@
+# Generates templates/helpers/colors.html: elements whose inline style carries one of the
+# application's known colors. Tessera rejects expressions in style attributes, so each known
+# color is a literal case; an unknown color renders the element without a style attribute.
+import sys
+palette = ["#eeeeee","#888888","#333333","#fff177","#ffcc00","#ff9500","#ff3b30","#a90329","#ff5197",
+           "#9b59b6","#5856d6","#007afa","#4f85d6","#5ac8fa","#abdb64","#4cd964","#2e7c2b"]
+extra = ["#FFFFFF","#FFFF00","#000000","#212121","#2E79B9","#F44336"]
+colors = []
+for c in palette + extra:
+    for v in (c.lower(), c.upper()):
+        if v not in colors: colors.append(v)
+props = ["background-color", "color"]
+out = ['<!-- Generated by migration/tools/gen_colors.py; do not edit by hand. -->',
+       '<div xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.icon.Icon">']
+for tag in ["div", "span", "a"]:
+    out.append(f'<t:block t:fragment="{tag}(String prop, String color, String id, String classes, String dataValue, Fragment content)">')
+    out.append('<t:block t:switch="prop + \':\' + color">')
+    for p in props:
+        for c in colors + [""]:
+            out.append(f'<t:block t:case="\'{p}:{c}\'"><{tag} t:id="id" t:class="classes" t:data-value="dataValue" style="{p}: {c}"><t:block t:replace="content"></t:block></{tag}></t:block>')
+    out.append(f'<t:block t:case="*"><{tag} t:id="id" t:class="classes" t:data-value="dataValue"><t:block t:replace="content"></t:block></{tag}></t:block>')
+    out.append('</t:block>')
+    out.append('</t:block>')
+# <span style="color: X"> around an entity icon (accounts, categories, templates)
+out.append('<t:block t:fragment="iconSpan(String color, Icon icon, String iconClasses, String fallbackName)">')
+out.append('<t:block t:switch="color">')
+for c in colors + [""]:
+    out.append(f'<t:block t:case="\'{c}\'"><span style="color: {c}"><t:block t:replace="~{{helpers/header :: entityIcon(icon, iconClasses, fallbackName)}}"></t:block></span></t:block>')
+out.append('<t:block t:case="*"><span><t:block t:replace="~{helpers/header :: entityIcon(icon, iconClasses, fallbackName)}"></t:block></span></t:block>')
+out.append('</t:block>')
+out.append('</t:block>')
+# category circle: <div style="background-color: X"><span style="color: Y">icon</span></div>
+out.append('<t:block t:fragment="circle(String bgColor, String classes, String dataValue, String fontColor, Icon icon, String iconClasses, String fallbackName)">')
+out.append('<t:block t:switch="bgColor">')
+for c in colors + [""]:
+    out.append(f'<t:block t:case="\'{c}\'"><div t:class="classes" style="background-color: {c}" t:data-value="dataValue"><t:block t:replace="~{{::iconSpan(fontColor, icon, iconClasses, fallbackName)}}"></t:block></div></t:block>')
+out.append('<t:block t:case="*"><div t:class="classes" t:data-value="dataValue"><t:block t:replace="~{::iconSpan(fontColor, icon, iconClasses, fallbackName)}"></t:block></div></t:block>')
+out.append('</t:block>')
+out.append('</t:block>')
+out.append('</div>')
+open(sys.argv[1], 'w').write("\n".join(out) + "\n")
