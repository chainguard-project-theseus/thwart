+
+    <div class="hide-on-med-and-up center-align">
+        <div class="row center-align">
+            <div class="row center-align">
+                <div class="col s12">
+                    <t:block t:replace="~{::buttonShow}"></t:block>
+                </div>
+            </div>
+            <div class="col s12">
+                <t:block t:replace="~{::buttonNew}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<!-- chartFunctions.ftl: <@chartFunctions.iconForItem item/>; pass item.icon and item.localizationKey -->
+<t:block t:fragment="iconForItem(String icon, String localizationKey)">
+    <t:block t:if="chartView.isFontAwesomeIcon(icon)"><i t:class="|${icon} left|"></i> [[${locale.getString(localizationKey)}]]</t:block>
+    <t:block t:unless="chartView.isFontAwesomeIcon(icon)"><i class="material-icons left" t:text="icon">icon</i> [[${locale.getString(localizationKey)}]]</t:block>
+</t:block>
+
+</div>
