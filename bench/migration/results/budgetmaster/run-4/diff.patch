index 00000000..c7f4a38a
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/categories/newCategory.html
@@ -0,0 +1,97 @@
+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.view.ValidationErrors, de.deadlocker8.budgetmaster.categories.Category"
+      t:params="PageContext page, Category category, List<String> categoryColors, String customColor, List<String> fontawesomeIcons, ValidationErrors validationErrors">
+    <head t:with="title=category.ID != null ? locale.getString('title.category.edit') : locale.getString('title.category.new')">
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + title)}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/iconSelect.css}"/>
+    </head>
+    <body class="background-blue-light" t:data-theme="page.darkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar(page, 'categories')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline" t:text="category.ID != null ? locale.getString('title.category.edit') : locale.getString('title.category.new')">title</div>
+                    </div>
+                </div>
+
+                <t:block t:replace="~{helpers/header :: showNotifications(page.notifications)}"></t:block>
+
+                    <div class="container">
+                        <form name="NewCategory" t:action="@{/categories/newCategory}" method="post">
+                            <input type="hidden" name="ID" t:value="view.c(category.ID)">
+                            <input type="hidden" name="type" t:value="category.type == null ? '' : '' + category.type">
+
+                            <!-- name -->
+                            <div class="row">
+                                <div class="input-field col s12 m12 l8 offset-l2"
+                                     t:with="categoryName=#categories.name(category), isNameEditingForbidden=category.type == 'NONE' || category.type == 'REST'">
+                                    <i class="material-icons prefix">edit</i>
+                                    <input id="category-name" type="text" name="name"
+                                           t:class="isNameEditingForbidden ? null : validation.classes(validationErrors, 'name', '')"
+                                           t:data-position="isNameEditingForbidden ? null : validation.position(validationErrors, 'name')"
+                                           t:data-delay="isNameEditingForbidden ? null : validation.delay(validationErrors, 'name')"
+                                           t:data-tooltip="isNameEditingForbidden ? null : validation.tooltip(validationErrors, 'name')"
+                                           t:value="categoryName" t:readonly="isNameEditingForbidden">
+                                    <label for="category-name" t:text="locale.getString('category.new.label.name')">Name</label>
+                                </div>
+                            </div>
+
+                            <!-- color: the old template opened/closed rows inside the loop; here rows of 6 colors -->
+                            <input type="hidden" name="color" id="categoryColor" t:value="category.color">
+                            <div class="row" t:each="r : numbers.sequence(0, (categoryColors.size() - 1) / 6)">
+                                <div t:each="i : numbers.sequence(r * 6, r * 6 + 5 < categoryColors.size() ? r * 6 + 5 : categoryColors.size() - 1)"
+                                     t:class="|col s2 m1 ${i % 6 == 0 ? 'offset-m3' : ''} no-padding|">
+                                    <t:block t:replace="~{helpers/colors :: div('background-color', categoryColors[i], null, |category-color ${categoryColors[i] == category.color ? 'category-color-active' : ''}|, null, null)}"></t:block>
+                                </div>
+                                <!-- add custom color picker -->
+                                <div t:if="rStat.last" class="col s2 m1 no-padding">
+                                    <t:block t:replace="~{helpers/colors :: div('background-color', customColor, 'customColorPickerContainer', |category-color ${customColor == category.color ? 'category-color-active' : ''}|, null, ~{::span})}"><span>+</span></t:block>
+                                </div>
+                            </div>
+
+                            <!-- icon -->
+                            <t:block t:replace="~{helpers/iconSelect :: iconSelect(page, 'category-icon', category.iconReference, view.fontColor(category, page.darkTheme), category.color, category.name, true, '', '', false)}"></t:block>
+
+                            <!-- font color -->
+                            <t:block t:replace="~{helpers/fontColorPicker :: fontColorPicker(view.fontColor(category, page.darkTheme), icons.defaultFontColor(category, page.darkTheme))}"></t:block>
+
+                            <br>
+
+                            <!-- buttons -->
+                            <div class="row hide-on-small-only">
+                                <div class="col s6 right-align">
+                                    <t:block t:replace="~{helpers/header :: buttonLink(@{/categories}, 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                                </div>
+
+                                <div class="col s6 left-align">
+                                    <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '', '')}"></t:block>
+                                </div>
+                            </div>
+                            <div class="hide-on-med-and-up">
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{helpers/header :: buttonLink(@{/categories}, 'clear', 'cancel', '', 'red', '', false, false, false, '')}"></t:block>
+                                    </div>
+                                </div>
+                                <div class="row center-align">
+                                    <div class="col s12">
+                                        <t:block t:replace="~{helpers/header :: buttonSubmit('action', 'save', 'save', '', 'green', '', false, '', '', '')}"></t:block>
+                                    </div>
+                                </div>
+                            </div>
+                        </form>
+                    </div>
+            </div>
+        </main>
+
+        <t:block t:replace="~{helpers/iconSelect :: modalIconSelect('category-name', category.iconReference, fontawesomeIcons)}"></t:block>
+
+        <!-- Scripts-->
+        <t:block t:replace="~{helpers/scripts :: scripts}"></t:block>
+        <script t:src="@{/webjars/vanilla-picker/dist/vanilla-picker.min.js}"></script>
+        <script t:src="@{/js/categories.js}"></script>
+        <script t:src="@{/js/iconSelect.js}"></script>
+        <script t:src="@{/js/fontColorPicker.js}"></script>
+    </body>
+</html>
