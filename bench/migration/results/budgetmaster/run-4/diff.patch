+    <body class="background-blue-light" t:data-theme="page.darkTheme ? 'dark'">
+        <t:block t:replace="~{helpers/navbar :: navbar(page, 'importCSV')}"></t:block>
+
+        <main>
+            <div class="card main-card background-color">
+                <div class="container">
+                    <div class="section center-align">
+                        <div class="headline"><i class="fas fa-file-csv"></i> <t:block t:text="locale.getString('menu.transactions.import')">Import</t:block></div>
+                    </div>
+                </div>
+
+                <script>
+                    transactionNameSuggestions = {};
+                </script>
+
+                <t:block t:replace="~{helpers/header :: showNotifications(page.notifications)}"></t:block>
+                    <div class="container">
+                        <t:block t:if="csvRows != null">
+                            <div class="row center-align">
+                                <div class="col s12 m12 l8 offset-l2 headline-small text-green truncate" id="csv-file-name">
+                                    <i class="fas fa-file-csv"></i> <t:block t:text="csvFileName">file.csv</t:block>
+                                </div>
+                            </div>
+
+                            <div class="row center-align">
+                                <div class="col s12">
+                                    <t:block t:replace="~{helpers/header :: buttonLink('/transactionImport/cancel', 'clear', 'cancel', 'button-cancel-csv-import', 'red', 'text-white', false, false, false, '')}"></t:block>
+                                </div>
