+<div xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.filter.FilterConfiguration">
+
+<!-- filterMacros.ftl: <@buttons/> -->
+<t:block t:fragment="buttons">
+    <div class="row hide-on-small-only no-margin-bottom">
+        <div class="col s12 right-align">
+            <t:block t:replace="~{::buttonCloseModal}"></t:block>
+            <t:block t:replace="~{::buttonReset}"></t:block>
+            <t:block t:replace="~{::buttonApply}"></t:block>
+        </div>
+    </div>
+
+    <div class="hide-on-med-and-up valign-wrapper no-margin-bottom">
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonCloseModal}"></t:block>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonReset}"></t:block>
+            </div>
+        </div>
+        <div class="row center-align">
+            <div class="col s12">
+                <t:block t:replace="~{::buttonApply}"></t:block>
+            </div>
+        </div>
+    </div>
+</t:block>
+
+<a t:fragment="buttonReset" t:href="@{/filter/reset}" class="waves-effect waves-light btn background-blue"><i class="material-icons left">settings_backup_restore</i><t:block t:text="locale.getString('filter.reset')">x</t:block></a>
+
+<button t:fragment="buttonApply" class="btn waves-effect waves-light background-green" type="submit" id="buttonApplyFilter">
+    <i class="fas fa-filter left"></i><t:block t:text="locale.getString('filter.apply')">x</t:block>
+</button>
+
+<a t:fragment="buttonResetChart" class="filter-button-reset waves-effect waves-light btn background-blue"><i class="material-icons left">settings_backup_restore</i><t:block t:text="locale.getString('filter.reset')">x</t:block></a>
+
+<a t:fragment="buttonClose" class="filter-button-close waves-effect waves-light background-blue btn white-text"><i class="fas fa-filter left"></i><t:block t:text="locale.getString('filter.apply')">x</t:block></a>
+
+<t:block t:fragment="buttonCloseModal"><t:block t:replace="~{helpers/header :: buttonLink('', 'clear', 'cancel', '', 'red', 'modal-action modal-close text-white', false, false, false, '')}"></t:block></t:block>
+
+<div t:fragment="buttonsAllOrNone" class="row no-margin">
+    <div class="col s6 right-align">
+        <a class="waves-effect waves-light btn background-blue filter-button-all" t:text="locale.getString('filter.tags.button.all')">all</a>
+    </div>
+    <div class="col s6">
+        <a class="waves-effect waves-light btn background-blue filter-button-none" t:text="locale.getString('filter.tags.button.none')">none</a>
+    </div>
+</div>
+
+<!-- filterMacros.ftl: <@filterModal filterConfiguration/> -->
+<div t:fragment="filterModal(FilterConfiguration filterConfiguration)" id="modalFilter" class="modal modal-fixed-footer background-color">
+    <div class="modal-content">
+        <h4 t:text="locale.getString('title.filter')">Filter</h4>
+        <form name="NewFilterConfiguration" t:action="@{/filter/apply}" method="post">
+            <t:block t:replace="~{::filterModalContent(filterConfiguration, '')}"></t:block>
+        </form>
+    </div>
+    <div class="modal-footer background-color">
+        <t:block t:replace="~{::buttons}"></t:block>
+    </div>
+</div>
+
+<!-- filterMacros.ftl: <@filterModalContent filterConfiguration prefix/> (FreeMarker default prefix='') -->
+<div t:fragment="filterModalContent(FilterConfiguration filterConfiguration, String prefix)" class="row"
+     t:with="prefixValue=#strings.isEmpty(prefix) ? '' : prefix + '.'">
+    <div class="col s12">
+        <ul class="collapsible z-depth-2" id="filterSettings">
+            <li id="section-type">
+                    <div class="collapsible-header">
+                        <i class="fas fa-piggy-bank"></i>
+                        <t:block t:text="locale.getString('filter.type')">x</t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                <div class="collapsible-body">
+                    <div class="row no-margin">
+                        <div class="col s12 m4 l4">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeIncome'" t:checked="filterConfiguration.includeIncome">
+                                    <span class="text-default" t:text="locale.getString('filter.type.income')">x</span>
+                                </label>
+                        </div>
+                        <div class="col s12 m4 l4">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeExpenditure'" t:checked="filterConfiguration.includeExpenditure">
+                                    <span class="text-default" t:text="locale.getString('filter.type.expenditure')">x</span>
+                                </label>
+                        </div>
+                        <div class="col s12 m4 l4">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeTransfer'" t:checked="filterConfiguration.includeTransfer">
+                                    <span class="text-default" t:text="locale.getString('filter.type.transfer')">x</span>
+                                </label>
+                        </div>
+                    </div>
+                </div>
+            </li>
+
+            <li id="section-repeating">
+                    <div class="collapsible-header">
+                        <i class="material-icons">repeat</i>
+                        <t:block t:text="locale.getString('filter.repeating')">x</t:block>
+                        <div class="collapsible-header-status"></div>
+                    </div>
+                <div class="collapsible-body">
+                    <div class="row no-margin">
+                        <div class="col s6 m6 l6">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeNotRepeating'" t:checked="filterConfiguration.includeNotRepeating">
+                                    <span class="text-default" t:text="locale.getString('filter.repeating.false')">x</span>
+                                </label>
+                        </div>
+                        <div class="col s6 m6 l6">
+                                <label>
+                                    <input type="checkbox" t:name="prefixValue + 'includeRepeating'" t:checked="filterConfiguration.includeRepeating">
+                                    <span class="text-default" t:text="locale.getString('filter.repeating.true')">x</span>
+                                </label>
+                        </div>
+                    </div>
+                </div>
