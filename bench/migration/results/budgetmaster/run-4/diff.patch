+<html xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.view.ValidationErrors, de.deadlocker8.budgetmaster.transactions.csvimport.*, de.deadlocker8.budgetmaster.categories.Category"
+      t:params="PageContext page, String csvFileName, List<CsvRow> csvRows, List<CsvTransaction> csvTransactions, List<String> errorsColumnSettings, CsvImportSettings csvImportSettings, List<Category> categories, List<String> nameSuggestions, ValidationErrors validationErrors">
+    <head>
+        <t:block t:replace="~{helpers/header :: header('BudgetMaster - ' + locale.getString('menu.transactions.import'))}"></t:block>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactions.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/transactionImport.css}"/>
+        <link type="text/css" rel="stylesheet" t:href="@{/css/collapsible.css}"/>
