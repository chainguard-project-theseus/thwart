+/**
+ * Replaces FreeMarker's direct access to the "error" BindingResult (helpers/validation.ftl):
+ * after a handler ran, wraps that BindingResult into a view-safe {@link ValidationErrors} model attribute
+ * "validationErrors" (absent = no errors).
+ */
+@Configuration
+public class ValidationErrorsInterceptor implements HandlerInterceptor, WebMvcConfigurer
+{
+	public static final String MODEL_ATTRIBUTE = "validationErrors";
+
+	@Override
+	public void addInterceptors(InterceptorRegistry registry)
+	{
+		registry.addInterceptor(this);
+	}
+
+	@Override
+	public void postHandle(HttpServletRequest request, HttpServletResponse response, Object handler, ModelAndView modelAndView)
+	{
+		if(modelAndView == null)
+		{
+			return;
+		}
+		final Object error = modelAndView.getModel().get("error");
+		if(error instanceof BindingResult bindingResult && !modelAndView.getModel().containsKey(MODEL_ATTRIBUTE))
+		{
+			modelAndView.addObject(MODEL_ATTRIBUTE, new ValidationErrors(bindingResult));
+		}
+	}
+}
diff --git a/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/view/ValidationFunctions.java b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/view/ValidationFunctions.java
new file mode 100644
index 00000000..e04fffdb
--- /dev/null
+++ b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/view/ValidationFunctions.java
@@ -0,0 +1,61 @@
+package de.deadlocker8.budgetmaster.view;
+
+import de.thecodelabs.utils.util.Localization;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Replacement for the attribute-emitting macro {@code <@validation.validation fieldName classes/>}.
+ * Usage on the input element (validationErrors may be null):
+ * <pre>
+ * t:class="validation.classes(validationErrors, 'name', 'extra classes')"
+ * t:data-position="validation.position(validationErrors, 'name')"
+ * t:data-delay="validation.delay(validationErrors, 'name')"
+ * t:data-tooltip="validation.tooltip(validationErrors, 'name')"
+ * </pre>
+ */
+@TemplateFunctions("validation")
+public final class ValidationFunctions
+{
+	private ValidationFunctions()
+	{
+	}
+
+	private static boolean hasError(ValidationErrors errors, String fieldName)
+	{
+		return errors != null && errors.hasFieldError(fieldName);
+	}
+
+	@TemplateFunction
+	public static String classes(ValidationErrors errors, String fieldName, String classes)
+	{
+		final String extra = classes == null ? "" : classes;
+		if(hasError(errors, fieldName))
+		{
+			return ("tooltipped invalid " + extra).trim();
+		}
+		return ("validate " + extra).trim();
+	}
+
+	@TemplateFunction
+	public static String position(ValidationErrors errors, String fieldName)
+	{
+		return hasError(errors, fieldName) ? "bottom" : null;
+	}
+
+	@TemplateFunction
+	public static String delay(ValidationErrors errors, String fieldName)
+	{
+		return hasError(errors, fieldName) ? "50" : null;
+	}
+
+	@TemplateFunction
+	public static String tooltip(ValidationErrors errors, String fieldName)
+	{
+		if(!hasError(errors, fieldName))
+		{
+			return null;
+		}
+		return Localization.getString(errors.getFieldErrorCode(fieldName));
+	}
+}
diff --git a/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/view/ViewFunctions.java b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/view/ViewFunctions.java
new file mode 100644
index 00000000..b0610fc1
--- /dev/null
+++ b/BudgetMasterServer/src/main/java/de/deadlocker8/budgetmaster/view/ViewFunctions.java
@@ -0,0 +1,51 @@
+package de.deadlocker8.budgetmaster.view;
+
+import de.deadlocker8.budgetmaster.icon.Iconizable;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * General helpers that FreeMarker templates computed with built-ins or method calls.
+ */
+@TemplateFunctions("view")
+public final class ViewFunctions
+{
+	private ViewFunctions()
+	{
+	}
+
+	/**
+	 * FreeMarker's {@code name?capitalize[0]}: the first character, upper-cased.
+	 */
+	@TemplateFunction
+	public static String initial(String name)
+	{
+		if(name == null || name.isEmpty())
+		{
+			return "";
+		}
+		return name.substring(0, 1).toUpperCase();
+	}
+
+	/**
+	 * {@code item.getFontColor(isDarkTheme)} of a category, account or template.
+	 */
+	@TemplateFunction
+	public static String fontColor(Object item, boolean isDarkTheme)
+	{
+		if(item == null)
+		{
+			return null;
+		}
+		return ((Iconizable) item).getFontColor(isDarkTheme);
+	}
+
+	/**
+	 * FreeMarker's {@code number?c} for an Integer/Long ID: plain digits, empty for null.
+	 */
+	@TemplateFunction
+	public static String c(Object number)
+	{
+		return number == null ? "" : String.valueOf(number);
+	}
+}
