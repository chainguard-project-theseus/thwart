+package de.deadlocker8.budgetmaster.view;
+
+import de.deadlocker8.budgetmaster.hints.Hint;
+import de.deadlocker8.budgetmaster.services.DateService;
+import de.deadlocker8.budgetmaster.services.HelpersService;
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Functions for helpers/globalDatePicker.html (replace dateService/helpers globals and FreeMarker list building).
+ */
+@TemplateFunctions("datePicker")
+public final class DatePickerFunctions
+{
+	private DatePickerFunctions()
+	{
+	}
+
+	@TemplateFunction
+	public static String monthAndYear(LocalDate date)
+	{
+		return date == null ? "" : SpringBeans.get(DateService.class).getDateStringWithMonthAndYear(date);
+	}
+
+	/**
+	 * The 12 years shown in the year grid: currentYear-7 .. currentYear+4.
+	 */
+	@TemplateFunction
+	public static List<String> years(int currentYear)
+	{
+		final List<String> years = new ArrayList<>();
+		for(int i = currentYear - 7; i <= currentYear + 4; i++)
+		{
+			years.add(String.valueOf(i));
+		}
+		return years;
+	}
+
+	@TemplateFunction
+	public static Hint hint(String localizationKey)
+	{
+		return SpringBeans.get(HelpersService.class).getHintByLocalizationKey(localizationKey);
+	}
+
+	/**
+	 * Every string shortened to its first {@code length} characters (FreeMarker's {@code s[0..length-1]}).
+	 */
+	@TemplateFunction
+	public static List<String> prefixes(List<String> values, int length)
+	{
+		final List<String> result = new ArrayList<>();
+		if(values != null)
+		{
+			for(String value : values)
+			{
+				result.add(value.length() <= length ? value : value.substring(0, length));
+			}
+		}
+		return result;
+	}
+}
