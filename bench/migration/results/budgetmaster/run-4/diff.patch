diff --git a/BudgetMasterServer/src/main/resources/templates/helpers/iconSelect.html b/BudgetMasterServer/src/main/resources/templates/helpers/iconSelect.html
new file mode 100644
index 00000000..141ae1fd
--- /dev/null
+++ b/BudgetMasterServer/src/main/resources/templates/helpers/iconSelect.html
@@ -0,0 +1,151 @@
+<div xmlns:t="https://tessera.dev" t:import="de.deadlocker8.budgetmaster.view.PageContext, de.deadlocker8.budgetmaster.icon.Icon">
+
+<!-- iconSelect.ftl: <@iconSelect id item showBackground initialBackgroundClasses backgroundClasses preventFallbackIcon/>
+     item is passed as its parts: icon = item.iconReference, fontColor = view.fontColor(item, page.darkTheme),
+     color = item.color ('' for items without a color), name = item.name.
+     FreeMarker defaults: showBackground=true, initialBackgroundClasses='', backgroundClasses='', preventFallbackIcon=false -->
+<div t:fragment="iconSelect(PageContext page, String id, Icon icon, String fontColor, String color, String name, boolean showBackground, String initialBackgroundClasses, String backgroundClasses, boolean preventFallbackIcon)" class="row">
+    <div class="input-field col s12 m12 l8 offset-l2">
+        <i class="fas fa-icons prefix"></i>
+        <label class="input-label" t:for="id" t:text="locale.getString('account.new.label.icon')">Icon</label>
+
+        <div t:id="id" class="valign-wrapper item-icon"
+             t:with="hasImageIcon=icon != null && icon.isImageIcon(), hasBuiltinIcon=icon != null && icon.isBuiltinIcon()">
+            <div class="item-icon-preview-container">
+                <t:block t:replace="~{helpers/colors :: a('color', fontColor ?: '', 'item-icon-preview', null, null, ~{::iconPreviewBackground(page, icon, color, name, showBackground, initialBackgroundClasses, backgroundClasses, preventFallbackIcon)})}"></t:block>
+                <t:block t:replace="~{helpers/header :: buttonFlat('', 'delete', '', '', 'no-padding text-default button-remove-icon-from-item', false, true, '', '', '')}"></t:block>
+            </div>
+
+            <div id="item-icon-placeholder" t:text="locale.getString('account.new.icon.placeholder')">placeholder</div>
+
+            <input id="hidden-input-icon-image-id" type="hidden" name="iconImageID" t:value="hasImageIcon ? view.c(icon.image.ID) : ''">
+            <input id="hidden-input-icon-builtin-identifier" type="hidden" name="builtinIconIdentifier" t:value="hasBuiltinIcon ? icon.builtinIdentifier : ''">
+        </div>
+    </div>
+</div>
+
+<!-- content of <a id="item-icon-preview"> (internal to iconSelect) -->
+<t:block t:fragment="iconPreviewBackground(PageContext page, Icon icon, String color, String name, boolean showBackground, String initialBackgroundClasses, String backgroundClasses, boolean preventFallbackIcon)">
+    <script>iconSelectAdditionalBackgroundClasses = [[${backgroundClasses}]];</script>
+    <t:block t:replace="~{helpers/colors :: div('background-color', showBackground ? (color ?: '') : '', 'item-icon-preview-background', |category-circle category-circle-preview ${page.categorySquare ? 'category-square' : ''} ${initialBackgroundClasses}|, null, ~{::iconPreviewContent(icon, name, preventFallbackIcon)})}"></t:block>
+</t:block>
+
+<!-- content of <div id="item-icon-preview-background"> (internal to iconSelect) -->
+<t:block t:fragment="iconPreviewContent(Icon icon, String name, boolean preventFallbackIcon)">
+    <t:block t:with="hasImageIcon=icon != null && icon.isImageIcon(), hasBuiltinIcon=icon != null && icon.isBuiltinIcon()">
+        <i id="builtin-icon-preview-icon" t:class="hasBuiltinIcon ? icon.builtinIdentifier : 'hidden'"></i>
