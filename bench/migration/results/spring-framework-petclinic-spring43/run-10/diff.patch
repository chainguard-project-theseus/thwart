+package org.springframework.samples.petclinic.web;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+import org.springframework.samples.petclinic.model.Pet;
+import org.springframework.samples.petclinic.model.Visit;
+
+/**
+ * Template functions for the values templates can't read directly: {@link java.util.Date} is not a view-safe
+ * type, so the dates of pets and visits are formatted here (as JSTL's {@code fmt:formatDate} did).
+ */
+@TemplateFunctions("petclinic")
+public final class PetclinicFunctions {
+
+    private PetclinicFunctions() {
+    }
+
+    @TemplateFunction
+    public static String birthDate(Pet pet, String pattern) {
+        return pet == null ? "" : format(pet.getBirthDate(), pattern);
+    }
+
+    @TemplateFunction
+    public static String visitDate(Visit visit, String pattern) {
+        return visit == null ? "" : format(visit.getDate(), pattern);
+    }
+
+    private static String format(Date date, String pattern) {
+        return date == null ? "" : new SimpleDateFormat(pattern).format(date);
+    }
+
+}
