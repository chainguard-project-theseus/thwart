diff --git a/src/test/java/org/springframework/samples/petclinic/web/ViewRenderingTests.java b/src/test/java/org/springframework/samples/petclinic/web/ViewRenderingTests.java
new file mode 100644
index 0000000..c506e0d
--- /dev/null
+++ b/src/test/java/org/springframework/samples/petclinic/web/ViewRenderingTests.java
@@ -0,0 +1,93 @@
+package org.springframework.samples.petclinic.web;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.model.Pet;
+import org.springframework.samples.petclinic.service.ClinicService;
+import org.springframework.test.context.ContextConfiguration;
+import org.springframework.test.context.junit4.SpringJUnit4ClassRunner;
+import org.springframework.test.context.web.WebAppConfiguration;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.context.WebApplicationContext;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+/**
+ * Renders pages through the application's real view resolvers (the Tessera templates), unlike the
+ * standalone controller tests, which never render a view.
+ */
+@RunWith(SpringJUnit4ClassRunner.class)
+@ContextConfiguration({"classpath:spring/mvc-test-config.xml", "classpath:spring/mvc-core-config.xml"})
+@WebAppConfiguration
+public class ViewRenderingTests {
+
+    private static final int TEST_OWNER_ID = 1;
+
+    @Autowired
+    private WebApplicationContext context;
+
+    @Autowired
+    private ClinicService clinicService;
+
+    private MockMvc mockMvc;
+
+    @Before
+    public void setup() {
+        this.mockMvc = MockMvcBuilders.webAppContextSetup(context).build();
+        Owner owner = new Owner();
+        owner.setId(TEST_OWNER_ID);
+        owner.setFirstName("<script>alert(1)</script>");
+        owner.setLastName("Franklin");
+        owner.setAddress("110 W. Liberty St.");
+        owner.setCity("Madison");
+        owner.setTelephone("6085551023");
+        given(this.clinicService.findOwnerById(TEST_OWNER_ID)).willReturn(owner);
+    }
+
+    @Test
+    public void testOwnerDetailsEscapesUserData() throws Exception {
+        mockMvc.perform(get("/owners/{ownerId}", TEST_OWNER_ID))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("&lt;script&gt;alert(1)&lt;/script&gt; Franklin")))
+            .andExpect(content().string(not(containsString("<script>alert(1)"))))
+            .andExpect(content().string(containsString("href=\"1/edit.html\"")));
+    }
+
+    @Test
+    public void testEditFormEscapesBoundValue() throws Exception {
+        mockMvc.perform(get("/owners/{ownerId}/edit", TEST_OWNER_ID))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("value=\"&lt;script&gt;alert(1)&lt;/script&gt;\"")))
+            .andExpect(content().string(containsString("action=\"/owners/1/edit\"")));
+    }
+
+    @Test
+    public void testWelcomePage() throws Exception {
+        mockMvc.perform(get("/"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("<h2>Welcome</h2>")));
+    }
+
+    @Test
+    public void testExceptionPageShowsMessage() throws Exception {
+        mockMvc.perform(get("/oups"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("Something happened...")))
+            .andExpect(content().string(containsString("Expected: controller used to showcase")));
+    }
+
+    @Test
+    public void testViewWithoutTemplateIsNotFound() throws Exception {
+        given(this.clinicService.findPetById(1)).willReturn(new Pet());
+        mockMvc.perform(get("/owners/1/pets/1/visits"))
+            .andExpect(status().isNotFound());
+    }
+}
