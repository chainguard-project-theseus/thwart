+import org.springframework.core.Ordered;
+import org.springframework.web.servlet.View;
+import org.springframework.web.servlet.ViewResolver;
+import org.springframework.web.servlet.view.UrlBasedViewResolver;
+
+/**
+ * Last view resolver in the chain: a view name that no template renders (such as {@code visitList}) answers
+ * "404 Not Found" for the requested URL, as it did when the JSP view resolver forwarded to a missing JSP,
+ * instead of failing the request with a 500.
+ */
+public class MissingViewResolver implements ViewResolver, Ordered {
+
+    private static final View NOT_FOUND = new View() {
+
+        @Override
+        public String getContentType() {
+            return null;
+        }
+
+        @Override
+        public void render(Map<String, ?> model, HttpServletRequest request, HttpServletResponse response)
+            throws Exception {
+            response.sendError(HttpServletResponse.SC_NOT_FOUND, request.getRequestURI());
+        }
+    };
+
+    @Override
+    public View resolveViewName(String viewName, Locale locale) {
+        if (viewName.startsWith(UrlBasedViewResolver.REDIRECT_URL_PREFIX)
+            || viewName.startsWith(UrlBasedViewResolver.FORWARD_URL_PREFIX)) {
+            return null;
+        }
+        return NOT_FOUND;
+    }
+
+    @Override
+    public int getOrder() {
+        return Ordered.LOWEST_PRECEDENCE;
+    }
+
+}
