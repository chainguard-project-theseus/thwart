diff --git a/src/main/resources/templates/pets/createOrUpdatePetForm.html b/src/main/resources/templates/pets/createOrUpdatePetForm.html
new file mode 100644
index 0000000..fb7b5c2
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdatePetForm.html
@@ -0,0 +1,42 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.*" t:params="Pet pet, Collection<PetType> types, Integer ownerId, Integer petId, Boolean htmlSuffix"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::custom-script})}">
+<custom-script t:remove="tag">
+    <script>
+        $(function () {
+            $("#birthDate").datepicker({dateFormat: 'yy/mm/dd'});
+        });
+    </script>
+</custom-script>
+<body t:remove="tag">
+    <h2>
+        <t:block t:if="pet.isNew()">New </t:block> Pet
+    </h2>
+    <!--/* posts back to the URI the form was requested with */-->
+    <form t:object="pet" id="pet" class="form-horizontal" method="post"
+          t:action="petId == null
+              ? (htmlSuffix ? @{/owners/{ownerId}/pets/new.html(ownerId=ownerId)} : @{/owners/{ownerId}/pets/new(ownerId=ownerId)})
+              : (htmlSuffix ? @{/owners/{ownerId}/pets/{petId}/edit.html(ownerId=ownerId,petId=petId)} : @{/owners/{ownerId}/pets/{petId}/edit(ownerId=ownerId,petId=petId)})">
+        <input type="hidden" name="id" t:value="pet.id == null ? '' : '' + pet.id"/>
+        <div class="form-group has-feedback">
+            <div class="form-group">
+                <label class="col-sm-2 control-label">Owner</label>
+                <div class="col-sm-10">
+                    [[${pet.owner?.firstName}]] [[${pet.owner?.lastName}]]
+                </div>
+            </div>
+            <div t:replace="~{fragments/fields :: inputField('Name', 'name')}"></div>
+            <div t:replace="~{fragments/fields :: inputField('Birth Date', 'birthDate')}"></div>
+            <div class="control-group">
+                <div t:replace="~{fragments/fields :: selectField('Type ', 'type', types)}"></div>
+            </div>
+        </div>
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <button t:if="pet.isNew()" class="btn btn-default" type="submit">Add Pet</button>
+                <button t:unless="pet.isNew()" class="btn btn-default" type="submit">Update Pet</button>
+            </div>
+        </div>
+    </form>
+</body>
+</html>
diff --git a/src/main/resources/templates/pets/createOrUpdateVisitForm.html b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
new file mode 100644
index 0000000..70a5caa
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
@@ -0,0 +1,66 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.*" t:params="Visit visit, Boolean htmlSuffix"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::custom-script})}">
+<custom-script t:remove="tag">
+    <script>
+        $(function () {
+            $("#date").datepicker({dateFormat: 'yy/mm/dd'});
+        });
+    </script>
+</custom-script>
+<body t:remove="tag">
+    <h2><t:block t:if="visit.isNew()">New </t:block>Visit</h2>
+
+    <b>Pet</b>
+    <table class="table table-striped">
+        <thead>
+        <tr>
+            <th>Name</th>
+            <th>Birth Date</th>
+            <th>Type</th>
+            <th>Owner</th>
+        </tr>
+        </thead>
+        <tbody>
+        <tr>
+            <td t:text="visit.pet.name">Samantha</td>
+            <td t:text="temporals.format(visit.pet.birthLocalDate, 'yyyy/MM/dd')">2012/09/04</td>
+            <td t:text="visit.pet.type?.name">cat</td>
+            <td>[[${visit.pet.owner?.firstName}]] [[${visit.pet.owner?.lastName}]]</td>
+        </tr>
+        </tbody>
+    </table>
+
+    <!--/* posts back to the URI the form was requested with */-->
+    <form t:object="visit" id="visit" class="form-horizontal" method="post"
+          t:with="ownerId=visit.pet.owner.id, petId=visit.pet.id"
+          t:action="htmlSuffix ? @{/owners/{ownerId}/pets/{petId}/visits/new.html(ownerId=ownerId,petId=petId)} : @{/owners/{ownerId}/pets/{petId}/visits/new(ownerId=ownerId,petId=petId)}">
+        <div class="form-group has-feedback">
+            <div t:replace="~{fragments/fields :: inputField('Date', 'date')}"></div>
+            <div t:replace="~{fragments/fields :: inputField('Description', 'description')}"></div>
+        </div>
+
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <input type="hidden" name="petId" t:value="visit.pet.id"/>
+                <button class="btn btn-default" type="submit">Add Visit</button>
+            </div>
+        </div>
+    </form>
+
+    <br/>
+    <b>Previous Visits</b>
+    <table class="table table-striped">
+        <tbody>
+        <tr>
+            <th>Date</th>
+            <th>Description</th>
+        </tr>
+        <tr t:each="v : visit.pet.visits" t:unless="v.isNew()">
+            <td t:text="temporals.format(v.localDate, 'yyyy/MM/dd')">2013/01/01</td>
+            <td t:text="v.description">rabies shot</td>
+        </tr>
+        </tbody>
+    </table>
+</body>
+</html>
