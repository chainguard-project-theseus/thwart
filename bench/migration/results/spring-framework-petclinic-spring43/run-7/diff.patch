+package org.springframework.samples.petclinic.web;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+
+import dev.tessera.runtime.TemplateFunction;
+import dev.tessera.runtime.TemplateFunctions;
+
+/**
+ * Date formatting for templates ({@code dates.format(pet.birthDate, 'yyyy-MM-dd')}), as JSTL's
+ * {@code <fmt:formatDate pattern="..."/>} did. A {@code null} date prints nothing.
+ */
+@TemplateFunctions("dates")
+public final class DateFunctions {
+
+    private DateFunctions() {
+    }
+
+    @TemplateFunction
+    public static String format(Date date, String pattern) {
+        return date == null ? "" : new SimpleDateFormat(pattern).format(date);
+    }
+
+}
