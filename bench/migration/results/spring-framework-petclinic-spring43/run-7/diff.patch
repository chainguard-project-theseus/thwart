diff --git a/src/main/resources/templates/pets/createOrUpdateVisitForm.html b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
new file mode 100644
index 0000000..7626124
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
@@ -0,0 +1,63 @@
+<!doctype html>
+<html xmlns:t="https://tessera.dev"
+      t:import="org.springframework.samples.petclinic.model.Visit, org.springframework.samples.petclinic.web.CurrentRequest"
+      t:params="Visit visit, CurrentRequest currentRequest"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::script})}">
+<head>
+    <script>
+        $(function () {
+            $("#date").datepicker({dateFormat: 'yy/mm/dd'});
+        });
+    </script>
+</head>
+<body t:remove="tag">
+    <h2><t:block t:if="visit.isNew()">New </t:block>Visit</h2>
+
+    <b>Pet</b>
+    <table class="table table-striped">
+        <thead>
+        <tr>
+            <th>Name</th>
+            <th>Birth Date</th>
+            <th>Type</th>
+            <th>Owner</th>
+        </tr>
+        </thead>
+        <tr>
+            <td t:text="visit.pet.name">Leo</td>
+            <td t:text="dates.format(visit.pet.birthDate, 'yyyy/MM/dd')">2010/09/07</td>
+            <td t:text="visit.pet.type?.name">cat</td>
+            <td><t:block t:text="visit.pet.owner?.firstName">George</t:block> <t:block t:text="visit.pet.owner?.lastName">Franklin</t:block></td>
+        </tr>
+    </table>
+
+    <form t:object="visit" class="form-horizontal" id="visit" t:action="currentRequest.uri" method="post">
+        <div class="form-group has-feedback">
+            <div t:replace="~{fragments/fields :: input('Date', 'date', visit.date != null)}"></div>
+            <div t:replace="~{fragments/fields :: input('Description', 'description', !strings.isEmpty(visit.description))}"></div>
+        </div>
+
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <input type="hidden" name="petId" t:value="visit.pet.id == null ? '' : '' + visit.pet.id"/>
+                <button class="btn btn-default" type="submit">Add Visit</button>
+            </div>
+        </div>
+    </form>
+
+    <br/>
+    <b>Previous Visits</b>
+    <table class="table table-striped">
+        <tr>
+            <th>Date</th>
+            <th>Description</th>
+        </tr>
+        <t:block t:each="previous : visit.pet.visits">
+            <tr t:unless="previous.isNew()">
+                <td t:text="dates.format(previous.date, 'yyyy/MM/dd')">2013/01/01</td>
+                <td t:text="previous.description">rabies shot</td>
+            </tr>
+        </t:block>
+    </table>
+</body>
+</html>
diff --git a/src/main/resources/templates/vets/vetList.html b/src/main/resources/templates/vets/vetList.html
