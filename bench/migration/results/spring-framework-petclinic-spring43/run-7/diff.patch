diff --git a/src/test/java/org/springframework/samples/petclinic/web/TesseraViewRenderingTests.java b/src/test/java/org/springframework/samples/petclinic/web/TesseraViewRenderingTests.java
new file mode 100644
index 0000000..67f758c
--- /dev/null
+++ b/src/test/java/org/springframework/samples/petclinic/web/TesseraViewRenderingTests.java
@@ -0,0 +1,106 @@
+package org.springframework.samples.petclinic.web;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.model.Pet;
+import org.springframework.samples.petclinic.service.ClinicService;
+import org.springframework.test.context.ContextConfiguration;
+import org.springframework.test.context.junit4.SpringJUnit4ClassRunner;
+import org.springframework.test.context.web.WebAppConfiguration;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.context.WebApplicationContext;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+/**
+ * Renders pages through the application's real view resolvers (the Tessera templates), unlike the
+ * controller tests, which use {@code standaloneSetup} and never render a view.
+ */
+@RunWith(SpringJUnit4ClassRunner.class)
+@ContextConfiguration({"classpath:spring/mvc-core-config.xml", "classpath:spring/mvc-test-config.xml"})
+@WebAppConfiguration
+public class TesseraViewRenderingTests {
+
+    private static final int TEST_OWNER_ID = 4242;
+    private static final int TEST_PET_ID = 4243;
+
+    @Autowired
+    private WebApplicationContext context;
+
+    @Autowired
+    private ClinicService clinicService;
+
+    private MockMvc mockMvc;
+
+    @Before
+    public void setup() {
+        this.mockMvc = MockMvcBuilders.webAppContextSetup(this.context).build();
+        Owner owner = new Owner();
+        owner.setId(TEST_OWNER_ID);
+        owner.setFirstName("<script>alert('x')</script>");
+        owner.setLastName("O'Neil & \"Co\"");
+        owner.setAddress("<b>1 Main St</b>");
+        owner.setCity("Madison");
+        owner.setTelephone("6085551023");
+        given(this.clinicService.findOwnerById(TEST_OWNER_ID)).willReturn(owner);
+        Pet pet = new Pet();
+        pet.setId(TEST_PET_ID);
+        given(this.clinicService.findPetById(TEST_PET_ID)).willReturn(pet);
+    }
+
+    @Test
+    public void welcomePageIsRenderedByTessera() throws Exception {
+        mockMvc.perform(get("/"))
+            .andExpect(status().isOk())
+            .andExpect(content().contentType("text/html;charset=UTF-8"))
+            .andExpect(content().string(containsString("<h2>Welcome</h2>")));
+    }
+
+    @Test
+    public void ownerDetailsEscapeUserData() throws Exception {
+        mockMvc.perform(get("/owners/{ownerId}", TEST_OWNER_ID))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("&lt;script&gt;")))
+            .andExpect(content().string(containsString("&lt;b&gt;1 Main St&lt;/b&gt;")))
+            .andExpect(content().string(not(containsString("<script>alert"))))
+            .andExpect(content().string(not(containsString("<b>1 Main St"))));
+    }
+
+    @Test
+    public void ownerFormShowsValidationErrorsAndEscapesRejectedValues() throws Exception {
+        mockMvc.perform(post("/owners/new")
+            .param("firstName", "\"><script>alert(1)</script>")
+            .param("lastName", "")
+            .param("address", "1 Main")
+            .param("city", "Madison")
+            .param("telephone", "12ab"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("action=\"/owners/new\"")))
+            .andExpect(content().string(containsString("value=\"&quot;&gt;&lt;script&gt;alert(1)&lt;/script&gt;\"")))
+            .andExpect(content().string(not(containsString("<script>alert(1)"))))
+            .andExpect(content().string(containsString("has-error")));
+    }
+
+    @Test
+    public void exceptionPageShowsTheMessage() throws Exception {
+        mockMvc.perform(get("/oups"))
+            .andExpect(status().isOk())
+            .andExpect(content().string(containsString("Something happened...")))
+            .andExpect(content().string(containsString("Expected: controller used to showcase")));
+    }
+
+    @Test
+    public void viewNamesWithoutATemplateAreNotFound() throws Exception {
+        mockMvc.perform(get("/owners/1/pets/{petId}/visits", TEST_PET_ID))
+            .andExpect(status().isNotFound());
+    }
+}
