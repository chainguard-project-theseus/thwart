+
+    <table id="vetsTable" class="table table-striped">
+        <thead>
+        <tr>
+            <th>Name</th>
+            <th>Specialties</th>
+        </tr>
+        </thead>
+        <tbody>
+        <tr t:each="vet : vets.vetList">
+            <td>
+                <t:block t:text="vet.firstName">James</t:block> <t:block t:text="vet.lastName">Carter</t:block>
+            </td>
+            <td>
+                <t:block t:each="specialty : vet.specialties"><t:block t:text="specialty.name">radiology</t:block> </t:block>
