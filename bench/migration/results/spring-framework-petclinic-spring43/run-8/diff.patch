+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.web;
+
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+
+import org.springframework.web.servlet.ModelAndView;
+import org.springframework.web.servlet.handler.HandlerInterceptorAdapter;
+import org.springframework.web.servlet.view.UrlBasedViewResolver;
+import org.springframework.web.util.UrlPathHelper;
+
+/**
+ * Exposes the URL of the current request as the {@code formAction} model attribute, so that forms posting back to
+ * the page they were rendered from can name their action explicitly (Spring's JSP form tag used to default to it).
+ * Templates only see the model, not the request.
+ * <p/>
+ * Not added to redirects, where a String model attribute would be appended to the target URL as a query parameter.
+ */
+public class FormActionInterceptor extends HandlerInterceptorAdapter {
+
+    public static final String FORM_ACTION = "formAction";
+
+    private final UrlPathHelper urlPathHelper = new UrlPathHelper();
+
+    @Override
+    public void postHandle(HttpServletRequest request, HttpServletResponse response, Object handler,
+                           ModelAndView modelAndView) {
+        if (modelAndView == null || !modelAndView.isReference()
+            || modelAndView.getViewName().startsWith(UrlBasedViewResolver.REDIRECT_URL_PREFIX)
+            || modelAndView.getModelMap().containsAttribute(FORM_ACTION)) {
+            return;
+        }
+        String action = this.urlPathHelper.getOriginatingRequestUri(request);
+        String queryString = this.urlPathHelper.getOriginatingQueryString(request);
+        if (queryString != null) {
+            action += "?" + queryString;
+        }
+        modelAndView.addObject(FORM_ACTION, response.encodeURL(action));
+    }
+
+}
