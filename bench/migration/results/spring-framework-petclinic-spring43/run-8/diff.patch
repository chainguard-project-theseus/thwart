+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.web;
+
+import java.util.Locale;
+import java.util.Map;
+
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+
+import org.springframework.core.Ordered;
+import org.springframework.web.servlet.View;
+import org.springframework.web.servlet.ViewResolver;
+
+/**
+ * Last-resort resolver for view names that no template is compiled for: answers 404 Not Found, as forwarding to a
+ * missing JSP used to, instead of failing with "Could not resolve view".
+ */
+public class NotFoundViewResolver implements ViewResolver, Ordered {
+
+    private static final View NOT_FOUND = new View() {
+
+        @Override
+        public String getContentType() {
+            return "text/html";
+        }
+
+        @Override
+        public void render(Map<String, ?> model, HttpServletRequest request, HttpServletResponse response)
+            throws Exception {
+            response.sendError(HttpServletResponse.SC_NOT_FOUND);
+        }
+    };
+
+    @Override
+    public View resolveViewName(String viewName, Locale locale) {
+        return NOT_FOUND;
+    }
+
+    @Override
+    public int getOrder() {
+        return Ordered.LOWEST_PRECEDENCE;
+    }
+
+}
