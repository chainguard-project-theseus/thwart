diff --git a/src/main/resources/templates/pets/createOrUpdatePetForm.html b/src/main/resources/templates/pets/createOrUpdatePetForm.html
new file mode 100644
index 0000000..62aa8b4
--- /dev/null
+++ b/src/main/resources/templates/pets/createOrUpdatePetForm.html
@@ -0,0 +1,50 @@
+<!DOCTYPE html>
+<html xmlns:t="https://tessera.dev" t:import="org.springframework.samples.petclinic.model.*"
+      t:params="Pet pet, Collection<PetType> types, String formAction"
+      t:replace="~{fragments/layout :: layout('owners', ~{::body}, ~{::script})}">
+<body t:remove="tag">
+    <h2>
+        <t:block t:if="pet.isNew()">New </t:block> Pet
+    </h2>
+    <form t:object="pet" id="pet" class="form-horizontal" t:action="formAction" method="post">
+        <input type="hidden" name="id" t:value="pet.id == null ? '' : '' + pet.id"/>
+        <div class="form-group has-feedback">
+            <div class="form-group">
+                <label class="col-sm-2 control-label">Owner</label>
+                <div class="col-sm-10" t:text="|${pet.owner?.firstName ?: ''} ${pet.owner?.lastName ?: ''}|">
+                    George Franklin
+                </div>
+            </div>
+            <div t:replace="~{fragments/fields :: inputField('Name', 'name', !strings.isEmpty(pet.name))}"></div>
+            <div t:replace="~{fragments/fields :: inputField('Birth Date', 'birthDate', pet.birthDate != null)}"></div>
+            <div class="control-group">
+                <div class="form-group" t:classappend="fields.hasErrors('type') ? 'error'">
+                    <label class="col-sm-2 control-label">Type </label>
+
+                    <div class="col-sm-10">
+                        <select class="form-control" t:field="*{type}" size="5">
+                            <option t:each="type : types" t:value="type" t:text="type">cat</option>
+                        </select>
+                        <span t:if="pet.type != null and !fields.hasErrors('type')" class="glyphicon glyphicon-ok form-control-feedback" aria-hidden="true"></span>
+                        <t:block t:if="fields.hasErrors('type')">
+                            <span class="glyphicon glyphicon-remove form-control-feedback" aria-hidden="true"></span>
+                            <span class="help-inline" t:text="fields.errors('type').first">is required</span>
+                        </t:block>
+                    </div>
+                </div>
+            </div>
+        </div>
+        <div class="form-group">
+            <div class="col-sm-offset-2 col-sm-10">
+                <button t:if="pet.isNew()" class="btn btn-default" type="submit">Add Pet</button>
+                <button t:unless="pet.isNew()" class="btn btn-default" type="submit">Update Pet</button>
+            </div>
+        </div>
+    </form>
+</body>
+<script>
+    $(function () {
+        $("#birthDate").datepicker({dateFormat: 'yy/mm/dd'});
+    });
+</script>
+</html>
diff --git a/src/main/resources/templates/pets/createOrUpdateVisitForm.html b/src/main/resources/templates/pets/createOrUpdateVisitForm.html
