<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.chainguard.thwart</groupId>
    <artifactId>thwart-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>thwart-spring-boot-starter-javax</artifactId>
  <name>Thwart Spring Boot Starter (javax.servlet)</name>
  <description>thwart-spring-boot-starter relocated from jakarta.servlet to javax.servlet, for Spring 4.3-5 / Boot 1.5-2 applications.</description>

  <!-- No sources of its own: the jar is the jakarta starter with jakarta.servlet relocated to
       javax.servlet. An application depends on exactly one of the two. -->
  <dependencies>
    <dependency>
      <!-- Optional: shaded into this jar, never passed on to consumers. -->
      <groupId>dev.chainguard.thwart</groupId>
      <artifactId>thwart-spring-boot-starter</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>dev.chainguard.thwart</groupId>
      <artifactId>thwart-runtime</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <artifactSet>
                <includes>
                  <include>dev.chainguard.thwart:thwart-spring-boot-starter</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>dev.chainguard.thwart:thwart-spring-boot-starter</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations>
                <relocation>
                  <pattern>jakarta.servlet</pattern>
                  <shadedPattern>javax.servlet</shadedPattern>
                </relocation>
              </relocations>
              <createSourcesJar>true</createSourcesJar>
              <shadeSourcesContent>true</shadeSourcesContent>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
