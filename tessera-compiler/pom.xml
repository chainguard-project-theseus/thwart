<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.tessera</groupId>
    <artifactId>tessera-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tessera-compiler</artifactId>
  <name>Tessera Compiler</name>
  <description>Build-time template compiler and javac annotation processor.</description>

  <!-- The processor runs inside the application's javac, so it is Java 8 too (#166); tests stay on 21. -->
  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <maven.compiler.testRelease>21</maven.compiler.testRelease>
    <!-- JDK 8 home for Jdk8ProcessorTest; CI sets JDK8_HOME. -->
    <tessera.jdk8.home>${env.JDK8_HOME}</tessera.jdk8.home>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.tessera</groupId>
      <artifactId>tessera-runtime</artifactId>
    </dependency>
    <!-- Test only: the reference parser in HtmlParserDifferentialTest (#170). -->
    <dependency>
      <groupId>org.attoparser</groupId>
      <artifactId>attoparser</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- This module defines the processor; don't run processors while compiling it. -->
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <tessera.jdk8.home>${tessera.jdk8.home}</tessera.jdk8.home>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <!-- Generated code must compile for the Java 8 floor (#154): run the template tests again
               with the Compilation harness at javac release 8. Excluded: tests whose own Java snippets
               need Java 9+ (types) or that assert record-accessor code text, and tests that do not
               compile templates (the parser differential test). -->
          <execution>
            <id>release-8</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <systemPropertyVariables>
                <tessera.test.release>8</tessera.test.release>
              </systemPropertyVariables>
              <excludes>
                <exclude>dev/tessera/compiler/types/**</exclude>
                <exclude>dev/tessera/compiler/testing/CompilationTest.java</exclude>
                <exclude>dev/tessera/compiler/links/LinkCompilerTest.java</exclude>
                <exclude>dev/tessera/compiler/processor/Jdk8ProcessorTest.java</exclude>
                <exclude>dev/tessera/compiler/html/HtmlParserDifferentialTest.java</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
