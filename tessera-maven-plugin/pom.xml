<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.tessera</groupId>
    <artifactId>tessera-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tessera-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>Tessera Maven Plugin</name>
  <description>Forces a recompile when only templates or message bundles changed since the last compile (#425, #447), and recompiles on every change for hot reload (#426).</description>

  <!-- Runs inside the application's Maven, which may run on Java 8; its tests stay on 21. -->
  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <maven.compiler.testRelease>21</maven.compiler.testRelease>
    <maven-plugin-api.version>3.6.3</maven-plugin-api.version>
    <maven-plugin-tools.version>3.16.0</maven-plugin-tools.version>
  </properties>

  <!-- Maintainer-approved for #425: the Maven plugin API, provided by Maven itself. Nothing else. -->
  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven-plugin-api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven-plugin-tools.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test only: so the reactor builds them first and the integration test's local repository
         gets them (invoker:install). -->
    <dependency>
      <groupId>dev.tessera</groupId>
      <artifactId>tessera-compiler</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- tessera-compiler is on the test classpath only for the integration test. -->
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${maven-plugin-tools.version}</version>
        <configuration>
          <goalPrefix>tessera</goalPrefix>
          <requiredMavenVersion>3.6.3</requiredMavenVersion>
        </configuration>
      </plugin>
      <!-- src/it/template-edit: build, edit only a template, build again; the processor reruns. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
          <settingsFile>src/it/settings.xml</settingsFile>
          <scope>test</scope>
          <postBuildHookScript>verify</postBuildHookScript>
          <showErrors>true</showErrors>
          <!-- The repo's pinned versions (root pom pluginManagement). -->
          <filterProperties>
            <compiler.plugin.version>3.16.0</compiler.plugin.version>
            <resources.plugin.version>3.5.0</resources.plugin.version>
          </filterProperties>
        </configuration>
        <executions>
          <execution>
            <id>integration-test</id>
            <goals>
              <goal>install</goal>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
