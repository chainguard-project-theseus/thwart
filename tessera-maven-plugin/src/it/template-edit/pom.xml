<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- #425, #447: an app that edits only a template or a message file between builds (see
       invoker.properties). -->
  <groupId>dev.tessera.it</groupId>
  <artifactId>template-edit</artifactId>
  <version>1.0</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- One value for -Atessera.messages and the check goal (its messages parameter). -->
    <tessera.messages>${project.basedir}/src/main/resources/messages</tessera.messages>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.tessera</groupId>
      <artifactId>tessera-runtime</artifactId>
      <version>@project.version@</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>@compiler.plugin.version@</version>
        <configuration>
          <release>8</release>
          <annotationProcessorPaths>
            <path>
              <groupId>dev.tessera</groupId>
              <artifactId>tessera-compiler</artifactId>
              <version>@project.version@</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Atessera.templates=${project.basedir}/src/main/resources/templates</arg>
            <arg>-Atessera.package=com.example.templates</arg>
            <arg>-Atessera.messages=${tessera.messages}</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>dev.tessera</groupId>
        <artifactId>tessera-maven-plugin</artifactId>
        <version>@project.version@</version>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- The edits: resources:copy-resources@<id> overwrites welcome.html or a message file with
           edits/<id>/. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>@resources.plugin.version@</version>
        <executions>
          <execution>
            <id>unsafe</id>
            <configuration>
              <outputDirectory>${project.basedir}/src/main/resources/templates</outputDirectory>
              <overwrite>true</overwrite>
              <resources><resource><directory>edits/unsafe</directory></resource></resources>
            </configuration>
          </execution>
          <execution>
            <id>v2</id>
            <configuration>
              <outputDirectory>${project.basedir}/src/main/resources/templates</outputDirectory>
              <overwrite>true</overwrite>
              <resources><resource><directory>edits/v2</directory></resource></resources>
            </configuration>
          </execution>
          <execution>
            <id>v3</id>
            <configuration>
              <outputDirectory>${project.basedir}/src/main/resources/templates</outputDirectory>
              <overwrite>true</overwrite>
              <resources><resource><directory>edits/v3</directory></resource></resources>
            </configuration>
          </execution>
          <execution>
            <id>msg-v2</id>
            <configuration>
              <outputDirectory>${project.basedir}/src/main/resources</outputDirectory>
              <overwrite>true</overwrite>
              <resources><resource><directory>edits/msg-v2</directory></resource></resources>
            </configuration>
          </execution>
          <execution>
            <id>msg-unsafe</id>
            <configuration>
              <outputDirectory>${project.basedir}/src/main/resources</outputDirectory>
              <overwrite>true</overwrite>
              <resources><resource><directory>edits/msg-unsafe</directory></resource></resources>
            </configuration>
          </execution>
          <!-- #626: a file another plugin writes into the class output before compile, as
               git-commit-id writes git.properties. -->
          <execution>
            <id>stamp</id>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <resources><resource><directory>edits/stamp</directory></resource></resources>
            </configuration>
          </execution>
          <execution>
            <id>msg-fixed</id>
            <configuration>
              <outputDirectory>${project.basedir}/src/main/resources</outputDirectory>
              <overwrite>true</overwrite>
              <resources><resource><directory>edits/msg-fixed</directory></resource></resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
