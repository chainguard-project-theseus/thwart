<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.tessera</groupId>
    <artifactId>tessera-html5</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tessera-html5-classic</artifactId>
  <name>Tessera HTML5 engine: classic validator.nu htmlparser 1.4.16 (build only)</name>

  <!-- nu.validator:htmlparser 1.4.16 (Jun 2020): classic <select> parsing, as in Firefox ESR, and
       the old fragment-case foreign-content breakout. This snapshot doesn't change. -->
  <properties>
    <html5.source.groupId>nu.validator</html5.source.groupId>
    <html5.source.artifactId>htmlparser</html5.source.artifactId>
    <html5.source.version>1.4.16</html5.source.version>
    <html5.source.sha256>c070893023b7d42b435680c4dcfc8139450ef3af9b87f48e47fd36b8624d8bdc</html5.source.sha256>
    <html5.package>dev.tessera.compiler.internal.html5.classic</html5.package>
    <html5.package.path>dev/tessera/compiler/internal/html5/classic</html5.package.path>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
